    ns1:input <https://workflowhub.eu/workflows/399#atacseq_main-inputs-%23main/Bin%20size>,
        <https://workflowhub.eu/workflows/399#atacseq_main-inputs-%23main/Effective%20genome%20size>,
        <https://workflowhub.eu/workflows/399#atacseq_main-inputs-%23main/PE%20fastq%20input>,
        <https://workflowhub.eu/workflows/399#atacseq_main-inputs-%23main/Percentage%20of%20bad%20quality%20bases%20per%20read>,
        <https://workflowhub.eu/workflows/399#atacseq_main-inputs-%23main/Reference%20Genome> ;
    ns1:output <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/1kb%20around%20summits>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/BAM%20filtered%20rmDup>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/Coverage%20from%20MACS2%20(bigwig)>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/MACS2%20narrowPeak>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/MACS2%20report>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/MarkDuplicates%20metrics>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/MultiQC%20on%20input%20dataset(s):%20Stats>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/MultiQC%20webpage>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/Nb%20of%20reads%20in%20summits%20+-500bp>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/bigwig_norm>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/bigwig_norm2>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/histogram%20of%20fragment%20length>,
        <https://workflowhub.eu/workflows/399#atacseq_main-outputs-%23main/mapping%20stats> ;
    schema:contributor <https://workflowhub.eu/people/112> ;
    schema:creator <https://orcid.org/0000-0002-1964-4960>,
        <https://workflowhub.eu/workflows/399#Lucille%20Delisle> ;
    schema:dateCreated "2026-07-14T02:01:48Z" ;
    schema:dateModified "2026-07-14T02:01:48Z" ;
    schema:description "Complete ATAC-seq analysis pipeline for paired-end reads. Processes raw FASTQ data through adapter and bad quality removal (fastp), alignment (Bowtie2 end-to-end), and filtering (removes MT reads, discordant pairs, low mapping quality below 30, PCR duplicates). Generates 5' cut site pileups (±100bp), performs peak calling, and quantifies reads in 1kb summit-centered regions. Produces two normalized coverage tracks (per million mapped reads and per million reads in peaks) and fragment length distribution plots for quality assessment." ;
    schema:isBasedOn "https://workflowhub.eu/workflows/399?version=21" ;
    schema:keywords "ATACseq" ;
    schema:license "https://spdx.org/licenses/MIT" ;
    schema:name "atacseq/main" ;
    schema:producer <https://workflowhub.eu/projects/33> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/399#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/399?version=22" ;
    schema:version 22 .

