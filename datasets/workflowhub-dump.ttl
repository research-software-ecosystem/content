    ns1:input <https://workflowhub.eu/workflows/1991#_dtc_e2__wf7201__ai_based_seismic_catalogue_generation__quakeflow_-inputs-WAVEFORMS> ;
    ns1:output <https://workflowhub.eu/workflows/1991#_dtc_e2__wf7201__ai_based_seismic_catalogue_generation__quakeflow_-outputs-HIGH_RESOLUTION_CATALOG> ;
