        <https://workflowhub.eu/workflows/2001#domestication_and_cloning_simulation_workflow-outputs-%23main/_anonymous_output_1>,
        <https://workflowhub.eu/workflows/2001#domestication_and_cloning_simulation_workflow-outputs-%23main/domestication%20results>,
        <https://workflowhub.eu/workflows/2001#domestication_and_cloning_simulation_workflow-outputs-%23main/missing%20fragments>,
        <https://workflowhub.eu/workflows/2001#domestication_and_cloning_simulation_workflow-outputs-%23main/saving%20report>,
        <https://workflowhub.eu/workflows/2001#domestication_and_cloning_simulation_workflow-outputs-%23main/scul%20group>,
        <https://workflowhub.eu/workflows/2001#domestication_and_cloning_simulation_workflow-outputs-%23main/simulation%20results%20(zip)>,
