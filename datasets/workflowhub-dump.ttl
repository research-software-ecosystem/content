    schema:version 2 .

<https://workflowhub.eu/workflows/123?version=1> a ns1:ComputationalWorkflow,
        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    ns1:input <https://workflowhub.eu/workflows/123#compute_daily_and_monthly_mean_from_meteorological_station_measurements-inputs-Temperature%20timeseries%20(csv)> ;
    ns1:output <https://workflowhub.eu/workflows/123#compute_daily_and_monthly_mean_from_meteorological_station_measurements-outputs-daily_barchart>,
        <https://workflowhub.eu/workflows/123#compute_daily_and_monthly_mean_from_meteorological_station_measurements-outputs-daily_mean_timeseries>,
        <https://workflowhub.eu/workflows/123#compute_daily_and_monthly_mean_from_meteorological_station_measurements-outputs-monthly_mean_timeseries>,
        <https://workflowhub.eu/workflows/123#compute_daily_and_monthly_mean_from_meteorological_station_measurements-outputs-stripes_daily_temperatures>,
        <https://workflowhub.eu/workflows/123#compute_daily_and_monthly_mean_from_meteorological_station_measurements-outputs-stripes_monthly_temperatures> ;
    schema:contributor <https://workflowhub.eu/people/49> ;
    schema:creativeWorkStatus "Stable" ;
    schema:dateCreated "2021-05-23T19:28:06Z" ;
    schema:dateModified "2026-05-13T12:45:11Z" ;
    schema:description """This workflow is used to process timeseries from meteorological stations in Finland but can be applied to any timeseries according it follows the same format.

Take a temperature timeseries from any meteorological station. Input format is csv and it must be standardized with 6 columns:

1. Year	(ex: 2021)
2. month	(ex: 1)
3. day	(ex: 15) 
4. Time	(ex: 16:56)
5. Time zone	(such as UTC)
6. Air temperature (degC)""" ;
    schema:keywords "Climate, eosc-nordic, observation" ;
    schema:license "https://spdx.org/licenses/GPL-3.0" ;
    schema:name "Compute daily and monthly mean from meteorological station measurements" ;
    schema:producer <https://workflowhub.eu/projects/18> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/123#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/123?version=1" ;
    schema:version 1 .

