    ns1:license "CC-BY-4.0" ;
    ns1:name "Use Case 4: Identify the Tissue Activity for a TF based on its Targets" ;
    ns1:url <https://workflowhub.eu/workflows/1239?version=2> ;
    ns1:version "2" .

<https://workflowhub.eu/workflows/123?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
