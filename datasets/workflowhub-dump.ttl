        <https://workflowhub.eu/workflows/2009#genetic_design__basic_assembly_-inputs-%23main/Linkers%20and%20user%20parts>,
        <https://workflowhub.eu/workflows/2009#genetic_design__basic_assembly_-inputs-%23main/Pathway%20(SBML)> ;
