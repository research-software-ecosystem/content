    ns1:keywords "ecology",
        "ecoregionalization",
        "fair workflows" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "Ecoregionalization workflow (Part 1)" ;
    ns1:url <https://workflowhub.eu/workflows/1208?version=1> ;
    ns1:version "1" .

