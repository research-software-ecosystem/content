        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-lon_min>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-model>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-model_weights>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-network_inventory>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-source_rock_density>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-source_wave_velocity>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-time_window_length>,
        <https://workflowhub.eu/workflows/1985#_dtc_agef__wf8103__forecasting_maximum_magnitude-inputs-velocity_model>,
