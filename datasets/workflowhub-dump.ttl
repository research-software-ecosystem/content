    schema:keywords "scATAC-seq, epigenetics" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "Workflow - Standard processing of 10X single cell ATAC-seq data with SnapATAC2" ;
    schema:producer <https://workflowhub.eu/projects/24> ;
