    ns1:name "NGS Equimolar Pooling Calculator" ;
    ns1:url <https://workflowhub.eu/workflows/1344?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/1346?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.1346.2" ;
