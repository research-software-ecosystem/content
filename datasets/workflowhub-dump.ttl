<https://workflowhub.eu/workflows/885?version=1> a ns1:ComputationalWorkflow,
        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    schema:contributor <https://workflowhub.eu/people/745> ;
