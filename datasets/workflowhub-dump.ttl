        "seurat" ;
    ns1:identifier "480" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "PerMedCoE Covid19 Pilot workflow (Nextflow)" ;
    ns1:url <https://workflowhub.eu/workflows/480?version=1> ;
    ns1:version "1" .

