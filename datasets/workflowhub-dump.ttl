    ns1:output <https://workflowhub.eu/workflows/1499#capturing_mitoflashes-outputs-%23main/Curve%20Fitting%20for%20Mitoflash%20Detection>,
        <https://workflowhub.eu/workflows/1499#capturing_mitoflashes-outputs-%23main/Spot%20Detection%20Across%20Frames>,
        <https://workflowhub.eu/workflows/1499#capturing_mitoflashes-outputs-%23main/Spot%20Detection%20of%20Mitoflashes> ;
