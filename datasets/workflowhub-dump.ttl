        <https://workflowhub.eu/workflows/75#indices_builder_from_gbol_rdf__ttl_-outputs-kallisto>,
        <https://workflowhub.eu/workflows/75#indices_builder_from_gbol_rdf__ttl_-outputs-proteins>,
        <https://workflowhub.eu/workflows/75#indices_builder_from_gbol_rdf__ttl_-outputs-transcripts> ;
