    schema:contributor <https://workflowhub.eu/people/112> ;
    schema:creator <https://workflowhub.eu/workflows/357#Anton%20Nekrutenko> ;
    schema:dateCreated "2022-06-04T02:01:11Z" ;
    schema:dateModified "2026-05-14T01:01:44Z" ;
    schema:description """Generic variation analysis on WGS PE data
-------------------------------------------

This workflows performs paired end read mapping with bwa-mem followed by
sensitive variant calling across a wide range of AFs with lofreq and variant
annotation with snpEff. The reference genome can be provided as a GenBank file.
""" ;
    schema:keywords "mpxv, generic" ;
    schema:license "https://spdx.org/licenses/MIT" ;
    schema:name "generic-variant-calling-wgs-pe/main" ;
    schema:producer <https://workflowhub.eu/projects/33> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/357#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/357?version=1" ;
    schema:version 1 .

<https://workflowhub.eu/workflows/358?version=1> a ns1:ComputationalWorkflow,
        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    ns1:input <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-inputs-Input%20genomes%20as%20collection> ;
    ns1:output <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-ClustalW%20on%20input%20dataset(s):%20clustal>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-Proteinortho%20on%20input%20dataset(s):%20orthology-groups>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-Proteinortho_extract_by_orthogroup>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_1>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_2>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_3>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_4>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_5>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_6>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-_anonymous_output_7>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-extracted_ORFs>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-fasta_header_cleaned>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-funannotate_predicted_proteins>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-headers_shortened>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-proteomes_to_one_file>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-repeat_masked>,
        <https://workflowhub.eu/workflows/358#preparing_genomic_data_for_phylogeny_recostruction__gtn_-outputs-sample_names_to_headers> ;
    schema:contributor <https://workflowhub.eu/people/281> ;
    schema:creator <https://workflowhub.eu/workflows/358#Miguel%20Roncoroni> ;
    schema:dateCreated "2022-06-06T14:05:14Z" ;
    schema:dateModified "2026-05-13T13:05:26Z" ;
    schema:description "This workflow begins from a set of genome assemblies of different samples, strains, species. The genome is first annotated with Funnanotate. Predicted proteins are furtner annotated with Busco. Next, 'ProteinOrtho' finds orthologs across the samples and makes orthogroups. Orthogroups where all samples are represented are extracted. Orthologs in each orthogroup are aligned with ClustalW. Test dataset: https://zenodo.org/record/6610704#.Ypn3FzlBw5k" ;
    schema:keywords "phylogenetics, phylogenomics, Annotation" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "preparing genomic data for phylogeny recostruction (GTN)" ;
    schema:producer <https://workflowhub.eu/projects/97> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/358#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/358?version=1" ;
    schema:version 1 .

