<https://workflowhub.eu/workflows/702?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_3673> ;
