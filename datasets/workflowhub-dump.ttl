<https://workflowhub.eu/workflows/435?version=1> a ns1:ComputationalWorkflow,
        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    schema:contributor <https://workflowhub.eu/people/405> ;
