<https://workflowhub.eu/workflows/2030?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:dateCreated "2025-12-10" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """This workflows contains a pipeline in Scipion that performs the following steps:\r
\r
1) Import atomic structure: introduces a protein atomic structure in the pipeline as receptor.\r
\r
2) Receptor preparation: uses bioPython to prepare the receptor structure, removing waters, adding hydrogens and removing unnecessary chains if asked. Also, uses PDBFixer to optimize the structure if selected.\r
\r
3) Protein pocket search: uses 3 different software (P2Rank, AutoSite and FPocket) for predicting the receptor pockets.\r
\r
4) Performs a consensus over the predicted pockets to extract those that are shared among the different programs.""" ;
    ns1:identifier "2030" ;
    ns1:license "Apache-2.0" ;
    ns1:name "Template for protein pockets search" ;
    ns1:url <https://workflowhub.eu/workflows/2030?version=1> ;
    ns1:version "1" .

