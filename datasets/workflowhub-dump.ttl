    schema:creativeWorkStatus "Stable" ;
    schema:creator <https://workflowhub.eu/workflows/19#Sarai%20Varona%20and%20Miguel%20Juli%C3%A1%20and%20Sara%20Monzon%20and%20Alexander%20Peltzer%20and%20Alison%20Meynert%20and%20Edgar%20Garriga%20Nogales%20and%20Erik%20Garrison%20and%20Gisela%20Gabernet%20and%20Harshil%20Patel%20and%20Joao%20Curado%20and%20Jose%20Espinosa-Carrasco%20and%20Katrin%20Sameith%20and%20Marta%20Pozuelo%20and%20Maxime%20Garcia%20and%20Michael%20Heuer%20and%20Phil%20Ewels%20and%20Simon%20Heumos%20and%20Stephen%20Kelly%20and%20Thanh%20Le%20Viet%20and%20Isabel%20Cuesta> ;
    schema:dateCreated "2020-05-14T14:10:58Z" ;
