    schema:contributor <https://workflowhub.eu/people/428> ;
    schema:creativeWorkStatus "Work-in-progress" ;
    schema:creator <https://workflowhub.eu/people/428> ;
    schema:dateCreated "2023-07-09T08:54:36Z" ;
