<https://workflowhub.eu/workflows/2109?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.2109.1" ;
    ns1:creator "Albert Turon",
        "Aravind Sasikumar",
        "Gerard Guillamet",
        "Jorge Ejarque",
        "Riccardo Cecco",
        "Rosa M Badia",
