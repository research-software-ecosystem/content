    ns1:name "NMR pipe" ;
    ns1:url <https://workflowhub.eu/workflows/43?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/440?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
