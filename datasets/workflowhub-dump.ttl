    schema:isPartOf <https://workflowhub.eu/collections/4> ;
    schema:keywords "imaging, Python" ;
    schema:license "https://spdx.org/licenses/BSD-2-Clause" ;
    schema:name "Use Public Resources to answer a biological question" ;
    schema:producer <https://workflowhub.eu/projects/69> ;
