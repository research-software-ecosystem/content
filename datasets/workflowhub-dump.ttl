<https://workflowhub.eu/workflows/357?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:creator "Anton Nekrutenko" ;
    ns1:dateCreated "2022-06-04" ;
    ns1:dateModified "2026-05-14" ;
    ns1:description """Generic variation analysis on WGS PE data
-------------------------------------------

This workflows performs paired end read mapping with bwa-mem followed by
sensitive variant calling across a wide range of AFs with lofreq and variant
annotation with snpEff. The reference genome can be provided as a GenBank file.
""" ;
    ns1:hasPart "bwa",
        "fastp",
        "lofreq",
        "multiqc",
        "samtools" ;
    ns1:identifier "357" ;
    ns1:keywords "generic",
        "mpxv" ;
    ns1:license "MIT" ;
    ns1:name "generic-variant-calling-wgs-pe/main" ;
    ns1:url <https://workflowhub.eu/workflows/357?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/358?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:creator "Miguel Roncoroni" ;
    ns1:dateCreated "2022-06-06" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description "This workflow begins from a set of genome assemblies of different samples, strains, species. The genome is first annotated with Funnanotate. Predicted proteins are furtner annotated with Busco. Next, 'ProteinOrtho' finds orthologs across the samples and makes orthogroups. Orthogroups where all samples are represented are extracted. Orthologs in each orthogroup are aligned with ClustalW. Test dataset: https://zenodo.org/record/6610704#.Ypn3FzlBw5k" ;
    ns1:hasPart "busco",
        "clustal2",
        "clustalw",
        "funannotate",
        "proteinortho",
        "repeatmasker" ;
    ns1:identifier "358" ;
    ns1:keywords "annotation",
        "phylogenetics",
        "phylogenomics" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "preparing genomic data for phylogeny recostruction (GTN)" ;
    ns1:url <https://workflowhub.eu/workflows/358?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/359?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:creator "Miguel Roncoroni" ;
    ns1:dateCreated "2022-06-06" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """Phylogenetic reconstruction using genome-wide and single-gene alignment data. Here we use maximum likelihood reconstruction program IQTree. \r
Data can be prepared using the [phylogenetic data preparation workflow](http://workflowhub.eu/workflows/358) prior to phylogenetic reconstruction.\r
Resulting trees can be viewed interactively using Galaxy's 'Phyloviz' or 'Phylogenetic Tree Visualization'""" ;
    ns1:hasPart "clipkit",
        "iqtree" ;
    ns1:identifier "359" ;
    ns1:keywords "phylogenetics",
        "phylogenomics" ;
