	journal = {npj Digital Medicine},\r
	author = {Renc, Pawel and Jia, Yugang and Samir, Anthony E. and Was, Jaroslaw and Li, Quanzheng and Bates, David W. and Sitek, Arkadiusz},\r
	month = sep,\r
	year = {2024},\r
	pages = {1--10},\r
}\r
```\r
""" ;
