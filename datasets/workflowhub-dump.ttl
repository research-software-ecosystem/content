    ns1:keywords "covid-19" ;
    ns1:license <https://spdx.org/licenses/MIT> ;
    ns1:name "Genomics - MRCA analysis" ;
    ns1:producer <https://workflowhub.eu/projects/3> ;
    ns1:programmingLanguage <https://workflowhub.eu/workflows/6#galaxy> ;
    ns1:sdPublisher <https://about.workflowhub.eu/> ;
    ns1:url <https://workflowhub.eu/workflows/6?version=1> ;
    ns1:version 1 .

