    schema:contributor <https://workflowhub.eu/people/112> ;
    schema:creator <https://orcid.org/0000-0002-1964-4960>,
        <https://workflowhub.eu/workflows/395#Lucille%20Delisle> ;
    schema:dateCreated "2026-06-25T02:02:27Z" ;
    schema:dateModified "2026-06-25T02:02:27Z" ;
    schema:description "Complete CUT&amp;RUN/CUT&amp;TAG analysis workflow for paired-end sequencing data. Processes raw FASTQ files through adapter removal (cutadapt) and alignment (Bowtie2 with dovetail option enabled). Applies quality filtering (MAPQ ≥ 30, concordant pairs only), converts BAM to BED format, and performs peak calling using MACS2 with parameters optimized for the punctate signal profile characteristic of CUT&amp;RUN/CUT&amp;TAG experiments." ;
    schema:isBasedOn "https://workflowhub.eu/workflows/395?version=19" ;
    schema:keywords "CUTnRUN" ;
    schema:license "https://spdx.org/licenses/MIT" ;
    schema:name "cutandrun/main" ;
    schema:producer <https://workflowhub.eu/projects/33> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/395#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/395?version=20" ;
    schema:version 20 .

