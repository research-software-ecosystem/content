<https://workflowhub.eu/workflows/1963?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_3170> ;
    ns1:citation "10.48546/workflowhub.workflow.1963.2" ;
