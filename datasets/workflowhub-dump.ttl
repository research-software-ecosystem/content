    schema:dateModified "2026-05-13T12:52:25Z" ;
    schema:description """This Workflow takes a dataset collection of single-cell ATAC-seq fragments and performs:
- preprocessing
- filtering
- concatenation
- dimension reduction
- batch correction (with Harmony and optionally Scanorama and MNC-correct)
- leiden clustering

* new SnapATAC2 version: from 2.5.3 to 2.6.4""" ;
    schema:keywords "scATAC-seq, single-cell" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "Multisample Batch Correction with SnapATAC2 and Harmony" ;
