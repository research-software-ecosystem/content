<https://workflowhub.eu/workflows/149?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_0196>,
        <http://edamontology.org/topic_3308>,
        <http://edamontology.org/topic_3512> ;
    ns1:citation "10.48546/workflowhub.workflow.149.1" ;
    ns1:creator "Cali Willet",
        "Georgina Samaha",
        "Rosemarie Sadsad",
        "Tracy Chew" ;
    ns1:dateCreated "2021-08-18" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """Flashlite-Trinity contains two workflows that run Trinity on the [University of Queensland's HPC, Flashlite](https://rcc.uq.edu.au/flashlite).  Trinity performs de novo transcriptome assembly of RNA-seq data by combining three independent software modules Inchworm, Chrysalis and Butterfly to process RNA-seq reads. The algorithm can detect isoforms, handle paired-end reads, multiple insert sizes and strandedness. Users can run Flashlite-Trinity on single samples, or smaller samples requiring <500Gb of memory or staged Trinity which is recommended for global assemblies with multiple sample inputs. Both implementations make use of Singularity containers to install software. \r
\r
Infrastructure\\_deployment\\_metadata: FlashLite (QRISCloud)""" ;
    ns1:featureList <http://edamontology.org/operation_0310>,
        <http://edamontology.org/operation_0524>,
        <http://edamontology.org/operation_3258> ;
