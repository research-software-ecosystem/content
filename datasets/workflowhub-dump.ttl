<https://workflowhub.eu/workflows/235?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.235.1" ;
    ns1:creator "Michael Roach",
        "Scott Handley, Rob Edwards" ;
    ns1:dateCreated "2021-11-11" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """A hecatomb is a great sacrifice or an extensive loss. Heactomb the software empowers an analyst to make data driven decisions to 'sacrifice' false-positive viral reads from metagenomes to enrich for true-positive viral reads. This process frequently results in a great loss of suspected viral sequences / contigs.\r
\r
For information about installation, usage, tutorial etc please refer to the documentation: https://hecatomb.readthedocs.io/en/latest/\r
\r
### Quick start guide\r
\r
Install Hecatomb from Bioconda\r
```bash\r
# create an env called hecatomb and install Hecatomb in it\r
conda create -n hecatomb -c conda-forge -c bioconda hecatomb\r
\r
# activate conda env\r
conda activate hecatomb\r
\r
# check the installation\r
hecatomb -h\r
\r
# download the databases - you only have to do this once\r
hecatomb install\r
\r
# Run the test dataset\r
hecatomb run --test\r
```""" ;
    ns1:identifier "235" ;
    ns1:license "MIT" ;
    ns1:name "Hecatomb" ;
    ns1:url <https://workflowhub.eu/workflows/235?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/236?version=1> a ns1:ComputationalWorkflow ;
