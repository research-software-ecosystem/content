    ns1:citation "10.48546/workflowhub.workflow.786.1" ;
    ns1:creator "Peter Menzel" ;
    ns1:dateCreated "2024-03-06" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """# score-assemblies\r
\r
A Snakemake-wrapper for evaluating *de novo* bacterial genome assemblies, e.g. from Oxford Nanopore (ONT) or Illumina sequencing.\r
\r
The workflow includes the following programs:\r
* [pomoxis](https://github.com/nanoporetech/pomoxis) assess_assembly and assess_homopolymers\r
* dnadiff from the [mummer](https://mummer4.github.io/index.html) package\r
* [NucDiff](https://github.com/uio-cels/NucDiff/)\r
* [QUAST](http://quast.sourceforge.net/quast)\r
* [BUSCO](https://busco.ezlab.org/)\r
* [ideel](https://github.com/mw55309/ideel/), which uses [prodigal](https://github.com/hyattpd/Prodigal) and [diamond](https://github.com/bbuchfink/diamond)\r
* [bakta](https://github.com/oschwengers/bakta)\r
\r
\r
""" ;
    ns1:identifier "786" ;
    ns1:keywords "genome-annotation",
        "genome_assembly" ;
    ns1:license "MIT" ;
    ns1:name "score-assemblies" ;
    ns1:url <https://workflowhub.eu/workflows/786?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/787?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_0196> ;
    ns1:citation "10.48546/workflowhub.workflow.787.1" ;
    ns1:creator "Peter Menzel" ;
    ns1:dateCreated "2024-03-06" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """# ont-assembly-snake\r
\r
A Snakemake wrapper for easily creating *de novo* bacterial genome assemblies from Oxford Nanopore (ONT) sequencing data, and optionally Illumina data,\r
using any combination of read filtering, assembly, long and short read polishing, and reference-based polishing.\r
\r
## Included programs\r
\r
| read filtering | assembly | long read polishing | short read polishing | reference-based polishing |\r
| --- | --- | --- | --- | --- |\r
| [Filtlong](https://github.com/rrwick/Filtlong)<br/> [Rasusa](https://github.com/mbhall88/rasusa) | [Flye](https://github.com/fenderglass/Flye)<br/> [raven](https://github.com/lbcb-sci/raven)<br/> [miniasm](https://github.com/lh3/miniasm)<br/> [Unicycler](https://github.com/rrwick/Unicycler)<br/> [Canu](https://github.com/marbl/canu)  | [racon](https://github.com/lbcb-sci/racon)<br/> [medaka](https://github.com/nanoporetech/medaka) | [pilon](https://github.com/broadinstitute/pilon/wiki)<br/> [Polypolish](https://github.com/rrwick/Polypolish)<br/> [POLCA](https://github.com/alekseyzimin/masurca#polca) | [Homopolish](https://github.com/ythuang0522/homopolish)<br/> [proovframe](https://github.com/thackl/proovframe) | \r
\r
""" ;
    ns1:featureList <http://edamontology.org/operation_0525> ;
    ns1:identifier "787" ;
    ns1:keywords "genome_assembly",
        "name:illumina",
        "name:ont" ;
    ns1:license "MIT" ;
    ns1:name "ont-assembly-snake" ;
    ns1:url <https://workflowhub.eu/workflows/787?version=1> ;
    ns1:version "1" .

