        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    ns1:input <https://workflowhub.eu/workflows/1239#use_case_4__identify_the_tissue_activity_for_a_tf_based_on_its_targets-inputs-step-1-data> ;
    ns1:output <https://workflowhub.eu/workflows/1239#use_case_4__identify_the_tissue_activity_for_a_tf_based_on_its_targets-outputs-step-1-output>,
