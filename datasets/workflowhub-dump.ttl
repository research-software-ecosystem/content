        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-Output%20tree%20file>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-Trimmed%20alignment.>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-_anonymous_output_1>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-_anonymous_output_2>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-_anonymous_output_3>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-_anonymous_output_4>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-_anonymous_output_5>,
        <https://workflowhub.eu/workflows/359#ml_phylogenetic_reconstruction-outputs-_anonymous_output_6> ;
    schema:contributor <https://workflowhub.eu/people/281> ;
    schema:creator <https://workflowhub.eu/workflows/359#Miguel%20Roncoroni> ;
    schema:dateCreated "2022-06-06T14:14:25Z" ;
    schema:dateModified "2026-05-13T13:05:26Z" ;
    schema:description """Phylogenetic reconstruction using genome-wide and single-gene alignment data. Here we use maximum likelihood reconstruction program IQTree. 
Data can be prepared using the [phylogenetic data preparation workflow](http://workflowhub.eu/workflows/358) prior to phylogenetic reconstruction.
Resulting trees can be viewed interactively using Galaxy's 'Phyloviz' or 'Phylogenetic Tree Visualization'""" ;
    schema:keywords "phylogenetics, phylogenomics" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "ML phylogenetic reconstruction" ;
    schema:producer <https://workflowhub.eu/projects/97> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/359#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/359?version=1" ;
    schema:version 1 .

