<https://workflowhub.eu/workflows/2081?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_0099>,
        <http://edamontology.org/topic_0203>,
        <http://edamontology.org/topic_3170>,
        <http://edamontology.org/topic_3301>,
        <http://edamontology.org/topic_3941> ;
