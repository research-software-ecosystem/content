<https://workflowhub.eu/workflows/398?version=21> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:creator "Lucille Delisle" ;
    ns1:dateCreated "2026-10-15" ;
    ns1:dateModified "2026-10-15" ;
    ns1:description "Complete ChIP-seq analysis for paired-end sequencing data. Processes raw FASTQ files through adapter removal (cutadapt), alignment to reference genome (Bowtie2), and stringent quality filtering (MAPQ &gt;= 30, concordant pairs only). Peak calling with MACS2 optimized for paired-end reads identifies protein-DNA binding sites. Generates alignment files, peak calls, and quality metrics for downstream analysis." ;
    ns1:hasPart "bowtie2",
        "cutadapt",
