    schema:producer <https://workflowhub.eu/projects/3> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/5#galaxy> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/5?version=1" ;
    schema:version 1 .

<https://workflowhub.eu/workflows/600?version=1> a ns1:ComputationalWorkflow,
        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    schema:contributor <https://workflowhub.eu/people/575> ;
    schema:creativeWorkStatus "Work-in-progress" ;
    schema:dateCreated "2023-10-04T13:11:55Z" ;
    schema:dateModified "2026-05-13T13:05:20Z" ;
    schema:description """The ultimate-level complexity workflow is one among a collection of workflows designed to address tasks up to CTF estimation. In addition to the functionalities provided by layer 0 and 1 workflows, this workflow aims to enhance the quality of both **acquisition images** and **processing**.

**Quality control protocols**

…

**Combination of methods**
* **CTF consensus**
	* New methods to compare ctf estimations
	* CTF xmipp criteria (richer parameters i.e. ice detection)

**Advantages**:&nbsp;
* Control of the acquisition quality
* Robust estimations to continue with the processing""" ;
    schema:image "https://workflowhub.eu/workflows/777/diagram?version=1" ;
    schema:isPartOf <https://workflowhub.eu/collections/11> ;
    schema:keywords "image processing, cryoem, spa, scipion" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "CEITEC layer 2 workflow" ;
    schema:producer <https://workflowhub.eu/projects/198> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/600#scipion> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/600?version=1" ;
    schema:version 1 .

