<https://workflowhub.eu/workflows/881?version=8> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.881.8" ;
    ns1:creator "Luke Silver" ;
    ns1:dateCreated "2026-05-05" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """# Fgenesh Annotation - TSI Workflow Description\r
\r
## Overview\r
One of a series of workflows to annotate a genome, tagged `TSI-annotation`. Based on command-line code by Luke Silver, converted into Galaxy Australia workflows.\r
\r
## Workflow Sequence\r
Run in this order:\r
- Repeat masking\r
- RNAseq QC and read trimming\r
- Find transcripts\r
- Combine transcripts\r
- Extract transcripts\r
- **Fgenesh annotation** (this workflow)\r
\r
## Inputs Required\r
\r
**Files uploaded by the user:**\r
- `assembled_genome.fasta` — the assembled genome\r
- `hard_masked_genome.fasta` — hard repeat-masked genome\r
- `mRNA_sequences.fasta` — TransDecoder CDS output from the upstream "Extract transcripts" workflow (use the "Results (CDS/FASTA)" output)\r
\r
**Selected at runtime (dropdowns / tick-boxes, not uploads):**\r
- Closely-related species (Fgenesh species matrix, from those installed on Galaxy Australia)\r
- Mammal or non-mammal\r
- NR database (for Fgenesh get proteins)\r
- BUSCO lineage\r
- Licence agreement (tick to accept Fgenesh terms)\r
\r
## Running without mRNA\r
If no known mRNA sequences are available, edit the Fgenesh-annotate step's mRNA option to "no" and disconnect the mRNA input.\r
\r
## Processing Steps\r
Splits the input genomes into single sequences (to reduce runtime), annotates each with Fgenesh++, and merges the outputs. TransDecoder CDS sequences are automatically filtered and reformatted for Fgenesh before annotation.\r
\r
## Outputs\r
- Genome annotation (GFF3)\r
- Annotation stats\r
- FASTA files of mRNAs, cDNAs and proteins\r
- BUSCO report of proteins\r
\r
## Key Note\r
The sequences passed to the mRNA/cDNA extraction tools are the unmasked assembly; there may be situations where the masked version is preferable.\r
""" ;
    ns1:hasPart "busco",
        "fgenesh" ;
    ns1:identifier "881" ;
    ns1:keywords "tsi-annotation" ;
    ns1:license "GPL-3.0" ;
    ns1:name "Fgenesh annotation -TSI" ;
    ns1:url <https://workflowhub.eu/workflows/881?version=8> ;
    ns1:version "8" .

<https://workflowhub.eu/workflows/882?version=3> a ns1:ComputationalWorkflow ;
