    ns1:name "ERGA Protein-coding gene annotation workflow" ;
    ns1:url <https://workflowhub.eu/workflows/569?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/56?version=9> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
