        <https://workflowhub.eu/workflows/357#generic_variant_calling_wgs_pe_main-outputs-%23main/markduplicates_reads>,
        <https://workflowhub.eu/workflows/357#generic_variant_calling_wgs_pe_main-outputs-%23main/markduplicates_stats>,
        <https://workflowhub.eu/workflows/357#generic_variant_calling_wgs_pe_main-outputs-%23main/preprocessing_and_mapping_reports>,
