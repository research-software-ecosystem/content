    schema:keywords "Bioinformatics, Python, Workflows, Cheminformatics, scipion, Consensus, Virtual Drug Screening, Drug design, drug discovery" ;
    schema:license "https://spdx.org/licenses/Apache-2.0" ;
    schema:name "Consensus Virtual Drug Screening Workflow" ;
    schema:producer <https://workflowhub.eu/projects/198> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/1365#scipion> ;
