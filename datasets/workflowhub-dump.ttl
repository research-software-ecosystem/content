<https://workflowhub.eu/workflows/838?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.838.1" ;
