    ns1:keywords "deep learning",
        "polarized images",
        "public colorectal cancer dataset",
        "python" ;
    ns1:license "GPL-3.0" ;
    ns1:name "Colorectal-cancer-detection-using-ColoPola-dataset" ;
    ns1:url <https://workflowhub.eu/workflows/1797?version=2> ;
    ns1:version "2" .

