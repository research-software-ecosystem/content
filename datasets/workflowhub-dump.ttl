    schema:keywords "GATK4, SNPs, INDELs, Somatic, variant_calling, Mutect2, NCI, NCI Gadi, Gadi, cancer, tumour, NCI-Gadi, scalable, VCF" ;
    schema:license "https://spdx.org/licenses/GPL-3.0" ;
    schema:name "Somatic-ShortV @ NCI-Gadi" ;
