    schema:keywords "RNASEQ, Transcriptomics, CWL, workflow" ;
    schema:license "https://spdx.org/licenses/MIT" ;
    schema:name "CWL-based RNA-Seq workflow" ;
    schema:producer <https://workflowhub.eu/projects/173> ;
