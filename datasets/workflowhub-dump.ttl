    ns1:keywords "assembly",
        "container",
        "de novo",
        "global assemblies",
        "illumina",
        "pbs",
        "rna",
        "rna-seq",
        "salmon",
        "scalable",
        "singularity",
        "strandedness",
        "transcriptome",
        "transcriptomics",
        "trinity" ;
    ns1:license "GPL-3.0" ;
    ns1:name "Flashlite-Trinity" ;
    ns1:url <https://workflowhub.eu/workflows/149?version=1> ;
    ns1:version "1" .

