        <https://workflowhub.eu/workflows/395#cutandrun_main-outputs-%23main/MACS2%20narrowPeak>,
        <https://workflowhub.eu/workflows/395#cutandrun_main-outputs-%23main/MACS2%20peaks%20xls>,
        <https://workflowhub.eu/workflows/395#cutandrun_main-outputs-%23main/MACS2%20report>,
        <https://workflowhub.eu/workflows/395#cutandrun_main-outputs-%23main/MACS2%20summits>,
        <https://workflowhub.eu/workflows/395#cutandrun_main-outputs-%23main/Mapping%20stats>,
        <https://workflowhub.eu/workflows/395#cutandrun_main-outputs-%23main/MarkDuplicates%20metrics>,
