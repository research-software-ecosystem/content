<https://workflowhub.eu/workflows/2321?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_0199>,
        <http://edamontology.org/topic_0625>,
        <http://edamontology.org/topic_2885> ;
    ns1:citation "" ;
    ns1:creator "Alexander Swarbrick",
        "Beata Myler",
        "Daniel Roden",
        "James Douglas",
