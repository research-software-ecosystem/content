    ns1:dateModified "2026-05-13" ;
    ns1:description """Workflow to build different indices for different tools from a genome and transcriptome. \r
\r
This workflow expects an (annotated) genome in GBOL ttl format.\r
\r
Steps:\r
  - SAPP: rdf2gtf (genome fasta)\r
  - SAPP: rdf2fasta (transcripts fasta)\r
  - STAR index (Optional for Eukaryotic origin)\r
  - bowtie2 index\r
  - kallisto index\r
""" ;
    ns1:identifier "75" ;
    ns1:keywords "alignment" ;
    ns1:license "CC0-1.0" ;
    ns1:name "Indices builder from GBOL RDF (TTL)" ;
    ns1:url <https://workflowhub.eu/workflows/75?version=1> ;
    ns1:version "1" .

