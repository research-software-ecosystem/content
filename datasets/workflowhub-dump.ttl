<https://workflowhub.eu/workflows/1381?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_3382> ;
    ns1:citation "" ;
    ns1:creator "Dario Longo",
        "Francesco Gammaraccio",
        "Hakim Achterberg",
        "Jeanne Chèneby",
        "Robin Navest" ;
    ns1:dateCreated "2025-10-21" ;
