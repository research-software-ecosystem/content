<https://workflowhub.eu/workflows/1077?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:creator "Timon Schlegel" ;
    ns1:dateCreated "2024-07-17" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """Workflow for Single-cell ATAC-seq standard processing with SnapATAC2.\r
This workflow takes a fragment file as input and performs the standard steps of scATAC-seq analysis: filtering, dimension reduction, embedding and visualization of marker genes with SnapATAC2. Finally, the clusters are manually annotated with the help of marker genes. \r
In an alternative step, the fragment file can also be generated from a BAM file. \r
* newer Version: Updated SnapATAC2 version from 2.5.3 to 2.6.4""" ;
    ns1:hasPart "anndata",
        "scanpy" ;
    ns1:identifier "1077" ;
    ns1:keywords "epigenetics",
        "scatac-seq" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "Workflow - Standard processing of 10X single cell ATAC-seq data with SnapATAC2" ;
    ns1:url <https://workflowhub.eu/workflows/1077?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/1078?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:dateCreated "2024-07-17" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """This Workflow takes a dataset collection of single-cell ATAC-seq fragments and performs:\r
- preprocessing\r
- filtering\r
- concatenation\r
- dimension reduction\r
- batch correction (with Harmony and optionally Scanorama and MNC-correct)\r
- leiden clustering\r
\r
* new SnapATAC2 version: from 2.5.3 to 2.6.4""" ;
    ns1:hasPart "anndata" ;
    ns1:identifier "1078" ;
    ns1:keywords "scatac-seq",
        "single-cell" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "Multisample Batch Correction with SnapATAC2 and Harmony" ;
    ns1:url <https://workflowhub.eu/workflows/1078?version=1> ;
    ns1:version "1" .

