<https://workflowhub.eu/workflows/1241?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.1241.2" ;
    ns1:creator "Playbook Partnership NIH CFDE" ;
    ns1:dateCreated "2025-02-25" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """The workflow starts with selecting chr10:g.3823823G>A as the search term. The closest gene to the variant was found using MyVariant.info[1]. RNA-seq-like LINCS L1000 Signatures[3] which mimick or reverse the the expression of KLF6 were visualized. Median expression of KLF6 was obtained from the GTEx Portal[8] using the portal's API. To visualize the scored tissues, a vertical bar plot was created Fig.. \r
1. Lelong, S. et al. BioThings SDK: a toolkit for building high-performance data APIs in biomedical research. Bioinformatics vol. 38 2077–2079 (2022). doi:10.1093/bioinformatics/btac017\r
3. Evangelista, J. E. et al. SigCom LINCS: data and metadata search engine for a million gene expression signatures. Nucleic Acids Research vol. 50 W697–W709 (2022). doi:10.1093/nar/gkac328\r
8. Lonsdale, J. et al. The Genotype-Tissue Expression (GTEx) project. Nature Genetics vol. 45 580–585 (2013). doi:10.1038/ng.2653""" ;
    ns1:identifier "1241" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "Use Case 6: CFDE Knowledge about a Variant" ;
    ns1:url <https://workflowhub.eu/workflows/1241?version=2> ;
    ns1:version "2" .

<https://workflowhub.eu/workflows/1242?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
