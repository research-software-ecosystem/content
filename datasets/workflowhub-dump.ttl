    schema:isBasedOn "https://workflowhub.eu/workflows/897?version=2" ;
    schema:keywords "Exposomics, QCxMS, GC-MS, Metabolomics" ;
    schema:license "https://spdx.org/licenses/MIT" ;
    schema:name "End-to-end EI+ mass spectra prediction workflow using QCxMS" ;
    schema:producer <https://workflowhub.eu/projects/246>,
        <https://workflowhub.eu/projects/262> ;
