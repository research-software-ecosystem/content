    ns1:keywords "data_persistence",
        "laptop",
        "pycompss" ;
    ns1:license "Apache-2.0" ;
    ns1:name "PyCOMPSs Matrix Multiplication, out-of-core using files, reproducibility example" ;
    ns1:url <https://workflowhub.eu/workflows/838?version=1> ;
    ns1:version "1" .

