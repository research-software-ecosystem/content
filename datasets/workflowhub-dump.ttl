    schema:keywords "" ;
    schema:license "https://spdx.org/licenses/Apache-2.0" ;
    schema:name "Template for protein pockets search" ;
    schema:producer <https://workflowhub.eu/projects/198> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/2030#scipion> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/2030?version=1" ;
    schema:version 1 .

