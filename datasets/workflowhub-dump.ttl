<https://workflowhub.eu/workflows/1114?version=1> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "10.48546/workflowhub.workflow.1114.1" ;
    ns1:creator "Anna Syme" ;
    ns1:dateCreated "2024-09-03" ;
    ns1:dateModified "2026-05-13" ;
    ns1:description """**Genome assembly workflow for nanopore reads, for TSI**\r
\r
Input: \r
* Nanopore reads (can be in format: fastq, fastq.gz, fastqsanger, or fastqsanger.gz) \r
\r
Optional settings to specify when the workflow is run:\r
* [1] how many input files to split the original input into (to speed up the workflow). default = 0. example: set to 2000 to split a 60 GB read file into 2000 files of ~ 30 MB. \r
* [2] filtering: min average read quality score. default = 10\r
* [3] filtering: min read length. default = 200\r
* [4] trimming: trim this many nucleotides from start of read. default = 50\r
* [5] note: these are suggestions and will depend on the characteristics of your raw reads and downstream aims. If filtering and trimming settings are too stringent, there may be no reads remaining and workflow will fail. \r
\r
Workflow steps:\r
* [1] runs FastQC on raw reads\r
* [2] splits input reads file into separate files to speed up the next step of Porechop\r
* [3] trims nanopore adapters using Porechop\r
* [4] trims and filters nanopore reads by quality and length using Nanofilt\r
* [5] collapses back into a single read file, fastqsanger format\r
* [6] runs FastqQC on trimmed/filtered reads\r
* [7] assembles genome with Flye\r
* [8] calculates statistics on genome assembly contigs with Fasta Statistics\r
* [9] draws genome assembly graph with Bandage \r
\r
Main outputs:\r
* [1] FastQC report on raw reads, html\r
* [2] Adpater-chopped, trimmed, filtered reads in fastqsanger format\r
* [3] FastQC report on filtered reads, html\r
* [4] genome assembly contigs in fasta format (primary assembly)\r
* [5] genome assembly statistics\r
* [6] genome assembly graph in Bandage format \r
\r
Note: You may wish to plot raw reads first (e.g. using the tool NanoPlot), to get a better of idea of read lengths and quality, to decide on filtering/trimming settings.""" ;
    ns1:hasPart "bandage",
        "fastqc",
        "flye" ;
    ns1:identifier "1114" ;
    ns1:keywords "genome_assembly",
        "nanopore",
        "tsi" ;
    ns1:license "GPL-3.0-or-later" ;
    ns1:name "Genome assembly workflow for nanopore reads, for TSI" ;
    ns1:url <https://workflowhub.eu/workflows/1114?version=1> ;
    ns1:version "1" .

<https://workflowhub.eu/workflows/111?version=5> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:citation "" ;
    ns1:creator "Wolfgang Maier" ;
    ns1:dateCreated "2021-12-21" ;
    ns1:dateModified "2026-05-14" ;
    ns1:description """COVID-19: variation analysis on ARTIC ONT data
----------------------------------------------

This workflow for ONT-sequenced ARTIC data is modeled after the alignment/variant-calling steps of the [ARTIC pipeline](https://artic.readthedocs.io/en/latest/). It performs, essentially, the same steps as that pipeline’s minion command, i.e. read mapping with minimap2 and variant calling with medaka. Like the Illumina ARTIC workflow it uses ivar for primer trimming. Since ONT-sequenced reads have a much higher error rate than Illumina-sequenced reads and are therefor plagued more by false-positive variant calls, this workflow does make no attempt to handle amplicons affected by potential primer-binding site mutations.
""" ;
    ns1:hasPart "bcftools",
        "bedtools",
        "fastp",
        "freebayes",
        "ivar",
        "lofreq",
        "medaka",
        "minimap2",
        "multiqc",
        "qualimap",
        "samtools",
        "snpeff" ;
    ns1:identifier "111" ;
    ns1:keywords "artic",
        "covid-19",
        "covid19.galaxyproject.org",
        "ont" ;
    ns1:license "MIT" ;
    ns1:name "sars-cov-2-ont-artic-variant-calling/COVID-19-ARTIC-ONT" ;
    ns1:url <https://workflowhub.eu/workflows/111?version=5> ;
    ns1:version "5" .

