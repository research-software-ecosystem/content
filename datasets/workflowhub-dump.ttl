    ns1:keywords "cryoem",
        "image processing",
        "scipion",
        "spa" ;
    ns1:license "CC-BY-4.0" ;
    ns1:name "CEITEC layer 2 workflow" ;
    ns1:url <https://workflowhub.eu/workflows/600?version=1> ;
    ns1:version "1" .

