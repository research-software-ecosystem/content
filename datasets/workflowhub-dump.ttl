    schema:producer <https://workflowhub.eu/projects/261> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/1075#snakemake> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/1075?version=1" ;
    schema:version 1 .

