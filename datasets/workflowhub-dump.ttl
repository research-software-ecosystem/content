<https://workflowhub.eu/workflows/402?version=8> a ns1:ComputationalWorkflow,
        schema:SoftwareSourceCode ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/> ;
    schema:contributor <https://workflowhub.eu/people/277> ;
    schema:creativeWorkStatus "Stable" ;
    schema:creator <https://workflowhub.eu/people/277>,
        <https://workflowhub.eu/people/316> ;
    schema:dateCreated "2023-11-24T13:50:34Z" ;
    schema:dateModified "2026-05-13T13:00:41Z" ;
    schema:datePublished "2023-11-24T13:54:55Z" ;
    schema:description "This workflow is designed to analyze to a multi-omics data set that comprises genome-wide DNA methylation profiles, targeted metabolomics, and behavioral data of two cohorts that participated in the ACTION Biomarker Study (ACTION, Aggression in Children: Unraveling gene-environment interplay to inform Treatment and InterventiON strategies. (Boomsma 2015, Bartels 2018, Hagenbeek 2020, van Dongen 2021, Hagenbeek 2022). The ACTION-NTR cohort consists of twins that are either longitudinally concordant or discordant for childhood aggression. The ACTION-Curium-LUMC cohort consists of children referred to the Dutch LUMC Curium academic center for child and youth psychiatry. With the joint analysis of multi-omics data and behavioral data, we aim to identify substructures in the ACTION-NTR cohort and link them to aggressive behavior. First, the individuals are clustered using Similarity Network Fusion (SNF, Wang 2014), and latent feature dimensions are uncovered using different unsupervised methods including Multi-Omics Factor Analysis (MOFA) (Argelaguet 2018) and Multiple Correspondence Analysis (MCA, Lê 2008, Husson 2017). In a second step, we determine correlations between -omics and phenotype dimensions, and use them to explain the subgroups of individuals from the ACTION-NTR cohort. In order to validate the results, we project data of the ACTION-Curium-LUMC cohort onto the latent dimensions and determine if correlations between omics and phenotype data can be reproduced." ;
    schema:identifier "https://doi.org/10.48546/workflowhub.workflow.402.8" ;
    schema:image "https://workflowhub.eu/workflows/908/diagram?version=8" ;
    schema:isBasedOn "https://workflowhub.eu/workflows/402?version=7" ;
    schema:keywords "Multi-omics, Metabolomics, Epigenomics, Behavioral data, FAIR, Nextflow" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "X-omics ACTIONdemonstrator analysis workflow" ;
    schema:producer <https://workflowhub.eu/projects/95> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/402#nextflow> ;
    schema:sdPublisher <https://about.workflowhub.eu/> ;
    schema:url "https://workflowhub.eu/workflows/402?version=8" ;
    schema:version 8 .

