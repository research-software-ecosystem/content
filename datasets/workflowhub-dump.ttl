<https://workflowhub.eu/workflows/1200?version=2> a ns1:ComputationalWorkflow ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_0196> ;
    ns1:citation "10.48546/workflowhub.workflow.1200.2" ;
    ns1:creator "Benjamin Istace",
        "Caroline Belser",
        "Jean-Marc Aury" ;
    ns1:dateCreated "2024-11-14" ;
    ns1:dateModified "2026-07-15" ;
    ns1:description """# GALOP - Genome Assembly using Long reads Pipeline\r
\r
This repository contains an exact copy of the standard Genoscope long reads assembly pipeline.\r
\r
At the moment, this is not intended for users to download as it uses grid submission commands that will only work at Genoscope. As time goes on, we intend to make this pipeline available to a broader audience. However, genome assembly and polishing commands are accessible in the `lib/assembly.py` and `lib/polishing.py` files.\r
\r
```\r
galop.py -h\r
Mandatory arguments:\r
  --step {assembly,polishing}\r
                        Defines if the program will launch assembly or polishing scripts (default: None)\r
\r
Assembly step arguments:\r
  --proj PROJECT_CODE, -p PROJECT_CODE\r
                        Project and material codes, can be given multiple times (eg. -p BCM,A,B -p BWW,AB)\r
                        (default: None)\r
  -i INPUT_FILE         Nanopore reads fastq file (default: )\r
  --size GENOME_SIZE, -s GENOME_SIZE\r
                        Estimated size of the genome in Mb (default: None)\r
  --cov READSET_COVERAGE, -c READSET_COVERAGE\r
                        Coverage to use for longest and filtlong subsets (default: 30)\r
  --assemblers ASSEMBLER_LIST\r
                        Comma-separated list of assemblers to use (e.g. '--assemblers\r
                        Smartdenovo,Raven,Wtdbg2'will not launch flye nor Necat. Choices: Flye, Hifiasm, Necat,\r
                        Nextdenovo, Raven, Shasta,Smartdenovo, Wtdbg2 (default:\r
                        Smartdenovo,Wtdbg2,Flye,Necat,Nextdenovo)\r
  --readsets READSET_LIST\r
                        Comma-separated list of readsets to use (e.g. '--readsets Filtlong,Longest' will not\r
                        launch assemblies with all reads (default: Full,Filtlong,Longest)\r
  --no-readset          Disables readset creation (default: False)\r
  --all-readsets        Disables the use of lsRunProj to check for readset validity and instead use all available\r
                        readsets (default: False)\r
  --force               Skips directory creation (default: False)\r
  --nano-raw            Use --nano-raw instead of --nano-hq in Flye (default: False)\r
  --pacbio              Look for PacBio runs when building readsets. (default: False)\r
\r
Polishing step arguments:\r
  --model MEDAKA_MODEL, -m MEDAKA_MODEL\r
                        Model to use for medaka polishing (default: r941_prom_sup_g507)\r
  --pe1 PE1_PATH        Path to the Illumina R1 file (.gz or .fastq) (default: None)\r
  --pe2 PE2_PATH        Path to the Illumina R2 file (.gz or .fastq) (default: None)\r
  --assembly ASSEMBLY, -a ASSEMBLY\r
                        FULL PATH to the assembly to polish (default: )\r
  --assembly_dir ASSEMBLY_DIR\r
                        FULL PATH to the directory ouput of the 'nanopore_assembly_pipeline --step assembly'\r
                        (default: )\r
  --racon               Enables the racon step (default: False)\r
  --no_medaka           Skip the medaka step (default: False)\r
\r
Optional arguments:\r
  --dir OUTPUT_DIRECTORY, -d OUTPUT_DIRECTORY\r
                        Output directory (default: None)\r
  --help, -h            Show this help message and exit\r
\r
Submission arguments:\r
  --submode {msub,local}\r
                        Either submit using ccc_msub or run in local mode (default: msub)\r
  --nolaunch            Creates submission scripts but does not launch them (default: False)\r
  --account ACCOUNT     Account to use for submission (default: bistace)\r
  --qos {long,week,nolimit,xlarge,xxlarge}\r
                        QoS to use for submission (default: )\r
  --assembly_queue {normal,xlarge,small,broadwell,xxlarge}\r
                        Cluster queue to use for the assembly step (default: normal)\r
  --assembly_core ASSEMBLY_CORE_NUMBER\r
                        Number of cores to use for the assembly step (default: 36)\r
  --polishing_queue {normal,xlarge,small,broadwell,xxlarge}\r
                        Cluster queue to use for the polishing step (default: normal)\r
  --polishing_core POLISHING_CORE_NUMBER\r
                        Number of cores to use for the polishing step (default: 36)\r
  --wait                Wait for all jobs to finish before exiting (default: False)\r
```\r
""" ;
    ns1:identifier "1200" ;
    ns1:keywords "bioinformatics",
        "genome assembly" ;
    ns1:license "CECILL-2.1" ;
    ns1:name "GALOP - Genome Assembly using Long reads Pipeline" ;
    ns1:url <https://workflowhub.eu/workflows/1200?version=2> ;
    ns1:version "2" .

