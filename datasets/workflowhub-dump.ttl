    schema:keywords "image processing, cryoem, spa, scipion" ;
    schema:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema:name "CEITEC layer 1 workflow" ;
    schema:producer <https://workflowhub.eu/projects/198> ;
    schema:programmingLanguage <https://workflowhub.eu/workflows/599#scipion> ;
