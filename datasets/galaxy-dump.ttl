<https://github.com/galaxyproject/tools-iuc/tree/master/tools/kraken> a ns1:SoftwareApplication ;
    ns2:output "tabular" ;
    ns1:applicationSubCategory <http://edamontology.org/data_3028>,
        <http://edamontology.org/topic_0637>,
        <http://edamontology.org/topic_3174> ;
    ns1:codeRepository <http://ccb.jhu.edu/software/kraken/> ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:dateCreated "2017-01-24" ;
    ns1:description "Kraken is a system for assigning taxonomic labels to short DNAsequences, usually obtained through metagenomic studies. Previous attempts by otherbioinformatics software to accomplish this task have often used sequence alignmentor machine learning techniques that were quite slow, leading to the developmentof less sensitive but much faster abundance estimation programs. Kraken aims toachieve high sensitivity and high speed by utilizing exact alignments of k-mersand a novel classification algorithm." ;
    ns1:encodingFormat "tabular" ;
    ns1:featureList <http://edamontology.org/data_1872>,
        <http://edamontology.org/operation_3460> ;
    ns1:identifier <https://bio.tools/kraken>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/kraken> ;
    ns1:isPartOf <http://pepsimili.e-nios.com:8080>,
        <https://galaxy.mesocentre.uca.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.ca>,
