    ns1:codeRepository <https://jgi.doe.gov/data-and-tools/bbtools/> ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:dateCreated "2021-10-04" ;
    ns1:description "BBTools is a suite of fast, multithreaded bioinformatics tools designed for analysis of DNA and RNA sequence data.BBTools can handle common sequencing file formats such as fastq, fasta, sam, scarf, fasta+qual, compressed or raw,with autodetection of quality encoding and interleaving. It is written in Java and works on any platform supportingJava, including Linux, MacOS, and Microsoft Windows and Linux; there are no dependencies other than Java (version7 or higher). Program descriptions and options are shown when running the shell scripts with no parameters." ;
    ns1:encodingFormat "bam",
        "fasta",
        "fastq",
        "fastqsanger",
        "tabular",
        "txt",
        "vcf" ;
