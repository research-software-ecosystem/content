<https://github.com/galaxyproject/tools-iuc/tree/master/tools/megan> a ns1:SoftwareApplication ;
    ns2:output "daa",
        "rma6",
        "txt" ;
    ns1:applicationSubCategory <http://edamontology.org/operation_2403>,
        <http://edamontology.org/topic_0080> ;
    ns1:codeRepository <https://github.com/husonlab/megan-ce> ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:dateCreated "2021-11-24" ;
    ns1:description "MEGAN Community Edition - Interactive exploration and analysis of large-scale microbiome sequencing data.  MEGAN is a tool for studying the taxonomic content of a set of DNA reads, typically collected in a metagenomics project.In a preprocessing step, a sequence alignment of all reads against a suitable database of reference DNA or proteinsequences must be performed to produce an input file for the program. MEGAN is suitable for DNA reads (metagenomedata), RNA reads (metatranscriptome data), peptide sequences (metaproteomics data) and, using a suitable synonymsfile that maps SILVA ids to taxon ids, for 16S rRNA data (amplicon sequencing)." ;
    ns1:encodingFormat "daa",
        "rma6",
        "txt" ;
    ns1:featureList <http://edamontology.org/data_1872>,
        <http://edamontology.org/operation_2403>,
        <http://edamontology.org/operation_3460>,
        <http://edamontology.org/topic_0080> ;
    ns1:identifier <https://bio.tools/megan>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/megan> ;
    ns1:isPartOf <https://usegalaxy.ca>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.org.au> ;
    ns1:keywords "Sequence Analysis" ;
    ns1:name "megan" ;
    ns1:provider <https://galaxyproject.org/> ;
    ns1:softwareVersion "6.25.10" ;
    ns1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/megan> .

