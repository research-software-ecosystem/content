        <https://usegalaxy.ca>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=778923dd04996e07>,
        <https://usegalaxy.eu/published/workflow?id=77db45ad90b4033d>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au> ;
    ns1:keywords "Sequence Analysis" ;
    ns1:name "nanocompore" ;
    ns1:provider <https://galaxyproject.org/> ;
    ns1:softwareVersion "1.0.0rc3.post2" ;
    ns1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/nanocompore> .

