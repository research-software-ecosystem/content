<https://github.com/galaxyproject/tools-iuc/tree/master/tools/bbtools> a ns1:SoftwareApplication ;
    ns2:output "bam",
        "fasta",
        "fastq",
        "fastqsanger",
        "tabular",
        "txt",
        "vcf" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_3168>,
