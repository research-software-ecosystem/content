<https://github.com/galaxyproject/tools-iuc/tree/master/tools/delly> a ns1:SoftwareApplication ;
    ns2:output "bcf",
        "tabular.gz" ;
    ns1:applicationSubCategory <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_0199>,
        <http://edamontology.org/topic_0622>,
        <http://edamontology.org/topic_0634>,
        <http://edamontology.org/topic_3168>,
        <http://edamontology.org/topic_3325>,
        <http://edamontology.org/topic_3796> ;
    ns1:codeRepository <https://github.com/dellytools/delly> ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:dateCreated "2020-09-28" ;
    ns1:description "Delly is an integrated structural variant (SV) prediction method that can discover, genotype and visualize deletions, tandem duplications, inversions and translocations at single-nucleotide resolution in short-read massively parallel sequencing data. It uses paired-ends, split-reads and read-depth to sensitively and accurately delineate genomic rearrangements throughout the genome." ;
    ns1:encodingFormat "bcf",
        "tabular.gz" ;
    ns1:featureList <http://edamontology.org/operation_0452>,
        <http://edamontology.org/operation_3196>,
        <http://edamontology.org/operation_3197>,
        <http://edamontology.org/operation_3227>,
        <http://edamontology.org/operation_3228> ;
    ns1:identifier <https://bio.tools/delly2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/delly> ;
    ns1:isPartOf <https://galaxy.pasteur.fr>,
        <https://mississippi.sorbonne-universite.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.ca>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    ns1:keywords "Variant Analysis" ;
    ns1:name "delly" ;
    ns1:provider <https://galaxyproject.org/> ;
    ns1:softwareVersion "0.9.1" ;
    ns1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/delly> .

