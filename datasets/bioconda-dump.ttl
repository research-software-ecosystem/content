<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bader> a ns1:SoftwareApplication ;
    ns1:alternateName "Bayesian Analysis of Differential Expression in RNA Sequencing Data" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "For RNA sequencing count data, BADER fits a Bayesian hierarchical model. The algorithm returns the posterior probability of differential expression for each gene between two groups A and B. The joint posterior distribution of the variables in the model can be returned in the form of posterior samples, which can be used for further down-stream analyses such as gene set enrichment." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/BADER_1.48.0.tar.gz>,
