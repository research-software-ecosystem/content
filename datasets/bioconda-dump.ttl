bioconda:bioconductor-epivizr a schema1:SoftwareApplication ;
    schema1:alternateName "R Interface to epiviz web app" ;
    schema1:citation "doi:10.1038/nmeth.3038" ;
    schema1:description "This package provides connections to the epiviz web app (http://epiviz.cbcb.umd.edu) for interactive visualization of genomic data. Objects in R/bioc interactive sessions can be displayed in genome browser tracks or plots to be explored by navigation through genomic regions. Fundamental Bioconductor data structures are supported (e.g., GenomicRanges and RangedSummarizedExperiment objects), while providing an easy mechanism to support other data structures (through package epivizrData). Visualizations (using d3.js) can be easily added to the web app as well." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/epivizr_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/epivizr/epivizr_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/epivizr_2.40.0.tar.gz",
