<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/hsdecipher> a ns1:SoftwareApplication ;
    ns1:alternateName "Pipeline for the downstream analysis of highly similar duplicate genes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Many tools have been developed to measure the degree of similarity between gene duplicates within and between species.Here, we present HSDecipher, a bioinformatics pipeline to assist users in the analysis and visualization of highly similar duplicate genes (HSDs). We describe the steps for analysis of HSDs statistics, expanding HSD gene set, and visualizing the results of comparative genomic analyses. HSDecipher represents a useful tool for researchers exploring the evolution of duplicate genes in select eukaryotic species." ;
    ns1:downloadUrl <https://github.com/zx0223winner/hsdecipher_conda/archive/refs/tags/v1.1.2.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/hsdecipher> ;
    ns1:license "GPL-3.0-or-later" ;
    ns1:name "hsdecipher" ;
    ns1:provider <https://bioconda.github.io/> ;
