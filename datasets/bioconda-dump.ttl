<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-multiwgcna> a ns1:SoftwareApplication ;
    ns1:alternateName "multiWGCNA" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "An R package for deeping mining gene co-expression networks in multi-trait expression data. Provides functions for analyzing, comparing, and visualizing WGCNA networks across conditions. multiWGCNA was designed to handle the common case where there are multiple biologically meaningful sample traits, such as disease vs wildtype across development or anatomical region." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/multiWGCNA_1.7.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/multiWGCNA/multiWGCNA_1.7.0.tar.gz>,
