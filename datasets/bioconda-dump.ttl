<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-seqinfo> a ns1:SoftwareApplication ;
    ns1:alternateName "A simple S4 class for storing basic information about a collection of genomic sequences" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Seqinfo class stores the names, lengths, circularity flags, and genomes for a particular collection of sequences. These sequences are typically the chromosomes and/or scaffolds of a specific genome assembly of a given organism. Seqinfo objects are rarely used as standalone objects. Instead, they are used as part of higher-level objects to represent their seqinfo() component. Examples of such higher-level objects are GRanges, RangedSummarizedExperiment, VCF, GAlignments, etc... defined in other Bioconductor infrastructure packages." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/Seqinfo_1.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.23/bioc/src/contrib/Archive/Seqinfo/Seqinfo_1.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.23/bioc/src/contrib/Seqinfo_1.2.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-seqinfo/bioconductor-seqinfo_1.2.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-seqinfo> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-seqinfo" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
