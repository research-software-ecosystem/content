<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-receptloss> a ns1:SoftwareApplication ;
    ns1:alternateName "Unsupervised Identification of Genes with Expression Loss in Subsets of Tumors" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "receptLoss identifies genes whose expression is lost in subsets of tumors relative to normal tissue. It is particularly well-suited in cases where the number of normal tissue samples is small, as the distribution of gene expression in normal tissue samples is approximated by a Gaussian. Originally designed for identifying nuclear hormone receptor expression loss but can be applied transcriptome wide as well." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/receptLoss_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/receptLoss/receptLoss_1.18.0.tar.gz>,
