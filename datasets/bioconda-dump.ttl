<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-deconrnaseq> a ns1:SoftwareApplication ;
    ns1:alternateName "Deconvolution of Heterogeneous Tissue Samples for mRNA-Seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "DeconSeq is an R package for deconvolution of heterogeneous tissues based on mRNA-Seq data. It modeled expression levels from heterogeneous cell populations in mRNA-Seq as the weighted average of expression from different constituting cell types and predicted cell type proportions of single expression profiles." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/DeconRNASeq_1.48.0.tar.gz>,
