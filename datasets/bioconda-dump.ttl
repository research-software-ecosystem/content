<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-asurat> a ns1:SoftwareApplication ;
    ns1:alternateName "Functional annotation-driven unsupervised clustering for single-cell data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "ASURAT is a software for single-cell data analysis. Using ASURAT, one can simultaneously perform unsupervised clustering and biological interpretation in terms of cell type, disease, biological process, and signaling pathway activity. Inputting a single-cell RNA-seq data and knowledge-based databases, such as Cell Ontology, Gene Ontology, KEGG, etc., ASURAT transforms gene expression tables into original multivariate tables, termed sign-by-sample matrices (SSMs)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ASURAT_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/ASURAT_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASURAT/ASURAT_1.14.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-asurat/bioconductor-asurat_1.14.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-asurat> ;
    ns1:license "GPL-3 + file LICENSE" ;
    ns1:name "bioconductor-asurat" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-complexheatmap>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
