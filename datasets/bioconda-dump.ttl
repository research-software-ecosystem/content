<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mdqc> a ns1:SoftwareApplication ;
    ns1:alternateName "Mahalanobis Distance Quality Control for microarrays" ;
    ns1:citation <doi:10.1093/bioinformatics/btm487> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MDQC is a multivariate quality assessment method for microarrays based on quality control (QC) reports. The Mahalanobis distance of an array's quality attributes is used to measure the similarity of the quality of that array against the quality of the other arrays. Then, arrays with unusually high distances can be flagged as potentially low-quality." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/mdqc_1.72.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mdqc/mdqc_1.72.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/mdqc_1.72.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-mdqc/bioconductor-mdqc_1.72.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/mdqc>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mdqc> ;
    ns1:license "LGPL (>= 2)" ;
    ns1:name "bioconductor-mdqc" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-cluster>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-mass> ;
    ns1:softwareVersion "1.72.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/mdqc.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-memes> a ns1:SoftwareApplication ;
    ns1:alternateName "motif matching, comparison, and de novo discovery using the MEME Suite" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
