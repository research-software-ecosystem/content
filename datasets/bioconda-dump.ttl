<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-metaproviz> a ns1:SoftwareApplication ;
    ns1:alternateName "METabolomics pre-PRocessing, functiOnal analysis and VIZualisation" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MetaProViz can analyse standard metabolomics and exometabolomics data (CoRe). It performs pre-processing including feature filtering, missing value imputation, normalisation and outlier detection. It performs functional analysis including differential metabolite analysis (DMA), clustering based on regulatory rules (MCA) and contains different visualisation methods to extract biological interpretable graphs and saves them in a publication ready format." ;
    ns1:downloadUrl <https://github.com/saezlab/MetaProViz/archive/refs/tags/v4.99.1.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-metaproviz> ;
    ns1:license "BSD_3_clause + file LICENSE" ;
    ns1:name "bioconductor-metaproviz" ;
    ns1:provider <https://bioconda.github.io/> ;
