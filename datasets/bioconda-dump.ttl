<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mirnapath> a ns1:SoftwareApplication ;
    ns1:alternateName "miRNApath: Pathway Enrichment for miRNA Expression Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides pathway enrichment techniques for miRNA expression data. Specifically, the set of methods handles the many-to-many relationship between miRNAs and the multiple genes they are predicted to target (and thus affect.)  It also handles the gene-to-pathway relationships separately. Both steps are designed to preserve the additive effects of miRNAs on genes, many miRNAs affecting one gene, one miRNA affecting multiple genes, or many miRNAs affecting many genes." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/miRNApath_1.70.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/miRNApath/miRNApath_1.70.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/miRNApath_1.70.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-mirnapath/bioconductor-mirnapath_1.70.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/mirnapath>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mirnapath> ;
    ns1:license "LGPL-2.1" ;
    ns1:name "bioconductor-mirnapath" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.70.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/miRNApath.html> .

