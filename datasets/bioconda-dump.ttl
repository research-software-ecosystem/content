<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-simffpe> a ns1:SoftwareApplication ;
    ns1:alternateName "NGS Read Simulator for FFPE Tissue" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The NGS (Next-Generation Sequencing) reads from FFPE (Formalin-Fixed Paraffin-Embedded) samples contain numerous artifact chimeric reads (ACRS), which can lead to false positive structural variant calls. These ACRs are derived from the combination of two single-stranded DNA (ss-DNA) fragments with short reverse complementary regions (SRCRs). This package simulates these artifact chimeric reads as well as normal reads for FFPE samples on the whole genome / several chromosomes / large regions." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SimFFPE_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SimFFPE/SimFFPE_1.22.0.tar.gz>,
