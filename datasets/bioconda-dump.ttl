<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/eden> a ns1:SoftwareApplication ;
    ns1:alternateName "The Explicit Decomposition with Neighborhoods (EDeN) is a decompositional kernel based on the Neighborhood Subgraph Pairwise Distance Kernel (NSPDK) that can be used to induce an explicit feature representation for graphs. This in turn allows the adoption of machine learning algorithm to perform supervised and unsupervised learning task in a scalable way (e.g. using fast stochastic gradient descent methods in classification and approximate neighborhood queries in clustering)." ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Explicit Decomposition with Neighborhoods (EDeN) is a decompositional kernel based on the Neighborhood Subgraph Pairwise Distance Kernel (NSPDK) that can be used to induce an explicit feature representation for graphs. This in turn allows the adoption of machine learning algorithm to perform supervised and unsupervised learning task in a scalable way (e.g. using fast stochastic gradient descent methods in classification and approximate neighborhood queries in clustering)." ;
    ns1:downloadUrl <https://github.com/fabriziocosta/EDeN/archive/v2.0.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/eden> ;
    ns1:license "MIT" ;
    ns1:name "eden" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/biopython>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/cvxopt>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/dill>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/esmre>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/joblib>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/matplotlib>,
