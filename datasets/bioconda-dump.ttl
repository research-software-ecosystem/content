<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-vdjdive> a ns1:SoftwareApplication ;
    ns1:alternateName "Analysis Tools for 10X V(D)J Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides functions for handling and analyzing immune receptor repertoire data, such as produced by the CellRanger V(D)J pipeline. This includes reading the data into R, merging it with paired single-cell data, quantifying clonotype abundances, calculating diversity metrics, and producing common plots. It implements the E-M Algorithm for clonotype assignment, along with other methods, which makes use of ambiguous cells for improved quantification." ;
