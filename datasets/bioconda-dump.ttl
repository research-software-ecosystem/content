<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pcamethods> a ns1:SoftwareApplication ;
    ns1:alternateName "A collection of PCA methods" ;
    ns1:citation <doi:10.1093/bioinformatics/btm069> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Provides Bayesian PCA, Probabilistic PCA, Nipals PCA, Inverse Non-Linear PCA and the conventional SVD PCA. A cluster based method for missing value estimation is included for comparison. BPCA, PPCA and NipalsPCA may be used to perform PCA on incomplete data as well as for accurate missing value estimation. A set of methods for printing and plotting the results is also provided. All PCA methods make use of the same data structure (pcaRes) to provide a common interface to the PCA results. Initiated at the Max-Planck Institute for Molecular Plant Physiology, Golm, Germany." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/pcaMethods_2.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pcaMethods/pcaMethods_2.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/pcaMethods_2.2.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-pcamethods/bioconductor-pcamethods_2.2.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/pcamethods>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pcamethods> ;
    ns1:license "GPL (>= 3)" ;
    ns1:name "bioconductor-pcamethods" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
