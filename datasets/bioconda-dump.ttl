<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-derfinderhelper> a ns1:SoftwareApplication ;
    ns1:alternateName "derfinder helper package" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Helper package for speeding up the derfinder package when using multiple cores. This package is particularly useful when using BiocParallel and it helps reduce the time spent loading the full derfinder package when running the F-statistics calculation in parallel." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/derfinderHelper_1.44.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/derfinderHelper/derfinderHelper_1.44.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/derfinderHelper_1.44.0.tar.gz>,
