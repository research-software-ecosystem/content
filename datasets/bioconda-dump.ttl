<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-curatedtcgadata> a ns1:SoftwareApplication ;
    ns1:alternateName "Curated Data from The Cancer Genome Atlas (TCGA) as MultiAssayExperiment Objects" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides publicly available data from The Cancer Genome Atlas (TCGA) as MultiAssayExperiment objects. MultiAssayExperiment integrates multiple assays (e.g., RNA-seq, copy number, mutation, microRNA, protein, and others) with clinical / pathological data.  It also links assay barcodes with patient identifiers, enabling harmonized subsetting of rows (features) and columns (patients / samples) across the entire multi-'omics experiment." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/curatedTCGAData_1.32.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/curatedTCGAData/curatedTCGAData_1.32.1.tar.gz>,
