bioconda:bioconductor-edge a schema1:SoftwareApplication ;
    schema1:alternateName "Extraction of Differential Gene Expression" ;
    schema1:description "The edge package implements methods for carrying out differential expression analyses of genome-wide gene expression studies. Significance testing using the optimal discovery procedure and generalized likelihood ratio tests (equivalent to F-tests and t-tests) are implemented for general study designs. Special functions are available to facilitate the analysis of common study designs, including time course experiments. Other packages such as sva and qvalue are integrated in edge to provide a wide range of tools for gene expression analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/edge_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/edge/edge_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/edge_2.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-edge/bioconductor-edge_2.42.0_src_all.tar.gz" ;
    schema1:identifier "biotools:edge" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-edge" ;
    schema1:softwareVersion "2.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/edge.html" .

bioconda:bioconductor-edger a schema1:SoftwareApplication ;
    schema1:alternateName "Empirical Analysis of Digital Gene Expression Data in R" ;
    schema1:description "Differential expression analysis of sequence count data. Implements a range of statistical methodology based on the negative binomial distributions, including empirical Bayes estimation, exact tests, generalized linear models, quasi-likelihood, and gene set enrichment. Can perform differential analyses of any type of omics data that produces read counts, including RNA-seq, ChIP-seq, ATAC-seq, Bisulfite-seq, SAGE, CAGE, metabolomics, or proteomics spectral counts. RNA-seq analyses can be conducted at the gene or isoform level, and tests can be conducted for differential exon or transcript usage." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/edgeR_4.8.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/edgeR/edgeR_4.8.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/edgeR_4.8.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-edger/bioconductor-edger_4.8.2_src_all.tar.gz" ;
    schema1:identifier "biotools:edger",
        "usegalaxy-eu:edger" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-edger" ;
    schema1:softwareVersion "4.8.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/edgeR.html" .

bioconda:bioconductor-egsea a schema1:SoftwareApplication ;
    schema1:alternateName "Ensemble of Gene Set Enrichment Analyses" ;
    schema1:description "This package implements the Ensemble of Gene Set Enrichment Analyses (EGSEA) method for gene set testing. EGSEA algorithm utilizes the analysis results of twelve prominent GSE algorithms in the literature to calculate collective significance scores for each gene set." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/EGSEA_1.38.0.tar.gz",
