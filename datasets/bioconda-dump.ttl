<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-quantro> a ns1:SoftwareApplication ;
    ns1:alternateName "A test for when to use quantile normalization" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A data-driven test for the assumptions of quantile normalization using raw data such as objects that inherit eSets (e.g. ExpressionSet, MethylSet). Group level information about each sample (such as Tumor / Normal status) must also be provided because the test assesses if there are global differences in the distributions between the user-defined groups." ;
