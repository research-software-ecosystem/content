<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-msstatssamplesize> a ns1:SoftwareApplication ;
    ns1:alternateName "Simulation tool for optimal design of high-dimensional MS-based proteomics experiment" ;
