        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-scales> ;
    ns1:softwareVersion "2.14.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/RadioGx.html> .

