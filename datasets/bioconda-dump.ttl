<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gaga> a ns1:SoftwareApplication ;
    ns1:alternateName "GaGa hierarchical model for high-throughput data analysis" ;
    ns1:citation <doi:10.1214/09-aoas244> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Implements the GaGa model for high-throughput data analysis, including differential expression analysis, supervised gene clustering and classification. Additionally, it performs sequential sample size calculations using the GaGa and LNNGV models (the latter from EBarrays package)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/gaga_2.56.0.tar.gz>,
