        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-withr> ;
    ns1:softwareVersion "2.16.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/decoupleR.html> .

