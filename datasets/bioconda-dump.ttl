        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "2.10.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/lfa.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-linnorm> a ns1:SoftwareApplication ;
    ns1:alternateName "Linear model and normality based normalization and transformation method (Linnorm)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Linnorm is an algorithm for normalizing and transforming RNA-seq, single cell RNA-seq, ChIP-seq count data or any large scale count data. It has been independently reviewed by Tian et al. on Nature Methods (https://doi.org/10.1038/s41592-019-0425-8). Linnorm can work with raw count, CPM, RPKM, FPKM and TPM." ;
