<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rfpred> a ns1:SoftwareApplication ;
    ns1:alternateName "Assign rfPred functional prediction scores to a missense variants list" ;
    ns1:citation <doi:10.1101/037127> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Based on external numerous data files where rfPred scores are pre-calculated on all genomic positions of the human exome, the package gives rfPred scores to missense variants identified by the chromosome, the position (hg19 version), the referent and alternative nucleotids and the uniprot identifier of the protein. Note that for using the package, the user has to download the TabixFile and index (approximately 3.3 Go)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/rfPred_1.48.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rfPred/rfPred_1.48.0.tar.gz>,
