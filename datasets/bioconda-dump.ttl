<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fcoex> a ns1:SoftwareApplication ;
    ns1:alternateName "FCBF-based Co-Expression Networks for Single Cells" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The fcoex package implements an easy-to use interface to co-expression analysis based on the FCBF (Fast Correlation-Based Filter) algorithm. it was implemented especifically to deal with single-cell data. The modules found can be used to redefine cell populations, unrevel novel gene associations and predict gene function by guilt-by-association. The package structure is adapted from the CEMiTool package, relying on visualizations and code designed and written by CEMiTool's authors." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/fcoex_1.13.0.tar.gz>,
        <https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/fcoex/fcoex_1.13.0.tar.gz>,
        <https://bioconductor.org/packages/3.17/bioc/src/contrib/fcoex_1.13.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-fcoex/bioconductor-fcoex_1.13.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fcoex> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-fcoex" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-clusterprofiler>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fcbf>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pathwaypca>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-data.table>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dplyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggrepel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-igraph>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-intergraph>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-network>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-progress>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-scales>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-sna>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-stringr> ;
    ns1:softwareVersion "1.13.0" ;
    ns1:url <https://bioconductor.org/packages/3.17/bioc/html/fcoex.html> .

