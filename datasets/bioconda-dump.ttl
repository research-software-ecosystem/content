        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-survival> ;
    ns1:softwareVersion "1.20.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/GSgalgoR.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gsreg> a ns1:SoftwareApplication ;
    ns1:alternateName "Gene Set Regulation (GS-Reg)" ;
    ns1:citation <doi:10.4137/CIN.S14066> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
