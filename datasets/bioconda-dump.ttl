<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rnainteract> a ns1:SoftwareApplication ;
    ns1:alternateName "Estimate Pairwise Interactions from multidimensional features" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "RNAinteract estimates genetic interactions from multi-dimensional read-outs like features extracted from images. The screen is assumed to be performed in multi-well plates or similar designs. Starting from a list of features (e.g. cell number, area, fluorescence intensity) per well, genetic interactions are estimated. The packages provides functions for reporting interacting gene pairs, plotting heatmaps and double RNAi plots. An HTML report can be written for quality control and analysis." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/RNAinteract_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/RNAinteract/RNAinteract_1.50.0.tar.gz>,
