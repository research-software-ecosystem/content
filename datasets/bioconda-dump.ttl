<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-vmrseq> a ns1:SoftwareApplication ;
    ns1:alternateName "Probabilistic Modeling of Single-cell Methylation Heterogeneity" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "High-throughput single-cell measurements of DNA methylation allows studying inter-cellular epigenetic heterogeneity, but this task faces the challenges of sparsity and noise. We present vmrseq, a statistical method that overcomes these challenges and identifies variably methylated regions accurately and robustly." ;
