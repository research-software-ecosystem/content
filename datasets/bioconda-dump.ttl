bioconda:bioconductor-motifbreakr a schema1:SoftwareApplication ;
    schema1:alternateName "A Package For Predicting The Disruptiveness Of Single Nucleotide Polymorphisms On Transcription Factor Binding Sites" ;
    schema1:description "We introduce motifbreakR, which allows the biologist to judge in the first place whether the sequence surrounding the polymorphism is a good match, and in the second place how much information is gained or lost in one allele of the polymorphism relative to another. MotifbreakR is both flexible and extensible over previous offerings; giving a choice of algorithms for interrogation of genomes with motifs from public sources that users can choose from; these are 1) a weighted-sum probability matrix, 2) log-probabilities, and 3) weighted by relative entropy. MotifbreakR can predict effects for novel or previously described variants in public databases, making it suitable for tasks beyond the scope of its original design. Lastly, it can be used to interrogate any genome curated within Bioconductor (currently there are 32 species, a total of 109 versions)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/motifbreakR_2.24.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/motifbreakR/motifbreakR_2.24.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/motifbreakR_2.24.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-motifbreakr/bioconductor-motifbreakr_2.24.0_src_all.tar.gz" ;
    schema1:identifier "biotools:motifbreakr" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-motifbreakr" ;
    schema1:softwareVersion "2.24.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/motifbreakR.html" .

