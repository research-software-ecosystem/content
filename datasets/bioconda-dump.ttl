    ns1:license "file LICENSE" ;
    ns1:name "bioconductor-sipsic" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix> ;
    ns1:softwareVersion "1.10.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/SiPSiC.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sispa> a ns1:SoftwareApplication ;
    ns1:alternateName "SISPA: Method for Sample Integrated Set Profile Analysis" ;
    ns1:citation <doi:10.1093/nar/gkv1503> ;
