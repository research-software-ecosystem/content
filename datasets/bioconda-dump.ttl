<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-blacksheepr> a ns1:SoftwareApplication ;
    ns1:alternateName "Outlier Analysis for pairwise differential comparison" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Blacksheep is a tool designed for outlier analysis in the context of pairwise comparisons in an effort to find distinguishing characteristics from two groups. This tool was designed to be applied for biological applications such as phosphoproteomics or transcriptomics, but it can be used for any data that can be represented by a 2D table, and has two sub populations within the table to compare." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/blacksheepr_1.24.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/blacksheepr/blacksheepr_1.24.0.tar.gz>,
