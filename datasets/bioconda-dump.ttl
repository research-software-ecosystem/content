<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichdo> a ns1:SoftwareApplication ;
    ns1:alternateName "a Global Weighted Model for Disease Ontology Enrichment Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "To implement disease ontology (DO) enrichment analysis, this package is designed and presents a double weighted model based on the latest annotations of the human genome with DO terms, by integrating the DO graph topology on a global scale. This package exhibits high accuracy that it can identify more specific DO terms, which alleviates the over enriched problem. The package includes various statistical models and visualization schemes for discovering the associations between genes and diseases from biological big data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/EnrichDO_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EnrichDO/EnrichDO_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/EnrichDO_1.4.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-enrichdo/bioconductor-enrichdo_1.4.0_src_all.tar.gz> ;
