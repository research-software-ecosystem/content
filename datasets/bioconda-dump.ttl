<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-smokingmouse> a ns1:SoftwareApplication ;
    ns1:alternateName "Provides access to smokingMouse project data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This is an ExperimentHub package that provides access to the data generated and analyzed in the [smoking-nicotine-mouse](https://github.com/LieberInstitute/smoking-nicotine-mouse/) LIBD project. The datasets contain the expression data of mouse genes, transcripts, exons, and exon-exon junctions across 208 samples from pup and adult mouse brain, and adult blood, that were exposed to nicotine, cigarette smoke, or controls. They also contain relevant metadata of these samples and gene expression features, such QC metrics, if they were used after filtering steps and also if the features were differently expressed in the different experiments." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/smokingMouse_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/smokingMouse/smokingMouse_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/data/experiment/src/contrib/smokingMouse_1.8.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-smokingmouse/bioconductor-smokingmouse_1.8.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-smokingmouse> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-smokingmouse" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-data-packages>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/curl>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.8.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/data/experiment/html/smokingMouse.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-smoothclust> a ns1:SoftwareApplication ;
    ns1:alternateName "smoothclust" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Method for identification of spatial domains and spatially-aware clustering in spatial transcriptomics data. The method generates spatial domains with smooth boundaries by smoothing gene expression profiles across neighboring spatial locations, followed by unsupervised clustering. Spatial domains consisting of consistent mixtures of cell types may then be further investigated by applying cell type compositional analyses or differential analyses." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/smoothclust_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/smoothclust/smoothclust_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/smoothclust_1.6.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-smoothclust/bioconductor-smoothclust_1.6.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-smoothclust> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-smoothclust" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocneighbors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spatialexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix> ;
    ns1:softwareVersion "1.6.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/smoothclust.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-smoppix> a ns1:SoftwareApplication ;
    ns1:alternateName "Analyze Single Molecule Spatial Omics Data Using the Probabilistic Index" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Test for univariate and bivariate spatial patterns in spatial omics data with single-molecule resolution. The tests implemented allow for analysis of nested designs and are automatically calibrated to different biological specimens. Tests for aggregation, colocalization, gradients and vicinity to cell edge or centroid are provided." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/smoppix_1.2.3.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/smoppix/smoppix_1.2.3.tar.gz>,
