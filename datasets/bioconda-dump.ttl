<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cfdnakit> a ns1:SoftwareApplication ;
    ns1:alternateName "Fragmen-length analysis package from high-throughput sequencing of cell-free DNA (cfDNA)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides basic functions for analyzing shallow whole-genome sequencing (~0.3X or more) of cell-free DNA (cfDNA). The package basically extracts the length of cfDNA fragments and aids the vistualization of fragment-length information. The package also extract fragment-length information per non-overlapping fixed-sized bins and used it for calculating ctDNA estimation score (CES)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/cfdnakit_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cfdnakit/cfdnakit_1.8.0.tar.gz>,
