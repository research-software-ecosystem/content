        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gridextra>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-mass>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcpp>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcpparmadillo>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "2.8.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/DifferentialRegulation.html> .

