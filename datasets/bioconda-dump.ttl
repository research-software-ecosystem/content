<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hiergwas> a ns1:SoftwareApplication ;
    ns1:alternateName "Asessing statistical significance in predictive GWA studies" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
