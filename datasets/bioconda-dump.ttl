    ns1:softwareVersion "1.56.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/GeneExpressionSignature.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genega> a ns1:SoftwareApplication ;
