        "https://depot.galaxyproject.org/software/bioconductor-generegionscan/bioconductor-generegionscan_1.66.0_src_all.tar.gz" ;
    schema1:identifier "biotools:generegionscan" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-generegionscan" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GeneRegionScan.html" .

bioconda:bioconductor-generxcluster a schema1:SoftwareApplication ;
    schema1:alternateName "gRx Differential Clustering" ;
    schema1:description "Detect Differential Clustering of Genomic Sites such as gene therapy integrations.  The package provides some functions for exploring genomic insertion sites originating from two different sources. Possibly, the two sources are two different gene therapy vectors.  Vectors are preferred that target sensitive regions less frequently, motivating the search for localized clusters of insertions and comparison of the clusters formed by integration of different vectors.  Scan statistics allow the discovery of spatial differences in clustering and calculation of False Discovery Rates (FDRs) providing statistical methods for comparing retroviral vectors. A scan statistic for comparing two vectors using multiple window widths to detect clustering differentials and compute FDRs is implemented here." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/geneRxCluster_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneRxCluster/geneRxCluster_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneRxCluster_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-generxcluster/bioconductor-generxcluster_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:generxcluster" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-generxcluster" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/geneRxCluster.html" .

