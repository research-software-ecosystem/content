bioconda:bioconductor-genextender a schema1:SoftwareApplication ;
    schema1:alternateName "Optimized Functional Annotation Of ChIP-seq Data" ;
    schema1:description "geneXtendeR optimizes the functional annotation of ChIP-seq peaks by exploring relative differences in annotating ChIP-seq peak sets to variable-length gene bodies.  In contrast to prior techniques, geneXtendeR considers peak annotations beyond just the closest gene, allowing users to see peak summary statistics for the first-closest gene, second-closest gene, ..., n-closest gene whilst ranking the output according to biologically relevant events and iteratively comparing the fidelity of peak-to-gene overlap across a user-defined range of upstream and downstream extensions on the original boundaries of each gene's coordinates.  Since different ChIP-seq peak callers produce different differentially enriched peaks with a large variance in peak length distribution and total peak count, annotating peak lists with their nearest genes can often be a noisy process.  As such, the goal of geneXtendeR is to robustly link differentially enriched peaks with their respective genes, thereby aiding experimental follow-up and validation in designing primers for a set of prospective gene candidates during qPCR." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/geneXtendeR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneXtendeR/geneXtendeR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneXtendeR_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genextender/bioconductor-genextender_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genextender" ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-genextender" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/geneXtendeR.html" .

bioconda:bioconductor-genomation a schema1:SoftwareApplication ;
    schema1:alternateName "Summary, annotation and visualization of genomic data" ;
    schema1:description "A package for summary and annotation of genomic intervals. Users can visualize and quantify genomic intervals over pre-defined functional regions, such as promoters, exons, introns, etc. The genomic intervals represent regions with a defined chromosome position, which may be associated with a score, such as aligned reads from HT-seq experiments, TF binding sites, methylation scores, etc. The package can use any tabular genomic feature data as long as it has minimal information on the locations of genomic intervals. In addition, It can use BAM or BigWig files as input." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/genomation_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genomation/genomation_1.42.0.tar.gz",
