<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-opossom> a ns1:SoftwareApplication ;
    ns1:alternateName "Comprehensive analysis of transcriptome data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package translates microarray expression data into metadata of reduced dimension. It provides various sample-centered and group-centered visualizations, sample similarity analyses and functional enrichment analyses. The underlying SOM algorithm combines feature clustering, multidimensional scaling and dimension reduction, along with strong visualization capabilities. It enables extraction and description of functional expression modules inherent in the data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/oposSOM_2.28.0.tar.gz>,
