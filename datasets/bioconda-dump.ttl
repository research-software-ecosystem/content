<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cindex> a ns1:SoftwareApplication ;
    ns1:alternateName "Chromosome Instability Index" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The CINdex package addresses important area of high-throughput genomic analysis. It allows the automated processing and analysis of the experimental DNA copy number data generated by Affymetrix SNP 6.0 arrays or similar high throughput technologies. It calculates the chromosome instability (CIN) index that allows to quantitatively characterize genome-wide DNA copy number alterations as a measure of chromosomal instability. This package calculates not only overall genomic instability, but also instability in terms of copy number gains and losses separately at the chromosome and cytoband level." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/CINdex_1.34.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/CINdex/CINdex_1.34.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/CINdex_1.34.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-cindex/bioconductor-cindex_1.34.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/cindex>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cindex> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-cindex" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomeinfodb>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
