<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sictools> a ns1:SoftwareApplication ;
    ns1:alternateName "Find SNV/Indel differences between two bam files with near relationship" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package is to find SNV/Indel differences between two bam files with near relationship in a way of pairwise comparison thourgh each base position across the genome region of interest. The difference is inferred by fisher test and euclidean distance, the input of which is the base count (A,T,G,C) in a given position and read counts for indels that span no less than 2bp on both sides of indel region." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SICtools_1.40.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SICtools/SICtools_1.40.0.tar.gz>,
