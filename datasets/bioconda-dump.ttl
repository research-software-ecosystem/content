<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dnacycp2> a ns1:SoftwareApplication ;
    ns1:alternateName "DNA Cyclizability Prediction" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package performs prediction of intrinsic cyclizability of of every 50-bp subsequence in a DNA sequence. The input could be a file either in FASTA or text format. The output will be the C-score, the estimated intrinsic cyclizability score for each 50 bp sequences in each entry of the sequence set." ;
