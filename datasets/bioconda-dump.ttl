<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-deepsnv> a ns1:SoftwareApplication ;
    ns1:alternateName "Detection of subclonal SNVs in deep sequencing data." ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides provides quantitative variant callers for detecting subclonal mutations in ultra-deep (>=100x coverage) sequencing experiments. The deepSNV algorithm is used for a comparative setup with a control experiment of the same loci and uses a beta-binomial model and a likelihood ratio test to discriminate sequencing errors and subclonal SNVs. The shearwater algorithm computes a Bayes classifier based on a beta-binomial model for variant calling with multiple samples for precisely estimating model parameters - such as local error rates and dispersion - and prior knowledge, e.g. from variation data bases such as COSMIC." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/deepSNV_1.56.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/deepSNV/deepSNV_1.56.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/deepSNV_1.56.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-deepsnv/bioconductor-deepsnv_1.56.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/deepsnv>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-deepsnv> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-deepsnv" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rhtslib>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
