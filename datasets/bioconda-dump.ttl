<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-podcall> a ns1:SoftwareApplication ;
    ns1:alternateName "Positive Droplet Calling for DNA Methylation Droplet Digital PCR" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Reads files exported from 'QX Manager or QuantaSoft' containing amplitude values from a run of ddPCR (96 well plate) and robustly sets thresholds to determine positive droplets for each channel of each individual well. Concentration and normalized concentration in addition to other metrics is then calculated for each well. Results are returned as a table, optionally written to file, as well as optional plots (scatterplot and histogram) for both channels per well written to file. The package includes a shiny application which provides an interactive and user-friendly interface to the full functionality of PoDCall." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/PoDCall_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PoDCall/PoDCall_1.18.0.tar.gz>,
