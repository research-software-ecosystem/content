<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-apl> a ns1:SoftwareApplication ;
    ns1:alternateName "Association Plots" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "APL is a package developed for computation of Association Plots (AP), a method for visualization and analysis of single cell transcriptomics data. The main focus of APL is the identification of genes characteristic for individual clusters of cells from input data. The package performs correspondence analysis (CA) and allows to identify cluster-specific genes using Association Plots. Additionally, APL computes the cluster-specificity scores for all genes which allows to rank the genes by their specificity for a selected cell cluster of interest." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/APL_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/APL_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/APL/APL_1.14.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-apl/bioconductor-apl_1.14.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-apl> ;
    ns1:license "GPL (>= 3)" ;
    ns1:name "bioconductor-apl" ;
    ns1:provider <https://bioconda.github.io/> ;
