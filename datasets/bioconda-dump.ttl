<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hdf5array> a ns1:SoftwareApplication ;
    ns1:alternateName "HDF5 datasets as array-like objects in R" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The HDF5Array package is an HDF5 backend for DelayedArray objects. It implements the HDF5Array, H5SparseMatrix, H5ADMatrix, and TENxMatrix classes, 4 convenient and memory-efficient array-like containers for representing and manipulating either: (1) a conventional (a.k.a. dense) HDF5 dataset, (2) an HDF5 sparse matrix (stored in CSR/CSC/Yale format), (3) the central matrix of an h5ad file (or any matrix in the /layers group), or (4) a 10x Genomics sparse matrix. All these containers are DelayedArray extensions and thus support all operations (delayed or block-processed) supported by DelayedArray objects." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/HDF5Array_1.38.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HDF5Array/HDF5Array_1.38.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/HDF5Array_1.38.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-hdf5array/bioconductor-hdf5array_1.38.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/hdf5array>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hdf5array> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-hdf5array" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-delayedarray>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-h5mread>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rhdf5>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4arrays>,
