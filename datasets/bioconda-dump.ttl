bioconda:bioconductor-metcirc a schema1:SoftwareApplication ;
    schema1:alternateName "Navigating mass spectral similarity in high-resolution MS/MS metabolomics data metabolomics data" ;
    schema1:citation "doi:10.1093/bioinformatics/btx159" ;
    schema1:description "MetCirc comprises a workflow to interactively explore high-resolution MS/MS metabolomics data. MetCirc uses the Spectra object infrastructure defined in the package Spectra that stores MS/MS spectra. MetCirc offers functionality to calculate similarity between precursors based on the normalised dot product, neutral losses or user-defined functions and visualise similarities in a circular layout. Within the interactive framework the user can annotate MS/MS features based on their similarity to (known) related MS/MS features." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MetCirc_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MetCirc/MetCirc_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MetCirc_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metcirc/bioconductor-metcirc_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:metcirc" ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-metcirc" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MetCirc.html" .

bioconda:bioconductor-methped a schema1:SoftwareApplication ;
    schema1:alternateName "A DNA methylation classifier tool for the identification of pediatric brain tumor subtypes" ;
    schema1:citation "doi:10.1186/s13148-015-0103-3" ;
    schema1:description "Classification of pediatric tumors into biologically defined subtypes is challenging and multifaceted approaches are needed. For this aim, we developed a diagnostic classifier based on DNA methylation profiles. We offer MethPed as an easy-to-use toolbox that allows researchers and clinical diagnosticians to test single samples as well as large cohorts for subclass prediction of pediatric brain tumors.  The current version of MethPed can classify the following tumor diagnoses/subgroups: Diffuse Intrinsic Pontine Glioma (DIPG), Ependymoma, Embryonal tumors with multilayered rosettes (ETMR), Glioblastoma (GBM), Medulloblastoma (MB) - Group 3 (MB_Gr3), Group 4 (MB_Gr3), Group WNT (MB_WNT), Group SHH (MB_SHH) and Pilocytic Astrocytoma (PiloAstro)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MethPed_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MethPed/MethPed_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MethPed_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methped/bioconductor-methped_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:methped" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-methped" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MethPed.html" .

