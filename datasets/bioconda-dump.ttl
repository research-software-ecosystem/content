<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-metagene2> a ns1:SoftwareApplication ;
    ns1:alternateName "A package to produce metagene plots" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package produces metagene plots to compare coverages of sequencing experiments at selected groups of genomic regions. It can be used for such analyses as assessing the binding of DNA-interacting proteins at promoter regions or surveying antisense transcription over the length of a gene. The metagene2 package can manage all aspects of the analysis, from normalization of coverages to plot facetting according to experimental metadata. Bootstraping analysis is used to provide confidence intervals of per-sample mean coverages." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/metagene2_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/metagene2/metagene2_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/metagene2_1.26.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-metagene2/bioconductor-metagene2_1.26.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-metagene2> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-metagene2" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomeinfodb>,
