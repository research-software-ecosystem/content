<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nnsvg> a ns1:SoftwareApplication ;
    ns1:alternateName "Scalable identification of spatially variable genes in spatially-resolved transcriptomics data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Method for scalable identification of spatially variable genes (SVGs) in spatially-resolved transcriptomics data. The method is based on nearest-neighbor Gaussian processes and uses the BRISC algorithm for model fitting and parameter estimation. Allows identification and ranking of SVGs with flexible length scales across a tissue slide or within spatial domains defined by covariates. Scales linearly with the number of spatial locations and can be applied to datasets containing thousands or more spatial locations." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/nnSVG_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nnSVG/nnSVG_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/nnSVG_1.14.0.tar.gz>,
