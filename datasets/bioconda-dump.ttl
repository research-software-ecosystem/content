<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-macarron> a ns1:SoftwareApplication ;
    ns1:alternateName "Prioritization of potentially bioactive metabolic features from epidemiological and environmental metabolomics datasets" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Macarron is a workflow for the prioritization of potentially bioactive metabolites from metabolomics experiments. Prioritization integrates strengths of evidences of bioactivity such as covariation with a known metabolite, abundance relative to a known metabolite and association with an environmental or phenotypic indicator of bioactivity. Broadly, the workflow consists of stratified clustering of metabolic spectral features which co-vary in abundance in a condition, transfer of functional annotations, estimation of relative abundance and differential abundance analysis to identify associations between features and phenotype/condition." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/Macarron_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/Macarron/Macarron_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Macarron_1.6.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-macarron/bioconductor-macarron_1.6.0_src_all.tar.gz> ;
