<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-newwave> a ns1:SoftwareApplication ;
    ns1:alternateName "Negative binomial model for scRNA-seq" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A model designed for dimensionality reduction and batch effect removal for scRNA-seq data. It is designed to be massively parallelizable using shared objects that prevent memory duplication, and it can be used with different mini-batch approaches in order to reduce time consumption. It assumes a negative binomial distribution for the data with a dispersion parameter that can be both commonwise across gene both genewise." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/NewWave_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NewWave/NewWave_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/NewWave_1.20.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-newwave/bioconductor-newwave_1.20.0_src_all.tar.gz> ;
