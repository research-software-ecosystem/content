<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-smartphos> a ns1:SoftwareApplication ;
    ns1:alternateName "A phosphoproteomics data analysis package with an interactive ShinyApp" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "To facilitate and streamline phosphoproteomics data analysis, we developed SmartPhos, an R package for the pre-processing, quality control, and exploratory analysis of phosphoproteomics data generated by MaxQuant and Spectronaut. The package can be used either through the R command line or through an interactive ShinyApp called SmartPhos Explorer. The package contains methods such as normalization and normalization correction, transformation, imputation, batch effect correction, PCA, heatmap, differential expression, time-series clustering, gene set enrichment analysis, and kinase activity inference." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SmartPhos_1.0.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SmartPhos/SmartPhos_1.0.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SmartPhos_1.0.0.tar.gz>,
