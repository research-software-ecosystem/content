bioconda:bioconductor-chippeakanno a schema1:SoftwareApplication ;
    schema1:alternateName "Batch annotation of the peaks identified from either ChIP-seq, ChIP-chip experiments, or any experiments that result in large number of genomic interval data" ;
    schema1:description "The package encompasses a range of functions for identifying the closest gene, exon, miRNA, or custom features—such as highly conserved elements and user-supplied transcription factor binding sites. Additionally, users can retrieve sequences around the peaks and obtain enriched Gene Ontology (GO) or Pathway terms. In version 2.0.5 and beyond, new functionalities have been introduced. These include features for identifying peaks associated with bi-directional promoters along with summary statistics (peaksNearBDP), summarizing motif occurrences in peaks (summarizePatternInPeaks), and associating additional identifiers with annotated peaks or enrichedGO (addGeneIDs). The package integrates with various other packages such as biomaRt, IRanges, Biostrings, BSgenome, GO.db, multtest, and stat to enhance its analytical capabilities." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ChIPpeakAnno_3.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPpeakAnno/ChIPpeakAnno_3.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPpeakAnno_3.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chippeakanno/bioconductor-chippeakanno_3.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:chippeakanno" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-chippeakanno" ;
    schema1:softwareVersion "3.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPpeakAnno.html" .

