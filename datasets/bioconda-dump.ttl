<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-schot> a ns1:SoftwareApplication ;
    ns1:alternateName "single-cell higher order testing" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Single cell Higher Order Testing (scHOT) is an R package that facilitates testing changes in higher order structure of gene expression along either a developmental trajectory or across space. scHOT is general and modular in nature, can be run in multiple data contexts such as along a continuous trajectory, between discrete groups, and over spatial orientations; as well as accommodate any higher order measurement such as variability or correlation. scHOT meaningfully adds to first order effect testing, such as differential expression, and provides a framework for interrogating higher order interactions from single cell data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scHOT_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scHOT/scHOT_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/scHOT_1.22.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-schot/bioconductor-schot_1.22.0_src_all.tar.gz> ;
