<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-adapt> a ns1:SoftwareApplication ;
    ns1:alternateName "Analysis of Microbiome Differential Abundance by Pooling Tobit Models" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "ADAPT carries out differential abundance analysis for microbiome metagenomics data in phyloseq format. It has two innovations. One is to treat zero counts as left censored and use Tobit models for log count ratios. The other is an innovative way to find non-differentially abundant taxa as reference, then use the reference taxa to find the differentially abundant ones." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ADAPT_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/ADAPT_1.4.0.tar.gz>,
