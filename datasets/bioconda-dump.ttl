<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nempi> a ns1:SoftwareApplication ;
    ns1:alternateName "Inferring unobserved perturbations from gene expression data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Takes as input an incomplete perturbation profile and differential gene expression in log odds and infers unobserved perturbations and augments observed ones. The inference is done by iteratively inferring a network from the perturbations and inferring perturbations from the network. The network inference is done by Nested Effects Models." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/nempi_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nempi/nempi_1.18.0.tar.gz>,
