<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mastr> a ns1:SoftwareApplication ;
    ns1:alternateName "Markers Automated Screening Tool in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "mastR is an R package designed for automated screening of signatures of interest for specific research questions. The package is developed for generating refined lists of signature genes from multiple group comparisons based on the results from edgeR and limma differential expression (DE) analysis workflow. It also takes into account the background noise of tissue-specificity, which is often ignored by other marker generation tools. This package is particularly useful for the identification of group markers in various biological and medical applications, including cancer research and developmental biology." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/mastR_1.10.2.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mastR/mastR_1.10.2.tar.gz>,
