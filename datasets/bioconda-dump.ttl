<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-aggregatebiovar> a ns1:SoftwareApplication ;
    ns1:alternateName "Differential Gene Expression Analysis for Multi-subject scRNA-seq" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "For single cell RNA-seq data collected from more than one subject (e.g. biological sample or technical replicates), this package contains tools to summarize single cell gene expression profiles at the level of subject. A SingleCellExperiment object is taken as input and converted to a list of SummarizedExperiment objects, where each list element corresponds to an assigned cell type. The SummarizedExperiment objects contain aggregate gene-by-subject count matrices and inter-subject column metadata for individual subjects that can be processed using downstream bulk RNA-seq tools." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/aggregateBioVar_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/aggregateBioVar/aggregateBioVar_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/aggregateBioVar_1.20.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-aggregatebiovar/bioconductor-aggregatebiovar_1.20.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-aggregatebiovar> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-aggregatebiovar" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rlang>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tibble> ;
    ns1:softwareVersion "1.20.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/aggregateBioVar.html> .

