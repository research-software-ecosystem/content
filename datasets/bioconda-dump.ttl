bioconda:bioconductor-rtcga a schema1:SoftwareApplication ;
    schema1:alternateName "The Cancer Genome Atlas Data Integration" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The Cancer Genome Atlas (TCGA) Data Portal provides a platform for researchers to search, download, and analyze data sets generated by TCGA. It contains clinical information, genomic characterization data, and high level sequence analysis of the tumor genomes. The key is to understand genomics to improve cancer care. RTCGA package offers download and integration of the variety and volume of TCGA data using patient barcode key, what enables easier data possession. This may have an benefcial infuence on impact on development of science and improvement of patients' treatment. Furthermore, RTCGA package transforms TCGA data to tidy form which is convenient to use." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RTCGA_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RTCGA/RTCGA_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RTCGA_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtcga/bioconductor-rtcga_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rtcga" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-rtcga" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RTCGA.html" .

bioconda:bioconductor-rtcgatoolbox a schema1:SoftwareApplication ;
    schema1:alternateName "A new tool for exporting TCGA Firehose data" ;
    schema1:description "Managing data from large scale projects such as The Cancer Genome Atlas (TCGA) for further analysis is an important and time consuming step for research projects. Several efforts, such as Firehose project, make TCGA pre-processed data publicly available via web services and data portals but it requires managing, downloading and preparing the data for following steps. We developed an open source and extensible R based data client for Firehose pre-processed data and demonstrated its use with sample case studies. Results showed that RTCGAToolbox could improve data management for researchers who are interested with TCGA data. In addition, it can be integrated with other analysis pipelines for following data analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RTCGAToolbox_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RTCGAToolbox/RTCGAToolbox_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RTCGAToolbox_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtcgatoolbox/bioconductor-rtcgatoolbox_2.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rtcgatoolbox" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-rtcgatoolbox" ;
    schema1:softwareVersion "2.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RTCGAToolbox.html" .

