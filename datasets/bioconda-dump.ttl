    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/dcGSA.html" .

bioconda:bioconductor-ddct a schema1:SoftwareApplication ;
    schema1:alternateName "The ddCt Algorithm for the Analysis of Quantitative Real-Time PCR (qRT-PCR)" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The Delta-Delta-Ct (ddCt) Algorithm is an approximation method to determine relative gene expression with quantitative real-time PCR (qRT-PCR) experiments. Compared to other approaches, it requires no standard curve for each primer-target pair, therefore reducing the working load and yet returning accurate enough results as long as the assumptions of the amplification efficiency hold. The ddCt package implements a pipeline to collect, analyse and visualize qRT-PCR results, for example those from TaqMan SDM software, mainly using the ddCt method. The pipeline can be either invoked by a script in command-line or through the API consisting of S4-Classes, methods and functions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ddCt_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ddCt/ddCt_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ddCt_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ddct/bioconductor-ddct_1.66.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ddct" ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-ddct" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ddCt.html" .

