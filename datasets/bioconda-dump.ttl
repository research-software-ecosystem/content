<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-clusterprofiler> a ns1:SoftwareApplication ;
    ns1:alternateName "A universal enrichment tool for interpreting omics data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package supports functional characteristics of both coding and non-coding genomics data for thousands of species with up-to-date gene annotation. It provides a universal interface for gene functional annotation from a variety of sources and thus can be applied in diverse scenarios. It provides a tidy interface to access, manipulate, and visualize enrichment results to help users achieve efficient data interpretation. Datasets obtained from multiple treatments and time points can be analyzed and compared in a single run, easily revealing functional consensus and differences among distinct gene clusters." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/clusterProfiler_4.18.4.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clusterProfiler/clusterProfiler_4.18.4.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/clusterProfiler_4.18.4.tar.gz>,
