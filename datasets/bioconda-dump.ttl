<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rtnduals> a ns1:SoftwareApplication ;
    ns1:alternateName "Analysis of co-regulation and inference of 'dual regulons'" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "RTNduals is a tool that searches for possible co-regulatory loops between regulon pairs generated by the RTN package. It compares the shared targets in order to infer 'dual regulons', a new concept that tests whether regulators can co-operate or compete in influencing targets." ;
