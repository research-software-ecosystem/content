        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-vegan> ;
    ns1:softwareVersion "1.18.1" ;
    ns1:url <https://bioconductor.org/packages/3.17/bioc/html/BDMMAcorrect.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-beachmat.hdf5> a ns1:SoftwareApplication ;
    ns1:alternateName "beachmat bindings for HDF5-backed matrices" ;
