<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-retrofit> a ns1:SoftwareApplication ;
    ns1:alternateName "RETROFIT: Reference-free deconvolution of cell mixtures in spatial transcriptomics" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "RETROFIT is a Bayesian non-negative matrix factorization framework to decompose cell type mixtures in ST data without using external single-cell expression references. RETROFIT outperforms existing reference-based methods in estimating cell type proportions and reconstructing gene expressions in simulations with varying spot size and sample heterogeneity, irrespective of the quality or availability of the single-cell reference. RETROFIT recapitulates known cell-type localization patterns in a Slide-seq dataset of mouse cerebellum without using any single-cell data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/retrofit_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/retrofit/retrofit_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/retrofit_1.10.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-retrofit/bioconductor-retrofit_1.10.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-retrofit> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-retrofit" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/make>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcpp>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.10.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/retrofit.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rfarm> a ns1:SoftwareApplication ;
    ns1:alternateName "An R interface to the Rfam database" ;
