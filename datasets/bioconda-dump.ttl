<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lumibarnes> a ns1:SoftwareApplication ;
    ns1:alternateName "Barnes Benchmark Illumina Tissues Titration Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Barnes benchmark dataset can be used to evaluate the algorithms for Illumina microarrays. It measured a titration series of two human tissues, blood and placenta, and includes six samples with the titration ratio of blood and placenta as 100:0, 95:5, 75:25, 50:50, 25:75 and 0:100. The samples were hybridized on HumanRef-8 BeadChip (Illumina, Inc) in duplicate. The data is loaded as an LumiBatch Object (see documents in the lumi package)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/lumiBarnes_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lumiBarnes/lumiBarnes_1.50.0.tar.gz>,
