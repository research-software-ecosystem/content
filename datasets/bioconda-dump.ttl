<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichtf> a ns1:SoftwareApplication ;
    ns1:alternateName "Transcription Factors Enrichment Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "As transcription factors (TFs) play a crucial role in regulating the transcription process through binding on the genome alone or in a combinatorial manner, TF enrichment analysis is an efficient and important procedure to locate the candidate functional TFs from a set of experimentally defined regulatory regions. While it is commonly accepted that structurally related TFs may have similar binding preference to sequences (i.e. motifs) and one TF may have multiple motifs, TF enrichment analysis is much more challenging than motif enrichment analysis. Here we present a R package for TF enrichment analysis which combine motif enrichment with the PECA model." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/enrichTF_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/enrichTF/enrichTF_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/enrichTF_1.18.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-enrichtf/bioconductor-enrichtf_1.18.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichtf> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-enrichtf" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bsgenome>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-clusterprofiler>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomeinfodb>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-jaspar2018>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-motifmatchr>,
