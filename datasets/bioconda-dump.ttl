<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-vbmp> a ns1:SoftwareApplication ;
    ns1:alternateName "Variational Bayesian Multinomial Probit Regression" ;
    ns1:citation <doi:10.1093/bioinformatics/btm535> ;
