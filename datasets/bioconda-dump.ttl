        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-viridislite> ;
    ns1:softwareVersion "1.22.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/dearseq.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-decomptumor2sig> a ns1:SoftwareApplication ;
    ns1:alternateName "Decomposition of individual tumors into mutational signatures by signature refitting" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Uses quadratic programming for signature refitting, i.e., to decompose the mutation catalog from an individual tumor sample into a set of given mutational signatures (either Alexandrov-model signatures or Shiraishi-model signatures), computing weights that reflect the contributions of the signatures to the mutation load of the tumor." ;
