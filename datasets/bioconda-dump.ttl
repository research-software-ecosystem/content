<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scmap> a ns1:SoftwareApplication ;
    ns1:alternateName "A tool for unsupervised projection of single cell RNA-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Single-cell RNA-seq (scRNA-seq) is widely used to investigate the composition of complex tissues since the technology allows researchers to define cell-types using unsupervised clustering of the transcriptome. However, due to differences in experimental methods and computational analyses, it is often challenging to directly compare the cells identified in two different experiments. scmap is a method for projecting cells from a scRNA-seq experiment on to the cell-types or individual cells identified in a different experiment." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scmap_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scmap/scmap_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/scmap_1.32.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-scmap/bioconductor-scmap_1.32.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scmap> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-scmap" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/make>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
