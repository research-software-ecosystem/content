<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gcatest> a ns1:SoftwareApplication ;
    ns1:alternateName "Genotype Conditional Association TEST" ;
    ns1:citation <doi:10.1101/012682> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "GCAT is an association test for genome wide association studies that controls for population structure under a general class of trait models.  This test conditions on the trait, which makes it immune to confounding by unmodeled environmental factors.  Population structure is modeled via logistic factors, which are estimated using the `lfa` package." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/gcatest_2.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gcatest/gcatest_2.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/gcatest_2.10.0.tar.gz>,
