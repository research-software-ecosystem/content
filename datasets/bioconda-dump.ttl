        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rtsne> ;
    ns1:softwareVersion "1.28.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/CellTrails.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cellxgenedp> a ns1:SoftwareApplication ;
