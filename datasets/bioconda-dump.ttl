    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-tweedeseq" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/tweeDEseq.html" .

bioconda:bioconductor-twilight a schema1:SoftwareApplication ;
    schema1:alternateName "Estimation of local false discovery rate" ;
    schema1:citation "doi:10.1093/bioinformatics/bti436" ;
    schema1:description "In a typical microarray setting with gene expression data observed under two conditions, the local false discovery rate describes the probability that a gene is not differentially expressed between the two conditions given its corrresponding observed score or p-value level. The resulting curve of p-values versus local false discovery rate offers an insight into the twilight zone between clear differential and clear non-differential gene expression. Package 'twilight' contains two main functions: Function twilight.pval performs a two-condition test on differences in means for a given input matrix or expression set and computes permutation based p-values. Function twilight performs a stochastic downhill search to estimate local false discovery rates and effect size distributions. The package further provides means to filter for permutations that describe the null distribution correctly. Using filtered permutations, the influence of hidden confounders could be diminished." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/twilight_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/twilight/twilight_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/twilight_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-twilight/bioconductor-twilight_1.86.0_src_all.tar.gz" ;
    schema1:identifier "biotools:twilight" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-twilight" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/twilight.html" .

