<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-crupr> a ns1:SoftwareApplication ;
    ns1:alternateName "An R package to predict condition-specific enhancers from ChIP-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "An R package that offers a workflow to predict condition-specific enhancers from ChIP-seq data. The prediction of regulatory units is done in four main steps: Step 1 - the normalization of the ChIP-seq counts. Step 2 - the prediction of active enhancers binwise on the whole genome. Step 3 - the condition-specific clustering of the putative active enhancers. Step 4 - the detection of possible target genes of the condition-specific clusters using RNA-seq counts." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/crupR_1.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/crupR/crupR_1.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/crupR_1.2.0.tar.gz>,
