<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-systempipetools> a ns1:SoftwareApplication ;
    ns1:alternateName "Tools for data visualization" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "systemPipeTools package extends the widely used systemPipeR (SPR) workflow environment with an enhanced toolkit for data visualization, including utilities to automate the data visualizaton for analysis of differentially expressed genes (DEGs). systemPipeTools provides data transformation and data exploration functions via scatterplots, hierarchical clustering heatMaps, principal component analysis, multidimensional scaling, generalized principal components, t-Distributed Stochastic Neighbor embedding (t-SNE), and MA and volcano plots. All these utilities can be integrated with the modular design of the systemPipeR environment that allows users to easily substitute any of these features and/or custom with alternatives." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/systemPipeTools_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/systemPipeTools/systemPipeTools_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/systemPipeTools_1.18.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-systempipetools/bioconductor-systempipetools_1.18.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-systempipetools> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-systempipetools" ;
    ns1:provider <https://bioconda.github.io/> ;
