<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-seqsetvis> a ns1:SoftwareApplication ;
    ns1:alternateName "Set Based Visualizations for Next-Gen Sequencing Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "seqsetvis enables the visualization and analysis of sets of genomic sites in next gen sequencing data. Although seqsetvis was designed for the comparison of mulitple ChIP-seq samples, this package is domain-agnostic and allows the processing of multiple genomic coordinate files (bed-like files) and signal files (bigwig files pileups from bam file). seqsetvis has multiple functions for fetching data from regions into a tidy format for analysis in data.table or tidyverse and visualization via ggplot2." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/seqsetvis_1.30.2.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/seqsetvis/seqsetvis_1.30.2.tar.gz>,
