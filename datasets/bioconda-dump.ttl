<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summix> a ns1:SoftwareApplication ;
    ns1:alternateName "Summix2: A suite of methods to estimate, adjust, and leverage substructure in genetic summary data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package contains the Summix2 method for estimating and adjusting for substructure in genetic summary allele frequency data. The function summix() estimates reference group proportions using a mixture model. The adjAF() function produces adjusted allele frequencies for an observed group with reference group proportions matching a target individual or sample. The summix_local() function estimates local ancestry mixture proportions and performs selection scans in genetic summary data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/Summix_2.16.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Summix/Summix_2.16.0.tar.gz>,
