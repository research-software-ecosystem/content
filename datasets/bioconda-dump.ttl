    ns1:softwareVersion "1.28.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/MPRAnalyze.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mqmetrics> a ns1:SoftwareApplication ;
    ns1:alternateName "Quality Control of Protemics Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The package MQmetrics (MaxQuant metrics) provides a workflow to analyze the quality and reproducibility of your proteomics mass spectrometry analysis from MaxQuant.Input data are extracted from several MaxQuant output tables and produces a pdf report. It includes several visualization tools to check numerous parameters regarding the quality of the runs. It also includes two functions to visualize the iRT peptides from Biognosys in case they were spiked in the samples." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MQmetrics_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/MQmetrics/MQmetrics_1.10.0.tar.gz>,
