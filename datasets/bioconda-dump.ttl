<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-moleculeexperiment> a ns1:SoftwareApplication ;
    ns1:alternateName "Prioritising a molecule-level storage of Spatial Transcriptomics Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MoleculeExperiment contains functions to create and work with objects from the new MoleculeExperiment class. We introduce this class for analysing molecule-based spatial transcriptomics data (e.g., Xenium by 10X, Cosmx SMI by Nanostring, and Merscope by Vizgen). This allows researchers to analyse spatial transcriptomics data at the molecule level, and to have standardised data formats accross vendors." ;
