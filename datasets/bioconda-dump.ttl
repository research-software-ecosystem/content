<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dnea> a ns1:SoftwareApplication ;
    ns1:alternateName "Differential Network Enrichment Analysis for Biological Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The DNEA R package is the latest implementation of the Differential Network Enrichment Analysis algorithm and is the successor to the Filigree Java-application described in Iyer et al. (2020). The package is designed to take as input an m x n expression matrix for some -omics modality (ie. metabolomics, lipidomics, proteomics, etc.) and jointly estimate the biological network associations of each condition using the DNEA algorithm described in Ma et al. (2019). This approach provides a framework for data-driven enrichment analysis across two experimental conditions that utilizes the underlying correlation structure of the data to determine feature-feature interactions." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/DNEA_1.0.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DNEA/DNEA_1.0.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/DNEA_1.0.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-dnea/bioconductor-dnea_1.0.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dnea> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-dnea" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dplyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gdata>,
