<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-zinbwave> a ns1:SoftwareApplication ;
    ns1:alternateName "Zero-Inflated Negative Binomial Model for RNA-Seq Data" ;
    ns1:citation <doi:10.1038/s41467-017-02554-5> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Implements a general and flexible zero-inflated negative binomial model that can be used to provide a low-dimensional representations of single-cell RNA-seq data. The model accounts for zero inflation (dropouts), over-dispersion, and the count nature of the data. The model also accounts for the difference in library sizes and optionally for batch effects and/or other covariates, avoiding the need for pre-normalize the data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/zinbwave_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/zinbwave/zinbwave_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/zinbwave_1.32.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-zinbwave/bioconductor-zinbwave_1.32.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/zinbwave>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-zinbwave> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-zinbwave" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-edger>,
