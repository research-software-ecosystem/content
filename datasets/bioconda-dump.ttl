<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scbfa> a ns1:SoftwareApplication ;
    ns1:alternateName "A dimensionality reduction tool using gene detection pattern to mitigate noisy expression profile of scRNA-seq" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package is designed to model gene detection pattern of scRNA-seq through a binary factor analysis model. This model allows user to pass into a cell level covariate matrix X and gene level covariate matrix Q to account for nuisance variance(e.g batch effect), and it will output a low dimensional embedding matrix for downstream analysis." ;
