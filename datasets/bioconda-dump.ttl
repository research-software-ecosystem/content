<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-normalize450k> a ns1:SoftwareApplication ;
    ns1:alternateName "Preprocessing of Illumina Infinium 450K data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Precise measurements are important for epigenome-wide studies investigating DNA methylation in whole blood samples, where effect sizes are expected to be small in magnitude. The 450K platform is often affected by batch effects and proper preprocessing is recommended. This package provides functions to read and normalize 450K '.idat' files. The normalization corrects for dye bias and biases related to signal intensity and methylation of probes using local regression. No adjustment for probe type bias is performed to avoid the trade-off of precision for accuracy of beta-values." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/normalize450K_1.38.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/normalize450K/normalize450K_1.38.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/normalize450K_1.38.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-normalize450k/bioconductor-normalize450k_1.38.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-normalize450k> ;
    ns1:license "BSD_2_clause + file LICENSE" ;
    ns1:name "bioconductor-normalize450k" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-illuminaio>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-quadprog> ;
    ns1:softwareVersion "1.38.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/normalize450K.html> .

