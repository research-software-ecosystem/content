<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-screcover> a ns1:SoftwareApplication ;
    ns1:alternateName "scRecover for imputation of single-cell RNA-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "scRecover is an R package for imputation of single-cell RNA-seq (scRNA-seq) data. It will detect and impute dropout values in a scRNA-seq raw read counts matrix while keeping the real zeros unchanged, since there are both dropout zeros and real zeros in scRNA-seq data. By combination with scImpute, SAVER and MAGIC, scRecover not only detects dropout and real zeros at higher accuracy, but also improve the downstream clustering and visualization results." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scRecover_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scRecover/scRecover_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/scRecover_1.26.0.tar.gz>,
