<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-similarpeak> a ns1:SoftwareApplication ;
    ns1:alternateName "Metrics to estimate a level of similarity between two ChIP-Seq profiles" ;
    ns1:citation <doi:10.1371/journal.pcbi.1004751> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
