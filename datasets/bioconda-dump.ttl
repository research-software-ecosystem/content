        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tca> ;
    ns1:softwareVersion "1.8.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/MICSQTL.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-midashla> a ns1:SoftwareApplication ;
    ns1:alternateName "R package for immunogenomics data handling and association analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MiDAS is a R package for immunogenetics data transformation and statistical analysis. MiDAS accepts input data in the form of HLA alleles and KIR types, and can transform it into biologically meaningful variables, enabling HLA amino acid fine mapping, analyses of HLA evolutionary divergence, KIR gene presence, as well as validated HLA-KIR interactions. Further, it allows comprehensive statistical association analysis workflows with phenotypes of diverse measurement scales. MiDAS closes a gap between the inference of immunogenetic variation and its efficient utilization to make relevant discoveries related to T cell, Natural Killer cell, and disease biology." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/midasHLA_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/midasHLA/midasHLA_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/midasHLA_1.18.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-midashla/bioconductor-midashla_1.18.0_src_all.tar.gz> ;
