<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-tidysinglecellexperiment> a ns1:SoftwareApplication ;
    ns1:alternateName "Brings SingleCellExperiment to the Tidyverse" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "'tidySingleCellExperiment' is an adapter that abstracts the 'SingleCellExperiment' container in the form of a 'tibble'. This allows *tidy* data manipulation, nesting, and plotting. For example, a 'tidySingleCellExperiment' is directly compatible with functions from 'tidyverse' packages `dplyr` and `tidyr`, as well as plotting with `ggplot2` and `plotly`. In addition, the package provides various utility functions specific to single-cell omics data analysis (e.g., aggregation of cell-level data to pseudobulks)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/tidySingleCellExperiment_1.20.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/tidySingleCellExperiment/tidySingleCellExperiment_1.20.1.tar.gz>,
