<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-desubs> a ns1:SoftwareApplication ;
    ns1:alternateName "DEsubs: an R package for flexible identification of differentially expressed subpathways using RNA-seq expression experiments" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "DEsubs is a network-based systems biology package that extracts disease-perturbed subpathways within a pathway network as recorded by RNA-seq experiments. It contains an extensive and customizable framework covering a broad range of operation modes at all stages of the subpathway analysis, enabling a case-specific approach. The operation modes refer to the pathway network construction and processing, the subpathway extraction, visualization and enrichment analysis with regard to various biological and pharmacological features. Its capabilities render it a tool-guide for both the modeler and experimentalist for the identification of more robust systems-level biomarkers for complex diseases." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/DEsubs_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEsubs/DEsubs_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/DEsubs_1.36.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-desubs/bioconductor-desubs_1.36.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-desubs> ;
