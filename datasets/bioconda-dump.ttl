<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hilbertcurve> a ns1:SoftwareApplication ;
    ns1:alternateName "Making 2D Hilbert Curve" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
