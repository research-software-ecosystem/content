<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scoup> a ns1:SoftwareApplication ;
    ns1:alternateName "Simulate Codons with Darwinian Selection Modelled as an OU Process" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "An elaborate molecular evolutionary framework that facilitates straightforward simulation of codon genetic sequences subjected to different degrees and/or patterns of Darwinian selection. The model is built upon the fitness landscape paradigm of Sewall Wright, as popularised by the mutation-selection model of Halpern and Bruno. This enables realistic evolutionary process of living organisms to be reproducible seamlessly. For example, an Ornstein-Uhlenbeck fitness update algorithm is incorporated herein. Consequently, otherwise complex biological processes, such as the effect of the interplay between genetic drift and fitness landscape fluctuations on the inference of diversifying selection, may now be investigated with minimal effort. Frequency-dependent and stochastic fitness landscape update techniques are available." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scoup_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scoup/scoup_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/scoup_1.4.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-scoup/bioconductor-scoup_1.4.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scoup> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-scoup" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix> ;
    ns1:softwareVersion "1.4.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/scoup.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scp> a ns1:SoftwareApplication ;
    ns1:alternateName "Mass Spectrometry-Based Single-Cell Proteomics Data Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Utility functions for manipulating, processing, and analyzing mass spectrometry-based single-cell proteomics data. The package is an extension to the 'QFeatures' package and relies on 'SingleCellExpirement' to enable single-cell proteomics analyses. The package offers the user the functionality to process quantitative table (as generated by MaxQuant, Proteome Discoverer, and more) into data tables ready for downstream analysis and data visualization." ;
