        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tibble> ;
    ns1:softwareVersion "1.20.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/transomics2cytoscape.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-transomicsdata> a ns1:SoftwareApplication ;
    ns1:alternateName "A collection of trans-omics datasets across various biological systems" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Contains a collection of trans-omics datasets generated using various sequencing technologies such as RNA-seq, Mass spectrometry and ChIP-seq. Modalities include the bulk profiling of the phosphoproteome, proteome, transcriptome and epigenome. Data reflects the timecourses of different developmental systems from the mouse or human." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/TransOmicsData_1.6.0.tar.gz>,
