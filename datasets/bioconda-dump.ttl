<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sparsesignatures> a ns1:SoftwareApplication ;
    ns1:alternateName "SparseSignatures" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Point mutations occurring in a genome can be divided into 96 categories based on the base being mutated, the base it is mutated into and its two flanking bases. Therefore, for any patient, it is possible to represent all the point mutations occurring in that patient's tumor as a vector of length 96, where each element represents the count of mutations for a given category in the patient. A mutational signature represents the pattern of mutations produced by a mutagen or mutagenic process inside the cell. Each signature can also be represented by a vector of length 96, where each element represents the probability that this particular mutagenic process generates a mutation of the 96 above mentioned categories. In this R package, we provide a set of functions to extract and visualize the mutational signatures that best explain the mutation counts of a large number of patients." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SparseSignatures_2.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SparseSignatures/SparseSignatures_2.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SparseSignatures_2.20.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-sparsesignatures/bioconductor-sparsesignatures_2.20.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sparsesignatures> ;
    ns1:license "file LICENSE" ;
    ns1:name "bioconductor-sparsesignatures" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bsgenome>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomeinfodb>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-data.table>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gridextra>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-nmf>,
