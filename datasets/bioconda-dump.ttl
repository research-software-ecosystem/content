        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-data.table>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-glue>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-lsa>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rlang> ;
    ns1:softwareVersion "2.14.0" ;
