    schema1:license "GPL (>=3) + file LICENSE" ;
    schema1:name "bioconductor-bioqc" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BioQC.html" .

bioconda:bioconductor-biosigner a schema1:SoftwareApplication ;
    schema1:alternateName "Signature discovery from omics data" ;
    schema1:citation "doi:10.3389/fmolb.2016.00026" ;
    schema1:description "Feature selection is critical in omics data analysis to extract restricted and meaningful molecular signatures from complex and high-dimension data, and to build robust classifiers. This package implements a new method to assess the relevance of the variables for the prediction performances of the classifier. The approach can be run in parallel with the PLS-DA, Random Forest, and SVM binary classifiers. The signatures and the corresponding 'restricted' models are returned, enabling future predictions on new datasets. A Galaxy implementation of the package is available within the Workflow4metabolomics.org online infrastructure for computational metabolomics." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/biosigner_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/biosigner/biosigner_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/biosigner_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biosigner/bioconductor-biosigner_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:biosigner" ;
    schema1:license "CeCILL" ;
    schema1:name "bioconductor-biosigner" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/biosigner.html" .

