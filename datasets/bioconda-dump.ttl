        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-checkmate>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-circlize>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-colorspace>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-data.table>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dplyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-forcats>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-futile.logger>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
