<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scbubbletree> a ns1:SoftwareApplication ;
    ns1:alternateName "Quantitative visual exploration of scRNA-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "scBubbletree is a quantitative method for the visual exploration of scRNA-seq data, preserving key biological properties such as local and global cell distances and cell density distributions across samples. It effectively resolves overplotting and enables the visualization of diverse cell attributes from multiomic single-cell experiments. Additionally, scBubbletree is user-friendly and integrates seamlessly with popular scRNA-seq analysis tools, facilitating comprehensive and intuitive data interpretation." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scBubbletree_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scBubbletree/scBubbletree_1.12.0.tar.gz>,
