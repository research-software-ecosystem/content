        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-htmlwidgets>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-magrittr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-stringr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-yaml> ;
    ns1:softwareVersion "2.16.4" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/systemPipeR.html> .

