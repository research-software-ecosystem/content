        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-vgam> ;
    ns1:softwareVersion "1.30.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/DEsingle.html> .

