        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-r.matlab>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcolorbrewer>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-scales>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-xtable> ;
    ns1:softwareVersion "2.42.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/TRONCO.html> .

