        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-shinydashboard>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-svglite>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-svgpanzoom>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-viridis> ;
    ns1:softwareVersion "1.22.0" ;
