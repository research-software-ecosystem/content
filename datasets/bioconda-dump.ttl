    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-limpca> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-limpca" ;
    ns1:provider <https://bioconda.github.io/> ;
