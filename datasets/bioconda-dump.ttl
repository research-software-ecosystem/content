        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.16.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/iPath.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-ipddb> a ns1:SoftwareApplication ;
