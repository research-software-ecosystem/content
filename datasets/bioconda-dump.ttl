        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/xorg-libxfixes> ;
    ns1:softwareVersion "1.6.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/PLSDAbatch.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-plyinteractions> a ns1:SoftwareApplication ;
