        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-txdb.hsapiens.ucsc.hg19.knowngene>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-variantannotation>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-googlevis>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gtools> ;
    ns1:softwareVersion "2.38.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/RareVariantVis.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rarr> a ns1:SoftwareApplication ;
    ns1:alternateName "Read Zarr Files in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Zarr specification defines a format for chunked, compressed, N-dimensional arrays.  It's design allows efficient access to subsets of the stored array, and supports both local and cloud storage systems.  Rarr aims to implement this specification in R with minimal reliance on an external tools or libraries." ;
