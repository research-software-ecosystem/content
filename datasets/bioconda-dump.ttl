<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hicool> a ns1:SoftwareApplication ;
    ns1:alternateName "HiCool" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "HiCool provides an R interface to process and normalize Hi-C paired-end fastq reads into .(m)cool files. .(m)cool is a compact, indexed HDF5 file format specifically tailored for efficiently storing HiC-based data. On top of processing fastq reads, HiCool provides a convenient reporting function to generate shareable reports summarizing Hi-C experiments and including quality controls." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/HiCool_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/HiCool/HiCool_1.6.0.tar.gz>,
