<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-podkat> a ns1:SoftwareApplication ;
    ns1:alternateName "Position-Dependent Kernel Association Test" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides an association test that is capable of dealing with very rare and even private variants. This is accomplished by a kernel-based approach that takes the positions of the variants into account. The test can be used for pre-processed matrix data, but also directly for variant data stored in VCF files. Association testing can be performed whole-genome, whole-exome, or restricted to pre-defined regions of interest. The test is complemented by tools for analyzing and visualizing the results." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/podkat_1.42.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/podkat/podkat_1.42.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/podkat_1.42.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-podkat/bioconductor-podkat_1.42.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/podkat>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-podkat> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-podkat" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
