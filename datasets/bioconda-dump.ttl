bioconda:bioconductor-drivernet a schema1:SoftwareApplication ;
    schema1:alternateName "Drivernet: uncovering somatic driver mutations modulating transcriptional networks in cancer" ;
    schema1:citation "doi:10.1186/gb-2012-13-12-r124" ;
    schema1:description "DriverNet is a package to predict functional important driver genes in cancer by integrating genome data (mutation and copy number variation data) and transcriptome data (gene expression data). The different kinds of data are combined by an influence graph, which is a gene-gene interaction network deduced from pathway data. A greedy algorithm is used to find the possible driver genes, which may mutated in a larger number of patients and these mutations will push the gene expression values of the connected genes to some extreme values." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DriverNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DriverNet/DriverNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DriverNet_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-drivernet/bioconductor-drivernet_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:drivernet" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-drivernet" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DriverNet.html" .

bioconda:bioconductor-dropletutils a schema1:SoftwareApplication ;
    schema1:alternateName "Utilities for Handling Single-Cell Droplet Data" ;
    schema1:description "Provides a number of utility functions for handling single-cell (RNA-seq) data from droplet technologies such as 10X Genomics. This includes data loading from count matrices or molecule information files, identification of cells from empty droplets, removal of barcode-swapped pseudo-cells, and downsampling of the count matrix." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DropletUtils_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DropletUtils/DropletUtils_1.30.0.tar.gz",
