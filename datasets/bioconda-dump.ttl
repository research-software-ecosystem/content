    ns1:softwareVersion "1.38.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/dada2.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dexseq> a ns1:SoftwareApplication ;
    ns1:alternateName "Inference of differential exon usage in RNA-Seq" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The package is focused on finding differential exon usage using RNA-seq exon counts between samples with different experimental designs. It provides functions that allows the user to make the necessary statistical tests based on a model that uses the negative binomial distribution to estimate the variance between biological replicates and generalized linear models for testing. The package also provides functions for the visualization and exploration of the results." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/DEXSeq_1.56.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEXSeq/DEXSeq_1.56.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/DEXSeq_1.56.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-dexseq/bioconductor-dexseq_1.56.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/dexseq>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dexseq>,
        "usegalaxy-eu:dexseq" ;
