<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-meb> a ns1:SoftwareApplication ;
    ns1:alternateName "A normalization-invariant minimum enclosing ball method to detect differentially expressed genes for RNA-seq and scRNA-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides a method to identify differential expression genes in the same or different species. Given that non-DE genes have some similarities in features, a scaling-free minimum enclosing ball (SFMEB) model is built to cover those non-DE genes in feature space, then those DE genes, which are enormously different from non-DE genes, being regarded as outliers and rejected outside the ball. The method on this package is described in the article 'A minimum enclosing ball method to detect differential expression genes for RNA-seq data'. The SFMEB method is extended to the scMEB method that considering two or more potential types of cells or unknown labels scRNA-seq dataset DEGs identification." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MEB_1.24.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MEB/MEB_1.24.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/MEB_1.24.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-meb/bioconductor-meb_1.24.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-meb> ;
    ns1:license "GPL-2" ;
    ns1:name "bioconductor-meb" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-edger>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scater>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
