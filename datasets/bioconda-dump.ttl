<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nullranges> a ns1:SoftwareApplication ;
    ns1:alternateName "Generation of null ranges via bootstrapping or covariate matching" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Modular package for generation of sets of ranges representing the null hypothesis. These can take the form of bootstrap samples of ranges (using the block bootstrap framework of Bickel et al 2010), or sets of control ranges that are matched across one or more covariates. nullranges is designed to be inter-operable with other packages for analysis of genomic overlap enrichment, including the plyranges Bioconductor package." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/nullranges_1.16.3.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nullranges/nullranges_1.16.3.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/nullranges_1.16.3.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-nullranges/bioconductor-nullranges_1.16.3_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nullranges> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-nullranges" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-interactionset>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
