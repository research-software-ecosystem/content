    ns1:softwareVersion "1.48.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/tRanslatome.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-transmogr> a ns1:SoftwareApplication ;
    ns1:alternateName "Modify a set of reference sequences using a set of variants" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "transmogR provides the tools needed to crate a new reference genome or reference transcriptome, using a set of variants. Variants can be any combination of SNPs, Insertions and Deletions. The intended use-case is to enable creation of variant-modified reference transcriptomes for incorporation into transcriptomic pseudo-alignment workflows, such as salmon." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/transmogR_1.6.0.tar.gz>,
