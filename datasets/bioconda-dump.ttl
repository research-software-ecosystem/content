<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-diffcoexp> a ns1:SoftwareApplication ;
    ns1:alternateName "Differential Co-expression Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A tool for the identification of differentially coexpressed links (DCLs) and differentially coexpressed genes (DCGs). DCLs are gene pairs with significantly different correlation coefficients under two conditions. DCGs are genes with significantly more DCLs than by chance." ;
