<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dss> a ns1:SoftwareApplication ;
    ns1:alternateName "Dispersion shrinkage for sequencing data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "DSS is an R library performing differntial analysis for count-based sequencing data. It detectes differentially expressed genes (DEGs) from RNA-seq, and differentially methylated loci or regions (DML/DMRs) from bisulfite sequencing (BS-seq). The core of DSS is a new dispersion shrinkage method for estimating the dispersion parameter from Gamma-Poisson or Beta-Binomial distributions." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/DSS_2.58.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DSS/DSS_2.58.0.tar.gz>,
