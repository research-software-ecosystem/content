<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fella> a ns1:SoftwareApplication ;
    ns1:alternateName "Interpretation and enrichment for metabolomics data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
