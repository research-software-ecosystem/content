    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scdataviz> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-scdataviz" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-flowcore>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
