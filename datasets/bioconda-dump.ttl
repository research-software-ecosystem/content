<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-demuxmix> a ns1:SoftwareApplication ;
    ns1:alternateName "Demultiplexing oligo-barcoded scRNA-seq data using regression mixture models" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A package for demultiplexing single-cell sequencing experiments of pooled cells labeled with barcode oligonucleotides. The package implements methods to fit regression mixture models for a probabilistic classification of cells, including multiplet detection. Demultiplexing error rates can be estimated, and methods for quality control are provided." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/demuxmix_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/demuxmix/demuxmix_1.12.0.tar.gz>,
