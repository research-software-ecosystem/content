<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mirsponger> a ns1:SoftwareApplication ;
    ns1:alternateName "Identification and analysis of miRNA sponge regulation" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides several functions to explore miRNA sponge (also called ceRNA or miRNA decoy) regulation from putative miRNA-target interactions or/and transcriptomics data (including bulk, single-cell and spatial gene expression data). It provides eight popular methods for identifying miRNA sponge interactions, and an integrative method to integrate miRNA sponge interactions from different methods, as well as the functions to validate miRNA sponge interactions, and infer miRNA sponge modules, conduct enrichment analysis of miRNA sponge modules, and conduct survival analysis of miRNA sponge modules. By using a sample control variable strategy, it provides a function to infer sample-specific miRNA sponge interactions. In terms of sample-specific miRNA sponge interactions, it implements three similarity methods to construct sample-sample correlation network." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/miRspongeR_2.14.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/miRspongeR/miRspongeR_2.14.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/miRspongeR_2.14.1.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-mirsponger/bioconductor-mirsponger_2.14.1_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mirsponger> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-mirsponger" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-clusterprofiler>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dose>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-org.hs.eg.db>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-reactomepa>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sponge>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
