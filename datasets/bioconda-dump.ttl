<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cetf> a ns1:SoftwareApplication ;
    ns1:alternateName "Coexpression for Transcription Factors using Regulatory Impact Factors and Partial Correlation and Information Theory analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides the necessary functions for performing the Partial Correlation coefficient with Information Theory (PCIT) (Reverter and Chan 2008) and Regulatory Impact Factors (RIF) (Reverter et al. 2010) algorithm. The PCIT algorithm identifies meaningful correlations to define edges in a weighted network and can be applied to any correlation-based network including but not limited to gene co-expression networks, while the RIF algorithm identify critical Transcription Factors (TF) from gene expression data. These two algorithms when combined provide a very relevant layer of information for gene expression studies (Microarray, RNA-seq and single-cell RNA-seq data)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/CeTF_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CeTF/CeTF_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/CeTF_1.22.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-cetf/bioconductor-cetf_1.22.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cetf> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-cetf" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-clusterprofiler>,
