<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hicparser> a ns1:SoftwareApplication ;
    ns1:alternateName "Parser for HiC data in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package is a parser to import HiC data into R. It accepts several type of data: tabular files, Cooler `.cool` or `.mcool` files, Juicer `.hic` files or HiC-Pro `.matrix` and `.bed` files. The HiC data can be several files, for several replicates and conditions. The data is formated in an InteractionSet object." ;
