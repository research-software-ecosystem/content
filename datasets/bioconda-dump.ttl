<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-recount3> a ns1:SoftwareApplication ;
    ns1:alternateName "Explore and download data from the recount3 project" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
