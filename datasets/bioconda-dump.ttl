<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-ocplus> a ns1:SoftwareApplication ;
    ns1:alternateName "Operating characteristics plus sample size and local fdr for microarray experiments" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package allows to characterize the operating characteristics of a microarray experiment, i.e. the trade-off between false discovery rate and the power to detect truly regulated genes. The package includes tools both for planned experiments (for sample size assessment) and for already collected data (identification of differentially expressed genes)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/OCplus_1.84.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OCplus/OCplus_1.84.0.tar.gz>,
