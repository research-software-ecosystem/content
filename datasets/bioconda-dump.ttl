<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-motif2site> a ns1:SoftwareApplication ;
    ns1:alternateName "Detect binding sites from motifs and ChIP-seq experiments, and compare binding sites across conditions" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Detect binding sites using motifs IUPAC sequence or bed coordinates and ChIP-seq experiments in bed or bam format. Combine/compare binding sites across experiments, tissues, or conditions. All normalization and differential steps are done using TMM-GLM method. Signal decomposition is done by setting motifs as the centers of the mixture of normal distribution curves." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/Motif2Site_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Motif2Site/Motif2Site_1.14.0.tar.gz>,
