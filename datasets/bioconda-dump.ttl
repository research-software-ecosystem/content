<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dks> a ns1:SoftwareApplication ;
    ns1:alternateName "The double Kolmogorov-Smirnov package for evaluating multiple testing procedures." ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The dks package consists of a set of diagnostic functions for multiple testing methods. The functions can be used to determine if the p-values produced by a multiple testing procedure are correct. These functions are designed to be applied to simulated data. The functions require the entire set of p-values from multiple simulated studies, so that the joint distribution can be evaluated." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/dks_1.56.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dks/dks_1.56.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/dks_1.56.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-dks/bioconductor-dks_1.56.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dks> ;
    ns1:license "GPL" ;
    ns1:name "bioconductor-dks" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-cubature> ;
    ns1:softwareVersion "1.56.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/dks.html> .

