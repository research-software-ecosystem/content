<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-comapr> a ns1:SoftwareApplication ;
    ns1:alternateName "Crossover analysis and genetic map construction" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "comapr detects crossover intervals for single gametes from their haplotype states sequences and stores the crossovers in GRanges object. The genetic distances can then be calculated via the mapping functions using estimated crossover rates for maker intervals. Visualisation functions for plotting interval-based genetic map or cumulative genetic distances are implemented, which help reveal the variation of crossovers landscapes across the genome and across individuals." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/comapr_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/comapr/comapr_1.10.0.tar.gz>,
