<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-semisup> a ns1:SoftwareApplication ;
    ns1:alternateName "Semi-Supervised Mixture Model" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
