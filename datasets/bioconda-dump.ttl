<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-exomecopy> a ns1:SoftwareApplication ;
    ns1:alternateName "Copy number variant detection from exome sequencing read depth" ;
    ns1:citation <doi:10.2202/1544-6115.1732> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Detection of copy number variants (CNV) from exome sequencing samples, including unpaired samples.  The package implements a hidden Markov model which uses positional covariates, such as background read depth and GC-content, to simultaneously normalize and segment the samples into regions of constant copy count." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/exomeCopy_1.48.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/exomeCopy/exomeCopy_1.48.0.tar.gz>,
