    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-msmstests> ;
    ns1:license "GPL-2" ;
    ns1:name "bioconductor-msmstests" ;
    ns1:provider <https://bioconda.github.io/> ;
