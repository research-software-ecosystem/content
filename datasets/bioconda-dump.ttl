<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spicey> a ns1:SoftwareApplication ;
    ns1:alternateName "Calculates cell type specificity from single cell data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "SPICEY (SPecificity Index for Coding and Epigenetic activitY) is an R package designed to quantify cell-type specificity in single-cell transcriptomic and epigenomic data, particularly scRNA-seq and scATAC-seq. It introduces two complementary indices: the Gene Expression Tissue Specificity Index (GETSI) and the Regulatory Element Tissue Specificity Index (RETSI), both based on entropy to provide continuous, interpretable measures of specificity. By integrating gene expression and chromatin accessibility, SPICEY enables standardized analysis of cell-type-specific regulatory programs across diverse tissues and conditions." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SPICEY_1.0.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SPICEY/SPICEY_1.0.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SPICEY_1.0.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-spicey/bioconductor-spicey_1.0.0_src_all.tar.gz> ;
