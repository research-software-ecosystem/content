<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-flowai> a ns1:SoftwareApplication ;
    ns1:alternateName "Automatic and interactive quality control for flow cytometry data" ;
    ns1:citation <doi:10.1093/bioinformatics/btw191> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
