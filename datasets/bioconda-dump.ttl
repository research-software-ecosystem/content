bioconda:bioconductor-meshes a schema1:SoftwareApplication ;
    schema1:alternateName "MeSH Enrichment and Semantic analyses" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "MeSH (Medical Subject Headings) is the NLM controlled vocabulary used to manually index articles for MEDLINE/PubMed. MeSH terms were associated by Entrez Gene ID by three methods, gendoo, gene2pubmed and RBBH. This association is fundamental for enrichment and semantic analyses. meshes supports enrichment analysis (over-representation and gene set enrichment analysis) of gene list or whole expression profile. The semantic comparisons of MeSH terms provide quantitative ways to compute similarities between genes and gene groups. meshes implemented five methods proposed by Resnik, Schlicker, Jiang, Lin and Wang respectively and supports more than 70 species." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/meshes_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/meshes/meshes_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/meshes_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-meshes/bioconductor-meshes_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:meshes" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-meshes" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/meshes.html" .

bioconda:bioconductor-messina a schema1:SoftwareApplication ;
    schema1:alternateName "Single-gene classifiers and outlier-resistant detection of differential expression for two-group and survival problems" ;
    schema1:description "Messina is a collection of algorithms for constructing optimally robust single-gene classifiers, and for identifying differential expression in the presence of outliers or unknown sample subgroups.  The methods have application in identifying lead features to develop into clinical tests (both diagnostic and prognostic), and in identifying differential expression when a fraction of samples show unusual patterns of expression." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/messina_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/messina/messina_1.46.0.tar.gz",
