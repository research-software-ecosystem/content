<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rcwl> a ns1:SoftwareApplication ;
    ns1:alternateName "An R interface to the Common Workflow Language" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Common Workflow Language (CWL) is an open standard for development of data analysis workflows that is portable and scalable across different tools and working environments. Rcwl provides a simple way to wrap command line tools and build CWL data analysis pipelines programmatically within R. It increases the ease of usage, development, and maintenance of CWL pipelines." ;
