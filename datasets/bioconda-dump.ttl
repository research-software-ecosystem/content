<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-factr> a ns1:SoftwareApplication ;
    ns1:alternateName "Functional Annotation of Custom Transcriptomes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "factR contain tools to process and interact with custom-assembled transcriptomes (GTF). At its core, factR constructs CDS information on custom transcripts and subsequently predicts its functional output. In addition, factR has tools capable of plotting transcripts, correcting chromosome and gene information and shortlisting new transcripts." ;
