<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nbamseq> a ns1:SoftwareApplication ;
    ns1:alternateName "Negative Binomial Additive Model for RNA-Seq Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "High-throughput sequencing experiments followed by differential expression analysis is a widely used approach to detect genomic biomarkers. A fundamental step in differential expression analysis is to model the association between gene counts and covariates of interest. NBAMSeq a flexible statistical model based on the generalized additive model and allows for information sharing across genes in variance estimation." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/NBAMSeq_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NBAMSeq/NBAMSeq_1.26.0.tar.gz>,
