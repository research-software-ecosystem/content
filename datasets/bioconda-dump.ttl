        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-desctools>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-doparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-foreach>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gplots>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcolorbrewer> ;
    ns1:softwareVersion "1.22.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/SCOPE.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scoreinvhap> a ns1:SoftwareApplication ;
    ns1:alternateName "Get inversion status in predefined regions" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "scoreInvHap can get the samples' inversion status of known inversions. scoreInvHap uses SNP data as input and requires the following information about the inversion: genotype frequencies in the different haplotypes, R2 between the region SNPs and inversion status and heterozygote genotypes in the reference. The package include this data for 21 inversions." ;
