<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-semdist> a ns1:SoftwareApplication ;
    ns1:alternateName "Information Accretion-based Function Predictor Evaluation" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
