<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-batchelor> a ns1:SoftwareApplication ;
    ns1:alternateName "Single-Cell Batch Correction Methods" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Implements a variety of methods for batch correction of single-cell (RNA sequencing) data. This includes methods based on detecting mutually nearest neighbors, as well as several efficient variants of linear regression of the log-expression values. Functions are also provided to perform global rescaling to remove differences in depth between batches, and to perform a principal components analysis that is robust to differences in the numbers of cells across batches." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/batchelor_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/batchelor/batchelor_1.26.0.tar.gz>,
