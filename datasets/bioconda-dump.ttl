        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-v8> ;
    ns1:softwareVersion "1.18.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/BloodGen3Module.html> .

