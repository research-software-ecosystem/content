<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-recoup> a ns1:SoftwareApplication ;
    ns1:alternateName "An R package for the creation of complex genomic profile plots" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "recoup calculates and plots signal profiles created from short sequence reads derived from Next Generation Sequencing technologies. The profiles provided are either sumarized curve profiles or heatmap profiles. Currently, recoup supports genomic profile plots for reads derived from ChIP-Seq and RNA-Seq experiments. The package uses ggplot2 and ComplexHeatmap graphics facilities for curve and heatmap coverage profiles respectively." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/recoup_1.38.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/recoup/recoup_1.38.1.tar.gz>,
