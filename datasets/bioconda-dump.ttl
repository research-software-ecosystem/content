    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/exomeCopy.html" .

bioconda:bioconductor-fastseg a schema1:SoftwareApplication ;
    schema1:alternateName "fastseg - a fast segmentation algorithm" ;
    schema1:description "fastseg implements a very fast and efficient segmentation algorithm. It has similar functionality as DNACopy (Olshen and Venkatraman 2004), but is considerably faster and more flexible. fastseg can segment data from DNA microarrays and data from next generation sequencing for example to detect copy number segments. Further it can segment data from RNA microarrays like tiling arrays to identify transcripts. Most generally, it can segment data given as a matrix or as a vector. Various data formats can be used as input to fastseg like expression set objects for microarrays or GRanges for sequencing data. The segmentation criterion of fastseg is based on a statistical test in a Bayesian framework, namely the cyber t-test (Baldi 2001). The speed-up arises from the facts, that sampling is not necessary in for fastseg and that a dynamic programming approach is used for calculation of the segments' first and higher order moments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/fastseg_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/fastseg/fastseg_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/fastseg_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fastseg/bioconductor-fastseg_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:fastseg" ;
    schema1:license "LGPL (>= 2.0)" ;
    schema1:name "bioconductor-fastseg" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/fastseg.html" .

bioconda:bioconductor-fccac a schema1:SoftwareApplication ;
    schema1:alternateName "functional Canonical Correlation Analysis to evaluate Covariance between nucleic acid sequencing datasets" ;
    schema1:description "Computational evaluation of variability across DNA or RNA sequencing datasets is a crucial step in genomics, as it allows both to evaluate reproducibility of replicates, and to compare different datasets to identify potential correlations. fCCAC applies functional Canonical Correlation Analysis to allow the assessment of: (i) reproducibility of biological or technical replicates, analyzing their shared covariance in higher order components; and (ii) the associations between different datasets. fCCAC represents a more sophisticated approach that complements Pearson correlation of genomic coverage." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/fCCAC_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/fCCAC/fCCAC_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/fCCAC_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fccac/bioconductor-fccac_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:fccac" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-fccac" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/fCCAC.html" .

