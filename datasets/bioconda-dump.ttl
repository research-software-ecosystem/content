<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-wgsmapp> a ns1:SoftwareApplication ;
    ns1:alternateName "Mappability tracks of Whole-genome Sequencing from the ENCODE Project" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides whole-genome mappability tracks on human hg19/hg38 assembly. We employed the 100-mers mappability track from the ENCODE Project and computed weighted average of the mappability scores if multiple ENCODE regions overlap with the same bin. “Blacklist” bins, including segmental duplication regions and gaps in reference assembly from telomere, centromere, and/or heterochromatin regions are included. The dataset consists of three assembled .bam files of single-cell whole genome sequencing from 10X for illustration purposes." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/WGSmapp_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/WGSmapp/WGSmapp_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/data/experiment/src/contrib/WGSmapp_1.22.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-wgsmapp/bioconductor-wgsmapp_1.22.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-wgsmapp> ;
    ns1:license "GPL-2" ;
    ns1:name "bioconductor-wgsmapp" ;
