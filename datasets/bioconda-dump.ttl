<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-raids> a ns1:SoftwareApplication ;
    ns1:alternateName "Robust Ancestry Inference using Data Synthesis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package implements specialized algorithms that enable genetic ancestry inference from various cancer sequences sources (RNA, Exome and Whole-Genome sequences). This package also implements a simulation algorithm that generates synthetic cancer-derived data. This code and analysis pipeline was designed and developed for the following publication: Belleau, P et al. Genetic Ancestry Inference from Cancer-Derived Molecular Data across Genomic and Transcriptomic Platforms. Cancer Res 1 January 2023; 83 (1): 49–58." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/RAIDS_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RAIDS/RAIDS_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/RAIDS_1.8.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-raids/bioconductor-raids_1.8.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-raids> ;
    ns1:license "Apache License (>= 2)" ;
    ns1:name "bioconductor-raids" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationdbi>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationfilter>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bsgenome>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-ensembldb>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gdsfmt>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genesis>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-matrixgenerics>,
