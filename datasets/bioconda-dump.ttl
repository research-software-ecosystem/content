<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dcanr> a ns1:SoftwareApplication ;
    ns1:alternateName "Differential co-expression/association network analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package implements methods and an evaluation framework to infer differential co-expression/association networks. Various methods are implemented and can be evaluated using simulated datasets. Inference of differential co-expression networks can allow identification of networks that are altered between two conditions (e.g., health and disease)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/dcanr_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dcanr/dcanr_1.26.0.tar.gz>,
