<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-xcore> a ns1:SoftwareApplication ;
    ns1:alternateName "xcore expression regulators inference" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "xcore is an R package for transcription factor activity modeling based on known molecular signatures and user's gene expression data. Accompanying xcoredata package provides a collection of molecular signatures, constructed from publicly available ChiP-seq experiments. xcore use ridge regression to model changes in expression as a linear combination of molecular signatures and find their unknown activities. Obtained, estimates can be further tested for significance to select molecular signatures with the highest predicted effect on the observed expression changes." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/xcore_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/xcore/xcore_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/xcore_1.14.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-xcore/bioconductor-xcore_1.14.0_src_all.tar.gz> ;
