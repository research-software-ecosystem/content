<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-periodicdna> a ns1:SoftwareApplication ;
    ns1:alternateName "Set of tools to identify periodic occurrences of k-mers in DNA sequences" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This R package helps the user identify k-mers (e.g. di- or tri-nucleotides) present periodically in a set of genomic loci (typically regulatory elements). The functions of this package provide a straightforward approach to find periodic occurrences of k-mers in DNA sequences, such as regulatory elements. It is not aimed at identifying motifs separated by a conserved distance; for this type of analysis, please visit MEME website." ;
