<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lace> a ns1:SoftwareApplication ;
    ns1:alternateName "Longitudinal Analysis of Cancer Evolution (LACE)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "LACE is an algorithmic framework that processes single-cell somatic mutation profiles from cancer samples collected at different time points and in distinct experimental settings, to produce longitudinal models of cancer evolution. The approach solves a Boolean Matrix Factorization problem with phylogenetic constraints, by maximizing a weighed likelihood function computed on multiple time points." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/LACE_2.14.0.tar.gz>,
