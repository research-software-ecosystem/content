<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nestlink> a ns1:SoftwareApplication ;
    ns1:alternateName "NestLink an R data package to guide through Engineered Peptide Barcodes for In-Depth Analyzes of Binding Protein Ensembles" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Provides next-generation sequencing (NGS) and mass spectrometry (MS) sample data, code snippets and replication material used for developing NestLink. The NestLink approach is a protein binder selection and identification technology able to biophysically characterize thousands of library members at once without handling individual clones at any stage of the process. Data were acquired on NGS and MS platforms at the Functional Genomics Center Zurich." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/NestLink_1.26.0.tar.gz>,
