<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/hpcblast> a ns1:SoftwareApplication ;
    ns1:alternateName "A wrapper for NCBI-BLAST+ suite which provides a simple and efficient method to accelerate the blast search" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "hpcblast provides a simple and efficient method for running the NCBI-BLAST+ suite program in localhost or the HPC environment (Sun Grid Engine). It splits the input sequence file and run all chunked tasks in parallel to accelerate the blast search speed. When there are many sequences in the input file for blast comparison and the running speed is slow, using hpcblast can significantly improve the performance. All of this can be easy done only by adding the hpc-blast command at the head of your blast command line." ;
    ns1:downloadUrl <https://github.com/yodeng/hpc-blast/archive/v1.0.2.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/hpcblast> ;
    ns1:license "MIT" ;
    ns1:name "hpcblast" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/blast>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/pip>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/python>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/runjob> ;
    ns1:softwareVersion "1.0.2" ;
    ns1:url <https://github.com/yodeng/hpc-blast> .

