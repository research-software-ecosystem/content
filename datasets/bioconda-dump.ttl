<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cyanofilter> a ns1:SoftwareApplication ;
    ns1:alternateName "Phytoplankton Population Identification using Cell Pigmentation and/or Complexity" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "An approach to filter out and/or identify phytoplankton cells from all particles measured via flow cytometry pigment and cell complexity information. It does this using a sequence of one-dimensional gates on pre-defined channels measuring certain pigmentation and complexity. The package is especially tuned for cyanobacteria, but will work fine for phytoplankton communities where there is at least one cell characteristic that differentiates every phytoplankton in the community." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/cyanoFilter_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cyanoFilter/cyanoFilter_1.18.0.tar.gz>,
