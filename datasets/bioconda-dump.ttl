    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-xaitest" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-limma>,
