<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-survtype> a ns1:SoftwareApplication ;
    ns1:alternateName "Subtype Identification with Survival Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Subtypes are defined as groups of samples that have distinct molecular and clinical features. Genomic data can be analyzed for discovering patient subtypes, associated with clinical data, especially for survival information. This package is aimed to identify subtypes that are both clinically relevant and biologically meaningful." ;
