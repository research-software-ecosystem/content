        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-reshape2> ;
    ns1:softwareVersion "1.22.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/dittoSeq.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dorothea> a ns1:SoftwareApplication ;
    ns1:alternateName "Collection Of Human And Mouse TF Regulons" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "DoRothEA is a gene regulatory network containing signed transcription factor (TF) - target gene interactions. DoRothEA regulons, the collection of a TF and its transcriptional targets, were curated and collected from different types of evidence for both human and mouse. A confidence level was assigned to each TF-target interaction based on the number of supporting evidence." ;
