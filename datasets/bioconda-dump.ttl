<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-glmgampoi> a ns1:SoftwareApplication ;
    ns1:alternateName "Fit a Gamma-Poisson Generalized Linear Model" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
