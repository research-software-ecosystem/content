<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-circrnaprofiler> a ns1:SoftwareApplication ;
    ns1:alternateName "circRNAprofiler: An R-Based Computational Framework for the Downstream Analysis of Circular RNAs" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
