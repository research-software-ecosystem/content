<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicinstability> a ns1:SoftwareApplication ;
    ns1:alternateName "Genomic Instability estimation for scRNA-Seq" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package contain functions to run genomic instability analysis (GIA) from scRNA-Seq data. GIA estimates the association between gene expression and genomic location of the coding genes. It uses the aREA algorithm to quantify the enrichment of sets of contiguous genes (loci-blocks) on the gene expression profiles and estimates the Genomic Instability Score (GIS) for each analyzed cell." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/genomicInstability_1.16.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genomicInstability/genomicInstability_1.16.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/genomicInstability_1.16.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-genomicinstability/bioconductor-genomicinstability_1.16.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicinstability> ;
    ns1:license "file LICENSE" ;
    ns1:name "bioconductor-genomicinstability" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
