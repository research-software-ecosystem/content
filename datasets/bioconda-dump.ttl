<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-delocal> a ns1:SoftwareApplication ;
    ns1:alternateName "Identifies differentially expressed genes with respect to other local genes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The goal of DELocal is to identify DE genes compared to their neighboring genes from the same chromosomal location. It has been shown that genes of related functions are generally very far from each other in the chromosome. DELocal utilzes this information to identify DE genes comparing with their neighbouring genes." ;
