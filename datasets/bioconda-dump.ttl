<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-slingshot> a ns1:SoftwareApplication ;
    ns1:alternateName "Tools for ordering single-cell sequencing" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Provides functions for inferring continuous, branching lineage structures in low-dimensional data. Slingshot was designed to model developmental trajectories in single-cell RNA sequencing data and serve as a component in an analysis pipeline after dimensionality reduction and clustering. It is flexible enough to handle arbitrarily many branching events and allows for the incorporation of prior knowledge through supervised graph construction." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/slingshot_2.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/slingshot/slingshot_2.18.0.tar.gz>,
