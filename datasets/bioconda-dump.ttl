<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cancersubtypes> a ns1:SoftwareApplication ;
    ns1:alternateName "Cancer subtypes identification, validation and visualization based on multiple genomic data sets" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
