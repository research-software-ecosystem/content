bioconda:bioconductor-deepsnv a schema1:SoftwareApplication ;
    schema1:alternateName "Detection of subclonal SNVs in deep sequencing data." ;
    schema1:description "This package provides provides quantitative variant callers for detecting subclonal mutations in ultra-deep (>=100x coverage) sequencing experiments. The deepSNV algorithm is used for a comparative setup with a control experiment of the same loci and uses a beta-binomial model and a likelihood ratio test to discriminate sequencing errors and subclonal SNVs. The shearwater algorithm computes a Bayes classifier based on a beta-binomial model for variant calling with multiple samples for precisely estimating model parameters - such as local error rates and dispersion - and prior knowledge, e.g. from variation data bases such as COSMIC." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/deepSNV_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/deepSNV/deepSNV_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/deepSNV_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-deepsnv/bioconductor-deepsnv_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:deepsnv" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-deepsnv" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/deepSNV.html" .

