<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-chronos> a ns1:SoftwareApplication ;
    ns1:alternateName "CHRONOS: A time-varying method for microRNA-mediated sub-pathway enrichment analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A package used for efficient unraveling of the inherent dynamic properties of pathways. MicroRNA-mediated subpathway topologies are extracted and evaluated by exploiting the temporal transition and the fold change activity of the linked genes/microRNAs." ;
