<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-snagee> a ns1:SoftwareApplication ;
    ns1:alternateName "Signal-to-Noise applied to Gene Expression Experiments" ;
    ns1:citation <doi:10.1371/journal.pone.0051013> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Signal-to-Noise applied to Gene Expression Experiments. Signal-to-noise ratios can be used as a proxy for quality of gene expression studies and samples. The SNRs can be calculated on any gene expression data set as long as gene IDs are available, no access to the raw data files is necessary. This allows to flag problematic studies and samples in any public data set." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SNAGEE_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SNAGEE/SNAGEE_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SNAGEE_1.50.0.tar.gz>,
