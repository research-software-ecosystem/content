<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sclane> a ns1:SoftwareApplication ;
    ns1:alternateName "Model Gene Expression Dynamics with Spline-Based NB GLMs, GEEs, & GLMMs" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Our scLANE model uses truncated power basis spline models to build flexible, interpretable models of single cell gene expression over pseudotime or latent time. The modeling architectures currently supported are Negative-binomial GLMs, GEEs, & GLMMs. Downstream analysis functionalities include model comparison, dynamic gene clustering, smoothed counts generation, gene set enrichment testing, & visualization." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scLANE_1.0.4.tar.gz>,
