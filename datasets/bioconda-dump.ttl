<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mdp> a ns1:SoftwareApplication ;
    ns1:alternateName "Molecular Degree of Perturbation calculates scores for transcriptome data samples based on their perturbation from controls" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Molecular Degree of Perturbation webtool quantifies the heterogeneity of samples. It takes a data.frame of omic data that contains at least two classes (control and test) and assigns a score to all samples based on how perturbed they are compared to the controls. It is based on the Molecular Distance to Health (Pankla et al. 2009), and expands on this algorithm by adding the options to calculate the z-score using the modified z-score (using median absolute deviation), change the z-score zeroing threshold, and look at genes that are most perturbed in the test versus control classes." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/mdp_1.30.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mdp/mdp_1.30.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/mdp_1.30.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-mdp/bioconductor-mdp_1.30.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mdp> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-mdp" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gridextra> ;
    ns1:softwareVersion "1.30.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/mdp.html> .

