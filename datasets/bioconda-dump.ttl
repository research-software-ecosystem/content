<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-copyhelper> a ns1:SoftwareApplication ;
    ns1:alternateName "Helper files for CopywriteR" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package contains the helper files that are required to run the Bioconductor package CopywriteR. It contains pre-assembled 1kb bin GC-content and mappability files for the reference genomes hg18, hg19, hg38, mm9 and mm10. In addition, it contains a blacklist filter to remove regions that display CNV. Files are stored as GRanges objects from the GenomicRanges Bioconductor package." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/CopyhelpeR_1.42.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CopyhelpeR/CopyhelpeR_1.42.0.tar.gz>,
