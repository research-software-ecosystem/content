bioconda:bioconductor-bionet a schema1:SoftwareApplication ;
    schema1:alternateName "Routines for the functional analysis of biological networks" ;
    schema1:description "This package provides functions for the integrated analysis of protein-protein interaction networks and the detection of functional modules. Different datasets can be integrated into the network by assigning p-values of statistical tests to the nodes of the network. E.g. p-values obtained from the differential expression of the genes from an Affymetrix array are assigned to the nodes of the network. By fitting a beta-uniform mixture model and calculating scores from the p-values, overall scores of network regions can be calculated and an integer linear programming algorithm identifies the maximum scoring subnetwork." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BioNet_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BioNet/BioNet_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BioNet_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bionet/bioconductor-bionet_1.70.0_src_all.tar.gz" ;
    schema1:identifier "biotools:bionet" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-bionet" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BioNet.html" .

bioconda:bioconductor-bioqc a schema1:SoftwareApplication ;
    schema1:alternateName "Detect tissue heterogeneity in expression profiles with gene sets" ;
    schema1:citation "doi:10.1186/s12864-017-3661-2" ;
    schema1:description "BioQC performs quality control of high-throughput expression data based on tissue gene signatures. It can detect tissue heterogeneity in gene expression data. The core algorithm is a Wilcoxon-Mann-Whitney test that is optimised for high performance." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BioQC_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BioQC/BioQC_1.38.0.tar.gz",
