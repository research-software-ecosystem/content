<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-proteodisco> a ns1:SoftwareApplication ;
    ns1:alternateName "Generation of customized protein variant databases from genomic variants, splice-junctions and manual sequences" ;
