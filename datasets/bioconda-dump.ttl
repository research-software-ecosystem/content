<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pepsettest> a ns1:SoftwareApplication ;
    ns1:alternateName "Peptide Set Test" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Peptide Set Test (PepSetTest) is a peptide-centric strategy to infer differentially expressed proteins in LC-MS/MS proteomics data. This test detects coordinated changes in the expression of peptides originating from the same protein and compares these changes against the rest of the peptidome. Compared to traditional aggregation-based approaches, the peptide set test demonstrates improved statistical power, yet controlling the Type I error rate correctly in most cases. This test can be valuable for discovering novel biomarkers and prioritizing drug targets, especially when the direct application of statistical analysis to protein data fails to provide substantial insights." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/PepSetTest_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PepSetTest/PepSetTest_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/PepSetTest_1.4.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-pepsettest/bioconductor-pepsettest_1.4.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pepsettest> ;
    ns1:license "GPL (>= 3)" ;
    ns1:name "bioconductor-pepsettest" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-limma>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dplyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-lme4>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-mass>,
