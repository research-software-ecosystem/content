        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-data.table>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dosnow>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-foreach>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-igraph>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-progress>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-snow>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidyr> ;
    ns1:softwareVersion "1.32.0" ;
