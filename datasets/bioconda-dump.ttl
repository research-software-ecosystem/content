<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-specond> a ns1:SoftwareApplication ;
    ns1:alternateName "Condition specific detection from expression data" ;
    ns1:citation <doi:10.1186/gb-2011-12-12-413> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package performs a gene expression data analysis to detect condition-specific genes. Such genes are significantly up- or down-regulated in a small number of conditions. It does so by fitting a mixture of normal distributions to the expression values. Conditions can be environmental conditions, different tissues, organs or any other sources that you wish to compare in terms of gene expression." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SpeCond_1.64.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SpeCond/SpeCond_1.64.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SpeCond_1.64.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-specond/bioconductor-specond_1.64.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/specond>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-specond> ;
    ns1:license "LGPL (>=2)" ;
    ns1:name "bioconductor-specond" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
