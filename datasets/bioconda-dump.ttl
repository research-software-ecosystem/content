    ns1:license "LGPL (>=3)" ;
    ns1:name "bioconductor-genomicozone" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biomart>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
