        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-zoo> ;
    ns1:softwareVersion "1.29.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/RcisTarget.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rcistarget.hg19.motifdbs.cisbponly.500bp> a ns1:SoftwareApplication ;
    ns1:alternateName "RcisTarget motif databases for human (hg19) - Subset of 4.6k motifs" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "RcisTarget databases: Gene-based motif rankings and annotation to transcription factors. This package contains a subset of 4.6k motifs (cisbp motifs), scored only within 500bp upstream and the TSS. See RcisTarget tutorial to download the full databases, containing 20k motifs and search space up to 10kbp around the TSS." ;
