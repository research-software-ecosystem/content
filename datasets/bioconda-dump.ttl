<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/beacon2-ri-tools> a ns1:SoftwareApplication ;
    ns1:alternateName "Package of tools designed to simplify the population of a Beacon v2 mongoDB database" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Beacon2 RI Tools v2 is a software created with the main goal of generating BFF data from .csv or .vcf (and probably more types of datafiles in the future). This is based on the first beacon ri tools. Currently, the supported input formats are VCF, CSV, and Phenopackets. These formats are converted to BFF (Beacon Friendly Format JSON, following Beacon v2 official specifications) and inserted into a Beacon database." ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/beacon2-ri-tools> ;
    ns1:license "Apache-2.0" ;
    ns1:maintainer "costero-e",
        "khaled196" ;
    ns1:name "beacon2-ri-tools" ;
    ns1:provider <https://bioconda.github.io/> ;
