bioconda:bioconductor-lpe a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for analyzing microarray data using Local Pooled Error (LPE) method" ;
    schema1:citation "doi:10.1093/bioinformatics/btg264" ;
    schema1:description "This LPE library is used to do significance analysis of microarray data with small number of replicates. It uses resampling based FDR adjustment, and gives less conservative results than traditional 'BH' or 'BY' procedures. Data accepted is raw data in txt format from MAS4, MAS5 or dChip. Data can also be supplied after normalization. LPE library is primarily used for analyzing data between two conditions. To use it for paired data, see LPEP library. For using LPE in multiple conditions, use HEM library." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/LPE_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LPE/LPE_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/LPE_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lpe/bioconductor-lpe_1.84.0_src_all.tar.gz" ;
    schema1:identifier "biotools:lpe" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-lpe" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/LPE.html" .

bioconda:bioconductor-lpeadj a schema1:SoftwareApplication ;
    schema1:alternateName "A correction of the local pooled error (LPE) method to replace the asymptotic variance adjustment with an unbiased adjustment based on sample size." ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Two options are added to the LPE algorithm. The original LPE method sets all variances below the max variance in the ordered distribution of variances to the maximum variance. in LPEadj this option is turned off by default.  The second option is to use a variance adjustment based on sample size rather than pi/2.  By default the LPEadj uses the sample size based variance adjustment." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/LPEadj_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/LPEadj/LPEadj_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/LPEadj_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lpeadj/bioconductor-lpeadj_1.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:lpeadj" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-lpeadj" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/LPEadj.html" .

bioconda:bioconductor-lpnet a schema1:SoftwareApplication ;
    schema1:alternateName "Linear Programming Model for Network Inference" ;
    schema1:citation "doi:10.1093/bioinformatics/btv327" ;
    schema1:description "lpNet aims at infering biological networks, in particular signaling and gene networks. For that it takes perturbation data, either steady-state or time-series, as input and generates an LP model which allows the inference of signaling networks. For parameter identification either leave-one-out cross-validation or stratified n-fold cross-validation can be used." ;
