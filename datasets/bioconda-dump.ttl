        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-biocmanager> ;
    ns1:softwareVersion "1.6.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/data/experiment/html/CytoMethIC.html> .

