<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sagenhaft> a ns1:SoftwareApplication ;
    ns1:alternateName "Collection of functions for reading and comparing SAGE libraries" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package implements several functions useful for analysis of gene expression data by sequencing tags as done in SAGE (Serial Analysis of Gene Expressen) data, i.e. extraction of a SAGE library from sequence files, sequence error correction, library comparison. Sequencing error correction is implementing using an Expectation Maximization Algorithm based on a Mixture Model of tag counts." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/sagenhaft_1.80.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sagenhaft/sagenhaft_1.80.0.tar.gz>,
