<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-simpic> a ns1:SoftwareApplication ;
    ns1:alternateName "Flexible simulation of paired-insertion counts for single-cell ATAC-sequencing data" ;
