<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rgsepd> a ns1:SoftwareApplication ;
    ns1:alternateName "Gene Set Enrichment / Projection Displays" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "R/GSEPD is a bioinformatics package for R to help disambiguate transcriptome samples (a matrix of RNA-Seq counts at transcript IDs) by automating differential expression (with DESeq2), then gene set enrichment (with GOSeq), and finally a N-dimensional projection to quantify in which ways each sample is like either treatment group." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/rgsepd_1.42.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rgsepd/rgsepd_1.42.0.tar.gz>,
