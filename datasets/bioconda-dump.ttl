<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spicyr> a ns1:SoftwareApplication ;
    ns1:alternateName "Spatial analysis of in situ cytometry data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The spicyR package provides a framework for performing inference on changes in spatial relationships between pairs of cell types for cell-resolution spatial omics technologies. spicyR consists of three primary steps: (i) summarizing the degree of spatial localization between pairs of cell types for each image; (ii) modelling the variability in localization summary statistics as a function of cell counts and (iii) testing for changes in spatial localizations associated with a response variable." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/spicyR_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/spicyR/spicyR_1.22.0.tar.gz>,
