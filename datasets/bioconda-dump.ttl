<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bandits> a ns1:SoftwareApplication ;
    ns1:alternateName "BANDITS: Bayesian ANalysis of DIfferenTial Splicing" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "BANDITS is a Bayesian hierarchical model for detecting differential splicing of genes and transcripts, via differential transcript usage (DTU), between two or more conditions. The method uses a Bayesian hierarchical framework, which allows for sample specific proportions in a Dirichlet-Multinomial model, and samples the allocation of fragments to the transcripts. Parameters are inferred via Markov chain Monte Carlo (MCMC) techniques and a DTU test is performed via a multivariate Wald test on the posterior densities for the average relative abundance of transcripts." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/BANDITS_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BANDITS/BANDITS_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/BANDITS_1.26.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-bandits/bioconductor-bandits_1.26.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bandits> ;
    ns1:license "GPL (>= 3)" ;
    ns1:name "bioconductor-bandits" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
