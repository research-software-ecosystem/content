<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/barcode_splitter> a ns1:SoftwareApplication ;
    ns1:alternateName "Split multiple fastq files by matching barcodes in one or more of the sequence files. Barcodes in the tab-delimited barcodes.txt file are matched against the beginning (or end) of the specified index read(s). By default, barcodes must match exactly, but --mistmatches can be set higher if desired. Compressed input is read (from all files) if the first input file name ends in .gz. Reading of compressed input can be forced with the gzipin option." ;
    ns1:citation <doi:10.5281/zenodo.2566616> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Split multiple fastq files by matching barcodes in one or more of the sequence files. Barcodes in the tab-delimited barcodes.txt file are matched against the beginning (or end) of the specified index read(s). By default, barcodes must match exactly, but --mistmatches can be set higher if desired. Compressed input is read (from all files) if the first input file name ends in .gz. Reading of compressed input can be forced with the gzipin option." ;
    ns1:downloadUrl <https://bitbucket.org/princeton_genomics/barcode_splitter/get/0.18.6.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/barcode_splitter> ;
    ns1:license "GNU" ;
    ns1:name "barcode_splitter" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/python>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/setuptools> ;
    ns1:softwareVersion "0.18.6" ;
    ns1:url <https://bitbucket.org/princeton_genomics/barcode_splitter> .

