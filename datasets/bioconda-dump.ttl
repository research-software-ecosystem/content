<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-syntenet> a ns1:SoftwareApplication ;
    ns1:alternateName "Inference And Analysis Of Synteny Networks" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "syntenet can be used to infer synteny networks from whole-genome protein sequences and analyze them. Anchor pairs are detected with the MCScanX algorithm, which was ported to this package with the Rcpp framework for R and C++ integration. Anchor pairs from synteny analyses are treated as an undirected unweighted graph (i.e., a synteny network), and users can perform: i. network clustering; ii. phylogenomic profiling (by identifying which species contain which clusters) and; iii. microsynteny-based phylogeny reconstruction with maximum likelihood." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/syntenet_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/syntenet/syntenet_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/syntenet_1.12.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-syntenet/bioconductor-syntenet_1.12.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-syntenet> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-syntenet" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
