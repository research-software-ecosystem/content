        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.13.0" ;
    ns1:url <https://bioconductor.org/packages/3.18/bioc/html/BRGenomics.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bridgedbr> a ns1:SoftwareApplication ;
    ns1:alternateName "Code for using BridgeDb identifier mapping framework from within R" ;
