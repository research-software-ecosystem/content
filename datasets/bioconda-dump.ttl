bioconda:bioconductor-dexseq a schema1:SoftwareApplication ;
    schema1:alternateName "Inference of differential exon usage in RNA-Seq" ;
    schema1:description "The package is focused on finding differential exon usage using RNA-seq exon counts between samples with different experimental designs. It provides functions that allows the user to make the necessary statistical tests based on a model that uses the negative binomial distribution to estimate the variance between biological replicates and generalized linear models for testing. The package also provides functions for the visualization and exploration of the results." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DEXSeq_1.56.0.tar.gz",
