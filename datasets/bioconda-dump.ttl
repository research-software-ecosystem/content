<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-outsplice> a ns1:SoftwareApplication ;
    ns1:alternateName "Comparison of Splicing Events between Tumor and Normal Samples" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "An easy to use tool that can compare splicing events in tumor and normal tissue samples using either a user generated matrix, or data from The Cancer Genome Atlas (TCGA). This package generates a matrix of splicing outliers that are significantly over or underexpressed in tumors samples compared to normal denoted by chromosome location. The package also will calculate the splicing burden in each tumor and characterize the types of splicing events that occur." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/OutSplice_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OutSplice/OutSplice_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/OutSplice_1.10.0.tar.gz>,
