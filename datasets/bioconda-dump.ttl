<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-messina> a ns1:SoftwareApplication ;
    ns1:alternateName "Single-gene classifiers and outlier-resistant detection of differential expression for two-group and survival problems" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Messina is a collection of algorithms for constructing optimally robust single-gene classifiers, and for identifying differential expression in the presence of outliers or unknown sample subgroups.  The methods have application in identifying lead features to develop into clinical tests (both diagnostic and prognostic), and in identifying differential expression when a fraction of samples show unusual patterns of expression." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/messina_1.46.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/messina/messina_1.46.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/messina_1.46.0.tar.gz>,
