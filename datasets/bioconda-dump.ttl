<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-knowyourcg> a ns1:SoftwareApplication ;
    ns1:alternateName "Functional analysis of DNA methylome datasets" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "KnowYourCG (KYCG) is a supervised learning framework designed for the functional analysis of DNA methylation data. Unlike existing tools that focus on genes or genomic intervals, KnowYourCG directly targets CpG dinucleotides, featuring automated supervised screenings of diverse biological and technical influences, including sequence motifs, transcription factor binding, histone modifications, replication timing, cell-type-specific methylation, and trait-epigenome associations. KnowYourCG addresses the challenges of data sparsity in various methylation datasets, including low-pass Nanopore sequencing, single-cell DNA methylomes, 5-hydroxymethylation profiles, spatial DNA methylation maps, and array-based datasets for epigenome-wide association studies and epigenetic clocks." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/knowYourCG_1.6.3.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/knowYourCG/knowYourCG_1.6.3.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/knowYourCG_1.6.3.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-knowyourcg/bioconductor-knowyourcg_1.6.3_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-knowyourcg> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-knowyourcg" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationhub>,
