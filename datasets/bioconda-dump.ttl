<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lpe> a ns1:SoftwareApplication ;
    ns1:alternateName "Methods for analyzing microarray data using Local Pooled Error (LPE) method" ;
    ns1:citation <doi:10.1093/bioinformatics/btg264> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This LPE library is used to do significance analysis of microarray data with small number of replicates. It uses resampling based FDR adjustment, and gives less conservative results than traditional 'BH' or 'BY' procedures. Data accepted is raw data in txt format from MAS4, MAS5 or dChip. Data can also be supplied after normalization. LPE library is primarily used for analyzing data between two conditions. To use it for paired data, see LPEP library. For using LPE in multiple conditions, use HEM library." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/LPE_1.84.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LPE/LPE_1.84.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/LPE_1.84.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-lpe/bioconductor-lpe_1.84.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/lpe>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lpe> ;
    ns1:license "LGPL" ;
    ns1:name "bioconductor-lpe" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.84.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/LPE.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-matter> a ns1:SoftwareApplication ;
