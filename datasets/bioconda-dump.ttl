<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lbe> a ns1:SoftwareApplication ;
    ns1:alternateName "Estimation of the false discovery rate" ;
    ns1:citation <doi:10.1093/bioinformatics/bti063> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "LBE is an efficient procedure for estimating the proportion of true null hypotheses, the false discovery rate (and so the q-values) in the framework of estimating procedures based on the marginal distribution of the p-values without assumption for the alternative hypothesis." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/LBE_1.78.0.tar.gz>,
