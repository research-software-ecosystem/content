<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-methylimp2> a ns1:SoftwareApplication ;
    ns1:alternateName "Missing value estimation of DNA methylation data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package allows to estimate missing values in DNA methylation data. methyLImp method is based on linear regression since methylation levels show a high degree of inter-sample correlation. Implementation is parallelised over chromosomes since probes on different chromosomes are usually independent. Mini-batch approach to reduce the runtime in case of large number of samples is available." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/methyLImp2_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methyLImp2/methyLImp2_1.6.0.tar.gz>,
