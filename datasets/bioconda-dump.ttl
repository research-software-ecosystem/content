        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-wesanderson> ;
    ns1:softwareVersion "1.0.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/CSOA.html> .

