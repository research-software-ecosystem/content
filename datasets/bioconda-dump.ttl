<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-tomoda> a ns1:SoftwareApplication ;
    ns1:alternateName "Tomo-seq data analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides many easy-to-use methods to analyze and visualize tomo-seq data. The tomo-seq technique is based on cryosectioning of tissue and performing RNA-seq on consecutive sections. (Reference: Kruse F, Junker JP, van Oudenaarden A, Bakkers J. Tomo-seq: A method to obtain genome-wide expression data with spatial resolution. Methods Cell Biol. 2016;135:299-307. doi:10.1016/bs.mcb.2016.01.006) The main purpose of the package is to find zones with similar transcriptional profiles and spatially expressed genes in a tomo-seq sample. Several visulization functions are available to create easy-to-modify plots." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/tomoda_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/tomoda/tomoda_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/tomoda_1.20.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-tomoda/bioconductor-tomoda_1.20.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-tomoda> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-tomoda" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggrepel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcolorbrewer>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-reshape2>,
