<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-splatter> a ns1:SoftwareApplication ;
    ns1:alternateName "Simple Simulation of Single-cell RNA Sequencing Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Splatter is a package for the simulation of single-cell RNA sequencing count data. It provides a simple interface for creating complex simulations that are reproducible and well-documented. Parameters can be estimated from real data and functions are provided for comparing real and simulated datasets." ;
