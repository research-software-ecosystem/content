    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mouseagingdata> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-mouseagingdata" ;
    ns1:provider <https://bioconda.github.io/> ;
