<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-zfpkm> a ns1:SoftwareApplication ;
    ns1:alternateName "A suite of functions to facilitate zFPKM transformations" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Perform the zFPKM transform on RNA-seq FPKM data. This algorithm is based on the publication by Hart et al., 2013 (Pubmed ID 24215113). Reference recommends using zFPKM > -3 to select expressed genes. Validated with encode open/closed chromosome data. Works well for gene level data using FPKM or TPM. Does not appear to calibrate well for transcript level data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/zFPKM_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/zFPKM/zFPKM_1.32.0.tar.gz>,
