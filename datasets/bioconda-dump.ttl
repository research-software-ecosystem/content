        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pmm> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-pmm" ;
    ns1:provider <https://bioconda.github.io/> ;
