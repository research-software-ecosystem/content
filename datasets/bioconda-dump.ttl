        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-stringr> ;
    ns1:softwareVersion "1.18.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/tLOH.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-tmexplorer> a ns1:SoftwareApplication ;
