<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-svaretro> a ns1:SoftwareApplication ;
    ns1:alternateName "Retrotransposed transcript detection from structural variants" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
