        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-seuratobject> ;
    ns1:softwareVersion "1.10.1" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/SCArray.sat.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scatac.explorer> a ns1:SoftwareApplication ;
    ns1:alternateName "A Collection of Single-cell ATAC Sequencing Datasets and Corresponding Metadata" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides a tool to search and download a collection of publicly available single cell ATAC-seq datasets and their metadata. scATAC-Explorer aims to act as a single point of entry for users looking to study single cell ATAC-seq data. Users can quickly search available datasets using the metadata table and download datasets of interest for immediate analysis within R." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scATAC.Explorer_1.16.0.tar.gz>,
