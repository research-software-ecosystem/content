        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-naturalsort>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcpp>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcppeigen>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-snowfall>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tsne>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-wesanderson>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
