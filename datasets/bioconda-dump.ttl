<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-deltacapturec> a ns1:SoftwareApplication ;
    ns1:alternateName "This Package Discovers Meso-scale Chromatin Remodeling from 3C Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package discovers meso-scale chromatin remodelling from 3C data.  3C data is local in nature.  It givens interaction counts between restriction enzyme digestion fragments and a preferred 'viewpoint' region.  By binning this data and using permutation testing, this package can test whether there are statistically significant changes in the interaction counts between the data from two cell types or two treatments." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/deltaCaptureC_1.24.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/deltaCaptureC/deltaCaptureC_1.24.0.tar.gz>,
