<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pathlinkr> a ns1:SoftwareApplication ;
    ns1:alternateName "Analyze and interpret RNA-Seq results" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "pathlinkR is an R package designed to facilitate analysis of RNA-Seq results. Specifically, our aim with pathlinkR was to provide a number of tools which take a list of DE genes and perform different analyses on them, aiding with the interpretation of results. Functions are included to perform pathway enrichment, with muliplte databases supported, and tools for visualizing these results. Genes can also be used to create and plot protein-protein interaction networks, all from inside of R." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/pathlinkR_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pathlinkR/pathlinkR_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/pathlinkR_1.6.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-pathlinkr/bioconductor-pathlinkr_1.6.0_src_all.tar.gz> ;
