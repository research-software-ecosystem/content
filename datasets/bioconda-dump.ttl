<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-proteingymr> a ns1:SoftwareApplication ;
    ns1:alternateName "Programmatic access to ProteinGym datasets in R/Bioconductor" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The ProteinGymR package provides analysis-ready data resources from ProteinGym, generated by Notin et al., 2023, as well as built-in functionality to visualize the data. ProteinGym comprises a collection of benchmarks for evaluating the performance of models predicting the effect of point mutations. This package provides access to 1. deep mutational scanning (DMS) scores from 217 assays measuring the impact of all possible amino acid substitutions across 186 proteins, 2. model performance metrics and prediction scores from 79 variant prediction models in the zero-shot setting and 12 models in the semi-supervised setting." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ProteinGymR_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ProteinGymR/ProteinGymR_1.4.0.tar.gz>,
