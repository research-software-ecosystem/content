<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-matchbox> a ns1:SoftwareApplication ;
    ns1:alternateName "Utilities to compute, compare, and plot the agreement between ordered vectors of features (ie. distinct genomic experiments). The package includes Correspondence-At-the-TOP (CAT) analysis." ;
