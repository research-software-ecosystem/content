<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-moanin> a ns1:SoftwareApplication ;
    ns1:alternateName "An R Package for Time Course RNASeq Data Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Simple and efficient workflow for time-course gene expression data, built on publictly available open-source projects hosted on CRAN and bioconductor. moanin provides helper functions for all the steps required for analysing time-course data using functional data analysis: (1) functional modeling of the timecourse data; (2) differential expression analysis; (3) clustering; (4) downstream analysis." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/moanin_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/moanin/moanin_1.18.0.tar.gz>,
