    schema1:name "bioconductor-les" ;
    schema1:softwareVersion "1.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/les.html" .

bioconda:bioconductor-lfa a schema1:SoftwareApplication ;
    schema1:alternateName "Logistic Factor Analysis for Categorical Data" ;
    schema1:citation "doi:10.1093/bioinformatics/btv641" ;
    schema1:description "Logistic Factor Analysis is a method for a PCA analogue on Binomial data via estimation of latent structure in the natural parameter.  The main method estimates genetic population structure from genotype data.  There are also methods for estimating individual-specific allele frequencies using the population structure.  Lastly, a structured Hardy-Weinberg equilibrium (HWE) test is developed, which quantifies the goodness of fit of the genotype data to the estimated population structure, via the estimated individual-specific allele frequencies (all of which generalizes traditional HWE tests)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/lfa_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lfa/lfa_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/lfa_2.10.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lfa/bioconductor-lfa_2.10.0_src_all.tar.gz" ;
    schema1:identifier "biotools:lfa" ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-lfa" ;
    schema1:softwareVersion "2.10.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/lfa.html" .

