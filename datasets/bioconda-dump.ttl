<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-path2ppi> a ns1:SoftwareApplication ;
    ns1:alternateName "Prediction of pathway-related protein-protein interaction networks" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Package to predict protein-protein interaction (PPI) networks in target organisms for which only a view information about PPIs is available. Path2PPI predicts PPI networks based on sets of proteins which can belong to a certain pathway from well-established model organisms. It helps to combine and transfer information of a certain pathway or biological process from several reference organisms to one target organism. Path2PPI only depends on the sequence similarity of the involved proteins." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/Path2PPI_1.40.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Path2PPI/Path2PPI_1.40.0.tar.gz>,
