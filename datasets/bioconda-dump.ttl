<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-reactomegsa> a ns1:SoftwareApplication ;
    ns1:alternateName "Client for the Reactome Analysis Service for comparative multi-omics gene set analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The ReactomeGSA packages uses Reactome's online analysis service to perform a multi-omics gene set analysis. The main advantage of this package is, that the retrieved results can be visualized using REACTOME's powerful webapplication.  Since Reactome's analysis service also uses R to perfrom the actual gene set analysis you will get similar results when using the same packages (such as limma and edgeR) locally.  Therefore, if you only require a gene set analysis, different packages are more suited." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ReactomeGSA_1.24.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ReactomeGSA/ReactomeGSA_1.24.1.tar.gz>,
