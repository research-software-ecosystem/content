bioconda:bioconductor-drugvsdisease a schema1:SoftwareApplication ;
    schema1:alternateName "Comparison of disease and drug profiles using Gene set Enrichment Analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package generates ranked lists of differential gene expression for either disease or drug profiles. Input data can be downloaded from Array Express or GEO, or from local CEL files. Ranked lists of differential expression and associated p-values are calculated using Limma. Enrichment scores (Subramanian et al. PNAS 2005) are calculated to a reference set of default drug or disease profiles, or a set of custom data supplied by the user. Network visualisation of significant scores are output in Cytoscape format." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DrugVsDisease_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DrugVsDisease/DrugVsDisease_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DrugVsDisease_2.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-drugvsdisease/bioconductor-drugvsdisease_2.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:drugvsdisease" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-drugvsdisease" ;
    schema1:softwareVersion "2.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DrugVsDisease.html" .

bioconda:bioconductor-dss a schema1:SoftwareApplication ;
    schema1:alternateName "Dispersion shrinkage for sequencing data" ;
    schema1:description "DSS is an R library performing differntial analysis for count-based sequencing data. It detectes differentially expressed genes (DEGs) from RNA-seq, and differentially methylated loci or regions (DML/DMRs) from bisulfite sequencing (BS-seq). The core of DSS is a new dispersion shrinkage method for estimating the dispersion parameter from Gamma-Poisson or Beta-Binomial distributions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DSS_2.58.0.tar.gz",
