        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidyverse> ;
    ns1:softwareVersion "1.2.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/RUCova.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-runibic> a ns1:SoftwareApplication ;
    ns1:alternateName "runibic: row-based biclustering algorithm for analysis of gene expression data in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package implements UbiBic algorithm in R. This biclustering algorithm for analysis of gene expression data was introduced by Zhenjia Wang et al. in 2016. It is currently considered the most promising biclustering method for identification of meaningful structures in complex and noisy data." ;
