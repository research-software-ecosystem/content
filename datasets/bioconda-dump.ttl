<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-orfik> a ns1:SoftwareApplication ;
    ns1:alternateName "Open Reading Frames in Genomics" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "R package for analysis of transcript and translation features through manipulation of sequence data and NGS data like Ribo-Seq, RNA-Seq, TCP-Seq and CAGE. It is generalized in the sense that any transcript region can be analysed, as the name hints to it was made with investigation of ribosomal patterns over Open Reading Frames (ORFs) as it's primary use case. ORFik is extremely fast through use of C++, data.table and GenomicRanges. Package allows to reassign starts of the transcripts with the use of CAGE-Seq data, automatic shifting of RiboSeq reads, finding of Open Reading Frames for whole genomes and much more." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ORFik_1.30.2.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ORFik/ORFik_1.30.2.tar.gz>,
