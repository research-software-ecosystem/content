bioconda:bioconductor-hiannotator a schema1:SoftwareApplication ;
    schema1:alternateName "Functions for annotating GRanges objects" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "hiAnnotator contains set of functions which allow users to annotate a GRanges object with custom set of annotations. The basic philosophy of this package is to take two GRanges objects (query & subject) with common set of seqnames (i.e. chromosomes) and return associated annotation per seqnames and rows from the query matching seqnames and rows from the subject (i.e. genes or cpg islands). The package comes with three types of annotation functions which calculates if a position from query is: within a feature, near a feature, or count features in defined window sizes. Moreover, each function is equipped with parallel backend to utilize the foreach package. In addition, the package is equipped with wrapper functions, which finds appropriate columns needed to make a GRanges object from a common data frame." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/hiAnnotator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/hiAnnotator/hiAnnotator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/hiAnnotator_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hiannotator/bioconductor-hiannotator_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:hiannotator" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-hiannotator" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/hiAnnotator.html" .

bioconda:bioconductor-hibag a schema1:SoftwareApplication ;
    schema1:alternateName "HLA Genotype Imputation with Attribute Bagging" ;
    schema1:description "Imputes HLA classical alleles using GWAS SNP data, and it relies on a training set of HLA and SNP genotypes. HIBAG can be used by researchers with published parameter estimates instead of requiring access to large training sample datasets. It combines the concepts of attribute bagging, an ensemble classifier method, with haplotype inference for SNPs and HLA types. Attribute bagging is a technique which improves the accuracy and stability of classifier ensembles using bootstrap aggregating and random variable selection." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HIBAG_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HIBAG/HIBAG_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HIBAG_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hibag/bioconductor-hibag_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:hibag" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-hibag" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HIBAG.html" .

bioconda:bioconductor-hiccompare a schema1:SoftwareApplication ;
    schema1:alternateName "HiCcompare: Joint normalization and comparative analysis of multiple Hi-C datasets" ;
    schema1:citation "doi:10.1186/s12859-018-2288-x" ;
    schema1:description "HiCcompare provides functions for joint normalization and difference detection in multiple Hi-C datasets. HiCcompare operates on processed Hi-C data in the form of chromosome-specific chromatin interaction matrices. It accepts three-column tab-separated text files storing chromatin interaction matrices in a sparse matrix format which are available from several sources. HiCcompare is designed to give the user the ability to perform a comparative analysis on the 3-Dimensional structure of the genomes of cells in different biological states.`HiCcompare` differs from other packages that attempt to compare Hi-C data in that it works on processed data in chromatin interaction matrix format instead of pre-processed sequencing data. In addition, `HiCcompare` provides a non-parametric method for the joint normalization and removal of biases between two Hi-C datasets for the purpose of comparative analysis. `HiCcompare` also provides a simple yet robust method for detecting differences between Hi-C datasets." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HiCcompare_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HiCcompare/HiCcompare_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HiCcompare_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hiccompare/bioconductor-hiccompare_1.32.0_src_all.tar.gz" ;
    schema1:identifier "biotools:HiCcompare" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-hiccompare" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HiCcompare.html" .

