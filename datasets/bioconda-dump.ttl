    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "With a set of pure metabolite reference spectra, ASICS quantifies concentration of metabolites in a complex spectrum. The identification of metabolites is performed by fitting a mixture model to the spectra of the library with a sparse penalty. The method and its statistical properties are described in Tardivel et al. (2017) <doi:10.1007/s11306-017-1244-5>." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ASICS_2.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/ASICS_2.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASICS/ASICS_2.26.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-asics/bioconductor-asics_2.26.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-asics> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-asics" ;
