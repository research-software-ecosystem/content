        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tokenizers>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-webchem> ;
    ns1:softwareVersion "1.18.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/DeepPINCS.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-diffbind> a ns1:SoftwareApplication ;
