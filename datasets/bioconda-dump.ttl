<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-methrix> a ns1:SoftwareApplication ;
    ns1:alternateName "Fast and efficient summarization of generic bedGraph files from Bisufite sequencing" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
