bioconda:bioconductor-synergyfinder a schema1:SoftwareApplication ;
    schema1:alternateName "Calculate and Visualize Synergy Scores for Drug Combinations" ;
    schema1:citation "doi:10.1093/bioinformatics/btx162" ;
    schema1:description "Efficient implementations for analyzing pre-clinical multiple drug combination datasets. It provides efficient implementations for 1.the popular synergy scoring models, including HSA, Loewe, Bliss, and ZIP to quantify the degree of drug combination synergy; 2. higher order drug combination data analysis and synergy landscape visualization for unlimited number of drugs in a combination; 3. statistical analysis of drug combination synergy and sensitivity with confidence intervals and p-values; 4. synergy barometer for harmonizing multiple synergy scoring methods to provide a consensus metric of synergy; 5. evaluation of synergy and sensitivity simultaneously to provide an unbiased interpretation of the clinical potential of the drug combinations. Based on this package, we also provide a web application (http://www.synergyfinder.org) for users who prefer graphical user interface." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/synergyfinder_3.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/synergyfinder/synergyfinder_3.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/synergyfinder_3.18.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-synergyfinder/bioconductor-synergyfinder_3.18.0_src_all.tar.gz" ;
    schema1:identifier "biotools:synergyfinder" ;
    schema1:license "Mozilla Public License 2.0" ;
    schema1:name "bioconductor-synergyfinder" ;
    schema1:softwareVersion "3.18.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/synergyfinder.html" .

bioconda:bioconductor-synlet a schema1:SoftwareApplication ;
    schema1:alternateName "Hits Selection for Synthetic Lethal RNAi Screen Data" ;
    schema1:citation "doi:10.1101/043570" ;
    schema1:description "Select hits from synthetic lethal RNAi screen data. For example, there are two identical celllines except one gene is knocked-down in one cellline. The interest is to find genes that lead to stronger lethal effect when they are knocked-down further by siRNA. Quality control and various visualisation tools are implemented. Four different algorithms could be used to pick up the interesting hits. This package is designed based on 384 wells plates, but may apply to other platforms with proper configuration." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/synlet_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/synlet/synlet_2.10.0.tar.gz",
