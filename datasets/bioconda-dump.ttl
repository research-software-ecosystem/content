        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-quadprog>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rdpack> ;
    ns1:softwareVersion "2.14.0" ;
    ns1:url <https://bioconductor.org/packages/3.23/bioc/html/ANCOMBC.html> .

