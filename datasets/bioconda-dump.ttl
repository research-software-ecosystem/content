<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scale4c> a ns1:SoftwareApplication ;
    ns1:alternateName "Scale4C: an R/Bioconductor package for scale-space transformation of 4C-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Scale4C is an R/Bioconductor package for scale-space transformation and visualization of 4C-seq data. The scale-space transformation is a multi-scale visualization technique to transform a 2D signal (e.g. 4C-seq reads on a genomic interval of choice) into a tesselation in the scale space (2D, genomic position x scale factor) by applying different smoothing kernels (Gauss, with increasing sigma). This transformation allows for explorative analysis and comparisons of the data's structure with other samples." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/Scale4C_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Scale4C/Scale4C_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Scale4C_1.32.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-scale4c/bioconductor-scale4c_1.32.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scale4c> ;
    ns1:license "LGPL-3" ;
    ns1:name "bioconductor-scale4c" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-smoothie> ;
    ns1:softwareVersion "1.32.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/Scale4C.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scan.upc> a ns1:SoftwareApplication ;
    ns1:alternateName "Single-channel array normalization (SCAN) and Universal exPression Codes (UPC)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "SCAN is a microarray normalization method to facilitate personalized-medicine workflows. Rather than processing microarray samples as groups, which can introduce biases and present logistical challenges, SCAN normalizes each sample individually by modeling and removing probe- and array-specific background noise using only data from within each array. SCAN can be applied to one-channel (e.g., Affymetrix) or two-channel (e.g., Agilent) microarrays. The Universal exPression Codes (UPC) method is an extension of SCAN that estimates whether a given gene/transcript is active above background levels in a given sample. The UPC method can be applied to one-channel or two-channel microarrays as well as to RNA-Seq read counts. Because UPC values are represented on the same scale and have an identical interpretation for each platform, they can be used for cross-platform data integration." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SCAN.UPC_2.52.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SCAN.UPC/SCAN.UPC_2.52.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SCAN.UPC_2.52.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-scan.upc/bioconductor-scan.upc_2.52.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/scan.upc>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scan.upc> ;
    ns1:license "MIT" ;
    ns1:name "bioconductor-scan.upc" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-affy>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-affyio>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-geoquery>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-oligo>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sva>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
