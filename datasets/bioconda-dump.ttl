<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gosemsim> a ns1:SoftwareApplication ;
    ns1:alternateName "GO-terms Semantic Similarity Measures" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The semantic comparisons of Gene Ontology (GO) annotations provide quantitative ways to compute similarities between genes and gene groups, and have became important basis for many bioinformatics analysis approaches. GOSemSim is an R package for semantic similarity computation among GO terms, sets of GO terms, gene products and gene clusters. GOSemSim implemented five methods proposed by Resnik, Schlicker, Jiang, Lin and Wang respectively." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/GOSemSim_2.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GOSemSim/GOSemSim_2.36.0.tar.gz>,
