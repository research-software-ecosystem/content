<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lumi> a ns1:SoftwareApplication ;
    ns1:alternateName "BeadArray Specific Methods for Illumina Methylation and Expression Microarrays" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The lumi package provides an integrated solution for the Illumina microarray data analysis. It includes functions of Illumina BeadStudio (GenomeStudio) data input, quality control, BeadArray-specific variance stabilization, normalization and gene annotation at the probe level. It also includes the functions of processing Illumina methylation microarrays, especially Illumina Infinium methylation microarrays." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/lumi_2.62.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lumi/lumi_2.62.0.tar.gz>,
