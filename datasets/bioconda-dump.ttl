<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-melissa> a ns1:SoftwareApplication ;
    ns1:alternateName "Bayesian clustering and imputationa of single cell methylomes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Melissa is a Baysian probabilistic model for jointly clustering and imputing single cell methylomes. This is done by taking into account local correlations via a Generalised Linear Model approach and global similarities using a mixture modelling approach." ;
