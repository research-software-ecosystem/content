<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-survclust> a ns1:SoftwareApplication ;
    ns1:alternateName "Identification Of Clinically Relevant Genomic Subtypes Using Outcome Weighted Learning" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "survClust is an outcome weighted integrative clustering algorithm used to classify multi-omic samples on their available time to event information. The resulting clusters are cross-validated to avoid over overfitting and output classification of samples that are molecularly distinct and clinically meaningful. It takes in binary (mutation) as well as continuous data (other omic types)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/survClust_1.4.0.tar.gz>,
