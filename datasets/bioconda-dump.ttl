<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/branchmanager> a ns1:SoftwareApplication ;
    ns1:alternateName "Microbial isolate tracking, marker-gene QC, and WGS prioritisation" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "BranchManager is a decision-support toolkit for microbial isolate collections. It validates partner submissions, processes Sanger AB1 chromatograms, assembles marker-gene sequences, compares taxonomy against reference databases, measures novelty relative to cultured and sequence-reference baselines, and helps prioritise isolates for whole-genome sequencing. Reference databases and  biological baselines are supplied and maintained separately by the user." ;
