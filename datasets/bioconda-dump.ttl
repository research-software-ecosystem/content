        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggpubr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-heatmap3>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-magrittr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-r.utils>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rmarkdown> ;
    ns1:softwareVersion "1.18.0" ;
    ns1:url <https://bioconductor.org/packages/3.18/bioc/html/enrichTF.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichviewnet> a ns1:SoftwareApplication ;
    ns1:alternateName "From functional enrichment results to biological networks" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package enables the visualization of functional enrichment results as network graphs. First the package enables the visualization of enrichment results, in a format corresponding to the one generated by gprofiler2, as a customizable Cytoscape network. In those networks, both gene datasets (GO terms/pathways/protein complexes) and genes associated to the datasets are represented as nodes. While the edges connect each gene to its dataset(s). The package also provides the option to create enrichment maps from functional enrichment results. Enrichment maps enable the visualization of enriched terms into a network with edges connecting overlapping genes." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/enrichViewNet_1.8.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/enrichViewNet/enrichViewNet_1.8.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/enrichViewNet_1.8.1.tar.gz>,
