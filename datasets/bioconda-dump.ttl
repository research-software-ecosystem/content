<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-islet> a ns1:SoftwareApplication ;
    ns1:alternateName "Individual-Specific ceLl typE referencing Tool" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "ISLET is a method to conduct signal deconvolution for general -omics data. It can estimate the individual-specific and cell-type-specific reference panels, when there are multiple samples observed from each subject. It takes the input of the observed mixture data (feature by sample matrix), and the cell type mixture proportions (sample by cell type matrix), and the sample-to-subject information. It can solve for the reference panel on the individual-basis and conduct test to identify cell-type-specific differential expression (csDE) genes. It also improves estimated cell type mixture proportions by integrating personalized reference panels." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ISLET_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ISLET/ISLET_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/ISLET_1.12.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-islet/bioconductor-islet_1.12.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-islet> ;
    ns1:license "GPL-2" ;
    ns1:name "bioconductor-islet" ;
    ns1:provider <https://bioconda.github.io/> ;
