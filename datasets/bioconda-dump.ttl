<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-progeny> a ns1:SoftwareApplication ;
    ns1:alternateName "Pathway RespOnsive GENes for activity inference from gene expression" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "PROGENy is resource that leverages a large compendium of publicly available signaling perturbation experiments to yield a common core of pathway responsive genes for human and mouse. These, coupled with any statistical method, can be used to infer pathway activities from bulk or single-cell transcriptomics." ;
