<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scmerge> a ns1:SoftwareApplication ;
    ns1:alternateName "scMerge: Merging multiple batches of scRNA-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Like all gene expression data, single-cell data suffers from batch effects and other unwanted variations that makes accurate biological interpretations difficult. The scMerge method leverages factor analysis, stably expressed genes (SEGs) and (pseudo-) replicates to remove unwanted variations and merge multiple single-cell data. This package contains all the necessary functions in the scMerge pipeline, including the identification of SEGs, replication-identification methods, and merging of single-cell data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scMerge_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scMerge/scMerge_1.26.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/scMerge_1.26.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-scmerge/bioconductor-scmerge_1.26.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scmerge> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-scmerge" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-batchelor>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocneighbors>,
