        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-mixtools> ;
    ns1:softwareVersion "1.16.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/genomicInstability.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicinteractionnodes> a ns1:SoftwareApplication ;
    ns1:alternateName "A R/Bioconductor package to detect the interaction nodes from HiC/HiChIP/HiCAR data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The GenomicInteractionNodes package can import interactions from bedpe file and define the interaction nodes, the genomic interaction sites with multiple interaction loops. The interaction nodes is a binding platform regulates one or multiple genes. The detected interaction nodes will be annotated for downstream validation." ;
