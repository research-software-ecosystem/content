<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-tuberculosis> a ns1:SoftwareApplication ;
    ns1:alternateName "Tuberculosis Gene Expression Data for Machine Learning" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The tuberculosis R/Bioconductor package features tuberculosis gene expression data for machine learning. All human samples from GEO that did not come from cell lines, were not taken postmortem, and did not feature recombination have been included. The package has more than 10,000 samples from both microarray and sequencing studies that have been processed from raw data through a hyper-standardized, reproducible pipeline." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/tuberculosis_1.16.0.tar.gz>,
