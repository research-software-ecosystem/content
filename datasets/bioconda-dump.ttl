bioconda:bioconductor-yapsa a schema1:SoftwareApplication ;
    schema1:alternateName "Yet Another Package for Signature Analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides functions and routines for supervised analyses of mutational signatures (i.e., the signatures have to be known, cf. L. Alexandrov et al., Nature 2013 and L. Alexandrov et al., Bioaxiv 2018). In particular, the family of functions LCD (LCD = linear combination decomposition) can use optimal signature-specific cutoffs which takes care of different detectability of the different signatures. Moreover, the package provides different sets of mutational signatures, including the COSMIC and PCAWG SNV signatures and the PCAWG Indel signatures; the latter infering that with YAPSA, the concept of supervised analysis of mutational signatures is extended to Indel signatures. YAPSA also provides confidence intervals as computed by profile likelihoods and can perform signature analysis on a stratified mutational catalogue (SMC = stratify mutational catalogue) in order to analyze enrichment and depletion patterns for the signatures in different strata." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/YAPSA_1.36.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/YAPSA/YAPSA_1.36.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/YAPSA_1.36.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-yapsa/bioconductor-yapsa_1.36.1_src_all.tar.gz" ;
    schema1:identifier "biotools:yapsa" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-yapsa" ;
    schema1:softwareVersion "1.36.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/YAPSA.html" .

bioconda:bioconductor-yarn a schema1:SoftwareApplication ;
    schema1:alternateName "YARN: Robust Multi-Condition RNA-Seq Preprocessing and Normalization" ;
    schema1:citation "doi:10.1101/086587" ;
    schema1:description "Expedite large RNA-Seq analyses using a combination of previously developed tools. YARN is meant to make it easier for the user in performing basic mis-annotation quality control, filtering, and condition-aware normalization. YARN leverages many Bioconductor tools and statistical techniques to account for the large heterogeneity and sparsity found in very large RNA-seq experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/yarn_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/yarn/yarn_1.36.0.tar.gz",
