        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dplyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggrepel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-pracma> ;
    ns1:softwareVersion "1.12.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/ATACseqTFEA.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-atena> a ns1:SoftwareApplication ;
    ns1:alternateName "Analysis of Transposable Elements" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Quantify expression of transposable elements (TEs) from RNA-seq data through different methods, including ERVmap, TEtranscripts and Telescope. A common interface is provided to use each of these methods, which consists of building a parameter object, calling the quantification function with this object and getting a SummarizedExperiment object as output container of the quantified expression profiles. The implementation allows one to quantify TEs and gene transcripts in an integrated manner." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/atena_1.16.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/atena/atena_1.16.1.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/atena_1.16.1.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-atena/bioconductor-atena_1.16.1_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-atena> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-atena" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationhub>,
