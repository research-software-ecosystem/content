<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nebulosa> a ns1:SoftwareApplication ;
    ns1:alternateName "Single-Cell Data Visualisation Using Kernel Gene-Weighted Density Estimation" ;
