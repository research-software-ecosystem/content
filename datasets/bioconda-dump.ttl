<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iseede> a ns1:SoftwareApplication ;
    ns1:alternateName "iSEE extension for panels related to differential expression analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package contains diverse functionality to extend the usage of the iSEE package, including additional classes for the panels or modes facilitating the analysis of differential expression results. This package does not perform differential expression. Instead, it provides methods to embed precomputed differential expression results in a SummarizedExperiment object, in a manner that is compatible with interactive visualisation in iSEE applications." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/iSEEde_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iSEEde/iSEEde_1.8.0.tar.gz>,
