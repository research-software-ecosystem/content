    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.38.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/Mergeomics.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-meshes> a ns1:SoftwareApplication ;
    ns1:alternateName "MeSH Enrichment and Semantic analyses" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MeSH (Medical Subject Headings) is the NLM controlled vocabulary used to manually index articles for MEDLINE/PubMed. MeSH terms were associated by Entrez Gene ID by three methods, gendoo, gene2pubmed and RBBH. This association is fundamental for enrichment and semantic analyses. meshes supports enrichment analysis (over-representation and gene set enrichment analysis) of gene list or whole expression profile. The semantic comparisons of MeSH terms provide quantitative ways to compute similarities between genes and gene groups. meshes implemented five methods proposed by Resnik, Schlicker, Jiang, Lin and Wang respectively and supports more than 70 species." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/meshes_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/meshes/meshes_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/meshes_1.36.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-meshes/bioconductor-meshes_1.36.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/meshes>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-meshes> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-meshes" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationdbi>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationhub>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dose>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichplot>,
