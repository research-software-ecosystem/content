<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-ogre> a ns1:SoftwareApplication ;
    ns1:alternateName "Calculate, visualize and analyse overlap between genomic regions" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
