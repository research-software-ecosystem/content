<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-oncoscore> a ns1:SoftwareApplication ;
    ns1:alternateName "A tool to identify potentially oncogenic genes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "OncoScore is a tool to measure the association of genes to cancer based on citation frequencies in biomedical literature. The score is evaluated from PubMed literature by dynamically updatable web queries." ;
