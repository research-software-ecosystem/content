        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-magrittr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrixstats>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-reshape2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rlang>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rocr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rstatix>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tibble>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidyr> ;
    ns1:softwareVersion "1.16.0" ;
