<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lute> a ns1:SoftwareApplication ;
    ns1:alternateName "Framework for cell size scale factor normalized bulk transcriptomics deconvolution experiments" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Provides a framework for adjustment on cell type size when performing bulk transcripomics deconvolution. The main framework function provides a means of reference normalization using cell size scale factors. It allows for marker selection and deconvolution using non-negative least squares (NNLS) by default. The framework is extensible for other marker selection and deconvolution algorithms, and users may reuse the generics, methods, and classes for these when developing new algorithms." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/lute_1.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/lute/lute_1.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/lute_1.2.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-lute/bioconductor-lute_1.2.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-lute> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-lute" ;
