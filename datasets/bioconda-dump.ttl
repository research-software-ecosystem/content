<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-humanaffydata> a ns1:SoftwareApplication ;
    ns1:alternateName "GEO accession GSE64985 and ArrayExpress accession E-MTAB-62 as ExpressionSet objects" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Re-analysis of human gene expression data generated on the Affymetrix HG U133PlusV2 (EH176) and Affymetrix HG U133A (EH177) platforms. The original data were normalized using robust multiarray averaging (RMA) to obtain an integrated gene expression atlas across diverse biological sample types and conditions. The entire compendia comprisee 9395 arrays for EH176 and 5372 arrays for EH177." ;
