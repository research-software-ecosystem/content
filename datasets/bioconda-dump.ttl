<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-copynumber> a ns1:SoftwareApplication ;
    ns1:alternateName "Segmentation of single- and multi-track copy number data by penalized least squares regression." ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Penalized least squares regression is applied to fit piecewise constant curves to copy number data to locate genomic regions of constant copy number. Procedures are available for individual segmentation of each sample, joint segmentation of several samples and joint segmentation of the two data tracks from SNP-arrays. Several plotting functions are available for visualization of the data and the segmentation results." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/copynumber_1.38.0.tar.gz>,
        <https://bioconductor.org/packages/3.16/bioc/src/contrib/Archive/copynumber/copynumber_1.38.0.tar.gz>,
