<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-msmstests> a ns1:SoftwareApplication ;
    ns1:alternateName "LC-MS/MS Differential Expression Tests" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Statistical tests for label-free LC-MS/MS data by spectral counts, to discover differentially expressed proteins between two biological conditions. Three tests are available: Poisson GLM regression, quasi-likelihood GLM regression, and the negative binomial of the edgeR package.The three models admit blocking factors to control for nuissance variables.To assure a good level of reproducibility a post-test filter is available, where we may set the minimum effect size considered biologicaly relevant, and the minimum expression of the most abundant condition." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/msmsTests_1.48.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/msmsTests/msmsTests_1.48.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/msmsTests_1.48.0.tar.gz>,
