    ns1:softwareVersion "1.30.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/diffuStats.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-diffutr> a ns1:SoftwareApplication ;
    ns1:alternateName "diffUTR: Streamlining differential exon and 3' UTR usage" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The diffUTR package provides a uniform interface and plotting functions for limma/edgeR/DEXSeq -powered differential bin/exon usage. It includes in addition an improved version of the limma::diffSplice method. Most importantly, diffUTR further extends the application of these frameworks to differential UTR usage analysis using poly-A site databases." ;
