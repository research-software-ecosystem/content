<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gsva> a ns1:SoftwareApplication ;
    ns1:alternateName "Gene Set Variation Analysis for Microarray and RNA-Seq Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Gene Set Variation Analysis (GSVA) is a non-parametric, unsupervised method for estimating variation of gene set enrichment through the samples of a expression data set. GSVA performs a change in coordinate systems, transforming the data from a gene by sample matrix to a gene-set by sample matrix, thereby allowing the evaluation of pathway enrichment for each sample. This new matrix of GSVA enrichment scores facilitates applying standard analytical methods like functional enrichment, survival analysis, clustering, CNV-pathway analysis or cross-tissue pathway analysis, in a pathway-centric manner." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/GSVA_2.4.9.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSVA/GSVA_2.4.9.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/GSVA_2.4.9.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-gsva/bioconductor-gsva_2.4.9_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/gsva>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gsva> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-gsva" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocsingular>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-delayedarray>,
