<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-turbonorm> a ns1:SoftwareApplication ;
    ns1:alternateName "A fast scatterplot smoother suitable for microarray normalization" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A fast scatterplot smoother based on B-splines with second-order difference penalty. Functions for microarray normalization of single-colour data i.e. Affymetrix/Illumina and two-colour data supplied as marray MarrayRaw-objects or limma RGList-objects are available." ;
