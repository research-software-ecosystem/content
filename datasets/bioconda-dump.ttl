<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bayesknockdown> a ns1:SoftwareApplication ;
    ns1:alternateName "BayesKnockdown: Posterior Probabilities for Edges from Knockdown Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A simple, fast Bayesian method for computing posterior probabilities for relationships between a single predictor variable and multiple potential outcome variables, incorporating prior probabilities of relationships. In the context of knockdown experiments, the predictor variable is the knocked-down gene, while the other genes are potential targets. Can also be used for differential expression/2-class data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/BayesKnockdown_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BayesKnockdown/BayesKnockdown_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/BayesKnockdown_1.36.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-bayesknockdown/bioconductor-bayesknockdown_1.36.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bayesknockdown> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-bayesknockdown" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
