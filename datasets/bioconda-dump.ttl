<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spanorm> a ns1:SoftwareApplication ;
    ns1:alternateName "Spatially-aware normalisation for spatial transcriptomics data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package implements the spatially aware library size normalisation algorithm, SpaNorm. SpaNorm normalises out library size effects while retaining biology through the modelling of smooth functions for each effect. Normalisation is performed in a gene- and cell-/spot- specific manner, yielding library size adjusted data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SpaNorm_1.4.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SpaNorm/SpaNorm_1.4.0.tar.gz>,
