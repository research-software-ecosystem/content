        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-reshape2> ;
    ns1:softwareVersion "1.26.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/metagene2.html> .

