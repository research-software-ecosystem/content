<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-suitor> a ns1:SoftwareApplication ;
    ns1:alternateName "Selecting the number of mutational signatures through cross-validation" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
