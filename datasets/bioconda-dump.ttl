<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pathnet> a ns1:SoftwareApplication ;
    ns1:alternateName "An R package for pathway analysis using topological information" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "PathNet uses topological information present in pathways and differential expression levels of genes (obtained from microarray experiment) to identify pathways that are 1) significantly enriched and 2) associated with each other in the context of differential expression. The algorithm is described in: PathNet: A tool for pathway analysis using topological information. Dutta B, Wallqvist A, and Reifman J. Source Code for Biology and Medicine 2012 Sep 24;7(1):10." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/PathNet_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PathNet/PathNet_1.50.0.tar.gz>,
