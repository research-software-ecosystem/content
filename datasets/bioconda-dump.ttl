<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dialignr> a ns1:SoftwareApplication ;
    ns1:alternateName "Dynamic Programming Based Alignment of MS2 Chromatograms" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "To obtain unbiased proteome coverage from a biological sample, mass-spectrometer is operated in Data Independent Acquisition (DIA) mode. Alignment of these DIA runs establishes consistency and less missing values in complete data-matrix. This package implements dynamic programming with affine gap penalty based approach for pair-wise alignment of analytes. A hybrid approach of global alignment (through MS2 features) and local alignment (with MS2 chromatograms) is implemented in this tool." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/DIAlignR_2.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/DIAlignR/DIAlignR_2.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/DIAlignR_2.10.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-dialignr/bioconductor-dialignr_2.10.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dialignr>,
        "usegalaxy-eu:dialignr" ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-dialignr" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mzr>,
