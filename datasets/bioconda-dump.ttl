        <https://depot.galaxyproject.org/software/bioconductor-dominosignal/bioconductor-dominosignal_1.4.1_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dominosignal> ;
    ns1:license "GPL-3 | file LICENSE" ;
    ns1:name "bioconductor-dominosignal" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biomart>,
