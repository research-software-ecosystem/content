<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cellmigration> a ns1:SoftwareApplication ;
    ns1:alternateName "Track Cells, Analyze Cell Trajectories and Compute Migration Statistics" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
