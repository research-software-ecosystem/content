    ns1:softwareVersion "1.14.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/coMethDMR.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-compass> a ns1:SoftwareApplication ;
    ns1:alternateName "Combinatorial Polyfunctionality Analysis of Single Cells" ;
    ns1:citation <doi:10.1038/nbt.3187> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "COMPASS is a statistical framework that enables unbiased analysis of antigen-specific T-cell subsets. COMPASS uses a Bayesian hierarchical framework to model all observed cell-subsets and select the most likely to be antigen-specific while regularizing the small cell counts that often arise in multi-parameter space. The model provides a posterior probability of specificity for each cell subset and each sample, which can be used to profile a subject's immune response to external stimuli such as infection or vaccination." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/COMPASS_1.48.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/COMPASS/COMPASS_1.48.0.tar.gz>,
