<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-geneattribution> a ns1:SoftwareApplication ;
    ns1:alternateName "Identification of candidate genes associated with genetic variation" ;
    ns1:citation <doi:10.1093/bioinformatics/btw698> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Identification of the most likely gene or genes through which variation at a given genomic locus in the human genome acts. The most basic functionality assumes that the closer gene is to the input locus, the more likely the gene is to be causative. Additionally, any empirical data that links genomic regions to genes (e.g. eQTL or genome conformation data) can be used if it is supplied in the UCSC .BED file format." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/geneAttribution_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneAttribution/geneAttribution_1.36.0.tar.gz>,
