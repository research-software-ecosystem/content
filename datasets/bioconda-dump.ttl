<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-synapter> a ns1:SoftwareApplication ;
    ns1:alternateName "Label-free data analysis pipeline for optimal identification and quantitation" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
