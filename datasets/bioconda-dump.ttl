    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichviewnet> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-enrichviewnet" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-enrichplot>,
