        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-viridis> ;
    ns1:softwareVersion "1.12.1" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/SpotClean.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spotlight> a ns1:SoftwareApplication ;
    ns1:alternateName "`SPOTlight`: Spatial Transcriptomics Deconvolution" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "`SPOTlight` provides a method to deconvolute spatial transcriptomics spots using a seeded NMF approach along with visualization tools to assess the results. Spatially resolved gene expression profiles are key to understand tissue organization and function. However, novel spatial transcriptomics (ST) profiling techniques lack single-cell resolution and require a combination with single-cell RNA sequencing (scRNA-seq) information to deconvolute the spatially indexed datasets. Leveraging the strengths of both data types, we developed SPOTlight, a computational tool that enables the integration of ST with scRNA-seq data to infer the location of cell types and states within a complex tissue. SPOTlight is centered around a seeded non-negative matrix factorization (NMF) regression, initialized using cell-type marker genes and non-negative least squares (NNLS) to subsequently deconvolute ST capture locations (spots)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SPOTlight_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SPOTlight/SPOTlight_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SPOTlight_1.14.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-spotlight/bioconductor-spotlight_1.14.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spotlight> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-spotlight" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sparsematrixstats>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/make>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcpp>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcppeigen>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.14.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/SPOTlight.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spotsweeper> a ns1:SoftwareApplication ;
    ns1:alternateName "Spatially-aware quality control for spatial transcriptomics" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Spatially-aware quality control (QC) software for both spot-level and artifact-level QC in spot-based spatial transcripomics, such as 10x Visium. These methods calculate local (nearest-neighbors) mean and variance of standard QC metrics (library size, unique genes, and mitochondrial percentage) to identify outliers spot and large technical artifacts." ;
