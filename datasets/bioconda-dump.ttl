<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-triplex> a ns1:SoftwareApplication ;
    ns1:alternateName "Search and visualize intramolecular triplex-forming sequences in DNA" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides functions for identification and visualization of potential intramolecular triplex patterns in DNA sequence. The main functionality is to detect the positions of subsequences capable of folding into an intramolecular triplex (H-DNA) in a much larger sequence. The potential H-DNA (triplexes) should be made of as many cannonical nucleotide triplets as possible. The package includes visualization showing the exact base-pairing in 1D, 2D or 3D." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/triplex_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/triplex/triplex_1.50.0.tar.gz>,
