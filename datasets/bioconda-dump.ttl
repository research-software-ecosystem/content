<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cordon> a ns1:SoftwareApplication ;
    ns1:alternateName "Codon Usage Analysis and Prediction of Gene Expressivity" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Tool for analysis of codon usage in various unannotated or KEGG/COG annotated DNA sequences. Calculates different measures of CU bias and CU-based predictors of gene expressivity, and performs gene set enrichment analysis for annotated sequences. Implements several methods for visualization of CU and enrichment analysis results." ;
