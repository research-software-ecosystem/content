<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidytacos> a ns1:SoftwareApplication ;
    ns1:alternateName "Functions to manipulate and visualize microbial community data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Tidytacos (tidy TAxonomic COmpositionS) is an R package for the exploration of microbial community data. Such community data consists of read counts generated by amplicon sequencing (e.g. a region of the 16S rRNA gene) or metagenome (shotgun) sequencing. Each read count represents a number of sequencing reads identified for some taxon (an ASV, OTU, species, or higher-level taxon) in a sample." ;
    ns1:downloadUrl <https://github.com/LebeerLab/tidytacos/archive/refs/tags/v1.0.9.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidytacos> ;
    ns1:license "GPL-3.0-only" ;
    ns1:name "r-tidytacos" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
