    schema1:name "bioconductor-egsea" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EGSEA.html" .

bioconda:bioconductor-empiricalbrownsmethod a schema1:SoftwareApplication ;
    schema1:alternateName "Uses Brown's method to combine p-values from dependent tests" ;
    schema1:citation "doi:10.1093/bioinformatics/btw438" ;
    schema1:description "Combining P-values from multiple statistical tests is common in bioinformatics. However, this procedure is non-trivial for dependent P-values. This package implements an empirical adaptation of Brown’s Method (an extension of Fisher’s Method) for combining dependent P-values which is appropriate for highly correlated data sets found in high-throughput biological experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/EmpiricalBrownsMethod_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EmpiricalBrownsMethod/EmpiricalBrownsMethod_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EmpiricalBrownsMethod_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-empiricalbrownsmethod/bioconductor-empiricalbrownsmethod_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:empiricalbrownsmethod" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-empiricalbrownsmethod" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EmpiricalBrownsMethod.html" .

bioconda:bioconductor-ensembldb a schema1:SoftwareApplication ;
    schema1:alternateName "Utilities to create and use Ensembl-based annotation databases" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The package provides functions to create and use transcript centric annotation databases/packages. The annotation for the databases are directly fetched from Ensembl using their Perl API. The functionality and data is similar to that of the TxDb packages from the GenomicFeatures package, but, in addition to retrieve all gene/transcript models and annotations from the database, ensembldb provides a filter framework allowing to retrieve annotations for specific entries like genes encoded on a chromosome region or transcript models of lincRNA genes. EnsDb databases built with ensembldb contain also protein annotations and mappings between proteins and their encoding transcripts. Finally, ensembldb provides functions to map between genomic, transcript and protein coordinates." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ensembldb_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ensembldb/ensembldb_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ensembldb_2.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ensembldb/bioconductor-ensembldb_2.34.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ensembldb" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-ensembldb" ;
    schema1:softwareVersion "2.34.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ensembldb.html" .

