<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bcseq> a ns1:SoftwareApplication ;
    ns1:alternateName "Fast Sequence Mapping in High-Throughput shRNA and CRISPR Screens" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This Rcpp-based package implements a highly efficient data structure and algorithm for performing alignment of short reads from CRISPR or shRNA screens to reference barcode library. Sequencing error are considered and matching qualities are evaluated based on Phred scores. A Bayes' classifier is employed to predict the originating barcode of a read. The package supports provision of user-defined probability models for evaluating matching qualities. The package also supports multi-threading." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/bcSeq_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bcSeq/bcSeq_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/bcSeq_1.32.0.tar.gz>,
