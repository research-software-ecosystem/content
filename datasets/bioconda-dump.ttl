bioconda:bioconductor-osat a schema1:SoftwareApplication ;
    schema1:alternateName "OSAT: Optimal Sample Assignment Tool" ;
    schema1:citation "doi:10.1186/1471-2164-13-689" ;
    schema1:description "A sizable genomics study such as microarray often involves the use of multiple batches (groups) of experiment due to practical complication. To minimize batch effects, a careful experiment design should ensure the even distribution of biological groups and confounding factors across batches. OSAT (Optimal Sample Assignment Tool) is developed to facilitate the allocation of collected samples to different batches. With minimum steps, it produces setup that optimizes the even distribution of samples in groups of biological interest into different batches, reducing the confounding or correlation between batches and the biological variables of interest. It can also optimize the even distribution of confounding factors across batches. Our tool can handle challenging instances where incomplete and unbalanced sample collections are involved as well as ideal balanced RCBD. OSAT provides a number of predefined layout for some of the most commonly used genomics platform. Related paper can be find at http://www.biomedcentral.com/1471-2164/13/689 ." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/OSAT_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OSAT/OSAT_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OSAT_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-osat/bioconductor-osat_1.58.0_src_all.tar.gz" ;
    schema1:identifier "biotools:osat" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-osat" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/OSAT.html" .

bioconda:bioconductor-oscope a schema1:SoftwareApplication ;
    schema1:alternateName "Oscope - A statistical pipeline for identifying oscillatory genes in unsynchronized single cell RNA-seq" ;
    schema1:citation "doi:10.1038/nmeth.3549" ;
    schema1:description "Oscope is a statistical pipeline developed to identifying and recovering the base cycle profiles of oscillating genes in an unsynchronized single cell RNA-seq experiment. The Oscope pipeline includes three modules: a sine model module to search for candidate oscillator pairs; a K-medoids clustering module to cluster candidate oscillators into groups; and an extended nearest insertion module to recover the base cycle order for each oscillator group." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Oscope_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Oscope/Oscope_1.40.0.tar.gz",
