<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-deedeeexperiment> a ns1:SoftwareApplication ;
    ns1:alternateName "DeeDeeExperiment: An S4 Class for managing and exploring omics analysis results" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "DeeDeeExperiment is an S4 class extending the SingleCellExperiment class, designed to integrate and manage omics analysis results. It introduces two dedicated slots to store Differential Expression Analysis (DEA) results and Functional Enrichment Analysis (FEA) results, providing a structured approach for downstream analysis." ;
