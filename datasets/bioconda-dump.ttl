bioconda:bioconductor-lola a schema1:SoftwareApplication ;
    schema1:alternateName "Locus overlap analysis for enrichment of genomic ranges" ;
    schema1:citation "doi:10.1093/bioinformatics/btv612" ;
    schema1:description "Provides functions for testing overlap of sets of genomic regions with public and custom region set (genomic ranges) databases. This makes it possible to do automated enrichment analysis for genomic region sets, thus facilitating interpretation of functional genomics and epigenomics data." ;
