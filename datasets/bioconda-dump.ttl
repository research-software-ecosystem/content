<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hippo> a ns1:SoftwareApplication ;
    ns1:alternateName "Heterogeneity-Induced Pre-Processing tOol" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "For scRNA-seq data, it selects features and clusters the cells simultaneously for single-cell UMI data. It has a novel feature selection method using the zero inflation instead of gene variance, and computationally faster than other existing methods since it only relies on PCA+Kmeans rather than graph-clustering or consensus clustering." ;
