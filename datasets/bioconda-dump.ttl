<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cernanetsim> a ns1:SoftwareApplication ;
    ns1:alternateName "Regulation Simulator of Interaction between miRNA and Competing RNAs (ceRNA)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package simulates regulations of ceRNA (Competing Endogenous) expression levels after a expression level change in one or more miRNA/mRNAs. The methodolgy adopted by the package has potential to incorparate any ceRNA (circRNA, lincRNA, etc.) into miRNA:target interaction network.  The package basically distributes miRNA expression over available ceRNAs where each ceRNA attracks miRNAs proportional to its amount. But, the package can utilize multiple parameters that modify miRNA effect on its target (seed type, binding energy, binding location, etc.).  The functions handle the given dataset as graph object and the processes progress via edge and node variables." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ceRNAnetsim_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ceRNAnetsim/ceRNAnetsim_1.22.0.tar.gz>,
