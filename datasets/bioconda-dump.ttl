<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mouseagingdata> a ns1:SoftwareApplication ;
    ns1:alternateName "Multi-omics data access for studies investigating the effects of aging" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The MouseAgingData package provides analysis-ready data resources from different studies focused on aging and rejuvenation in mice. The package currently provides two 10x Genomics single-cell RNA-seq datasets. The first study profiled the aging mouse brain measured across 37,089 cells (Ximerakis et al., 2019). The second study investigated parabiosis by profiling a total of 105,329 cells (Ximerakis & Holton et al., 2023). The datasets are provided as SingleCellExperiment objects and provide raw UMI counts and cell metadata." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MouseAgingData_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MouseAgingData/MouseAgingData_1.6.0.tar.gz>,
