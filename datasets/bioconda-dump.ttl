<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-massspecwavelet> a ns1:SoftwareApplication ;
    ns1:alternateName "Peak Detection for Mass Spectrometry data using wavelet-based algorithms" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Peak Detection in Mass Spectrometry data is one of the important preprocessing steps. The performance of peak detection affects subsequent processes, including protein identification, profile alignment and biomarker identification. Using Continuous Wavelet Transform (CWT), this package provides a reliable algorithm for peak detection that does not require any type of smoothing or previous baseline correction method, providing more consistent results for different spectra. See <doi:10.1093/bioinformatics/btl355} for further details." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MassSpecWavelet_1.76.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MassSpecWavelet/MassSpecWavelet_1.76.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/MassSpecWavelet_1.76.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-massspecwavelet/bioconductor-massspecwavelet_1.76.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/massspecwavelet>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-massspecwavelet> ;
    ns1:license "LGPL (>= 2)" ;
    ns1:name "bioconductor-massspecwavelet" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
