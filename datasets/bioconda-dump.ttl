<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cbea> a ns1:SoftwareApplication ;
    ns1:alternateName "Competitive Balances for Taxonomic Enrichment Analysis in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package implements CBEA, a method to perform set-based analysis for microbiome relative abundance data. This approach constructs a competitive balance between taxa within the set and remainder taxa per sample. More details can be found in the Nguyen et al. 2021+ manuscript. Additionally, this package adds support functions to help users perform taxa-set enrichment analyses using existing gene set analysis methods. In the future we hope to also provide curated knowledge driven taxa sets." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/CBEA_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/CBEA/CBEA_1.6.0.tar.gz>,
