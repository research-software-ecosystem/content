<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mfuzz> a ns1:SoftwareApplication ;
    ns1:alternateName "Soft clustering of omics time series data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The Mfuzz package implements noise-robust soft clustering of omics time-series data, including transcriptomic, proteomic or metabolomic data. It is based on the use of c-means clustering. For convenience, it includes a graphical user interface." ;
