<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fletcher2013a> a ns1:SoftwareApplication ;
    ns1:alternateName "Gene expression data from breast cancer cells under FGFR2 signalling perturbation" ;
