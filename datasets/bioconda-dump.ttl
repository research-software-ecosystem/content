<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mmappr2> a ns1:SoftwareApplication ;
    ns1:alternateName "Mutation Mapping Analysis Pipeline for Pooled RNA-Seq" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MMAPPR2 maps mutations resulting from pooled RNA-seq data from the F2 cross of forward genetic screens. Its predecessor is described in a paper published in Genome Research (Hill et al. 2013). MMAPPR2 accepts aligned BAM files as well as a reference genome as input, identifies loci of high sequence disparity between the control and mutant RNA sequences, predicts variant effects using Ensembl's Variant Effect Predictor, and outputs a ranked list of candidate mutations." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MMAPPR2_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/MMAPPR2/MMAPPR2_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.17/bioc/src/contrib/MMAPPR2_1.14.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-mmappr2/bioconductor-mmappr2_1.14.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mmappr2> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-mmappr2" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-ensemblvep>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomeinfodb>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
