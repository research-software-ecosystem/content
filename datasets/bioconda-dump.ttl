<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-regionalpcs> a ns1:SoftwareApplication ;
    ns1:alternateName "Summarizing Regional Methylation with Regional Principal Components Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Functions to summarize DNA methylation data using regional principal components. Regional principal components are computed using principal components analysis within genomic regions to summarize the variability in methylation levels across CpGs. The number of principal components is chosen using either the Marcenko-Pasteur or Gavish-Donoho method to identify relevant signal in the data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/regionalpcs_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/regionalpcs/regionalpcs_1.8.0.tar.gz>,
