<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-r453plus1toolbox> a ns1:SoftwareApplication ;
    ns1:alternateName "A package for importing and analyzing data from Roche's Genome Sequencer System" ;
