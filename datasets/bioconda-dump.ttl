        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-randomforest> ;
    ns1:softwareVersion "1.20.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/preciseTAD.html> .

