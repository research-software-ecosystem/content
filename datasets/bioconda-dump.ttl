<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bumpymatrix> a ns1:SoftwareApplication ;
    ns1:alternateName "Bumpy Matrix of Non-Scalar Objects" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Implements the BumpyMatrix class and several subclasses for holding non-scalar objects in each entry of the matrix. This is akin to a ragged array but the raggedness is in the third dimension, much like a bumpy surface - hence the name. Of particular interest is the BumpyDataFrameMatrix, where each entry is a Bioconductor data frame. This allows us to naturally represent multivariate data in a format that is compatible with two-dimensional containers like the SummarizedExperiment and MultiAssayExperiment objects." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/BumpyMatrix_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BumpyMatrix/BumpyMatrix_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/BumpyMatrix_1.18.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-bumpymatrix/bioconductor-bumpymatrix_1.18.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bumpymatrix> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-bumpymatrix" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-matrix> ;
    ns1:softwareVersion "1.18.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/BumpyMatrix.html> .

