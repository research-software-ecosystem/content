        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fgsea>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-fdrtool>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-fields>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggrepel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-markdown> ;
    ns1:softwareVersion "1.16.0" ;
