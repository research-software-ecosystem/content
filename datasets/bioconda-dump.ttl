<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mpranalyze> a ns1:SoftwareApplication ;
    ns1:alternateName "Statistical Analysis of MPRA data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MPRAnalyze provides statistical framework for the analysis of data generated by Massively Parallel Reporter Assays (MPRAs), used to directly measure enhancer activity. MPRAnalyze can be used for quantification of enhancer activity, classification of active enhancers and comparative analyses of enhancer activity between conditions. MPRAnalyze construct a nested pair of generalized linear models (GLMs) to relate the DNA and RNA observations, easily adjustable to various experimental designs and conditions, and provides a set of rigorous statistical testig schemes." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MPRAnalyze_1.28.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MPRAnalyze/MPRAnalyze_1.28.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/MPRAnalyze_1.28.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-mpranalyze/bioconductor-mpranalyze_1.28.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-mpranalyze> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-mpranalyze" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
