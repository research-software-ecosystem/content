bioconda:bioconductor-missmethyl a schema1:SoftwareApplication ;
    schema1:alternateName "Analysing Illumina HumanMethylation BeadChip Data" ;
    schema1:description "Normalisation, testing for differential variability and differential methylation and gene set testing for data from Illumina's Infinium HumanMethylation arrays. The normalisation procedure is subset-quantile within-array normalisation (SWAN), which allows Infinium I and II type probes on a single array to be normalised together. The test for differential variability is based on an empirical Bayes version of Levene's test. Differential methylation testing is performed using RUV, which can adjust for systematic errors of unknown origin in high-dimensional data by using negative control probes. Gene ontology analysis is performed by taking into account the number of probes per gene on the array, as well as taking into account multi-gene associated probes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/missMethyl_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/missMethyl/missMethyl_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/missMethyl_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-missmethyl/bioconductor-missmethyl_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:missmethyl" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-missmethyl" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/missMethyl.html" .

