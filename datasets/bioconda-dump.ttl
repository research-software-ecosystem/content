    schema1:name "bioconductor-meigor" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MEIGOR.html" .

bioconda:bioconductor-mergeomics a schema1:SoftwareApplication ;
    schema1:alternateName "Integrative network analysis of omics data" ;
    schema1:citation "doi:10.1101/036012" ;
    schema1:description "The Mergeomics pipeline serves as a flexible framework for integrating multidimensional omics-disease associations, functional genomics, canonical pathways and gene-gene interaction networks to generate mechanistic hypotheses. It includes two main parts, 1) Marker set enrichment analysis (MSEA); 2) Weighted Key Driver Analysis (wKDA)." ;
