<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-npgsea> a ns1:SoftwareApplication ;
    ns1:alternateName "Permutation approximation methods for gene set enrichment analysis (non-permutation GSEA)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Current gene set enrichment methods rely upon permutations for inference.  These approaches are computationally expensive and have minimum achievable p-values based on the number of permutations, not on the actual observed statistics.  We have derived three parametric approximations to the permutation distributions of two gene set enrichment test statistics.  We are able to reduce the computational burden and granularity issues of permutation testing with our method, which is implemented in this package. npGSEA calculates gene set enrichment statistics and p-values without the computational cost of permutations.  It is applicable in settings where one or many gene sets are of interest.  There are also built-in plotting functions to help users visualize results." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/npGSEA_1.46.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/npGSEA/npGSEA_1.46.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/npGSEA_1.46.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-npgsea/bioconductor-npgsea_1.46.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/npgsea>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-npgsea> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-npgsea" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gseabase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.46.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/npGSEA.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-ntw> a ns1:SoftwareApplication ;
    ns1:alternateName "Predict gene network using an Ordinary Differential Equation (ODE) based method" ;
