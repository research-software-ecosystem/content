<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-chippeakanno> a ns1:SoftwareApplication ;
    ns1:alternateName "Batch annotation of the peaks identified from either ChIP-seq, ChIP-chip experiments, or any experiments that result in large number of genomic interval data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The package encompasses a range of functions for identifying the closest gene, exon, miRNA, or custom features—such as highly conserved elements and user-supplied transcription factor binding sites. Additionally, users can retrieve sequences around the peaks and obtain enriched Gene Ontology (GO) or Pathway terms. In version 2.0.5 and beyond, new functionalities have been introduced. These include features for identifying peaks associated with bi-directional promoters along with summary statistics (peaksNearBDP), summarizing motif occurrences in peaks (summarizePatternInPeaks), and associating additional identifiers with annotated peaks or enrichedGO (addGeneIDs). The package integrates with various other packages such as biomaRt, IRanges, Biostrings, BSgenome, GO.db, multtest, and stat to enhance its analytical capabilities." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ChIPpeakAnno_3.44.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPpeakAnno/ChIPpeakAnno_3.44.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPpeakAnno_3.44.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-chippeakanno/bioconductor-chippeakanno_3.44.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/chippeakanno>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-chippeakanno> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-chippeakanno" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-annotationdbi>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocgenerics>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biomart>,
