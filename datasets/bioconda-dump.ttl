<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-occugene> a ns1:SoftwareApplication ;
    ns1:alternateName "Functions for Multinomial Occupancy Distribution" ;
    ns1:citation <doi:10.1007/978-1-59745-321-9_22> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Statistical tools for building random mutagenesis libraries for prokaryotes. The package has functions for handling the occupancy distribution for a multinomial and for estimating the number of essential genes in random transposon mutagenesis libraries." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/occugene_1.70.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/occugene/occugene_1.70.0.tar.gz>,
