bioconda:bioconductor-reportingtools a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for making reports in various formats" ;
    schema1:description "The ReportingTools software package enables users to easily display reports of analysis results generated from sources such as microarray and sequencing data.  The package allows users to create HTML pages that may be viewed on a web browser such as Safari, or in other formats readable by programs such as Excel.  Users can generate tables with sortable and filterable columns, make and display plots, and link table entries to other data sources such as NCBI or larger plots within the HTML page.  Using the package, users can also produce a table of contents page to link various reports together for a particular project that can be viewed in a web browser.  For more examples, please visit our site: http:// research-pub.gene.com/ReportingTools." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ReportingTools_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ReportingTools/ReportingTools_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ReportingTools_2.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-reportingtools/bioconductor-reportingtools_2.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:reportingtools" ;
