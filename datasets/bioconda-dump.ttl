        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/python>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/seaborn> ;
    ns1:softwareVersion "1.1.2" ;
    ns1:url <https://github.com/zx0223winner/HSDecipher> .

