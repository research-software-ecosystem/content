        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-mclust>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcpphungarian>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-uwot> ;
    ns1:softwareVersion "1.6.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/Banksy.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-banocc> a ns1:SoftwareApplication ;
    ns1:alternateName "Bayesian ANalysis Of Compositional Covariance" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "BAnOCC is a package designed for compositional data, where each sample sums to one. It infers the approximate covariance of the unconstrained data using a Bayesian model coded with `rstan`. It provides as output the `stanfit` object as well as posterior median and credible interval estimates for each correlation element." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/banocc_1.34.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/banocc/banocc_1.34.0.tar.gz>,
