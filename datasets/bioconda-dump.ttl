<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-grafgen> a ns1:SoftwareApplication ;
    ns1:alternateName "Classification of Helicobacter Pylori Genomes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
