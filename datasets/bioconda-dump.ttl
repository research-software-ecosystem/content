<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bobafit> a ns1:SoftwareApplication ;
    ns1:alternateName "Refitting diploid region profiles using a clustering procedure" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package provides a method to refit and correct the diploid region in copy number profiles. It uses a clustering algorithm to identify pathology-specific normal (diploid) chromosomes and then use their copy number signal to refit the whole profile.  The package is composed by three functions: DRrefit (the main function), ComputeNormalChromosome and PlotCluster." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/BOBaFIT_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BOBaFIT/BOBaFIT_1.14.0.tar.gz>,
