<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-synlet> a ns1:SoftwareApplication ;
    ns1:alternateName "Hits Selection for Synthetic Lethal RNAi Screen Data" ;
    ns1:citation <doi:10.1101/043570> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Select hits from synthetic lethal RNAi screen data. For example, there are two identical celllines except one gene is knocked-down in one cellline. The interest is to find genes that lead to stronger lethal effect when they are knocked-down further by siRNA. Quality control and various visualisation tools are implemented. Four different algorithms could be used to pick up the interesting hits. This package is designed based on 384 wells plates, but may apply to other platforms with proper configuration." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/synlet_2.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/synlet/synlet_2.10.0.tar.gz>,
