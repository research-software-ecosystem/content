<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dasper> a ns1:SoftwareApplication ;
    ns1:alternateName "Detecting abberant splicing events from RNA-sequencing data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The aim of dasper is to detect aberrant splicing events from RNA-seq data. dasper will use as input both junction and coverage data from RNA-seq to calculate the deviation of each splicing event in a patient from a set of user-defined controls. dasper uses an unsupervised outlier detection algorithm to score each splicing event in the patient with an outlier score representing the degree to which that splicing event looks abnormal." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/dasper_1.9.0.tar.gz>,
        <https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/dasper/dasper_1.9.0.tar.gz>,
        <https://bioconductor.org/packages/3.17/bioc/src/contrib/dasper_1.9.0.tar.gz>,
