<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-screpertoire> a ns1:SoftwareApplication ;
    ns1:alternateName "A toolkit for single-cell immune receptor profiling" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "scRepertoire is a toolkit for processing and analyzing single-cell T-cell receptor (TCR) and immunoglobulin (Ig). The scRepertoire framework supports use of 10x, AIRR, BD, MiXCR, TRUST4, and WAT3R single-cell formats. The functionality includes basic clonal analyses, repertoire summaries, distance-based clustering and interaction with the popular Seurat and SingleCellExperiment/Bioconductor R single-cell workflows." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scRepertoire_2.6.2.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scRepertoire/scRepertoire_2.6.2.tar.gz>,
