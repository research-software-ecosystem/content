<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-msa2dist> a ns1:SoftwareApplication ;
    ns1:alternateName "MSA2dist calculates pairwise distances between all sequences of a DNAStringSet or a AAStringSet using a custom score matrix and conducts codon based analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "MSA2dist calculates pairwise distances between all sequences of a DNAStringSet or a AAStringSet using a custom score matrix and conducts codon based analysis. It uses scoring matrices to be used in these pairwise distance calculations which can be adapted to any scoring for DNA or AA characters. E.g. by using literal distances MSA2dist calculates pairwise IUPAC distances. DNAStringSet alignments can be analysed as codon alignments to look for synonymous and nonsynonymous substitutions (dN/dS) in a parallelised fashion using a variety of substitution models. Non-aligned coding sequences can be directly used to construct pairwise codon alignments (global/local) and calculate dN/dS without any external dependencies." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/MSA2dist_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MSA2dist/MSA2dist_1.14.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/MSA2dist_1.14.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-msa2dist/bioconductor-msa2dist_1.14.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-msa2dist> ;
    ns1:license "GPL-3 + file LICENSE" ;
    ns1:name "bioconductor-msa2dist" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
