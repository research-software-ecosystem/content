<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-splicewiz> a ns1:SoftwareApplication ;
    ns1:alternateName "interactive analysis and visualization of alternative splicing in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The analysis and visualization of alternative splicing (AS) events from RNA sequencing data remains challenging. SpliceWiz is a user-friendly and performance-optimized R package for AS analysis, by processing alignment BAM files to quantify read counts across splice junctions, IRFinder-based intron retention quantitation, and supports novel splicing event identification. We introduce a novel visualization for AS using normalized coverage, thereby allowing visualization of differential AS across conditions. SpliceWiz features a shiny-based GUI facilitating interactive data exploration of results including gene ontology enrichment. It is performance optimized with multi-threaded processing of BAM files and a new COV file format for fast recall of sequencing coverage. Overall, SpliceWiz streamlines AS analysis, enabling reliable identification of functionally relevant AS events for further characterization." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/SpliceWiz_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SpliceWiz/SpliceWiz_1.12.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/SpliceWiz_1.12.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-splicewiz/bioconductor-splicewiz_1.12.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-splicewiz> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-splicewiz" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/automake>,
