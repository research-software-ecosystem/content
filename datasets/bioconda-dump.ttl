<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-regparallel> a ns1:SoftwareApplication ;
    ns1:alternateName "Standard regression functions in R enabled for parallel processing over large data-frames" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "In many analyses, a large amount of variables have to be tested independently against the trait/endpoint of interest, and also adjusted for covariates and confounding factors at the same time. The major bottleneck in these is the amount of time that it takes to complete these analyses. With RegParallel, a large number of tests can be performed simultaneously. On a 12-core system, 144 variables can be tested simultaneously, with 1000s of variables processed in a matter of seconds via 'nested' parallel processing. Works for logistic regression, linear regression, conditional logistic regression, Cox proportional hazards and survival models, and Bayesian logistic regression. Also caters for generalised linear models that utilise survey weights created by the 'survey' CRAN package and that utilise 'survey::svyglm'." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/RegParallel_1.28.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RegParallel/RegParallel_1.28.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/data/experiment/src/contrib/RegParallel_1.28.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-regparallel/bioconductor-regparallel_1.28.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-regparallel> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-regparallel" ;
