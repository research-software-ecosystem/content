    ns1:license "GPL-3" ;
    ns1:name "bioconductor-tidysummarizedexperiment" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-plyxp>,
