<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-abseqr> a ns1:SoftwareApplication ;
    ns1:alternateName "Reporting and data analysis functionalities for Rep-Seq datasets of antibody libraries" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "AbSeq is a comprehensive bioinformatic pipeline for the analysis of sequencing datasets generated from antibody libraries and abseqR is one of its packages. abseqR empowers the users of abseqPy (https://github.com/malhamdoosh/abseqPy) with plotting and reporting capabilities and allows them to generate interactive HTML reports for the convenience of viewing and sharing with other researchers. Additionally, abseqR extends abseqPy to compare multiple repertoire analyses and perform further downstream analysis on its output." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/abseqR_1.28.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/abseqR/abseqR_1.28.0.tar.gz>,
