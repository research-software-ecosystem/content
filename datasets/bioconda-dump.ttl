    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "SpikeLI is a package that performs the analysis of the Affymetrix spike-in data using the Langmuir Isotherm. The aim of this package is to show the advantages of a physical-chemistry based analysis of the Affymetrix microarray data compared to the traditional methods. The spike-in (or Latin square) data for the HGU95 and HGU133 chipsets have been downloaded from the Affymetrix web site. The model used in the spikeLI package is described in details in E. Carlon and T. Heim, Physica A 362, 433 (2006)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/spikeLI_2.70.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/spikeLI/spikeLI_2.70.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/spikeLI_2.70.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-spikeli/bioconductor-spikeli_2.70.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/spikeli>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spikeli> ;
    ns1:license "GPL-2" ;
    ns1:name "bioconductor-spikeli" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "2.70.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/spikeLI.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spillr> a ns1:SoftwareApplication ;
    ns1:alternateName "Spillover Compensation in Mass Cytometry Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Channel interference in mass cytometry can cause spillover and may result in miscounting of protein markers. We develop a nonparametric finite mixture model and use the mixture components to estimate the probability of spillover. We implement our method using expectation-maximization to fit the mixture model." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/spillR_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/spillR/spillR_1.6.0.tar.gz>,
