        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.48.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/msmsTests.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-msstatsbionet> a ns1:SoftwareApplication ;
    ns1:alternateName "Network Analysis for MS-based Proteomics Experiments" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A set of tools for network analysis using mass spectrometry-based proteomics data and network databases. The package takes as input the output of MSstats differential abundance analysis and provides functions to perform enrichment analysis and visualization in the context of prior knowledge from past literature. Notably, this package integrates with INDRA, which is a database of biological networks extracted from the literature using text mining techniques." ;
