        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-readxl>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rlang>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-shiny>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-shinywidgets>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-stringr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tibble>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-vegan> ;
