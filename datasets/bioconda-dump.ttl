<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rnasense> a ns1:SoftwareApplication ;
    ns1:alternateName "Analysis of Time-Resolved RNA-Seq Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "RNA-sense tool compares RNA-seq time curves in two experimental conditions, i.e. wild-type and mutant, and works in three steps. At Step 1, it builds expression profile for each transcript in one condition (i.e. wild-type) and tests if the transcript abundance grows or decays significantly. Dynamic transcripts are then sorted to non-overlapping groups (time profiles) by the time point of switch up or down. At Step 2, RNA-sense outputs the groups of differentially expressed transcripts, which are up- or downregulated in the mutant compared to the wild-type at each time point. At Step 3, Correlations (Fisher's exact test) between the outputs of Step 1 (switch up- and switch down- time profile groups) and the outputs of Step2 (differentially expressed transcript groups) are calculated. The results of the correlation analysis are printed as two-dimensional color plot, with time profiles and differential expression groups at y- and x-axis, respectively, and facilitates the biological interpretation of the data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/RNAsense_1.24.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RNAsense/RNAsense_1.24.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/RNAsense_1.24.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-rnasense/bioconductor-rnasense_1.24.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-rnasense> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-rnasense" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-qvalue>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-summarizedexperiment>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-nbpseq> ;
    ns1:softwareVersion "1.24.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/RNAsense.html> .

