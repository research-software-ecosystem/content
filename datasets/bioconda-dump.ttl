        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-scatterplot3d> ;
    ns1:softwareVersion "1.38.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/ClusterSignificance.html> .

