bioconda:bioconductor-geometadb a schema1:SoftwareApplication ;
    schema1:alternateName "A compilation of metadata from NCBI GEO" ;
    schema1:description "The NCBI Gene Expression Omnibus (GEO) represents the largest public repository of microarray data. However, finding data of interest can be challenging using current tools. GEOmetadb is an attempt to make access to the metadata associated with samples, platforms, and datasets much more feasible. This is accomplished by parsing all the NCBI GEO metadata into a SQLite database that can be stored and queried locally. GEOmetadb is simply a thin wrapper around the SQLite database along with associated documentation. Finally, the SQLite database is updated regularly as new data is added to GEO and can be downloaded at will for the most up-to-date metadata. GEOmetadb paper: http://bioinformatics.oxfordjournals.org/cgi/content/short/24/23/2798 ." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GEOmetadb_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEOmetadb/GEOmetadb_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GEOmetadb_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geometadb/bioconductor-geometadb_1.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:geometadb" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-geometadb" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GEOmetadb.html" .

