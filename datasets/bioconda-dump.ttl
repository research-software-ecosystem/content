        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.8.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/IsoBayes.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-isocorrectorgui> a ns1:SoftwareApplication ;
