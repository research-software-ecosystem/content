        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcppeigen>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.12.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/scDDboost.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scdesign3> a ns1:SoftwareApplication ;
    ns1:alternateName "A unified framework of realistic in silico data generation and statistical model inference for single-cell and spatial omics" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "We present a statistical simulator, scDesign3, to generate realistic single-cell and spatial omics data, including various cell states, experimental designs, and feature modalities, by learning interpretable parameters from real data. Using a unified probabilistic model for single-cell and spatial omics data, scDesign3 infers biologically meaningful parameters; assesses the goodness-of-fit of inferred cell clusters, trajectories, and spatial locations; and generates in silico negative and positive controls for benchmarking computational tools." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/scDesign3_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scDesign3/scDesign3_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/scDesign3_1.8.0.tar.gz>,
