        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fccac> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-fccac" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-complexheatmap>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomation>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
