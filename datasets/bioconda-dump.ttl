<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-reducedexperiment> a ns1:SoftwareApplication ;
    ns1:alternateName "Containers and tools for dimensionally-reduced -omics representations" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Provides SummarizedExperiment-like containers for storing and manipulating dimensionally-reduced assay data. The ReducedExperiment classes allow users to simultaneously manipulate their original dataset and their decomposed data, in addition to other method-specific outputs like feature loadings. Implements utilities and specialised classes for the application of stabilised independent component analysis (sICA) and weighted gene correlation network analysis (WGCNA)." ;
