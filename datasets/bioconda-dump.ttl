<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-profileplyr> a ns1:SoftwareApplication ;
    ns1:alternateName "Visualization and annotation of read signal over genomic ranges with profileplyr" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Quick and straightforward visualization of read signal over genomic intervals is key for generating hypotheses from sequencing data sets (e.g. ChIP-seq, ATAC-seq, bisulfite/methyl-seq). Many tools both inside and outside of R and Bioconductor are available to explore these types of data, and they typically start with a bigWig or BAM file and end with some representation of the signal (e.g. heatmap). profileplyr leverages many Bioconductor tools to allow for both flexibility and additional functionality in workflows that end with visualization of the read signal." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/profileplyr_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/profileplyr/profileplyr_1.22.0.tar.gz>,
        <https://bioconductor.org/packages/3.20/bioc/src/contrib/profileplyr_1.22.0.tar.gz>,
