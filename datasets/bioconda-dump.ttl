<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-erssa> a ns1:SoftwareApplication ;
    ns1:alternateName "Empirical RNA-seq Sample Size Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The ERSSA package takes user supplied RNA-seq differential expression dataset and calculates the number of differentially expressed genes at varying biological replicate levels. This allows the user to determine, without relying on any a priori assumptions, whether sufficient differential detection has been acheived with their RNA-seq dataset." ;
