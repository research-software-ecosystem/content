<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hicdcplus> a ns1:SoftwareApplication ;
    ns1:alternateName "Hi-C Direct Caller Plus" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Systematic 3D interaction calls and differential analysis for Hi-C and HiChIP. The HiC-DC+ (Hi-C/HiChIP direct caller plus) package enables principled statistical analysis of Hi-C and HiChIP data sets – including calling significant interactions within a single experiment and performing differential analysis between conditions given replicate experiments – to facilitate global integrative studies. HiC-DC+ estimates significant interactions in a Hi-C or HiChIP experiment directly from the raw contact matrix for each chromosome up to a specified genomic distance, binned by uniform genomic intervals or restriction enzyme fragments, by training a background model to account for random polymer ligation and systematic sources of read count variation." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/HiCDCPlus_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HiCDCPlus/HiCDCPlus_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/HiCDCPlus_1.18.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-hicdcplus/bioconductor-hicdcplus_1.18.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hicdcplus> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-hicdcplus" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-bsgenome>,
