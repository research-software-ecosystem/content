<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hilda> a ns1:SoftwareApplication ;
    ns1:alternateName "Conducting statistical inference on comparing the mutational exposures of mutational signatures by using hierarchical latent Dirichlet allocation" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
