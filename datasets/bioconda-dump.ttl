<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-spoon> a ns1:SoftwareApplication ;
    ns1:alternateName "Address the Mean-variance Relationship in Spatial Transcriptomics Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package addresses the mean-variance relationship in spatially resolved transcriptomics data. Precision weights are generated for individual observations using Empirical Bayes techniques. These weights are used to rescale the data and covariates, which are then used as input in spatially variable gene detection tools." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/spoon_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/spoon/spoon_1.6.0.tar.gz>,
