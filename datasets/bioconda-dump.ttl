<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-heron> a ns1:SoftwareApplication ;
    ns1:alternateName "Hierarchical Epitope pROtein biNding" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "HERON is a software package for analyzing peptide binding array data. In addition to identifying significant binding probes, HERON also provides functions for finding epitopes (string of consecutive peptides within a protein). HERON also calculates significance on the probe, epitope, and protein level by employing meta p-value methods.  HERON is designed for obtaining calls on the sample level and calculates fractions of hits for different conditions." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/HERON_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HERON/HERON_1.8.0.tar.gz>,
