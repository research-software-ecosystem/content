        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "2.4.5" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/GBScleanR.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-gcapc> a ns1:SoftwareApplication ;
    ns1:alternateName "GC Aware Peak Caller" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Peak calling for ChIP-seq data with consideration of potential GC bias in sequencing reads. GC bias is first estimated with generalized linear mixture models using effective GC strategy, then applied into peak significance estimation." ;
