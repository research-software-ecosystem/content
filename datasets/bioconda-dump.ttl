bioconda:bioconductor-dyebias a schema1:SoftwareApplication ;
    schema1:alternateName "The GASSCO method for correcting for slide-dependent gene-specific dye bias" ;
    schema1:description "Many two-colour hybridizations suffer from a dye bias that is both gene-specific and slide-specific. The former depends on the content of the nucleotide used for labeling; the latter depends on the labeling percentage. The slide-dependency was hitherto not recognized, and made addressing the artefact impossible.  Given a reasonable number of dye-swapped pairs of hybridizations, or of same vs. same hybridizations, both the gene- and slide-biases can be estimated and corrected using the GASSCO method (Margaritis et al., Mol. Sys. Biol. 5:266 (2009), doi:10.1038/msb.2009.21)" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/dyebias_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dyebias/dyebias_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dyebias_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dyebias/bioconductor-dyebias_1.70.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dyebias" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-dyebias" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/dyebias.html" .

