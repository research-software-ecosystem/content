<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-hivcdnavantwout03> a ns1:SoftwareApplication ;
    ns1:alternateName "T cell line infections with HIV-1 LAI (BRU)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "The expression levels of approximately 4600 cellular RNA transcripts were assessed in CD4+ T cell lines at different times after infection with HIV-1BRU using DNA microarrays. This data corresponds to the first block of a 12 block array image (001030_08_1.GEL) in the first data set (2000095918 A) in the first experiment (CEM LAI vs HI-LAI 24hr). There are two data sets, which are part of a dye-swap experiment with replicates, representing the Cy3 (green) absorption intensities for channel 1 (hiv1raw) and the Cy5 (red) absorption intensities for channel 2 (hiv2raw)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/HIVcDNAvantWout03_1.50.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HIVcDNAvantWout03/HIVcDNAvantWout03_1.50.0.tar.gz>,
