        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tidyverse> ;
    ns1:softwareVersion "1.16.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/MAI.html> .

