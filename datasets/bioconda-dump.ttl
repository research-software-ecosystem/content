        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pathnet> ;
    ns1:license "GPL-3" ;
    ns1:name "bioconductor-pathnet" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base> ;
    ns1:softwareVersion "1.50.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/PathNet.html> .

