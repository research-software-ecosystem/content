<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sigsquared> a ns1:SoftwareApplication ;
    ns1:alternateName "Gene signature generation for functionally validated signaling pathways" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "By leveraging statistical properties (log-rank test for survival) of patient cohorts defined by binary thresholds, poor-prognosis patients are identified by the sigsquared package via optimization over a cost function reducing type I and II error." ;
