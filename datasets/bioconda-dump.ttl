<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fdrame> a ns1:SoftwareApplication ;
    ns1:alternateName "FDR adjustments of Microarray Experiments (FDR-AME)" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package contains two main functions. The first is fdr.ma which takes normalized expression data array, experimental design and computes adjusted p-values It returns the fdr adjusted p-values and plots, according to the methods described in (Reiner, Yekutieli and Benjamini 2002). The second, is fdr.gui() which creates a simple graphic user interface to access fdr.ma" ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/fdrame_1.82.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/fdrame/fdrame_1.82.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/fdrame_1.82.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-fdrame/bioconductor-fdrame_1.82.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-fdrame> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-fdrame" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
