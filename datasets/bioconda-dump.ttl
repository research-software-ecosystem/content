<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-scclassify> a ns1:SoftwareApplication ;
    ns1:alternateName "scClassify: single-cell Hierarchical Classification" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "scClassify is a multiscale classification framework for single-cell RNA-seq data based on ensemble learning and cell type hierarchies, enabling sample size estimation required for accurate cell type classification and joint classification of cells using multiple references." ;
