<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-chipanalyser> a ns1:SoftwareApplication ;
    ns1:alternateName "ChIPanalyser: Predicting Transcription Factor Binding Sites" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "ChIPanalyser is a package to predict and understand TF binding by utilizing a statistical thermodynamic model. The model incorporates 4 main factors thought to drive TF binding: Chromatin State, Binding energy, Number of bound molecules and a scaling factor modulating TF binding affinity. Taken together, ChIPanalyser produces ChIP-like profiles that closely mimic the patterns seens in real ChIP-seq data." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ChIPanalyser_1.32.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPanalyser/ChIPanalyser_1.32.0.tar.gz>,
