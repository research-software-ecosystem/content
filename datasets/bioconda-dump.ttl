<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-motiftestr> a ns1:SoftwareApplication ;
    ns1:alternateName "Perform key tests for binding motifs in sequence data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Taking a set of sequence motifs as PWMs, test a set of sequences for over-representation of these motifs, as well as any positional features within the set of motifs. Enrichment analysis can be undertaken using multiple statistical approaches. The package also contains core functions to prepare data for analysis, and to visualise results." ;
