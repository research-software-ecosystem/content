<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-twilight> a ns1:SoftwareApplication ;
    ns1:alternateName "Estimation of local false discovery rate" ;
    ns1:citation <doi:10.1093/bioinformatics/bti436> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "In a typical microarray setting with gene expression data observed under two conditions, the local false discovery rate describes the probability that a gene is not differentially expressed between the two conditions given its corrresponding observed score or p-value level. The resulting curve of p-values versus local false discovery rate offers an insight into the twilight zone between clear differential and clear non-differential gene expression. Package 'twilight' contains two main functions: Function twilight.pval performs a two-condition test on differences in means for a given input matrix or expression set and computes permutation based p-values. Function twilight performs a stochastic downhill search to estimate local false discovery rates and effect size distributions. The package further provides means to filter for permutations that describe the null distribution correctly. Using filtered permutations, the influence of hidden confounders could be diminished." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/twilight_1.86.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/twilight/twilight_1.86.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/twilight_1.86.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-twilight/bioconductor-twilight_1.86.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/twilight>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-twilight> ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "bioconductor-twilight" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biobase>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/libblas>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblapack>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/liblzma-devel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/make>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.86.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/twilight.html> .

