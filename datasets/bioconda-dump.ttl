<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-csar> a ns1:SoftwareApplication ;
    ns1:alternateName "Statistical tools for the analysis of ChIP-seq data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Statistical tools for ChIP-seq data analysis. The package includes the statistical method described in Kaufmann et al. (2009) PLoS Biology: 7(4):e1000090. Briefly, Taking the average DNA fragment size subjected to sequencing into account, the software calculates genomic single-nucleotide read-enrichment values. After normalization, sample and control are compared using a test based on the Poisson distribution. Test statistic thresholds to control the false discovery rate are obtained through random permutation." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/CSAR_1.62.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CSAR/CSAR_1.62.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/CSAR_1.62.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-csar/bioconductor-csar_1.62.0_src_all.tar.gz> ;
    ns1:identifier <https://bio.tools/csar>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-csar> ;
    ns1:license "Artistic-2.0" ;
    ns1:name "bioconductor-csar" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-genomicranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-iranges>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-s4vectors>,
