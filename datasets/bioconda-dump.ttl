    ns1:softwareVersion "1.26.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/sitePath.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sizepower> a ns1:SoftwareApplication ;
    ns1:alternateName "Sample Size and Power Calculation in Micorarray Studies" ;
    ns1:citation <doi:10.1038/nmeth.3252> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package has been prepared to assist users in computing either a sample size or power value for a microarray experimental study. The user is referred to the cited references for technical background on the methodology underpinning these calculations. This package provides support for five types of sample size and power calculations. These five types can be adapted in various ways to encompass many of the standard designs encountered in practice." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/sizepower_1.80.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sizepower/sizepower_1.80.0.tar.gz>,
