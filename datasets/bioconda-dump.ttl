<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-riboprofiling> a ns1:SoftwareApplication ;
    ns1:alternateName "Ribosome Profiling Data Analysis: from BAM to Data Representation and Interpretation" ;
    ns1:citation <doi:10.12688/f1000research.8964.1> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Starting with a BAM file, this package provides the necessary functions for quality assessment, read start position recalibration, the counting of reads on CDS, 3'UTR, and 5'UTR, plotting of count data: pairs, log fold-change, codon frequency and coverage assessment, principal component analysis on codon coverage." ;
