<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-csdr> a ns1:SoftwareApplication ;
    ns1:alternateName "Differential gene co-expression" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package contains functionality to run differential gene co-expression across two different conditions. The algorithm is inspired by Voigt et al. 2017 and finds Conserved, Specific and Differentiated genes (hence the name CSD). This package include efficient and variance calculation by bootstrapping and Welford's algorithm." ;
