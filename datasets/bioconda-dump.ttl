<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-dandelionr> a ns1:SoftwareApplication ;
    ns1:alternateName "Single-cell Immune Repertoire Trajectory Analysis in R" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "dandelionR is an R package for performing single-cell immune repertoire trajectory analysis, based on the original python implementation. It provides the necessary functions to interface with scRepertoire and a custom implementation of an absorbing Markov chain for pseudotime inference, inspired by the Palantir Python package." ;
