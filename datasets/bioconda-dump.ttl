<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-cogaps> a ns1:SoftwareApplication ;
    ns1:alternateName "Coordinated Gene Activity in Pattern Sets." ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Coordinated Gene Activity in Pattern Sets (CoGAPS) implements a Bayesian MCMC matrix factorization algorithm, GAPS, and links it to gene set statistic methods to infer biological process activity. It can be used to perform sparse matrix factorization on any data, and when this data represents biomolecules, to do gene set analysis." ;
