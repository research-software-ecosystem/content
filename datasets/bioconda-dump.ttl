<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-geofastq> a ns1:SoftwareApplication ;
    ns1:alternateName "Downloads ENA Fastqs With GEO Accessions" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "GEOfastq is used to download fastq files from the European Nucleotide Archive (ENA) starting with an accession from the Gene Expression Omnibus (GEO). To do this, sample metadata is retrieved from GEO and the Sequence Read Archive (SRA). SRA run accessions are then used to construct FTP and aspera download links for fastq files generated by the ENA." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/GEOfastq_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEOfastq/GEOfastq_1.18.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/GEOfastq_1.18.0.tar.gz>,
