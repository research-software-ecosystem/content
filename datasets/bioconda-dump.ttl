bioconda:gcen a schema1:SoftwareApplication ;
    schema1:alternateName "GCEN: an easy-to-use toolkit for Gene Co-Expression Network analysis and lncRNAs annotation." ;
    schema1:citation "doi:10.3390/cimb44040100" ;
    schema1:description "GCEN is a command-line toolkit that allows biologists to easily build gene co-expression network and predict gene function, especially in RNA-Seq research or lncRNAs annotation. GCEN is primarily designed to be used in lncRNAs annotation, but is not limited to those scenarios. It is an efficient and easy-to-use solution that will allow everyone to perform gene co-expression network analysis without sophisticated programming skills. The recommended pipeline consists of four parts: data pretreatment, network construction, module identification, and function annotation. A README file and sample data are included in the software package. Because of its modular design, the GCEN can be easily integrated into another pipeline. Also, the multithreaded implementation of GCEN makes it fast and efficient for RNA-Seq data." ;
    schema1:downloadUrl "https://github.com/wen-chen/gcen/releases/download/v0.6.3/gcen-0.6.3-source.tar.gz" ;
    schema1:identifier "biotools:gcen" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "gcen" ;
    schema1:softwareVersion "0.6.3" ;
    schema1:url "https://www.biochen.org/gcen" .

