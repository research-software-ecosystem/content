<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pairedgsea> a ns1:SoftwareApplication ;
    ns1:alternateName "Paired DGE and DGS analysis for gene set enrichment analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "pairedGSEA makes it simple to run a paired Differential Gene Expression (DGE) and Differencital Gene Splicing (DGS) analysis. The package allows you to store intermediate results for further investiation, if desired. pairedGSEA comes with a wrapper function for running an Over-Representation Analysis (ORA) and functionalities for plotting the results." ;
