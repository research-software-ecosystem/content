    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-nxtirfdata> ;
    ns1:license "MIT + file LICENSE" ;
    ns1:name "bioconductor-nxtirfdata" ;
    ns1:provider <https://bioconda.github.io/> ;
