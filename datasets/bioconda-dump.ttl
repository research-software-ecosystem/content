        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-slam>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.24.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/cliqueMS.html> .

