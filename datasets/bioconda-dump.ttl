bioconda:bioconductor-diffustats a schema1:SoftwareApplication ;
    schema1:alternateName "Diffusion scores on biological networks" ;
    schema1:citation "doi:10.1093/bioinformatics/btx632" ;
    schema1:description "Label propagation approaches are a widely used procedure in computational biology for giving context to molecular entities using network data. Node labels, which can derive from gene expression, genome-wide association studies, protein domains or metabolomics profiling, are propagated to their neighbours in the network, effectively smoothing the scores through prior annotated knowledge and prioritising novel candidates. The R package diffuStats contains a collection of diffusion kernels and scoring approaches that facilitates their computation, characterisation and benchmarking." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/diffuStats_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/diffuStats/diffuStats_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/diffuStats_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffustats/bioconductor-diffustats_1.30.0_src_all.tar.gz" ;
    schema1:identifier "biotools:diffuStats" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-diffustats" ;
    schema1:softwareVersion "1.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/diffuStats.html" .

bioconda:bioconductor-director a schema1:SoftwareApplication ;
    schema1:alternateName "A dynamic visualization tool of multi-level data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Director is an R package designed to streamline the visualization of molecular effects in regulatory cascades. It utilizes the R package htmltools and a modified Sankey plugin of the JavaScript library D3 to provide a fast and easy, browser-enabled solution to discovering potentially interesting downstream effects of regulatory and/or co-expressed molecules. The diagrams are robust, interactive, and packaged as highly-portable HTML files that eliminate the need for third-party software to view. This enables a straightforward approach for scientists to interpret the data produced, and bioinformatics developers an alternative means to present relevant data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Director_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/Director/Director_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Director_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-director/bioconductor-director_1.32.0_src_all.tar.gz" ;
    schema1:identifier "biotools:director" ;
    schema1:license "GPL-3 + file LICENSE" ;
    schema1:name "bioconductor-director" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/Director.html" .

