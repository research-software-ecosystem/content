<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-seqarchr> a ns1:SoftwareApplication ;
    ns1:alternateName "Identify Different Architectures of Sequence Elements" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "seqArchR enables unsupervised discovery of _de novo_ clusters with characteristic sequence architectures characterized by position-specific motifs or composition of stretches of nucleotides, e.g., CG-richness. seqArchR does _not_ require any specifications w.r.t. the number of clusters, the length of any individual motifs, or the distance between motifs if and when they occur in pairs/groups; it directly detects them from the data. seqArchR uses non-negative matrix factorization (NMF) as its backbone, and employs a chunking-based iterative procedure that enables processing of large sequence collections efficiently. Wrapper functions are provided for visualizing cluster architectures as sequence logos." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/seqArchR_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/seqArchR/seqArchR_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/seqArchR_1.6.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-seqarchr/bioconductor-seqarchr_1.6.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-seqarchr> ;
    ns1:license "GPL-3 | file LICENSE" ;
    ns1:name "bioconductor-seqarchr" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocparallel>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biostrings>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-cli>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-cluster>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-cvtools>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-fpc>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggplot2>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-ggseqlogo>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-mass>,
