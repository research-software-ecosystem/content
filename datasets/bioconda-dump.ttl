    ns1:license "GPL-3" ;
    ns1:name "bioconductor-siamcat" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-phyloseq>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-beanplot>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-corrplot>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-glmnet>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-gridbase>,
