<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-reactomegraph4r> a ns1:SoftwareApplication ;
    ns1:alternateName "Interface for the Reactome Graph Database" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Pathways, reactions, and biological entities in Reactome knowledge are systematically represented as an ordered network. Instances are represented as nodes and relationships between instances as edges; they are all stored in the Reactome Graph Database. This package serves as an interface to query the interconnected data from a local Neo4j database, with the aim of minimizing the usage of Neo4j Cypher queries." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ReactomeGraph4R_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/ReactomeGraph4R/ReactomeGraph4R_1.10.0.tar.gz>,
