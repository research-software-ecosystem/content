<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-intact> a ns1:SoftwareApplication ;
    ns1:alternateName "Integrate TWAS and Colocalization Analysis for Gene Set Enrichment Analysis" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "This package integrates colocalization probabilities from colocalization analysis with transcriptome-wide association study (TWAS) scan summary statistics to implicate genes that may be biologically relevant to a complex trait. The probabilistic framework implemented in this package constrains the TWAS scan z-score-based likelihood using a gene-level colocalization probability. Given gene set annotations, this package can estimate gene set enrichment using posterior probabilities from the TWAS-colocalization integration step." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/INTACT_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/INTACT/INTACT_1.10.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/INTACT_1.10.0.tar.gz>,
        <https://depot.galaxyproject.org/software/bioconductor-intact/bioconductor-intact_1.10.0_src_all.tar.gz> ;
    ns1:identifier <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-intact> ;
    ns1:license "GPL-3 + file LICENSE" ;
    ns1:name "bioconductor-intact" ;
    ns1:provider <https://bioconda.github.io/> ;
    ns1:softwareRequirements <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-bdsmatrix>,
