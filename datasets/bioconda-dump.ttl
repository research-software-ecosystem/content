    schema1:softwareVersion "1.33.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/Metab.html" .

bioconda:bioconductor-metabosignal a schema1:SoftwareApplication ;
    schema1:alternateName "MetaboSignal: a network-based approach to overlay and explore metabolic and signaling KEGG pathways" ;
    schema1:description "MetaboSignal is an R package that allows merging, analyzing and customizing metabolic and signaling KEGG pathways. It is a network-based approach designed to explore the topological relationship between genes (signaling- or enzymatic-genes) and metabolites, representing a powerful tool to investigate the genetic landscape and regulatory networks of metabolic phenotypes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MetaboSignal_1.40.0.tar.gz",
