<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-biocbook> a ns1:SoftwareApplication ;
    ns1:alternateName "Write, containerize, publish and version Quarto books with Bioconductor" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "A BiocBook can be created by authors (e.g. R developers, but also scientists, teachers, communicators, ...) who wish to 1) write (compile a body of biological and/or bioinformatics knowledge), 2) containerize (provide Docker images to reproduce the examples illustrated in the compendium), 3) publish (deploy an online book to disseminate the compendium), and 4) version (automatically generate specific online book versions and Docker images for specific Bioconductor releases)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/BiocBook_1.8.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocBook/BiocBook_1.8.0.tar.gz>,
