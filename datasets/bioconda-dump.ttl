<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-singlecellmultimodal> a ns1:SoftwareApplication ;
    ns1:alternateName "Integrating Multi-modal Single Cell Experiment datasets" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "SingleCellMultiModal is an ExperimentHub package that serves multiple datasets obtained from GEO and other sources and represents them as MultiAssayExperiment objects. We provide several multi-modal datasets including scNMT, 10X Multiome, seqFISH, CITEseq, SCoPE2, and others. The scope of the package is is to provide data for benchmarking and analysis. To cite, use the 'citation' function and see <https://doi.org/10.1371/journal.pcbi.1011324>." ;
