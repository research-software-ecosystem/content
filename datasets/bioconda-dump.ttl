        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/seaborn>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/setuptools> ;
    ns1:softwareVersion "0.2.4" ;
    ns1:url <https://github.com/wtsi-hpag/HiLine> .

