<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-sccomp> a ns1:SoftwareApplication ;
    ns1:alternateName "Differential Composition and Variability Analysis for Single-Cell Data" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Comprehensive R package for differential composition and variability analysis in single-cell RNA sequencing, CyTOF, and microbiome data. Provides robust Bayesian modeling with outlier detection, random effects, and advanced statistical methods for cell type proportion analysis. Features include probabilistic outlier identification, mixed-effect modeling, differential variability testing, and comprehensive visualization tools. Perfect for cancer research, immunology, developmental biology, and single-cell genomics applications." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/sccomp_2.2.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sccomp/sccomp_2.2.0.tar.gz>,
