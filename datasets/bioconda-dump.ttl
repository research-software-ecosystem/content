<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-clustall> a ns1:SoftwareApplication ;
    ns1:alternateName "ClustAll: Data driven strategy to robustly identify stratification of patients within complex diseases" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Data driven strategy to find hidden groups of patients with complex diseases using clinical data. ClustAll facilitates the unsupervised identification of multiple robust stratifications. ClustAll, is able to overcome the most common limitations found when dealing with clinical data (missing values, correlated data, mixed data types)." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/ClustAll_1.6.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ClustAll/ClustAll_1.6.0.tar.gz>,
