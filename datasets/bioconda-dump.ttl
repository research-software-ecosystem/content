<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-yamss> a ns1:SoftwareApplication ;
    ns1:alternateName "Tools for high-throughput metabolomics" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Tools to analyze and visualize high-throughput metabolomics data aquired using chromatography-mass spectrometry. These tools preprocess data in a way that enables reliable and powerful differential analysis. At the core of these methods is a peak detection phase that pools information across all samples simultaneously. This is in contrast to other methods that detect peaks in a sample-by-sample basis." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/yamss_1.36.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/yamss/yamss_1.36.0.tar.gz>,
