        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-base>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.76.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/MassSpecWavelet.html> .

<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-metapod> a ns1:SoftwareApplication ;
    ns1:alternateName "Meta-Analyses on P-Values of Differential Analyses" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Implements a variety of methods for combining p-values in differential analyses of genome-scale datasets. Functions can combine p-values across different tests in the same analysis (e.g., genomic windows in ChIP-seq, exons in RNA-seq) or for corresponding tests across separate analyses (e.g., replicated comparisons, effect of different treatment conditions). Support is provided for handling log-transformed input p-values, missing values and weighting where appropriate." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/metapod_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.23/bioc/src/contrib/Archive/metapod/metapod_1.20.0.tar.gz>,
        <https://bioconductor.org/packages/3.23/bioc/src/contrib/metapod_1.20.0.tar.gz>,
