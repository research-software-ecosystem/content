        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-stringi>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-stringr> ;
    ns1:softwareVersion "1.26.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/Modstrings.html> .

