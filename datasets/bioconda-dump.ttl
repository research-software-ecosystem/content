        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-data.table>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-dplyr>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-networkd3>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-rcolorbrewer>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-snowballc>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-tm>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/r-wordcloud>,
        <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/zlib> ;
    ns1:softwareVersion "1.36.0" ;
    ns1:url <https://bioconductor.org/packages/3.22/bioc/html/geneXtendeR.html> .

