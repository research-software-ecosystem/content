        "https://depot.galaxyproject.org/software/bioconductor-messina/bioconductor-messina_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:messina" ;
    schema1:license "EPL (>= 1.0)" ;
    schema1:name "bioconductor-messina" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/messina.html" .

bioconda:bioconductor-metab a schema1:SoftwareApplication ;
    schema1:alternateName "Metab: An R Package for a High-Throughput Analysis of Metabolomics Data Generated by GC-MS." ;
    schema1:description "Metab is an R package for high-throughput processing of metabolomics data analysed by the Automated Mass Spectral Deconvolution and Identification System (AMDIS) (http://chemdata.nist.gov/mass-spc/amdis/downloads/). In addition, it performs statistical hypothesis test (t-test) and analysis of variance (ANOVA). Doing so, Metab considerably speed up the data mining process in metabolomics and produces better quality results. Metab was developed using interactive features, allowing users with lack of R knowledge to appreciate its functionalities." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Metab_1.33.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/Metab/Metab_1.33.0.tar.gz",
