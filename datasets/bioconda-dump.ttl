bioconda:bioconductor-mbttest a schema1:SoftwareApplication ;
    schema1:alternateName "Multiple Beta t-Tests" ;
    schema1:citation "doi:10.1371/journal.pone.0123658" ;
    schema1:description "MBttest method was developed from beta t-test method of Baggerly et al(2003). Compared to baySeq (Hard castle and Kelly 2010), DESeq (Anders and Huber 2010) and exact test (Robinson and Smyth 2007, 2008) and the GLM of McCarthy et al(2012), MBttest is of high work efficiency,that is, it has high power, high conservativeness of FDR estimation and high stability. MBttest is suit- able to transcriptomic data, tag data, SAGE data (count data) from small samples or a few replicate libraries. It can be used to identify genes, mRNA isoforms or tags differentially expressed between two conditions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MBttest_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MBttest/MBttest_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MBttest_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mbttest/bioconductor-mbttest_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mbttest" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-mbttest" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MBttest.html" .

bioconda:bioconductor-mdqc a schema1:SoftwareApplication ;
    schema1:alternateName "Mahalanobis Distance Quality Control for microarrays" ;
    schema1:citation "doi:10.1093/bioinformatics/btm487" ;
    schema1:description "MDQC is a multivariate quality assessment method for microarrays based on quality control (QC) reports. The Mahalanobis distance of an array's quality attributes is used to measure the similarity of the quality of that array against the quality of the other arrays. Then, arrays with unusually high distances can be flagged as potentially low-quality." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/mdqc_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mdqc/mdqc_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mdqc_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mdqc/bioconductor-mdqc_1.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mdqc" ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-mdqc" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mdqc.html" .

bioconda:bioconductor-medips a schema1:SoftwareApplication ;
    schema1:alternateName "DNA IP-seq data analysis" ;
    schema1:description "MEDIPS was developed for analyzing data derived from methylated DNA immunoprecipitation (MeDIP) experiments followed by sequencing (MeDIP-seq). However, MEDIPS provides functionalities for the analysis of any kind of quantitative sequencing data (e.g. ChIP-seq, MBD-seq, CMS-seq and others) including calculation of differential coverage between groups of samples and saturation and correlation analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MEDIPS_1.62.0.tar.gz",
