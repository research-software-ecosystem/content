<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-pdinfobuilder> a ns1:SoftwareApplication ;
    ns1:alternateName "Platform Design Information Package Builder" ;
    ns1:citation <doi:10.1093/bioinformatics/btq431> ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Builds platform design information packages. These consist of a SQLite database containing feature-level data such as x, y position on chip and featureSet ID. The database also incorporates featureSet-level annotation data. The products of this packages are used by the oligo pkg." ;
    ns1:downloadUrl <https://bioarchive.galaxyproject.org/pdInfoBuilder_1.74.0.tar.gz>,
        <https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pdInfoBuilder/pdInfoBuilder_1.74.0.tar.gz>,
