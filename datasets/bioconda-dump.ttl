<https://github.com/bioconda/bioconda-recipes/tree/master/recipes/bioconductor-tidysbml> a ns1:SoftwareApplication ;
    ns1:alternateName "Extract SBML's data into dataframes" ;
    ns1:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    ns1:description "Starting from one SBML file, it extracts information from each listOfCompartments, listOfSpecies and listOfReactions element by saving them into data frames. Each table provides one row for each entity (i.e. either compartment, species, reaction or speciesReference) and one set of columns for the attributes, one column for the content of the 'notes' subelement and one set of columns for the content of the 'annotation' subelement." ;
