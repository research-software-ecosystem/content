<https://biocontainers.pro/tools/r-missforest> a ns1:SoftwareApplication ;
    ns1:citation "doi:10.1093/bioinformatics/btr597" ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "The function missForest in this package is used to impute missing values particularly in the case of mixed-type data. It uses a random forest trained on the observed values of a data matrix to predict the missing values. It can be used to impute continuous and/or categorical data including complex interactions and non-linear relations. It yields an out-of-bag (OOB) imputation error estimate without the need of a test set or elaborate cross-validation. It can be run in parallel to save computation time." ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "r-missforest" ;
    ns1:provider <https://biocontainers.pro> ;
    ns1:url "https://github.com/stekhoven/missForest" .

<https://biocontainers.pro/tools/r-mitools> a ns1:SoftwareApplication ;
