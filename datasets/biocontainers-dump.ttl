<https://biocontainers.pro/tools/r-peer> a ns1:SoftwareApplication ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "PEER is a collection of Bayesian approaches to infer hidden determinants and their effects from gene expression profiles using factor analysis methods. Applications of PEER have (i) detected batch effects and experimental confounders (ii) increased the number of expression QTL findings by threefold and (iii) allowed inference of intermediate cellular traits, such as transcription factor or pathway activations. This project offers an efficient and versatile C++ implementation of the underlying algorithms with user-friendly interfaces to R and python. " ;
    ns1:license "GPL 2.0" ;
    ns1:name "r-peer" ;
    ns1:provider <https://biocontainers.pro> ;
