<https://biocontainers.pro/tools/bioconductor-rtcgatoolbox> a ns1:SoftwareApplication ;
    ns1:citation "doi:10.1371/journal.pone.0106397" ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "Managing data from large scale projects such as the cancer genome atlas (tcga) for further analysis is an important and time consuming step for research projects. firehose project makes tcga pre-processed data publicly available via web services and data portals but it requires managing, downloading and preparing the data for following steps. we developed an open source and extensible r based data client for firehose pre-processed data and demonstrated its use with sample case studies." ;
    ns1:identifier <https://bio.tools/rtcgatoolbox> ;
    ns1:keywords "Breast Neoplasms",
        "Computational Biology",
        "Data management",
        "Databases, Genetic",
        "Female",
        "Genome, Human",
        "Genomics",
        "Humans",
        "Neoplasms",
        "Phosphatidylinositol 3-Kinases" ;
    ns1:license "GPL-2.0" ;
    ns1:name "bioconductor-rtcgatoolbox" ;
    ns1:provider <https://biocontainers.pro> ;
    ns1:url "http://bioconductor.org/packages/release/bioc/html/RTCGAToolbox.html" .

