<https://biocontainers.pro/tools/chemfp> a ns1:SoftwareApplication ;
    ns1:citation "doi:10.1186/s13321-019-0398-8",
        "doi:10.26434/CHEMRXIV.7877846.V2" ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "Chemfp is a set of command-lines tools for generating cheminformatics fingerprints and searching those fingerprints by tanimoto similarity, as well as a python library which can be used to build new tools. these algorithms are designed for the dense, 100-10,000 bit fingerprints which occur in small-molecule pharmaceutical nchemisty. the tanimoto search algorithms are implemented in c for performance and support both threshold and k-nearest searches.fingerprint generation can be done either by extracting existing fingerprint data from an sd file or by using an existing chemistry toolkit. chemfp supports the python libraries from open babel, nopeneye, and rdkit toolkits." ;
    ns1:identifier <https://bio.tools/chemfp> ;
    ns1:keywords "Cheminformatics",
        "Chemistry",
        "Literature and language",
        "Transcription factors and regulatory sites" ;
    ns1:license "MIT" ;
    ns1:name "chemfp" ;
    ns1:provider <https://biocontainers.pro> ;
    ns1:url "https://chemfp.com" .

