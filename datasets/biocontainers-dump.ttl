<https://biocontainers.pro/tools/r-aptreeshape> a ns1:SoftwareApplication ;
    ns1:citation "doi:10.1093/bioinformatics/bti798",
        "doi:10.1101/224295" ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "Simulation and analysis of phylogenetic tree topologies using statistical indices. It is a companion library of the 'ape' package. It provides additional functions for reading, plotting, manipulating phylogenetic trees. It also offers convenient web-access to public databases, and enables testing null models of macroevolution using corrected test statistics.  Trees of class \"phylo\" (from 'ape' package) can be converted easily. Implements methods described in Bortolussi et al. (2005) and Maliet et al. (2017)." ;
    ns1:keywords "Genetics",
        "Phylogenetics" ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "r-aptreeshape" ;
    ns1:provider <https://biocontainers.pro> ;
