<https://biocontainers.pro/tools/r-r2html> a ns1:SoftwareApplication ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "Includes HTML function and methods to write in an HTML file. Thus, making HTML reports is easy. Includes a function that allows redirection on the fly, which appears to be very useful for teaching purpose, as the student can keep a copy of the produced output to keep all that he did during the course. Package comes with a vignette describing how to write HTML reports for statistical analysis. Finally, a driver for 'Sweave' allows to parse HTML flat files containing R code and to automatically write the corresponding outputs (tables and graphs)." ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "r-r2html" ;
    ns1:provider <https://biocontainers.pro> ;
    ns1:url "https://cran.r-project.org/web/packages/R2HTML/index.html" .

