<https://biocontainers.pro/tools/r-fftwtools> a ns1:SoftwareApplication ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "Provides a wrapper for several FFTW functions. This package provides access to the two-dimensional FFT, the multivariate FFT, and the one-dimensional real to complex FFT using FFTW3. The package includes the functions fftw and mvfftw which are designed to mimic the functionality of the R functions fft and mvfft. The FFT functions have a parameter that allows them to not return the redundant complex conjugate when the input is real data. " ;
    ns1:license "GPL (>= 2)" ;
    ns1:name "r-fftwtools" ;
    ns1:provider <https://biocontainers.pro> ;
    ns1:url "None" .

