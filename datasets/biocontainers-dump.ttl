    ns1:citation "doi:10.18129/b9.bioc.nebulosa" ;
    ns1:conformsTo "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE" ;
    ns1:description "This package provides a enhanced visualization of single-cell data based on gene-weighted density estimation. Nebulosa recovers the signal from dropped-out features and allows the inspection of the joint expression from multiple features (e.g. genes). Seurat and SingleCellExperiment objects can be used within Nebulosa." ;
    ns1:keywords "Data visualisation",
        "Gene Expression",
        "Genomics" ;
    ns1:license "GPL-3.0" ;
    ns1:name "bioconductor-nebulosa" ;
    ns1:provider <https://biocontainers.pro> ;
    ns1:url "https://bioconductor.org/packages/3.12/bioc/html/Nebulosa.html" .

