@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-decipher a schema1:SoftwareApplication ;
    schema1:description "Tools for curating, analyzing, and manipulating biological sequences" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DECIPHER_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DECIPHER/DECIPHER_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DECIPHER_3.6.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-decipher/bioconductor-decipher_3.6.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dbi",
        "zlib" ;
    schema1:identifier biotools:DECIPHER ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-decipher" ;
    schema1:softwareVersion "3.6.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DECIPHER.html" .

