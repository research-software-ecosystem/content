@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-decipher a schema:SoftwareApplication ;
    schema:description "Tools for curating, analyzing, and manipulating biological sequences" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DECIPHER_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DECIPHER/DECIPHER_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DECIPHER_3.6.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-decipher/bioconductor-decipher_3.6.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dbi",
        "zlib" ;
    schema:identifier biotools:DECIPHER ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-decipher" ;
    schema:softwareVersion "3.6.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DECIPHER.html" .

