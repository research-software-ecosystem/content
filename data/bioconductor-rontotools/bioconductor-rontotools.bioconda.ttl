@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rontotools a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/JPROC.2016.2531000" ;
    schema:description "R Onto-Tools suite" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ROntoTools_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ROntoTools/ROntoTools_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ROntoTools_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rontotools/bioconductor-rontotools_2.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-kegggraph",
        "bioconductor-keggrest",
        "bioconductor-rgraphviz",
        "r-base",
        "r-boot" ;
    schema:identifier biotools:rontotools ;
    schema:license "CC BY-NC-ND 4.0 + file LICENSE" ;
    schema:name "bioconductor-rontotools" ;
    schema:softwareVersion "2.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ROntoTools.html" .

