    schema1:license "CC BY-NC-ND 4.0 + file LICENSE" ;
    schema1:name "bioconductor-rontotools" ;
    schema1:softwareVersion "2.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ROntoTools.html" .

