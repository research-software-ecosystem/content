@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-generxcluster a schema:SoftwareApplication ;
    schema:description "gRx Differential Clustering" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/geneRxCluster_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneRxCluster/geneRxCluster_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneRxCluster_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-generxcluster/bioconductor-generxcluster_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicranges",
        "bioconductor-iranges",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:generxcluster ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-generxcluster" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/geneRxCluster.html" .

