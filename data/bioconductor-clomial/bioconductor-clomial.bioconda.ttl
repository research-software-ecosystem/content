@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clomial a schema1:SoftwareApplication ;
    schema1:alternateName "Infers clonal composition of a tumor" ;
    schema1:description "Clomial fits binomial distributions to counts obtained from Next Gen Sequencing data of multiple samples of the same tumor. The trained parameters can be interpreted to infer the clonal structure of the tumor." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Clomial_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Clomial/Clomial_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Clomial_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clomial/bioconductor-clomial_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:clomial" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-clomial" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Clomial.html" .

