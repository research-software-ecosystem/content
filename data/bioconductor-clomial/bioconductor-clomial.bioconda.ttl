@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clomial a schema:SoftwareApplication ;
    schema:description "Infers clonal composition of a tumor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Clomial_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Clomial/Clomial_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Clomial_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clomial/bioconductor-clomial_1.46.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-matrixstats",
        "r-permute" ;
    schema:identifier biotools:clomial ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-clomial" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Clomial.html" .

