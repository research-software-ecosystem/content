@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-process a schema1:SoftwareApplication ;
    schema1:alternateName "Ciphergen SELDI-TOF Processing" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A package for processing protein mass spectrometry data." ;
    schema1:identifier <https://bio.tools/biotools:process> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-process" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PROcess.html" .

