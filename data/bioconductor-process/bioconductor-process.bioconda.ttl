@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-process a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Ciphergen SELDI-TOF Processing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PROcess_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PROcess/PROcess_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PROcess_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-process/bioconductor-process_1.86.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-icens",
        "r-base" ;
    schema:identifier biotools:process ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-process" ;
    schema:softwareVersion "1.86.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PROcess.html" .

