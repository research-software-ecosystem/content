@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:secedo a schema:SoftwareApplication ;
    schema:description "SNV-based clustering for single-cell sequencing data." ;
    schema:downloadUrl "https://github.com/ratschlab/secedo/archive/refs/tags/v1.0.7.tar.gz" ;
    schema:hasPart "arpack",
        "hdf5",
        "jsoncpp",
        "libgomp",
        "liblapack",
        "llvm-openmp",
        "openblas",
        "superlu",
        "zlib" ;
    schema:identifier biotools:secedo ;
    schema:license "MIT" ;
    schema:name "secedo" ;
    schema:softwareVersion "1.0.7" ;
    schema:url "https://github.com/ratschlab/secedo" .

