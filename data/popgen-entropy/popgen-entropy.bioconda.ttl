@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:popgen-entropy a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2020.07.31.231514" ;
    schema:description "This program is for inferring population structure from autopolyploid and mixed-ploidy individuals." ;
    schema:downloadUrl "https://bitbucket.org/buerklelab/mixedploidy-entropy/get/550355eac120.zip" ;
    schema:hasPart "gsl",
        "hdf5",
        "zlib" ;
    schema:identifier biotools:popgen-entropy ;
    schema:license "GPLv3" ;
    schema:name "popgen-entropy" ;
    schema:softwareVersion "2.0" ;
    schema:url "https://bitbucket.org/buerklelab/mixedploidy-entropy/src/master/" .

