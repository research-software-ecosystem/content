@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annotationdbi a schema1:SoftwareApplication ;
    schema1:alternateName "Manipulation of SQLite-based annotations in Bioconductor" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Implements a user-friendly interface for querying SQLite-based annotation data packages." ;
    schema1:identifier biotools:annotationdbi ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-annotationdbi" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationDbi.html" .

