@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annotationdbi a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Manipulation of SQLite-based annotations in Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/AnnotationDbi_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AnnotationDbi_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AnnotationDbi/AnnotationDbi_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationdbi/bioconductor-annotationdbi_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-iranges",
        "bioconductor-keggrest",
        "bioconductor-s4vectors",
        "r-base",
        "r-dbi",
        "r-rsqlite" ;
    schema:identifier biotools:annotationdbi ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-annotationdbi" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationDbi.html" .

