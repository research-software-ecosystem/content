@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hpar a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Human Protein Atlas in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/hpar_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/hpar/hpar_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/hpar_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hpar/bioconductor-hpar_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-experimenthub",
        "r-base" ;
    schema:identifier biotools:hpar ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-hpar" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/hpar.html" .

