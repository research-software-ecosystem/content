@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gffread a schema:SoftwareApplication ;
    schema:citation "doi:10.12688/f1000research.23297.2" ;
    schema:description "GFF/GTF utility providing format conversions, region filtering, FASTA sequence extraction and more." ;
    schema:downloadUrl "https://github.com/gpertea/gffread/releases/download/v0.12.9/gffread-0.12.9.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:gffread ;
    schema:license "MIT" ;
    schema:name "gffread" ;
    schema:softwareHelp "https://ccb.jhu.edu/software/stringtie/gff.shtml#gffread" ;
    schema:softwareVersion "0.12.9" ;
    schema:url "https://ccb.jhu.edu/software/stringtie/gff.shtml" .

