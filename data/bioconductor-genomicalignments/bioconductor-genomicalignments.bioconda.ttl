@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genomicalignments a schema1:SoftwareApplication ;
    schema1:alternateName "Representation and manipulation of short genomic alignments" ;
    schema1:description "Provides efficient containers for storing and manipulating short genomic alignments (typically obtained by aligning short reads to a reference genome). This includes read counting, computing the coverage, junction detection, and working with the nucleotide content of the alignments." ;
    schema1:identifier <https://bio.tools/biotools:genomicalignments> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genomicalignments" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicAlignments.html" .

