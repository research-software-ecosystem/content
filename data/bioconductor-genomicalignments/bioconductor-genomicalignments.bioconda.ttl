@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genomicalignments a schema:SoftwareApplication ;
    schema:description "Representation and manipulation of short genomic alignments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GenomicAlignments_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicAlignments/GenomicAlignments_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicAlignments_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomicalignments/bioconductor-genomicalignments_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-cigarillo",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:genomicalignments ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genomicalignments" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicAlignments.html" .

