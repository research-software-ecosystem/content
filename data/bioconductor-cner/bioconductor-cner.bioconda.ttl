@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cner a schema1:SoftwareApplication ;
    schema1:alternateName "CNE Detection and Visualization" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Large-scale identification and advanced visualization of sets of conserved noncoding elements." ;
    schema1:identifier <https://bio.tools/biotools:cner> ;
    schema1:license "GPL-2 | file LICENSE" ;
    schema1:name "bioconductor-cner" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CNEr.html" .

