@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ctc a schema1:SoftwareApplication ;
    schema1:alternateName "Cluster and Tree Conversion." ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Tools for export and import classification trees and clusters to other programs" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ctc_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ctc/ctc_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ctc_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ctc/bioconductor-ctc_1.84.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ctc" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ctc" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ctc.html" .

