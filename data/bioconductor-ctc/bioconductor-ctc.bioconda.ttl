@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ctc a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Cluster and Tree Conversion." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ctc_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ctc/ctc_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ctc_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ctc/bioconductor-ctc_1.84.0_src_all.tar.gz" ;
    schema:hasPart "r-amap",
        "r-base" ;
    schema:identifier biotools:ctc ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ctc" ;
    schema:softwareVersion "1.84.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ctc.html" .

