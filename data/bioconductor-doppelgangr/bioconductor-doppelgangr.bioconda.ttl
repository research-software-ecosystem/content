@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-doppelgangr a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/jnci/djw146" ;
    schema:description "Identify likely duplicate samples from genomic or meta-data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/doppelgangR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/doppelgangR/doppelgangR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/doppelgangR_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-doppelgangr/bioconductor-doppelgangr_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocparallel",
        "bioconductor-impute",
        "bioconductor-summarizedexperiment",
        "bioconductor-sva",
        "r-base",
        "r-digest",
        "r-mnormt" ;
    schema:identifier biotools:doppelgangr ;
    schema:license "GPL (>=2.0)" ;
    schema:name "bioconductor-doppelgangr" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/doppelgangR.html" .

