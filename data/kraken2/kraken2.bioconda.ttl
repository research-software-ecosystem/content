@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kraken2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2014-15-3-r46",
        "doi:10.1186/s13059-019-1891-0" ;
    schema:description "Kraken2 is a system for assigning taxonomic labels to short DNA sequences, usually obtained through metagenomic studies." ;
    schema:downloadUrl "https://github.com/DerrickWood/kraken2/archive/refs/tags/v2.17.1.tar.gz" ;
    schema:hasPart "gperftools",
        "libgomp",
        "llvm-openmp",
        "perl",
        "rsync",
        "tar",
        "wget",
        "zlib" ;
    schema:identifier biotools:kraken2 ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "kraken2" ;
    schema:softwareHelp "https://github.com/DerrickWood/kraken2/blob/v2.17.1/docs/MANUAL.markdown" ;
    schema:softwareVersion "2.17.1" ;
    schema:url "https://ccb.jhu.edu/software/kraken2" .

