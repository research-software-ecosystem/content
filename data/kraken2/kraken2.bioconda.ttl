    schema1:identifier <https://bio.tools/biotools:kraken2>,
        "usegalaxy-eu:kraken2" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "kraken2" ;
    schema1:softwareVersion "2.17.1" ;
