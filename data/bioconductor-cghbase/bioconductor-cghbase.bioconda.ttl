@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cghbase a schema1:SoftwareApplication ;
    schema1:alternateName "CGHbase: Base functions and classes for arrayCGH data analysis." ;
    schema1:citation "doi:10.1016/j.ejmg.2005.10.046" ;
    schema1:description "Contains functions and classes that are needed by arrayCGH packages." ;
    schema1:identifier <https://bio.tools/biotools:cghbase> ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-cghbase" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CGHbase.html" .

