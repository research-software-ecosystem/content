@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cghbase a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ejmg.2005.10.046" ;
    schema:description "CGHbase: Base functions and classes for arrayCGH data analysis." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CGHbase_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CGHbase/CGHbase_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CGHbase_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cghbase/bioconductor-cghbase_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-marray",
        "r-base" ;
    schema:identifier biotools:cghbase ;
    schema:license "GPL" ;
    schema:name "bioconductor-cghbase" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CGHbase.html" .

