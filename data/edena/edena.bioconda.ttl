@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:edena a schema1:SoftwareApplication ;
    schema1:alternateName "De novo short reads assembler." ;
    schema1:description "De novo short reads assembler." ;
    schema1:downloadUrl "http://www.genomic.ch/edena/EdenaV3.131028.tar.gz" ;
    schema1:identifier "biotools:edena",
        "usegalaxy-eu:edena_ass_wrapper",
        "usegalaxy-eu:edena_ovl_wrapper" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "edena" ;
    schema1:softwareVersion "3.131028" ;
    schema1:url "http://www.genomic.ch/edena.php" .

