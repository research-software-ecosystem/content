@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:edena a schema:SoftwareApplication ;
    schema:description "De novo short reads assembler." ;
    schema:downloadUrl "http://www.genomic.ch/edena/EdenaV3.131028.tar.gz" ;
    schema:identifier biotools:edena ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "edena" ;
    schema:softwareVersion "3.131028" ;
    schema:url "http://www.genomic.ch/edena.php" .

