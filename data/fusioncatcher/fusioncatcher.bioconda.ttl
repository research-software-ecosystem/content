@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fusioncatcher a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/011650" ;
    schema:description "Finder of Somatic Fusion Genes in RNA-seq data." ;
    schema:downloadUrl "https://github.com/bioinformaticsorphanage/fusioncatcher/archive/refs/tags/1.33b.tar.gz" ;
    schema:identifier biotools:fusioncatcher ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "fusioncatcher" ;
    schema:softwareVersion "1.33b" ;
    schema:url "https://github.com/bioinformaticsorphanage/fusioncatcher" .

