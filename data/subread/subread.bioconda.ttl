@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:subread a schema:SoftwareApplication ;
    schema:author "mjsteinbaugh" ;
    schema:citation "doi:10.1093/nar/gkt214" ;
    schema:description "High-performance read alignment, quantification, and mutation discovery." ;
    schema:downloadUrl "https://downloads.sourceforge.net/project/subread/subread-2.1.1/subread-2.1.1-source.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:subread ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "mjsteinbaugh" ;
    schema:name "subread" ;
    schema:softwareHelp "https://subread.sourceforge.net/SubreadUsersGuide.pdf" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "https://subread.sourceforge.net" .

