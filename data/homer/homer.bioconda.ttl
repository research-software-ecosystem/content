@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:homer a schema1:SoftwareApplication ;
    schema1:alternateName "Software for motif discovery and next generation sequencing analysis." ;
    schema1:citation "doi:10.1016/j.molcel.2010.05.004" ;
    schema1:description "Software for motif discovery and next generation sequencing analysis." ;
    schema1:identifier biotools:homer,
        "usegalaxy-eu:homer_gtf_to_annotations" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "BioNinja",
        "cokelaer",
        "r78v10a07",
        "simonvh" ;
    schema1:name "homer" ;
    schema1:softwareVersion "5.1" ;
    schema1:url "http://homer.ucsd.edu/homer/index.html" .

