@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:homer a schema:SoftwareApplication ;
    schema:author "BioNinja",
        "cokelaer",
        "r78v10a07",
        "simonvh" ;
    schema:citation "doi:10.1016/j.molcel.2010.05.004" ;
    schema:description "Software for motif discovery and next generation sequencing analysis." ;
    schema:downloadUrl "http://homer.ucsd.edu/homer/configureHomer.pl" ;
    schema:hasPart "perl",
        "tar",
        "unzip",
        "wget",
        "zip" ;
    schema:identifier biotools:homer ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "BioNinja",
        "cokelaer",
        "r78v10a07",
        "simonvh" ;
    schema:name "homer" ;
    schema:softwareHelp "http://homer.ucsd.edu/homer/homer2.html" ;
    schema:softwareVersion "5.1" ;
    schema:url "http://homer.ucsd.edu/homer/index.html" .

