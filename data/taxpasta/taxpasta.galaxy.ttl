@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:taxpasta a schema1:SoftwareApplication ;
    bioschemas:output "biom1",
        "tabular" ;
    schema1:applicationSubCategory edam:data_3028,
        edam:topic_0637,
        edam:topic_3174 ;
    schema1:codeRepository <https://taxpasta.readthedocs.io/en/latest/> ;
    schema1:dateCreated "2023-08-30" ;
    schema1:description "standardise taxonomic profiles" ;
    schema1:encodingFormat "biom1",
        "tabular" ;
    schema1:featureList edam:operation_3434,
        edam:operation_3435,
        edam:operation_3436 ;
    schema1:identifier biotools:taxpasta,
        bioconda:taxpasta ;
    schema1:isPartOf <https://galaxy.mesocentre.uca.fr>,
        <https://galaxytrakr.org>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=7491883694fff308>,
        <https://usegalaxy.eu/published/workflow?id=b14845359b702444>,
        <https://usegalaxy.eu/published/workflow?id=cb2df493f5e334f7>,
        <https://usegalaxy.fr> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "taxpasta" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/taxpasta> .

<https://galaxy.mesocentre.uca.fr> a schema1:WebSite .

<https://galaxytrakr.org> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.fr> a schema1:WebSite .

