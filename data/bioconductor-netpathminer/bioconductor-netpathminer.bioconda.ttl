@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-netpathminer a schema:SoftwareApplication ;
    schema:description "NetPathMiner for Biological Network Construction, Path Mining and Visualization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/NetPathMiner_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NetPathMiner/NetPathMiner_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/NetPathMiner_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-netpathminer/bioconductor-netpathminer_1.46.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "libxml2",
        "r-base",
        "r-igraph",
        "zlib" ;
    schema:identifier biotools:netpathminer ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-netpathminer" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/NetPathMiner.html" .

