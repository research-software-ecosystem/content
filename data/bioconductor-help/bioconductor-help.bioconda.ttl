@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-help a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Tools for HELP data analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HELP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HELP/HELP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HELP_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-help/bioconductor-help_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:help ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-help" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HELP.html" .

