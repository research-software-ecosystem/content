@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-help a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for HELP data analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The package contains a modular pipeline for analysis of HELP microarray data, and includes graphical and mathematical tools with more general applications." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HELP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HELP/HELP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HELP_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-help/bioconductor-help_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:help" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-help" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HELP.html" .

