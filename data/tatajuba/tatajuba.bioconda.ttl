@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tatajuba a schema:SoftwareApplication ;
    schema:description "Identification and classification of homopolymeric tracts from reads" ;
    schema:hasPart "check",
        "libgcc-ng",
        "libgomp",
        "zlib" ;
    schema:identifier biotools:tatajuba ;
    schema:license "GPLv3" ;
    schema:name "tatajuba" ;
    schema:softwareVersion "1.0.4" ;
    schema:url "https://github.com/quadram-institute-bioscience/tatajuba" .

