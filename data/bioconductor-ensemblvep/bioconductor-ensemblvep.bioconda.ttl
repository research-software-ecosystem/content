@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ensemblvep a schema1:SoftwareApplication ;
    schema1:alternateName "R Interface to Ensembl Variant Effect Predictor" ;
    schema1:citation "doi:10.1186/s13059-016-0974-4" ;
    schema1:description "Query the Ensembl Variant Effect Predictor via the perl API." ;
