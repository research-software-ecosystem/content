@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ensemblvep a schema1:SoftwareApplication ;
    schema1:alternateName "R Interface to Ensembl Variant Effect Predictor" ;
    schema1:citation "doi:10.1186/s13059-016-0974-4" ;
    schema1:description "Query the Ensembl Variant Effect Predictor via the perl API." ;
    schema1:identifier <https://bio.tools/biotools:ensemblvep> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ensemblvep" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/ensemblVEP.html" .

