@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ensemblvep a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1186/s13059-016-0974-4" ;
    schema1:description "R Interface to Ensembl Variant Effect Predictor" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ensemblVEP_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/ensemblVEP/ensemblVEP_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/ensemblVEP_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ensemblvep/bioconductor-ensemblvep_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "r-base" ;
    schema1:identifier biotools:ensemblvep ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ensemblvep" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/ensemblVEP.html" .

