    schema1:dateCreated "2018-08-02" ;
    schema1:description "Exonerate is a generic tool for pairwise sequence comparison." ;
    schema1:encodingFormat "gff",
        "gff3",
        "txt" ;
    schema1:featureList edam:operation_0302,
        edam:operation_0491,
        edam:operation_3182 ;
    schema1:identifier biotools:exonerate,
        bioconda:exonerate ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org/published/workflow?id=f74ee88aff766e20> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "exonerate" ;
    schema1:softwareVersion "2.4.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/exonerate> .

