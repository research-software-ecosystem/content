@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:exonerate a schema:SoftwareApplication ;
    schema:description "Exonerate - A generic tool for pairwise sequence comparison / alignment." ;
    schema:downloadUrl "http://ftp.ebi.ac.uk/pub/software/vertebrategenomics/exonerate/exonerate-2.4.0.tar.gz" ;
    schema:hasPart "glib",
        "pcre",
        "wget" ;
    schema:identifier biotools:exonerate ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "exonerate" ;
    schema:softwareVersion "2.4.0" ;
    schema:url "http://ftp.ebi.ac.uk/pub/software/vertebrategenomics/exonerate" .

