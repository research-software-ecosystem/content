@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:metamdbg a schema1:SoftwareApplication ;
    bioschemas:output "fasta.gz",
        "gfa1",
        "tar.gz",
        "txt" ;
    schema1:applicationSubCategory edam:topic_3174 ;
    schema1:codeRepository "https://github.com/GaetanBenoitDev/metaMDBG" ;
    schema1:dateCreated "2025-02-04" ;
    schema1:description "MetaMDBG is a fast and low-memory assembler for long and accurate metagenomics reads." ;
    schema1:encodingFormat "fasta.gz",
        "gfa1",
        "tar.gz",
        "txt" ;
    schema1:featureList edam:operation_0525,
        edam:operation_3440 ;
    schema1:identifier biotools:metamdbg,
        bioconda:metamdbg ;
    schema1:keywords "Assembly",
        "Metagenomics" ;
    schema1:name "metamdbg" ;
    schema1:softwareVersion "1.4" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/metamdbg" .

