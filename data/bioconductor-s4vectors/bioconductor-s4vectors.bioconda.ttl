@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-s4vectors a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Foundation of vector-like and list-like containers in Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/S4Vectors_0.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/S4Vectors/S4Vectors_0.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/S4Vectors_0.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-s4vectors/bioconductor-s4vectors_0.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:s4vectors ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-s4vectors" ;
    schema:softwareVersion "0.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/S4Vectors.html" .

