@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fastani a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-018-07641-9" ;
    schema:description "FastANI is developed for fast alignment-free computation of whole-genome Average Nucleotide Identity (ANI)." ;
    schema:downloadUrl "https://github.com/ParBLiSS/FastANI/archive/v1.34.tar.gz" ;
    schema:hasPart "gsl",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:fastani ;
    schema:license "Apache-2.0" ;
    schema:name "fastani" ;
    schema:softwareHelp "https://github.com/ParBLiSS/FastANI/blob/v1.34/README.md" ;
    schema:softwareVersion "1.34" ;
    schema:url "https://github.com/ParBLiSS/FastANI" .

