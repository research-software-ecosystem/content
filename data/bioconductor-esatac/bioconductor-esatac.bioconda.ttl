@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-esatac a schema:SoftwareApplication ;
    schema:description "An Easy-to-use Systematic pipeline for ATACseq data analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/esATAC_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/esATAC/esATAC_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/esATAC_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-esatac/bioconductor-esatac_1.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-chipseeker",
        "bioconductor-clusterprofiler",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-jaspar2018",
        "bioconductor-motifmatchr",
        "bioconductor-pipeframe",
        "bioconductor-rbowtie2",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-shortread",
        "bioconductor-tfbstools",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-biocmanager",
        "r-corrplot",
        "r-digest",
        "r-ggplot2",
        "r-igraph",
        "r-knitr",
        "r-magrittr",
        "r-r.utils",
        "r-rcpp",
        "r-rjava",
        "r-rmarkdown",
        "r-venndiagram",
        "zlib" ;
    schema:identifier biotools:esATAC ;
    schema:license "GPL-3 | file LICENSE" ;
    schema:name "bioconductor-esatac" ;
    schema:softwareVersion "1.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/esATAC.html" .

