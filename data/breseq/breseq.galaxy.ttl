@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:breseq a schema1:SoftwareApplication ;
    bioschemas:output "html",
        "phylip",
        "tabular",
        "txt",
        "zip" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:topic_0080,
        edam:topic_2533,
        edam:topic_3168 ;
    schema1:codeRepository <https://github.com/barricklab/breseq> ;
    schema1:dateCreated "2019-10-21" ;
    schema1:description "Predicts mutations in microbial genomes" ;
    schema1:encodingFormat "html",
        "phylip",
        "tabular",
        "txt",
        "zip" ;
    schema1:featureList edam:operation_3202 ;
    schema1:identifier biotools:breseq,
        bioconda:breseq ;
    schema1:isPartOf <https://galaxy.pasteur.fr>,
        <https://galaxytrakr.org>,
        <https://mississippi.sorbonne-universite.fr>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "breseq" ;
    schema1:softwareVersion "0.35.5" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/breseq> .

