@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:breseq a schema1:SoftwareApplication ;
    schema1:alternateName "A computational pipeline for finding mutations relative to a reference sequence in short-read DNA re-sequencing data." ;
    schema1:description "A computational pipeline for finding mutations relative to a reference sequence in short-read DNA re-sequencing data." ;
    schema1:identifier <https://bio.tools/biotools:breseq>,
        "usegalaxy-eu:breseq" ;
    schema1:license "GPL-2.0-or-later" ;
    schema1:name "breseq" ;
    schema1:softwareVersion "0.40.2" ;
    schema1:url "https://github.com/barricklab/breseq" .

