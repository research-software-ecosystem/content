@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:breseq a schema:SoftwareApplication ;
    schema:description "A computational pipeline for finding mutations relative to a reference sequence in short-read DNA re-sequencing data." ;
    schema:downloadUrl "https://github.com/barricklab/breseq/releases/download/v0.40.1/breseq-0.40.1-Source.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:breseq ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "breseq" ;
    schema:softwareHelp "https://barricklab.org/twiki/pub/Lab/ToolsBacterialGenomeResequencing/documentation/" ;
    schema:softwareVersion "0.40.1" ;
    schema:url "https://github.com/barricklab/breseq" .

