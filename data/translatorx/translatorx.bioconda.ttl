@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:translatorx a schema:SoftwareApplication ;
    schema:description "Multiple alignment of nucleotide sequences guided by amino acid information" ;
    schema:downloadUrl "http://pc16141.mncn.csic.es/cgi-bin/translatorx_vLocal.pl" ;
    schema:identifier biotools:translatorx ;
    schema:license "unknown" ;
    schema:name "translatorx" ;
    schema:softwareVersion "1.1" ;
    schema:url "http://pc16141.mncn.csic.es/" .

