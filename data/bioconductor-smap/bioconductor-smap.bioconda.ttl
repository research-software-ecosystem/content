@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-smap a schema1:SoftwareApplication ;
    schema1:alternateName "A Segmental Maximum A Posteriori Approach to Array-CGH Copy Number Profiling" ;
    schema1:citation "doi:10.1093/bioinformatics/btn003" ;
    schema1:description "Functions and classes for DNA copy number profiling of array-CGH data" ;
    schema1:identifier biotools:smap ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-smap" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/SMAP.html" .

