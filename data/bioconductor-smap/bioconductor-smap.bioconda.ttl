@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-smap a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn003" ;
    schema:description "A Segmental Maximum A Posteriori Approach to Array-CGH Copy Number Profiling" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SMAP_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/SMAP/SMAP_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/SMAP_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-smap/bioconductor-smap_1.66.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:smap ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-smap" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/SMAP.html" .

