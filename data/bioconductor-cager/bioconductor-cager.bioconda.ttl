@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cager a schema1:SoftwareApplication ;
    schema1:description "Analysis of CAGE (Cap Analysis of Gene Expression) sequencing data for precise mapping of transcription start sites and promoterome mining" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CAGEr_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CAGEr/CAGEr_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CAGEr_2.16.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cager/bioconductor-cager_2.16.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-cagefightr",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-multiassayexperiment",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-data.table",
        "r-formula.tools",
        "r-ggplot2",
        "r-gtools",
        "r-kernsmooth",
        "r-matrix",
        "r-memoise",
        "r-plyr",
        "r-reshape2",
        "r-rlang",
        "r-scales",
        "r-som",
        "r-stringdist",
        "r-stringi",
        "r-vegan",
        "r-vgam" ;
    schema1:identifier biotools:cager ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-cager" ;
    schema1:softwareVersion "2.16.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CAGEr.html" .

