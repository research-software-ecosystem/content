@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-splinetimer a schema1:SoftwareApplication ;
    schema1:alternateName "Time-course differential gene expression data analysis using spline regression models followed by gene association network reconstruction" ;
    schema1:citation "doi:10.1371/journal.pone.0160791" ;
    schema1:description "This package provides functions for differential gene expression analysis of gene expression time-course data. Natural cubic spline regression models are used. Identified genes may further be used for pathway enrichment analysis and/or the reconstruction of time dependent gene regulatory association networks." ;
    schema1:identifier <https://bio.tools/biotools:splinetimer> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-splinetimer" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/splineTimeR.html" .

