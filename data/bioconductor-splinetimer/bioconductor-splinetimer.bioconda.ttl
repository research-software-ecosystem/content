@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-splinetimer a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0160791" ;
    schema:description "Time-course differential gene expression data analysis using spline regression models followed by gene association network reconstruction" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/splineTimeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/splineTimeR/splineTimeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/splineTimeR_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-splinetimer/bioconductor-splinetimer_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-fis",
        "bioconductor-gseabase",
        "bioconductor-limma",
        "r-base",
        "r-genenet",
        "r-gtools",
        "r-igraph",
        "r-longitudinal" ;
    schema:identifier biotools:splinetimer ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-splinetimer" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/splineTimeR.html" .

