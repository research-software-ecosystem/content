@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-fgsea a schema1:SoftwareApplication ;
    schema1:alternateName "Fast Gene Set Enrichment Analysis" ;
    schema1:citation "doi:10.1101/060012" ;
    schema1:description "The package implements an algorithm for fast gene set enrichment analysis. Using the fast algorithm allows to make more permutations and get more fine grained p-values, which allows to use accurate stantard approaches to multiple hypothesis correction." ;
    schema1:identifier <https://bio.tools/biotools:fgsea> ;
    schema1:license "MIT + file LICENCE" ;
    schema1:name "bioconductor-fgsea" ;
    schema1:softwareVersion "1.36.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/fgsea.html" .

