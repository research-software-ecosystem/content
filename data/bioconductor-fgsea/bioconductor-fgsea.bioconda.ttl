@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-fgsea a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1101/060012" ;
    schema1:description "Fast Gene Set Enrichment Analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/fgsea_1.36.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/fgsea/fgsea_1.36.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/fgsea_1.36.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fgsea/bioconductor-fgsea_1.36.2_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocparallel",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-cowplot",
        "r-data.table",
        "r-fastmatch",
        "r-ggplot2",
        "r-matrix",
        "r-rcpp",
        "r-scales",
        "zlib" ;
    schema1:identifier biotools:fgsea ;
    schema1:license "MIT + file LICENCE" ;
    schema1:name "bioconductor-fgsea" ;
    schema1:softwareVersion "1.36.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/fgsea.html" .

