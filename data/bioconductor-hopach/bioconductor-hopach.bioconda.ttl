@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hopach a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Hierarchical Ordered Partitioning and Collapsing Hybrid (HOPACH)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/hopach_2.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/hopach/hopach_2.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/hopach_2.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hopach/bioconductor-hopach_2.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "zlib" ;
    schema:identifier biotools:hopach ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-hopach" ;
    schema:softwareVersion "2.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/hopach.html" .

