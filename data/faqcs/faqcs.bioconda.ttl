@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:faqcs a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-014-0366-2" ;
    schema:description "Quality Control of Next Generation Sequencing Data." ;
    schema:downloadUrl "https://github.com/LANL-Bioinformatics/FaQCs/archive/2.12.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "r-base",
        "zlib" ;
    schema:identifier biotools:faqcs ;
    schema:license "BSD-3-Clause" ;
    schema:name "faqcs" ;
    schema:softwareVersion "2.12" ;
    schema:url "https://github.com/LANL-Bioinformatics/FaQCs" .

