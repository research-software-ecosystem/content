@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:get_homologues a schema:SoftwareApplication ;
    schema:citation "doi:https://doi.org/10.1007/978-1-0716-2429-6_9",
        "doi:https://doi.org/10.1007/978-1-4939-1720-4_14",
        "doi:https://doi.org/10.1128/AEM.02411-13",
        "doi:https://doi.org/10.3389/fpls.2017.00184" ;
    schema:description "A versatile software package for pan-genome analysis, including GET_HOMOLOGUES and GET_HOMOLOGUES-EST" ;
    schema:downloadUrl "https://github.com/eead-csic-compbio/get_homologues/archive/refs/tags/v3.8.1.tar.gz" ;
    schema:identifier biotools:get_homologues ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "get_homologues" ;
    schema:softwareVersion "3.8.1" ;
    schema:url "https://github.com/eead-csic-compbio/get_homologues" .

