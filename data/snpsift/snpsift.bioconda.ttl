@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:snpsift a schema:SoftwareApplication ;
    schema:citation "doi:10.3389/fgene.2012.00035" ;
    schema:description "Toolbox that allows you to filter and manipulate annotated files" ;
    schema:downloadUrl "https://snpeff-public.s3.amazonaws.com/versions/snpEff_v5_4c_core.zip" ;
    schema:identifier biotools:SnpSift ;
    schema:license "LGPLv3" ;
    schema:name "snpsift" ;
    schema:softwareVersion "5.4.0c" ;
    schema:url "http://snpeff.sourceforge.net/SnpSift.html" .

