@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-crimage a schema:SoftwareApplication ;
    schema:citation "doi:10.1126/scitranslmed.3004330" ;
    schema:description "CRImage a package to classify cells and calculate tumour cellularity" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CRImage_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CRImage/CRImage_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CRImage_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-crimage/bioconductor-crimage_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-acgh",
        "bioconductor-dnacopy",
        "bioconductor-ebimage",
        "r-base",
        "r-e1071",
        "r-foreach",
        "r-mass",
        "r-sgeostat" ;
    schema:identifier biotools:crimage ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-crimage" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CRImage.html" .

