@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-crimage a schema1:SoftwareApplication ;
    schema1:alternateName "CRImage a package to classify cells and calculate tumour cellularity" ;
    schema1:citation "doi:10.1126/scitranslmed.3004330" ;
    schema1:description "CRImage provides functionality to process and analyze images, in particular to classify cells in biological images. Furthermore, in the context of tumor images, it provides functionality to calculate tumour cellularity." ;
    schema1:identifier biotools:crimage ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-crimage" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CRImage.html" .

