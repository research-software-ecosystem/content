@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clipper a schema1:SoftwareApplication ;
    schema1:description "Gene Set Analysis Exploiting Pathway Topology" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/clipper_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clipper/clipper_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clipper_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clipper/bioconductor-clipper_1.50.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "bioconductor-kegggraph",
        "bioconductor-qpgraph",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-corpcor",
        "r-grbase",
        "r-igraph",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:clipper ;
    schema1:license "AGPL-3" ;
    schema1:name "bioconductor-clipper" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clipper.html" .

