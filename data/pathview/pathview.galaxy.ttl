@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:pathview a schema1:SoftwareApplication ;
    bioschemas:output "pdf",
        "png" ;
    schema1:applicationSubCategory edam:topic_0092,
        edam:topic_0602,
        edam:topic_2259 ;
    schema1:codeRepository "https://bioconductor.org/packages/release/bioc/html/pathview.html" ;
    schema1:dateCreated "2019-08-26" ;
    schema1:description "Pathview is a tool set for pathway based data integration and visualization." ;
    schema1:encodingFormat "pdf",
        "png" ;
    schema1:featureList edam:operation_2497,
        edam:operation_3083 ;
    schema1:identifier biotools:pathview,
        bioconda:bioconductor-pathview ;
    schema1:isPartOf <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org.au/published/workflow?id=5490661d0153962b>,
        <https://usegalaxy.org/published/workflow?id=053f09b017c85ace>,
        <https://usegalaxy.org/published/workflow?id=3dd83e9ceaa9b749>,
        <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1713?version=2> ;
    schema1:keywords "Micro-array Analysis",
        "RNA",
        "Statistics" ;
    schema1:name "pathview" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/pathview" .

<https://usegalaxy.org> a schema1:WebSite .

