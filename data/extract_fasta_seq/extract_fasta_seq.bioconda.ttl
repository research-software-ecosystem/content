@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:extract_fasta_seq a schema:SoftwareApplication ;
    schema:author "linzhi2013" ;
    schema:description "To extract specific fasta sequences from a fasta file." ;
    schema:downloadUrl "https://pypi.io/packages/source/e/extract_fasta_seq/extract_fasta_seq-0.0.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:extract_fasta_seq ;
    schema:license "GNU General Public v3 or later (GPLv3+)" ;
    schema:maintainer "linzhi2013" ;
    schema:name "extract_fasta_seq" ;
    schema:softwareVersion "0.0.1" ;
    schema:url "https://github.com/linzhi2013/extract_fasta_seq" .

