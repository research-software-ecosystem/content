@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-triplex a schema1:SoftwareApplication ;
    schema1:alternateName "Search and visualize intramolecular triplex-forming sequences in DNA" ;
    schema1:description "This package provides functions for identification and visualization of potential intramolecular triplex patterns in DNA sequence. The main functionality is to detect the positions of subsequences capable of folding into an intramolecular triplex (H-DNA) in a much larger sequence. The potential H-DNA (triplexes) should be made of as many cannonical nucleotide triplets as possible. The package includes visualization showing the exact base-pairing in 1D, 2D or 3D." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/triplex_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/triplex/triplex_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/triplex_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-triplex/bioconductor-triplex_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:triplex" ;
    schema1:license "BSD_2_clause + file LICENSE" ;
    schema1:name "bioconductor-triplex" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/triplex.html" .

