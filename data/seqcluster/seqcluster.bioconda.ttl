@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seqcluster a schema:SoftwareApplication ;
    schema:description "small RNA analysis from NGS data" ;
    schema:downloadUrl "https://github.com/lpantano/seqcluster/archive/v1.2.9.tar.gz" ;
    schema:hasPart "python",
        "setuptools" ;
    schema:identifier biotools:seqcluster ;
    schema:license "MIT" ;
    schema:name "seqcluster" ;
    schema:softwareVersion "1.2.9" ;
    schema:url "https://github.com/lpantano/seqclsuter" .

