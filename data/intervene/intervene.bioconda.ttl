@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:intervene a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-017-1708-7" ;
    schema:description "A tool for intersection of multiple gene or genomic region sets and visualization as venn diagrams, UpSet plots or pariwaise heatmaps" ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/45/43/c8cc6574be4806653b43c2a974ed9751a512d75e2bd339261f8a65b98ad5/intervene-0.6.5.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:Intervene ;
    schema:license "MIT License" ;
    schema:name "intervene" ;
    schema:softwareVersion "0.6.5" ;
    schema:url "https://github.com/asntech/intervene" .

