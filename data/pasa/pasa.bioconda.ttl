@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pasa a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkg770",
        "doi:10.1186/gb-2008-9-1-r7" ;
    schema:description "Eukaryotic genome annotation tool" ;
    schema:downloadUrl "https://github.com/PASApipeline/PASApipeline/releases/download/pasa-v2.5.3/PASApipeline.v2.5.3.FULL.tar.gz" ;
    schema:identifier biotools:PASA ;
    schema:license "BSD-3-Clause" ;
    schema:name "pasa" ;
    schema:softwareHelp "https://github.com/PASApipeline/PASApipeline/wiki" ;
    schema:softwareVersion "2.5.3" ;
    schema:url "https://github.com/PASApipeline/PASApipeline" .

