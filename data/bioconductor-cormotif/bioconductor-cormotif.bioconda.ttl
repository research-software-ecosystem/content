@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cormotif a schema:SoftwareApplication ;
    schema:description "Correlation Motif Fit" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Cormotif_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Cormotif/Cormotif_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Cormotif_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cormotif/bioconductor-cormotif_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-limma",
        "r-base" ;
    schema:identifier biotools:cormotif ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-cormotif" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Cormotif.html" .

