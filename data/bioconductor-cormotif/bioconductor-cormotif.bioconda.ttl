@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cormotif a schema1:SoftwareApplication ;
    schema1:alternateName "Correlation Motif Fit" ;
    schema1:description "It fits correlation motif model to multiple studies to detect study specific differential expression patterns." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Cormotif_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Cormotif/Cormotif_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Cormotif_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cormotif/bioconductor-cormotif_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cormotif" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-cormotif" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Cormotif.html" .

