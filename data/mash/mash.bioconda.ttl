@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mash a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-016-0997-x",
        "doi:10.1186/s13059-019-1841-x" ;
    schema:description "Fast sequence distance estimator that uses MinHash." ;
    schema:downloadUrl "https://github.com/marbl/Mash/archive/v2.3.tar.gz" ;
    schema:hasPart "capnproto",
        "gsl",
        "libcblas",
        "libzlib",
        "zlib" ;
    schema:identifier biotools:mash ;
    schema:license "https://github.com/marbl/Mash/blob/master/LICENSE.txt" ;
    schema:name "mash" ;
    schema:softwareHelp "https://mash.readthedocs.io/en/latest" ;
    schema:softwareVersion "2.3" ;
    schema:url "https://github.com/marbl/Mash" .

