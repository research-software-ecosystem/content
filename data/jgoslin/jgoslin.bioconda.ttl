@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:jgoslin a schema:SoftwareApplication ;
    schema:citation "doi:10.5281/zenodo.7018207" ;
    schema:description "This project is a parser, validator and normalizer for shorthand lipid names, based on the Goslin project." ;
    schema:downloadUrl "https://repo1.maven.org/maven2/org/lifs-tools/jgoslin-cli/2.2.0/jgoslin-cli-2.2.0-bin.zip" ;
    schema:identifier biotools:jgoslin ;
    schema:license "Apache License 2.0" ;
    schema:name "jgoslin" ;
    schema:softwareVersion "2.2.0" ;
    schema:url "https://github.com/lifs-tools/jgoslin" .

