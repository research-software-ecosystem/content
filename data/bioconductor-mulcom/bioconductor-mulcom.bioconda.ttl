@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mulcom a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-12-382" ;
    schema:description "Calculates Mulcom test" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Mulcom_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Mulcom/Mulcom_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Mulcom_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mulcom/bioconductor-mulcom_1.60.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-fields",
        "zlib" ;
    schema:identifier biotools:mulcom ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-mulcom" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Mulcom.html" .

