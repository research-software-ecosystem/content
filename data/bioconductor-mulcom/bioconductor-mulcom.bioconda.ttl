@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mulcom a schema1:SoftwareApplication ;
    schema1:alternateName "Calculates Mulcom test" ;
    schema1:citation "doi:10.1186/1471-2105-12-382" ;
    schema1:description "Identification of differentially expressed genes and false discovery rate (FDR) calculation by Multiple Comparison test." ;
    schema1:identifier <https://bio.tools/biotools:mulcom> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-mulcom" ;
    schema1:softwareVersion "1.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Mulcom.html" .

