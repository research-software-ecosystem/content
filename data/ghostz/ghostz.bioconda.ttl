@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ghostz a schema:SoftwareApplication ;
    schema:author "tomkinsc" ;
    schema:citation "doi:10.1093/bioinformatics/btu780" ;
    schema:description "GHOSTZ is a highly efficient remote homologue detection tool." ;
    schema:downloadUrl "http://www.bi.cs.titech.ac.jp/ghostz/releases/ghostz-1.0.2.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:ghostz ;
    schema:license "BSD-2-Clause" ;
    schema:maintainer "tomkinsc" ;
    schema:name "ghostz" ;
    schema:softwareHelp "http://www.bi.cs.titech.ac.jp/ghostz" ;
    schema:softwareVersion "1.0.2" ;
    schema:url "http://www.bi.cs.titech.ac.jp/ghostz" .

