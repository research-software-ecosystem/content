@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ghostz a schema1:SoftwareApplication ;
    schema1:alternateName "GHOSTZ is a highly efficient remote homologue detection tool." ;
    schema1:citation "doi:10.1093/bioinformatics/btu780" ;
    schema1:description "GHOSTZ is a homology search tool which can detect remote homologues like BLAST and is about 200 times more efficient than BLAST by using database subsequence clustering. GHOSTZ outputs search results in the format similar to BLAST-tabular format." ;
    schema1:identifier <https://bio.tools/biotools:ghostz> ;
    schema1:license "BSD-2-Clause" ;
    schema1:maintainer "tomkinsc" ;
    schema1:name "ghostz" ;
    schema1:softwareVersion "1.0.2" ;
    schema1:url "http://www.bi.cs.titech.ac.jp/ghostz" .

