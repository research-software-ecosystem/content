@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-aldex2 a schema:SoftwareApplication ;
    schema:description "Analysis Of Differential Abundance Taking Sample and Scale Variation Into Account" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ALDEx2_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ALDEx2_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ALDEx2/ALDEx2_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aldex2/bioconductor-aldex2_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-multtest",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-directlabels",
        "r-lattice",
        "r-latticeextra",
        "r-rfast",
        "r-zcompositions" ;
    schema:identifier biotools:aldex2 ;
    schema:license "GPL (>=3)" ;
    schema:name "bioconductor-aldex2" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ALDEx2.html" .

