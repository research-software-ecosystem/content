@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pepstat a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-4939-3037-1_10" ;
    schema:description "Statistical analysis of peptide microarrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pepStat_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pepStat/pepStat_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pepStat_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pepstat/bioconductor-pepstat_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "r-base",
        "r-data.table",
        "r-fields",
        "r-ggplot2",
        "r-plyr" ;
    schema:identifier biotools:pepstat ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-pepstat" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pepStat.html" .

