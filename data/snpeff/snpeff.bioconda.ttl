@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:snpeff a schema1:SoftwareApplication ;
    schema1:alternateName "Genetic variant annotation and effect prediction toolbox" ;
    schema1:description "Genetic variant annotation and effect prediction toolbox" ;
    schema1:identifier <https://bio.tools/biotools:snpeff> ;
    schema1:license "LGPLv3" ;
    schema1:name "snpeff" ;
    schema1:softwareVersion "5.4.0c" ;
    schema1:url "http://snpeff.sourceforge.net/" .

