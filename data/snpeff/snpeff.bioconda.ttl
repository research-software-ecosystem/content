@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:snpeff a schema:SoftwareApplication ;
    schema:description "Genetic variant annotation and effect prediction toolbox" ;
    schema:downloadUrl "https://snpeff-public.s3.amazonaws.com/versions/snpEff_v5_4c_core.zip" ;
    schema:identifier biotools:snpeff ;
    schema:license "LGPLv3" ;
    schema:name "snpeff" ;
    schema:softwareVersion "5.4.0c" ;
    schema:url "http://snpeff.sourceforge.net/" .

