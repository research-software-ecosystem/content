@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:ptxqc a schema1:SoftwareApplication ;
    bioschemas:output "pdf" ;
    schema1:applicationSubCategory edam:topic_0121 ;
    schema1:codeRepository <https://github.com/cbielow/PTXQC> ;
    schema1:dateCreated "2025-04-16" ;
    schema1:description "Quality control reports for MaxQuant results" ;
    schema1:encodingFormat "pdf" ;
    schema1:featureList edam:operation_2428 ;
    schema1:identifier biotools:ptxqc,
        bioconda:r-ptxqc ;
    schema1:keywords "Proteomics" ;
    schema1:name "ptxqc" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproteomics/tools-galaxyp/tree/master/tools/ptxqc> .

