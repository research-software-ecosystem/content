@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ntedit a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btz400" ;
    schema:description "Ultrafast, lightweight, scalable genome assembly polishing, and SNV detection & annotation" ;
    schema:downloadUrl "https://github.com/BirolLab/ntEdit/releases/download/v2.1.1/ntEdit-2.1.1.tar.gz" ;
    schema:hasPart "boost-cpp",
        "btllib",
        "llvm-openmp",
        "perl",
        "python",
        "zlib" ;
    schema:identifier biotools:ntEdit ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "ntedit" ;
    schema:softwareHelp "https://github.com/BirolLab/ntEdit/blob/master/README.md" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "https://github.com/BirolLab/ntEdit" .

