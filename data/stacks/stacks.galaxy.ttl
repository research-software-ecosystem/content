@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:stacks a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "fastqsanger.gz",
        "html",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:operation_2429,
        edam:topic_0102,
        edam:topic_3056 ;
    schema1:codeRepository <http://catchenlab.life.illinois.edu/stacks/> ;
    schema1:dateCreated "2016-03-07" ;
    schema1:description "Stacks is a software pipeline for building loci from short-read sequences, such as RAD-seq" ;
    schema1:encodingFormat "fasta",
        "fastqsanger.gz",
        "html",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_2409,
        edam:operation_2427 ;
    schema1:identifier biotools:stacks,
        bioconda:stacks ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=d257b9294afbd85d>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au>,
        <https://workflowhub.eu/workflows/1662?version=1>,
        <https://workflowhub.eu/workflows/1665?version=1>,
        <https://workflowhub.eu/workflows/1666?version=1>,
        <https://workflowhub.eu/workflows/1683?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "stacks" ;
    schema1:softwareVersion "1.46.1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/stacks> .

