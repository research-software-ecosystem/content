@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:stacks a schema1:SoftwareApplication ;
    schema1:alternateName "Stacks is a software pipeline for building loci from short-read sequences." ;
    schema1:citation "doi:10.1111/mec.12354" ;
    schema1:description "Stacks is a software pipeline for building loci from short-read sequences." ;
    schema1:identifier <https://bio.tools/biotools:stacks>,
        "usegalaxy-eu:stacks2_clonefilter",
        "usegalaxy-eu:stacks2_cstacks",
        "usegalaxy-eu:stacks2_denovomap",
        "usegalaxy-eu:stacks2_gstacks",
        "usegalaxy-eu:stacks2_kmerfilter",
        "usegalaxy-eu:stacks2_populations",
        "usegalaxy-eu:stacks2_procrad",
        "usegalaxy-eu:stacks2_refmap",
        "usegalaxy-eu:stacks2_shortreads",
        "usegalaxy-eu:stacks2_sstacks",
        "usegalaxy-eu:stacks2_tsv2bam",
        "usegalaxy-eu:stacks2_ustacks" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "stacks" ;
    schema1:softwareVersion "2.68" ;
    schema1:url "https://catchenlab.life.illinois.edu/stacks" .

