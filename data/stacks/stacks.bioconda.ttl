@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:stacks a schema:SoftwareApplication ;
    schema:citation "doi:10.1111/mec.12354" ;
    schema:description "Stacks is a software pipeline for building loci from short-read sequences." ;
    schema:downloadUrl "https://catchenlab.life.illinois.edu/stacks/source/stacks-2.68.tar.gz" ;
    schema:hasPart "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:stacks ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "stacks" ;
    schema:softwareHelp "https://catchenlab.life.illinois.edu/stacks" ;
    schema:softwareVersion "2.68" ;
    schema:url "https://catchenlab.life.illinois.edu/stacks" .

