@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gmove a schema:SoftwareApplication ;
    schema:citation "doi:10.7490/f1000research.1111735.1" ;
    schema:description "Gmove is a gene prediction tool." ;
    schema:downloadUrl "https://github.com/institut-de-genomique/Gmove/archive/refs/tags/v1.3.tar.gz" ;
    schema:hasPart "boost-cpp" ;
    schema:identifier biotools:Gmove ;
    schema:license "MIT" ;
    schema:name "gmove" ;
    schema:softwareHelp "https://github.com/institut-de-genomique/Gmove/blob/v1.3/README.md" ;
    schema:softwareVersion "1.3" ;
    schema:url "https://github.com/institut-de-genomique/Gmove" .

