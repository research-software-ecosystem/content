@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sincei a schema:SoftwareApplication ;
    schema:citation "doi:10.5281/zenodo.8105536" ;
    schema:description "A user-friendly toolkit for QC, counting, clustering and plotting of single-cell (epi)genomics data." ;
    schema:downloadUrl "https://pypi.io/packages/source/s/sincei/sincei-0.5.2.tar.gz" ;
    schema:hasPart "hatchling",
        "pip",
        "python" ;
    schema:identifier biotools:sincei ;
    schema:license "MIT" ;
    schema:name "sincei" ;
    schema:softwareVersion "0.5.2" ;
    schema:url "https://github.com/bhardwaj-lab/sincei" .

