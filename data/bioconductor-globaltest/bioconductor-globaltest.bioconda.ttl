@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-globaltest a schema:SoftwareApplication ;
    schema:description "Testing Groups of Covariates/Features for Association with a Response Variable, with Applications to Gene Set Testing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/globaltest_5.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/globaltest/globaltest_5.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/globaltest_5.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-globaltest/bioconductor-globaltest_5.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "r-base",
        "r-survival" ;
    schema:identifier biotools:globaltest ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-globaltest" ;
    schema:softwareVersion "5.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/globaltest.html" .

