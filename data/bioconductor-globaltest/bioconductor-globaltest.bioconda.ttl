@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-globaltest a schema1:SoftwareApplication ;
    schema1:alternateName "Testing Groups of Covariates/Features for Association with a Response Variable, with Applications to Gene Set Testing" ;
    schema1:description "The global test tests groups of covariates (or features) for association with a response variable. This package implements the test with diagnostic plots and multiple testing utilities, along with several functions to facilitate the use of this test for gene set testing of GO and KEGG terms." ;
    schema1:identifier biotools:globaltest ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-globaltest" ;
    schema1:softwareVersion "5.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/globaltest.html" .

