@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:verifybamid a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ajhg.2012.09.004" ;
    schema:description "verifyBamID verifies identity and purity of sequence data" ;
    schema:downloadUrl "https://github.com/statgen/verifyBamID/releases/download/v1.1.3/verifyBamIDLibStatGen.1.1.3.tgz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:verifybamid ;
    schema:license "GPL3" ;
    schema:name "verifybamid" ;
    schema:softwareVersion "1.1.3" ;
    schema:url "http://genome.sph.umich.edu/wiki/VerifyBamID" .

