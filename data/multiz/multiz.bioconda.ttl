@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:multiz a schema:SoftwareApplication ;
    schema:description "DNA multiple sequence aligner from Penn State's Miller lab." ;
    schema:downloadUrl "https://github.com/multiz/multiz/archive/refs/tags/20190527.tar.gz" ;
    schema:identifier biotools:multiz ;
    schema:license "MIT" ;
    schema:name "multiz" ;
    schema:softwareVersion "11.2" ;
    schema:url "http://www.bx.psu.edu/miller_lab/" .

