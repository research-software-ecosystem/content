@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ray a schema1:SoftwareApplication ;
    schema1:alternateName "Parallel genome assemblies for parallel DNA sequencing." ;
    schema1:citation "doi:10.1186/gb-2012-13-12-r122" ;
    schema1:description "Parallel genome assemblies for parallel DNA sequencing." ;
    schema1:identifier biotools:ray ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "ray" ;
    schema1:softwareVersion "2.3.1" ;
    schema1:url "https://denovoassembler.sourceforge.net/index.html" .

