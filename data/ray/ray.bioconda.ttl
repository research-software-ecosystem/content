@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ray a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2012-13-12-r122" ;
    schema:description "Parallel genome assemblies for parallel DNA sequencing" ;
    schema:downloadUrl "https://downloads.sourceforge.net/project/denovoassembler/Ray-2.3.1.tar.bz2" ;
    schema:hasPart "openmpi" ;
    schema:identifier biotools:ray ;
    schema:license "GPL3" ;
    schema:name "ray" ;
    schema:softwareVersion "2.3.1" ;
    schema:url "http://denovoassembler.sourceforge.net/index.html" .

