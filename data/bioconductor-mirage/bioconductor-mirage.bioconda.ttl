@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mirage a schema1:SoftwareApplication ;
    schema1:alternateName "MiRNA Ranking by Gene Expression" ;
    schema1:description "The package contains functions for inferece of target gene regulation by miRNA, based on only target gene expression profile." ;
    schema1:identifier <https://bio.tools/biotools:mirage> ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-mirage" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MiRaGE.html" .

