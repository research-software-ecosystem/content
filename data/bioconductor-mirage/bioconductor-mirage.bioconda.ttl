@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mirage a schema:SoftwareApplication ;
    schema:description "MiRNA Ranking by Gene Expression" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MiRaGE_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MiRaGE/MiRaGE_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MiRaGE_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mirage/bioconductor-mirage_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-s4vectors",
        "r-base",
        "r-biocmanager" ;
    schema:identifier biotools:mirage ;
    schema:license "GPL" ;
    schema:name "bioconductor-mirage" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MiRaGE.html" .

