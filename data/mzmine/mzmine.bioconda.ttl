@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mzmine a schema:SoftwareApplication ;
    schema:description "Integrative analysis of multimodal mass spectrometry data." ;
    schema:downloadUrl "https://github.com/mzmine/mzmine/archive/refs/tags/v4.7.29.tar.gz" ;
    schema:identifier biotools:mzmine ;
    schema:license "MIT" ;
    schema:name "mzmine" ;
    schema:softwareHelp "https://mzmine.github.io/mzmine_documentation" ;
    schema:softwareVersion "4.7.29" ;
    schema:url "https://github.com/mzmine/mzmine" .

