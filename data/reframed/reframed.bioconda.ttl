@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:reframed a schema:SoftwareApplication ;
    schema:author "acaprez",
        "cdanielmachado",
        "lhtxa" ;
    schema:citation "doi:10.5281/zenodo.7955995" ;
    schema:description "Metabolic modeling package." ;
    schema:downloadUrl "https://pypi.io/packages/source/r/reframed/reframed-1.6.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:reframed ;
    schema:license "Apache-2.0" ;
    schema:maintainer "acaprez",
        "cdanielmachado",
        "lhtxa" ;
    schema:name "reframed" ;
    schema:softwareVersion "1.6.0" ;
    schema:url "https://github.com/cdanielmachado/reframed" .

