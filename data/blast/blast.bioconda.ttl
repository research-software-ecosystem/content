@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:blast a schema:SoftwareApplication ;
    schema:author "christiam",
        "ebete" ;
    schema:citation "doi:10.1016/S0022-2836(05)80360-2" ;
    schema:description "BLAST+ is a new suite of BLAST tools that utilizes the NCBI C++ Toolkit." ;
    schema:hasPart "bzip2",
        "curl",
        "entrez-direct",
        "ncbi-vdb",
        "sqlite",
        "zlib" ;
    schema:identifier biotools:blast ;
    schema:license "NCBI-PD" ;
    schema:maintainer "christiam",
        "ebete" ;
    schema:name "blast" ;
    schema:softwareVersion "2.17.0" ;
    schema:url "https://blast.ncbi.nlm.nih.gov/doc/blast-help/" .

