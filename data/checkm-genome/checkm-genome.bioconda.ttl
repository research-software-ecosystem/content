@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:checkm-genome a schema1:SoftwareApplication ;
    schema1:alternateName "Assess the quality of microbial genomes recovered from isolates, single cells, and metagenomes." ;
    schema1:citation "doi:10.1101/gr.186072.114" ;
    schema1:description "Assess the quality of microbial genomes recovered from isolates, single cells, and metagenomes." ;
    schema1:identifier biotools:checkm,
        "usegalaxy-eu:checkm_analyze",
        "usegalaxy-eu:checkm_lineage_set",
        "usegalaxy-eu:checkm_lineage_wf",
        "usegalaxy-eu:checkm_plot",
        "usegalaxy-eu:checkm_qa",
        "usegalaxy-eu:checkm_taxon_set",
        "usegalaxy-eu:checkm_taxonomy_wf",
        "usegalaxy-eu:checkm_tetra",
        "usegalaxy-eu:checkm_tree",
        "usegalaxy-eu:checkm_tree_qa" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "checkm-genome" ;
    schema1:softwareVersion "1.2.5" ;
    schema1:url "https://github.com/Ecogenomics/CheckM" .

