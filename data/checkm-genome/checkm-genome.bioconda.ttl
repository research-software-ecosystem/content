@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:checkm-genome a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.186072.114" ;
    schema:description "Assess the quality of microbial genomes recovered from isolates, single cells, and metagenomes." ;
    schema:downloadUrl "https://github.com/Ecogenomics/CheckM/archive/v1.2.5.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:checkm ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "checkm-genome" ;
    schema:softwareHelp "https://ecogenomics.github.io/CheckM" ;
    schema:softwareVersion "1.2.5" ;
    schema:url "https://github.com/Ecogenomics/CheckM" .

