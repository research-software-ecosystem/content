@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:magneto a schema:SoftwareApplication ;
    schema:citation "doi:10.1128/msystems.00432-22" ;
    schema:description "MAGNETO is an automated snakemake workflow dedicated to MAG reconstruction from metagenomic data." ;
    schema:downloadUrl "https://gitlab.univ-nantes.fr/bird_pipeline_registry/magneto/-/archive/1.5.2/magneto-1.5.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:magneto ;
    schema:license "GPL-3.0-only" ;
    schema:name "magneto" ;
    schema:softwareHelp "https://gitlab.univ-nantes.fr/bird_pipeline_registry/magneto/-/wikis/home" ;
    schema:softwareVersion "1.5.2" ;
    schema:url "https://gitlab.univ-nantes.fr/bird_pipeline_registry/magneto" .

