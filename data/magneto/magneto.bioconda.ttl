@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:magneto a schema1:SoftwareApplication ;
    schema1:alternateName "MAGNETO is an automated snakemake workflow dedicated to MAG reconstruction from metagenomic data." ;
    schema1:citation "doi:10.1128/msystems.00432-22" ;
    schema1:description "MAGNETO is an automated snakemake workflow dedicated to MAG reconstruction from metagenomic data." ;
    schema1:identifier <https://bio.tools/biotools:magneto> ;
    schema1:license "GPL-3.0-only" ;
    schema1:name "magneto" ;
    schema1:softwareVersion "1.5.2" ;
    schema1:url "https://gitlab.univ-nantes.fr/bird_pipeline_registry/magneto" .

