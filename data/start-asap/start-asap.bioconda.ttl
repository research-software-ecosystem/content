@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:start-asap a schema:SoftwareApplication ;
    schema:description "Prepare project directory and project sheet for ASA3P" ;
    schema:downloadUrl "https://github.com/quadram-institute-bioscience/start-asap/archive/v1.3.0.tar.gz" ;
    schema:identifier biotools:start-asap ;
    schema:license "MIT" ;
    schema:name "start-asap" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "http://github.com/quadram-institute-bioscience/start-asap/" .

