@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sylph a schema:SoftwareApplication ;
    schema:author "bluenote-1577" ;
    schema:citation "doi:10.1038/s41587-024-02412-y" ;
    schema:description "sylph quickly enables querying of genomes against even low-coverage shotgun metagenomes to find nearest neighbour ANI." ;
    schema:downloadUrl "https://github.com/bluenote-1577/sylph/archive/v0.9.0.tar.gz" ;
    schema:identifier biotools:sylph ;
    schema:license "MIT" ;
    schema:maintainer "bluenote-1577" ;
    schema:name "sylph" ;
    schema:softwareHelp "https://github.com/bluenote-1577/sylph/blob/v0.9.0/README.md" ;
    schema:softwareVersion "0.9.0" ;
    schema:url "https://github.com/bluenote-1577/sylph" .

