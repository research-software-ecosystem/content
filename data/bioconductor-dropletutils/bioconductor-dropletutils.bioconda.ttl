@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dropletutils a schema1:SoftwareApplication ;
    schema1:description "Utilities for Handling Single-Cell Droplet Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DropletUtils_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DropletUtils/DropletUtils_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DropletUtils_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dropletutils/bioconductor-dropletutils_1.30.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-assorthead",
        "bioconductor-beachmat",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-delayedarray",
        "bioconductor-delayedmatrixstats",
        "bioconductor-edger",
        "bioconductor-genomicranges",
        "bioconductor-hdf5array",
        "bioconductor-iranges",
        "bioconductor-rhdf5",
        "bioconductor-rhdf5lib",
        "bioconductor-s4vectors",
        "bioconductor-scuttle",
        "bioconductor-singlecellexperiment",
        "bioconductor-sparsearray",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-dqrng",
        "r-matrix",
        "r-r.utils",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:DropletUtils ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-dropletutils" ;
    schema1:softwareVersion "1.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DropletUtils.html" .

