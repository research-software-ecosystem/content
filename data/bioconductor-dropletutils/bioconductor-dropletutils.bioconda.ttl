@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dropletutils a schema1:SoftwareApplication ;
    schema1:alternateName "Utilities for Handling Single-Cell Droplet Data" ;
    schema1:description "Provides a number of utility functions for handling single-cell (RNA-seq) data from droplet technologies such as 10X Genomics. This includes data loading from count matrices or molecule information files, identification of cells from empty droplets, removal of barcode-swapped pseudo-cells, and downsampling of the count matrix." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DropletUtils_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DropletUtils/DropletUtils_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DropletUtils_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dropletutils/bioconductor-dropletutils_1.30.0_src_all.tar.gz" ;
    schema1:identifier "biotools:DropletUtils" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-dropletutils" ;
    schema1:softwareVersion "1.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DropletUtils.html" .

