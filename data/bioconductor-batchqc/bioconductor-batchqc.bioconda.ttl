@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-batchqc a schema1:SoftwareApplication ;
    schema1:description "Batch Effects Quality Control Software" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BatchQC_2.6.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BatchQC/BatchQC_2.6.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BatchQC_2.6.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-batchqc/bioconductor-batchqc_2.6.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-deseq2",
        "bioconductor-ebseq",
        "bioconductor-edger",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "bioconductor-scran",
        "bioconductor-summarizedexperiment",
        "bioconductor-sva",
        "r-base",
        "r-data.table",
        "r-dplyr",
        "r-fnn",
        "r-ggdendro",
        "r-ggnewscale",
        "r-ggplot2",
        "r-mass",
        "r-matrixstats",
        "r-pheatmap",
        "r-rcolorbrewer",
        "r-reader",
        "r-reshape2",
        "r-shiny",
        "r-shinyjs",
        "r-shinythemes",
        "r-tibble",
        "r-tidyr",
        "r-tidyverse",
        "r-umap" ;
    schema1:identifier biotools:batchqc ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-batchqc" ;
    schema1:softwareVersion "2.6.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BatchQC.html" .

