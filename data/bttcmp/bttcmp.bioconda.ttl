@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bttcmp a schema:SoftwareApplication ;
    schema:author "liaochenlanruo" ;
    schema:description "A toxin minging tool for Bacillus thuringiensis" ;
    schema:downloadUrl "https://github.com/liaochenlanruo/BTTCMP/archive/v1.0.3.tar.gz" ;
    schema:hasPart "perl",
        "perl-bioperl",
        "perl-file-tee" ;
    schema:identifier biotools:bttcmp ;
    schema:license "GPLv3" ;
    schema:maintainer "liaochenlanruo" ;
    schema:name "bttcmp" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/liaochenlanruo/BTTCMP/blob/master/README.md" .

