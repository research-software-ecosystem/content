@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-nucleosim a schema:SoftwareApplication ;
    schema:citation "doi:10.1515/sagmb-2014-0098" ;
    schema:description "Generate synthetic nucleosome maps" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/nucleoSim_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nucleoSim/nucleoSim_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/nucleoSim_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-nucleosim/bioconductor-nucleosim_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:nucleosim ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-nucleosim" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/nucleoSim.html" .

