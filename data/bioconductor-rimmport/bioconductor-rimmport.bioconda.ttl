@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rimmport a schema1:SoftwareApplication ;
    schema1:alternateName "RImmPort: Enabling Ready-for-analysis Immunology Research Data" ;
    schema1:citation "doi:10.1093/bioinformatics/btw719" ;
    schema1:description "The RImmPort package simplifies access to ImmPort data for analysis in the R environment. It provides a standards-based interface to the ImmPort study data that is in a proprietary format." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RImmPort_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RImmPort/RImmPort_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RImmPort_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rimmport/bioconductor-rimmport_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rimmport" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-rimmport" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RImmPort.html" .

