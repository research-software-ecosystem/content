@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rimmport a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw719" ;
    schema:description "RImmPort: Enabling Ready-for-analysis Immunology Research Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RImmPort_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RImmPort/RImmPort_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RImmPort_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rimmport/bioconductor-rimmport_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-data.table",
        "r-dbi",
        "r-dplyr",
        "r-plyr",
        "r-reshape2",
        "r-rsqlite",
        "r-sqldf" ;
    schema:identifier biotools:rimmport ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-rimmport" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RImmPort.html" .

