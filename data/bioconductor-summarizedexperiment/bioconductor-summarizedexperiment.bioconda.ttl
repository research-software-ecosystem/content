@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-summarizedexperiment a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A container (S4 class) for matrix-like assays" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SummarizedExperiment_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SummarizedExperiment/SummarizedExperiment_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SummarizedExperiment_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-summarizedexperiment/bioconductor-summarizedexperiment_1.40.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-delayedarray",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-s4arrays",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-matrix" ;
    schema1:identifier biotools:summarizedexperiment ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-summarizedexperiment" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SummarizedExperiment.html" .

