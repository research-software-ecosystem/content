@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bgmix a schema1:SoftwareApplication ;
    schema1:alternateName "Bayesian models for differential gene expression" ;
    schema1:citation "doi:10.2202/1544-6115.1314" ;
    schema1:description "Fully Bayesian mixture models for differential gene expression" ;
    schema1:identifier biotools:bgmix ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-bgmix" ;
    schema1:softwareVersion "1.59.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/BGmix.html" .

