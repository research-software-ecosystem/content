@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bgmix a schema:SoftwareApplication ;
    schema:citation "doi:10.2202/1544-6115.1314" ;
    schema:description "Bayesian models for differential gene expression" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BGmix_1.59.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/BGmix/BGmix_1.59.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/BGmix_1.59.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bgmix/bioconductor-bgmix_1.59.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "r-base",
        "r-kernsmooth" ;
    schema:identifier biotools:bgmix ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-bgmix" ;
    schema:softwareVersion "1.59.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/BGmix.html" .

