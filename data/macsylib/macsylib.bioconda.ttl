@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:macsylib a schema:SoftwareApplication ;
    schema:author "bneron" ;
    schema:citation "doi:10.24072/pcjournal.250" ;
    schema:description "MacSyLib: Python library that help to detect of macromolecular, systems genetic pathways… in prokaryotes protein datasets using systems modelling and similarity search." ;
    schema:downloadUrl "https://pypi.org/packages/source/m/macsylib/macsylib-1.0.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:macsylib ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "bneron" ;
    schema:name "macsylib" ;
    schema:softwareHelp "https://macsylib.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.0.4" ;
    schema:url "https://github.com/gem-pasteur/macsylib" .

