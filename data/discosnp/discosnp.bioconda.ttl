@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:discosnp a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkn000" ;
    schema:description "Reference-free small variant caller for short read sequencing data." ;
    schema:downloadUrl "https://github.com/GATB/DiscoSnp/releases/download/v2.6.2/DiscoSNP.-v2.6.2-Source.tar.gz" ;
    schema:hasPart "cppunit",
        "zlib" ;
    schema:identifier biotools:discosnp ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "discosnp" ;
    schema:softwareHelp "https://gatb.inria.fr/software/discosnp" ;
    schema:softwareVersion "2.6.2" ;
    schema:url "https://github.com/GATB/DiscoSnp" .

