    schema1:encodingFormat "pdf",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_3643,
        edam:operation_3741,
        edam:operation_3860 ;
    schema1:identifier biotools:msstatstmt,
        bioconda:bioconductor-msstats ;
    schema1:isPartOf <https://galaxy.mesocentre.uca.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
