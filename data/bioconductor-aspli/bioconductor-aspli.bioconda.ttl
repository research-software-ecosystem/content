@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-aspli a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Analysis of Alternative Splicing Using RNA-Seq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ASpli_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ASpli_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASpli/ASpli_2.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aspli/bioconductor-aspli_2.20.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biocstyle",
        "bioconductor-edger",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-txdbmaker",
        "r-base",
        "r-data.table",
        "r-dt",
        "r-htmltools",
        "r-igraph",
        "r-mass",
        "r-pbmcapply",
        "r-tidyr",
        "r-upsetr" ;
    schema:identifier biotools:aspli ;
    schema:license "GPL" ;
    schema:name "bioconductor-aspli" ;
    schema:softwareVersion "2.20.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ASpli.html" .

