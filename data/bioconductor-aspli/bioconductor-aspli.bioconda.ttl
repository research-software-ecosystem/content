@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-aspli a schema1:SoftwareApplication ;
    schema1:alternateName "Analysis of Alternative Splicing Using RNA-Seq" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Integrative pipeline for the analysis of alternative splicing using RNAseq." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ASpli_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ASpli_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASpli/ASpli_2.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aspli/bioconductor-aspli_2.20.0_src_all.tar.gz" ;
    schema1:identifier "biotools:aspli" ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-aspli" ;
    schema1:softwareVersion "2.20.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ASpli.html" .

