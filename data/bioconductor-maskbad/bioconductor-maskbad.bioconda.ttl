@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-maskbad a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp492" ;
    schema:description "Masking probes with binding affinity differences" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/maskBAD_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/maskBAD/maskBAD_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/maskBAD_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-maskbad/bioconductor-maskbad_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-gcrma",
        "r-base" ;
    schema:identifier biotools:maskbad ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-maskbad" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/maskBAD.html" .

