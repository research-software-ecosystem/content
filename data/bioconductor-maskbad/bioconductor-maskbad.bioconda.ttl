@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-maskbad a schema1:SoftwareApplication ;
    schema1:alternateName "Masking probes with binding affinity differences" ;
    schema1:citation "doi:10.1093/bioinformatics/btp492" ;
    schema1:description "Package includes functions to analyze and mask microarray expression data." ;
    schema1:identifier biotools:maskbad ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-maskbad" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/maskBAD.html" .

