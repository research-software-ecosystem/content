  "@id": "https://bio.tools/wfexs-backend",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "WfExS-backend (Workflow Execution Service Backend) automates the complete execution lifecycle of complex scientific workflows. It fetches and caches pipelines from GA4GH TRSv2-enabled registries (such as WorkflowHub and Dockstore), git repositories, or RO-Crate archives. WfExS-backend automatically configures workflow execution engines (including Nextflow and cwltool), resolves container dependencies (Singularity, Apptainer, Docker, or Podman), and fetches remote inputs referenced via URLs or CURIE persistent identifiers.\nBuilt to handle sensitive data in federated contexts and Trusted Research Environments, WfExS-backend features native Crypt4GH payload encryption and FUSE-encrypted working filesystems. Upon completion, it packages execution provenance, input references, and outputs into standardised FAIR RO-Crates",
  "sc:name": "WfExS-backend",
  "sc:softwareHelp": {
    "@id": "https://wfexs-backend.readthedocs.io/en/latest/"
  },
  "sc:softwareVersion": "1.0.10",
  "sc:url": "https://github.com/inab/WfExS-backend"
}