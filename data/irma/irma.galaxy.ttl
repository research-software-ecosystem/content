@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:irma a schema1:SoftwareApplication ;
    bioschemas:output "txt" ;
    schema1:codeRepository "https://wonder.cdc.gov/amd/flu/irma/irma.html" ;
    schema1:dateCreated "2024-11-09" ;
    schema1:description "Iterative Refinement Meta-Assembler (IRMA) is a tool to construct assembly of highly variable RNA viruses." ;
    schema1:encodingFormat "txt" ;
    schema1:featureList edam:operation_0523 ;
    schema1:identifier biotools:irma-virus,
        bioconda:irma ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "irma" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/irma" .

