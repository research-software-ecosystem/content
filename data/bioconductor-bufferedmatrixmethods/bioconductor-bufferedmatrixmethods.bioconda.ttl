@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bufferedmatrixmethods a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Microarray Data related methods that utlize BufferedMatrix objects" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BufferedMatrixMethods_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BufferedMatrixMethods/BufferedMatrixMethods_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BufferedMatrixMethods_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bufferedmatrixmethods/bioconductor-bufferedmatrixmethods_1.74.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-bufferedmatrix",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:bufferedmatrixmethods ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-bufferedmatrixmethods" ;
    schema:softwareVersion "1.74.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BufferedMatrixMethods.html" .

