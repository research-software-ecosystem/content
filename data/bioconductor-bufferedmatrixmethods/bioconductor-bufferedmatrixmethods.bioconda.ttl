@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bufferedmatrixmethods a schema1:SoftwareApplication ;
    schema1:alternateName "Microarray Data related methods that utlize BufferedMatrix objects" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Microarray analysis methods that use BufferedMatrix objects" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BufferedMatrixMethods_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BufferedMatrixMethods/BufferedMatrixMethods_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BufferedMatrixMethods_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bufferedmatrixmethods/bioconductor-bufferedmatrixmethods_1.74.0_src_all.tar.gz" ;
    schema1:identifier "biotools:bufferedmatrixmethods" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-bufferedmatrixmethods" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BufferedMatrixMethods.html" .

