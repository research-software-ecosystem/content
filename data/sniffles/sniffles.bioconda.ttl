@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:sniffles a schema1:SoftwareApplication ;
    schema1:alternateName "Sniffles is a structural variation caller using third generation sequencing (PacBio or Oxford Nanopore)." ;
    schema1:citation "doi:10.1038/s41587-023-02024-y",
        "doi:10.1038/s41592-018-0001-7" ;
    schema1:description "Sniffles is a structural variation caller using third generation sequencing (PacBio or Oxford Nanopore)." ;
    schema1:identifier <https://bio.tools/biotools:sniffles>,
        "usegalaxy-eu:sniffles" ;
    schema1:license "MIT" ;
    schema1:name "sniffles" ;
    schema1:softwareVersion "2.8.0" ;
    schema1:url "https://github.com/fritzsedlazeck/Sniffles" .

