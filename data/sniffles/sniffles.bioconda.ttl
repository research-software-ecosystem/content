@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sniffles a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41587-023-02024-y",
        "doi:10.1038/s41592-018-0001-7" ;
    schema:description "Sniffles is a structural variation caller using third generation sequencing (PacBio or Oxford Nanopore)." ;
    schema:downloadUrl "https://pypi.org/packages/source/s/sniffles/sniffles-2.8.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:sniffles ;
    schema:license "MIT" ;
    schema:name "sniffles" ;
    schema:softwareHelp "https://github.com/fritzsedlazeck/Sniffles/wiki" ;
    schema:softwareVersion "2.8.0" ;
    schema:url "https://github.com/fritzsedlazeck/Sniffles" .

