@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sc3 a schema1:SoftwareApplication ;
    schema1:alternateName "Single-Cell Consensus Clustering" ;
    schema1:description "A tool for unsupervised clustering and analysis of single cell RNA-Seq data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SC3_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SC3/SC3_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SC3_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sc3/bioconductor-sc3_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:sc3" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-sc3" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SC3.html" .

