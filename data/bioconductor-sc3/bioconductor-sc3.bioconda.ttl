@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sc3 a schema:SoftwareApplication ;
    schema:description "Single-Cell Consensus Clustering" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SC3_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SC3/SC3_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SC3_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sc3/bioconductor-sc3_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-s4vectors",
        "bioconductor-singlecellexperiment",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-doparallel",
        "r-dorng",
        "r-e1071",
        "r-foreach",
        "r-ggplot2",
        "r-pheatmap",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-robustbase",
        "r-rocr",
        "r-rrcov",
        "r-shiny",
        "r-writexls",
        "zlib" ;
    schema:identifier biotools:sc3 ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-sc3" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SC3.html" .

