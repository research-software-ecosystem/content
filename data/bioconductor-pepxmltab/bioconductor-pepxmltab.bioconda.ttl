@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pepxmltab a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Parsing pepXML files and filter based on peptide FDR." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pepXMLTab_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pepXMLTab/pepXMLTab_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pepXMLTab_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pepxmltab/bioconductor-pepxmltab_1.44.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-xml" ;
    schema:identifier biotools:pepxmltab ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-pepxmltab" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pepXMLTab.html" .

