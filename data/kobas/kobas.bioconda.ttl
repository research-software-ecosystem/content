@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:kobas a schema1:SoftwareApplication ;
    schema1:alternateName "KEGG Orthology Based Annotation System" ;
    schema1:description "KEGG Orthology Based Annotation System" ;
    schema1:identifier <https://bio.tools/biotools:kobas> ;
    schema1:license "Biopython License Agreement" ;
    schema1:name "kobas" ;
    schema1:softwareVersion "3.0.3" ;
    schema1:url "http://kobas.cbi.pku.edu.cn" .

