@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kobas a schema:SoftwareApplication ;
    schema:description "KEGG Orthology Based Annotation System" ;
    schema:downloadUrl "http://kobas.cbi.pku.edu.cn/kobas-2.1.1/kobas-3.0.3.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:kobas ;
    schema:license "Biopython License Agreement" ;
    schema:name "kobas" ;
    schema:softwareVersion "3.0.3" ;
    schema:url "http://kobas.cbi.pku.edu.cn" .

