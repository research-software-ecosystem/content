@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-martini a schema:SoftwareApplication ;
    schema:description "GWAS Incorporating Networks" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/martini_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/martini/martini_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/martini_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-martini/bioconductor-martini_1.30.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-snpstats",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-igraph",
        "r-matrix",
        "r-memoise",
        "r-rcpp",
        "r-rcppeigen",
        "zlib" ;
    schema:identifier biotools:martini ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-martini" ;
    schema:softwareVersion "1.30.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/martini.html" .

