@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-martini a schema1:SoftwareApplication ;
    schema1:description "GWAS Incorporating Networks" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/martini_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/martini/martini_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/martini_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-martini/bioconductor-martini_1.30.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-snpstats",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-igraph",
        "r-matrix",
        "r-memoise",
        "r-rcpp",
        "r-rcppeigen",
        "zlib" ;
    schema1:identifier biotools:martini ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-martini" ;
    schema1:softwareVersion "1.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/martini.html" .

