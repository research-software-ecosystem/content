@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metaphlan a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.2066" ;
    schema:description "Metagenomic Phylogenetic Analysis." ;
    schema:downloadUrl "https://github.com/biobakery/MetaPhlAn/archive/4.2.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:metaphlan ;
    schema:license "MIT" ;
    schema:name "metaphlan" ;
    schema:softwareHelp "https://github.com/biobakery/MetaPhlAn/wiki/MetaPhlAn-4" ;
    schema:softwareVersion "4.2.4" ;
    schema:url "https://github.com/biobakery/metaphlan" .

