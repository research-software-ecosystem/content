@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bcov a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt555" ;
    schema:description "BCov is a software package designed for predicting protein beta-sheet topology from amino acid sequence." ;
    schema:downloadUrl "https://biocomp.unibo.it/savojard/bcov/bcov-1.0.tar.gz" ;
    schema:hasPart "glpk" ;
    schema:identifier biotools:bcov ;
    schema:license "file" ;
    schema:name "bcov" ;
    schema:softwareHelp "https://biocomp.unibo.it/savojard/bcov/index.html" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://biocomp.unibo.it/savojard/bcov/index.html" .

