@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:perl-bioperl a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-59745-535-0_26" ;
    schema:description "Bioinformatics Toolkit" ;
    schema:identifier biotools:bioperl ;
    schema:license "perl_5" ;
    schema:name "perl-bioperl" ;
    schema:softwareVersion "1.7.8" ;
    schema:url "http://metacpan.org/pod/BioPerl" .

