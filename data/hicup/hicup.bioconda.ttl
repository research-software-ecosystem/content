@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hicup a schema:SoftwareApplication ;
    schema:citation "doi:10.12688/f1000research.7334.1" ;
    schema:description "A tool for mapping and performing quality control on Hi-C data" ;
    schema:downloadUrl "https://github.com/StevenWingett/HiCUP/archive/refs/tags/v0.9.2.tar.gz" ;
    schema:identifier biotools:hicup ;
    schema:license "GPLv3" ;
    schema:name "hicup" ;
    schema:softwareVersion "0.9.2" ;
    schema:url "http://www.bioinformatics.babraham.ac.uk/projects/hicup/" .

