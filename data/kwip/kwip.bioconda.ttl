@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kwip a schema:SoftwareApplication ;
    schema:citation "doi:https://doi.org/10.1371/journal.pcbi.1005727" ;
    schema:description "kWIP implements a de novo, alignment free measure of sample genetic dissimilarity" ;
    schema:downloadUrl "https://github.com/kdmurray91/kWIP/archive/0.2.0.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:kWIP ;
    schema:license "GNU General Public License version 3" ;
    schema:name "kwip" ;
    schema:softwareVersion "0.2.0" ;
    schema:url "https://github.com/kdmurray91/kWIP" .

