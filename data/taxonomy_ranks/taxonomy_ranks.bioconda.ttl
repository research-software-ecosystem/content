@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:taxonomy_ranks a schema:SoftwareApplication ;
    schema:author "linzhi2013" ;
    schema:description "To get taxonomy ranks information for taxid, species name, or higher ranks (e.g., genus, family) with ETE3 from NCBI Taxonomy database." ;
    schema:downloadUrl "https://pypi.io/packages/source/t/taxonomy_ranks/taxonomy_ranks-0.0.10.tar.gz" ;
    schema:hasPart "ete3",
        "pip",
        "python",
        "six" ;
    schema:identifier biotools:taxonomy_ranks ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "linzhi2013" ;
    schema:name "taxonomy_ranks" ;
    schema:softwareVersion "0.0.10" ;
    schema:url "https://github.com/linzhi2013/taxonomy_ranks" .

