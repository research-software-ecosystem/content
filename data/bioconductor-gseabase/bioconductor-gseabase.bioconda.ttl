@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gseabase a schema1:SoftwareApplication ;
    schema1:alternateName "Gene set enrichment data structures and methods" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides classes and methods to support Gene Set Enrichment Analysis (GSEA)." ;
    schema1:identifier <https://bio.tools/biotools:gseabase> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gseabase" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSEABase.html" .

