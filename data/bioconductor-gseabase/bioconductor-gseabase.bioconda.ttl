        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSEABase/GSEABase_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSEABase_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gseabase/bioconductor-gseabase_1.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:gseabase" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gseabase" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSEABase.html" .

