@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gseabase a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene set enrichment data structures and methods" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GSEABase_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSEABase/GSEABase_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSEABase_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gseabase/bioconductor-gseabase_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-graph",
        "r-base",
        "r-xml" ;
    schema:identifier biotools:gseabase ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gseabase" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GSEABase.html" .

