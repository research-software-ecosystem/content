@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:skewer a schema:SoftwareApplication ;
    schema:description "A fast and accurate adapter trimmer for paired-end reads." ;
    schema:downloadUrl "https://github.com/relipmoc/skewer/archive/0.2.2.zip" ;
    schema:identifier biotools:skewer ;
    schema:license "MIT" ;
    schema:name "skewer" ;
    schema:softwareVersion "0.2.2" ;
    schema:url "https://github.com/relipmoc/skewer.git" .

