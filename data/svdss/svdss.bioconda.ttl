@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:svdss a schema:SoftwareApplication ;
    schema:author "ldenti" ;
    schema:citation "doi:10.1038/s41592-022-01674-1" ;
    schema:description "Structural Variant Discovery from Sample-specific Strings." ;
    schema:downloadUrl "https://github.com/Parsoa/SVDSS/archive/refs/tags/v2.1.1.tar.gz" ;
    schema:hasPart "bzip2",
        "gsl",
        "htslib",
        "libgomp",
        "llvm-openmp",
        "xz",
        "zlib" ;
    schema:identifier biotools:svdss ;
    schema:license "MIT" ;
    schema:maintainer "ldenti" ;
    schema:name "svdss" ;
    schema:softwareHelp "https://github.com/Parsoa/SVDSS/blob/v2.1.1/README.md" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "https://github.com/Parsoa/SVDSS" .

