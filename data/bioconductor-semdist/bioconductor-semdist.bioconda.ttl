@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-semdist a schema1:SoftwareApplication ;
    schema1:alternateName "Information Accretion-based Function Predictor Evaluation" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package implements methods to calculate information accretion for a given version of the gene ontology and uses this data to calculate remaining uncertainty, misinformation, and semantic similarity for given sets of predicted annotations and true annotations from a protein function predictor." ;
    schema1:identifier biotools:semdist ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-semdist" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SemDist.html" .

