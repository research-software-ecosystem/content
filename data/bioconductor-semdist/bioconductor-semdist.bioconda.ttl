@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-semdist a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Information Accretion-based Function Predictor Evaluation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SemDist_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SemDist/SemDist_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SemDist_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-semdist/bioconductor-semdist_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-go.db",
        "r-base" ;
    schema:identifier biotools:semdist ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-semdist" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SemDist.html" .

