@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hifiadapterfilt a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-022-08375-1" ;
    schema:description "Convert .bam to .fastq and remove reads with remnant PacBio HiFi adapter sequences" ;
    schema:downloadUrl "https://github.com/sheinasim/HiFiAdapterFilt/archive/refs/tags/v3.0.0.tar.gz" ;
    schema:identifier biotools:hifiadapterfilt ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "hifiadapterfilt" ;
    schema:softwareVersion "3.0.0" ;
    schema:url "https://bio.tools/hifiadapterfilt" .

