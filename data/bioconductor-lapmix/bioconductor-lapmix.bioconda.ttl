@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lapmix a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/biostatistics/kxj032" ;
    schema:description "Laplace Mixture Model in Microarray Experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/lapmix_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/lapmix/lapmix_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/lapmix_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lapmix/bioconductor-lapmix_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:lapmix ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-lapmix" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/lapmix.html" .

