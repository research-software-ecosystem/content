@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lapmix a schema1:SoftwareApplication ;
    schema1:alternateName "Laplace Mixture Model in Microarray Experiments" ;
    schema1:citation "doi:10.1093/biostatistics/kxj032" ;
    schema1:description "Laplace mixture modelling of microarray experiments. A hierarchical Bayesian approach is used, and the hyperparameters are estimated using empirical Bayes. The main purpose is to identify differentially expressed genes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/lapmix_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/lapmix/lapmix_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/lapmix_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lapmix/bioconductor-lapmix_1.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:lapmix" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-lapmix" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/lapmix.html" .

