@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mait a schema1:SoftwareApplication ;
    schema1:alternateName "Statistical Analysis of Metabolomic Data" ;
    schema1:description "The MAIT package contains functions to perform end-to-end statistical analysis of LC/MS Metabolomic Data. Special emphasis is put on peak annotation and in modular function design of the functions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MAIT_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MAIT/MAIT_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MAIT_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mait/bioconductor-mait_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mait" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-mait" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MAIT.html" .

