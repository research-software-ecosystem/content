@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mait a schema:SoftwareApplication ;
    schema:description "Statistical Analysis of Metabolomic Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MAIT_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MAIT/MAIT_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MAIT_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mait/bioconductor-mait_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-camera",
        "bioconductor-xcms",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-agricolae",
        "r-base",
        "r-caret",
        "r-class",
        "r-e1071",
        "r-gplots",
        "r-mass",
        "r-pls",
        "r-plsgenomics",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:mait ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-mait" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MAIT.html" .

