@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:repeatmasker a schema1:SoftwareApplication ;
    schema1:alternateName "RepeatMasker is a program that screens DNA sequences for interspersed repeats and low complexity DNA sequences." ;
    schema1:description "RepeatMasker is a program that screens DNA sequences for interspersed repeats and low complexity DNA sequences." ;
    schema1:identifier biotools:repeatmasker,
        "usegalaxy-eu:repeatmasker_wrapper" ;
    schema1:license "Open Software License v2.1" ;
    schema1:maintainer "TobyBaril",
        "mencian" ;
    schema1:name "repeatmasker" ;
    schema1:softwareVersion "4.2.4" ;
    schema1:url "https://www.repeatmasker.org/RepeatMasker" .

