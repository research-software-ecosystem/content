@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:repeatmasker a schema:SoftwareApplication ;
    schema:author "TobyBaril",
        "mencian" ;
    schema:description "RepeatMasker is a program that screens DNA sequences for interspersed repeats and low complexity DNA sequences." ;
    schema:downloadUrl "https://www.repeatmasker.org/RepeatMasker/RepeatMasker-4.2.4.tar.gz" ;
    schema:hasPart "famdb",
        "h5py",
        "perl",
        "rmblast",
        "trf" ;
    schema:identifier biotools:repeatmasker ;
    schema:license "Open Software License v2.1" ;
    schema:maintainer "TobyBaril",
        "mencian" ;
    schema:name "repeatmasker" ;
    schema:softwareHelp "https://www.repeatmasker.org/RepeatMasker" ;
    schema:softwareVersion "4.2.4" ;
    schema:url "https://www.repeatmasker.org/RepeatMasker" .

