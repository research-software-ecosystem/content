@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mosaik a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0090581" ;
    schema:description "MOSAIK is a stable, sensitive and open-source program for mapping second and third-generation sequencing reads to a reference genome." ;
    schema:downloadUrl "https://github.com/wanpinglee/MOSAIK/archive/e04c806bb1410cf1dbd1534991c46d696aec6723.zip" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:mosaik ;
    schema:license "GPL 2.0+" ;
    schema:name "mosaik" ;
    schema:softwareVersion "2.2.26" ;
    schema:url "https://github.com/wanpinglee/MOSAIK" .

