@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mosaik a schema1:SoftwareApplication ;
    schema1:alternateName "MOSAIK is a stable, sensitive and open-source program for mapping second and third-generation sequencing reads to a reference genome." ;
    schema1:citation "doi:10.1371/journal.pone.0090581" ;
    schema1:description "MOSAIK is a stable, sensitive and open-source program for mapping second and third-generation sequencing reads to a reference genome." ;
    schema1:identifier <https://bio.tools/biotools:mosaik> ;
    schema1:license "GPL 2.0+" ;
    schema1:name "mosaik" ;
    schema1:softwareVersion "2.2.26" ;
    schema1:url "https://github.com/wanpinglee/MOSAIK" .

