@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annotationtools a schema1:SoftwareApplication ;
    schema1:alternateName "Annotate microarrays and perform cross-species gene expression analyses using flat file databases" ;
    schema1:description "Functions to annotate microarrays, find orthologs, and integrate heterogeneous gene expression profiles using annotation and other molecular biology information available as flat file database (plain text files)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/annotationTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annotationTools/annotationTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annotationTools_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationtools/bioconductor-annotationtools_1.84.0_src_all.tar.gz" ;
    schema1:identifier "biotools:annotationtools" ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-annotationtools" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/annotationTools.html" .

