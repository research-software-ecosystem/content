@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annotationtools a schema:SoftwareApplication ;
    schema:description "Annotate microarrays and perform cross-species gene expression analyses using flat file databases" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/annotationTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annotationTools/annotationTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annotationTools_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationtools/bioconductor-annotationtools_1.84.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:annotationtools ;
    schema:license "GPL" ;
    schema:name "bioconductor-annotationtools" ;
    schema:softwareVersion "1.84.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/annotationTools.html" .

