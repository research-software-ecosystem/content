@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowfp a schema1:SoftwareApplication ;
    schema1:alternateName "Fingerprinting for Flow Cytometry" ;
    schema1:citation "doi:10.1155/2009/193947" ;
    schema1:description "Fingerprint generation of flow cytometry data, used to facilitate the application of machine learning and datamining tools for flow cytometry." ;
    schema1:identifier biotools:flowfp ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-flowfp" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowFP.html" .

