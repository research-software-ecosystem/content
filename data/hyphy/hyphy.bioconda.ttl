@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hyphy a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-4939-8736-8_6",
        "doi:10.1093/bioinformatics/bti079",
        "doi:10.1093/molbev/msz197" ;
    schema:description "An open-source software package for comparative sequence analysis using stochastic evolutionary models." ;
    schema:downloadUrl "https://github.com/veg/hyphy/archive/2.5.100.tar.gz" ;
    schema:hasPart "libblas",
        "libcurl",
        "libgomp",
        "llvm-openmp",
        "openmpi",
        "zlib" ;
    schema:identifier biotools:HyPhy ;
    schema:license "MIT" ;
    schema:name "hyphy" ;
    schema:softwareHelp "https://hyphy.org" ;
    schema:softwareVersion "2.5.100" ;
    schema:url "https://hyphy.org" .

