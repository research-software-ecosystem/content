@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:barrnap a schema1:SoftwareApplication ;
    schema1:alternateName "Rapid microbial RNA annotation" ;
    schema1:description "Rapid microbial RNA annotation" ;
    schema1:identifier biotools:barrnap,
        "usegalaxy-eu:barrnap" ;
    schema1:license "GPLv3" ;
    schema1:name "barrnap" ;
    schema1:softwareVersion "1.10.6" ;
    schema1:url "https://github.com/tseemann/barrnap" .

