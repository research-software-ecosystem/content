@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:barrnap a schema1:SoftwareApplication ;
    schema1:description "Rapid microbial RNA annotation" ;
    schema1:downloadUrl "https://github.com/tseemann/barrnap/archive/v1.10.6.tar.gz" ;
    schema1:hasPart "any2fasta",
        "aragorn",
        "bedtools",
        "diamond",
        "infernal",
        "mmseqs2",
        "perl",
        "perl-file-which",
        "perl-list-moreutils",
        "perl-path-tiny",
        "pyrodigal",
        "seqkit",
        "taxonkit",
        "transtermhp",
        "ziggypep" ;
    schema1:identifier biotools:barrnap ;
    schema1:license "GPLv3" ;
    schema1:name "barrnap" ;
    schema1:softwareVersion "1.10.6" ;
    schema1:url "https://github.com/tseemann/barrnap" .

