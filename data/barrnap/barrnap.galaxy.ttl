        edam:topic_0622 ;
    schema1:codeRepository <https://github.com/tseemann/barrnap> ;
    schema1:dateCreated "2017-08-25" ;
    schema1:description "Contains the Barrnap tool for finding ribosomal RNAs in FASTA sequences." ;
    schema1:encodingFormat "fasta",
        "gff3" ;
    schema1:featureList edam:operation_2454 ;
    schema1:identifier biotools:barrnap,
        bioconda:barrnap ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=2a1dc58e51d5f01a>,
