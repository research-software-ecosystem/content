        <https://usegalaxy.fr>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "barrnap" ;
    schema1:softwareVersion "1.2.2" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/barrnap> .

