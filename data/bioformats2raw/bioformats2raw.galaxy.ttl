@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:bioformats2raw a schema1:SoftwareApplication ;
    bioschemas:output "zarr" ;
    schema1:applicationSubCategory edam:topic_3070 ;
    schema1:codeRepository "https://github.com/Euro-BioImaging" ;
    schema1:dateCreated "2023-11-02" ;
    schema1:description "Convert image to OME-Zarr" ;
    schema1:encodingFormat "zarr" ;
    schema1:identifier biotools:bio-formats ;
    schema1:keywords "Convert Formats",
        "Imaging" ;
    schema1:name "bioformats2raw" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/BMCV/galaxy-image-analysis/tree/master/tools/bioformats2raw" .

