@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:conus a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-5-71" ;
    schema:description "CONUS is an implementation of simple stochastic context-free grammars for RNA secondary structure analysis.CONUS developed for exploring the consequences of different single sequence SCFG designs in predicting RNA secondary structure." ;
    schema:downloadUrl "http://eddylab.org/software/conus/conus-1.0.tar.gz" ;
    schema:identifier biotools:CONUS ;
    schema:license "file" ;
    schema:name "conus" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://eddylab.org/software/conus/" .

