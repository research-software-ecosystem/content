@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:adapterremoval a schema:SoftwareApplication ;
    schema:description "The AdapterRemoval v2 tool for merging and clipping reads." ;
    schema:downloadUrl "https://github.com/MikkelSchubert/adapterremoval/archive/v2.3.4.tar.gz" ;
    schema:hasPart "bzip2",
        "perl",
        "wget",
        "zlib" ;
    schema:identifier biotools:adapterremoval ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "adapterremoval" ;
    schema:softwareVersion "2.3.4" ;
    schema:url "https://github.com/MikkelSchubert/adapterremoval" .

