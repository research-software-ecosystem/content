@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:adapterremoval a schema1:SoftwareApplication ;
    schema1:alternateName "The AdapterRemoval v2 tool for merging and clipping reads." ;
    schema1:citation "doi:10.1186/s13104-016-1900-2" ;
    schema1:description "The AdapterRemoval v2 tool for merging and clipping reads." ;
    schema1:identifier <https://bio.tools/biotools:adapterremoval>,
        "usegalaxy-eu:adapter_removal" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "adapterremoval" ;
    schema1:softwareVersion "3.0.1" ;
    schema1:url "https://github.com/MikkelSchubert/adapterremoval" .

