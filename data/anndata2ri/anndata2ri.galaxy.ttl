@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:anndata2ri a schema1:SoftwareApplication ;
    bioschemas:output "h5ad",
        "rdata.sce" ;
    schema1:codeRepository "https://github.com/theislab/anndata2ri" ;
    schema1:dateCreated "2025-02-12" ;
    schema1:description "Convert between Anndata and SingCellExperiment objects" ;
    schema1:encodingFormat "h5ad",
        "rdata.sce" ;
    schema1:featureList edam:operation_2409,
        edam:operation_2427 ;
    schema1:identifier biotools:anndata2ri,
        bioconda:anndata2ri ;
    schema1:keywords "Convert Formats",
        "Single Cell" ;
    schema1:name "anndata2ri" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/anndata2ri" .

