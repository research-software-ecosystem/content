@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbowtie2 a schema1:SoftwareApplication ;
    schema1:alternateName "An R Wrapper for Bowtie2 and AdapterRemoval" ;
    schema1:description "This package provides an R wrapper of the popular bowtie2 sequencing reads aligner and AdapterRemoval, a convenient tool for rapid adapter trimming, identification, and read merging. The package contains wrapper functions that allow for genome indexing and alignment to those indexes. The package also allows for the creation of .bam files via Rsamtools." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Rbowtie2_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rbowtie2/Rbowtie2_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rbowtie2_2.16.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbowtie2/bioconductor-rbowtie2_2.16.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rbowtie2" ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-rbowtie2" ;
    schema1:softwareVersion "2.16.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Rbowtie2.html" .

