@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbowtie2 a schema:SoftwareApplication ;
    schema:description "An R Wrapper for Bowtie2 and AdapterRemoval" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Rbowtie2_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rbowtie2/Rbowtie2_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rbowtie2_2.16.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbowtie2/bioconductor-rbowtie2_2.16.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rsamtools",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-magrittr",
        "zlib" ;
    schema:identifier biotools:rbowtie2 ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-rbowtie2" ;
    schema:softwareVersion "2.16.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Rbowtie2.html" .

