@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pblat a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-019-2597-8" ;
    schema:description "blat with multi-threads support" ;
    schema:downloadUrl "https://github.com/icebert/pblat/archive/2.5.1.tar.gz" ;
    schema:hasPart "openssl",
        "zlib" ;
    schema:identifier biotools:pblat ;
    schema:license "OTHER" ;
    schema:name "pblat" ;
    schema:softwareVersion "2.5.1" ;
    schema:url "https://icebert.github.io/pblat" .

