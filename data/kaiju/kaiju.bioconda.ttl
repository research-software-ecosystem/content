@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:kaiju a schema1:SoftwareApplication ;
    schema1:alternateName "Fast and sensitive taxonomic classification for metagenomics." ;
    schema1:citation "doi:10.1038/ncomms11257" ;
    schema1:description "Fast and sensitive taxonomic classification for metagenomics." ;
    schema1:identifier <https://bio.tools/biotools:kaiju>,
        "usegalaxy-eu:kaiju_addtaxonnames",
        "usegalaxy-eu:kaiju_kaiju",
        "usegalaxy-eu:kaiju_kaiju2krona",
        "usegalaxy-eu:kaiju_kaiju2table",
        "usegalaxy-eu:kaiju_mergeoutputs" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "kaiju" ;
    schema1:softwareVersion "1.10.2" ;
    schema1:url "https://github.com/bioinformatics-centre/kaiju" .

