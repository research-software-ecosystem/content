@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kaiju a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ncomms11257" ;
    schema:description "Fast and sensitive taxonomic classification for metagenomics." ;
    schema:downloadUrl "https://github.com/bioinformatics-centre/kaiju/archive/v1.10.1.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:kaiju ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "kaiju" ;
    schema:softwareHelp "https://github.com/bioinformatics-centre/kaiju/blob/v1.10.1/README.md" ;
    schema:softwareVersion "1.10.1" ;
    schema:url "https://github.com/bioinformatics-centre/kaiju" .

