@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ribodetector a schema:SoftwareApplication ;
    schema:author "alienzj" ;
    schema:description "Accurate and rapid RiboRNA sequences Detector based on deep learning" ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/ed/92/ddeb9ca3e7cc936669f19d6ad181cca2ce8ca7afab00cbbee9f88ad50a84/ribodetector-0.3.3.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:ribodetector ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "alienzj" ;
    schema:name "ribodetector" ;
    schema:softwareVersion "0.3.3" ;
    schema:url "https://github.com/hzi-bifo/RiboDetector" .

