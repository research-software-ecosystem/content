@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ribodetector a schema1:SoftwareApplication ;
    schema1:alternateName "Accurate and rapid RiboRNA sequences Detector based on deep learning" ;
    schema1:description "Accurate and rapid RiboRNA sequences Detector based on deep learning" ;
    schema1:identifier <https://bio.tools/biotools:ribodetector> ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "alienzj" ;
    schema1:name "ribodetector" ;
    schema1:softwareVersion "0.3.3" ;
    schema1:url "https://github.com/hzi-bifo/RiboDetector" .

