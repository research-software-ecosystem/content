@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bold-identification a schema:SoftwareApplication ;
    schema:author "linzhi2013" ;
    schema:description "A tool for taxonomic assignment for given sequences using the BOLD database (http://www.boldsystems.org/index.php)" ;
    schema:downloadUrl "https://github.com/linzhi2013/bold_identification/archive/v0.0.27.tar.gz" ;
    schema:hasPart "beautifulsoup4",
        "biopython",
        "html5lib",
        "pip",
        "python",
        "requests" ;
    schema:identifier biotools:bold-identification ;
    schema:license "GNU General Public v3 or later (GPLv3+)" ;
    schema:maintainer "linzhi2013" ;
    schema:name "bold-identification" ;
    schema:softwareVersion "0.0.27" ;
    schema:url "https://github.com/linzhi2013/bold_identification" .

