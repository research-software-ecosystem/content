@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:spacepharer a schema:SoftwareApplication ;
    schema:author "milot-mirdita" ;
    schema:citation "doi:10.1093/bioinformatics/btab222" ;
    schema:description "SpacePHARER: Sensitive identification of phages from CRISPR spacers in prokaryotic hosts" ;
    schema:downloadUrl "https://github.com/soedinglab/spacepharer/archive/5-c2e680a.tar.gz" ;
    schema:hasPart "bzip2",
        "gawk",
        "zlib" ;
    schema:identifier biotools:spacepharer ;
    schema:license "GPL-3" ;
    schema:maintainer "milot-mirdita" ;
    schema:name "spacepharer" ;
    schema:softwareVersion "5.c2e680a" ;
    schema:url "https://github.com/soedinglab/spacepharer" .

