@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-marray a schema1:SoftwareApplication ;
    schema1:alternateName "Exploratory analysis for two-color spotted microarray data" ;
    schema1:citation "doi:10.1007/0-387-21679-0_3" ;
    schema1:description "Class definitions for two-color spotted microarray data. Fuctions for data input, diagnostic plots, normalization and quality checking." ;
    schema1:identifier <https://bio.tools/biotools:marray> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-marray" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/marray.html" .

