@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genextender a schema:SoftwareApplication ;
    schema:description "Optimized Functional Annotation Of ChIP-seq Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/geneXtendeR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneXtendeR/geneXtendeR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneXtendeR_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genextender/bioconductor-genextender_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocstyle",
        "bioconductor-go.db",
        "bioconductor-org.rn.eg.db",
        "bioconductor-rtracklayer",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-dplyr",
        "r-networkd3",
        "r-rcolorbrewer",
        "r-snowballc",
        "r-tm",
        "r-wordcloud",
        "zlib" ;
    schema:identifier biotools:genextender ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-genextender" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/geneXtendeR.html" .

