@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mdqc a schema1:SoftwareApplication ;
    schema1:alternateName "Mahalanobis Distance Quality Control for microarrays" ;
    schema1:citation "doi:10.1093/bioinformatics/btm487" ;
    schema1:description "MDQC is a multivariate quality assessment method for microarrays based on quality control (QC) reports. The Mahalanobis distance of an array's quality attributes is used to measure the similarity of the quality of that array against the quality of the other arrays. Then, arrays with unusually high distances can be flagged as potentially low-quality." ;
    schema1:identifier biotools:mdqc ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-mdqc" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mdqc.html" .

