@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mdqc a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btm487" ;
    schema1:description "Mahalanobis Distance Quality Control for microarrays" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/mdqc_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mdqc/mdqc_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mdqc_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mdqc/bioconductor-mdqc_1.72.0_src_all.tar.gz" ;
    schema1:hasPart "r-base",
        "r-cluster",
        "r-mass" ;
    schema1:identifier biotools:mdqc ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-mdqc" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mdqc.html" .

