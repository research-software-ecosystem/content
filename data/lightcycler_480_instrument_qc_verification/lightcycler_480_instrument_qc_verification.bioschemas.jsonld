      "sc:citation": {
        "@id": "https://doi.org/10.5281/zenodo.24082377"
      },
      "sc:description": "A single-file offline browser application for reviewing Roche LightCycler 480 QC Kit qualification runs from IXO files. It reads stored crossing-point results, derives melting metrics from stored curves, checks file integrity, and displays plate maps, amplification and melting curves, and control charts grouped by instrument serial number. It exports QC data and reports. Version v4 includes a guided walkthrough, a command demonstration, and eight learning cases using four de-identified IXO runs, with a completion PDF. Users can click, type commands, or use optional voice commands in compatible browsers. For research and training use. Official qualification certificates require the vendor workflow.",
      "sc:isAccessibleForFree": true,
      "sc:name": "LightCycler 480 Instrument QC Verification",
      "sc:operatingSystem": "Windows",
      "sc:softwareHelp": {
        "@id": "https://zenodo.org/records/24082377"
      },
      "sc:softwareVersion": "v4",
      "sc:url": "https://mihaiionitabio-alt.github.io/lc480-ixo-qc-kit/"
    },
