@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bx-python a schema:SoftwareApplication ;
    schema:author "nsoranzo" ;
    schema:description "Tools for manipulating biological data, particularly multiple sequence alignments." ;
    schema:downloadUrl "https://pypi.org/packages/source/b/bx-python/bx_python-0.14.0.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:bx-python ;
    schema:license "MIT" ;
    schema:maintainer "nsoranzo" ;
    schema:name "bx-python" ;
    schema:softwareHelp "https://bx-python.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.14.0" ;
    schema:url "https://github.com/bxlab/bx-python" .

