@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gentle a schema:SoftwareApplication ;
    schema:author "smoe" ;
    schema:description "Software suite for DNA cloning." ;
    schema:downloadUrl "https://github.com/GENtle-persons/gentle-m/archive/refs/tags/1.9.5.alpha1.tar.gz" ;
    schema:hasPart "clustalw",
        "mysql",
        "sqlite",
        "tinyxml",
        "wxwidgets" ;
    schema:identifier biotools:gentle ;
    schema:license "GPL-2.0-or-later" ;
    schema:maintainer "smoe" ;
    schema:name "gentle" ;
    schema:softwareVersion "1.9.5.alpha1" ;
    schema:url "https://github.com/GENtle-persons/gentle-m" .

