@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bumphunter a schema:SoftwareApplication ;
    schema:description "Bump Hunter" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/bumphunter_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bumphunter/bumphunter_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bumphunter_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bumphunter/bioconductor-bumphunter_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-dorng",
        "r-foreach",
        "r-iterators",
        "r-locfit",
        "r-matrixstats" ;
    schema:identifier biotools:bumphunter ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-bumphunter" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/bumphunter.html" .

