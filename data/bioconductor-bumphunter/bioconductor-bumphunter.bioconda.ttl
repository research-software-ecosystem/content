@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bumphunter a schema1:SoftwareApplication ;
    schema1:alternateName "Bump Hunter" ;
    schema1:description "Tools for finding bumps in genomic data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/bumphunter_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bumphunter/bumphunter_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bumphunter_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bumphunter/bioconductor-bumphunter_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:bumphunter" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-bumphunter" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bumphunter.html" .

