@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:khmer a schema:SoftwareApplication ;
    schema:citation "doi:10.12688/f1000research.6924.1" ;
    schema:description "khmer k-mer counting library." ;
    schema:downloadUrl "https://github.com/dib-lab/khmer/archive/v3.0.0a3.tar.gz" ;
    schema:hasPart "bzip2",
        "cython",
        "libgomp",
        "llvm-openmp",
        "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:khmer ;
    schema:license "BSD-3-License" ;
    schema:name "khmer" ;
    schema:softwareHelp "https://khmer.readthedocs.io" ;
    schema:softwareVersion "3.0.0a3" ;
    schema:url "https://github.com/dib-lab/khmer" .

