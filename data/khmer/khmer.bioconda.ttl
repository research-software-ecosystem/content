@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:khmer a schema1:SoftwareApplication ;
    schema1:alternateName "khmer k-mer counting library." ;
    schema1:citation "doi:10.12688/f1000research.6924.1" ;
    schema1:description "khmer k-mer counting library." ;
    schema1:downloadUrl "https://github.com/dib-lab/khmer/archive/v3.0.0a3.tar.gz" ;
    schema1:identifier "biotools:khmer",
        "usegalaxy-eu:khmer_abundance_distribution",
        "usegalaxy-eu:khmer_abundance_distribution_single",
        "usegalaxy-eu:khmer_count_median",
        "usegalaxy-eu:khmer_extract_partitions",
        "usegalaxy-eu:khmer_filter_abundance",
        "usegalaxy-eu:khmer_filter_below_abundance_cutoff",
        "usegalaxy-eu:khmer_normalize_by_median",
        "usegalaxy-eu:khmer_partition" ;
    schema1:license "BSD-3-License" ;
    schema1:name "khmer" ;
    schema1:softwareVersion "3.0.0a3" ;
    schema1:url "https://github.com/dib-lab/khmer" .

