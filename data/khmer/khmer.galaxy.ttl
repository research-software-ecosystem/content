    schema1:dateCreated "2015-03-24" ;
    schema1:description "In-memory nucleotide sequence k-mer counting, filtering, graph traversal and more" ;
    schema1:encodingFormat "csv",
        "oxlicg",
        "txt" ;
    schema1:featureList edam:operation_0524,
        edam:operation_3435 ;
    schema1:identifier biotools:khmer,
        bioconda:khmer ;
    schema1:isPartOf <https://galaxy.pasteur.fr>,
        <https://mississippi.sorbonne-universite.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Assembly",
