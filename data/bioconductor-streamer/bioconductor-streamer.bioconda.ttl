@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-streamer a schema1:SoftwareApplication ;
    schema1:alternateName "Enabling stream processing of large files" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Large data files can be difficult to work with in R, where data generally resides in memory. This package encourages a style of programming where data is 'streamed' from disk into R via a `producer' and through a series of `consumers' that, typically reduce the original data to a manageable size. The package provides useful Producer and Consumer stream components for operations such as data input, sampling, indexing, and transformation; see package?Streamer for details." ;
    schema1:identifier biotools:streamer ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-streamer" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Streamer.html" .

