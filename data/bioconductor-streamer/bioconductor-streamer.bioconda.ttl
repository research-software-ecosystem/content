@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-streamer a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Enabling stream processing of large files" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Streamer_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Streamer/Streamer_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Streamer_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-streamer/bioconductor-streamer_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-graph",
        "bioconductor-rbgl",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:streamer ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-streamer" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Streamer.html" .

