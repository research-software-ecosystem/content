@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnacode a schema:SoftwareApplication ;
    schema:citation "doi:10.1261/rna.2536111" ;
    schema:description "RNAcode - Analyze the protein coding potential in multiple sequence alignments RNAcode relies on evolutionary signatures including synonymous/conservative mutations and conservation of the reading frame. It does not use any species specific sequence characteristics whatsoever and does not use any machine learning techniques." ;
    schema:downloadUrl "https://github.com/ViennaRNA/RNAcode/releases/download/v0.3.1/RNAcode-0.3.1.tar.gz" ;
    schema:identifier biotools:rnacode ;
    schema:license "Unknown" ;
    schema:name "rnacode" ;
    schema:softwareHelp "https://viennarna.github.io/RNAcode" ;
    schema:softwareVersion "0.3.1" ;
    schema:url "https://github.com/ViennaRNA/RNAcode" .

