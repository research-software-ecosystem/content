@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-snprelate a schema1:SoftwareApplication ;
    schema1:description "Parallel Computing Toolset for Relatedness and Principal Component Analysis of SNP Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SNPRelate_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SNPRelate/SNPRelate_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SNPRelate_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-snprelate/bioconductor-snprelate_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-gdsfmt",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-rhpcblasctl",
        "zlib" ;
    schema1:identifier biotools:snprelate ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-snprelate" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SNPRelate.html" .

