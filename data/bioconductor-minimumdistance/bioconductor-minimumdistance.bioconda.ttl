@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-minimumdistance a schema1:SoftwareApplication ;
    schema1:alternateName "A Package for De Novo CNV Detection in Case-Parent Trios" ;
    schema1:citation "doi:10.1186/1471-2105-13-330" ;
    schema1:description "Analysis of de novo copy number variants in trios from high-dimensional genotyping platforms." ;
    schema1:identifier biotools:minimumdistance ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-minimumdistance" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MinimumDistance.html" .

