@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-minimumdistance a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1186/1471-2105-13-330" ;
    schema1:description "A Package for De Novo CNV Detection in Case-Parent Trios" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MinimumDistance_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MinimumDistance/MinimumDistance_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MinimumDistance_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-minimumdistance/bioconductor-minimumdistance_1.54.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-dnacopy",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-oligoclasses",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-vanillaice",
        "r-base",
        "r-data.table",
        "r-ff",
        "r-foreach",
        "r-lattice",
        "r-matrixstats" ;
    schema1:identifier biotools:minimumdistance ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-minimumdistance" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MinimumDistance.html" .

