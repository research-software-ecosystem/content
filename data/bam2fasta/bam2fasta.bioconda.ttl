@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bam2fasta a schema:SoftwareApplication ;
    schema:author "pranathi7" ;
    schema:description "bam2fasta: cli tool to convert bam to fastas" ;
    schema:downloadUrl "https://pypi.io/packages/source/b/bam2fasta/bam2fasta-1.0.8.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "setuptools_scm",
        "setuptools_scm_git_archive" ;
    schema:identifier biotools:bam2fasta ;
    schema:license "MIT" ;
    schema:maintainer "pranathi7" ;
    schema:name "bam2fasta" ;
    schema:softwareVersion "1.0.8" ;
    schema:url "https://github.com/czbiohub/bam2fasta" .

