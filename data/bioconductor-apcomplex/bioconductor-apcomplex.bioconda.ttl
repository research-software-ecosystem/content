@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-apcomplex a schema1:SoftwareApplication ;
    schema1:alternateName "Estimate protein complex membership using AP-MS protein data" ;
    schema1:citation "doi:10.1093/bioinformatics/bti567" ;
    schema1:description "Functions to estimate a bipartite graph of protein complex membership using AP-MS data." ;
    schema1:identifier biotools:apcomplex ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-apcomplex" ;
    schema1:softwareVersion "2.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/apComplex.html" .

