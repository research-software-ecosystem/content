@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-apcomplex a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bti567" ;
    schema:description "Estimate protein complex membership using AP-MS protein data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/apComplex_2.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/apComplex/apComplex_2.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/apComplex_2.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-apcomplex/bioconductor-apcomplex_2.76.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-org.sc.sgd.db",
        "bioconductor-rbgl",
        "bioconductor-rgraphviz",
        "r-base" ;
    schema:identifier biotools:apcomplex ;
    schema:license "LGPL" ;
    schema:name "bioconductor-apcomplex" ;
    schema:softwareVersion "2.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/apComplex.html" .

