@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:platon a schema1:SoftwareApplication ;
    schema1:alternateName "Plasmid contig classification and characterization for short read draft assemblies." ;
    schema1:citation "doi:10.1099/mgen.0.000398",
        "doi:10.5281/zenodo.4066768" ;
    schema1:description "Plasmid contig classification and characterization for short read draft assemblies." ;
    schema1:identifier biotools:platon ;
    schema1:license "GPLv3" ;
    schema1:maintainer "oschwengers" ;
    schema1:name "platon" ;
    schema1:softwareVersion "1.8" ;
    schema1:url "https://github.com/oschwengers/platon" .

