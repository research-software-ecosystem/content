@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:platon a schema:SoftwareApplication ;
    schema:author "oschwengers" ;
    schema:description "Plasmid contig classification and characterization for short read draft assemblies." ;
    schema:downloadUrl "https://github.com/oschwengers/platon/archive/v1.7.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:platon ;
    schema:license "GPLv3" ;
    schema:maintainer "oschwengers" ;
    schema:name "platon" ;
    schema:softwareVersion "1.7" ;
    schema:url "https://github.com/oschwengers/platon" .

