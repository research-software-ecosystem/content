@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metagem a schema:SoftwareApplication ;
    schema:author "franciscozorrilla" ;
    schema:citation "doi:10.1093/nar/gkab815" ;
    schema:description "Generate context specific genome-scale metabolic models and predict metabolic interactions directly from metagenomic data" ;
    schema:downloadUrl "https://github.com/franciscozorrilla/metaGEM/archive/refs/tags/v1.0.5.tar.gz" ;
    schema:identifier biotools:metagem ;
    schema:license "MIT" ;
    schema:maintainer "franciscozorrilla" ;
    schema:name "metagem" ;
    schema:softwareVersion "1.0.5" ;
    schema:url "https://github.com/franciscozorrilla/metaGEM" .

