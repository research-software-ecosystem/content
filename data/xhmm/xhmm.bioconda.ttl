@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:xhmm a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/0471142905.hg0723s81",
        "doi:10.1016/j.ajhg.2012.08.005" ;
    schema:description "XHMM (eXome-Hidden Markov Model)." ;
