    schema:hasPart "liblapack" ;
    schema:identifier biotools:xhmm ;
    schema:license "GPL3" ;
    schema:name "xhmm" ;
    schema:softwareVersion "0.0.0.2016_01_04.cc14e52" ;
    schema:url "http://atgu.mgh.harvard.edu/xhmm/index.shtml" .

