@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hapfabia a schema:SoftwareApplication ;
    schema:description "hapFabia: Identification of very short segments of identity by descent (IBD) characterized by rare variants in large sequencing data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/hapFabia_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/hapFabia/hapFabia_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/hapFabia_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hapfabia/bioconductor-hapfabia_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-fabia",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:hapfabia ;
    schema:license "LGPL (>= 2.1)" ;
    schema:name "bioconductor-hapfabia" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/hapFabia.html" .

