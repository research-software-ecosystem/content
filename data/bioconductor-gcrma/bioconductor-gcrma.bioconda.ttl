@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gcrma a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-9-452" ;
    schema:description "Background Adjustment Using Sequence Information" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/gcrma_2.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gcrma/gcrma_2.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gcrma_2.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gcrma/bioconductor-gcrma_2.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-biostrings",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-biocmanager",
        "zlib" ;
    schema:identifier biotools:gcrma ;
    schema:license "LGPL" ;
    schema:name "bioconductor-gcrma" ;
    schema:softwareVersion "2.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/gcrma.html" .

