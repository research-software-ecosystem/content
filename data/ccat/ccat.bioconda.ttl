@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ccat a schema1:SoftwareApplication ;
    schema1:alternateName "CCAT is a software package for the analysis of ChIP-seq data with negative control." ;
    schema1:citation "doi:10.1093/bioinformatics/btq128" ;
    schema1:description "CCAT is a software package for the analysis of ChIP-seq data with negative control." ;
    schema1:identifier <https://bio.tools/biotools:CCAT>,
        "usegalaxy-eu:peakcalling_ccat" ;
    schema1:license "unknown" ;
    schema1:name "ccat" ;
    schema1:softwareVersion "3.0" ;
    schema1:url "http://cmb.gis.a-star.edu.sg/ChIPSeq/paperCCAT.htm" .

