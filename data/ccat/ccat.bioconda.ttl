@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ccat a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btq128" ;
    schema:description "CCAT is a software package for the analysis of ChIP-seq data with negative control." ;
    schema:downloadUrl "http://www.comp.nus.edu.sg/~bioinfo/CCAT3.0/CCAT3.0.tar.gz" ;
    schema:identifier biotools:CCAT ;
    schema:license "unknown" ;
    schema:name "ccat" ;
    schema:softwareVersion "3.0" ;
    schema:url "http://cmb.gis.a-star.edu.sg/ChIPSeq/paperCCAT.htm" .

