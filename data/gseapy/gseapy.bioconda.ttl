@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gseapy a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btac757" ;
    schema:description "Gene Set Enrichment Analysis in Python." ;
    schema:downloadUrl "https://pypi.org/packages/source/g/gseapy/gseapy-1.3.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "setuptools-rust",
        "toml" ;
    schema:identifier biotools:gseapy ;
    schema:license "BSD-3-Clause" ;
    schema:name "gseapy" ;
    schema:softwareHelp "https://gseapy.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "https://github.com/zqfang/gseapy" .

