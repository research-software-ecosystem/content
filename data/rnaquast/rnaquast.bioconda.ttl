@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnaquast a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw218" ;
    schema:description "rnaQUAST is a tool for evaluating RNA-Seq assemblies using reference genome and gene database. In addition, rnaQUAST is also capable of estimating gene database coverage by raw reads and de novo quality assessment using third-party software." ;
    schema:downloadUrl "https://github.com/ablab/rnaquast/releases/download/v2.3.2/rnaQUAST-2.3.2.tar.gz" ;
    schema:identifier biotools:rnaQUAST ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "rnaquast" ;
    schema:softwareVersion "2.3.2" ;
    schema:url "https://github.com/ablab/rnaquast" .

