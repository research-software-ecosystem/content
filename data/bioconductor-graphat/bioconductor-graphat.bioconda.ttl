@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-graphat a schema1:SoftwareApplication ;
    schema1:alternateName "Graph Theoretic Association Tests" ;
    schema1:citation "doi:10.1093/bioinformatics/bth405" ;
    schema1:description "Functions and data used in Balasubramanian, et al. (2004)" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GraphAT_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GraphAT/GraphAT_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GraphAT_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-graphat/bioconductor-graphat_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:graphat" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-graphat" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GraphAT.html" .

