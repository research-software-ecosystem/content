@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-graphat a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bth405" ;
    schema:description "Graph Theoretic Association Tests" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GraphAT_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GraphAT/GraphAT_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GraphAT_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-graphat/bioconductor-graphat_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "r-base",
        "r-mcmcpack" ;
    schema:identifier biotools:graphat ;
    schema:license "LGPL" ;
    schema:name "bioconductor-graphat" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GraphAT.html" .

