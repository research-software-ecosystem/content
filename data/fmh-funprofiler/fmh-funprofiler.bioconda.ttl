@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fmh-funprofiler a schema:SoftwareApplication ;
    schema:author "dkoslicki",
        "miraep8" ;
    schema:citation "doi:10.1093/bioinformatics/btae397" ;
    schema:description "fmh-funprofiler is a pipeline that leverages FracMinHash (implemented in sourmash) to functionally profile metagenomic samples, offering a faster and more memory-efficient alternative to alignment-based methods." ;
    schema:downloadUrl "https://github.com/KoslickiLab/fmh-funprofiler/archive/refs/tags/v1.1.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:fmh-funprofiler ;
    schema:license "MIT" ;
    schema:maintainer "dkoslicki",
        "miraep8" ;
    schema:name "fmh-funprofiler" ;
    schema:softwareVersion "1.1.1" ;
    schema:url "https://github.com/KoslickiLab/fmh-funprofiler" .

