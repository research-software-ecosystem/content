@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:swarm a schema:SoftwareApplication ;
    schema:citation "doi:10.7717/peerj.593" ;
    schema:description "A robust and fast clustering method for amplicon-based studies." ;
    schema:downloadUrl "https://github.com/torognes/swarm/archive/v3.1.7.tar.gz" ;
    schema:identifier biotools:swarm ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "swarm" ;
    schema:softwareHelp "https://github.com/torognes/swarm/blob/v3.1.7/man/swarm_manual.pdf" ;
    schema:softwareVersion "3.1.7" ;
    schema:url "https://github.com/torognes/swarm" .

