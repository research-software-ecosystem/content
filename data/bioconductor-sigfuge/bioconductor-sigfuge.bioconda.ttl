@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sigfuge a schema1:SoftwareApplication ;
    schema1:alternateName "SigFuge" ;
    schema1:citation "doi:10.1093/nar/gku521" ;
    schema1:description "Algorithm for testing significance of clustering in RNA-seq data." ;
    schema1:identifier biotools:sigfuge ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-sigfuge" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/SigFuge.html" .

