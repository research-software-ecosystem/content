@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sigfuge a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gku521" ;
    schema:description "SigFuge" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SigFuge_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/SigFuge/SigFuge_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/SigFuge_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sigfuge/bioconductor-sigfuge_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicranges",
        "r-base",
        "r-ggplot2",
        "r-matlab",
        "r-reshape",
        "r-sigclust" ;
    schema:identifier biotools:sigfuge ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-sigfuge" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/SigFuge.html" .

