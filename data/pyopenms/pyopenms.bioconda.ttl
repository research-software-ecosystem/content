@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyopenms a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-024-02197-7" ;
    schema:description "Python bindings for OpenMS, an open-source software C++ library for LC-MS data management and analyses." ;
    schema:downloadUrl "https://github.com/OpenMS/OpenMS/releases/download/release%2F3.4.1/OpenMS-3.4.1.tar.gz" ;
    schema:hasPart "autowrap",
        "cython",
        "eigen",
        "libboost-headers",
        "libopenms",
        "matplotlib-base",
        "numpy",
        "pandas",
        "pip",
        "pytest",
        "python",
        "setuptools",
        "wheel" ;
    schema:identifier biotools:openms ;
    schema:license "BSD-3-Clause" ;
    schema:name "pyopenms" ;
    schema:softwareHelp "https://openms.readthedocs.io/en/latest" ;
    schema:softwareVersion "3.4.1" ;
    schema:url "https://github.com/OpenMS/OpenMS" .

