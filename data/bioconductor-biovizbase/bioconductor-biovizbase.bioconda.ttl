@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biovizbase a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Basic graphic utilities for visualization of genomic data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/biovizBase_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/biovizBase/biovizBase_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/biovizBase_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biovizbase/bioconductor-biovizbase_1.58.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-annotationfilter",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-ensembldb",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dichromat",
        "r-hmisc",
        "r-rcolorbrewer",
        "r-rlang",
        "r-scales",
        "zlib" ;
    schema1:identifier biotools:biovizbase ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biovizbase" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/biovizBase.html" .

