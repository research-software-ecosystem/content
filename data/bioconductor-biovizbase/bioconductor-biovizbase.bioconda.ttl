@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biovizbase a schema1:SoftwareApplication ;
    schema1:alternateName "Basic graphic utilities for visualization of genomic data." ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The biovizBase package is designed to provide a set of utilities, color schemes and conventions for genomic data. It serves as the base for various high-level packages for biological data visualization. This saves development effort and encourages consistency." ;
    schema1:identifier <https://bio.tools/biotools:biovizbase> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biovizbase" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/biovizBase.html" .

