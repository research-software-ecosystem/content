@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pash a schema:SoftwareApplication ;
    schema:description "A versatile software package for read mapping and integrative analysis of genomic and epigenomic variation using massively parallel DNA sequencing" ;
    schema:downloadUrl "https://genboree.org/pash-supp/pash-3.0.6.2.tar.gz" ;
    schema:hasPart "glib",
        "ruby" ;
    schema:identifier biotools:pash ;
    schema:license "Unknown" ;
    schema:name "pash" ;
    schema:softwareVersion "3.0.6.2" ;
    schema:url "http://www.bioinformatics.bbsrc.ac.uk/projects/bismark/" .

