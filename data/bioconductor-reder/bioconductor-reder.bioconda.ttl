@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-reder a schema:SoftwareApplication ;
    schema:description "Interactive visualization and manipulation of nested networks" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RedeR_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RedeR/RedeR_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RedeR_3.6.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-reder/bioconductor-reder_3.6.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-igraph",
        "r-scales" ;
    schema:identifier biotools:reder ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-reder" ;
    schema:softwareVersion "3.6.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RedeR.html" .

