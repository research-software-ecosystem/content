@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-snpstats a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "SnpMatrix and XSnpMatrix classes and methods" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/snpStats_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/snpStats/snpStats_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/snpStats_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-snpstats/bioconductor-snpstats_1.60.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-survival",
        "zlib" ;
    schema:identifier biotools:snpstats ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-snpstats" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/snpStats.html" .

