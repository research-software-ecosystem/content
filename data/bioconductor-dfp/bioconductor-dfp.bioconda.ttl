@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dfp a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene Selection" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DFP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DFP/DFP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DFP_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dfp/bioconductor-dfp_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:dfp ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-dfp" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DFP.html" .

