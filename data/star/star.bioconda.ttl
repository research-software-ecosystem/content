@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:star a schema:SoftwareApplication ;
    schema:author "mjsteinbaugh" ;
    schema:description "An RNA-seq read aligner." ;
    schema:downloadUrl "https://github.com/alexdobin/STAR/archive/2.7.11b.tar.gz" ;
    schema:hasPart "htslib",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:star ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "mjsteinbaugh" ;
    schema:name "star" ;
    schema:softwareHelp "https://github.com/alexdobin/STAR/blob/2.7.11b/doc/STARmanual.pdf" ;
    schema:softwareVersion "2.7.11b" ;
    schema:url "https://github.com/alexdobin/STAR" .

