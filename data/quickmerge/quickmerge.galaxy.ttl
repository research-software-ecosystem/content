@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:quickmerge a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196,
        edam:topic_0625,
        edam:topic_2885,
        edam:topic_3175,
        edam:topic_3673 ;
    schema1:codeRepository <https://github.com/mahulchak/quickmerge> ;
    schema1:dateCreated "2022-07-08" ;
    schema1:description "Merge long-read and hybrid assemblies to increase contiguity" ;
    schema1:encodingFormat "fasta",
        "tabular" ;
    schema1:featureList edam:operation_0524,
        edam:operation_0525,
        edam:operation_3196,
        edam:operation_3216,
        edam:operation_3440 ;
    schema1:identifier biotools:quickmerge,
        bioconda:quickmerge ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no> ;
    schema1:keywords "Assembly" ;
    schema1:name "quickmerge" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/quickmerge> .

