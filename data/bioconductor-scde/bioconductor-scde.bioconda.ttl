@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-scde a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.2967" ;
    schema1:description "Single Cell Differential Expression" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/scde_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scde/scde_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/scde_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-scde/bioconductor-scde_2.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocparallel",
        "bioconductor-edger",
        "bioconductor-pcamethods",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cairo",
        "r-extremes",
        "r-flexmix",
        "r-mass",
        "r-mgcv",
        "r-nnet",
        "r-quantreg",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-rjson",
        "r-rmtstat",
        "r-rook",
        "zlib" ;
    schema1:identifier biotools:scde ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-scde" ;
    schema1:softwareVersion "2.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/scde.html" .

