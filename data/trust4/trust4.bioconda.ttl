@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trust4 a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-021-01142-2" ;
    schema:description "TCR and BCR assembly from bulk or single-cell RNA-seq data." ;
    schema:downloadUrl "https://github.com/liulab-dfci/TRUST4/archive/v1.1.9.tar.gz" ;
    schema:hasPart "samtools",
        "zlib" ;
    schema:identifier biotools:trust4 ;
    schema:license "MIT" ;
    schema:name "trust4" ;
    schema:softwareHelp "https://github.com/liulab-dfci/TRUST4/blob/v1.1.9/README.md" ;
    schema:softwareVersion "1.1.9" ;
    schema:url "https://github.com/liulab-dfci/TRUST4" .

