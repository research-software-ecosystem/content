@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ringo a schema:SoftwareApplication ;
    schema:description "R Investigation of ChIP-chip Oligoarrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Ringo_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/Ringo/Ringo_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Ringo_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ringo/bioconductor-ringo_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genefilter",
        "bioconductor-limma",
        "bioconductor-vsn",
        "libblas",
        "liblapack",
        "r-base",
        "r-lattice",
        "r-matrix",
        "r-rcolorbrewer" ;
    schema:identifier biotools:ringo ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-ringo" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/Ringo.html" .

