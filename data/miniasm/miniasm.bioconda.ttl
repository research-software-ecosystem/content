@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:miniasm a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw152" ;
    schema:description "Ultrafast de novo assembly for long noisy reads (though having no consensus step)." ;
    schema:downloadUrl "https://github.com/lh3/miniasm/archive/refs/tags/v0.3.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:miniasm ;
    schema:license "MIT" ;
    schema:name "miniasm" ;
    schema:softwareHelp "https://github.com/lh3/miniasm/blob/v0.3/README.md" ;
    schema:softwareVersion "0.3" ;
    schema:url "https://github.com/lh3/miniasm" .

