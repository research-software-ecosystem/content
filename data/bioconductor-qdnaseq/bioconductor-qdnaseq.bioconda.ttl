@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-qdnaseq a schema1:SoftwareApplication ;
    schema1:description "Quantitative DNA Sequencing for Chromosomal Aberrations" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/QDNAseq_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/QDNAseq/QDNAseq_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/QDNAseq_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qdnaseq/bioconductor-qdnaseq_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-cghbase",
        "bioconductor-cghcall",
        "bioconductor-dnacopy",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-seqinfo",
        "r-base",
        "r-future.apply",
        "r-matrixstats",
        "r-r.utils" ;
    schema1:identifier biotools:qdnaseq ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-qdnaseq" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/QDNAseq.html" .

