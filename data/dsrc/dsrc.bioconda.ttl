@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dsrc a schema:SoftwareApplication ;
    schema:description "High-performance compression of sequencing reads stored in FASTQ format." ;
    schema:downloadUrl "https://github.com/refresh-bio/DSRC/archive/5eda82cb1546b71cd3480bc0aba1d321b52bd0b4.zip" ;
    schema:hasPart "boost-cpp",
        "zlib" ;
    schema:identifier biotools:dsrc ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "dsrc" ;
    schema:softwareVersion "2015.06.04" ;
    schema:url "https://github.com/refresh-bio/DSRC" .

