@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-macorrplot a schema1:SoftwareApplication ;
    schema1:alternateName "Visualize artificial correlation in microarray data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Graphically displays correlation in microarray data that is due to insufficient normalization" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/maCorrPlot_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/maCorrPlot/maCorrPlot_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/maCorrPlot_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-macorrplot/bioconductor-macorrplot_1.80.0_src_all.tar.gz" ;
    schema1:identifier "biotools:macorrplot" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-macorrplot" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/maCorrPlot.html" .

