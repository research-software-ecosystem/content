@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-macorrplot a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Visualize artificial correlation in microarray data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/maCorrPlot_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/maCorrPlot/maCorrPlot_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/maCorrPlot_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-macorrplot/bioconductor-macorrplot_1.80.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-lattice" ;
    schema:identifier biotools:macorrplot ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-macorrplot" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/maCorrPlot.html" .

