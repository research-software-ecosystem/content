@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:admixtools a schema:SoftwareApplication ;
    schema:citation "doi:10.1534/genetics.112.145037" ;
    schema:description "ADMIXTOOLS (Patterson et al. 2012) is a software package that supports formal tests of whether admixture occurred, and makes it possible to infer admixture proportions and dates." ;
    schema:downloadUrl "https://github.com/DReichLab/AdmixTools/archive/refs/tags/v8.0.2.tar.gz" ;
    schema:hasPart "argp-standalone",
        "gsl",
        "openblas" ;
    schema:identifier biotools:AdmixTools ;
    schema:license "Academic License" ;
    schema:name "admixtools" ;
    schema:softwareHelp "https://github.com/DReichLab/AdmixTools/blob/v8.0.2/README" ;
    schema:softwareVersion "8.0.2" ;
    schema:url "https://github.com/DReichLab/AdmixTools" .

