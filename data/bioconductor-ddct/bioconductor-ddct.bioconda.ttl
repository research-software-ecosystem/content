@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ddct a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "The ddCt Algorithm for the Analysis of Quantitative Real-Time PCR (qRT-PCR)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ddCt_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ddCt/ddCt_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ddCt_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ddct/bioconductor-ddct_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "r-base",
        "r-lattice",
        "r-rcolorbrewer",
        "r-xtable" ;
    schema:identifier biotools:ddct ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-ddct" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ddCt.html" .

