@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:jali a schema:SoftwareApplication ;
    schema:citation "doi:10.1089/106652702761034172" ;
    schema:description "Alignment method for comparing a protein sequence to a protein family, represented by a multiple alignment. It can also be used for sensitive protein database searches. The algorithm is a generalization of the Smith-Waterman algorithm." ;
    schema:downloadUrl "https://bibiserv.cebitec.uni-bielefeld.de/applications/jali/resources/downloads/jali-1.3.src.tar.gz" ;
    schema:identifier biotools:jali ;
    schema:license "file" ;
    schema:name "jali" ;
    schema:softwareVersion "1.3" ;
    schema:url "http://bibiserv.cebitec.uni-bielefeld.de/jali" .

