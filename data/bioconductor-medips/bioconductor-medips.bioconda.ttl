@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-medips a schema:SoftwareApplication ;
    schema:description "DNA IP-seq data analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MEDIPS_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MEDIPS/MEDIPS_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MEDIPS_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-medips/bioconductor-medips_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-dnacopy",
        "bioconductor-edger",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-preprocesscore",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "r-base",
        "r-gtools" ;
    schema:identifier biotools:medips ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-medips" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MEDIPS.html" .

