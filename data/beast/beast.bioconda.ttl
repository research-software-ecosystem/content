@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:beast a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-025-02751-x" ;
    schema:description "BEAST is a cross-platform program for Bayesian analysis of molecular sequences using MCMC." ;
    schema:downloadUrl "https://github.com/beast-dev/beast-mcmc/releases/download/v10.5.0/BEAST_X_v10.5.0.tgz" ;
    schema:identifier biotools:beast ;
    schema:license "LGPL-2.1-or-later" ;
    schema:name "beast" ;
    schema:softwareHelp "https://beast.community" ;
    schema:softwareVersion "10.5.0" ;
    schema:url "https://beast.community" .

