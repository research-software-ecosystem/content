@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-msstats a schema:SoftwareApplication ;
    schema:description "Protein Significance Analysis in DDA, SRM and DIA for Label-free or Label-based Proteomics Experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MSstats_4.18.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MSstats/MSstats_4.18.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MSstats_4.18.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-msstats/bioconductor-msstats_4.18.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "bioconductor-marray",
        "bioconductor-msstatsconvert",
        "bioconductor-preprocesscore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-checkmate",
        "r-data.table",
        "r-ggplot2",
        "r-ggrepel",
        "r-gplots",
        "r-htmltools",
        "r-lme4",
        "r-mass",
        "r-plotly",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-rlang",
        "r-statmod",
        "r-survival",
        "zlib" ;
    schema:identifier biotools:msstats ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-msstats" ;
    schema:softwareVersion "4.18.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MSstats.html" .

