@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-msstats a schema1:SoftwareApplication ;
    schema1:alternateName "Protein Significance Analysis in DDA, SRM and DIA for Label-free or Label-based Proteomics Experiments" ;
    schema1:description "A set of tools for statistical relative protein significance analysis in DDA, SRM and DIA experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MSstats_4.18.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MSstats/MSstats_4.18.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MSstats_4.18.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-msstats/bioconductor-msstats_4.18.1_src_all.tar.gz" ;
    schema1:identifier "biotools:msstats" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-msstats" ;
    schema1:softwareVersion "4.18.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MSstats.html" .

