@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:getorganelle a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-020-02154-5" ;
    schema:description "Get organelle genomes from genome skimming data" ;
    schema:downloadUrl "https://github.com/Kinggerm/GetOrganelle/archive/1.7.7.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:getorganelle ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "getorganelle" ;
    schema:softwareHelp "https://github.com/Kinggerm/GetOrganelle/wiki" ;
    schema:softwareVersion "1.7.7.1" ;
    schema:url "https://github.com/Kinggerm/GetOrganelle" .

