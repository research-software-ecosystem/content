@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mummer4 a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1005944" ;
    schema:description "MUMmer is a system for rapidly aligning entire genomes." ;
    schema:downloadUrl "https://github.com/mummer4/mummer/releases/download/v4.0.1/mummer-4.0.1.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "perl",
        "swig",
        "yaggo" ;
    schema:identifier biotools:mummer4 ;
    schema:license "Artistic License 2.0" ;
    schema:name "mummer4" ;
    schema:softwareHelp "https://github.com/mummer4/mummer/blob/v4.0.1/README.md" ;
    schema:softwareVersion "4.0.1" ;
    schema:url "https://mummer4.github.io" .

