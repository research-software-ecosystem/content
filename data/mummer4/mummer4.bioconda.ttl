@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mummer4 a schema1:SoftwareApplication ;
    schema1:alternateName "MUMmer is a system for rapidly aligning entire genomes." ;
    schema1:citation "doi:10.1371/journal.pcbi.1005944" ;
    schema1:description "MUMmer is a system for rapidly aligning entire genomes." ;
    schema1:identifier <https://bio.tools/biotools:mummer4>,
        "usegalaxy-eu:mummer_mummer",
        "usegalaxy-eu:mummerplot",
        "usegalaxy-eu:mummerplot_wrapper" ;
    schema1:license "Artistic License 2.0" ;
    schema1:name "mummer4" ;
    schema1:softwareVersion "4.0.1" ;
    schema1:url "https://mummer4.github.io" .

