@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gem3-mapper a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.2221" ;
    schema:description "The GEM read mapper (v3)." ;
    schema:downloadUrl "https://github.com/smarco/gem3-mapper/archive/v3.6.1.tar.gz" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:GEM_Mapper ;
    schema:license "GPL-3.0" ;
    schema:name "gem3-mapper" ;
    schema:softwareVersion "3.6.1" ;
    schema:url "https://github.com/smarco/gem3-mapper" .

