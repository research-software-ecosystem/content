@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annotationhubdata a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Transform public data resources into Bioconductor Data Structures" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/AnnotationHubData_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AnnotationHubData_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AnnotationHubData/AnnotationHubData_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationhubdata/bioconductor-annotationhubdata_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-annotationforge",
        "bioconductor-annotationhub",
        "bioconductor-biobase",
        "bioconductor-bioccheck",
        "bioconductor-biocgenerics",
        "bioconductor-biocviews",
        "bioconductor-biostrings",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-graph",
        "bioconductor-iranges",
        "bioconductor-organismdbi",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-biocmanager",
        "r-dbi",
        "r-futile.logger",
        "r-jsonlite",
        "r-rcurl",
        "r-rsqlite",
        "r-xml" ;
    schema:identifier biotools:annotationhubdata ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-annotationhubdata" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationHubData.html" .

