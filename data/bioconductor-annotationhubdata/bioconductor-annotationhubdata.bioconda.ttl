@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annotationhubdata a schema1:SoftwareApplication ;
    schema1:alternateName "Transform public data resources into Bioconductor Data Structures" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "These recipes convert a wide variety and a growing number of public bioinformatic data sets into easily-used standard Bioconductor data structures." ;
    schema1:identifier biotools:annotationhubdata ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-annotationhubdata" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationHubData.html" .

