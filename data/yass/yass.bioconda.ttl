@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:yass a schema:SoftwareApplication ;
    schema:description "YASS is a genomic similarity search tool, for nucleic (DNA/RNA) sequences in fasta or plain text format." ;
    schema:downloadUrl "https://bioinfo.lifl.fr/yass/files/yass-1.16_alpha1/yass-1.16.tar.gz" ;
    schema:identifier biotools:yass ;
    schema:license "CeCILL Free Software License" ;
    schema:name "yass" ;
    schema:softwareHelp "https://bioinfo.lifl.fr/yass" ;
    schema:softwareVersion "1.16" ;
    schema:url "https://bioinfo.lifl.fr/yass" .

