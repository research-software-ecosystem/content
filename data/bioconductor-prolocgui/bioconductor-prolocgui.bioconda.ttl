@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-prolocgui a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ncomms9992" ;
    schema:description "Interactive visualisation of spatial proteomics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pRolocGUI_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pRolocGUI/pRolocGUI_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pRolocGUI_2.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-prolocgui/bioconductor-prolocgui_2.20.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-msnbase",
        "bioconductor-proloc",
        "r-base",
        "r-colorspace",
        "r-colourpicker",
        "r-dplyr",
        "r-dt",
        "r-ggplot2",
        "r-scales",
        "r-shiny",
        "r-shinydashboard",
        "r-shinydashboardplus",
        "r-shinyhelper",
        "r-shinyjs",
        "r-shinywidgets" ;
    schema:identifier biotools:prolocgui ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-prolocgui" ;
    schema:softwareVersion "2.20.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pRolocGUI.html" .

