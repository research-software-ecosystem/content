@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-prolocgui a schema1:SoftwareApplication ;
    schema1:alternateName "Interactive visualisation of spatial proteomics data" ;
    schema1:citation "doi:10.1038/ncomms9992" ;
    schema1:description "The package pRolocGUI comprises functions to interactively visualise spatial proteomics data on the basis of pRoloc, pRolocdata and shiny." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pRolocGUI_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pRolocGUI/pRolocGUI_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pRolocGUI_2.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-prolocgui/bioconductor-prolocgui_2.20.0_src_all.tar.gz" ;
    schema1:identifier "biotools:prolocgui" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-prolocgui" ;
    schema1:softwareVersion "2.20.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pRolocGUI.html" .

