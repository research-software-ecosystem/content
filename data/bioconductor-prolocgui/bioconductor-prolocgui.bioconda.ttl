@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-prolocgui a schema1:SoftwareApplication ;
    schema1:alternateName "Interactive visualisation of spatial proteomics data" ;
    schema1:citation "doi:10.1038/ncomms9992" ;
    schema1:description "The package pRolocGUI comprises functions to interactively visualise spatial proteomics data on the basis of pRoloc, pRolocdata and shiny." ;
    schema1:identifier <https://bio.tools/biotools:prolocgui> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-prolocgui" ;
    schema1:softwareVersion "2.20.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pRolocGUI.html" .

