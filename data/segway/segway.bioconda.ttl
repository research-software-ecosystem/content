@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:segway a schema:SoftwareApplication ;
    schema:author "ericr86" ;
    schema:citation "doi:10.1093/bioinformatics/btx603" ;
    schema:description "A tool for easy pattern discovery and identification in functional genomics data." ;
    schema:downloadUrl "https://pypi.org/packages/source/s/segway/segway-3.0.7.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools_scm" ;
    schema:identifier biotools:segway ;
    schema:license "GPL-2.0-or-later" ;
    schema:maintainer "ericr86" ;
    schema:name "segway" ;
    schema:softwareHelp "https://segway.readthedocs.io/en/latest" ;
    schema:softwareVersion "3.0.7" ;
    schema:url "https://segway.hoffmanlab.org" .

