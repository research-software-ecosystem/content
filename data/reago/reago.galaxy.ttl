@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:reago a schema1:SoftwareApplication ;
    bioschemas:output "fasta" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0099,
        edam:topic_0196,
        edam:topic_3174,
        edam:topic_3301 ;
    schema1:codeRepository <https://github.com/chengyuan/reago-1.1> ;
    schema1:dateCreated "2015-12-09" ;
    schema1:description "Reago is tool to assembly 16S ribosomal RNA recovery from metagenomic data." ;
    schema1:encodingFormat "fasta" ;
    schema1:featureList edam:data_0925,
        edam:operation_0310,
        edam:topic_0196 ;
    schema1:identifier biotools:reago,
        bioconda:reago ;
    schema1:isPartOf <https://usegalaxy.eu> ;
    schema1:keywords "Metagenomics",
        "RNA" ;
    schema1:name "reago" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/bgruening/galaxytools/tree/master/tools/rna_tools/reago> .

<https://usegalaxy.eu> a schema1:WebSite .

