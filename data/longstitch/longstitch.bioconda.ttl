@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:longstitch a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2021.06.17.448848" ;
    schema:description "A genome assembly correction and scaffolding pipeline using long reads." ;
    schema:downloadUrl "https://github.com/BirolLab/LongStitch/releases/download/v1.0.5/longstitch-1.0.5.tar.gz" ;
    schema:identifier biotools:longstitch ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "longstitch" ;
    schema:softwareHelp "https://github.com/BirolLab/LongStitch/blob/v1.0.5/README.md" ;
    schema:softwareVersion "1.0.5" ;
    schema:url "https://github.com/BirolLab/longstitch" .

