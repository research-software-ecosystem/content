@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ebsea a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Exon Based Strategy for Expression Analysis of genes" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EBSEA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBSEA/EBSEA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBSEA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebsea/bioconductor-ebsea_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-deseq2",
        "bioconductor-empiricalbrownsmethod",
        "r-base" ;
    schema:identifier biotools:ebsea ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ebsea" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EBSEA.html" .

