@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ebsea a schema1:SoftwareApplication ;
    schema1:alternateName "Exon Based Strategy for Expression Analysis of genes" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Calculates differential expression of genes based on exon counts of genes obtained from RNA-seq sequencing data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/EBSEA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBSEA/EBSEA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBSEA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebsea/bioconductor-ebsea_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ebsea" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ebsea" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EBSEA.html" .

