@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bacon a schema1:SoftwareApplication ;
    schema1:alternateName "Controlling bias and inflation in association studies using the empirical null distribution" ;
    schema1:description "Bacon can be used to remove inflation and bias often observed in epigenome- and transcriptome-wide association studies. To this end bacon constructs an empirical null distribution using a Gibbs Sampling algorithm by fitting a three-component normal mixture on z-scores." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/bacon_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bacon/bacon_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bacon_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bacon/bioconductor-bacon_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:bacon" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-bacon" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bacon.html" .

