@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bacon a schema:SoftwareApplication ;
    schema:description "Controlling bias and inflation in association studies using the empirical null distribution" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/bacon_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bacon/bacon_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bacon_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bacon/bioconductor-bacon_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ellipse",
        "r-ggplot2",
        "zlib" ;
    schema:identifier biotools:bacon ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-bacon" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/bacon.html" .

