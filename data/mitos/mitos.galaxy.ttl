@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:mitos a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "fasta",
        "gff",
        "pdf",
        "tabular",
        "txt",
        "zip" ;
    schema1:applicationSubCategory edam:topic_3500,
        edam:topic_3673 ;
    schema1:codeRepository <http://mitos.bioinf.uni-leipzig.de/> ;
    schema1:dateCreated "2020-02-18" ;
    schema1:description "de-novo annotation of metazoan mitochondrial genomes" ;
    schema1:encodingFormat "bed",
        "fasta",
        "gff",
        "pdf",
        "tabular",
        "txt",
        "zip" ;
    schema1:featureList edam:operation_0362,
        edam:topic_0222 ;
    schema1:identifier biotools:mitos,
        bioconda:mitos ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=0de5fcc38ef1501d>,
        <https://usegalaxy.eu/published/workflow?id=2d0400b5d05c6c10>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org/published/workflow?id=110ad20060b03e02> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "mitos" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/mitos> .

