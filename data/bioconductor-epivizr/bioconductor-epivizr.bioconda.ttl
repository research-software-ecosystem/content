@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-epivizr a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3038" ;
    schema:description "R Interface to epiviz web app" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/epivizr_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/epivizr/epivizr_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/epivizr_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epivizr/bioconductor-epivizr_2.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-bumphunter",
        "bioconductor-epivizrdata",
        "bioconductor-epivizrserver",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:epivizr ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-epivizr" ;
    schema:softwareVersion "2.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/epivizr.html" .

