@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:transdecoder a schema1:SoftwareApplication ;
    schema1:alternateName "TransDecoder identifies candidate coding regions within transcript sequences, such as those generated by de novo RNA-Seq transcript assembly using Trinity, or constructed based on RNA-Seq alignments to the genome using Tophat and Cufflinks." ;
    schema1:description "TransDecoder identifies candidate coding regions within transcript sequences, such as those generated by de novo RNA-Seq transcript assembly using Trinity, or constructed based on RNA-Seq alignments to the genome using Tophat and Cufflinks." ;
    schema1:identifier <https://bio.tools/biotools:TransDecoder>,
        "usegalaxy-eu:transdecoder" ;
    schema1:license "Broad Institute" ;
    schema1:name "transdecoder" ;
    schema1:softwareVersion "6.0.0" ;
    schema1:url "https://transdecoder.github.io" .

