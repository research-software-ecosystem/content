@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:transdecoder a schema:SoftwareApplication ;
    schema:description "TransDecoder identifies candidate coding regions within transcript sequences, such as those generated by de novo RNA-Seq transcript assembly using Trinity, or constructed based on RNA-Seq alignments to the genome using Tophat and Cufflinks." ;
    schema:downloadUrl "https://github.com/TransDecoder/TransDecoder/archive/TransDecoder-v6.0.0.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:TransDecoder ;
    schema:license "Broad Institute" ;
    schema:name "transdecoder" ;
    schema:softwareHelp "https://github.com/TransDecoder/TransDecoder/wiki" ;
    schema:softwareVersion "6.0.0" ;
    schema:url "https://transdecoder.github.io" .

