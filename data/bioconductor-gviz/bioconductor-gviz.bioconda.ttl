@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gviz a schema1:SoftwareApplication ;
    schema1:description "Plotting data and annotation information along genomic coordinates" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Gviz_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Gviz/Gviz_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Gviz_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gviz/bioconductor-gviz_1.54.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-biovizbase",
        "bioconductor-bsgenome",
        "bioconductor-ensembldb",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "r-base",
        "r-digest",
        "r-lattice",
        "r-latticeextra",
        "r-matrixstats",
        "r-rcolorbrewer" ;
    schema1:identifier biotools:gviz ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gviz" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Gviz.html" .

