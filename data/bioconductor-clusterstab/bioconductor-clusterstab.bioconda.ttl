@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clusterstab a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Compute cluster stability scores for microarray data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/clusterStab_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clusterStab/clusterStab_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clusterStab_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clusterstab/bioconductor-clusterstab_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:clusterstab ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-clusterstab" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/clusterStab.html" .

