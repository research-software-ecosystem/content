@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clusterstab a schema1:SoftwareApplication ;
    schema1:alternateName "Compute cluster stability scores for microarray data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package can be used to estimate the number of clusters in a set of microarray data, as well as test the stability of these clusters." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/clusterStab_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clusterStab/clusterStab_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clusterStab_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clusterstab/bioconductor-clusterstab_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:clusterstab" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-clusterstab" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clusterStab.html" .

