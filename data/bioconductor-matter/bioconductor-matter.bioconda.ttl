@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-matter a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Out-of-core statistical computing and signal processing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/matter_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/matter/matter_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/matter_2.12.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-matter/bioconductor-matter_2.12.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-protgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-digest",
        "r-irlba",
        "r-matrix",
        "zlib" ;
    schema:identifier biotools:matter ;
    schema:license "Artistic-2.0 | file LICENSE" ;
    schema:name "bioconductor-matter" ;
    schema:softwareVersion "2.12.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/matter.html" .

