@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-matter a schema1:SoftwareApplication ;
    schema1:alternateName "Out-of-core statistical computing and signal processing" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Toolbox for larger-than-memory scientific computing and visualization, providing efficient out-of-core data structures using files or shared memory, for dense and sparse vectors, matrices, and arrays, with applications to nonuniformly sampled signals and images." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/matter_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/matter/matter_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/matter_2.12.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-matter/bioconductor-matter_2.12.0_src_all.tar.gz" ;
    schema1:identifier "biotools:matter" ;
    schema1:license "Artistic-2.0 | file LICENSE" ;
    schema1:name "bioconductor-matter" ;
    schema1:softwareVersion "2.12.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/matter.html" .

