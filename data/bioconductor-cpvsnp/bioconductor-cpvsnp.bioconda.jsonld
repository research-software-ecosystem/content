  "@id": "bioconda:bioconductor-cpvsnp",
  "@type": "schema1:SoftwareApplication",
  "schema1:alternateName": "Gene set analysis methods for SNP association p-values that lie in genes in given gene sets",
  "schema1:citation": "doi:10.1038/nmeth.3252",
  "schema1:description": "Gene set analysis methods exist to combine SNP-level association p-values into gene sets, calculating a single association p-value for each gene set. This package implements two such methods that require only the calculated SNP p-values, the gene set(s) of interest, and a correlation matrix (if desired). One method (GLOSSI) requires independent SNPs and the other (VEGAS) can take into account correlation (LD) among the SNPs. Built-in plotting functions are available to help users visualize results.",
  "schema1:downloadUrl": [
    "https://bioconductor.org/packages/3.22/bioc/src/contrib/cpvSNP_1.42.0.tar.gz",
    "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cpvSNP/cpvSNP_1.42.0.tar.gz",
    "https://bioarchive.galaxyproject.org/cpvSNP_1.42.0.tar.gz",
    "https://depot.galaxyproject.org/software/bioconductor-cpvsnp/bioconductor-cpvsnp_1.42.0_src_all.tar.gz"
  ],
  "schema1:identifier": "biotools:cpvsnp",
  "schema1:license": "Artistic-2.0",
  "schema1:name": "bioconductor-cpvsnp",
  "schema1:softwareVersion": "1.42.0",
  "schema1:url": "https://bioconductor.org/packages/3.22/bioc/html/cpvSNP.html"
