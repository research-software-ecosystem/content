@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cpvsnp a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene set analysis methods for SNP association p-values that lie in genes in given gene sets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cpvSNP_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cpvSNP/cpvSNP_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cpvSNP_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cpvsnp/bioconductor-cpvsnp_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "bioconductor-genomicfeatures",
        "bioconductor-gseabase",
        "r-base",
        "r-corpcor",
        "r-ggplot2",
        "r-plyr" ;
    schema:identifier biotools:cpvsnp ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-cpvsnp" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cpvSNP.html" .

