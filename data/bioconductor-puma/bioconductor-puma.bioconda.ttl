@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-puma a schema:SoftwareApplication ;
    schema:description "Propagating Uncertainty in Microarray Analysis(including Affymetrix tranditional 3' arrays and exon arrays and Human Transcriptome Array 2.0)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/puma_3.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/puma/puma_3.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/puma_3.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-puma/bioconductor-puma_3.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-oligo",
        "bioconductor-oligoclasses",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mclust",
        "zlib" ;
    schema:identifier biotools:puma ;
    schema:license "LGPL" ;
    schema:name "bioconductor-puma" ;
    schema:softwareVersion "3.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/puma.html" .

