@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bedtk a schema:SoftwareApplication ;
    schema:author "mjsteinbaugh" ;
    schema:description "Bedtk is a set of simple tools to process BED files." ;
    schema:downloadUrl "https://github.com/lh3/bedtk/archive/refs/tags/v1.2.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:bedtk ;
    schema:license "MIT" ;
    schema:maintainer "mjsteinbaugh" ;
    schema:name "bedtk" ;
    schema:softwareHelp "https://github.com/lh3/bedtk" ;
    schema:softwareVersion "1.2" ;
    schema:url "https://github.com/lh3/bedtk" .

