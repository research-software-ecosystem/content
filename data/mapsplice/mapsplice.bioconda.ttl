@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mapsplice a schema:SoftwareApplication ;
    schema:description "MapSplice is a software for mapping RNA-seq data to reference genome for splice junction discovery that depends only on reference genome, and not on any further annotations." ;
    schema:downloadUrl "http://protocols.netlab.uky.edu/~zeng/MapSplice-v2.2.1.zip" ;
    schema:hasPart "ncurses",
        "python",
        "zlib" ;
    schema:identifier biotools:mapsplice ;
    schema:license "Custom" ;
    schema:name "mapsplice" ;
    schema:softwareHelp "http://www.netlab.uky.edu/p/bioinfo/MapSplice2" ;
    schema:softwareVersion "2.2.1" ;
    schema:url "http://www.netlab.uky.edu/p/bioinfo/MapSplice2" .

