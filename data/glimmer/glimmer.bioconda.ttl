@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:glimmer a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm009" ;
    schema:description "Glimmer is a system for finding genes in microbial DNA" ;
    schema:downloadUrl "https://ccb.jhu.edu/software/glimmer/glimmer302b.tar.gz" ;
    schema:identifier biotools:glimmer ;
    schema:license "Custom" ;
    schema:name "glimmer" ;
    schema:softwareVersion "3.02" ;
    schema:url "https://ccb.jhu.edu/software/glimmer/index.shtml" .

