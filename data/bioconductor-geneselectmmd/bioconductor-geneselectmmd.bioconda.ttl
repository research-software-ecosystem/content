@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-geneselectmmd a schema:SoftwareApplication ;
    schema:description "Gene selection based on the marginal distributions of gene profiles that characterized by a mixture of three-component multivariate distributions" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GeneSelectMMD_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneSelectMMD/GeneSelectMMD_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneSelectMMD_2.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geneselectmmd/bioconductor-geneselectmmd_2.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mass",
        "zlib" ;
    schema:identifier biotools:geneselectmmd ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-geneselectmmd" ;
    schema:softwareVersion "2.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GeneSelectMMD.html" .

