@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gcta a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ajhg.2010.11.011" ;
    schema:description "GCTA (Genome-wide Complex Trait Analysis) estimates the proportion of phenotypic variance explained by all genome-wide SNPs for complex traits." ;
    schema:identifier biotools:gcta ;
    schema:license "GPL-3.0-only" ;
    schema:name "gcta" ;
    schema:softwareVersion "1.94.1" ;
    schema:url "https://yanglab.westlake.edu.cn/software/gcta" .

