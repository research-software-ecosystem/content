@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:mykrobe a schema1:SoftwareApplication ;
    schema1:alternateName "Antibiotic resistance prediction in minutes." ;
    schema1:citation "doi:10.12688/wellcomeopenres.15603.1" ;
    schema1:description "Rapid antibiotic-resistance predictions from genome sequence data for Staphylococcus aureus and Mycobacterium tuberculosis." ;
    schema1:identifier biotools:Mykrobe ;
    schema1:license "MIT" ;
    schema1:maintainer "martinghunt",
        "mbhall88" ;
    schema1:name "mykrobe" ;
    schema1:softwareVersion "0.13.0" ;
    schema1:url "https://github.com/Mykrobe-tools/mykrobe" .

