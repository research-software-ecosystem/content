@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mykrobe a schema:SoftwareApplication ;
    schema:author "martinghunt",
        "mbhall88" ;
    schema:citation "doi:10.12688/wellcomeopenres.15603.1" ;
    schema:description "Antibiotic resistance prediction in minutes." ;
    schema:downloadUrl "https://github.com/Mykrobe-tools/mykrobe/archive/v0.13.0.tar.gz" ;
    schema:hasPart "anytree",
        "biopython",
        "cython",
        "gzip",
        "mongodb",
        "mongoengine",
        "numpy",
        "pip",
        "python",
        "pyvcf3",
        "requests",
        "tar",
        "wget",
        "zlib" ;
    schema:identifier biotools:Mykrobe ;
    schema:license "MIT" ;
    schema:maintainer "martinghunt",
        "mbhall88" ;
    schema:name "mykrobe" ;
    schema:softwareHelp "https://github.com/Mykrobe-tools/mykrobe/wiki" ;
    schema:softwareVersion "0.13.0" ;
    schema:url "https://github.com/Mykrobe-tools/mykrobe" .

