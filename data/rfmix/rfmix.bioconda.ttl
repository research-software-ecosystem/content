bioconda:rfmix a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ajhg.2013.06.020" ;
    schema:description "RFMix implements a fast discriminative approach to modeling ancestry along an admixed chromosome given observed haplotype sequences of known or inferred ancestry." ;
