    schema:hasPart "pthread-stubs" ;
    schema:identifier biotools:RFMix ;
    schema:license "Free for Academic Use" ;
    schema:name "rfmix" ;
    schema:softwareVersion "2.03.r0.9505bfa" ;
    schema:url "https://github.com/slowkoni/rfmix" .

