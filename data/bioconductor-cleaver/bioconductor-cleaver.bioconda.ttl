@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cleaver a schema1:SoftwareApplication ;
    schema1:alternateName "Cleavage of Polypeptide Sequences" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "In-silico cleavage of polypeptide sequences. The cleavage rules are taken from: http://web.expasy.org/peptide_cutter/peptidecutter_enzymes.html" ;
    schema1:identifier <https://bio.tools/biotools:cleaver> ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-cleaver" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cleaver.html" .

