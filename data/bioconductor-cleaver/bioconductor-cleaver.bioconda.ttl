@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cleaver a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Cleavage of Polypeptide Sequences" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cleaver_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cleaver/cleaver_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cleaver_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cleaver/bioconductor-cleaver_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:cleaver ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-cleaver" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cleaver.html" .

