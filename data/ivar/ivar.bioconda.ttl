@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ivar a schema1:SoftwareApplication ;
    schema1:alternateName "iVar is a computational package that contains functions broadly useful for viral amplicon-based sequencing." ;
    schema1:citation "doi:10.1186/s13059-018-1618-7" ;
    schema1:description "iVar is a computational package that contains functions broadly useful for viral amplicon-based sequencing." ;
    schema1:identifier <https://bio.tools/biotools:ivar>,
        "usegalaxy-eu:ivar_consensus",
        "usegalaxy-eu:ivar_filtervariants",
        "usegalaxy-eu:ivar_getmasked",
        "usegalaxy-eu:ivar_removereads",
        "usegalaxy-eu:ivar_trim",
        "usegalaxy-eu:ivar_variants" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "gkarthik" ;
    schema1:name "ivar" ;
    schema1:softwareVersion "1.4.4" ;
    schema1:url "https://github.com/andersen-lab/ivar" .

