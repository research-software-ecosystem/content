@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ivar a schema:SoftwareApplication ;
    schema:author "gkarthik" ;
    schema:citation "doi:10.1186/s13059-018-1618-7" ;
    schema:description "iVar is a computational package that contains functions broadly useful for viral amplicon-based sequencing." ;
    schema:downloadUrl "https://github.com/andersen-lab/ivar/archive/v1.4.4.tar.gz" ;
    schema:hasPart "htslib",
        "zlib" ;
    schema:identifier biotools:ivar ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "gkarthik" ;
    schema:name "ivar" ;
    schema:softwareHelp "https://andersen-lab.github.io/ivar/html" ;
    schema:softwareVersion "1.4.4" ;
    schema:url "https://github.com/andersen-lab/ivar" .

