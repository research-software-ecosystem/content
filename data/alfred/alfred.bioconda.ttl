@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:alfred a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bty1007" ;
    schema:description "BAM alignment statistics, feature counting and feature annotation" ;
    schema:downloadUrl "https://github.com/tobiasrausch/alfred/archive/v0.5.3.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "htslib",
        "xz",
        "zlib" ;
    schema:identifier biotools:alfred ;
    schema:license "BSD-3-Clause" ;
    schema:name "alfred" ;
    schema:softwareHelp "https://github.com/tobiasrausch/alfred/blob/v0.5.3/README.md" ;
    schema:softwareVersion "0.5.3" ;
    schema:url "https://github.com/tobiasrausch/alfred" .

