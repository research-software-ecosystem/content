@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:alfred a schema1:SoftwareApplication ;
    schema1:alternateName "BAM alignment statistics, feature counting and feature annotation" ;
    schema1:citation "doi:10.1093/bioinformatics/bty1007" ;
    schema1:description "BAM alignment statistics, feature counting and feature annotation" ;
    schema1:identifier <https://bio.tools/biotools:alfred> ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "alfred" ;
    schema1:softwareVersion "0.6.2" ;
    schema1:url "https://github.com/tobiasrausch/alfred" .

