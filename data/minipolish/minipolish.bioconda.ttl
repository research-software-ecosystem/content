@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:minipolish a schema:SoftwareApplication ;
    schema:author "rrwick",
        "thanhleviet" ;
    schema:citation "doi:10.12688/f1000research.21782.4" ;
    schema:description "A tool for Racon polishing miniasm assemblies." ;
    schema:downloadUrl "https://github.com/rrwick/Minipolish/archive/v0.2.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:minipolish ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "rrwick",
        "thanhleviet" ;
    schema:name "minipolish" ;
    schema:softwareHelp "https://github.com/rrwick/Minipolish/blob/v0.2.1/README.md" ;
    schema:softwareVersion "0.2.1" ;
    schema:url "https://github.com/rrwick/Minipolish" .

