@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gosemsim a schema:SoftwareApplication ;
    schema:description "GO-terms Semantic Similarity Measures" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GOSemSim_2.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GOSemSim/GOSemSim_2.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GOSemSim_2.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gosemsim/bioconductor-gosemsim_2.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-go.db",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dbi",
        "r-digest",
        "r-r.utils",
        "r-rcpp",
        "r-rlang",
        "r-yulab.utils",
        "zlib" ;
    schema:identifier biotools:gosemsim ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gosemsim" ;
    schema:softwareVersion "2.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GOSemSim.html" .

