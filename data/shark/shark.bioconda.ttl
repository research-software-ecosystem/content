@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:shark a schema:SoftwareApplication ;
    schema:description "Mapping-free filtering of useless RNA-Seq reads" ;
    schema:downloadUrl "https://github.com/AlgoLab/shark/archive/v1.2.0.tar.gz" ;
    schema:hasPart "sdsl-lite",
        "zlib" ;
    schema:identifier biotools:shark ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "shark" ;
    schema:softwareVersion "1.2.0" ;
    schema:url "https://algolab.github.io/shark/" .

