@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cghnormaliter a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2164-10-401" ;
    schema:description "Normalization of array CGH data with imbalanced aberrations." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CGHnormaliter_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CGHnormaliter/CGHnormaliter_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CGHnormaliter_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cghnormaliter/bioconductor-cghnormaliter_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-cghbase",
        "bioconductor-cghcall",
        "r-base" ;
    schema:identifier biotools:cghnormaliter ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-cghnormaliter" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CGHnormaliter.html" .

