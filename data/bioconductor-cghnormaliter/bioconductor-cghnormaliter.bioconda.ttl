@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cghnormaliter a schema1:SoftwareApplication ;
    schema1:alternateName "Normalization of array CGH data with imbalanced aberrations." ;
    schema1:citation "doi:10.1186/1471-2164-10-401" ;
    schema1:description "Normalization and centralization of array comparative genomic hybridization (aCGH) data. The algorithm uses an iterative procedure that effectively eliminates the influence of imbalanced copy numbers. This leads to a more reliable assessment of copy number alterations (CNAs)." ;
    schema1:identifier <https://bio.tools/biotools:cghnormaliter> ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-cghnormaliter" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CGHnormaliter.html" .

