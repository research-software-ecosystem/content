@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ananse a schema:SoftwareApplication ;
    schema:author "siebrenf",
        "simonvh" ;
    schema:description "ANANSE: ANalysis Algorithm for Networks Specified by Enhancers - Prediction of key transcription factors in cell fate determination using enhancer networks" ;
    schema:downloadUrl "https://github.com/vanheeringen-lab/ANANSE/releases/download/v0.5.1/ANANSE-0.5.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:ananse ;
    schema:license "MIT License" ;
    schema:maintainer "siebrenf",
        "simonvh" ;
    schema:name "ananse" ;
    schema:softwareVersion "0.5.1" ;
    schema:url "https://github.com/vanheeringen-lab/ANANSE" .

