@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:minibwa a schema1:SoftwareApplication ;
    bioschemas:output "bam",
        "paf" ;
    schema1:codeRepository <https://github.com/lh3/minibwa> ;
    schema1:dateCreated "2026-08-25" ;
    schema1:description "minibwa is a fast successor to BWA-MEM for short and accurate long reads." ;
    schema1:encodingFormat "bam",
        "paf" ;
    schema1:identifier biotools:minibwa,
        bioconda:minibwa ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.fr> ;
    schema1:keywords "Next Gen Mappers" ;
    schema1:name "minibwa" ;
    schema1:softwareVersion "0.7" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/minibwa> .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.fr> a schema1:WebSite .

