@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ntw a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btq629" ;
    schema:description "Predict gene network using an Ordinary Differential Equation (ODE) based method" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/NTW_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NTW/NTW_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/NTW_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ntw/bioconductor-ntw_1.60.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mvtnorm" ;
    schema:identifier biotools:ntw ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ntw" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/NTW.html" .

