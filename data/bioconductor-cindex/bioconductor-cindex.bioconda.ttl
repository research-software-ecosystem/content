@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cindex a schema1:SoftwareApplication ;
    schema1:alternateName "Chromosome Instability Index" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The CINdex package addresses important area of high-throughput genomic analysis. It allows the automated processing and analysis of the experimental DNA copy number data generated by Affymetrix SNP 6.0 arrays or similar high throughput technologies. It calculates the chromosome instability (CIN) index that allows to quantitatively characterize genome-wide DNA copy number alterations as a measure of chromosomal instability. This package calculates not only overall genomic instability, but also instability in terms of copy number gains and losses separately at the chromosome and cytoband level." ;
    schema1:identifier biotools:cindex ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-cindex" ;
    schema1:softwareVersion "1.34.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/CINdex.html" .

