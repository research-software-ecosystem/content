@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cindex a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Chromosome Instability Index" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CINdex_1.34.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/CINdex/CINdex_1.34.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/CINdex_1.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cindex/bioconductor-cindex_1.34.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base",
        "r-bitops",
        "r-dplyr",
        "r-gplots",
        "r-gridextra",
        "r-png",
        "r-som",
        "r-stringr" ;
    schema:identifier biotools:cindex ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-cindex" ;
    schema:softwareVersion "1.34.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/CINdex.html" .

