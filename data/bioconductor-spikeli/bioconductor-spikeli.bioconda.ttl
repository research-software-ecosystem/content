@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-spikeli a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Affymetrix Spike-in Langmuir Isotherm Data Analysis Tool" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/spikeLI_2.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/spikeLI/spikeLI_2.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/spikeLI_2.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-spikeli/bioconductor-spikeli_2.70.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:spikeli ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-spikeli" ;
    schema:softwareVersion "2.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/spikeLI.html" .

