@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bicare a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Biclustering Analysis and Results Exploration" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BicARE_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BicARE/BicARE_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BicARE_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bicare/bioconductor-bicare_1.68.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-go.db",
        "bioconductor-gseabase",
        "bioconductor-multtest",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:bicare ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-bicare" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BicARE.html" .

