@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bicare a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Biclustering Analysis and Results Exploration" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BicARE_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BicARE/BicARE_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BicARE_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bicare/bioconductor-bicare_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-go.db",
        "bioconductor-gseabase",
        "bioconductor-multtest",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:bicare ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-bicare" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BicARE.html" .

