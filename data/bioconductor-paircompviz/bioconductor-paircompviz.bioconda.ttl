@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-paircompviz a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Multiple comparison test visualization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/paircompviz_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/paircompviz/paircompviz_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/paircompviz_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-paircompviz/bioconductor-paircompviz_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rgraphviz",
        "r-base" ;
    schema:identifier biotools:paircompviz ;
    schema:license "GPL (>=3.0)" ;
    schema:name "bioconductor-paircompviz" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/paircompviz.html" .

