@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:velvet a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.074492.107" ;
    schema:description "Sequence Assembler for short reads." ;
    schema:downloadUrl "https://github.com/dzerbino/velvet/archive/refs/tags/v1.2.10.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:velvet ;
    schema:license "GPL-2.0-only" ;
    schema:name "velvet" ;
    schema:softwareHelp "https://github.com/dzerbino/velvet/blob/master/Manual.pdf" ;
    schema:softwareVersion "1.2.10" ;
    schema:url "https://github.com/dzerbino/velvet" .

