@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-helloranges a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Introduce *Ranges to bedtools users" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HelloRanges_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HelloRanges/HelloRanges_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HelloRanges_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-helloranges/bioconductor-helloranges_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocio",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "r-base",
        "r-docopt" ;
    schema1:identifier biotools:helloranges ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-helloranges" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HelloRanges.html" .

