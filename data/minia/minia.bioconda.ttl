@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:minia a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1748-7188-8-22" ;
    schema:description "Minia is a short-read assembler based on a de Bruijn graph, capable of assembling a human genome on a desktop computer in a day." ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:minia ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "minia" ;
    schema:softwareHelp "https://gatb.inria.fr/software/minia" ;
    schema:softwareVersion "3.2.6" ;
    schema:url "https://github.com/GATB/minia" .

