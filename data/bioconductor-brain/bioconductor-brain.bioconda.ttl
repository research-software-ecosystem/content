@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-brain a schema1:SoftwareApplication ;
    schema1:alternateName "Baffling Recursive Algorithm for Isotope distributioN calculations" ;
    schema1:citation "doi:10.1021/ac303439m" ;
    schema1:description "Package for calculating aggregated isotopic distribution and exact center-masses for chemical substances (in this version composed of C, H, N, O and S). This is an implementation of the BRAIN algorithm described in the paper by J. Claesen, P. Dittwald, T. Burzykowski and D. Valkenborg." ;
    schema1:identifier <https://bio.tools/biotools:brain> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-brain" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BRAIN.html" .

