@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:snipit a schema1:SoftwareApplication ;
    bioschemas:output "csv",
        "png" ;
    schema1:applicationSubCategory edam:topic_0781 ;
    schema1:codeRepository <https://github.com/aineniamh/snipit> ;
    schema1:dateCreated "2022-07-17" ;
    schema1:description "Summarise snps relative to a reference sequence" ;
    schema1:encodingFormat "csv",
        "png" ;
    schema1:featureList edam:operation_0287 ;
    schema1:identifier biotools:snipit,
        bioconda:snipit ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=4db391b405f2ed38>,
        <https://usegalaxy.eu/published/workflow?id=a15dabcadb63b46d>,
        <https://usegalaxy.eu/published/workflow?id=c789ab71876c6ead>,
        <https://usegalaxy.eu/published/workflow?id=cd25f70f71683ab6>,
        <https://usegalaxy.eu/published/workflow?id=e353c6a106fa9e4c>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org/published/workflow?id=1518c8c50747a1c1>,
        <https://usegalaxy.org/published/workflow?id=97263f3308077ff0>,
        <https://usegalaxy.org/published/workflow?id=f7d9656f4cb77079>,
        <https://workflowhub.eu/workflows/1260?version=3> ;
    schema1:keywords "Sequence Analysis",
        "Variant Analysis" ;
    schema1:name "snipit" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/snipit> .

