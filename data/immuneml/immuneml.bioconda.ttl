@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:immuneml a schema:SoftwareApplication ;
    schema:author "knutwa-ext",
        "pavelvazquez",
        "pavlovicmilena" ;
    schema:citation "doi:10.1038/s42256-021-00413-z" ;
    schema:description "immuneML is a software platform for machine learning analysis of immune receptor repertoires." ;
    schema:downloadUrl "https://pypi.org/packages/source/i/immuneml/immuneml-3.0.27.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:immuneml ;
    schema:license "APGL-3.0-only" ;
    schema:maintainer "knutwa-ext",
        "pavelvazquez",
        "pavlovicmilena" ;
    schema:name "immuneml" ;
    schema:softwareHelp "https://docs.immuneml.uio.no" ;
    schema:softwareVersion "3.0.27" ;
    schema:url "https://github.com/uio-bmi/immuneML" .

