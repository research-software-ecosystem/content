@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cispath a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1752-0509-9-s1-s1" ;
    schema:description "Visualization and management of the protein-protein interaction networks." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cisPath_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/cisPath/cisPath_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/cisPath_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cispath/bioconductor-cispath_1.46.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:cispath ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-cispath" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/cisPath.html" .

