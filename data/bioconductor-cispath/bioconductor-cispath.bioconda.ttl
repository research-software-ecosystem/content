@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cispath a schema1:SoftwareApplication ;
    schema1:alternateName "Visualization and management of the protein-protein interaction networks." ;
    schema1:citation "doi:10.1186/1752-0509-9-s1-s1" ;
    schema1:description "cisPath is an R package that uses web browsers to visualize and manage protein-protein interaction networks." ;
    schema1:identifier <https://bio.tools/biotools:cispath> ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-cispath" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/cisPath.html" .

