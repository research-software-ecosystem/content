galaxytool:ribowaltz a schema1:SoftwareApplication ;
    bioschemas:output "rdata",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_3307 ;
    schema1:codeRepository <https://github.com/LabTranslationalArchitectomics/riboWaltz> ;
    schema1:dateCreated "2022-09-22" ;
    schema1:description "Calculation of optimal P-site offsets, diagnostic analysis and visual inspection of ribosome profiling data" ;
    schema1:encodingFormat "rdata",
        "tabular" ;
    schema1:identifier biotools:riboWaltz,
        bioconda:ribowaltz ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    schema1:keywords "RNA",
        "Transcriptomics" ;
    schema1:name "ribowaltz" ;
    schema1:softwareVersion "1.2.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/ribowaltz> .

