@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metabuli a schema:SoftwareApplication ;
    schema:author "jaebeom-kim",
        "milot-mirdita" ;
    schema:citation "doi:10.1038/s41592-024-02273-y" ;
    schema:description "Metabuli: specific and sensitive metagenomic classification via joint analysis of DNA and amino acid." ;
    schema:hasPart "bzip2",
        "gawk",
        "libgomp",
        "llvm-openmp",
        "perl",
        "zlib" ;
    schema:identifier biotools:metabuli ;
    schema:license "GPLv3" ;
    schema:maintainer "jaebeom-kim",
        "milot-mirdita" ;
    schema:name "metabuli" ;
    schema:softwareVersion "1.2.0" ;
    schema:url "https://github.com/steineggerlab/Metabuli" .

