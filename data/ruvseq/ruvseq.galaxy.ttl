@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:ruvseq a schema1:SoftwareApplication ;
    bioschemas:output "pdf" ;
    schema1:applicationSubCategory edam:topic_0203 ;
    schema1:codeRepository <https://www.bioconductor.org/packages/release/bioc/html/DESeq2.html> ;
    schema1:dateCreated "2018-08-30" ;
    schema1:description "Remove Unwanted Variation from RNA-Seq Data" ;
    schema1:encodingFormat "pdf" ;
    schema1:featureList edam:operation_3742 ;
    schema1:identifier biotools:ruvseq,
        bioconda:bioconductor-ruvseq ;
    schema1:isPartOf <https://mississippi.sorbonne-universite.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org> ;
    schema1:keywords "RNA",
        "Statistics",
        "Transcriptomics" ;
    schema1:name "ruvseq" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@WRAPPER_VERSION@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/ruvseq> .

<https://mississippi.sorbonne-universite.fr> a schema1:WebSite .

