@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gothic a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1101/gr.185272.114" ;
    schema1:description "Binomial test for Hi-C data analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GOTHiC_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GOTHiC/GOTHiC_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GOTHiC_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gothic/bioconductor-gothic_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-shortread",
        "r-base",
        "r-biocmanager",
        "r-data.table",
        "r-ggplot2" ;
    schema1:identifier biotools:gothic ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-gothic" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GOTHiC.html" .

