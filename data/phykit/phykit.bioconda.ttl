@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:phykit a schema1:SoftwareApplication ;
    schema1:alternateName "PhyKIT is a UNIX shell toolkit for processing and analyzing phylogenomic data." ;
    schema1:citation "doi:10.1093/bioinformatics/btab096" ;
    schema1:description "PhyKIT is a UNIX shell toolkit for processing and analyzing phylogenomic data." ;
    schema1:downloadUrl "https://pypi.io/packages/source/p/phykit/phykit-2.1.94.tar.gz" ;
    schema1:identifier "biotools:phykit" ;
    schema1:license "MIT" ;
    schema1:maintainer "pauldg" ;
    schema1:name "phykit" ;
    schema1:softwareVersion "2.1.94" ;
    schema1:url "https://github.com/jlsteenwyk/phykit" .

