@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phykit a schema:SoftwareApplication ;
    schema:author "pauldg" ;
    schema:citation "doi:10.1093/bioinformatics/btab096" ;
    schema:description "PhyKIT is a UNIX shell toolkit for processing and analyzing phylogenomic data." ;
    schema:downloadUrl "https://pypi.io/packages/source/p/phykit/phykit-2.1.94.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:phykit ;
    schema:license "MIT" ;
    schema:maintainer "pauldg" ;
    schema:name "phykit" ;
    schema:softwareHelp "https://jlsteenwyk.com/PhyKIT" ;
    schema:softwareVersion "2.1.94" ;
    schema:url "https://github.com/jlsteenwyk/phykit" .

