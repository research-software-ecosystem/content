@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rcas a schema:SoftwareApplication ;
    schema:description "RNA Centric Annotation System" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RCAS_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RCAS/RCAS_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RCAS_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rcas/bioconductor-rcas_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-bsgenome.hsapiens.ucsc.hg19",
        "bioconductor-genomation",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqlogo",
        "bioconductor-txdbmaker",
        "pandoc",
        "r-base",
        "r-cowplot",
        "r-data.table",
        "r-dt",
        "r-ggplot2",
        "r-gprofiler2",
        "r-knitr",
        "r-pbapply",
        "r-pheatmap",
        "r-plotly",
        "r-plotrix",
        "r-proxy",
        "r-ranger",
        "r-rmarkdown",
        "r-rsqlite" ;
    schema:identifier biotools:rcas ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-rcas" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RCAS.html" .

