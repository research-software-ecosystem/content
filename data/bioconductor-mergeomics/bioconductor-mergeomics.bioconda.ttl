@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mergeomics a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/036012" ;
    schema:description "Integrative network analysis of omics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Mergeomics_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Mergeomics/Mergeomics_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Mergeomics_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mergeomics/bioconductor-mergeomics_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:mergeomics ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-mergeomics" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Mergeomics.html" .

