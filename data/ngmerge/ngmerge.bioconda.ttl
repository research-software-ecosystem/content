@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ngmerge a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-018-2579-2" ;
    schema:description "Merging paired-end reads and removing sequencing adapters." ;
    schema:downloadUrl "https://github.com/jsh58/NGmerge/archive/v0.5.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "openmpi",
        "zlib" ;
    schema:identifier biotools:ngmerge ;
    schema:license "MIT" ;
    schema:name "ngmerge" ;
    schema:softwareHelp "https://github.com/jsh58/NGmerge/blob/v0.5/README.md" ;
    schema:softwareVersion "0.5" ;
    schema:url "https://github.com/jsh58/NGmerge" .

