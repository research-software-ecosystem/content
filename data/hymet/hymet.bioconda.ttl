@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hymet a schema:SoftwareApplication ;
    schema:author "inesbmartins02",
        "jorgeMFS" ;
    schema:description "HYMET provides hybrid Mash+minimap2 metagenomic classification with benchmark and case-study tooling." ;
    schema:downloadUrl "https://github.com/ieeta-pt/HYMET/archive/refs/tags/v1.3.0.tar.gz" ;
    schema:identifier biotools:hymet ;
    schema:license "MIT" ;
    schema:maintainer "inesbmartins02",
        "jorgeMFS" ;
    schema:name "hymet" ;
    schema:softwareHelp "https://github.com/ieeta-pt/HYMET" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "https://github.com/ieeta-pt/HYMET" .

