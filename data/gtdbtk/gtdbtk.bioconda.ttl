@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gtdbtk a schema:SoftwareApplication ;
    schema:author "aaronmussig",
        "pchaumeil" ;
    schema:citation "doi:10.1093/bioinformatics/btz848" ;
    schema:description "A toolkit for assigning objective taxonomic classifications to bacterial and archaeal genomes." ;
    schema:downloadUrl "https://pypi.org/packages/source/g/gtdbtk/gtdbtk-2.7.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:GTDB-Tk ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "aaronmussig",
        "pchaumeil" ;
    schema:name "gtdbtk" ;
    schema:softwareHelp "https://ecogenomics.github.io/GTDBTk" ;
    schema:softwareVersion "2.7.2" ;
    schema:url "https://github.com/Ecogenomics/GTDBTk" .

