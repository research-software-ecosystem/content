@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:gtdbtk a schema1:SoftwareApplication ;
    schema1:alternateName "A toolkit for assigning objective taxonomic classifications to bacterial and archaeal genomes." ;
    schema1:citation "doi:10.1093/bioinformatics/btz848" ;
    schema1:description "A toolkit for assigning objective taxonomic classifications to bacterial and archaeal genomes." ;
    schema1:downloadUrl "https://pypi.org/packages/source/g/gtdbtk/gtdbtk-2.7.2.tar.gz" ;
    schema1:identifier "biotools:GTDB-Tk",
        "usegalaxy-eu:gtdbtk_classify_wf" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "aaronmussig",
        "pchaumeil" ;
    schema1:name "gtdbtk" ;
    schema1:softwareVersion "2.7.2" ;
    schema1:url "https://github.com/Ecogenomics/GTDBTk" .

