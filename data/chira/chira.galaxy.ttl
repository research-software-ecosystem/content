@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:chira a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "fasta",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0099,
        edam:topic_0602,
        edam:topic_0659 ;
    schema1:codeRepository "https://github.com/pavanvidem/chira" ;
    schema1:dateCreated "2020-01-19" ;
    schema1:description "Chimeric Read Annotator for RNA-RNA interactome data" ;
    schema1:encodingFormat "bed",
        "fasta",
        "tabular" ;
    schema1:identifier biotools:chira,
        bioconda:chira ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=25a209bda998412f>,
        <https://usegalaxy.eu/published/workflow?id=26c4882e320ed7b3>,
        <https://usegalaxy.eu/published/workflow?id=66834f10c86362b9>,
        <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1681?version=1>,
        <https://workflowhub.eu/workflows/66?version=1>,
        <https://workflowhub.eu/workflows/67?version=1> ;
    schema1:keywords "RNA",
        "Sequence Analysis",
        "Transcriptomics" ;
    schema1:name "chira" ;
    schema1:softwareVersion "1.4.3" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/chira" .

<https://usegalaxy.eu> a schema1:WebSite .

