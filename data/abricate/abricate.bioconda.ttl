@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:abricate a schema:SoftwareApplication ;
    schema:description "Mass screening of contigs for antibiotic resistance genes" ;
    schema:downloadUrl "https://github.com/tseemann/abricate/archive/v1.4.0.tar.gz" ;
    schema:hasPart "any2fasta",
        "blast",
        "perl-bioperl",
        "perl-json",
        "perl-libwww-perl",
        "perl-list-moreutils",
        "perl-path-tiny",
        "unzip",
        "zlib" ;
    schema:identifier biotools:ABRicate ;
    schema:license "GPL-2.0-only" ;
    schema:name "abricate" ;
    schema:softwareVersion "1.4.0" ;
    schema:url "https://github.com/tseemann/abricate" .

