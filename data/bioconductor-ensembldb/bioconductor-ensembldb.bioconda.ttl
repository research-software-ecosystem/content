@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ensembldb a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Utilities to create and use Ensembl-based annotation databases" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ensembldb_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ensembldb/ensembldb_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ensembldb_2.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ensembldb/bioconductor-ensembldb_2.34.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-annotationfilter",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-protgenerics",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-curl",
        "r-dbi",
        "r-rsqlite" ;
    schema:identifier biotools:ensembldb ;
    schema:license "LGPL" ;
    schema:name "bioconductor-ensembldb" ;
    schema:softwareVersion "2.34.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ensembldb.html" .

