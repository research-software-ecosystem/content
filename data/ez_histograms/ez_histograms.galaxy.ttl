@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:ez_histograms a schema1:SoftwareApplication ;
    bioschemas:output "pdf",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0610 ;
    schema1:codeRepository <https://github.com/tidyverse/ggplot2> ;
    schema1:dateCreated "2024-02-07" ;
    schema1:description "ggplot2 histograms and density plots" ;
    schema1:encodingFormat "pdf",
        "tabular" ;
    schema1:featureList edam:operation_0337,
        edam:operation_2238,
        edam:operation_2945 ;
    schema1:identifier biotools:ez_histograms,
        bioconda:r-ggplot2 ;
    schema1:isPartOf <https://mississippi.sorbonne-universite.fr> ;
    schema1:keywords "Statistics",
        "Visualization" ;
    schema1:name "ez_histograms" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/artbio/tools-artbio/tree/main/tools/ez_histograms> .

<https://mississippi.sorbonne-universite.fr> a schema1:WebSite .

