@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgreat a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "GREAT Analysis - Functional Enrichment on Genomic Regions" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rGREAT_2.12.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rGREAT/rGREAT_2.12.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rGREAT_2.12.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgreat/bioconductor-rgreat_2.12.2_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-go.db",
        "bioconductor-iranges",
        "bioconductor-org.hs.eg.db",
        "bioconductor-s4vectors",
        "bioconductor-txdb.hsapiens.ucsc.hg19.knowngene",
        "bioconductor-txdb.hsapiens.ucsc.hg38.knowngene",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-circlize",
        "r-digest",
        "r-doparallel",
        "r-dt",
        "r-foreach",
        "r-getoptlong",
        "r-globaloptions",
        "r-progress",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rcurl",
        "r-rjson",
        "r-shiny",
        "zlib" ;
    schema1:identifier biotools:rgreat ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-rgreat" ;
    schema1:softwareVersion "2.12.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rGREAT.html" .

