@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-goseq a schema:SoftwareApplication ;
    schema:description "Gene Ontology analyser for RNA-seq and other length biased data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/goseq_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/goseq/goseq_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/goseq_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-goseq/bioconductor-goseq_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-genelendatabase",
        "bioconductor-genomicfeatures",
        "bioconductor-go.db",
        "bioconductor-rtracklayer",
        "bioconductor-seqinfo",
        "r-base",
        "r-biasedurn",
        "r-mgcv" ;
    schema:identifier biotools:goseq ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-goseq" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/goseq.html" .

