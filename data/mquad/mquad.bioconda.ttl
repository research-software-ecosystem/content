@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mquad a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-022-28845-0" ;
    schema:description "MQuad: Mixture Model for Mitochondrial Mutation detection in single-cell omics data." ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:mquad ;
    schema:license "Apache-2.0" ;
    schema:name "mquad" ;
    schema:softwareHelp "https://github.com/single-cell-genetics/MQuad/blob/main/README.rst" ;
    schema:softwareVersion "0.1.8b" ;
    schema:url "https://github.com/aaronkwc/MQuad" .

