@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hicexplorer a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/gigascience/giac061",
        "doi:10.1093/nar/gkaa220",
        "doi:10.1093/nar/gky504" ;
    schema:description "Set of programs to process, analyze and visualize Hi-C and capture Hi-C data" ;
    schema:downloadUrl "https://github.com/deeptools/HiCExplorer/archive/3.7.6.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:hicexplorer ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "hicexplorer" ;
    schema:softwareHelp "https://hicexplorer.readthedocs.org/" ;
    schema:softwareVersion "3.7.6" ;
    schema:url "https://github.com/deeptools/HiCExplorer" .

