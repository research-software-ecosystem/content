@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:percolator a schema1:SoftwareApplication ;
    schema1:alternateName "Semi-supervised learning for peptide identification from shotgun proteomics datasets." ;
    schema1:citation "doi:10.1007/s13361-016-1460-7" ;
    schema1:description "Semi-supervised learning for peptide identification from shotgun proteomics datasets." ;
    schema1:identifier <https://bio.tools/biotools:Percolator>,
        "usegalaxy-eu:percolator" ;
    schema1:license "Apache-2.0" ;
    schema1:name "percolator" ;
    schema1:softwareVersion "3.9" ;
    schema1:url "https://github.com/percolator/percolator" .

