@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:percolator a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/s13361-016-1460-7" ;
    schema:description "Semi-supervised learning for peptide identification from shotgun proteomics datasets." ;
    schema:downloadUrl "https://github.com/percolator/percolator/archive/refs/tags/rel-3-09.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "sqlite",
        "zlib" ;
    schema:identifier biotools:Percolator ;
    schema:license "Apache-2.0" ;
    schema:name "percolator" ;
    schema:softwareHelp "http://percolator.ms" ;
    schema:softwareVersion "3.9" ;
    schema:url "https://github.com/percolator/percolator" .

