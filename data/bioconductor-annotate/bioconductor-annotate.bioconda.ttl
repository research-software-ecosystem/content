@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annotate a schema1:SoftwareApplication ;
    schema1:alternateName "Annotation for microarrays" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Using R enviroments for annotation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/annotate_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annotate/annotate_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annotate_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotate/bioconductor-annotate_1.88.0_src_all.tar.gz" ;
    schema1:identifier "biotools:annotate" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-annotate" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/annotate.html" .

