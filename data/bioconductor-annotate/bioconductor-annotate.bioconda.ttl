@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annotate a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Annotation for microarrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/annotate_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annotate/annotate_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annotate_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotate/bioconductor-annotate_1.88.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "r-base",
        "r-dbi",
        "r-httr",
        "r-xml",
        "r-xtable" ;
    schema:identifier biotools:annotate ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-annotate" ;
    schema:softwareVersion "1.88.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/annotate.html" .

