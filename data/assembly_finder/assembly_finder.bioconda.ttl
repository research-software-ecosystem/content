@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:assembly_finder a schema1:SoftwareApplication ;
    schema1:alternateName "Snakemake-powered cli pipeline to download genomes with NCBI datasets" ;
    schema1:description "Snakemake-powered cli pipeline to download genomes with NCBI datasets" ;
    schema1:identifier <https://bio.tools/biotools:assembly_finder> ;
    schema1:license "MIT" ;
    schema1:maintainer "farchaab",
        "tpillone" ;
    schema1:name "assembly_finder" ;
    schema1:softwareVersion "0.9.0" ;
    schema1:url "https://github.com/metagenlab/assembly_finder" .

