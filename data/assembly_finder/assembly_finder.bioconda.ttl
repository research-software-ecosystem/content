@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:assembly_finder a schema:SoftwareApplication ;
    schema:author "farchaab",
        "tpillone" ;
    schema:description "Snakemake-powered cli pipeline to download genomes with NCBI datasets" ;
    schema:downloadUrl "https://github.com/metagenlab/assembly_finder/archive/refs/tags/v0.9.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:assembly_finder ;
    schema:license "MIT" ;
    schema:maintainer "farchaab",
        "tpillone" ;
    schema:name "assembly_finder" ;
    schema:softwareHelp "https://metagenlab.github.io/assembly_finder" ;
    schema:softwareVersion "0.9.0" ;
    schema:url "https://github.com/metagenlab/assembly_finder" .

