@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-beat a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "BEAT - BS-Seq Epimutation Analysis Toolkit" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BEAT_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BEAT/BEAT_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BEAT_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beat/bioconductor-beat_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-shortread",
        "r-base" ;
    schema:identifier biotools:beat ;
    schema:license "LGPL (>= 3.0)" ;
    schema:name "bioconductor-beat" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BEAT.html" .

