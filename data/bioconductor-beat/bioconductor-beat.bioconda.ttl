@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-beat a schema1:SoftwareApplication ;
    schema1:alternateName "BEAT - BS-Seq Epimutation Analysis Toolkit" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Model-based analysis of single-cell methylation data" ;
    schema1:identifier <https://bio.tools/biotools:beat> ;
    schema1:license "LGPL (>= 3.0)" ;
    schema1:name "bioconductor-beat" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BEAT.html" .

