@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cas-offinder a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu048" ;
    schema:description "Cas-OFFinder is OpenCL based, ultrafast and versatile program that searches for potential off-target sites of CRISPR/Cas-derived RNA-guided endonucleases (RGEN)." ;
    schema:downloadUrl "https://github.com/snugel/cas-offinder/archive/refs/tags/2.4.1.tar.gz" ;
    schema:hasPart "libgomp",
        "libopencl-devel",
        "llvm-openmp",
        "opencl-headers" ;
    schema:identifier biotools:cas-offinder ;
    schema:license "BSD-3-Clause" ;
    schema:name "cas-offinder" ;
    schema:softwareHelp "https://github.com/snugel/cas-offinder/blob/2.4.1/README.md" ;
    schema:softwareVersion "2.4.1" ;
    schema:url "https://github.com/snugel/cas-offinder" .

