@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-systempiper a schema:SoftwareApplication ;
    schema:description "systemPipeR: Workflow Environment for Data Analysis and Report Generation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/systemPipeR_2.16.3.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/systemPipeR/systemPipeR_2.16.3.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/systemPipeR_2.16.3.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-systempiper/bioconductor-systempiper_2.16.3_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-shortread",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-crayon",
        "r-ggplot2",
        "r-htmlwidgets",
        "r-magrittr",
        "r-stringr",
        "r-yaml" ;
    schema:identifier biotools:systempiper ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-systempiper" ;
    schema:softwareVersion "2.16.3" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/systemPipeR.html" .

