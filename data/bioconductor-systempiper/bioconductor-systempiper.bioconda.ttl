@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-systempiper a schema1:SoftwareApplication ;
    schema1:alternateName "systemPipeR: Workflow Environment for Data Analysis and Report Generation" ;
    schema1:description "systemPipeR is a multipurpose data analysis workflow environment that unifies R with command-line tools. It enables scientists to analyze many types of large- or small-scale data on local or distributed computer systems with a high level of reproducibility, scalability and portability. At its core is a command-line interface (CLI) that adopts the Common Workflow Language (CWL). This design allows users to choose for each analysis step the optimal R or command-line software. It supports both end-to-end and partial execution of workflows with built-in restart functionalities. Efficient management of complex analysis tasks is accomplished by a flexible workflow control container class. Handling of large numbers of input samples and experimental designs is facilitated by consistent sample annotation mechanisms. As a multi-purpose workflow toolkit, systemPipeR enables users to run existing workflows, customize them or design entirely new ones while taking advantage of widely adopted data structures within the Bioconductor ecosystem. Another important core functionality is the generation of reproducible scientific analysis and technical reports. For result interpretation, systemPipeR offers a wide range of plotting functionality, while an associated Shiny App offers many useful functionalities for interactive result exploration. The vignettes linked from this page include (1) a general introduction, (2) a description of technical details, and (3) a collection of workflow templates." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/systemPipeR_2.16.3.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/systemPipeR/systemPipeR_2.16.3.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/systemPipeR_2.16.3.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-systempiper/bioconductor-systempiper_2.16.3_src_all.tar.gz" ;
    schema1:identifier "biotools:systempiper" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-systempiper" ;
    schema1:softwareVersion "2.16.3" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/systemPipeR.html" .

