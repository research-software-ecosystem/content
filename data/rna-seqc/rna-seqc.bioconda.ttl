@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rna-seqc a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btab135" ;
    schema:description "Fast, efficient RNA-Seq metrics for quality control and process optimization." ;
    schema:downloadUrl "https://github.com/broadinstitute/rnaseqc/releases/download/v2.4.2/rnaseqc.v2.4.2.full_source.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "curl",
        "xz",
        "zlib" ;
    schema:identifier biotools:rna-seqc ;
    schema:license "BSD-3-Clause" ;
    schema:name "rna-seqc" ;
    schema:softwareHelp "https://github.com/getzlab/rnaseqc/blob/v2.4.2/README.md" ;
    schema:softwareVersion "2.4.2" ;
    schema:url "https://github.com/broadinstitute/rnaseqc" .

