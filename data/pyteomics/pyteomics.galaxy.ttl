@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:pyteomics a schema1:SoftwareApplication ;
    schema1:applicationSubCategory edam:topic_0121,
        edam:topic_3520 ;
    schema1:codeRepository <https://pyteomics.readthedocs.io/en/latest/> ;
    schema1:dateCreated "2021-01-15" ;
    schema1:description "Tools using the pyteomics library" ;
    schema1:featureList edam:operation_3767 ;
    schema1:identifier biotools:pyteomics,
        bioconda:pyteomics ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    schema1:keywords "Metabolomics",
        "Proteomics" ;
    schema1:name "pyteomics" ;
    schema1:softwareVersion "@TOOL_VERSION@" ;
    schema1:url <https://github.com/galaxyproteomics/tools-galaxyp/tree/master/tools/pyteomics> .

<https://usegalaxy.cz> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

