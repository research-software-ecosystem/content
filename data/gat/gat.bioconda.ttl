@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gat a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt343" ;
    schema:description "Genomic Association Tester" ;
    schema:downloadUrl "https://pypi.io/packages/source/g/gat/gat-1.3.6.tar.gz" ;
    schema:hasPart "cython",
        "matplotlib-base",
        "numpy",
        "python",
        "scipy",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:gat ;
    schema:license "MIT" ;
    schema:name "gat" ;
    schema:softwareVersion "1.3.6" ;
    schema:url "https://github.com/AndreasHeger/gat" .

