@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-deseq2 a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1186/s13059-014-0550-8" ;
    schema1:description "Differential gene expression analysis based on the negative binomial distribution" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DESeq2_1.50.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DESeq2/DESeq2_1.50.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DESeq2_1.50.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-deseq2/bioconductor-deseq2_1.50.2_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ggplot2",
        "r-locfit",
        "r-matrixstats",
        "r-rcpp",
        "r-rcpparmadillo",
        "zlib" ;
    schema1:identifier biotools:deseq2 ;
    schema1:license "LGPL (>= 3)" ;
    schema1:name "bioconductor-deseq2" ;
    schema1:softwareVersion "1.50.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DESeq2.html" .

