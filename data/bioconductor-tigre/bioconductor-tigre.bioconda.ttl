@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-tigre a schema1:SoftwareApplication ;
    schema1:description "Transcription factor Inference through Gaussian process Reconstruction of Expression" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/tigre_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/tigre/tigre_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/tigre_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tigre/bioconductor-tigre_1.64.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dbi",
        "r-gplots",
        "r-rsqlite",
        "zlib" ;
    schema1:identifier biotools:tigre ;
    schema1:license "AGPL-3" ;
    schema1:name "bioconductor-tigre" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/tigre.html" .

