@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-omicade4 a schema:SoftwareApplication ;
    schema:description "Multiple co-inertia analysis of omics datasets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/omicade4_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/omicade4/omicade4_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/omicade4_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-omicade4/bioconductor-omicade4_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-made4",
        "r-ade4",
        "r-base" ;
    schema:identifier biotools:omicade4 ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-omicade4" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/omicade4.html" .

