@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-omicade4 a schema1:SoftwareApplication ;
    schema1:alternateName "Multiple co-inertia analysis of omics datasets" ;
    schema1:description "This package performes multiple co-inertia analysis of omics datasets." ;
    schema1:identifier <https://bio.tools/biotools:omicade4> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-omicade4" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/omicade4.html" .

