@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-omicade4 a schema1:SoftwareApplication ;
    schema1:alternateName "Multiple co-inertia analysis of omics datasets" ;
    schema1:description "This package performes multiple co-inertia analysis of omics datasets." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/omicade4_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/omicade4/omicade4_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/omicade4_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-omicade4/bioconductor-omicade4_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:omicade4" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-omicade4" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/omicade4.html" .

