@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-tscan a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/nar/gkw430" ;
    schema1:description "Tools for Single-Cell Analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/TSCAN_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TSCAN/TSCAN_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TSCAN_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tscan/bioconductor-tscan_1.48.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-delayedarray",
        "bioconductor-s4vectors",
        "bioconductor-singlecellexperiment",
        "bioconductor-sparsearray",
        "bioconductor-summarizedexperiment",
        "bioconductor-trajectoryutils",
        "r-base",
        "r-combinat",
        "r-fastica",
        "r-ggplot2",
        "r-gplots",
        "r-igraph",
        "r-matrix",
        "r-mclust",
        "r-mgcv",
        "r-plyr",
        "r-shiny" ;
    schema1:identifier biotools:tscan ;
    schema1:license "GPL(>=2)" ;
    schema1:name "bioconductor-tscan" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/TSCAN.html" .

