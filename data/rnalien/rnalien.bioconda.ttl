@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnalien a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkw558" ;
    schema:description "A tool for unsupervised construction of RNA family models" ;
    schema:downloadUrl "https://github.com/eggzilla/RNAlien/releases/download/1.8.0/RNAlien.tar.gz" ;
    schema:identifier biotools:RNAlien ;
    schema:license "GPL-3" ;
    schema:name "rnalien" ;
    schema:softwareVersion "1.8.0" ;
    schema:url "http://rna.tbi.univie.ac.at/rnalien/tool" .

