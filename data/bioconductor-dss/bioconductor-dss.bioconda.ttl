@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dss a schema1:SoftwareApplication ;
    schema1:alternateName "Dispersion shrinkage for sequencing data" ;
    schema1:description "DSS is an R library performing differntial analysis for count-based sequencing data. It detectes differentially expressed genes (DEGs) from RNA-seq, and differentially methylated loci or regions (DML/DMRs) from bisulfite sequencing (BS-seq). The core of DSS is a new dispersion shrinkage method for estimating the dispersion parameter from Gamma-Poisson or Beta-Binomial distributions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DSS_2.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DSS/DSS_2.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DSS_2.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dss/bioconductor-dss_2.58.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dss" ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-dss" ;
    schema1:softwareVersion "2.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DSS.html" .

