@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dss a schema:SoftwareApplication ;
    schema:description "Dispersion shrinkage for sequencing data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DSS_2.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DSS/DSS_2.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DSS_2.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dss/bioconductor-dss_2.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocparallel",
        "bioconductor-bsseq",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:dss ;
    schema:license "GPL" ;
    schema:name "bioconductor-dss" ;
    schema:softwareVersion "2.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DSS.html" .

