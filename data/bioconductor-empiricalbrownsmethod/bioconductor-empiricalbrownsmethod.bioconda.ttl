@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-empiricalbrownsmethod a schema1:SoftwareApplication ;
    schema1:alternateName "Uses Brown's method to combine p-values from dependent tests" ;
    schema1:citation "doi:10.1093/bioinformatics/btw438" ;
    schema1:description "Combining P-values from multiple statistical tests is common in bioinformatics. However, this procedure is non-trivial for dependent P-values. This package implements an empirical adaptation of Brown’s Method (an extension of Fisher’s Method) for combining dependent P-values which is appropriate for highly correlated data sets found in high-throughput biological experiments." ;
    schema1:identifier biotools:empiricalbrownsmethod ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-empiricalbrownsmethod" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EmpiricalBrownsMethod.html" .

