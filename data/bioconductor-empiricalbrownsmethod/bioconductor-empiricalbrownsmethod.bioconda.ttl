@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-empiricalbrownsmethod a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw438" ;
    schema:description "Uses Brown's method to combine p-values from dependent tests" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EmpiricalBrownsMethod_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EmpiricalBrownsMethod/EmpiricalBrownsMethod_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EmpiricalBrownsMethod_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-empiricalbrownsmethod/bioconductor-empiricalbrownsmethod_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:empiricalbrownsmethod ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-empiricalbrownsmethod" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EmpiricalBrownsMethod.html" .

