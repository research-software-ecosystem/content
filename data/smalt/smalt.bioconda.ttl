@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:smalt a schema:SoftwareApplication ;
    schema:description "SMALT aligns DNA sequencing reads with a reference genome." ;
    schema:downloadUrl "https://sourceforge.net/projects/smalt/files/smalt-0.7.6.tar.gz" ;
    schema:hasPart "bambamc",
        "samtools",
        "wget",
        "zlib" ;
    schema:identifier biotools:smalt ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "smalt" ;
    schema:softwareHelp "https://www.sanger.ac.uk/tool/smalt" ;
    schema:softwareVersion "0.7.6" ;
    schema:url "https://www.sanger.ac.uk/tool/smalt" .

