@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:t-coffee a schema:SoftwareApplication ;
    schema:citation "doi:10.1006/jmbi.2000.4042" ;
    schema:description "A collection of tools for Multiple Alignments of DNA, RNA, Protein Sequence." ;
    schema:downloadUrl "https://s3.eu-central-1.amazonaws.com/tcoffee-packages/Archives/T-COFFEE_distribution_Version_13.46.2.7c9e712d.tar.gz" ;
    schema:hasPart "perl",
        "perl-xml-simple",
        "wget" ;
    schema:identifier biotools:tcoffee ;
    schema:license "GPL-2.0-only" ;
    schema:name "t-coffee" ;
    schema:softwareHelp "https://tcoffee.org/Projects/tcoffee/documentation/index.html" ;
    schema:softwareVersion "13.46.2.7c9e712d" ;
    schema:url "https://github.com/cbcrg/tcoffee" .

