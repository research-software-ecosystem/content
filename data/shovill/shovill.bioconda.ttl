@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:shovill a schema1:SoftwareApplication ;
    schema1:alternateName "Microbial assembly pipeline for Illumina paired-end reads" ;
    schema1:description "Microbial assembly pipeline for Illumina paired-end reads" ;
    schema1:identifier <https://bio.tools/biotools:shovill>,
        "usegalaxy-eu:shovill" ;
    schema1:license "GPL2" ;
    schema1:name "shovill" ;
    schema1:softwareVersion "1.4.2" ;
    schema1:url "https://github.com/tseemann/shovill" .

