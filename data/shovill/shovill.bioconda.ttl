@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:shovill a schema:SoftwareApplication ;
    schema:description "Microbial assembly pipeline for Illumina paired-end reads" ;
    schema:downloadUrl "https://github.com/tseemann/shovill/archive/v1.4.2.tar.gz" ;
    schema:identifier biotools:shovill ;
    schema:license "GPL2" ;
    schema:name "shovill" ;
    schema:softwareVersion "1.4.2" ;
    schema:url "https://github.com/tseemann/shovill" .

