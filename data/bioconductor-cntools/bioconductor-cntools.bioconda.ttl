@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cntools a schema1:SoftwareApplication ;
    schema1:alternateName "Convert segment data into a region by sample matrix to allow for other high level computational analyses." ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides tools to convert the output of segmentation analysis using DNAcopy to a matrix structure with overlapping segments as rows and samples as columns so that other computational analyses can be applied to segmented data" ;
    schema1:identifier biotools:cntools ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-cntools" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CNTools.html" .

