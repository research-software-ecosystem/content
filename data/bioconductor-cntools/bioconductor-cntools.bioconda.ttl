@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cntools a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Convert segment data into a region by sample matrix to allow for other high level computational analyses." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CNTools_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CNTools/CNTools_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CNTools_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cntools/bioconductor-cntools_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genefilter",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:cntools ;
    schema:license "LGPL" ;
    schema:name "bioconductor-cntools" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CNTools.html" .

