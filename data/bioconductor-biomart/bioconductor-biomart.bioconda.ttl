@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biomart a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nprot.2009.97" ;
    schema:description "Interface to BioMart databases (i.e. Ensembl)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/biomaRt_2.66.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/biomaRt/biomaRt_2.66.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/biomaRt_2.66.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biomart/bioconductor-biomart_2.66.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocfilecache",
        "r-base",
        "r-curl",
        "r-httr2",
        "r-progress",
        "r-stringr",
        "r-xml2" ;
    schema:identifier biotools:biomaRt ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-biomart" ;
    schema:softwareVersion "2.66.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/biomaRt.html" .

