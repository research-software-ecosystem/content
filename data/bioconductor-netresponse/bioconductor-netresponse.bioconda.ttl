@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-netresponse a schema:SoftwareApplication ;
    schema:description "Functional Network Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/netresponse_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/netresponse/netresponse_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/netresponse_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-netresponse/bioconductor-netresponse_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocstyle",
        "bioconductor-graph",
        "bioconductor-minet",
        "bioconductor-qvalue",
        "bioconductor-rgraphviz",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ggplot2",
        "r-igraph",
        "r-mclust",
        "r-plyr",
        "r-rcolorbrewer",
        "r-reshape2",
        "r-rmarkdown",
        "zlib" ;
    schema:identifier biotools:netresponse ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-netresponse" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/netresponse.html" .

