@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-netresponse a schema1:SoftwareApplication ;
    schema1:alternateName "Functional Network Analysis" ;
    schema1:description "Algorithms for functional network analysis. Includes an implementation of a variational Dirichlet process Gaussian mixture model for nonparametric mixture modeling." ;
    schema1:identifier biotools:netresponse ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-netresponse" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/netresponse.html" .

