@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-philr a schema:SoftwareApplication ;
    schema:description "Phylogenetic partitioning based ILR transform for metagenomics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/philr_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/philr/philr_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/philr_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-philr/bioconductor-philr_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-ggtree",
        "r-ape",
        "r-base",
        "r-ggplot2",
        "r-phangorn",
        "r-tidyr" ;
    schema:identifier biotools:philr ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-philr" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/philr.html" .

