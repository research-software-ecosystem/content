@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:vamb a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2024.10.25.620172" ;
    schema:description "Variational autoencoder for metagenomic binning." ;
    schema:downloadUrl "https://pypi.org/packages/source/v/vamb/vamb-5.0.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "setuptools-scm" ;
    schema:identifier biotools:vamb ;
    schema:license "MIT" ;
    schema:name "vamb" ;
    schema:softwareHelp "https://vamb.readthedocs.io/en/latest" ;
    schema:softwareVersion "5.0.4" ;
    schema:url "https://github.com/RasmussenLab/vamb" .

