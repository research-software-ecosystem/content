@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cogps a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "cancer outlier Gene Profile Sets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/coGPS_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/coGPS/coGPS_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/coGPS_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cogps/bioconductor-cogps_1.54.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:cogps ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-cogps" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/coGPS.html" .

