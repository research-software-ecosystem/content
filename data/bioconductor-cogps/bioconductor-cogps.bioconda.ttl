@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cogps a schema1:SoftwareApplication ;
    schema1:alternateName "cancer outlier Gene Profile Sets" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Gene Set Enrichment Analysis of P-value based statistics for outlier gene detection in dataset merged from multiple studies" ;
    schema1:identifier biotools:cogps ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-cogps" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/coGPS.html" .

