  "@graph": [
    {
      "@id": "https://bio.tools/picklet",
      "@type": "sc:SoftwareApplication",
      "biotools:primaryContact": "Fishka Bio",
      "bsc:input": {
        "@id": "_:Na1fba7a158f34bbda18f2bfd17a8c85b"
