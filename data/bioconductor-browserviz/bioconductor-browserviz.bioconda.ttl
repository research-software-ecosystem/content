@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-browserviz a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-4302-4426-4_17" ;
    schema:description "BrowserViz: interactive R/browser graphics using websockets and JSON" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BrowserViz_2.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BrowserViz/BrowserViz_2.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BrowserViz_2.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-browserviz/bioconductor-browserviz_2.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "r-base",
        "r-httpuv",
        "r-jsonlite" ;
    schema:identifier biotools:browserviz ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-browserviz" ;
    schema:softwareVersion "2.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BrowserViz.html" .

