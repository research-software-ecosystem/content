@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-refplus a schema1:SoftwareApplication ;
    schema1:alternateName "A function set for the Extrapolation Strategy (RMA+) and Extrapolation Averaging (RMA++) methods." ;
    schema1:citation "doi:10.1093/bioinformatics/btm357" ;
    schema1:description "The package contains functions for pre-processing Affymetrix data using the RMA+ and the RMA++ methods." ;
    schema1:identifier biotools:refplus ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-refplus" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/RefPlus.html" .

