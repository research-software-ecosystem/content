@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dcgsa a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Distance-correlation based Gene Set Analysis for longitudinal gene expression profiles" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/dcGSA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dcGSA/dcGSA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dcGSA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dcgsa/bioconductor-dcgsa_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocparallel",
        "r-base",
        "r-matrix" ;
    schema1:identifier biotools:dcgsa ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-dcgsa" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/dcGSA.html" .

