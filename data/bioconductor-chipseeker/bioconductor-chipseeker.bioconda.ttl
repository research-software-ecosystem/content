@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chipseeker a schema1:SoftwareApplication ;
    schema1:description "ChIPseeker for ChIP peak Annotation, Comparison, and Visualization" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ChIPseeker_1.46.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPseeker/ChIPseeker_1.46.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPseeker_1.46.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipseeker/bioconductor-chipseeker_1.46.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-enrichplot",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-txdb.hsapiens.ucsc.hg19.knowngene",
        "r-aplot",
        "r-base",
        "r-boot",
        "r-dplyr",
        "r-ggplot2",
        "r-gplots",
        "r-gtools",
        "r-magrittr",
        "r-plotrix",
        "r-rcolorbrewer",
        "r-rlang",
        "r-scales",
        "r-tibble",
        "r-yulab.utils" ;
    schema1:identifier biotools:chipseeker ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-chipseeker" ;
    schema1:softwareVersion "1.46.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPseeker.html" .

