@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:crispresso2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41587-019-0046-x" ;
    schema:description "A software pipeline designed to enable rapid and intuitive interpretation of genome editing experiments." ;
    schema:downloadUrl "https://github.com/pinellolab/CRISPResso2/archive/v2.3.4.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:crispresso2 ;
    schema:license "CC0-1.0" ;
    schema:name "crispresso2" ;
    schema:softwareHelp "https://docs.crispresso.com" ;
    schema:softwareVersion "2.3.4" ;
    schema:url "https://github.com/pinellolab/CRISPResso2" .

