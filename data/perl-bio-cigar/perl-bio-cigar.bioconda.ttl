@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:perl-bio-cigar a schema:SoftwareApplication ;
    schema:description "Parse CIGAR strings and translate coordinates to/from reference/query" ;
    schema:downloadUrl "https://cpan.metacpan.org/authors/id/T/TS/TSIBLEY/Bio-Cigar-1.01.tar.gz" ;
    schema:hasPart "perl",
        "perl-carp",
        "perl-extutils-makemaker",
        "perl-moo",
        "perl-namespace-clean",
        "perl-test-simple",
        "perl-type-tiny" ;
    schema:identifier biotools:bio-cigar ;
    schema:license "gpl_2" ;
    schema:name "perl-bio-cigar" ;
    schema:softwareVersion "1.01" ;
    schema:url "https://github.com/MullinsLab/Bio-Cigar" .

