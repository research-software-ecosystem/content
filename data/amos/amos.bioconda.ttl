@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:amos a schema1:SoftwareApplication ;
    schema1:alternateName "A Modular, Open-Source whole genome assembler" ;
    schema1:description "A Modular, Open-Source whole genome assembler" ;
    schema1:identifier <https://bio.tools/biotools:amos> ;
    schema1:license "Artistic License" ;
    schema1:name "amos" ;
    schema1:softwareVersion "3.1.0" ;
    schema1:url "http://amos.sourceforge.net/wiki/index.php/AMOS" .

