@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:amos a schema:SoftwareApplication ;
    schema:description "A Modular, Open-Source whole genome assembler" ;
    schema:downloadUrl "https://sourceforge.net/projects/amos/files/amos/3.1.0/amos-3.1.0.tar.gz" ;
    schema:hasPart "blat",
        "boost",
        "kmer-jellyfish",
        "mummer",
        "perl",
        "perl-dbi",
        "perl-statistics-descriptive",
        "perl-xml-parser",
        "python",
        "zlib" ;
    schema:identifier biotools:amos ;
    schema:license "Artistic License" ;
    schema:name "amos" ;
    schema:softwareVersion "3.1.0" ;
    schema:url "http://amos.sourceforge.net/wiki/index.php/AMOS" .

