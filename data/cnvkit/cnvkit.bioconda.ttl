@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:cnvkit a schema1:SoftwareApplication ;
    schema1:alternateName "Copy number variant detection from high-throughput sequencing." ;
    schema1:citation "doi:10.1371/journal.pcbi.1004873" ;
    schema1:description "Copy number variant detection from high-throughput sequencing." ;
    schema1:identifier <https://bio.tools/biotools:cnvkit>,
        "usegalaxy-eu:cnvkit_access",
        "usegalaxy-eu:cnvkit_antitarget",
        "usegalaxy-eu:cnvkit_autobin",
        "usegalaxy-eu:cnvkit_batch",
        "usegalaxy-eu:cnvkit_breaks",
        "usegalaxy-eu:cnvkit_call",
        "usegalaxy-eu:cnvkit_coverage",
        "usegalaxy-eu:cnvkit_diagram",
        "usegalaxy-eu:cnvkit_fix",
        "usegalaxy-eu:cnvkit_genemetrics",
        "usegalaxy-eu:cnvkit_heatmap",
        "usegalaxy-eu:cnvkit_reference",
        "usegalaxy-eu:cnvkit_scatter",
        "usegalaxy-eu:cnvkit_segment",
        "usegalaxy-eu:cnvkit_segmetrics",
        "usegalaxy-eu:cnvkit_sex",
        "usegalaxy-eu:cnvkit_target" ;
    schema1:license "Apache-2.0" ;
    schema1:name "cnvkit" ;
    schema1:softwareVersion "0.9.14" ;
    schema1:url "https://github.com/etal/cnvkit" .

