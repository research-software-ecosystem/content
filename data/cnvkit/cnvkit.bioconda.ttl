@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cnvkit a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1004873" ;
    schema:description "Copy number variant detection from high-throughput sequencing." ;
    schema:downloadUrl "https://github.com/etal/cnvkit/archive/v0.9.13.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:cnvkit ;
    schema:license "Apache-2.0" ;
    schema:name "cnvkit" ;
    schema:softwareHelp "https://cnvkit.readthedocs.io/en/stable" ;
    schema:softwareVersion "0.9.13" ;
    schema:url "https://github.com/etal/cnvkit" .

