@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mzr a schema1:SoftwareApplication ;
    schema1:alternateName "parser for netCDF, mzXML and mzML and mzIdentML files (mass spectrometry data)" ;
    schema1:description "mzR provides a unified API to the common file formats and parsers available for mass spectrometry data. It comes with a subset of the proteowizard library for mzXML, mzML and mzIdentML. The netCDF reading code has previously been used in XCMS." ;
    schema1:identifier <https://bio.tools/biotools:mzr> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mzr" ;
    schema1:softwareVersion "2.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mzR.html" .

