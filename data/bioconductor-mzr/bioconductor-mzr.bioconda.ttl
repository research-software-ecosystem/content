@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mzr a schema:SoftwareApplication ;
    schema:description "parser for netCDF, mzXML and mzML and mzIdentML files (mass spectrometry data)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/mzR_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mzR/mzR_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mzR_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mzr/bioconductor-mzr_2.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-protgenerics",
        "bioconductor-rhdf5lib",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ncdf4",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:mzr ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-mzr" ;
    schema:softwareVersion "2.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/mzR.html" .

