@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:longtr a schema:SoftwareApplication ;
    schema:author "awgymer" ;
    schema:description "Tandem repeat genotyping with long reads." ;
    schema:hasPart "htslib",
        "spoa",
        "zlib" ;
    schema:identifier biotools:longtr ;
    schema:license "BSD-2-Clause" ;
    schema:maintainer "awgymer" ;
    schema:name "longtr" ;
    schema:softwareHelp "https://github.com/gymrek-lab/LongTR" ;
    schema:softwareVersion "1.2" ;
    schema:url "https://github.com/gymrek-lab/LongTR" .

