@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:abpoa a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btaa963" ;
    schema:description "abPOA: fast SIMD-based partial order alignment using adaptive band." ;
    schema:downloadUrl "https://github.com/yangao07/abPOA/releases/download/v1.5.6/abPOA-v1.5.6.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:abpoa ;
    schema:license "MIT" ;
    schema:name "abpoa" ;
    schema:softwareHelp "https://github.com/yangao07/abPOA/blob/v1.5.6/README.md" ;
    schema:softwareVersion "1.5.6" ;
    schema:url "https://github.com/yangao07/abPOA" .

