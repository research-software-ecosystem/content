@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:searchgui a schema1:SoftwareApplication ;
    schema1:alternateName "User-friendly graphical tool for using proteomics identification search engines." ;
    schema1:citation "doi:10.1002/pmic.201000595" ;
    schema1:description "SearchGUI is a user-friendly open-source graphical user interface for configuring and running proteomics identification search engines, currently supporting X!Tandem, MS-GF+, MetaMorpheus, MS Amanda, MyriMatch, Comet, Tide, Andromeda and OMSSA." ;
    schema1:downloadUrl "http://genesis.ugent.be/maven2/eu/isas/searchgui/SearchGUI/4.3.15/SearchGUI-4.3.15-mac_and_linux.tar.gz" ;
    schema1:identifier "biotools:searchgui",
        "usegalaxy-eu:search_gui" ;
    schema1:license "Apache-2.0" ;
    schema1:name "searchgui" ;
    schema1:softwareVersion "4.3.15" ;
    schema1:url "https://github.com/compomics/searchgui" .

