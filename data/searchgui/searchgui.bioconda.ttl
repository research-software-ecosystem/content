@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:searchgui a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/pmic.201000595" ;
    schema:description "User-friendly graphical tool for using proteomics identification search engines." ;
    schema:downloadUrl "http://genesis.ugent.be/maven2/eu/isas/searchgui/SearchGUI/4.3.15/SearchGUI-4.3.15-mac_and_linux.tar.gz" ;
    schema:hasPart "blast",
        "metamorpheus",
        "xtandem" ;
    schema:identifier biotools:searchgui ;
    schema:license "Apache-2.0" ;
    schema:name "searchgui" ;
    schema:softwareHelp "https://github.com/compomics/searchgui/blob/master/README.md" ;
    schema:softwareVersion "4.3.15" ;
    schema:url "https://github.com/compomics/searchgui" .

