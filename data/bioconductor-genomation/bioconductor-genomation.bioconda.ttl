@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genomation a schema:SoftwareApplication ;
    schema:description "Summary, annotation and visualization of genomic data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/genomation_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genomation/genomation_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/genomation_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomation/bioconductor-genomation_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-impute",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-seqpattern",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-ggplot2",
        "r-gridbase",
        "r-matrixstats",
        "r-plotrix",
        "r-plyr",
        "r-rcpp",
        "r-readr",
        "r-reshape2",
        "zlib" ;
    schema:identifier biotools:genomation ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genomation" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/genomation.html" .

