@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:telogator a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "png",
        "tabular" ;
    schema1:codeRepository <https://github.com/zstephens/telogator2> ;
    schema1:dateCreated "2025-12-04" ;
    schema1:description "Measure allele-specific telomere length from long-read sequencing data" ;
    schema1:encodingFormat "fasta",
        "png",
        "tabular" ;
    schema1:identifier biotools:telogator2,
        bioconda:telogator2 ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.org> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "telogator" ;
    schema1:softwareVersion "2.2.3" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/telogator> .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org> a schema1:WebSite .

