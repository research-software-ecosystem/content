@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbcbook1 a schema1:SoftwareApplication ;
    schema1:alternateName "Support for Springer monograph on Bioconductor" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "tools for building book" ;
    schema1:identifier <https://bio.tools/biotools:rbcbook1> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-rbcbook1" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RbcBook1.html" .

