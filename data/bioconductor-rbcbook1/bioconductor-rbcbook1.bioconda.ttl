@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbcbook1 a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Support for Springer monograph on Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RbcBook1_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RbcBook1/RbcBook1_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RbcBook1_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbcbook1/bioconductor-rbcbook1_1.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "r-base",
        "r-rpart" ;
    schema:identifier biotools:rbcbook1 ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-rbcbook1" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RbcBook1.html" .

