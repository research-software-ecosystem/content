@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bandage a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv383" ;
    schema:description "Bandage - a Bioinformatics Application for Navigating De novo Assembly Graphs Easily." ;
    schema:downloadUrl "https://github.com/rrwick/Bandage/archive/v0.9.0.tar.gz" ;
    schema:identifier biotools:bandage ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "bandage" ;
    schema:softwareHelp "https://rrwick.github.io/Bandage" ;
    schema:softwareVersion "0.9.0" ;
    schema:url "https://github.com/rrwick/Bandage" .

