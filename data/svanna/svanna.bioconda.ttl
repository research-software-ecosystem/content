@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:svanna a schema:SoftwareApplication ;
    schema:author "nourmahfel" ;
    schema:citation "doi:10.1186/s13073-022-01046-6" ;
    schema:description "Efficient and accurate pathogenicity prediction for coding and regulatory structural variants in long-read genome sequencing" ;
    schema:downloadUrl "https://github.com/monarch-initiative/SvAnna/releases/download/v1.2.0/svanna-cli-1.2.0-distribution.zip" ;
    schema:identifier biotools:svanna ;
    schema:license "LicenseRef-Jackson-Laboratory-NonCommercial" ;
    schema:maintainer "nourmahfel" ;
    schema:name "svanna" ;
    schema:softwareHelp "https://svanna.readthedocs.io" ;
    schema:softwareVersion "1.2.0" ;
    schema:url "https://github.com/monarch-initiative/SvAnna" .

