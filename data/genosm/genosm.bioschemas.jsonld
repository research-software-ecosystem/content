  "@id": "https://bio.tools/genosm",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "Genosm is a HIPAA-ready, local-first clinical genogram, medical pedigree, and systemic case formulation platform. Unlike basic cloud AI tree generators or generic corporate flowchart apps, Genosm delivers full enterprise depth with total authoring control across PHI-stripped AI generation, deterministic auto-layout for complex multigenerational lineages, and custom drag-and-drop. It features NSGC/McGoldrick quadrant shading, carrier markers, and insurance-ready ICD-10, DSM-5, OMIM, HPO, and social coding. Clinicians can apply one-click Clinical Overlay Lenses (timelines, intergenerational ladders, generational intensity) with custom nodes, lines, and legend keys. Unifying 22 frameworks (Genogram, Ecomap, IFS, Triangle of Conflict, Trauma Lifeline) in one multi-sheet workspace with single-PDF export, it also includes editable AI diagram-to-notes (SOAP/PIRP), a Version Timeline with side-by-side visual diff Compare Mode, and a collaborative Case Conceptualizer.",
  "sc:isAccessibleForFree": true,
  "sc:name": "Genosm",
  "sc:operatingSystem": [
    "Linux",
    "Mac",
    "Windows"
  ],
  "sc:url": "https://www.genosm.com"
}