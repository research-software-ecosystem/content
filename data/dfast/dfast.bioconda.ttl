@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dfast a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx713" ;
    schema:description "DDBJ Fast Annotation and Submission Tool - Prokaryotic genome annotation pipeline" ;
    schema:downloadUrl "https://github.com/nigyta/dfast_core/archive/1.4.0.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:dfast ;
    schema:license "GPL-3.0-only" ;
    schema:name "dfast" ;
    schema:softwareHelp "https://github.com/nigyta/dfast_core/blob/1.4.0/README.md" ;
    schema:softwareVersion "1.4.0" ;
    schema:url "https://dfast.nig.ac.jp" .

