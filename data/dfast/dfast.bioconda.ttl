@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:dfast a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btx713" ;
    schema1:description "DDBJ Fast Annotation and Submission Tool - Prokaryotic genome annotation pipeline" ;
    schema1:downloadUrl "https://github.com/nigyta/dfast_core/archive/1.4.0.tar.gz" ;
    schema1:hasPart "zlib" ;
    schema1:identifier biotools:dfast ;
    schema1:license "GPL-3.0-only" ;
    schema1:name "dfast" ;
    schema1:softwareHelp "https://github.com/nigyta/dfast_core/blob/1.4.0/README.md" ;
    schema1:softwareVersion "1.4.0" ;
    schema1:url "https://dfast.nig.ac.jp" .

