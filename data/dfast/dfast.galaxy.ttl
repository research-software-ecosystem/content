@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:dfast a schema1:SoftwareApplication ;
    bioschemas:output "embl",
        "fasta",
        "genbank",
        "gff3",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:operation_2481,
        edam:topic_0080,
        edam:topic_0097,
        edam:topic_0622 ;
    schema1:codeRepository "https://github.com/nigyta/dfast_core/" ;
    schema1:dateCreated "2025-04-16" ;
    schema1:description "Prokaryotic genome annotation" ;
    schema1:encodingFormat "embl",
        "fasta",
        "genbank",
        "gff3",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_0362,
        edam:topic_0222 ;
    schema1:identifier biotools:dfast,
        bioconda:dfast ;
    schema1:keywords "Genome annotation" ;
    schema1:name "dfast" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/Helmholtz-UFZ/ufz-galaxy-tools/blob/main/tools/dfast/" .

