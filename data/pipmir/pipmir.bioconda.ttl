@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pipmir a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.123547.111" ;
    schema:description "We developed the PIPmiR algorithm to identify novel plant miRNA." ;
    schema:downloadUrl "https://ohlerlab.mdc-berlin.de/files/duke/PIPmiR/PIPmiR_v1_1b_executable.tar.gz" ;
    schema:identifier biotools:pipmir ;
    schema:license "PIPmiR is provided for academic use only, if you wish to use it in another setting please contact Uwe Ohler." ;
    schema:name "pipmir" ;
    schema:softwareVersion "1.1" ;
    schema:url "https://ohlerlab.mdc-berlin.de/software/Pipeline_for_the_Identification_of_Plant_miRNAs_84" .

