@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-qcmetrics a schema1:SoftwareApplication ;
    schema1:alternateName "A Framework for Quality Control" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The package provides a framework for generic quality control of data. It permits to create, manage and visualise individual or sets of quality control metrics and generate quality control reports in various formats." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/qcmetrics_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/qcmetrics/qcmetrics_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/qcmetrics_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qcmetrics/bioconductor-qcmetrics_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:qcmetrics" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-qcmetrics" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/qcmetrics.html" .

