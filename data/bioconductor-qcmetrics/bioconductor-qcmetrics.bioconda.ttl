@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-qcmetrics a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A Framework for Quality Control" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/qcmetrics_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/qcmetrics/qcmetrics_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/qcmetrics_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qcmetrics/bioconductor-qcmetrics_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-s4vectors",
        "r-base",
        "r-knitr",
        "r-pander",
        "r-xtable" ;
    schema:identifier biotools:qcmetrics ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-qcmetrics" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/qcmetrics.html" .

