@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:rcorrector a schema1:SoftwareApplication ;
    bioschemas:output "fastq" ;
    schema1:applicationSubCategory edam:topic_0099,
        edam:topic_3168,
        edam:topic_3170 ;
    schema1:codeRepository "https://github.com/mourisl/Rcorrector" ;
    schema1:dateCreated "2018-05-02" ;
    schema1:description "Rcorrector (RNA-seq error CORRECTOR) is a kmer-based error correction method for RNA-seq data." ;
    schema1:encodingFormat "fastq" ;
    schema1:featureList edam:operation_3195 ;
    schema1:identifier biotools:rcorrector,
        bioconda:rcorrector ;
    schema1:keywords "Fastq Manipulation" ;
    schema1:name "rcorrector" ;
    schema1:softwareVersion "1.0.3" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/rcorrector" .

