@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-xcms a schema:SoftwareApplication ;
    schema:description "LC-MS and GC-MS Data Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/xcms_4.8.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/xcms/xcms_4.8.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/xcms_4.8.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-xcms/bioconductor-xcms_4.8.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-iranges",
        "bioconductor-massspecwavelet",
        "bioconductor-metabocoreutils",
        "bioconductor-mscoreutils",
        "bioconductor-msexperiment",
        "bioconductor-msfeatures",
        "bioconductor-msnbase",
        "bioconductor-mzr",
        "bioconductor-protgenerics",
        "bioconductor-s4vectors",
        "bioconductor-spectra",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-lattice",
        "r-progress",
        "r-rcolorbrewer",
        "zlib" ;
    schema:identifier biotools:xcms ;
    schema:license "GPL (>= 2) + file LICENSE" ;
    schema:name "bioconductor-xcms" ;
    schema:softwareVersion "4.8.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/xcms.html" .

