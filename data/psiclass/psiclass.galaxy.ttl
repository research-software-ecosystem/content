@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:psiclass a schema1:SoftwareApplication ;
    bioschemas:output "gtf",
        "interval" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196 ;
    schema1:codeRepository <https://github.com/splicebox/PsiCLASS> ;
    schema1:dateCreated "2023-09-06" ;
    schema1:description "PsiCLASS is a reference-based transcriptome assembler for single or multiple RNA-seq samples." ;
    schema1:encodingFormat "gtf",
        "interval" ;
    schema1:featureList edam:operation_3258 ;
    schema1:identifier biotools:psiclass,
        bioconda:psiclass ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    schema1:keywords "Transcriptomics" ;
    schema1:name "psiclass" ;
    schema1:softwareVersion "1.0.3" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/psiclass> .

<https://usegalaxy.cz> a schema1:WebSite .

