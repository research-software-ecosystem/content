@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:psiclass a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-019-12990-0" ;
    schema:description "Simultaneous multi-sample transcript assembler for RNA-seq data." ;
    schema:downloadUrl "https://github.com/splicebox/PsiCLASS/archive/v1.0.3.tar.gz" ;
    schema:hasPart "samtools",
        "zlib" ;
    schema:identifier biotools:psiclass ;
    schema:license "GPL-3.0-only" ;
    schema:name "psiclass" ;
    schema:softwareHelp "https://github.com/splicebox/PsiCLASS/blob/v1.0.3/README.md" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/splicebox/PsiCLASS" .

