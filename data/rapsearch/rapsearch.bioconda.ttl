@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rapsearch a schema:SoftwareApplication ;
    schema:description "RAPSearch2 is a tool for fast protein similarity searches." ;
    schema:downloadUrl "http://downloads.sourceforge.net/project/rapsearch2/RAPSearch2.24_64bits.tar.gz",
        "https://depot.galaxyproject.org/software/rapsearch/rapsearch_2.24_src_all.tar.gz" ;
    schema:hasPart "boost-cpp" ;
    schema:identifier biotools:rapsearch ;
    schema:license "GNU General Public License v3 (GPLv3)" ;
    schema:name "rapsearch" ;
    schema:softwareVersion "2.24" ;
    schema:url "http://omics.informatics.indiana.edu/mg/RAPSearch2/" .

