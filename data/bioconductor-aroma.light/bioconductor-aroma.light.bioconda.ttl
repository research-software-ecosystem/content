@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-aroma.light a schema:SoftwareApplication ;
    schema:description "Light-Weight Methods for Normalization and Visualization of Microarray Data using Only Basic R Data Types" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/aroma.light_3.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/aroma.light/aroma.light_3.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/aroma.light_3.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aroma.light/bioconductor-aroma.light_3.40.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-matrixstats",
        "r-r.methodss3",
        "r-r.oo",
        "r-r.utils" ;
    schema:identifier biotools:aroma.light ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-aroma.light" ;
    schema:softwareVersion "3.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/aroma.light.html" .

