@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-aroma.light a schema1:SoftwareApplication ;
    schema1:alternateName "Light-Weight Methods for Normalization and Visualization of Microarray Data using Only Basic R Data Types" ;
    schema1:description "Methods for microarray analysis that take basic data types such as matrices and lists of vectors.  These methods can be used standalone, be utilized in other packages, or be wrapped up in higher-level classes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/aroma.light_3.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/aroma.light/aroma.light_3.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/aroma.light_3.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aroma.light/bioconductor-aroma.light_3.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:aroma.light" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-aroma.light" ;
    schema1:softwareVersion "3.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/aroma.light.html" .

