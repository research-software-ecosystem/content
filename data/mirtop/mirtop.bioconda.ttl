@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mirtop a schema:SoftwareApplication ;
    schema:description "Small RNA-seq annotation." ;
    schema:downloadUrl "https://github.com/miRTop/mirtop/archive/v0.4.30.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:mirtop ;
    schema:license "MIT" ;
    schema:name "mirtop" ;
    schema:softwareHelp "https://mirtop.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.4.30" ;
    schema:url "https://github.com/mirtop/mirtop" .

