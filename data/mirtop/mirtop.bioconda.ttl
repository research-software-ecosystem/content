@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mirtop a schema1:SoftwareApplication ;
    schema1:alternateName "Small RNA-seq annotation." ;
    schema1:description "Small RNA-seq annotation." ;
    schema1:identifier <https://bio.tools/biotools:mirtop> ;
    schema1:license "MIT" ;
    schema1:name "mirtop" ;
    schema1:softwareVersion "0.4.30" ;
    schema1:url "https://github.com/mirtop/mirtop" .

