@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-zlibbioc a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "An R packaged zlib-1.2.5" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/zlibbioc_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/zlibbioc/zlibbioc_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/zlibbioc_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-zlibbioc/bioconductor-zlibbioc_1.52.0_src_all.tar.gz" ;
    schema1:hasPart "libblas",
        "liblapack",
        "r-base" ;
    schema1:identifier biotools:zlibbioc ;
    schema1:license "Artistic-2.0 + file LICENSE" ;
    schema1:name "bioconductor-zlibbioc" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/zlibbioc.html" .

