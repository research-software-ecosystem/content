@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-zlibbioc a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "An R packaged zlib-1.2.5" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/zlibbioc_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/zlibbioc/zlibbioc_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/zlibbioc_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-zlibbioc/bioconductor-zlibbioc_1.52.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:zlibbioc ;
    schema:license "Artistic-2.0 + file LICENSE" ;
    schema:name "bioconductor-zlibbioc" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/zlibbioc.html" .

