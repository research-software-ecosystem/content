@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-basic4cseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu497" ;
    schema:description "Basic4Cseq: an R/Bioconductor package for analyzing 4C-seq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Basic4Cseq_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Basic4Cseq/Basic4Cseq_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Basic4Cseq_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-basic4cseq/bioconductor-basic4cseq_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome.ecoli.ncbi.20080805",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "r-base",
        "r-catools",
        "r-rcircos" ;
    schema:identifier biotools:basic4cseq ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-basic4cseq" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Basic4Cseq.html" .

