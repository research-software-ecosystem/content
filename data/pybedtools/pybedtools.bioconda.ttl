@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:pybedtools a schema1:SoftwareApplication ;
    schema1:alternateName "Wraps BEDTools for use in Python and adds many additional features." ;
    schema1:description "Wraps BEDTools for use in Python and adds many additional features." ;
    schema1:identifier biotools:pybedtools ;
    schema1:license "MIT" ;
    schema1:name "pybedtools" ;
    schema1:softwareVersion "0.12.1" ;
    schema1:url "https://github.com/daler/pybedtools" .

