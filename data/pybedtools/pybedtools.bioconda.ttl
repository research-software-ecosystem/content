@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pybedtools a schema:SoftwareApplication ;
    schema:description "Wraps BEDTools for use in Python and adds many additional features." ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/89/93/5878b1eed2e0b6662002d069763025e4374c16ad3d18d8e10a9fefac7b16/pybedtools-0.12.0.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python",
        "setuptools",
        "wheel",
        "zlib" ;
    schema:identifier biotools:pybedtools ;
    schema:license "MIT" ;
    schema:name "pybedtools" ;
    schema:softwareHelp "https://daler.github.io/pybedtools" ;
    schema:softwareVersion "0.12.0" ;
    schema:url "https://github.com/daler/pybedtools" .

