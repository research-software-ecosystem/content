@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:selscan a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/molbev/msu211" ;
    schema:description "a program to calculate EHH-based scans for positive selection in genomes" ;
    schema:downloadUrl "https://github.com/szpiech/selscan/archive/1.2.0a.tar.gz" ;
    schema:hasPart "gsl",
        "zlib" ;
    schema:identifier biotools:selscan ;
    schema:license "GPL-3.0" ;
    schema:name "selscan" ;
    schema:softwareVersion "1.2.0a" ;
    schema:url "https://github.com/szpiech/selscan" .

