@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:selscan a schema1:SoftwareApplication ;
    schema1:alternateName "a program to calculate EHH-based scans for positive selection in genomes" ;
    schema1:citation "doi:10.1093/molbev/msu211" ;
    schema1:description "a program to calculate EHH-based scans for positive selection in genomes" ;
    schema1:identifier biotools:selscan ;
    schema1:license "GPL-3.0-only" ;
    schema1:name "selscan" ;
    schema1:softwareVersion "3.0.1" ;
    schema1:url "https://github.com/szpiech/selscan" .

