@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gambit a schema:SoftwareApplication ;
    schema:author "jlumpe" ;
    schema:citation "doi:10.1371/journal.pone.0277575" ;
    schema:description "Tool for rapid taxonomic identification of microbial pathogens" ;
    schema:downloadUrl "https://github.com/jlumpe/gambit/archive/v1.1.0.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python" ;
    schema:identifier biotools:gambit_bacterial ;
    schema:license "AGPL-3.0-or-later" ;
    schema:maintainer "jlumpe" ;
    schema:name "gambit" ;
    schema:softwareHelp "https://gambit-genomics.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.1.0" ;
    schema:url "https://github.com/jlumpe/gambit" .

