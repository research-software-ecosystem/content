@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pecat a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-024-47349-7" ;
    schema:description "A phased error correction and assembly tool." ;
    schema:downloadUrl "https://github.com/lemene/PECAT/releases/download/v0.0.3/pecat_source_v0.0.3.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:pecat ;
    schema:license "BSD-2-Clause" ;
    schema:name "pecat" ;
    schema:softwareVersion "0.0.3" ;
    schema:url "https://github.com/lemene/PECAT" .

