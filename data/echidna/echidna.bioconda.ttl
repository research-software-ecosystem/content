@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:echidna a schema1:SoftwareApplication ;
    schema1:alternateName "Mapping genotype to phenotype through joint probabilistic modeling of single-cell gene expression and chromosomal copy number variation." ;
    schema1:description "Mapping genotype to phenotype through joint probabilistic modeling of single-cell gene expression and chromosomal copy number variation." ;
    schema1:identifier <https://bio.tools/biotools:echidna> ;
    schema1:license "MIT" ;
    schema1:maintainer "mingkz",
        "wgobrien" ;
    schema1:name "echidna" ;
    schema1:softwareVersion "1.0.3" ;
    schema1:url "https://github.com/azizilab/echidna" .

