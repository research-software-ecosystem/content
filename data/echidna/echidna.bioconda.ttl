@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:echidna a schema:SoftwareApplication ;
    schema:author "mingkz",
        "wgobrien" ;
    schema:description "Mapping genotype to phenotype through joint probabilistic modeling of single-cell gene expression and chromosomal copy number variation." ;
    schema:downloadUrl "https://pypi.io/packages/source/s/sc_echidna/sc_echidna-1.0.3.tar.gz" ;
    schema:hasPart "pip",
        "poetry",
        "python" ;
    schema:identifier biotools:echidna ;
    schema:license "MIT" ;
    schema:maintainer "mingkz",
        "wgobrien" ;
    schema:name "echidna" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/azizilab/echidna" .

