@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rmblast a schema:SoftwareApplication ;
    schema:author "TobyBaril",
        "mencian" ;
    schema:description "RMBlast is a RepeatMasker compatible version of the standard NCBI BLAST+ suite." ;
    schema:downloadUrl "https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.17.0/ncbi-blast-2.17.0+-src.tar.gz" ;
    schema:hasPart "bzip2",
        "curl",
        "entrez-direct",
        "ncbi-vdb",
        "sqlite",
        "zlib",
        "zstd" ;
    schema:identifier biotools:rmblast ;
    schema:license "OSL-2.1" ;
    schema:maintainer "TobyBaril",
        "mencian" ;
    schema:name "rmblast" ;
    schema:softwareHelp "https://www.repeatmasker.org/rmblast" ;
    schema:softwareVersion "2.17.0" ;
    schema:url "https://www.repeatmasker.org/rmblast" .

