@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:rmblast a schema1:SoftwareApplication ;
    schema1:alternateName "RMBlast is a RepeatMasker compatible version of the standard NCBI BLAST+ suite." ;
    schema1:description "RMBlast is a RepeatMasker compatible version of the standard NCBI BLAST+ suite." ;
    schema1:identifier <https://bio.tools/biotools:rmblast> ;
    schema1:license "OSL-2.1" ;
    schema1:maintainer "TobyBaril",
        "mencian" ;
    schema1:name "rmblast" ;
    schema1:softwareVersion "2.17.0" ;
    schema1:url "https://www.repeatmasker.org/rmblast" .

