@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gffcompare a schema:SoftwareApplication ;
    schema:description "GffCompare by Geo Pertea." ;
    schema:downloadUrl "https://github.com/gpertea/gffcompare/releases/download/v0.12.10/gffcompare-0.12.10.tar.gz" ;
    schema:identifier biotools:gffcompare ;
    schema:license "Artistic License 2.0" ;
    schema:name "gffcompare" ;
    schema:softwareHelp "https://github.com/gpertea/gffcompare/blob/v0.12.10/README.md" ;
    schema:softwareVersion "0.12.10" ;
    schema:url "https://ccb.jhu.edu/software/stringtie/gffcompare.shtml" .

