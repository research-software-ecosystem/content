@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-yarn a schema1:SoftwareApplication ;
    schema1:alternateName "YARN: Robust Multi-Condition RNA-Seq Preprocessing and Normalization" ;
    schema1:citation "doi:10.1101/086587" ;
    schema1:description "Expedite large RNA-Seq analyses using a combination of previously developed tools. YARN is meant to make it easier for the user in performing basic mis-annotation quality control, filtering, and condition-aware normalization. YARN leverages many Bioconductor tools and statistical techniques to account for the large heterogeneity and sparsity found in very large RNA-seq experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/yarn_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/yarn/yarn_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/yarn_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-yarn/bioconductor-yarn_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:yarn" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-yarn" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/yarn.html" .

