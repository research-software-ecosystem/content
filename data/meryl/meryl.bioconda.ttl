@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:meryl a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-020-02134-9" ;
    schema:description "meryl is a multi-threaded, multi-process, out-of-core k-mer counter" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:meryl ;
    schema:license "Public Domain" ;
    schema:name "meryl" ;
    schema:softwareHelp "https://github.com/marbl/meryl" ;
    schema:softwareVersion "1.4.1" ;
    schema:url "https://github.com/marbl/meryl" .

