@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:salmon a schema1:SoftwareApplication ;
    schema1:alternateName "Highly-accurate & wicked fast transcript-level quantification from RNA-seq reads (salmon 2.0, Rust)." ;
    schema1:citation "doi:10.1038/nmeth.4197" ;
    schema1:description "Highly-accurate & wicked fast transcript-level quantification from RNA-seq reads (salmon 2.0, Rust)." ;
    schema1:identifier <https://bio.tools/biotools:salmon>,
        "usegalaxy-eu:salmon",
        "usegalaxy-eu:salmonquantmerge" ;
    schema1:license "BSD-3-Clause" ;
    schema1:maintainer "k3yavi",
        "mjsteinbaugh",
        "rob-p" ;
    schema1:name "salmon" ;
    schema1:softwareVersion "2.4.1" ;
    schema1:url "https://github.com/COMBINE-lab/salmon" .

