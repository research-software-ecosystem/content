@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:salmon a schema:SoftwareApplication ;
    schema:author "k3yavi",
        "mjsteinbaugh",
        "rob-p" ;
    schema:citation "doi:10.1038/nmeth.4197" ;
    schema:description "Highly-accurate & wicked fast transcript-level quantification from RNA-seq reads (salmon 2.0, Rust)." ;
    schema:identifier biotools:salmon ;
    schema:license "BSD-3-Clause" ;
    schema:maintainer "k3yavi",
        "mjsteinbaugh",
        "rob-p" ;
    schema:name "salmon" ;
    schema:softwareHelp "https://combine-lab.github.io/salmon" ;
    schema:softwareVersion "2.3.1" ;
    schema:url "https://github.com/COMBINE-lab/salmon" .

