@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-medme a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.080721.108" ;
    schema:description "Modelling Experimental Data from MeDIP Enrichment" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MEDME_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MEDME/MEDME_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MEDME_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-medme/bioconductor-medme_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-drc",
        "r-mass",
        "zlib" ;
    schema:identifier biotools:medme ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-medme" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MEDME.html" .

