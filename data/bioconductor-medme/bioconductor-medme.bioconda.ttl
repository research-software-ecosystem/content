@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-medme a schema1:SoftwareApplication ;
    schema1:alternateName "Modelling Experimental Data from MeDIP Enrichment" ;
    schema1:citation "doi:10.1101/gr.080721.108" ;
    schema1:description "MEDME allows the prediction of absolute and relative methylation levels based on measures obtained by MeDIP-microarray experiments" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MEDME_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MEDME/MEDME_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MEDME_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-medme/bioconductor-medme_1.70.0_src_all.tar.gz" ;
    schema1:identifier "biotools:medme" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-medme" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MEDME.html" .

