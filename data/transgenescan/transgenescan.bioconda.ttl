@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:transgenescan a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-15-S9-S8" ;
    schema:description "Software tool for finding genes in assembled transcripts from metatranscriptomic sequences." ;
    schema:downloadUrl "https://github.com/COL-IU/TransGeneScan/archive/refs/tags/v1.3.0.tar.gz" ;
    schema:identifier biotools:TransGeneScan ;
    schema:license "GPL-3.0-only" ;
    schema:name "transgenescan" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "https://github.com/COL-IU/TransGeneScan" .

