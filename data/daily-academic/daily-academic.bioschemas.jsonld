  "@id": "https://bio.tools/daily-academic",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "Daily Academic is a publicly available platform that continuously aggregates and delivers personalized feeds of newly published scientific literature to biomedical researchers:\n\nIt integrates publications indexed across PubMed, monitored via the Crossref and NCBI EFetch APIs, covering a manually curated corpus of approximately 3,000 biomedical journals selected for scope and quality. Articles are encoded using a fine-tuned biomedical sentence-embedding model producing semantic vector representations that enable cosine similarity-based ranking against individual researcher interest profiles. The system also links publications to omics datasets through integration with the Public Omics Explorer, surfacing relevant GEO and SRA entries alongside literature results.",
  "sc:name": "Daily-Academic",
  "sc:url": "https://daily-academic.com"
}