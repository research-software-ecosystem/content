@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:exparna a schema:SoftwareApplication ;
    schema:description "The program finds the longest common subsequence of exact pattern matches (LCS-EPM)" ;
    schema:downloadUrl "https://github.com/BackofenLab/ExpaRNA/archive/1.0.1.tar.gz" ;
    schema:hasPart "perl",
        "viennarna" ;
    schema:identifier biotools:exparna ;
    schema:license "GPL-2.0" ;
    schema:name "exparna" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "https://github.com/BackofenLab/ExpaRNA" .

