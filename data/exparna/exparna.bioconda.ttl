@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:exparna a schema1:SoftwareApplication ;
    schema1:alternateName "The program finds the longest common subsequence of exact pattern matches (LCS-EPM)" ;
    schema1:description "The program finds the longest common subsequence of exact pattern matches (LCS-EPM)" ;
    schema1:identifier <https://bio.tools/biotools:exparna> ;
    schema1:license "GPL-2.0" ;
    schema1:name "exparna" ;
    schema1:softwareVersion "1.0.1" ;
    schema1:url "https://github.com/BackofenLab/ExpaRNA" .

