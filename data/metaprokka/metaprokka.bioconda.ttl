@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metaprokka a schema:SoftwareApplication ;
    schema:description "A fork of Prokka using Prodigal-GV for phage annotation and metagenome/metavirome tweaks" ;
    schema:downloadUrl "https://github.com/telatin/metaprokka/archive/v1.15.0.tar.gz" ;
    schema:hasPart "perl",
        "perl-bioperl",
        "prokka" ;
    schema:identifier biotools:metaprokka ;
    schema:license "GPL-3.0-only" ;
    schema:name "metaprokka" ;
    schema:softwareVersion "1.15.0" ;
    schema:url "https://github.com/telatin/metaprokka" .

