@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cyvcf2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx057" ;
    schema:description "A cython wrapper around htslib built for fast parsing of Variant Call Format (VCF) files." ;
    schema:downloadUrl "https://pypi.org/packages/source/c/cyvcf2/cyvcf2-0.34.0.tar.gz" ;
    schema:hasPart "cython",
        "htslib",
        "numpy",
        "pip",
        "python",
        "scikit-build-core" ;
    schema:identifier biotools:cyvcf2 ;
    schema:license "MIT" ;
    schema:name "cyvcf2" ;
    schema:softwareHelp "https://brentp.github.io/cyvcf2" ;
    schema:softwareVersion "0.34.0" ;
    schema:url "https://github.com/brentp/cyvcf2" .

