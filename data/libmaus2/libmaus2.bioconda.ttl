@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:libmaus2 a schema1:SoftwareApplication ;
    schema1:description "Collection of data structures and algorithms for NGS data." ;
    schema1:downloadUrl "https://gitlab.com/german.tischler/libmaus2/-/archive/2.0.813-release-20221210220409/libmaus2-2.0.813-release-20221210220409.tar.gz" ;
    schema1:hasPart "boost-cpp",
        "gmp",
        "libcurl",
        "libdeflate",
        "libgomp",
        "llvm-openmp",
        "nettle",
        "snappy",
        "staden_io_lib",
        "zlib" ;
    schema1:identifier biotools:libmaus ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "libmaus2" ;
    schema1:softwareVersion "2.0.813" ;
    schema1:url "https://gitlab.com/german.tischler/libmaus2" .

