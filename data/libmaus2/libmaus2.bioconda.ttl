@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:libmaus2 a schema1:SoftwareApplication ;
    schema1:alternateName "Collection of data structures and algorithms for NGS data." ;
    schema1:description "Collection of data structures and algorithms for NGS data." ;
    schema1:identifier biotools:libmaus ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "libmaus2" ;
    schema1:softwareVersion "2.0.813" ;
    schema1:url "https://gitlab.com/german.tischler/libmaus2" .

