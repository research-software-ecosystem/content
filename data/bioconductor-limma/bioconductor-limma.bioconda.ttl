@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-limma a schema1:SoftwareApplication ;
    schema1:alternateName "Linear Models for Microarray and Omics Data" ;
    schema1:description "Data analysis, linear models and differential expression for omics data." ;
    schema1:identifier <https://bio.tools/biotools:limma>,
        "usegalaxy-eu:limma_voom" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-limma" ;
    schema1:softwareVersion "3.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/limma.html" .

