@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-limma a schema1:SoftwareApplication ;
    schema1:alternateName "Linear Models for Microarray and Omics Data" ;
    schema1:description "Data analysis, linear models and differential expression for omics data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/limma_3.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/limma/limma_3.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/limma_3.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-limma/bioconductor-limma_3.66.0_src_all.tar.gz" ;
    schema1:identifier "biotools:limma",
        "usegalaxy-eu:limma_voom" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-limma" ;
    schema1:softwareVersion "3.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/limma.html" .

