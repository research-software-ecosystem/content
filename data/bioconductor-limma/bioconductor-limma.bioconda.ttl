@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-limma a schema:SoftwareApplication ;
    schema:description "Linear Models for Microarray and Omics Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/limma_3.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/limma/limma_3.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/limma_3.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-limma/bioconductor-limma_3.66.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-statmod",
        "zlib" ;
    schema:identifier biotools:limma ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-limma" ;
    schema:softwareVersion "3.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/limma.html" .

