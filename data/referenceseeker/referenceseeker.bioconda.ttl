@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:referenceseeker a schema:SoftwareApplication ;
    schema:author "oschwengers" ;
    schema:description "Rapid determination of appropriate reference genomes." ;
    schema:downloadUrl "https://github.com/oschwengers/referenceseeker/archive/v1.8.0.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:referenceseeker ;
    schema:license "GPLv3" ;
    schema:maintainer "oschwengers" ;
    schema:name "referenceseeker" ;
    schema:softwareVersion "1.8.0" ;
    schema:url "https://github.com/oschwengers/referenceseeker" .

