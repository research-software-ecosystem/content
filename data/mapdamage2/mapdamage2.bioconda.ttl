@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mapdamage2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr347",
        "doi:10.1093/bioinformatics/btt193" ;
    schema:description "mapDamage: tracking and quantifying damage patterns in ancient DNA sequencing reads generated by Next-Generation Sequencing platforms." ;
    schema:downloadUrl "https://pypi.org/packages/source/m/mapdamage/mapdamage-2.2.3.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "zlib" ;
    schema:identifier biotools:mapdamage ;
    schema:license "MIT" ;
    schema:name "mapdamage2" ;
    schema:softwareHelp "https://ginolhac.github.io/mapDamage" ;
    schema:softwareVersion "2.2.3" ;
    schema:url "https://github.com/ginolhac/mapDamage" .

