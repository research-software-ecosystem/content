@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mason a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0049110" ;
    schema:description "Mason is a collection of tools for the simulation of biological sequences." ;
    schema:downloadUrl "https://github.com/seqan/seqan/archive/refs/tags/seqan-v2.5.2.tar.gz" ;
    schema:hasPart "bzip2",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:mason ;
    schema:license "BSD 3-Clause" ;
    schema:name "mason" ;
    schema:softwareHelp "https://github.com/seqan/seqan/tree/seqan-v2.5.2/apps/mason2/README" ;
    schema:softwareVersion "2.0.13" ;
    schema:url "https://www.seqan.de/apps/mason.html" .

