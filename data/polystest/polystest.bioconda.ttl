@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:polystest a schema:SoftwareApplication ;
    schema:citation "doi:10.1074/mcp.RA119.001777" ;
    schema:description "Interactive tool for statistical testing, data browsing and interactive visualization of quantitative omics data" ;
    schema:downloadUrl "https://bitbucket.org/veitveit/polystest/get/release-1.3.4.tar.gz" ;
    schema:identifier biotools:polystest ;
    schema:license "GPL (>=2)" ;
    schema:name "polystest" ;
    schema:softwareVersion "1.3.4" ;
    schema:url "https://bitbucket.org/veitveit/polystest/src/master/" .

