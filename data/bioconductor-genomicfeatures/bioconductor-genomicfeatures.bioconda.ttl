@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genomicfeatures a schema1:SoftwareApplication ;
    schema1:alternateName "Query the gene models of a given organism/assembly" ;
    schema1:description "Extract the genomic locations of genes, transcripts, exons, introns, and CDS, for the gene models stored in a TxDb object. A TxDb object is a small database that contains the gene models of a given organism/assembly. Bioconductor provides a small collection of TxDb objects in the form of ready-to-install TxDb packages for the most commonly studied organisms. Additionally, the user can easily make a TxDb object (or package) for the organism/assembly of their choice by using the tools from the txdbmaker package." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GenomicFeatures_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicFeatures/GenomicFeatures_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicFeatures_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomicfeatures/bioconductor-genomicfeatures_1.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genomicfeatures" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genomicfeatures" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicFeatures.html" .

