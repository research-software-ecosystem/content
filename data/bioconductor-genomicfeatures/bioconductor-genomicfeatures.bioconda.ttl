@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genomicfeatures a schema:SoftwareApplication ;
    schema:description "Query the gene models of a given organism/assembly" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GenomicFeatures_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicFeatures/GenomicFeatures_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicFeatures_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomicfeatures/bioconductor-genomicfeatures_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "r-base",
        "r-dbi" ;
    schema:identifier biotools:genomicfeatures ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genomicfeatures" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicFeatures.html" .

