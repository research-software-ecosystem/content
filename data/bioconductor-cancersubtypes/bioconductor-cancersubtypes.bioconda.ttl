@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cancersubtypes a schema1:SoftwareApplication ;
    schema1:alternateName "Cancer subtypes identification, validation and visualization based on multiple genomic data sets" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "CancerSubtypes integrates the current common computational biology methods for cancer subtypes identification and provides a standardized framework for cancer subtype analysis based multi-omics data, such as gene expression, miRNA expression, DNA methylation and others." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CancerSubtypes_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/CancerSubtypes/CancerSubtypes_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/CancerSubtypes_1.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cancersubtypes/bioconductor-cancersubtypes_1.26.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cancersubtypes" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-cancersubtypes" ;
    schema1:softwareVersion "1.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/CancerSubtypes.html" .

