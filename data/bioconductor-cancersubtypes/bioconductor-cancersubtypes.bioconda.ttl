@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cancersubtypes a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Cancer subtypes identification, validation and visualization based on multiple genomic data sets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CancerSubtypes_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/CancerSubtypes/CancerSubtypes_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/CancerSubtypes_1.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cancersubtypes/bioconductor-cancersubtypes_1.26.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-consensusclusterplus",
        "bioconductor-impute",
        "bioconductor-limma",
        "r-base",
        "r-cluster",
        "r-nmf",
        "r-sigclust",
        "r-survival" ;
    schema:identifier biotools:cancersubtypes ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-cancersubtypes" ;
    schema:softwareVersion "1.26.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/CancerSubtypes.html" .

