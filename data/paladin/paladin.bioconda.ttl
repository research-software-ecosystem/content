@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:paladin a schema1:SoftwareApplication ;
    schema1:alternateName "Protein Alignment and Detection Interface." ;
    schema1:citation "doi:10.1093/bioinformatics/btx021" ;
    schema1:description "PALADIN is a protein sequence alignment tool designed for the accurate functional characterization of metagenomes." ;
    schema1:identifier biotools:paladin ;
    schema1:license "MIT" ;
    schema1:maintainer "keuv-grvl" ;
    schema1:name "paladin" ;
    schema1:softwareVersion "1.6.0" ;
    schema1:url "https://github.com/ToniWestbrook/paladin" .

