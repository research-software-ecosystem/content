@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:paladin a schema:SoftwareApplication ;
    schema:author "keuv-grvl" ;
    schema:citation "doi:10.1093/bioinformatics/btx021" ;
    schema:description "Protein Alignment and Detection Interface." ;
    schema:downloadUrl "https://github.com/ToniWestbrook/paladin/archive/refs/tags/v.1.6.0.tar.gz" ;
    schema:hasPart "libcurl",
        "zlib" ;
    schema:identifier biotools:paladin ;
    schema:license "MIT" ;
    schema:maintainer "keuv-grvl" ;
    schema:name "paladin" ;
    schema:softwareHelp "https://genomebio.org/paladin" ;
    schema:softwareVersion "1.6.0" ;
    schema:url "https://github.com/ToniWestbrook/paladin" .

