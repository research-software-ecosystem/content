@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-interactionset a schema:SoftwareApplication ;
    schema:description "Base Classes for Storing Genomic Interaction Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/InteractionSet_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/InteractionSet/InteractionSet_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/InteractionSet_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-interactionset/bioconductor-interactionset_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:interactionset ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-interactionset" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/InteractionSet.html" .

