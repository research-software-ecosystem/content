@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-interactionset a schema1:SoftwareApplication ;
    schema1:alternateName "Base Classes for Storing Genomic Interaction Data" ;
    schema1:description "Provides the GInteractions, InteractionSet and ContactMatrix objects and associated methods for storing and manipulating genomic interaction data from Hi-C and ChIA-PET experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/InteractionSet_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/InteractionSet/InteractionSet_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/InteractionSet_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-interactionset/bioconductor-interactionset_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:interactionset" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-interactionset" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/InteractionSet.html" .

