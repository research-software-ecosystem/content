@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-noiseq a schema1:SoftwareApplication ;
    schema1:alternateName "Exploratory analysis and differential expression for RNA-seq data" ;
    schema1:description "Analysis of RNA-seq expression data or other similar kind of data. Exploratory plots to evualuate saturation, count distribution, expression per chromosome, type of detected features, features length, etc. Differential expression between two experimental conditions with no parametric assumptions." ;
    schema1:identifier <https://bio.tools/biotools:noiseq> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-noiseq" ;
    schema1:softwareVersion "2.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/NOISeq.html" .

