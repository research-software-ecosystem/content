@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-noiseq a schema1:SoftwareApplication ;
    schema1:description "Exploratory analysis and differential expression for RNA-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/NOISeq_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NOISeq/NOISeq_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/NOISeq_2.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-noiseq/bioconductor-noiseq_2.54.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "r-base",
        "r-matrix" ;
    schema1:identifier biotools:noiseq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-noiseq" ;
    schema1:softwareVersion "2.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/NOISeq.html" .

