@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:raven-assembler a schema:SoftwareApplication ;
    schema:author "thanhleviet" ;
    schema:description "Raven is an assembler for raw reads generated by the third generation sequencing." ;
    schema:downloadUrl "https://github.com/lbcb-sci/raven/archive/1.8.3.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:raven ;
    schema:license "MIT" ;
    schema:maintainer "thanhleviet" ;
    schema:name "raven-assembler" ;
    schema:softwareHelp "https://github.com/lbcb-sci/raven/blob/1.8.3/README.md" ;
    schema:softwareVersion "1.8.3" ;
    schema:url "https://github.com/lbcb-sci/raven" .

