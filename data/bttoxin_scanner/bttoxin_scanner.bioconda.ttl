@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bttoxin_scanner a schema:SoftwareApplication ;
    schema:author "liaochenlanruo" ;
    schema:description "A toxin exploration tool for Bacillus thuringiensis" ;
    schema:downloadUrl "https://github.com/liaochenlanruo/BtToxin_scanner/archive/v2.0.1.tar.gz" ;
    schema:hasPart "perl",
        "perl-bioperl",
        "perl-file-tee" ;
    schema:identifier biotools:BtToxin_scanner ;
    schema:license "GPLv3" ;
    schema:maintainer "liaochenlanruo" ;
    schema:name "bttoxin_scanner" ;
    schema:softwareVersion "2.0.1" ;
    schema:url "https://github.com/liaochenlanruo/BtToxin_scanner/blob/master/README.md" .

