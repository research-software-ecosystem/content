@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:happy a schema1:SoftwareApplication ;
    bioschemas:output "csv",
        "json",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0622,
        edam:topic_2885 ;
    schema1:codeRepository "https://github.com/Illumina/hap.py" ;
    schema1:dateCreated "2022-01-25" ;
    schema1:description "A tool to perform comparisons only based on chromosome, position, and allele identity for comparison of somatic callsets." ;
    schema1:encodingFormat "csv",
        "json",
        "tabular" ;
    schema1:featureList edam:operation_2403,
        edam:operation_3196,
        edam:operation_3227,
        edam:topic_0080 ;
    schema1:identifier biotools:hap.py,
        bioconda:hap.py ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "happy" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/happy" .

