@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-crisprseek a schema:SoftwareApplication ;
    schema:description "Design of guide RNAs in CRISPR genome-editing systems" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CRISPRseek_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CRISPRseek/CRISPRseek_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CRISPRseek_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-crisprseek/bioconductor-crisprseek_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-delayedarray",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rhdf5",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "r-base",
        "r-data.table",
        "r-dplyr",
        "r-gtools",
        "r-hash",
        "r-keras",
        "r-mltools",
        "r-openxlsx",
        "r-reticulate",
        "r-rio",
        "r-rlang",
        "r-seqinr",
        "r-stringr" ;
    schema:identifier biotools:crisprseek ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-crisprseek" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CRISPRseek.html" .

