@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bwa-mem2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/IPDPS.2019.00041" ;
    schema:description "The next version of bwa-mem." ;
    schema:downloadUrl "https://github.com/bwa-mem2/bwa-mem2/releases/download/v2.3/Source_code_including_submodules.tar.gz" ;
    schema:hasPart "wget",
        "zlib" ;
    schema:identifier biotools:bwa-mem2 ;
    schema:license "MIT" ;
    schema:name "bwa-mem2" ;
    schema:softwareHelp "https://github.com/bwa-mem2/bwa-mem2/blob/v2.3/README.md" ;
    schema:softwareVersion "2.3" ;
    schema:url "https://github.com/bwa-mem2/bwa-mem2" .

