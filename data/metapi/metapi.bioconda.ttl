@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metapi a schema:SoftwareApplication ;
    schema:author "alienzj" ;
    schema:description "A general metagenomics data mining system focus on robust microbiome research" ;
    schema:downloadUrl "https://github.com/ohmeta/metapi/archive/v3.0.0.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:metapi ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "alienzj" ;
    schema:name "metapi" ;
    schema:softwareVersion "3.0.0" ;
    schema:url "https://github.com/ohmeta/metapi" .

