@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:piret a schema:SoftwareApplication ;
    schema:description "A tool for conducting RNA seq analysis." ;
    schema:downloadUrl "https://github.com/mshakya/piret/archive/0.3.4.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:piret ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "piret" ;
    schema:softwareVersion "0.3.4" ;
    schema:url "https://github.com/mshakya/PyPiReT" .

