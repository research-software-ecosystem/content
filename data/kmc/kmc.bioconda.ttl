@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kmc a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv022",
        "doi:10.1093/bioinformatics/btx304",
        "doi:10.1186/1471-2105-14-160" ;
    schema:description "Tools for efficient k-mer counting and filtering of reads based on k-mer content." ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:kmc ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "kmc" ;
    schema:softwareHelp "https://github.com/refresh-bio/KMC/blob/v3.2.4/README.md" ;
    schema:softwareVersion "3.2.4" ;
    schema:url "https://github.com/refresh-bio/kmc" .

