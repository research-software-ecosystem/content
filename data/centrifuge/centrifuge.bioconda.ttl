@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:centrifuge a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.210641.116" ;
    schema:description "Classifier for metagenomic sequences. Supports classifier scripts" ;
    schema:downloadUrl "https://github.com/DaehwanKimLab/centrifuge/archive/refs/tags/v1.0.4.2.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Centrifuge ;
    schema:license "GPL-3.0-only" ;
    schema:name "centrifuge" ;
    schema:softwareVersion "1.0.4.2" ;
    schema:url "https://github.com/DaehwanKimLab/centrifuge" .

