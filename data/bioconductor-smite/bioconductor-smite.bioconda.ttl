@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-smite a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-017-1477-3" ;
    schema:description "Significance-based Modules Integrating the Transcriptome and Epigenome" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SMITE_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SMITE/SMITE_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SMITE_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-smite/bioconductor-smite_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-bionet",
        "bioconductor-genelendatabase",
        "bioconductor-genomicranges",
        "bioconductor-goseq",
        "bioconductor-iranges",
        "bioconductor-keggrest",
        "bioconductor-org.hs.eg.db",
        "bioconductor-reactome.db",
        "bioconductor-s4vectors",
        "r-base",
        "r-ggplot2",
        "r-hmisc",
        "r-igraph",
        "r-plyr",
        "r-scales" ;
    schema:identifier biotools:smite ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-smite" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SMITE.html" .

