@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:primer3 a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gks596" ;
    schema:description "PCR primer design software" ;
    schema:downloadUrl "https://github.com/primer3-org/primer3/archive/v2.6.1.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:primer3 ;
    schema:license "GPLv2" ;
    schema:name "primer3" ;
    schema:softwareVersion "2.6.1" ;
    schema:url "https://github.com/primer3-org/primer3" .

