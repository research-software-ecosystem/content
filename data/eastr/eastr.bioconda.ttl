@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:eastr a schema:SoftwareApplication ;
    schema:author "coperni",
        "ishinder" ;
    schema:citation "doi:10.1038/s41467-023-43017-4" ;
    schema:description "Tool for emending alignments of spuriously spliced transcript reads." ;
    schema:downloadUrl "https://pypi.io/packages/source/e/eastr/eastr-1.1.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:eastr ;
    schema:license "MIT" ;
    schema:maintainer "coperni",
        "ishinder" ;
    schema:name "eastr" ;
    schema:softwareHelp "https://ccb.jhu.edu/eastr/#usage" ;
    schema:softwareVersion "1.1.2" ;
    schema:url "https://ccb.jhu.edu/eastr" .

