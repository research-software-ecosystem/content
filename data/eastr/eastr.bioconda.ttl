@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:eastr a schema1:SoftwareApplication ;
    schema1:alternateName "Tool for emending alignments of spuriously spliced transcript reads." ;
