@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:pbwt a schema1:SoftwareApplication ;
    schema1:alternateName "Positional Burrows-Wheeler Transform -  methods for storing and computing on genome variation data sets" ;
    schema1:description "Positional Burrows-Wheeler Transform -  methods for storing and computing on genome variation data sets" ;
    schema1:identifier biotools:pbwt ;
    schema1:license "Apache-2.0" ;
    schema1:name "pbwt" ;
    schema1:softwareVersion "3.0" ;
    schema1:url "https://github.com/richarddurbin/pbwt" .

