@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pbwt a schema:SoftwareApplication ;
    schema:description "Positional Burrows-Wheeler Transform -  methods for storing and computing on genome variation data sets" ;
    schema:downloadUrl "https://github.com/richarddurbin/pbwt/archive/64c4ffa7880db5f85b53ccbd7e530ec4b95ea4ba.zip" ;
    schema:hasPart "htslib",
        "llzma",
        "zlib" ;
    schema:identifier biotools:pbwt ;
    schema:license "Apache-2.0" ;
    schema:name "pbwt" ;
    schema:softwareVersion "3.0" ;
    schema:url "https://github.com/richarddurbin/pbwt" .

