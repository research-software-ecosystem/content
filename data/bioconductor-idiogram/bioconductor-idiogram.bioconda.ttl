@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-idiogram a schema1:SoftwareApplication ;
    schema1:alternateName "idiogram" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A package for plotting genomic data by chromosomal location" ;
    schema1:identifier <https://bio.tools/biotools:idiogram> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-idiogram" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/idiogram.html" .

