@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-idiogram a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "idiogram" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/idiogram_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/idiogram/idiogram_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/idiogram_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-idiogram/bioconductor-idiogram_1.86.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotate",
        "bioconductor-biobase",
        "r-base",
        "r-plotrix" ;
    schema1:identifier biotools:idiogram ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-idiogram" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/idiogram.html" .

