@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:sr_bowtie a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:applicationSubCategory edam:topic_3070,
        edam:topic_3301 ;
    schema1:codeRepository "http://artbio.fr" ;
    schema1:dateCreated "2017-09-02" ;
    schema1:description "bowtie wrapper tool to align small RNA sequencing reads" ;
    schema1:encodingFormat "tabular" ;
    schema1:identifier biotools:sr_bowtie,
        bioconda:bowtie ;
    schema1:keywords "Next Gen Mappers",
        "RNA" ;
    schema1:name "sr_bowtie" ;
    schema1:softwareVersion "2.3.1" ;
    schema1:url "https://github.com/ARTbio/tools-artbio/tree/master/tools/sr_bowtie" .

