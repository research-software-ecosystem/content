@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:igblast a schema:SoftwareApplication ;
    schema:description "A tool for analyzing immunoglobulin (IG) and T cell receptor (TR) sequences" ;
    schema:downloadUrl "ftp://ftp.ncbi.nih.gov/blast/executables/igblast/release/1.22.0/ncbi-igblast-1.22.0-src.tar.gz" ;
    schema:hasPart "bzip2",
        "libidn11",
        "libsqlite",
        "ncbi-vdb",
        "zlib" ;
    schema:identifier biotools:igblast ;
    schema:license "Public Domain and others" ;
    schema:name "igblast" ;
    schema:softwareVersion "1.22.0" ;
    schema:url "http://www.ncbi.nlm.nih.gov/projects/igblast/" .

