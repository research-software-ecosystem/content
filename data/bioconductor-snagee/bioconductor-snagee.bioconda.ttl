@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-snagee a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0051013" ;
    schema:description "Signal-to-Noise applied to Gene Expression Experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SNAGEE_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SNAGEE/SNAGEE_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SNAGEE_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-snagee/bioconductor-snagee_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-snageedata",
        "r-base" ;
    schema:identifier biotools:snagee ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-snagee" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SNAGEE.html" .

