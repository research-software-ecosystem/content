@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-quasr a schema1:SoftwareApplication ;
    schema1:description "Quantify and Annotate Short Reads in R" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/QuasR_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/QuasR/QuasR_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/QuasR_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-quasr/bioconductor-quasr_1.50.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicfiles",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rbowtie",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-shortread",
        "bioconductor-txdbmaker",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:quasr ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-quasr" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/QuasR.html" .

