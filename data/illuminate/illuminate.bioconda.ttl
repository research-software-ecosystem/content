@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:illuminate a schema:SoftwareApplication ;
    schema:description "Analytics toolkit for Illumina sequencer metrics." ;
    schema:downloadUrl "https://bitbucket.org/ilmn8/illuminate/get/e19b8afefead.zip" ;
    schema:hasPart "bitstring",
        "docopt",
        "numpy",
        "openpyxl",
        "pandas",
        "python",
        "pytz",
        "setuptools",
        "xmltodict" ;
    schema:identifier biotools:illuminate ;
    schema:license "MIT" ;
    schema:name "illuminate" ;
    schema:softwareVersion "0.6.3" ;
    schema:url "https://bitbucket.org/invitae/illuminate" .

