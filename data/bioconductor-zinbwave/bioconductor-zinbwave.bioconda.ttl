@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-zinbwave a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-017-02554-5" ;
    schema:description "Zero-Inflated Negative Binomial Model for RNA-Seq Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/zinbwave_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/zinbwave/zinbwave_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/zinbwave_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-zinbwave/bioconductor-zinbwave_1.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "bioconductor-edger",
        "bioconductor-genefilter",
        "bioconductor-singlecellexperiment",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-matrix",
        "r-softimpute" ;
    schema:identifier biotools:zinbwave ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-zinbwave" ;
    schema:softwareVersion "1.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/zinbwave.html" .

