@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sscore a schema1:SoftwareApplication ;
    schema1:alternateName "S-Score Algorithm for Affymetrix Oligonucleotide Microarrays" ;
    schema1:citation "doi:10.1016/S1046-2023(03)00156-7" ;
    schema1:description "This package contains an implementation of the S-Score algorithm as described by Zhang et al (2002)." ;
    schema1:identifier <https://bio.tools/biotools:sscore> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-sscore" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/sscore.html" .

