@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sscore a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/S1046-2023(03)00156-7" ;
    schema:description "S-Score Algorithm for Affymetrix Oligonucleotide Microarrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sscore_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/sscore/sscore_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/sscore_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sscore/bioconductor-sscore_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyio",
        "r-base" ;
    schema:identifier biotools:sscore ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-sscore" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/sscore.html" .

