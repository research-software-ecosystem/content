        "r-igraph",
        "r-jade",
        "r-mclust",
        "r-plyr",
        "r-rcolorbrewer",
        "r-scales",
        "r-xtable" ;
    schema:identifier biotools:mineica ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-mineica" ;
    schema:softwareVersion "1.49.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MineICA.html" .

