@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:vcflib a schema:SoftwareApplication ;
    schema:author "jpuritz",
        "mencian" ;
    schema:citation "doi:10.1371/journal.pcbi.1009123" ;
    schema:description "Command-line tools for manipulating VCF files." ;
    schema:hasPart "bzip2",
        "fastahack",
        "htslib",
        "libcurl",
        "libdeflate",
        "libgomp",
        "llvm-openmp",
        "pandoc",
        "wfa2-lib",
        "xz",
        "zlib" ;
    schema:identifier biotools:vcflib ;
    schema:license "MIT" ;
    schema:maintainer "jpuritz",
        "mencian" ;
    schema:name "vcflib" ;
    schema:softwareHelp "https://github.com/vcflib/vcflib/blob/v1.0.15/README.md" ;
    schema:softwareVersion "1.0.15" ;
    schema:url "https://github.com/vcflib/vcflib" .

