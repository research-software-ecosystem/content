@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-egsea a schema1:SoftwareApplication ;
    schema1:description "Ensemble of Gene Set Enrichment Analyses" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/EGSEA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EGSEA/EGSEA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EGSEA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-egsea/bioconductor-egsea_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-edger",
        "bioconductor-egseadata",
        "bioconductor-gage",
        "bioconductor-globaltest",
        "bioconductor-gsva",
        "bioconductor-limma",
        "bioconductor-org.hs.eg.db",
        "bioconductor-org.mm.eg.db",
        "bioconductor-org.rn.eg.db",
        "bioconductor-padog",
        "bioconductor-pathview",
        "bioconductor-safe",
        "bioconductor-topgo",
        "r-base",
        "r-dt",
        "r-ggplot2",
        "r-gplots",
        "r-htmlutils",
        "r-htmlwidgets",
        "r-hwriter",
        "r-metap",
        "r-plotly",
        "r-rcolorbrewer",
        "r-stringi" ;
    schema1:identifier biotools:egsea ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-egsea" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EGSEA.html" .

