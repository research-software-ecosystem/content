@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:nextpolish a schema:SoftwareApplication ;
    schema:author "rpetit3" ;
    schema:citation "doi:10.1093/bioinformatics/btz891" ;
    schema:description "Fast and accurately polish the genome generated by noisy long reads." ;
    schema:hasPart "bzip2",
        "xz",
        "zlib" ;
    schema:identifier biotools:NextPolish ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "rpetit3" ;
    schema:name "nextpolish" ;
    schema:softwareHelp "https://nextpolish.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.4.1" ;
    schema:url "https://github.com/Nextomics/NextPolish" .

