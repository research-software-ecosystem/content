@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affyio a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for parsing Affymetrix data files" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Routines for parsing Affymetrix data files based upon file format information. Primary focus is on accessing the CEL and CDF file formats." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/affyio_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affyio/affyio_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affyio_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affyio/bioconductor-affyio_1.80.0_src_all.tar.gz" ;
    schema1:identifier "biotools:affyio" ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-affyio" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affyio.html" .

