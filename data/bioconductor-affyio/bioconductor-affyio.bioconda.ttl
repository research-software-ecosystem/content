@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-affyio a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Tools for parsing Affymetrix data files" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/affyio_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affyio/affyio_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affyio_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affyio/bioconductor-affyio_1.80.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:affyio ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-affyio" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/affyio.html" .

