@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:spotyping a schema1:SoftwareApplication ;
    bioschemas:output "excel.xls",
        "pdf",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0157,
        edam:topic_0199,
        edam:topic_3168,
        edam:topic_3301 ;
    schema1:codeRepository <https://github.com/xiaeryu/SpoTyping-v2.0> ;
    schema1:dateCreated "2018-05-08" ;
    schema1:description "SpoTyping allows fast and accurate in silico Mycobacterium spoligotyping from sequence reads" ;
    schema1:encodingFormat "excel.xls",
        "pdf",
        "txt" ;
    schema1:featureList edam:operation_3504 ;
    schema1:identifier biotools:spotyping,
        bioconda:spotyping ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "spotyping" ;
    schema1:softwareVersion "2.1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/spotyping> .

<https://usegalaxy.cz> a schema1:WebSite .

