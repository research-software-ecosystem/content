@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hypergraph a schema1:SoftwareApplication ;
    schema1:alternateName "A package providing hypergraph data structures" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A package that implements some simple capabilities for representing and manipulating hypergraphs." ;
    schema1:identifier biotools:hypergraph ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-hypergraph" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/hypergraph.html" .

