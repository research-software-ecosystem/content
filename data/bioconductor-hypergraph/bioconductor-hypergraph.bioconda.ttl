@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hypergraph a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A package providing hypergraph data structures" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/hypergraph_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/hypergraph/hypergraph_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/hypergraph_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hypergraph/bioconductor-hypergraph_1.82.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-graph",
        "r-base" ;
    schema1:identifier biotools:hypergraph ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-hypergraph" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/hypergraph.html" .

