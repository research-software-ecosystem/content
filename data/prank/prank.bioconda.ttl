@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:prank a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-62703-646-7_10" ;
    schema:description "PRANK is a probabilistic multiple alignment program for DNA, codon and amino-acid sequences." ;
    schema:downloadUrl "https://github.com/ariloytynoja/prank-msa/archive/refs/tags/v.251117.tar.gz" ;
    schema:identifier biotools:prank ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "prank" ;
    schema:softwareHelp "https://ariloytynoja.github.io/prank-msa" ;
    schema:softwareVersion "251117" ;
    schema:url "http://wasabiapp.org/software/prank" .

