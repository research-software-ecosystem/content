@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-iterativebmasurv a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-10-72" ;
    schema:description "The Iterative Bayesian Model Averaging (BMA) Algorithm For Survival Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/iterativeBMAsurv_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iterativeBMAsurv/iterativeBMAsurv_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iterativeBMAsurv_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-iterativebmasurv/bioconductor-iterativebmasurv_1.68.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-bma",
        "r-leaps",
        "r-survival" ;
    schema:identifier biotools:iterativebmasurv ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-iterativebmasurv" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/iterativeBMAsurv.html" .

