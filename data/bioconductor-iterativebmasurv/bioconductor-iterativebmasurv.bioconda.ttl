@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-iterativebmasurv a schema1:SoftwareApplication ;
    schema1:alternateName "The Iterative Bayesian Model Averaging (BMA) Algorithm For Survival Analysis" ;
    schema1:citation "doi:10.1186/1471-2105-10-72" ;
    schema1:description "The iterative Bayesian Model Averaging (BMA) algorithm for survival analysis is a variable selection method for applying survival analysis to microarray data." ;
    schema1:identifier biotools:iterativebmasurv ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-iterativebmasurv" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/iterativeBMAsurv.html" .

