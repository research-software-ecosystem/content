@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gcen a schema:SoftwareApplication ;
    schema:citation "doi:10.3390/cimb44040100" ;
    schema:description "GCEN: an easy-to-use toolkit for Gene Co-Expression Network analysis and lncRNAs annotation." ;
    schema:downloadUrl "https://github.com/wen-chen/gcen/releases/download/v0.6.3/gcen-0.6.3-source.tar.gz" ;
    schema:identifier biotools:gcen ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "gcen" ;
    schema:softwareHelp "https://www.biochen.org/gcen" ;
    schema:softwareVersion "0.6.3" ;
    schema:url "https://www.biochen.org/gcen" .

