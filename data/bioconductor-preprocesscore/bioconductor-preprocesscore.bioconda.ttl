@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-preprocesscore a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A collection of pre-processing functions" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/preprocessCore_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/preprocessCore/preprocessCore_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/preprocessCore_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-preprocesscore/bioconductor-preprocesscore_1.72.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:preprocesscore ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-preprocesscore" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/preprocessCore.html" .

