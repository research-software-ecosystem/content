@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-preprocesscore a schema1:SoftwareApplication ;
    schema1:alternateName "A collection of pre-processing functions" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A library of core preprocessing routines." ;
    schema1:identifier <https://bio.tools/biotools:preprocesscore> ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-preprocesscore" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/preprocessCore.html" .

