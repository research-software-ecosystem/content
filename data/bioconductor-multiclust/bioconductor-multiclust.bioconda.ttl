@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-multiclust a schema:SoftwareApplication ;
    schema:citation "doi:10.4137/cin.s38000" ;
    schema:description "multiClust: An R-package for Identifying Biologically Relevant Clusters in Cancer Transcriptome Profiles" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/multiClust_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/multiClust/multiClust_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/multiClust_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-multiclust/bioconductor-multiclust_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-ctc",
        "r-amap",
        "r-base",
        "r-cluster",
        "r-dendextend",
        "r-mclust",
        "r-survival" ;
    schema:identifier biotools:multiclust ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-multiclust" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/multiClust.html" .

