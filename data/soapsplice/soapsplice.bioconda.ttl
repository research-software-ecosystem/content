@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:soapsplice a schema:SoftwareApplication ;
    schema:citation "doi:10.3389/fgene.2011.00046" ;
    schema:description "We have developed a tool SOAPsplice for genome-wide ab initio detection of splice junction sites from RNA-Seq, a method using new generation sequencing technologies to sequence the messenger RNA." ;
    schema:downloadUrl "https://depot.galaxyproject.org/software/soapsplice/soapsplice_1.10_src_all.tar.gz" ;
    schema:identifier biotools:SOAPsplice ;
    schema:license "freely available" ;
    schema:name "soapsplice" ;
    schema:softwareVersion "1.1" ;
    schema:url "http://soap.genomics.org.cn/soapsplice.html" .

