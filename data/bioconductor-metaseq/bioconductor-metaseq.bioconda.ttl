@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-metaseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Meta-analysis of RNA-Seq count data in multiple studies" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/metaSeq_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/metaSeq/metaSeq_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/metaSeq_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metaseq/bioconductor-metaseq_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-noiseq",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-rcpp",
        "r-snow",
        "zlib" ;
    schema:identifier biotools:metaseq ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-metaseq" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/metaSeq.html" .

