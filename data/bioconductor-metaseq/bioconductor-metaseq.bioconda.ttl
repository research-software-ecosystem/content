@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-metaseq a schema1:SoftwareApplication ;
    schema1:alternateName "Meta-analysis of RNA-Seq count data in multiple studies" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The probabilities by one-sided NOISeq are combined by Fisher's method or Stouffer's method" ;
    schema1:identifier <https://bio.tools/biotools:metaseq> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-metaseq" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/metaSeq.html" .

