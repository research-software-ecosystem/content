@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-metaseq a schema1:SoftwareApplication ;
    schema1:alternateName "Meta-analysis of RNA-Seq count data in multiple studies" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The probabilities by one-sided NOISeq are combined by Fisher's method or Stouffer's method" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/metaSeq_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/metaSeq/metaSeq_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/metaSeq_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metaseq/bioconductor-metaseq_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:metaseq" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-metaseq" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/metaSeq.html" .

