@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ltr_retriever a schema:SoftwareApplication ;
    schema:citation "doi:10.1104/pp.17.01310" ;
    schema:description "Sensitive and accurate identification of LTR retrotransposons" ;
    schema:downloadUrl "https://github.com/oushujun/LTR_retriever/archive/v3.0.5.tar.gz" ;
    schema:identifier biotools:ltr_retriever ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "ltr_retriever" ;
    schema:softwareVersion "3.0.5" ;
    schema:url "https://github.com/oushujun/LTR_retriever" .

