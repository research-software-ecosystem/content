@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:biobambam a schema:SoftwareApplication ;
    schema:description "Tools for early stage alignment file processing." ;
    schema:downloadUrl "https://gitlab.com/german.tischler/biobambam2/-/archive/2.0.185-release-20221211202123/biobambam2-2.0.185-release-20221211202123.tar.gz" ;
    schema:hasPart "gmp",
        "libmaus2",
        "xerces-c",
        "zlib" ;
    schema:identifier biotools:biobambam ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "biobambam" ;
    schema:softwareVersion "2.0.185" ;
    schema:url "https://gitlab.com/german.tischler/biobambam2" .

