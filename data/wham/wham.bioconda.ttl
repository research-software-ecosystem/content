@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:wham a schema:SoftwareApplication ;
    schema:description "Structural variant detection and association testing" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Wham6216 ;
    schema:license "MIT" ;
    schema:name "wham" ;
    schema:softwareVersion "1.8.0.1.2017.05.03" ;
    schema:url "https://github.com/zeeev/wham" .

