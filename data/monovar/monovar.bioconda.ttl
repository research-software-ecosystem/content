@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:monovar a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3835" ;
    schema:description "single cell joint genotyper" ;
    schema:downloadUrl "https://bitbucket.org/dlaehnemann/monovar/get/v0.0.1.tar.gz" ;
    schema:identifier biotools:Monovar ;
    schema:license "MIT" ;
    schema:name "monovar" ;
    schema:softwareVersion "0.0.1" ;
    schema:url "https://bitbucket.org/hamimzafar/monovar" .

