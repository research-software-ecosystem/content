@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:busco a schema1:SoftwareApplication ;
    schema1:alternateName "Assessment of assembly completeness using Universal Single Copy Orthologs." ;
    schema1:citation "doi:10.1093/bioinformatics/btv351" ;
    schema1:description "BUSCO provides measures for quantitative assessment of genome assembly, gene set, and transcriptome completeness based on evolutionarily informed expectations of gene content from near-universal single-copy orthologs selected from OrthoDB." ;
    schema1:identifier biotools:busco,
        "usegalaxy-eu:busco" ;
    schema1:license "MIT" ;
    schema1:maintainer "berkelem" ;
    schema1:name "busco" ;
    schema1:softwareVersion "6.1.0" ;
    schema1:url "https://busco.ezlab.org" .

