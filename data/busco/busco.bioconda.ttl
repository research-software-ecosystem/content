@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:busco a schema:SoftwareApplication ;
    schema:author "berkelem" ;
    schema:citation "doi:10.1093/bioinformatics/btv351" ;
    schema:description "Assessment of assembly completeness using Universal Single Copy Orthologs." ;
    schema:downloadUrl "https://gitlab.com/ezlab/busco/-/archive/6.1.0/busco-6.1.0.tar.gz" ;
    schema:hasPart "augustus",
        "bbmap",
        "biopython",
        "blast",
        "hmmer",
        "matplotlib-base",
        "metaeuk",
        "miniprot",
        "numpy",
        "pandas",
        "pip",
        "prodigal",
        "python",
        "requests",
        "sepp",
        "wget" ;
    schema:identifier biotools:busco ;
    schema:license "MIT" ;
    schema:maintainer "berkelem" ;
    schema:name "busco" ;
    schema:softwareHelp "https://busco.ezlab.org/busco_userguide.html" ;
    schema:softwareVersion "6.1.0" ;
    schema:url "https://busco.ezlab.org" .

