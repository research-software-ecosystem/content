@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:blobtoolkit a schema1:SoftwareApplication ;
    schema1:alternateName "Interactive quality assessment of genome assemblies." ;
    schema1:citation "doi:10.1534/g3.119.400908" ;
    schema1:description "Interactive quality assessment of genome assemblies." ;
    schema1:identifier biotools:BlobToolKit,
        "usegalaxy-eu:blobtoolkit",
        "usegalaxy-eu:interactive_tool_blobtoolkit" ;
    schema1:license "MIT" ;
    schema1:name "blobtoolkit" ;
    schema1:softwareVersion "4.5.5" ;
    schema1:url "https://github.com/blobtoolkit/blobtoolkit" .

