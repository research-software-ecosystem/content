@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:blobtoolkit a schema:SoftwareApplication ;
    schema:citation "doi:10.1534/g3.119.400908" ;
    schema:description "Interactive quality assessment of genome assemblies." ;
    schema:downloadUrl "https://github.com/genomehubs/blobtoolkit/archive/4.5.3.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:BlobToolKit ;
    schema:license "MIT" ;
    schema:name "blobtoolkit" ;
    schema:softwareHelp "https://blobtoolkit.genomehubs.org" ;
    schema:softwareVersion "4.5.3" ;
    schema:url "https://github.com/blobtoolkit/blobtoolkit" .

