        <https://usegalaxy.fr>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org.au/published/workflow?id=0a3fb089674de144>,
        <https://workflowhub.eu/workflows/1103?version=3>,
        <https://workflowhub.eu/workflows/1104?version=2>,
        <https://workflowhub.eu/workflows/1641?version=1> ;
    schema1:keywords "Assembly",
        "Sequence Analysis" ;
    schema1:name "blobtoolkit" ;
    schema1:softwareVersion "4.5.3" ;
    schema1:url <https://github.com/bgruening/galaxytools/tree/master/tools/blobtoolkit> .

