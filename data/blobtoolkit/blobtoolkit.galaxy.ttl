        edam:topic_0621,
        edam:topic_0769,
        edam:topic_3050,
        edam:topic_3500 ;
    schema1:codeRepository <https://blobtoolkit.genomehubs.org/> ;
    schema1:dateCreated "2022-11-04" ;
    schema1:description "Identification and isolation non-target data in draft and publicly available genome assemblies." ;
    schema1:encodingFormat "svg",
        "tar.gz" ;
    schema1:featureList edam:operation_0337,
        edam:operation_0525,
        edam:operation_1812,
        edam:operation_3216,
        edam:operation_3431,
        edam:operation_3440 ;
    schema1:identifier biotools:BlobToolKit,
        bioconda:blobtoolkit ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=3069c17b52decab4>,
