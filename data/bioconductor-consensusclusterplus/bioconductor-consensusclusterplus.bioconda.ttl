@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-consensusclusterplus a schema:SoftwareApplication ;
    schema:description "ConsensusClusterPlus" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ConsensusClusterPlus_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ConsensusClusterPlus/ConsensusClusterPlus_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ConsensusClusterPlus_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-consensusclusterplus/bioconductor-consensusclusterplus_1.74.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-all",
        "bioconductor-biobase",
        "r-base",
        "r-cluster" ;
    schema:identifier biotools:consensusclusterplus ;
    schema:license "GPL version 2" ;
    schema:name "bioconductor-consensusclusterplus" ;
    schema:softwareVersion "1.74.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ConsensusClusterPlus.html" .

