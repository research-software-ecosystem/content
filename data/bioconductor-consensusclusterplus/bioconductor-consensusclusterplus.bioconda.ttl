@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-consensusclusterplus a schema1:SoftwareApplication ;
    schema1:alternateName "ConsensusClusterPlus" ;
    schema1:description "algorithm for determining cluster count and membership by stability evidence in unsupervised analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ConsensusClusterPlus_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ConsensusClusterPlus/ConsensusClusterPlus_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ConsensusClusterPlus_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-consensusclusterplus/bioconductor-consensusclusterplus_1.74.0_src_all.tar.gz" ;
    schema1:identifier "biotools:consensusclusterplus" ;
    schema1:license "GPL version 2" ;
    schema1:name "bioconductor-consensusclusterplus" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ConsensusClusterPlus.html" .

