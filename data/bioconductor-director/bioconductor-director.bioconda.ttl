@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-director a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A dynamic visualization tool of multi-level data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Director_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/Director/Director_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Director_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-director/bioconductor-director_1.32.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-htmltools" ;
    schema:identifier biotools:director ;
    schema:license "GPL-3 + file LICENSE" ;
    schema:name "bioconductor-director" ;
    schema:softwareVersion "1.32.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/Director.html" .

