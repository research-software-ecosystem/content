@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rtracklayer a schema1:SoftwareApplication ;
    schema1:alternateName "R interface to genome annotation files and the UCSC genome browser" ;
    schema1:description "Extensible framework for interacting with multiple genome browsers (currently UCSC built-in) and manipulating annotation tracks in various formats (currently GFF, BED, bedGraph, BED15, WIG, BigWig and 2bit built-in). The user may export/import tracks to/from the supported browsers, as well as query and modify the browser state, such as the current viewport." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rtracklayer_1.70.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rtracklayer/rtracklayer_1.70.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rtracklayer_1.70.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtracklayer/bioconductor-rtracklayer_1.70.1_src_all.tar.gz" ;
    schema1:identifier "biotools:rtracklayer" ;
    schema1:license "Artistic-2.0 + file LICENSE" ;
    schema1:name "bioconductor-rtracklayer" ;
    schema1:softwareVersion "1.70.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rtracklayer.html" .

