@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtracklayer a schema:SoftwareApplication ;
    schema:description "R interface to genome annotation files and the UCSC genome browser" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rtracklayer_1.70.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rtracklayer/rtracklayer_1.70.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rtracklayer_1.70.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtracklayer/bioconductor-rtracklayer_1.70.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocio",
        "bioconductor-biostrings",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-curl",
        "r-httr",
        "r-restfulr",
        "r-xml",
        "zlib" ;
    schema:identifier biotools:rtracklayer ;
    schema:license "Artistic-2.0 + file LICENSE" ;
    schema:name "bioconductor-rtracklayer" ;
    schema:softwareVersion "1.70.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rtracklayer.html" .

