@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-derfinderhelper a schema1:SoftwareApplication ;
    schema1:alternateName "derfinder helper package" ;
    schema1:description "Helper package for speeding up the derfinder package when using multiple cores. This package is particularly useful when using BiocParallel and it helps reduce the time spent loading the full derfinder package when running the F-statistics calculation in parallel." ;
    schema1:identifier biotools:derfinderhelper ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-derfinderhelper" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/derfinderHelper.html" .

