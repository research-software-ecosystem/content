@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-derfinderhelper a schema:SoftwareApplication ;
    schema:description "derfinder helper package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/derfinderHelper_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/derfinderHelper/derfinderHelper_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/derfinderHelper_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-derfinderhelper/bioconductor-derfinderhelper_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base",
        "r-matrix" ;
    schema:identifier biotools:derfinderhelper ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-derfinderhelper" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/derfinderHelper.html" .

