@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:jbrowse a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.094607.109" ;
    schema:description "The JBrowse Genome Browser" ;
    schema:downloadUrl "https://github.com/GMOD/jbrowse/archive/1.16.11-release.zip" ;
    schema:hasPart "git",
        "nodejs",
        "perl",
        "perl-bio-featureio",
        "perl-bio-gff3",
        "perl-bioperl",
        "perl-capture-tiny",
        "perl-db-file",
        "perl-devel-size",
        "perl-digest-crc32",
        "perl-exporter-tiny",
        "perl-file-copy-recursive",
        "perl-file-next",
        "perl-hash-merge",
        "perl-heap-simple",
        "perl-io-uncompress-gunzip",
        "perl-json",
        "perl-list-moreutils",
        "perl-local-lib",
        "perl-perlio-gzip",
        "perl-scalar-list-utils",
        "perl-test-deep",
        "perl-test-simple",
        "perl-test-warn",
        "perl-uri",
        "python" ;
    schema:identifier biotools:jbrowse ;
    schema:license "LGPL" ;
    schema:name "jbrowse" ;
    schema:softwareVersion "1.16.11" ;
    schema:url "https://jbrowse.org/" .

