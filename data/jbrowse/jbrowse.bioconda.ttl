@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:jbrowse a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1101/gr.094607.109" ;
    schema1:description "The JBrowse Genome Browser" ;
    schema1:downloadUrl "https://github.com/GMOD/jbrowse/archive/1.16.11-release.zip" ;
    schema1:hasPart "git",
        "nodejs",
        "perl",
        "perl-bio-featureio",
        "perl-bio-gff3",
        "perl-bioperl",
        "perl-capture-tiny",
        "perl-db-file",
        "perl-devel-size",
        "perl-digest-crc32",
        "perl-exporter-tiny",
        "perl-file-copy-recursive",
        "perl-file-next",
        "perl-hash-merge",
        "perl-heap-simple",
        "perl-io-uncompress-gunzip",
        "perl-json",
        "perl-list-moreutils",
        "perl-local-lib",
        "perl-perlio-gzip",
        "perl-scalar-list-utils",
        "perl-test-deep",
        "perl-test-simple",
        "perl-test-warn",
        "perl-uri",
        "python" ;
    schema1:identifier biotools:jbrowse ;
    schema1:license "LGPL" ;
    schema1:name "jbrowse" ;
    schema1:softwareVersion "1.16.11" ;
    schema1:url "https://jbrowse.org/" .

