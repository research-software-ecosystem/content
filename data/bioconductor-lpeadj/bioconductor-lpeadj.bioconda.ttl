@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lpeadj a schema1:SoftwareApplication ;
    schema1:alternateName "A correction of the local pooled error (LPE) method to replace the asymptotic variance adjustment with an unbiased adjustment based on sample size." ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Two options are added to the LPE algorithm. The original LPE method sets all variances below the max variance in the ordered distribution of variances to the maximum variance. in LPEadj this option is turned off by default.  The second option is to use a variance adjustment based on sample size rather than pi/2.  By default the LPEadj uses the sample size based variance adjustment." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/LPEadj_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/LPEadj/LPEadj_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/LPEadj_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lpeadj/bioconductor-lpeadj_1.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:lpeadj" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-lpeadj" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/LPEadj.html" .

