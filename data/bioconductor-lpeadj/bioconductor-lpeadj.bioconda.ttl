@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lpeadj a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A correction of the local pooled error (LPE) method to replace the asymptotic variance adjustment with an unbiased adjustment based on sample size." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/LPEadj_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/LPEadj/LPEadj_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/LPEadj_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lpeadj/bioconductor-lpeadj_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-lpe",
        "r-base" ;
    schema:identifier biotools:lpeadj ;
    schema:license "LGPL" ;
    schema:name "bioconductor-lpeadj" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/LPEadj.html" .

