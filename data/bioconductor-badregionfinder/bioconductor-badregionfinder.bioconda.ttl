@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-badregionfinder a schema1:SoftwareApplication ;
    schema1:alternateName "BadRegionFinder: an R/Bioconductor package for identifying regions with bad coverage" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "BadRegionFinder is a package for identifying regions with a bad, acceptable and good coverage in sequence alignment data available as bam files. The whole genome may be considered as well as a set of target regions. Various visual and textual types of output are available." ;
    schema1:identifier <https://bio.tools/biotools:badregionfinder> ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-badregionfinder" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BadRegionFinder.html" .

