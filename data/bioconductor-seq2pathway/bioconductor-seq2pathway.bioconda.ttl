@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-seq2pathway a schema:SoftwareApplication ;
    schema:description "a novel tool for functional gene-set (or termed as pathway) analysis of next-generation sequencing data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/seq2pathway_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/seq2pathway/seq2pathway_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/seq2pathway_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-seq2pathway/bioconductor-seq2pathway_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biomart",
        "bioconductor-genomicranges",
        "bioconductor-seq2pathway.data",
        "r-base",
        "r-gsa",
        "r-nnet",
        "r-wgcna" ;
    schema:identifier biotools:seq2pathway ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-seq2pathway" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/seq2pathway.html" .

