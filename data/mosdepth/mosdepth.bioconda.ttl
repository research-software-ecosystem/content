@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mosdepth a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx699" ;
    schema:description "Fast BAM/CRAM depth calculation for WGS, exome, or targeted sequencing." ;
    schema:downloadUrl "https://github.com/brentp/mosdepth/archive/refs/tags/v0.3.14.tar.gz" ;
    schema:hasPart "bzip2",
        "curl",
        "htslib",
        "tar",
        "xz",
        "zlib" ;
    schema:identifier biotools:mosdepth ;
    schema:license "MIT" ;
    schema:name "mosdepth" ;
    schema:softwareHelp "https://github.com/brentp/mosdepth/blob/v0.3.14/README.md" ;
    schema:softwareVersion "0.3.14" ;
    schema:url "https://github.com/brentp/mosdepth" .

