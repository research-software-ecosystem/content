@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mosdepth a schema1:SoftwareApplication ;
    schema1:alternateName "Fast BAM/CRAM depth calculation for WGS, exome, or targeted sequencing." ;
    schema1:citation "doi:10.1093/bioinformatics/btx699" ;
    schema1:description "Fast BAM/CRAM depth calculation for WGS, exome, or targeted sequencing." ;
    schema1:downloadUrl "https://github.com/brentp/mosdepth/archive/refs/tags/v0.3.14.tar.gz" ;
    schema1:identifier "biotools:mosdepth",
        "usegalaxy-eu:mosdepth" ;
    schema1:license "MIT" ;
    schema1:name "mosdepth" ;
    schema1:softwareVersion "0.3.14" ;
    schema1:url "https://github.com/brentp/mosdepth" .

