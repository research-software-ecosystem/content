@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cogena a schema1:SoftwareApplication ;
    schema1:alternateName "co-expressed gene-set enrichment analysis" ;
    schema1:citation "doi:10.1186/s12864-016-2737-8" ;
    schema1:description "cogena is a workflow for co-expressed gene-set enrichment analysis. It aims to discovery smaller scale, but highly correlated cellular events that may be of great biological relevance. A novel pipeline for drug discovery and drug repositioning based on the cogena workflow is proposed. Particularly, candidate drugs can be predicted based on the gene expression of disease-related data, or other similar drugs can be identified based on the gene expression of drug-related data. Moreover, the drug mode of action can be disclosed by the associated pathway analysis. In summary, cogena is a flexible workflow for various gene set enrichment analysis for co-expressed genes, with a focus on pathway/GO analysis and drug repositioning." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/cogena_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cogena/cogena_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cogena_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cogena/bioconductor-cogena_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cogena" ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-cogena" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cogena.html" .

