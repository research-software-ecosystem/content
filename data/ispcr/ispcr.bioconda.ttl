@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ispcr a schema:SoftwareApplication ;
    schema:description "In silico PCR" ;
    schema:downloadUrl "https://users.soe.ucsc.edu/~kent/src/isPcr33.zip" ;
    schema:identifier biotools:ispcr ;
    schema:license "License is hereby granted for personal, academic, and non-profit use." ;
    schema:name "ispcr" ;
    schema:softwareVersion "33" ;
    schema:url "https://users.soe.ucsc.edu/~kent/" .

