@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gewist a schema1:SoftwareApplication ;
    schema1:alternateName "Gene Environment Wide Interaction Search Threshold" ;
    schema1:citation "doi:10.1002/gepi.20624" ;
    schema1:description "This 'GEWIST' package provides statistical tools to efficiently optimize SNP prioritization for gene-gene and gene-environment interactions." ;
    schema1:identifier biotools:gewist ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-gewist" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GEWIST.html" .

