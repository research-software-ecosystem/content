@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gewist a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/gepi.20624" ;
    schema:description "Gene Environment Wide Interaction Search Threshold" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GEWIST_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEWIST/GEWIST_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GEWIST_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gewist/bioconductor-gewist_1.54.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-car" ;
    schema:identifier biotools:gewist ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-gewist" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GEWIST.html" .

