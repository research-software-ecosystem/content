@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:beagle a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ajhg.2018.07.015",
        "doi:10.1086/521987" ;
    schema:description "Beagle is a software package for phasing genotypes and for imputing ungenotyped markers." ;
    schema:downloadUrl "https://faculty.washington.edu/browning/beagle/beagle.27Feb25.75f.jar" ;
    schema:identifier biotools:BEAGLE ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "beagle" ;
    schema:softwareHelp "https://faculty.washington.edu/browning/beagle/beagle_5.4_18Mar22.pdf" ;
    schema:softwareVersion "5.5_27Feb25.75f" ;
    schema:url "http://faculty.washington.edu/browning/beagle/beagle.html" .

