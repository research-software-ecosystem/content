@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bufferedmatrix a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A matrix data storage object held in temporary files" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BufferedMatrix_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BufferedMatrix/BufferedMatrix_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BufferedMatrix_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bufferedmatrix/bioconductor-bufferedmatrix_1.74.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:bufferedmatrix ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-bufferedmatrix" ;
    schema:softwareVersion "1.74.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BufferedMatrix.html" .

