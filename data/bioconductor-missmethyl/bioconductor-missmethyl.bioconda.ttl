@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-missmethyl a schema1:SoftwareApplication ;
    schema1:description "Analysing Illumina HumanMethylation BeadChip Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/missMethyl_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/missMethyl/missMethyl_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/missMethyl_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-missmethyl/bioconductor-missmethyl_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-go.db",
        "bioconductor-illuminahumanmethylation450kanno.ilmn12.hg19",
        "bioconductor-illuminahumanmethylation450kmanifest",
        "bioconductor-illuminahumanmethylationepicanno.ilm10b4.hg19",
        "bioconductor-illuminahumanmethylationepicmanifest",
        "bioconductor-illuminahumanmethylationepicv2anno.20a1.hg38",
        "bioconductor-illuminahumanmethylationepicv2manifest",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-methylumi",
        "bioconductor-minfi",
        "bioconductor-org.hs.eg.db",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-biasedurn",
        "r-ruv",
        "r-statmod",
        "r-stringr" ;
    schema1:identifier biotools:missmethyl ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-missmethyl" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/missMethyl.html" .

