@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-blima a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Tools for the preprocessing and analysis of the Illumina microarrays on the detector (bead) level" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/blima_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/blima/blima_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/blima_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-blima/bioconductor-blima_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-beadarray",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "r-base",
        "r-rcpp" ;
    schema:identifier biotools:blima ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-blima" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/blima.html" .

