@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clonality a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr268" ;
    schema:description "Clonality testing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Clonality_1.47.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/Clonality/Clonality_1.47.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Clonality_1.47.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clonality/bioconductor-clonality_1.47.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-dnacopy",
        "r-base" ;
    schema:identifier biotools:clonality ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-clonality" ;
    schema:softwareVersion "1.47.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/Clonality.html" .

