@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clonality a schema1:SoftwareApplication ;
    schema1:alternateName "Clonality testing" ;
    schema1:citation "doi:10.1093/bioinformatics/btr268" ;
    schema1:description "Statistical tests for clonality versus independence of tumors from the same patient based on their LOH or genomewide copy number profiles" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Clonality_1.47.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/Clonality/Clonality_1.47.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Clonality_1.47.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clonality/bioconductor-clonality_1.47.0_src_all.tar.gz" ;
    schema1:identifier "biotools:clonality" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-clonality" ;
    schema1:softwareVersion "1.47.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/Clonality.html" .

