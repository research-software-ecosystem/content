@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:longshot a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-019-12493-y" ;
    schema:description "Diploid SNV caller for error-prone reads." ;
    schema:downloadUrl "https://github.com/pjedge/longshot/archive/v1.0.0.tar.gz" ;
    schema:hasPart "clangdev",
        "xz",
        "zlib" ;
    schema:identifier biotools:longshot ;
    schema:license "MIT" ;
    schema:name "longshot" ;
    schema:softwareHelp "https://github.com/pjedge/longshot/blob/v(( version }}/README.md" ;
    schema:softwareVersion "1.0.0" ;
    schema:url "https://github.com/pjedge/longshot" .

