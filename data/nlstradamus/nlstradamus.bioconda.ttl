@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:nlstradamus a schema1:SoftwareApplication ;
    schema1:alternateName "NLStradamus: a simple Hidden Markov Model for nuclear localization signal prediction." ;
