@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:nlstradamus a schema:SoftwareApplication ;
    schema:description "NLStradamus: a simple Hidden Markov Model for nuclear localization signal prediction." ;
    schema:downloadUrl "http://www.moseslab.csb.utoronto.ca/NLStradamus/NLStradamus/NLStradamus.1.8.tar.gz" ;
    schema:identifier biotools:NLStradamus ;
    schema:license "GNU General Public License v3 or later (GPLv3+)" ;
    schema:name "nlstradamus" ;
    schema:softwareVersion "1.8" ;
    schema:url "http://www.moseslab.csb.utoronto.ca/NLStradamus/" .

