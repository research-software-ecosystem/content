@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bowtie2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.1923" ;
    schema:description "A fast and sensitive gapped read aligner." ;
    schema:downloadUrl "https://github.com/BenLangmead/bowtie2/archive/v2.5.5.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "zlib",
        "zstd" ;
    schema:identifier biotools:bowtie2 ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "bowtie2" ;
    schema:softwareHelp "https://github.com/BenLangmead/bowtie2/blob/v2.5.5/README.md" ;
    schema:softwareVersion "2.5.5" ;
    schema:url "https://bowtie-bio.sourceforge.net/bowtie2/index.shtml" .

