@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biocstyle a schema1:SoftwareApplication ;
    schema1:alternateName "Standard styles for vignettes and other Bioconductor documents" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Provides standard formatting styles for Bioconductor PDF and HTML documents. Package vignettes illustrate use and functionality." ;
    schema1:identifier <https://bio.tools/biotools:biocstyle> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biocstyle" ;
    schema1:softwareVersion "2.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BiocStyle.html" .

