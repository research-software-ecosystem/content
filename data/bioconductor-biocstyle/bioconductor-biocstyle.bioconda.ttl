@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biocstyle a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Standard styles for vignettes and other Bioconductor documents" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BiocStyle_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocStyle/BiocStyle_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiocStyle_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocstyle/bioconductor-biocstyle_2.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-biocmanager",
        "r-bookdown",
        "r-knitr",
        "r-rmarkdown",
        "r-yaml" ;
    schema:identifier biotools:biocstyle ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-biocstyle" ;
    schema:softwareVersion "2.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BiocStyle.html" .

