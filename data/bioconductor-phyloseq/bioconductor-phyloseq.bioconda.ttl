@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-phyloseq a schema1:SoftwareApplication ;
    schema1:alternateName "Handling and analysis of high-throughput microbiome census data" ;
    schema1:description "phyloseq provides a set of classes and tools to facilitate the import, storage, analysis, and graphical display of microbiome census data." ;
    schema1:identifier biotools:phyloseq ;
    schema1:license "AGPL-3" ;
    schema1:name "bioconductor-phyloseq" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/phyloseq.html" .

