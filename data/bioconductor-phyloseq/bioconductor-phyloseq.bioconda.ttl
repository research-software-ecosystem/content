@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-phyloseq a schema:SoftwareApplication ;
    schema:description "Handling and analysis of high-throughput microbiome census data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/phyloseq_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/phyloseq/phyloseq_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/phyloseq_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-phyloseq/bioconductor-phyloseq_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biomformat",
        "bioconductor-biostrings",
        "bioconductor-multtest",
        "r-ade4",
        "r-ape",
        "r-base",
        "r-cluster",
        "r-data.table",
        "r-foreach",
        "r-ggplot2",
        "r-igraph",
        "r-plyr",
        "r-reshape2",
        "r-scales",
        "r-vegan" ;
    schema:identifier biotools:phyloseq ;
    schema:license "AGPL-3" ;
    schema:name "bioconductor-phyloseq" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/phyloseq.html" .

