@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-proper a schema1:SoftwareApplication ;
    schema1:alternateName "PROspective Power Evaluation for RNAseq" ;
    schema1:description "This package provide simulation based methods for evaluating the statistical power in differential expression analysis from RNA-seq data." ;
    schema1:identifier biotools:proper ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-proper" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PROPER.html" .

