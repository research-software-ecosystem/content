@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-proper a schema:SoftwareApplication ;
    schema:description "PROspective Power Evaluation for RNAseq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PROPER_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PROPER/PROPER_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PROPER_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-proper/bioconductor-proper_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-edger",
        "r-base" ;
    schema:identifier biotools:proper ;
    schema:license "GPL" ;
    schema:name "bioconductor-proper" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PROPER.html" .

