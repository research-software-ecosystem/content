@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:r-sartools a schema:SoftwareApplication ;
    schema:author "ArneKr",
        "FrodePedersen",
        "MathiasHaudgaard",
        "bgruening",
        "daler",
        "hvaret",
        "jdblischak",
        "johanneskoester" ;
    schema:description "Statistical Analysis of RNA-Seq data." ;
    schema:downloadUrl "https://github.com/PF2-pasteur-fr/SARTools/archive/v1.8.2.tar.gz" ;
    schema:hasPart "bioconductor-deseq2",
        "bioconductor-edger",
        "bioconductor-genefilter",
        "r-ashr",
        "r-base",
        "r-bit64",
        "r-blob",
        "r-ggally",
        "r-ggdendro",
        "r-ggplot2",
        "r-ggrepel",
        "r-gridextra",
        "r-kableextra",
        "r-knitr",
        "r-optparse",
        "r-rmarkdown" ;
    schema:identifier biotools:sartools ;
    schema:license "GPL-2.0-or-later" ;
    schema:maintainer "ArneKr",
        "FrodePedersen",
        "MathiasHaudgaard",
        "bgruening",
        "daler",
        "hvaret",
        "jdblischak",
        "johanneskoester" ;
    schema:name "r-sartools" ;
    schema:softwareVersion "1.8.2" ;
    schema:url "https://github.com/PF2-pasteur-fr/SARTools" .

