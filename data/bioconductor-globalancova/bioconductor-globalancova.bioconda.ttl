@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-globalancova a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm531" ;
    schema:description "Global test for groups of variables via model comparisons" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GlobalAncova_4.28.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GlobalAncova/GlobalAncova_4.28.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GlobalAncova_4.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-globalancova/bioconductor-globalancova_4.28.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-globaltest",
        "bioconductor-gseabase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-corpcor",
        "r-dendextend",
        "r-vgam",
        "zlib" ;
    schema:identifier biotools:globalancova ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-globalancova" ;
    schema:softwareVersion "4.28.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GlobalAncova.html" .

