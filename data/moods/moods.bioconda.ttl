@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:moods a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/TCBB.2009.35" ;
    schema:description "MOODS: Motif Occurrence Detection Suite" ;
    schema:downloadUrl "https://pypi.io/packages/source/m/mira-moods/mira-moods-1.9.4.2.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:MOODS ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "moods" ;
    schema:softwareHelp "https://github.com/jhkorhonen/MOODS/wiki" ;
    schema:softwareVersion "1.9.4.2" ;
    schema:url "https://www.cs.helsinki.fi/group/pssmfind" .

