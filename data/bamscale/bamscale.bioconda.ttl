@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bamscale a schema:SoftwareApplication ;
    schema:description "BAMscale is a one-step tool for either 1) quantifying and normalizing the coverage of peaks." ;
    schema:hasPart "bzip2",
        "htslib",
        "libbigwig",
        "libcurl",
        "xz",
        "zlib" ;
    schema:identifier biotools:bamscale ;
    schema:license "Public Domain" ;
    schema:name "bamscale" ;
    schema:softwareHelp "https://github.com/ncbi/BAMscale/wiki" ;
    schema:softwareVersion "0.0.9" ;
    schema:url "https://github.com/ncbi/BAMscale" .

