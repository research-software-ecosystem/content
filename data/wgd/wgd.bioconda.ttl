@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:wgd a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-0716-2561-3_1",
        "doi:10.1093/bioinformatics/btae272" ;
    schema:description "wgd v2: a suite of tools to uncover and date ancient polyploidy and whole-genome duplication" ;
    schema:downloadUrl "https://pypi.io/packages/source/w/wgd/wgd-2.0.38.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:wgd ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "wgd" ;
    schema:softwareHelp "https://wgdv2.readthedocs.io/en/latest/" ;
    schema:softwareVersion "2.0.38" ;
    schema:url "https://github.com/heche-psb/wgd" .

