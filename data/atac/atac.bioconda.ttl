@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:atac a schema:SoftwareApplication ;
    schema:description "ATAC is a computational process for comparative mapping between two genome assemblies, or between two different genomes." ;
    schema:downloadUrl "http://sourceforge.net/projects/kmer/files/ATAC-r2008.tar.bz2" ;
    schema:hasPart "bzip2",
        "perl",
        "python" ;
    schema:identifier biotools:atac ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "atac" ;
    schema:softwareVersion "2008" ;
    schema:url "https://sourceforge.net/projects/kmer" .

