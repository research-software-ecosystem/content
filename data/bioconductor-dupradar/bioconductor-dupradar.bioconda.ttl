@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dupradar a schema:SoftwareApplication ;
    schema:description "Assessment of duplication rates in RNA-Seq datasets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/dupRadar_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dupRadar/dupRadar_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dupRadar_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dupradar/bioconductor-dupradar_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rsubread",
        "r-base",
        "r-kernsmooth" ;
    schema:identifier biotools:dupradar ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-dupradar" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/dupRadar.html" .

