@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dupradar a schema1:SoftwareApplication ;
    schema1:alternateName "Assessment of duplication rates in RNA-Seq datasets" ;
    schema1:description "Duplication rate quality control for RNA-Seq datasets." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/dupRadar_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dupRadar/dupRadar_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dupRadar_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dupradar/bioconductor-dupradar_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dupradar" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-dupradar" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/dupRadar.html" .

