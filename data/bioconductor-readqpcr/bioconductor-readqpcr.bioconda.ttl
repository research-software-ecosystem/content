@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-readqpcr a schema:SoftwareApplication ;
    schema:description "Read qPCR data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ReadqPCR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ReadqPCR/ReadqPCR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ReadqPCR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-readqpcr/bioconductor-readqpcr_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:readqpcr ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-readqpcr" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ReadqPCR.html" .

