@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-readqpcr a schema1:SoftwareApplication ;
    schema1:alternateName "Read qPCR data" ;
    schema1:description "The package provides functions to read raw RT-qPCR data of different platforms." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ReadqPCR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ReadqPCR/ReadqPCR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ReadqPCR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-readqpcr/bioconductor-readqpcr_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:readqpcr" ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-readqpcr" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ReadqPCR.html" .

