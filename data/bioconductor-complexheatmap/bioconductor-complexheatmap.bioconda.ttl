@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-complexheatmap a schema:SoftwareApplication ;
    schema:description "Make Complex Heatmaps" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ComplexHeatmap_2.26.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ComplexHeatmap/ComplexHeatmap_2.26.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ComplexHeatmap_2.26.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-complexheatmap/bioconductor-complexheatmap_2.26.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-iranges",
        "r-base",
        "r-circlize",
        "r-clue",
        "r-codetools",
        "r-colorspace",
        "r-digest",
        "r-doparallel",
        "r-foreach",
        "r-getoptlong",
        "r-globaloptions",
        "r-matrixstats",
        "r-png",
        "r-rcolorbrewer" ;
    schema:identifier biotools:complexheatmap ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-complexheatmap" ;
    schema:softwareVersion "2.26.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ComplexHeatmap.html" .

