@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-complexheatmap a schema1:SoftwareApplication ;
    schema1:alternateName "Make Complex Heatmaps" ;
    schema1:description "Complex heatmaps are efficient to visualize associations between different sources of data sets and reveal potential patterns. Here the ComplexHeatmap package provides a highly flexible way to arrange multiple heatmaps and supports various annotation graphics." ;
    schema1:identifier biotools:complexheatmap ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-complexheatmap" ;
    schema1:softwareVersion "2.26.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ComplexHeatmap.html" .

