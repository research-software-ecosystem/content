@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-degseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp612" ;
    schema:description "Identify Differentially Expressed Genes from RNA-seq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DEGseq_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEGseq/DEGseq_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DEGseq_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-degseq/bioconductor-degseq_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-qvalue",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:degseq ;
    schema:license "LGPL (>=2)" ;
    schema:name "bioconductor-degseq" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DEGseq.html" .

