@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-degseq a schema1:SoftwareApplication ;
    schema1:alternateName "Identify Differentially Expressed Genes from RNA-seq data" ;
    schema1:citation "doi:10.1093/bioinformatics/btp612" ;
    schema1:description "DEGseq is an R package to identify differentially expressed genes from RNA-Seq data." ;
    schema1:identifier biotools:degseq ;
    schema1:license "LGPL (>=2)" ;
    schema1:name "bioconductor-degseq" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DEGseq.html" .

