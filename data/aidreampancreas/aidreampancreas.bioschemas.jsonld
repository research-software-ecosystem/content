  "@id": "https://bio.tools/aidreampancreas",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:additionalType": "Web application",
  "sc:applicationSubCategory": {
    "@id": "edam:topic_3384"
  },
  "sc:description": "AIDREAMPancreas is a medical imaging application designed to support the \nreview, annotation, and classification of pancreatic lesions on CT. It \nprovides automatic pancreas segmentation that can be manually \nadjusted by the user, as well as dedicated segmentation tools for \nlesion annotation. The application enables users to classify individual \nlesions through structured forms and to perform an overall \nassessment of the pancreatic condition using standardized \nclassification workflows. The tool is intended to assist clinicians and \nresearchers in the consistent analysis and annotation of pancreatic \nimaging data",
  "sc:isAccessibleForFree": false,
  "sc:license": "Proprietary",
  "sc:name": "AIDREAMPancreas",
  "sc:operatingSystem": [
    "Linux",
    "Mac",
    "Windows"
  ],
  "sc:softwareVersion": "v1.0.0",
  "sc:url": "https://www.gehealthcare.com/fr-fr/products/aidream?srsltid=AfmBOopYODl1h_6v87tRP_XC9t7-SHF-14tASDCJd1iRQiF8qUmZAnU3"
