  "@id": "https://bio.tools/samen_meten_knowledge_portal",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "The (Dutch) knowledge portal focuses on the exchange of information. Technological developments enable anyone to measure for example air quality or noise with increasing accuracy. But when are measurements meaningful? how do you perform  measurements in the best possible way? and who else is developing new methods? To answer these questions, the knowledge portal offers an overview of the materials, sensors and devices that are available for environmental measurements. We also provide information about citizen science projects and the sharing and use of data.",
  "sc:name": "Samen Meten Knowledge Portal",
  "sc:url": "https://www.samenmeten.nl/"
}