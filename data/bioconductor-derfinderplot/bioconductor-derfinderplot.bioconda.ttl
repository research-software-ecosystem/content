@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-derfinderplot a schema1:SoftwareApplication ;
    schema1:alternateName "Plotting functions for derfinder" ;
    schema1:description "This package provides plotting functions for results from the derfinder package. This helps separate the graphical dependencies required for making these plots from the core functionality of derfinder." ;
    schema1:identifier biotools:derfinderplot ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-derfinderplot" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/derfinderPlot.html" .

