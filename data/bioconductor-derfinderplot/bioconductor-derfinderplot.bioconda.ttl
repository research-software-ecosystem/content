@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-derfinderplot a schema1:SoftwareApplication ;
    schema1:description "Plotting functions for derfinder" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/derfinderPlot_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/derfinderPlot/derfinderPlot_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/derfinderPlot_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-derfinderplot/bioconductor-derfinderplot_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-derfinder",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-ggbio",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-ggplot2",
        "r-plyr",
        "r-rcolorbrewer",
        "r-reshape2",
        "r-scales" ;
    schema1:identifier biotools:derfinderplot ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-derfinderplot" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/derfinderPlot.html" .

