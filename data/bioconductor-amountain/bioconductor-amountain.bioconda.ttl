@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-amountain a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/056952" ;
    schema:description "Active modules for multilayer weighted gene co-expression networks: a continuous optimization approach" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/AMOUNTAIN_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AMOUNTAIN_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AMOUNTAIN/AMOUNTAIN_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-amountain/bioconductor-amountain_1.36.0_src_all.tar.gz" ;
    schema:hasPart "gsl",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:amountain ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-amountain" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/AMOUNTAIN.html" .

