@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-amountain a schema1:SoftwareApplication ;
    schema1:alternateName "Active modules for multilayer weighted gene co-expression networks: a continuous optimization approach" ;
    schema1:citation "doi:10.1101/056952" ;
    schema1:description "A pure data-driven gene network, weighted gene co-expression network (WGCN) could be constructed only from expression profile. Different layers in such networks may represent different time points, multiple conditions or various species. AMOUNTAIN aims to search active modules in multi-layer WGCN using a continuous optimization approach." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/AMOUNTAIN_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AMOUNTAIN_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AMOUNTAIN/AMOUNTAIN_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-amountain/bioconductor-amountain_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:amountain" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-amountain" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AMOUNTAIN.html" .

