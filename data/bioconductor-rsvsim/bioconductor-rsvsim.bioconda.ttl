@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rsvsim a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt198" ;
    schema:description "RSVSim: an R/Bioconductor package for the simulation of structural variations" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RSVSim_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RSVSim/RSVSim_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RSVSim_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rsvsim/bioconductor-rsvsim_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-shortread",
        "r-base" ;
    schema:identifier biotools:rsvsim ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-rsvsim" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RSVSim.html" .

