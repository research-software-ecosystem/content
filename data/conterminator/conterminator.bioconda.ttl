@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:conterminator a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-020-02023-1" ;
    schema:description "Conterminator: software to detect contamination in large sequence sets" ;
    schema:downloadUrl "https://github.com/martin-steinegger/conterminator/archive/1-c74b5.tar.gz" ;
    schema:hasPart "bzip2",
        "gawk",
        "openmp",
        "perl",
        "zlib" ;
    schema:identifier biotools:conterminator ;
    schema:license "GPL3" ;
    schema:name "conterminator" ;
    schema:softwareVersion "1.c74b5" ;
    schema:url "https://github.com/martin-steinegger/conterminator" .

