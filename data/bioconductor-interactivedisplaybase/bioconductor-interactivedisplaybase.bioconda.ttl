@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-interactivedisplaybase a schema1:SoftwareApplication ;
    schema1:alternateName "Base package for enabling powerful shiny web displays of Bioconductor objects" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The interactiveDisplayBase package contains the the basic methods needed to generate interactive Shiny based display methods for Bioconductor objects." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/interactiveDisplayBase_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/interactiveDisplayBase/interactiveDisplayBase_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/interactiveDisplayBase_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-interactivedisplaybase/bioconductor-interactivedisplaybase_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:interactivedisplaybase" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-interactivedisplaybase" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/interactiveDisplayBase.html" .

