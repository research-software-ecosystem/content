@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-interactivedisplaybase a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Base package for enabling powerful shiny web displays of Bioconductor objects" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/interactiveDisplayBase_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/interactiveDisplayBase/interactiveDisplayBase_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/interactiveDisplayBase_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-interactivedisplaybase/bioconductor-interactivedisplaybase_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "r-base",
        "r-dt",
        "r-shiny" ;
    schema:identifier biotools:interactivedisplaybase ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-interactivedisplaybase" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/interactiveDisplayBase.html" .

