@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-interactivedisplaybase a schema1:SoftwareApplication ;
    schema1:alternateName "Base package for enabling powerful shiny web displays of Bioconductor objects" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The interactiveDisplayBase package contains the the basic methods needed to generate interactive Shiny based display methods for Bioconductor objects." ;
    schema1:identifier <https://bio.tools/biotools:interactivedisplaybase> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-interactivedisplaybase" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/interactiveDisplayBase.html" .

