@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ucsc-bedrestricttopositions a schema1:SoftwareApplication ;
    schema1:alternateName "Filter bed file, restricting to only ones that match chrom/start/ends specified in restrict.bed file." ;
    schema1:citation "doi:10.1093/bib/bbs038" ;
    schema1:description "Filter bed file, restricting to only ones that match chrom/start/ends specified in restrict.bed file." ;
    schema1:identifier biotools:UCSC_Genome_Browser_Utilities ;
    schema1:license "Varies; see https://genome.ucsc.edu/license" ;
    schema1:name "ucsc-bedrestricttopositions" ;
    schema1:softwareVersion "482" ;
    schema1:url "https://hgdownload.cse.ucsc.edu/admin/exe" .

