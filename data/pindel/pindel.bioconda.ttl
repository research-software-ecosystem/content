@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pindel a schema:SoftwareApplication ;
    schema:description "Pindel can detect breakpoints of large deletions, medium sized insertions, inversions, tandem duplications and other structural variants at single-based resolution from next-gen sequence data" ;
    schema:downloadUrl "https://github.com/genome/pindel/archive/b706fba.tar.gz" ;
    schema:hasPart "htslib",
        "zlib" ;
    schema:identifier biotools:pindel ;
    schema:license "GPLv3" ;
    schema:name "pindel" ;
    schema:softwareVersion "0.2.5b9" ;
    schema:url "http://gmt.genome.wustl.edu/packages/pindel/index.html" .

