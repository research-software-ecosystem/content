@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hitc a schema:SoftwareApplication ;
    schema:description "High Throughput Chromosome Conformation Capture analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HiTC_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HiTC/HiTC_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HiTC_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hitc/bioconductor-hitc_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-seqinfo",
        "r-base",
        "r-matrix",
        "r-rcolorbrewer" ;
    schema:identifier biotools:hitc ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-hitc" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HiTC.html" .

