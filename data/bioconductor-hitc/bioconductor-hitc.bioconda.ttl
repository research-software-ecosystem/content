@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hitc a schema1:SoftwareApplication ;
    schema1:alternateName "High Throughput Chromosome Conformation Capture analysis" ;
    schema1:description "The HiTC package was developed to explore high-throughput 'C' data such as 5C or Hi-C. Dedicated R classes as well as standard methods for quality controls, normalization, visualization, and further analysis are also provided." ;
    schema1:identifier <https://bio.tools/biotools:hitc> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-hitc" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HiTC.html" .

