@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:quast a schema1:SoftwareApplication ;
    schema1:alternateName "Quality Assessment Tool for Genome Assemblies." ;
    schema1:citation "doi:10.1093/bioinformatics/btt086" ;
    schema1:description "Quality Assessment Tool for Genome Assemblies." ;
    schema1:identifier <https://bio.tools/biotools:quast>,
        "usegalaxy-eu:quast" ;
    schema1:license "Custom" ;
    schema1:name "quast" ;
    schema1:softwareVersion "5.3.0" ;
    schema1:url "https://quast.sourceforge.net" .

