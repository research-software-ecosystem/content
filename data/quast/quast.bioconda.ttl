@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:quast a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt086" ;
    schema:description "Quality Assessment Tool for Genome Assemblies." ;
    schema:downloadUrl "http://downloads.sourceforge.net/project/quast/quast-5.3.0.tar.gz",
        "https://github.com/ablab/quast/releases/download/quast_5.3.0/quast-5.3.0.tar.gz" ;
    schema:hasPart "blast",
        "circos",
        "cython",
        "glimmerHMM",
        "joblib",
        "matplotlib-base",
        "minimap2",
        "perl",
        "pip",
        "python",
        "setuptools",
        "simplejson",
        "zlib" ;
    schema:identifier biotools:quast ;
    schema:license "Custom" ;
    schema:name "quast" ;
    schema:softwareHelp "https://quast.sourceforge.net/docs/manual.html" ;
    schema:softwareVersion "5.3.0" ;
    schema:url "https://quast.sourceforge.net" .

