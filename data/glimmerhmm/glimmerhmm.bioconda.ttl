@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:glimmerhmm a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bth315" ;
    schema:description "GlimmerHMM is a gene finder based on a Generalized Hidden Markov Model (GHMM)." ;
    schema:downloadUrl "https://ccb.jhu.edu/software/glimmerhmm/dl/GlimmerHMM-3.0.4.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:glimmer-hmm ;
    schema:license "Artistic License" ;
    schema:name "glimmerhmm" ;
    schema:softwareHelp "https://ccb.jhu.edu/software/glimmerhmm" ;
    schema:softwareVersion "3.0.4" ;
    schema:url "https://ccb.jhu.edu/software/glimmerhmm" .

