@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rtreemix a schema1:SoftwareApplication ;
    schema1:alternateName "Rtreemix: Mutagenetic trees mixture models." ;
    schema1:citation "doi:10.1093/bioinformatics/btn410" ;
    schema1:description "Rtreemix is a package that offers an environment for estimating the mutagenetic trees mixture models from cross-sectional data and using them for various predictions. It includes functions for fitting the trees mixture models, likelihood computations, model comparisons, waiting time estimations, stability analysis, etc." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Rtreemix_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/Rtreemix/Rtreemix_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Rtreemix_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtreemix/bioconductor-rtreemix_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rtreemix" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-rtreemix" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/Rtreemix.html" .

