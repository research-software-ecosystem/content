@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtreemix a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn410" ;
    schema:description "Rtreemix: Mutagenetic trees mixture models." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Rtreemix_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/Rtreemix/Rtreemix_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Rtreemix_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtreemix/bioconductor-rtreemix_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "libblas",
        "liblapack",
        "r-base",
        "r-hmisc" ;
    schema:identifier biotools:rtreemix ;
    schema:license "LGPL" ;
    schema:name "bioconductor-rtreemix" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/Rtreemix.html" .

