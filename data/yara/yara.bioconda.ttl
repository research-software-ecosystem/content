@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:yara a schema:SoftwareApplication ;
    schema:author "eseiler" ;
    schema:citation "doi:10.1093/nar/gkt005" ;
    schema:description "Yara is an exact tool for aligning DNA sequencing reads to reference genomes." ;
    schema:downloadUrl "https://github.com/seqan/seqan/archive/refs/tags/seqan-v2.5.1.tar.gz" ;
    schema:hasPart "bzip2",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:yara ;
    schema:license "BSD 3-Clause" ;
    schema:maintainer "eseiler" ;
    schema:name "yara" ;
    schema:softwareVersion "1.0.5" ;
    schema:url "https://github.com/seqan/seqan/tree/seqan-v2.5.1/apps/yara/README.rst" .

