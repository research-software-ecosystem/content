@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:beast2 a schema1:SoftwareApplication ;
    bioschemas:output "beast.trees",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0194,
        edam:topic_3293 ;
    schema1:codeRepository "https://www.beast2.org/" ;
    schema1:dateCreated "2026-07-20" ;
    schema1:description "BEAST 2: Bayesian Evolutionary Analysis Sampling Trees" ;
    schema1:encodingFormat "beast.trees",
        "tabular",
        "txt" ;
    schema1:identifier biotools:beast2,
        bioconda:beast2 ;
    schema1:keywords "Phylogenetics" ;
    schema1:name "beast2" ;
    schema1:softwareVersion "2.7.7" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/beast2" .

