@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:falco a schema1:SoftwareApplication ;
    schema1:alternateName "falco is a drop-in C++ implementation of FastQC to assess the quality of sequence reads." ;
    schema1:citation "doi:10.12688/f1000research.21142.2" ;
    schema1:description "falco is a drop-in C++ implementation of FastQC to assess the quality of sequence reads." ;
    schema1:identifier biotools:falco,
        "usegalaxy-eu:falco" ;
    schema1:license "MIT" ;
    schema1:maintainer "andrewdavidsmith",
        "guilhermesena1" ;
    schema1:name "falco" ;
    schema1:softwareVersion "2.0.1" ;
    schema1:url "https://github.com/smithlabcode/falco" .

