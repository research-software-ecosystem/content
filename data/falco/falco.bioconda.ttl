@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:falco a schema:SoftwareApplication ;
    schema:author "andrewdavidsmith",
        "guilhermesena1" ;
    schema:citation "doi:10.12688/f1000research.21142.2" ;
    schema:description "falco is a drop-in C++ implementation of FastQC to assess the quality of sequence reads." ;
    schema:downloadUrl "https://github.com/smithlabcode/falco/releases/download/v1.3.2/falco-1.3.2.tar.gz" ;
    schema:hasPart "htslib",
        "zlib" ;
    schema:identifier biotools:falco ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "andrewdavidsmith",
        "guilhermesena1" ;
    schema:name "falco" ;
    schema:softwareHelp "https://falco.readthedocs.io" ;
    schema:softwareVersion "1.3.2" ;
    schema:url "https://github.com/smithlabcode/falco" .

