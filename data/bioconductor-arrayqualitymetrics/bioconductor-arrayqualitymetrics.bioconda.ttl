@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-arrayqualitymetrics a schema1:SoftwareApplication ;
    schema1:alternateName "Quality metrics report for microarray data sets" ;
    schema1:description "This package generates microarray quality metrics reports for data in Bioconductor microarray data containers (ExpressionSet, NChannelSet, AffyBatch). One and two color array platforms are supported." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/arrayQualityMetrics_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/arrayQualityMetrics/arrayQualityMetrics_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/arrayQualityMetrics_3.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-arrayqualitymetrics/bioconductor-arrayqualitymetrics_3.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:arrayqualitymetrics" ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-arrayqualitymetrics" ;
    schema1:softwareVersion "3.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/arrayQualityMetrics.html" .

