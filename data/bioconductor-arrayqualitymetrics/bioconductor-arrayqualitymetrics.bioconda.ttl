@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-arrayqualitymetrics a schema:SoftwareApplication ;
    schema:description "Quality metrics report for microarray data sets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/arrayQualityMetrics_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/arrayQualityMetrics/arrayQualityMetrics_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/arrayQualityMetrics_3.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-arrayqualitymetrics/bioconductor-arrayqualitymetrics_3.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyplm",
        "bioconductor-beadarray",
        "bioconductor-biobase",
        "bioconductor-genefilter",
        "bioconductor-limma",
        "bioconductor-vsn",
        "r-base",
        "r-gridsvg",
        "r-hmisc",
        "r-hwriter",
        "r-lattice",
        "r-latticeextra",
        "r-rcolorbrewer",
        "r-setrng",
        "r-svglite",
        "r-xml" ;
    schema:identifier biotools:arrayqualitymetrics ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-arrayqualitymetrics" ;
    schema:softwareVersion "3.62.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/arrayQualityMetrics.html" .

