  "@id": "bioconda:bioconductor-genomicranges",
  "@type": "schema1:SoftwareApplication",
  "schema1:alternateName": "Representation and manipulation of genomic intervals",
  "schema1:description": "The ability to efficiently represent and manipulate genomic annotations and alignments is playing a central role when it comes to analyzing high-throughput sequencing data (a.k.a. NGS data). The GenomicRanges package defines general purpose containers for storing and manipulating genomic intervals and variables defined along a genome. More specialized containers for representing and manipulating short alignments against a reference genome, or a matrix-like summarization of an experiment, are defined in the GenomicAlignments and SummarizedExperiment packages, respectively. Both packages build on top of the GenomicRanges infrastructure.",
  "schema1:downloadUrl": [
    "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicRanges_1.62.1.tar.gz",
    "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicRanges/GenomicRanges_1.62.1.tar.gz",
    "https://bioarchive.galaxyproject.org/GenomicRanges_1.62.1.tar.gz",
    "https://depot.galaxyproject.org/software/bioconductor-genomicranges/bioconductor-genomicranges_1.62.1_src_all.tar.gz"
  ],
