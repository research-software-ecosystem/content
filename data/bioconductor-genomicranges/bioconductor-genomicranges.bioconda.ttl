@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genomicranges a schema:SoftwareApplication ;
    schema:description "Representation and manipulation of genomic intervals" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GenomicRanges_1.62.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicRanges/GenomicRanges_1.62.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicRanges_1.62.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomicranges/bioconductor-genomicranges_1.62.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:genomicranges ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genomicranges" ;
    schema:softwareVersion "1.62.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicRanges.html" .

