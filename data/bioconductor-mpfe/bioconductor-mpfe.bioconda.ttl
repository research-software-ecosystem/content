@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mpfe a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-015-0600-6" ;
    schema:description "Estimation of the amplicon methylation pattern distribution from bisulphite sequencing data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MPFE_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MPFE/MPFE_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MPFE_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mpfe/bioconductor-mpfe_1.46.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:mpfe ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-mpfe" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MPFE.html" .

