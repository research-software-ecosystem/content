@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mpfe a schema1:SoftwareApplication ;
    schema1:alternateName "Estimation of the amplicon methylation pattern distribution from bisulphite sequencing data" ;
    schema1:citation "doi:10.1186/s12859-015-0600-6" ;
    schema1:description "Estimate distribution of methylation patterns from a table of counts from a bisulphite sequencing experiment given a non-conversion rate and read error rate." ;
    schema1:identifier biotools:mpfe ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-mpfe" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MPFE.html" .

