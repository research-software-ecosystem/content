@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-oligo a schema1:SoftwareApplication ;
    schema1:description "Preprocessing tools for oligonucleotide arrays" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/oligo_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/oligo/oligo_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/oligo_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-oligo/bioconductor-oligo_1.74.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affxparser",
        "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-oligoclasses",
        "bioconductor-preprocesscore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bit",
        "r-dbi",
        "r-ff",
        "r-rsqlite",
        "zlib" ;
    schema1:identifier biotools:oligo ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-oligo" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/oligo.html" .

