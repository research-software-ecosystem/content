@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-oligo a schema1:SoftwareApplication ;
    schema1:alternateName "Preprocessing tools for oligonucleotide arrays" ;
    schema1:description "A package to analyze oligonucleotide arrays (expression/SNP/tiling/exon) at probe-level. It currently supports Affymetrix (CEL files) and NimbleGen arrays (XYS files)." ;
    schema1:identifier biotools:oligo ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-oligo" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/oligo.html" .

