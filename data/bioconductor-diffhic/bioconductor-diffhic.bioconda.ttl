@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-diffhic a schema:SoftwareApplication ;
    schema:description "Differential Analysis of Hi-C Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/diffHic_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/diffHic/diffHic_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/diffHic_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffhic/bioconductor-diffhic_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-csaw",
        "bioconductor-edger",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-interactionset",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rhdf5",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-locfit",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:diffhic ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-diffhic" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/diffHic.html" .

