@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-diffhic a schema1:SoftwareApplication ;
    schema1:alternateName "Differential Analysis of Hi-C Data" ;
    schema1:description "Detects differential interactions across biological conditions in a Hi-C experiment. Methods are provided for read alignment and data pre-processing into interaction counts. Statistical analysis is based on edgeR and supports normalization and filtering. Several visualization options are also available." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/diffHic_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/diffHic/diffHic_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/diffHic_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffhic/bioconductor-diffhic_1.42.0_src_all.tar.gz" ;
    schema1:identifier "biotools:diffhic" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-diffhic" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/diffHic.html" .

