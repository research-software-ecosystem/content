@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gsalightning a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw349" ;
    schema:description "Fast Permutation-based Gene Set Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GSALightning_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSALightning/GSALightning_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSALightning_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsalightning/bioconductor-gsalightning_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-data.table",
        "r-matrix" ;
    schema:identifier biotools:gsalightning ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-gsalightning" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GSALightning.html" .

