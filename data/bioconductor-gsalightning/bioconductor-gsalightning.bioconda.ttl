@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsalightning a schema1:SoftwareApplication ;
    schema1:alternateName "Fast Permutation-based Gene Set Analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/btw349" ;
    schema1:description "GSALightning provides a fast implementation of permutation-based gene set analysis for two-sample problem. This package is particularly useful when testing simultaneously a large number of gene sets, or when a large number of permutations is necessary for more accurate p-values estimation." ;
    schema1:identifier biotools:gsalightning ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-gsalightning" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSALightning.html" .

