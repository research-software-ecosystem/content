@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:krona a schema:SoftwareApplication ;
    schema:description "Krona Tools is a set of scripts to create Krona charts from several Bioinformatics tools as well as from text and XML files." ;
    schema:downloadUrl "https://github.com/marbl/Krona/releases/download/v2.8.1/KronaTools-2.8.1.tar" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:krona ;
    schema:license "BSD" ;
    schema:name "krona" ;
    schema:softwareVersion "2.8.1" ;
    schema:url "https://github.com/marbl/Krona" .

