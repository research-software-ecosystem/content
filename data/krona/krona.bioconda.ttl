@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:krona a schema1:SoftwareApplication ;
    schema1:alternateName "Krona Tools is a set of scripts to create Krona charts from several Bioinformatics tools as well as from text and XML files." ;
    schema1:description "Krona Tools is a set of scripts to create Krona charts from several Bioinformatics tools as well as from text and XML files." ;
    schema1:identifier <https://bio.tools/biotools:krona> ;
    schema1:license "BSD" ;
    schema1:name "krona" ;
    schema1:softwareVersion "2.8.1" ;
    schema1:url "https://github.com/marbl/Krona" .

