@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:lastz a schema:SoftwareApplication ;
    schema:description "LASTZ is a program for aligning DNA sequences, a pairwise aligner." ;
    schema:downloadUrl "https://github.com/lastz/lastz/archive/refs/tags/1.04.52.tar.gz" ;
    schema:identifier biotools:lastz ;
    schema:license "MIT" ;
    schema:name "lastz" ;
    schema:softwareHelp "https://lastz.github.io/lastz" ;
    schema:softwareVersion "1.04.52" ;
    schema:url "https://www.bx.psu.edu/~rsharris/lastz" .

