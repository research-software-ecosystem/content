@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:lastz a schema1:SoftwareApplication ;
    schema1:alternateName "LASTZ is a program for aligning DNA sequences, a pairwise aligner." ;
    schema1:description "LASTZ is a program for aligning DNA sequences, a pairwise aligner." ;
    schema1:identifier <https://bio.tools/biotools:lastz> ;
    schema1:license "MIT" ;
    schema1:name "lastz" ;
    schema1:softwareVersion "1.04.52" ;
    schema1:url "https://www.bx.psu.edu/~rsharris/lastz" .

