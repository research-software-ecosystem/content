@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-liquidassociation a schema1:SoftwareApplication ;
    schema1:alternateName "LiquidAssociation" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The package contains functions for calculate direct and model-based estimators for liquid association. It also provides functions for testing the existence of liquid association given a gene triplet data." ;
    schema1:identifier biotools:liquidassociation ;
    schema1:license "GPL (>=3)" ;
    schema1:name "bioconductor-liquidassociation" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/LiquidAssociation.html" .

