@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-liquidassociation a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "LiquidAssociation" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/LiquidAssociation_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LiquidAssociation/LiquidAssociation_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/LiquidAssociation_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-liquidassociation/bioconductor-liquidassociation_1.64.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-org.sc.sgd.db",
        "bioconductor-yeastcc",
        "r-base",
        "r-geepack" ;
    schema1:identifier biotools:liquidassociation ;
    schema1:license "GPL (>=3)" ;
    schema1:name "bioconductor-liquidassociation" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/LiquidAssociation.html" .

