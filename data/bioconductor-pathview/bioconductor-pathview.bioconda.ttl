@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pathview a schema1:SoftwareApplication ;
    schema1:alternateName "a tool set for pathway based data integration and visualization" ;
    schema1:description "Pathview is a tool set for pathway based data integration and visualization. It maps and renders a wide variety of biological data on relevant pathway graphs. All users need is to supply their data and specify the target pathway. Pathview automatically downloads the pathway graph data, parses the data file, maps user data to the pathway, and render pathway graph with the mapped data. In addition, Pathview also seamlessly integrates with pathway and gene set (enrichment) analysis tools for large-scale and fully automated analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pathview_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pathview/pathview_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pathview_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathview/bioconductor-pathview_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:pathview" ;
    schema1:license "GPL (>=3.0)" ;
    schema1:name "bioconductor-pathview" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pathview.html" .

