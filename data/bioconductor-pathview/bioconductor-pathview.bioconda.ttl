@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pathview a schema:SoftwareApplication ;
    schema:description "a tool set for pathway based data integration and visualization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pathview_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pathview/pathview_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pathview_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathview/bioconductor-pathview_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-graph",
        "bioconductor-kegggraph",
        "bioconductor-keggrest",
        "bioconductor-org.hs.eg.db",
        "bioconductor-rgraphviz",
        "r-base",
        "r-png",
        "r-xml" ;
    schema:identifier biotools:pathview ;
    schema:license "GPL (>=3.0)" ;
    schema:name "bioconductor-pathview" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pathview.html" .

