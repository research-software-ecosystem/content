@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biocgenerics a schema:SoftwareApplication ;
    schema:description "S4 generic functions used in Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BiocGenerics_0.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocGenerics/BiocGenerics_0.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiocGenerics_0.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocgenerics/bioconductor-biocgenerics_0.56.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-generics" ;
    schema:identifier biotools:biocgenerics ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-biocgenerics" ;
    schema:softwareVersion "0.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BiocGenerics.html" .

