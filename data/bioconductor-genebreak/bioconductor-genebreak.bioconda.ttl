@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genebreak a schema1:SoftwareApplication ;
    schema1:citation "doi:10.12688/f1000research.9259.1" ;
    schema1:description "Gene Break Detection" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GeneBreak_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneBreak/GeneBreak_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneBreak_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genebreak/bioconductor-genebreak_1.40.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-cghbase",
        "bioconductor-cghcall",
        "bioconductor-genomicranges",
        "bioconductor-qdnaseq",
        "r-base" ;
    schema1:identifier biotools:genebreak ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-genebreak" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GeneBreak.html" .

