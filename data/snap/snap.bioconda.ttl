@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:snap a schema1:SoftwareApplication ;
    schema1:alternateName "Semi-HMM-based Nucleic Acid Parser - a gene prediction tool." ;
    schema1:citation "doi:10.1186/1471-2105-5-59" ;
    schema1:description "Semi-HMM-based Nucleic Acid Parser - a gene prediction tool." ;
    schema1:identifier <https://bio.tools/biotools:snap>,
        "usegalaxy-eu:snap_training" ;
    schema1:license "MIT" ;
    schema1:name "snap" ;
    schema1:softwareVersion "20170301" ;
    schema1:url "https://github.com/KorfLab/SNAP" .

