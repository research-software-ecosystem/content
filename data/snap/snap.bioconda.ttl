@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:snap a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-5-59" ;
    schema:description "Semi-HMM-based Nucleic Acid Parser - a gene prediction tool." ;
    schema:identifier biotools:snap ;
    schema:license "MIT" ;
    schema:name "snap" ;
    schema:softwareHelp "https://github.com/KorfLab/SNAP/blob/master/README.md" ;
    schema:softwareVersion "20170301" ;
    schema:url "https://github.com/KorfLab/SNAP" .

