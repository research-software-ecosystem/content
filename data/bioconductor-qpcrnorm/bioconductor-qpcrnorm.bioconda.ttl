@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-qpcrnorm a schema1:SoftwareApplication ;
    schema1:alternateName "Data-driven normalization strategies for high-throughput qPCR data." ;
    schema1:citation "doi:10.1186/1471-2105-10-110" ;
    schema1:description "The package contains functions to perform normalization of high-throughput qPCR data. Basic functions for processing raw Ct data plus functions to generate diagnostic plots are also available." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/qpcrNorm_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/qpcrNorm/qpcrNorm_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/qpcrNorm_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qpcrnorm/bioconductor-qpcrnorm_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:qpcrnorm" ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-qpcrnorm" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/qpcrNorm.html" .

