@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-qpcrnorm a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-10-110" ;
    schema:description "Data-driven normalization strategies for high-throughput qPCR data." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/qpcrNorm_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/qpcrNorm/qpcrNorm_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/qpcrNorm_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qpcrnorm/bioconductor-qpcrnorm_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-limma",
        "r-base" ;
    schema:identifier biotools:qpcrnorm ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-qpcrnorm" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/qpcrNorm.html" .

