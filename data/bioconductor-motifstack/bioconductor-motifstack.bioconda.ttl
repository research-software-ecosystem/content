@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-motifstack a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Plot stacked logos for single or multiple DNA, RNA and amino acid sequence" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/motifStack_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/motifStack/motifStack_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/motifStack_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-motifstack/bioconductor-motifstack_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-tfbstools",
        "r-ade4",
        "r-base",
        "r-ggplot2",
        "r-htmlwidgets",
        "r-xml" ;
    schema:identifier biotools:motifstack ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-motifstack" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/motifStack.html" .

