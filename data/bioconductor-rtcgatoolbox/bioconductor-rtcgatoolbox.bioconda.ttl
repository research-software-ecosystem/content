@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtcgatoolbox a schema:SoftwareApplication ;
    schema:description "A new tool for exporting TCGA Firehose data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RTCGAToolbox_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RTCGAToolbox/RTCGAToolbox_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RTCGAToolbox_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtcgatoolbox/bioconductor-rtcgatoolbox_2.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-delayedarray",
        "bioconductor-genomicranges",
        "bioconductor-raggedexperiment",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-tcgautils",
        "r-base",
        "r-data.table",
        "r-httr",
        "r-rcurl",
        "r-rjsonio",
        "r-rvest",
        "r-stringr" ;
    schema:identifier biotools:rtcgatoolbox ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-rtcgatoolbox" ;
    schema:softwareVersion "2.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RTCGAToolbox.html" .

