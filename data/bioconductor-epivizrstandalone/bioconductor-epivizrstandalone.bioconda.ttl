@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-epivizrstandalone a schema1:SoftwareApplication ;
    schema1:alternateName "Run Epiviz Interactive Genomic Data Visualization App within R" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package imports the epiviz visualization JavaScript app for genomic data interactive visualization. The 'epivizrServer' package is used to provide a web server running completely within R. This standalone version allows to browse arbitrary genomes through genome annotations provided by Bioconductor packages." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/epivizrStandalone_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/epivizrStandalone/epivizrStandalone_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/epivizrStandalone_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epivizrstandalone/bioconductor-epivizrstandalone_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:epivizrstandalone" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-epivizrstandalone" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/epivizrStandalone.html" .

