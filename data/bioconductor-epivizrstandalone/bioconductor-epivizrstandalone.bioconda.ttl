@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-epivizrstandalone a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Run Epiviz Interactive Genomic Data Visualization App within R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/epivizrStandalone_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/epivizrStandalone/epivizrStandalone_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/epivizrStandalone_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epivizrstandalone/bioconductor-epivizrstandalone_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-epivizr",
        "bioconductor-epivizrserver",
        "bioconductor-genomicfeatures",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-git2r" ;
    schema:identifier biotools:epivizrstandalone ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-epivizrstandalone" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/epivizrStandalone.html" .

