@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:megahit a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ymeth.2016.02.020",
        "doi:10.1093/bioinformatics/btv033" ;
    schema:description "MEGAHIT: An ultra-fast single-node solution for large and complex metagenomics assembly via succinct de Bruijn graph." ;
    schema:downloadUrl "https://github.com/voutcn/megahit/archive/v1.2.9.tar.gz" ;
    schema:hasPart "bzip2",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:megahit ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "megahit" ;
    schema:softwareHelp "https://github.com/voutcn/megahit/blob/v1.2.9/README.md" ;
    schema:softwareVersion "1.2.9" ;
    schema:url "https://github.com/voutcn/megahit" .

