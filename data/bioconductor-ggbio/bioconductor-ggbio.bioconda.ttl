@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ggbio a schema1:SoftwareApplication ;
    schema1:description "Visualization tools for genomic data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ggbio_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ggbio/ggbio_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ggbio_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ggbio/bioconductor-ggbio_1.58.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-annotationfilter",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-biovizbase",
        "bioconductor-bsgenome",
        "bioconductor-ensembldb",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-organismdbi",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "r-base",
        "r-ggplot2",
        "r-gridextra",
        "r-gtable",
        "r-hmisc",
        "r-reshape2",
        "r-rlang",
        "r-scales" ;
    schema1:identifier biotools:ggbio ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ggbio" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ggbio.html" .

