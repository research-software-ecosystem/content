@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mbamethyl a schema1:SoftwareApplication ;
    schema1:alternateName "Model-based analysis of DNA methylation data" ;
    schema1:citation "doi:10.1111/biom.12422" ;
    schema1:description "This package provides a function for reconstructing DNA methylation values from raw measurements. It iteratively implements the group fused lars to smooth related-by-location methylation values and the constrained least squares to remove probe affinity effect across multiple sequences." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MBAmethyl_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MBAmethyl/MBAmethyl_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MBAmethyl_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mbamethyl/bioconductor-mbamethyl_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mbamethyl" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mbamethyl" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MBAmethyl.html" .

