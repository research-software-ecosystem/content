@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:arb-bio a schema:SoftwareApplication ;
    schema:author "epruesse" ;
    schema:citation "doi:10.1002/9781118010518.ch46" ;
    schema:description "ARB 6 Sequence Analysis Suite" ;
    schema:downloadUrl "http://download.arb-home.de/release/arb-6.0.6/arb-6.0.6-source.tgz" ;
    schema:hasPart "gettext",
        "glib",
        "libpng",
        "libtiff",
        "libxslt",
        "openmotif-dev",
        "perl",
        "pthread-stubs",
        "xerces-c",
        "xorg-libxaw",
        "xorg-libxi",
        "xorg-libxmu",
        "xorg-libxp",
        "xorg-libxpm" ;
    schema:identifier biotools:arb ;
    schema:license "ARB" ;
    schema:maintainer "epruesse" ;
    schema:name "arb-bio" ;
    schema:softwareHelp "http://www.arb-home.de/documentation.html" ;
    schema:softwareVersion "6.0.6" ;
    schema:url "http://www.arb-home.de" .

