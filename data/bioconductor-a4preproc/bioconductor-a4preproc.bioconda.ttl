        "https://depot.galaxyproject.org/software/bioconductor-a4preproc/bioconductor-a4preproc_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "r-base" ;
    schema:identifier biotools:a4preproc ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-a4preproc" ;
