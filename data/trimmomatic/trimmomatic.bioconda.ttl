@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trimmomatic a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btag331",
        "doi:10.1093/bioinformatics/btu170" ;
    schema:description "A flexible read trimming tool for Illumina NGS data." ;
    schema:downloadUrl "https://github.com/usadellab/Trimmomatic/releases/download/v0.41/Trimmomatic-0.41.zip" ;
    schema:identifier biotools:trimmomatic ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "trimmomatic" ;
    schema:softwareHelp "https://www.plabipd.de/trimmomatic_main.html" ;
    schema:softwareVersion "0.41" ;
    schema:url "https://www.plabipd.de/trimmomatic_main.html" .

