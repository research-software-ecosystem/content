@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:trimmomatic a schema1:SoftwareApplication ;
    schema1:alternateName "A flexible read trimming tool for Illumina NGS data." ;
    schema1:citation "doi:10.1093/bioinformatics/btag331",
        "doi:10.1093/bioinformatics/btu170" ;
    schema1:description "A flexible read trimming tool for Illumina NGS data." ;
    schema1:downloadUrl "https://github.com/usadellab/Trimmomatic/releases/download/v0.41/Trimmomatic-0.41.zip" ;
    schema1:identifier "biotools:trimmomatic",
        "usegalaxy-eu:trimmomatic" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "trimmomatic" ;
    schema1:softwareVersion "0.41" ;
    schema1:url "https://www.plabipd.de/trimmomatic_main.html" .

