@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-motifmatchr a schema:SoftwareApplication ;
    schema:description "Fast Motif Matching in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/motifmatchr_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/motifmatchr/motifmatchr_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/motifmatchr_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-motifmatchr/bioconductor-motifmatchr_1.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-tfbstools",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-rcpp",
        "r-rcpparmadillo",
        "zlib" ;
    schema:identifier biotools:motifmatchr ;
    schema:license "GPL-3 + file LICENSE" ;
    schema:name "bioconductor-motifmatchr" ;
    schema:softwareVersion "1.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/motifmatchr.html" .

