@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-motifmatchr a schema1:SoftwareApplication ;
    schema1:alternateName "Fast Motif Matching in R" ;
    schema1:description "Quickly find motif matches for many motifs and many sequences. Wraps C++ code from the MOODS motif calling library, which was developed by Pasi Rastas, Janne Korhonen, and Petri Martinmäki." ;
    schema1:identifier biotools:motifmatchr ;
    schema1:license "GPL-3 + file LICENSE" ;
    schema1:name "bioconductor-motifmatchr" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/motifmatchr.html" .

