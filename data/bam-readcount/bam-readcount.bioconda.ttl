@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bam-readcount a schema:SoftwareApplication ;
    schema:citation "doi:10.21105/joss.03722" ;
    schema:description "bam-readcount generates metrics at single nucleotide positions." ;
    schema:hasPart "icu",
        "pthread-stubs",
        "tar",
        "wget" ;
    schema:identifier biotools:bam-readcount ;
    schema:license "MIT" ;
    schema:name "bam-readcount" ;
    schema:softwareHelp "https://github.com/genome/bam-readcount/blob/v1.0.1/README.md" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "https://github.com/genome/bam-readcount" .

