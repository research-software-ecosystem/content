@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hhsuite a schema:SoftwareApplication ;
    schema:author "milot-mirdita" ;
    schema:citation "doi:10.1186/s12859-019-3019-7" ;
    schema:description "HH-suite3 for fast remote homology detection and deep protein annotation." ;
    schema:downloadUrl "https://github.com/soedinglab/hh-suite/archive/v3.3.0.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:hh-suite ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "milot-mirdita" ;
    schema:name "hhsuite" ;
    schema:softwareHelp "https://github.com/soedinglab/hh-suite/wiki" ;
    schema:softwareVersion "3.3.0" ;
    schema:url "https://github.com/soedinglab/hh-suite" .

