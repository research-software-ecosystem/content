@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:hhsuite a schema1:SoftwareApplication ;
    schema1:alternateName "HH-suite3 for fast remote homology detection and deep protein annotation." ;
