@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-plgem a schema1:SoftwareApplication ;
    schema1:alternateName "Detect differential expression in microarray and proteomics datasets with the Power Law Global Error Model (PLGEM)" ;
    schema1:description "The Power Law Global Error Model (PLGEM) has been shown to faithfully model the variance-versus-mean dependence that exists in a variety of genome-wide datasets, including microarray and proteomics data. The use of PLGEM has been shown to improve the detection of differentially expressed genes or proteins in these datasets." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/plgem_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/plgem/plgem_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/plgem_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-plgem/bioconductor-plgem_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:plgem" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-plgem" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/plgem.html" .

