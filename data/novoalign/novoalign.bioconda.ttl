@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:novoalign a schema:SoftwareApplication ;
    schema:description "Powerful tool designed for mapping of short reads onto a reference genome from Illumina, Ion Torrent, and 454 NGS platforms" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Novoalign ;
    schema:license "Commercial (requires license for use)" ;
    schema:name "novoalign" ;
    schema:softwareVersion "4.03.04" ;
    schema:url "http://www.novocraft.com/products/novoalign/" .

