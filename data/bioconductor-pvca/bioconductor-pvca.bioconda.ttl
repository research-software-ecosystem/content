@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pvca a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/9780470685983.ch12" ;
    schema:description "Principal Variance Component Analysis (PVCA)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pvca_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pvca/pvca_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pvca_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pvca/bioconductor-pvca_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-vsn",
        "r-base",
        "r-lme4",
        "r-matrix" ;
    schema:identifier biotools:pvca ;
    schema:license "LGPL (>= 2.0)" ;
    schema:name "bioconductor-pvca" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pvca.html" .

