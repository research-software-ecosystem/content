@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:maxquant a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-018-0018-y" ;
    schema:description "MaxQuant is a quantitative proteomics software package designed for analyzing large mass-spectrometric data sets. License restricted." ;
    schema:downloadUrl "http://computproteomics.bmb.sdu.dk/share/MaxQuant_2.0.3.0.zip" ;
    schema:hasPart "python" ;
    schema:identifier biotools:MaxQuant ;
    schema:license "http://www.coxdocs.org/lib/exe/fetch.php?media=license_agreement.pdf" ;
    schema:name "maxquant" ;
    schema:softwareVersion "2.0.3.0" ;
    schema:url "http://www.coxdocs.org/doku.php?id=maxquant:start" .

