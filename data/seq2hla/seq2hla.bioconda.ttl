@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seq2hla a schema:SoftwareApplication ;
    schema:description "Precision HLA typing and expression from next-generation RNA sequencing data" ;
    schema:identifier biotools:seq2hla ;
    schema:license "MIT" ;
    schema:name "seq2hla" ;
    schema:softwareVersion "2.3" ;
    schema:url "https://github.com/TRON-Bioinformatics/seq2HLA" .

