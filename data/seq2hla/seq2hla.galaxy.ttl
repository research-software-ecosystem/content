@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:seq2hla a schema1:SoftwareApplication ;
    bioschemas:output "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:operation_2429,
        edam:topic_0102,
        edam:topic_3308 ;
    schema1:codeRepository "https://github.com/TRON-Bioinformatics/seq2HLA" ;
    schema1:dateCreated "2020-02-20" ;
    schema1:description "Precision HLA typing and expression from RNAseq data" ;
    schema1:encodingFormat "tabular",
        "txt" ;
    schema1:featureList edam:operation_3197,
        edam:operation_3198 ;
    schema1:identifier biotools:seq2hla,
        bioconda:seq2hla ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=c3f2350f0be2d9c9>,
        <https://usegalaxy.eu/published/workflow?id=db270d0eb035609e>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
