        <https://usegalaxy.org/published/workflow?id=1d925422fc6094a0>,
        <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1430?version=1>,
        <https://workflowhub.eu/workflows/1794?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "seq2hla" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/seq2hla" .

