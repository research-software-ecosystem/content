@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-funchip a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx201" ;
    schema:description "Clustering and Alignment of ChIP-Seq peaks based on their shapes" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/FunChIP_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/FunChIP/FunChIP_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/FunChIP_1.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-funchip/bioconductor-funchip_1.28.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-rsamtools",
        "libblas",
        "liblapack",
        "r-base",
        "r-doparallel",
        "r-fda",
        "r-foreach",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-shiny" ;
    schema:identifier biotools:funchip ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-funchip" ;
    schema:softwareVersion "1.28.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/FunChIP.html" .

