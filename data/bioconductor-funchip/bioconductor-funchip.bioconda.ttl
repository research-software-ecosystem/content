@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-funchip a schema1:SoftwareApplication ;
    schema1:alternateName "Clustering and Alignment of ChIP-Seq peaks based on their shapes" ;
    schema1:citation "doi:10.1093/bioinformatics/btx201" ;
    schema1:description "Preprocessing and smoothing of ChIP-Seq peaks and efficient implementation of the k-mean alignment algorithm to classify them." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/FunChIP_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/FunChIP/FunChIP_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/FunChIP_1.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-funchip/bioconductor-funchip_1.28.0_src_all.tar.gz" ;
    schema1:identifier "biotools:funchip" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-funchip" ;
    schema1:softwareVersion "1.28.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/FunChIP.html" .

