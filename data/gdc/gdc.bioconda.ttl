@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gdc a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/srep11565" ;
    schema:description "Utility designed for compression of genome collections from the same species." ;
    schema:downloadUrl "http://sun.aei.polsl.pl/REFRESH/gdc/downloads/2.0/gdc2.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:GDC ;
    schema:license "GPL2" ;
    schema:name "gdc" ;
    schema:softwareVersion "2.0" ;
    schema:url "http://sun.aei.polsl.pl/REFRESH/index.php?page=projects&project=gdc&subpage=about" .

