@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sscu a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Strength of Selected Codon Usage" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sscu_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sscu/sscu_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sscu_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sscu/bioconductor-sscu_2.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "r-base",
        "r-seqinr" ;
    schema:identifier biotools:sscu ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-sscu" ;
    schema:softwareVersion "2.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sscu.html" .

