@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:abritamr a schema:SoftwareApplication ;
    schema:author "kristyhoran" ;
    schema:description "Idenify bacterial AMR genes and SNPs in genome assemblies" ;
    schema:downloadUrl "https://pypi.org/packages/source/a/abritamr/abritamr-1.3.0.tar.gz" ;
    schema:hasPart "libcurl",
        "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:abritamr ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "kristyhoran" ;
    schema:name "abritamr" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "https://github.com/MDU-PHL/abritamr" .

