@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:abritamr a schema1:SoftwareApplication ;
    schema1:alternateName "Idenify bacterial AMR genes and SNPs in genome assemblies" ;
    schema1:description "Idenify bacterial AMR genes and SNPs in genome assemblies" ;
    schema1:identifier <https://bio.tools/biotools:abritamr> ;
    schema1:license "GPL-3.0-only" ;
    schema1:maintainer "kristyhoran" ;
    schema1:name "abritamr" ;
    schema1:softwareVersion "1.3.0" ;
    schema1:url "https://github.com/MDU-PHL/abritamr" .

