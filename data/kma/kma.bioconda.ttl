@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kma a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nargab/lqaf116" ;
    schema:description "KMA is a mapping method designed to map raw reads directly against redundant databases, in an ultra-fast manner using seed and extend." ;
    schema:downloadUrl "https://bitbucket.org/genomicepidemiology/kma/get/1.6.13.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:kma ;
    schema:license "Apache-2.0" ;
    schema:name "kma" ;
    schema:softwareHelp "https://bitbucket.org/genomicepidemiology/kma/src/1.6.13/README.md" ;
    schema:softwareVersion "1.6.13" ;
    schema:url "https://bitbucket.org/genomicepidemiology/kma" .

