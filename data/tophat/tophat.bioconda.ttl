@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tophat a schema:SoftwareApplication ;
    schema:description "A spliced read mapper for RNA-Seq." ;
    schema:downloadUrl "https://github.com/infphilo/tophat/archive/refs/tags/v2.1.2.tar.gz" ;
    schema:hasPart "boost-cpp",
        "libgomp",
        "llvm-openmp",
        "ncurses",
        "zlib" ;
    schema:identifier biotools:tophat2 ;
    schema:license "Boost Software License" ;
    schema:name "tophat" ;
    schema:softwareHelp "http://ccb.jhu.edu/software/tophat" ;
    schema:softwareVersion "2.1.2" ;
    schema:url "http://ccb.jhu.edu/software/tophat" .

