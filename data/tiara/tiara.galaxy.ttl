@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:tiara a schema1:SoftwareApplication ;
    bioschemas:output "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0622,
        edam:topic_2885,
        edam:topic_3168 ;
    schema1:codeRepository "https://github.com/ibe-uw/tiara" ;
    schema1:dateCreated "2024-05-23" ;
    schema1:description "Tool for identification of eukaryotic sequences in the metagenomic datasets." ;
    schema1:encodingFormat "tabular",
        "txt" ;
    schema1:featureList edam:operation_2422,
        edam:operation_3208,
        edam:operation_3209,
        edam:operation_3227,
        edam:operation_3228 ;
    schema1:identifier biotools:Tiara,
        bioconda:tiara ;
    schema1:keywords "Metagenomics",
        "Sequence Analysis" ;
    schema1:name "tiara" ;
    schema1:softwareVersion "1.0.3" ;
    schema1:url "https://github.com/bgruening/galaxytools/tree/master/tools/tiara" .

