@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:macsyfinder a schema:SoftwareApplication ;
    schema:author "bneron" ;
    schema:citation "doi:10.24072/pcjournal.250" ;
    schema:description "MacSyFinder: Detection of macromolecular systems in protein datasets using systems modelling and similarity search" ;
    schema:downloadUrl "https://pypi.io/packages/source/m/macsyfinder/macsyfinder-2.1.6.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:macsyfinder ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "bneron" ;
    schema:name "macsyfinder" ;
    schema:softwareHelp "https://macsyfinder.readthedocs.io/en/latest" ;
    schema:softwareVersion "2.1.6" ;
    schema:url "https://github.com/gem-pasteur/macsyfinder" .

