@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-spacepac a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of Mutational Clusters in 3D Protein Space via Simulation." ;
    schema1:citation "doi:10.1186/1471-2105-15-231" ;
    schema1:description "Identifies clustering of somatic mutations in proteins via a simulation approach while considering the protein's tertiary structure." ;
    schema1:identifier biotools:spacepac ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-spacepac" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/SpacePAC.html" .

