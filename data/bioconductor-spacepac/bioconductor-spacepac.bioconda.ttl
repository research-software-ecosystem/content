@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-spacepac a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-15-231" ;
    schema:description "Identification of Mutational Clusters in 3D Protein Space via Simulation." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SpacePAC_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/SpacePAC/SpacePAC_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/SpacePAC_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-spacepac/bioconductor-spacepac_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-ipac",
        "r-base" ;
    schema:identifier biotools:spacepac ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-spacepac" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/SpacePAC.html" .

