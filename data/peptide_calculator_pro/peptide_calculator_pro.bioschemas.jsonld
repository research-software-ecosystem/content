      "sc:description": "Free browser-based calculators for peptide sequences and solutions. From a one-letter amino acid sequence it computes average molecular weight, monoisotopic mass, molecular formula and m/z for charge states, with N-terminal acetylation, C-terminal amidation and disulfide options. It also computes net charge at a chosen pH, isoelectric point (pI) and GRAVY using EMBOSS pKa values. A concentration calculator converts peptide mass and volume to mg/mL, mM or µM from the molecular weight. All calculations run client-side and no login is required.",
      "sc:featureList": [
        {
          "@id": "edam:operation_0403"
        },
        {
          "@id": "edam:operation_0398"
        },
        {
          "@id": "edam:operation_3434"
        }
      ],
      "sc:isAccessibleForFree": true,
      "sc:license": "Proprietary",
      "sc:name": "Peptide Calculator Pro",
      "sc:operatingSystem": [
        "Linux",
        "Mac",
        "Windows"
      ],
      "sc:url": "https://peptidecalculatorpro.org/"
