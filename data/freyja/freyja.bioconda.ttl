@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:freyja a schema:SoftwareApplication ;
    schema:description "Freyja recovers relative lineage abundances from mixed SARS-CoV-2 samples and provides functionality to analyze lineage dynamics." ;
    schema:downloadUrl "https://github.com/andersen-lab/Freyja/archive/v2.0.3.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:freyja ;
    schema:license "BSD-2-Clause" ;
    schema:name "freyja" ;
    schema:softwareHelp "https://andersen-lab.github.io/Freyja" ;
    schema:softwareVersion "2.0.3" ;
    schema:url "https://github.com/andersen-lab/Freyja" .

