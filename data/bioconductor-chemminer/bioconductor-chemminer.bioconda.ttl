@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chemminer a schema1:SoftwareApplication ;
    schema1:alternateName "Cheminformatics Toolkit for R" ;
    schema1:description "ChemmineR is a cheminformatics package for analyzing drug-like small molecule data in R. Its latest version contains functions for efficient processing of large numbers of molecules, physicochemical/structural property predictions, structural similarity searching, classification and clustering of compound libraries with a wide spectrum of algorithms. In addition, it offers visualization functions for compound clustering results and chemical structures." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ChemmineR_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChemmineR/ChemmineR_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChemmineR_3.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chemminer/bioconductor-chemminer_3.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:chemminer" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-chemminer" ;
    schema1:softwareVersion "3.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ChemmineR.html" .

