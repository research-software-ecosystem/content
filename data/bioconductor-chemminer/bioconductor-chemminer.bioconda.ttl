@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chemminer a schema:SoftwareApplication ;
    schema:description "Cheminformatics Toolkit for R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ChemmineR_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChemmineR/ChemmineR_3.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChemmineR_3.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chemminer/bioconductor-chemminer_3.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-base64enc",
        "r-bh",
        "r-dbi",
        "r-digest",
        "r-dt",
        "r-ggplot2",
        "r-gridextra",
        "r-jsonlite",
        "r-png",
        "r-rcpp",
        "r-rcurl",
        "r-rjson",
        "r-rsvg",
        "r-stringi",
        "zlib" ;
    schema:identifier biotools:chemminer ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-chemminer" ;
    schema:softwareVersion "3.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ChemmineR.html" .

