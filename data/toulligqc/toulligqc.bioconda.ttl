@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:toulligqc a schema:SoftwareApplication ;
    schema:description "A post sequencing QC tool for Oxford Nanopore sequencers." ;
    schema:downloadUrl "https://pypi.org/packages/source/t/toulligqc/toulligqc-2.9.1.tar.gz" ;
    schema:hasPart "hatchling",
        "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:ToulligQC ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "toulligqc" ;
    schema:softwareHelp "https://github.com/GenomiqueENS/toulligQC/blob/v2.9.1/README.md" ;
    schema:softwareVersion "2.9.1" ;
    schema:url "https://github.com/GenomicParisCentre/toulligQC" .

