@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:muscle a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-022-34630-w" ;
    schema:description "Multiple sequence and structure alignment with top benchmark scores scalable to thousands of sequences." ;
    schema:downloadUrl "https://github.com/rcedgar/muscle/archive/refs/tags/v5.3.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:muscle ;
    schema:license "GPL-3.0-only" ;
    schema:name "muscle" ;
    schema:softwareHelp "https://drive5.com/muscle5" ;
    schema:softwareVersion "5.3" ;
    schema:url "https://github.com/rcedgar/muscle" .

