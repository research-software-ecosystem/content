@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sradb a schema:SoftwareApplication ;
    schema:description "A compilation of metadata from NCBI SRA and tools" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SRAdb_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SRAdb/SRAdb_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SRAdb_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sradb/bioconductor-sradb_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "r-base",
        "r-r.utils",
        "r-rcurl",
        "r-rsqlite" ;
    schema:identifier biotools:sradb ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-sradb" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SRAdb.html" .

