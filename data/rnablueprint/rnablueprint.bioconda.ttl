@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnablueprint a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx263" ;
    schema:description "The RNAblueprint library solves the problem of uniformly sampling RNA/DNA sequences compatible to multiple structural constraints and sequence constraints." ;
    schema:downloadUrl "https://github.com/ViennaRNA/RNAblueprint/archive/refs/tags/v1.3.3.tar.gz" ;
    schema:hasPart "boost-cpp",
        "gmp",
        "perl",
        "python",
        "swig" ;
    schema:identifier biotools:rnablueprint ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "rnablueprint" ;
    schema:softwareHelp "https://viennarna.github.io/RNAblueprint" ;
    schema:softwareVersion "1.3.3" ;
    schema:url "https://github.com/ViennaRNA/RNAblueprint" .

