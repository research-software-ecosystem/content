@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-geoquery a schema1:SoftwareApplication ;
    schema1:alternateName "Get data from NCBI Gene Expression Omnibus (GEO)" ;
    schema1:description "The NCBI Gene Expression Omnibus (GEO) is a public repository of microarray data.  Given the rich and varied nature of this resource, it is only natural to want to apply BioConductor tools to these data.  GEOquery is the bridge between GEO and BioConductor." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GEOquery_2.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEOquery/GEOquery_2.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GEOquery_2.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geoquery/bioconductor-geoquery_2.78.0_src_all.tar.gz" ;
    schema1:identifier "biotools:geoquery" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-geoquery" ;
    schema1:softwareVersion "2.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GEOquery.html" .

