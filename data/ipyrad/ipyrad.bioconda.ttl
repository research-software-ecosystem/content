@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ipyrad a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btz966" ;
    schema:description "Interactive assembly and analysis of RAD-seq data sets." ;
    schema:downloadUrl "https://github.com/dereneaton/ipyrad/archive/0.9.108.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:ipyrad ;
    schema:license "GPL-3.0-only" ;
    schema:name "ipyrad" ;
    schema:softwareHelp "https://ipyrad.readthedocs.io/en/master" ;
    schema:softwareVersion "0.9.108" ;
    schema:url "https://github.com/dereneaton/ipyrad" .

