@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:modle a schema:SoftwareApplication ;
    schema:author "jonnings",
        "robomics" ;
    schema:citation "doi:10.1186/s13059-022-02815-7",
        "doi:10.5281/zenodo.6992533" ;
    schema:description "High-performance stochastic modeling of DNA loop extrusion interactions" ;
    schema:downloadUrl "https://github.com/paulsengroup/MoDLE/archive/refs/tags/v1.1.0.tar.gz" ;
    schema:identifier biotools:modle ;
    schema:license "MIT" ;
    schema:maintainer "jonnings",
        "robomics" ;
    schema:name "modle" ;
    schema:softwareHelp "https://github.com/paulsengroup/MoDLE#readme" ;
    schema:softwareVersion "1.1.0" ;
    schema:url "https://github.com/paulsengroup/MoDLE" .

