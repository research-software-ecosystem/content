@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-generecommender a schema1:SoftwareApplication ;
    schema1:alternateName "A gene recommender algorithm to identify genes coexpressed with a query set of genes" ;
    schema1:citation "doi:10.1101/gr.1125403" ;
    schema1:description "This package contains a targeted clustering algorithm for the analysis of microarray data. The algorithm can aid in the discovery of new genes with similar functions to a given list of genes already known to have closely related functions." ;
    schema1:identifier biotools:generecommender ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-generecommender" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/geneRecommender.html" .

