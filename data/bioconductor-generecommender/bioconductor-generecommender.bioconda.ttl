@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-generecommender a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.1125403" ;
    schema:description "A gene recommender algorithm to identify genes coexpressed with a query set of genes" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/geneRecommender_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneRecommender/geneRecommender_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneRecommender_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-generecommender/bioconductor-generecommender_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:generecommender ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-generecommender" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/geneRecommender.html" .

