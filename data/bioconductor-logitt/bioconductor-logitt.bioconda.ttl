@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-logitt a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "logit-t Package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/logitT_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/logitT/logitT_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/logitT_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-logitt/bioconductor-logitt_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:logitt ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-logitt" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/logitT.html" .

