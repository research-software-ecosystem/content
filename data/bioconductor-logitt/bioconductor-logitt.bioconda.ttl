@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-logitt a schema1:SoftwareApplication ;
    schema1:alternateName "logit-t Package" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The logitT library implements the Logit-t algorithm introduced in --A high performance test of differential gene expression for oligonucleotide arrays-- by William J Lemon, Sandya Liyanarachchi and Ming You for use with Affymetrix data stored in an AffyBatch object in R." ;
    schema1:identifier <https://bio.tools/biotools:logitt> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-logitt" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/logitT.html" .

