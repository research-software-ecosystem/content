@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-similarpeak a schema1:SoftwareApplication ;
    schema1:alternateName "Metrics to estimate a level of similarity between two ChIP-Seq profiles" ;
    schema1:citation "doi:10.1371/journal.pcbi.1004751" ;
    schema1:description "This package calculates metrics which quantify the level of similarity between ChIP-Seq profiles. More specifically, the package implements six pseudometrics specialized in pattern similarity detection in ChIP-Seq profiles." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/similaRpeak_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/similaRpeak/similaRpeak_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/similaRpeak_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-similarpeak/bioconductor-similarpeak_1.42.0_src_all.tar.gz" ;
    schema1:identifier "biotools:similarpeak" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-similarpeak" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/similaRpeak.html" .

