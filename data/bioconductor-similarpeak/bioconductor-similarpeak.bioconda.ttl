@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-similarpeak a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1004751" ;
    schema:description "Metrics to estimate a level of similarity between two ChIP-Seq profiles" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/similaRpeak_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/similaRpeak/similaRpeak_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/similaRpeak_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-similarpeak/bioconductor-similarpeak_1.42.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-r6" ;
    schema:identifier biotools:similarpeak ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-similarpeak" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/similaRpeak.html" .

