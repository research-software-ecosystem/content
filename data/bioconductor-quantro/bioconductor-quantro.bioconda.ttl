@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-quantro a schema:SoftwareApplication ;
    schema:description "A test for when to use quantile normalization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/quantro_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/quantro/quantro_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/quantro_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-quantro/bioconductor-quantro_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-minfi",
        "r-base",
        "r-doparallel",
        "r-foreach",
        "r-ggplot2",
        "r-iterators",
        "r-rcolorbrewer" ;
    schema:identifier biotools:quantro ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-quantro" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/quantro.html" .

