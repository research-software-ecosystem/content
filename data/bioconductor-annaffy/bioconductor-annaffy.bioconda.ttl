@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annaffy a schema1:SoftwareApplication ;
    schema1:alternateName "Annotation tools for Affymetrix biological metadata" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for handling data from Bioconductor Affymetrix annotation data packages. Produces compact HTML and text reports including experimental data and URL links to many online databases. Allows searching biological metadata using various criteria." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/annaffy_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annaffy/annaffy_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annaffy_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annaffy/bioconductor-annaffy_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:annaffy" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-annaffy" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/annaffy.html" .

