@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annaffy a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Annotation tools for Affymetrix biological metadata" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/annaffy_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annaffy/annaffy_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annaffy_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annaffy/bioconductor-annaffy_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-go.db",
        "r-base",
        "r-biocmanager",
        "r-dbi" ;
    schema:identifier biotools:annaffy ;
    schema:license "LGPL" ;
    schema:name "bioconductor-annaffy" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/annaffy.html" .

