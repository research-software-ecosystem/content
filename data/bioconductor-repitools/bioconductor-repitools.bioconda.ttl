@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-repitools a schema:SoftwareApplication ;
    schema:description "Epigenomic tools" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Repitools_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/Repitools/Repitools_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Repitools_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-repitools/bioconductor-repitools_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-dnacopy",
        "bioconductor-edger",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "r-base",
        "r-cluster",
        "r-gplots",
        "r-gsmoothr",
        "r-mass",
        "r-rsolnp" ;
    schema:identifier biotools:repitools ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-repitools" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/Repitools.html" .

