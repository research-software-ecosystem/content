@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-repitools a schema1:SoftwareApplication ;
    schema1:alternateName "Epigenomic tools" ;
    schema1:description "Tools for the analysis of enrichment-based epigenomic data.  Features include summarization and visualization of epigenomic data across promoters according to gene expression context, finding regions of differential methylation/binding, BayMeth for quantifying methylation etc." ;
    schema1:identifier <https://bio.tools/biotools:repitools> ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-repitools" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/Repitools.html" .

