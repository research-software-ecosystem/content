@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:ssiamb a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:codeRepository "https://github.com/ssi-dk/ssiamb" ;
    schema1:dateCreated "2026-06-23" ;
    schema1:description "ambiguous SNV counter from reads mapped back to their assembly." ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_3197 ;
    schema1:identifier biotools:ssiamb,
        bioconda:ssiamb ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "ssiamb" ;
    schema1:softwareVersion "1.0.0" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/ssiamb" .

