@prefix bioconda: <https://bioconda.github.io/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:ssiamb a schema1:SoftwareApplication ;
    schema1:description "ambiguous SNV counter from reads mapped back to their assembly." ;
    schema1:featureList edam:operation_3197 ;
    schema1:identifier biotools:ssiamb,
        bioconda:ssiamb ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "ssiamb" ;
    schema1:softwareVersion "1.0.0" ;
    schema1:url "https://github.com/ssi-dk/ssiamb" .

