@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bifrost a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/695338" ;
    schema:description "Highly parallel construction and indexing of colored and compacted de Bruijn graphs." ;
    schema:downloadUrl "https://github.com/pmelsted/bifrost/archive/v1.3.5.tar.gz" ;
    schema:hasPart "pthread-stubs",
        "zlib" ;
    schema:identifier biotools:bifrost ;
    schema:license "BSD-2-Clause" ;
    schema:name "bifrost" ;
    schema:softwareHelp "https://github.com/pmelsted/bifrost/blob/v1.3.5/README.md" ;
    schema:softwareVersion "1.3.5" ;
    schema:url "https://github.com/pmelsted/bifrost" .

