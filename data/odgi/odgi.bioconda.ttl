@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:odgi a schema:SoftwareApplication ;
    schema:author "AndreaGuarracino" ;
    schema:citation "doi:10.1093/bioinformatics/btac308" ;
    schema:description "An optimized dynamic genome/graph implementation." ;
    schema:downloadUrl "https://github.com/pangenome/odgi/releases/download/v0.9.4/odgi-v0.9.4.tar.gz" ;
    schema:hasPart "jemalloc",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:odgi ;
    schema:license "MIT" ;
    schema:maintainer "AndreaGuarracino" ;
    schema:name "odgi" ;
    schema:softwareHelp "https://github.com/pangenome/odgi/blob/v0.9.4/README.md" ;
    schema:softwareVersion "0.9.4" ;
    schema:url "https://github.com/pangenome/odgi" .

