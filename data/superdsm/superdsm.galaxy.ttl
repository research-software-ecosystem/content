@prefix biii: <https://biii.eu/> .
@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:superdsm a schema1:SoftwareApplication ;
    bioschemas:output "png",
        "tsv" ;
    schema1:codeRepository <https://superdsm.readthedocs.io> ;
    schema1:dateCreated "2023-06-20" ;
    schema1:description "Globally optimal segmentation method based on superadditivity and deformable shape models for cell nuclei in fluorescence microscopy images" ;
    schema1:encodingFormat "png",
        "tsv" ;
    schema1:featureList edam:operation_3443 ;
    schema1:identifier biii:superdsm,
        biotools:superdsm,
        bioconda:superdsm ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.org> ;
    schema1:keywords "Imaging" ;
    schema1:name "superdsm" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/BMCV/galaxy-image-analysis/tree/master/tools/superdsm/> .

<https://usegalaxy.cz> a schema1:WebSite .

