@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rsem a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-12-323" ;
    schema:description "RSEM is a software package for estimating gene and isoform expression levels from RNA-Seq data." ;
    schema:downloadUrl "https://github.com/deweylab/RSEM/archive/v1.3.3.tar.gz" ;
    schema:hasPart "htslib",
        "perl",
        "perl-module-build",
        "zlib" ;
    schema:identifier biotools:rsem ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "rsem" ;
    schema:softwareHelp "https://deweylab.github.io/RSEM" ;
    schema:softwareVersion "1.3.3" ;
    schema:url "https://deweylab.github.io/RSEM" .

