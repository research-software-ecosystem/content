        }
      ],
      "sc:description": "Retuve is an open-source explainable pipeline designed for the automated analysis of infant hip ultrasound cine sweeps. It performs combined segmentation, Graf-plane calibration, and frame filtering to assess hip quality and measure key orthopedic angles.",
      "sc:featureList": {
        "@id": "edam:operation_2428"
      },
      "sc:name": "Retuve: Explainable Quality Assessment and Measurement Pipeline for Hip Ultrasound",
      "sc:url": "https://github.com/radoss-org/retuve"
    },
