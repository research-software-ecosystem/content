@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-tcgabiolinks a schema1:SoftwareApplication ;
    schema1:alternateName "TCGAbiolinks: An R/Bioconductor package for integrative analysis with GDC data" ;
    schema1:citation "doi:10.1093/nar/gkv1507" ;
    schema1:description "The aim of TCGAbiolinks is : i) facilitate the GDC open-access data retrieval, ii) prepare the data using the appropriate pre-processing strategies, iii) provide the means to carry out different standard analyses and iv) to easily reproduce earlier research results. In more detail, the package provides multiple methods for analysis (e.g., differential expression analysis, identifying differentially methylated regions) and methods for visualization (e.g., survival plots, volcano plots, starburst plots) in order to easily develop complete analysis pipelines." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/TCGAbiolinks_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TCGAbiolinks/TCGAbiolinks_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TCGAbiolinks_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tcgabiolinks/bioconductor-tcgabiolinks_2.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:tcgabiolinks" ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-tcgabiolinks" ;
    schema1:softwareVersion "2.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/TCGAbiolinks.html" .

