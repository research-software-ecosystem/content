@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-tcgabiolinks a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkv1507" ;
    schema:description "TCGAbiolinks: An R/Bioconductor package for integrative analysis with GDC data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/TCGAbiolinks_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TCGAbiolinks/TCGAbiolinks_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TCGAbiolinks_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tcgabiolinks/bioconductor-tcgabiolinks_2.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biomart",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-tcgabiolinksgui.data",
        "r-base",
        "r-data.table",
        "r-downloader",
        "r-dplyr",
        "r-ggplot2",
        "r-httr",
        "r-jsonlite",
        "r-knitr",
        "r-plyr",
        "r-purrr",
        "r-r.utils",
        "r-readr",
        "r-rvest",
        "r-stringr",
        "r-tibble",
        "r-tidyr",
        "r-xml",
        "r-xml2" ;
    schema:identifier biotools:tcgabiolinks ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-tcgabiolinks" ;
    schema:softwareVersion "2.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/TCGAbiolinks.html" .

