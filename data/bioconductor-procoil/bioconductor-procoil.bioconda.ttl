@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-procoil a schema1:SoftwareApplication ;
    schema1:alternateName "Prediction of Oligomerization of Coiled Coil Proteins" ;
    schema1:description "The package allows for predicting whether a coiled coil sequence (amino acid sequence plus heptad register) is more likely to form a dimer or more likely to form a trimer. Additionally to the prediction itself, a prediction profile is computed which allows for determining the strengths to which the individual residues are indicative for either class. Prediction profiles can also be visualized as curves or heatmaps." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/procoil_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/procoil/procoil_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/procoil_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-procoil/bioconductor-procoil_2.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:procoil" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-procoil" ;
    schema1:softwareVersion "2.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/procoil.html" .

