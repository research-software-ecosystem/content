@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-procoil a schema:SoftwareApplication ;
    schema:description "Prediction of Oligomerization of Coiled Coil Proteins" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/procoil_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/procoil/procoil_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/procoil_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-procoil/bioconductor-procoil_2.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-kebabs",
        "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:procoil ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-procoil" ;
    schema:softwareVersion "2.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/procoil.html" .

