@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-subseq a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btu552" ;
    schema1:description "Subsampling of high-throughput sequencing count data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/subSeq_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/subSeq/subSeq_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/subSeq_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-subseq/bioconductor-subseq_1.40.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-qvalue",
        "r-base",
        "r-data.table",
        "r-digest",
        "r-dplyr",
        "r-ggplot2",
        "r-magrittr",
        "r-tidyr" ;
    schema1:identifier biotools:subseq ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-subseq" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/subSeq.html" .

