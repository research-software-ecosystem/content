@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mustang a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/prot.20921" ;
    schema:description "Mustang is a program that implements an algorithm for structural alignment of multiple protein structures." ;
    schema:downloadUrl "https://lcb.infotech.monash.edu.au/mustang/mustang_v3.2.4.tgz" ;
    schema:identifier biotools:mustang ;
    schema:license "file" ;
    schema:name "mustang" ;
    schema:softwareHelp "https://lcb.infotech.monash.edu.au/mustang" ;
    schema:softwareVersion "3.2.4" ;
    schema:url "https://lcb.infotech.monash.edu.au/mustang" .

