  "function": [
    {
      "input": [
        {
          "data": {
            "term": "Protein sequence",
            "uri": "http://edamontology.org/data_2976"
          },
          "format": [
            {
              "term": "FASTA",
              "uri": "http://edamontology.org/format_1929"
            }
          ]
        }
      ],
      "note": "Boltz-2 v2.2.1 runs locally; every predicted structure is retained under content-addressed custody with its confidence files.",
      "operation": [
        {
          "term": "Protein structure prediction",
          "uri": "http://edamontology.org/operation_0474"
        }
      ],
      "output": [
        {
          "data": {
            "term": "Protein structure",
            "uri": "http://edamontology.org/data_1460"
          },
          "format": [
            {
              "term": "mmCIF",
              "uri": "http://edamontology.org/format_1477"
            }
          ]
        }
      ]
    },
    {
      "input": [
        {
          "data": {
            "term": "Protein structure",
            "uri": "http://edamontology.org/data_1460"
          },
          "format": [
            {
              "term": "mmCIF",
              "uri": "http://edamontology.org/format_1477"
            }
          ]
        }
      ],
      "note": "Backbone geometry, per-residue pLDDT and interface PAE are read from the model's own file; a value that was never computed renders as a label.",
      "operation": [
        {
          "term": "Validation",
          "uri": "http://edamontology.org/operation_2428"
        }
      ],
      "output": [
        {
          "data": {
            "term": "Protein structure",
            "uri": "http://edamontology.org/data_1460"
          }
        }
      ]
    },
    {
      "input": [
        {
          "data": {
            "term": "SMILES string",
            "uri": "http://edamontology.org/data_2301"
          },
          "format": [
            {
              "term": "SMILES",
              "uri": "http://edamontology.org/format_1196"
            }
          ]
        }
      ],
      "note": "RDKit validation: parsing, molecular formula, InChIKey and stereochemistry completeness. A SMILES that fails to parse is shown as unverified.",
      "operation": [
        {
          "term": "Structure analysis",
          "uri": "http://edamontology.org/operation_2480"
        }
      ],
