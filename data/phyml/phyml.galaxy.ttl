@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:phyml a schema1:SoftwareApplication ;
    bioschemas:output "nhx",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0091,
        edam:topic_3293 ;
    schema1:codeRepository "http://www.atgc-montpellier.fr/phyml/" ;
    schema1:dateCreated "2019-05-27" ;
    schema1:description "PhyML is a phylogeny software based on the maximum-likelihood principle." ;
    schema1:encodingFormat "nhx",
        "txt" ;
    schema1:identifier biotools:phyml,
        bioconda:phyml ;
    schema1:isPartOf <https://usegalaxy.fr>,
        <https://usegalaxy.fr/published/workflow?id=63b49f322ec366b5>,
        <https://usegalaxy.fr/published/workflow?id=894143d81af8dff0> ;
    schema1:keywords "Phylogenetics" ;
    schema1:name "phyml" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/phyml" .

<https://usegalaxy.fr> a schema1:WebSite .

