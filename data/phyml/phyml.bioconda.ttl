@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phyml a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/sysbio/syq010" ;
    schema:description "Phylogenetic estimation using (Maximum) Likelihood" ;
    schema:downloadUrl "https://github.com/stephaneguindon/phyml/archive/v3.3.20220408.tar.gz" ;
    schema:hasPart "openmpi",
        "pkg-config" ;
    schema:identifier biotools:phyml ;
    schema:license "GPL-3.0-only" ;
    schema:name "phyml" ;
    schema:softwareHelp "https://github.com/stephaneguindon/phyml/blob/master/doc/phyml-manual.pdf" ;
    schema:softwareVersion "3.3.20220408" ;
    schema:url "http://www.atgc-montpellier.fr/phyml/" .

