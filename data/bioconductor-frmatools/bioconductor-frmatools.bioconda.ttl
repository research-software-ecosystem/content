@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-frmatools a schema1:SoftwareApplication ;
    schema1:alternateName "Frozen RMA Tools" ;
    schema1:description "Tools for advanced use of the frma package." ;
    schema1:identifier <https://bio.tools/biotools:frmatools> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-frmatools" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/frmaTools.html" .

