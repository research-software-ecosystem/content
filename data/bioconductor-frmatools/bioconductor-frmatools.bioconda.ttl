@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-frmatools a schema:SoftwareApplication ;
    schema:description "Frozen RMA Tools" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/frmaTools_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/frmaTools/frmaTools_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/frmaTools_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-frmatools/bioconductor-frmatools_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-preprocesscore",
        "r-base",
        "r-dbi" ;
    schema:identifier biotools:frmatools ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-frmatools" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/frmaTools.html" .

