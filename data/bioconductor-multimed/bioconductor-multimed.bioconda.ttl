@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-multimed a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt633" ;
    schema:description "Testing multiple biological mediators simultaneously" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MultiMed_2.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MultiMed/MultiMed_2.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MultiMed_2.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-multimed/bioconductor-multimed_2.32.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:multimed ;
    schema:license "GPL (>= 2) + file LICENSE" ;
    schema:name "bioconductor-multimed" ;
    schema:softwareVersion "2.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MultiMed.html" .

