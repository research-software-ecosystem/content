@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seqfu a schema:SoftwareApplication ;
    schema:author "telatin" ;
    schema:citation "doi:10.3390/bioengineering8050059" ;
    schema:description "DNA sequence utilities." ;
    schema:downloadUrl "https://github.com/telatin/seqfu2/archive/refs/tags/v1.26.0.tar.gz" ;
    schema:hasPart "curl",
        "pcre",
        "zlib" ;
    schema:identifier biotools:seqfu ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "telatin" ;
    schema:name "seqfu" ;
    schema:softwareVersion "1.26.0" ;
    schema:url "https://github.com/telatin/seqfu2" .

