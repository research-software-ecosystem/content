@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-unifiedwmwqpcr a schema:SoftwareApplication ;
    schema:description "Unified Wilcoxon-Mann Whitney Test for testing differential expression in qPCR data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/unifiedWMWqPCR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/unifiedWMWqPCR/unifiedWMWqPCR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/unifiedWMWqPCR_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-unifiedwmwqpcr/bioconductor-unifiedwmwqpcr_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-limma",
        "r-base" ;
    schema:identifier biotools:unifiedwmwqpcr ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-unifiedwmwqpcr" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/unifiedWMWqPCR.html" .

