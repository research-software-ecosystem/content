@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-unifiedwmwqpcr a schema1:SoftwareApplication ;
    schema1:alternateName "Unified Wilcoxon-Mann Whitney Test for testing differential expression in qPCR data" ;
    schema1:description "This packages implements the unified Wilcoxon-Mann-Whitney Test for qPCR data. This modified test allows for testing differential expression in qPCR data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/unifiedWMWqPCR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/unifiedWMWqPCR/unifiedWMWqPCR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/unifiedWMWqPCR_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-unifiedwmwqpcr/bioconductor-unifiedwmwqpcr_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:unifiedwmwqpcr" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-unifiedwmwqpcr" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/unifiedWMWqPCR.html" .

