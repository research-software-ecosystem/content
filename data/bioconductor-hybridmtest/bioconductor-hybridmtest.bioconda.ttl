@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hybridmtest a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Hybrid Multiple Testing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HybridMTest_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HybridMTest/HybridMTest_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HybridMTest_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hybridmtest/bioconductor-hybridmtest_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-fdrtool",
        "r-mass",
        "r-survival" ;
    schema:identifier biotools:hybridmtest ;
    schema:license "GPL Version 2 or later" ;
    schema:name "bioconductor-hybridmtest" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HybridMTest.html" .

