@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:chiron a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/gigascience/giy037" ;
    schema:description "A deep neural network basecaller for nanopore sequencing." ;
    schema:downloadUrl "https://pypi.io/packages/source/c/chiron/chiron-0.6.1.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:Chiron ;
    schema:license "Mozilla Public License 2.0 (MPL 2.0)" ;
    schema:name "chiron" ;
    schema:softwareVersion "0.6.1.1" ;
    schema:url "https://github.com/haotianteng/chiron" .

