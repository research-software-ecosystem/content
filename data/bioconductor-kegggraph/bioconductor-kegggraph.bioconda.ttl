@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-kegggraph a schema:SoftwareApplication ;
    schema:description "KEGGgraph: A graph approach to KEGG PATHWAY in R and Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/KEGGgraph_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/KEGGgraph/KEGGgraph_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/KEGGgraph_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-kegggraph/bioconductor-kegggraph_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-rgraphviz",
        "r-base",
        "r-rcurl",
        "r-xml" ;
    schema:identifier biotools:kegggraph ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-kegggraph" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/KEGGgraph.html" .

