@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ipac a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-14-190" ;
    schema:description "Identification of Protein Amino acid Clustering" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/iPAC_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/iPAC/iPAC_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/iPAC_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ipac/bioconductor-ipac_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-multtest",
        "r-base",
        "r-gdata",
        "r-scatterplot3d" ;
    schema:identifier biotools:ipac ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ipac" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/iPAC.html" .

