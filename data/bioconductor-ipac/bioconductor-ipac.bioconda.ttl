@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ipac a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of Protein Amino acid Clustering" ;
    schema1:citation "doi:10.1186/1471-2105-14-190" ;
    schema1:description "iPAC is a novel tool to identify somatic amino acid mutation clustering within proteins while taking into account protein structure." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/iPAC_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/iPAC/iPAC_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/iPAC_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ipac/bioconductor-ipac_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ipac" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ipac" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/iPAC.html" .

