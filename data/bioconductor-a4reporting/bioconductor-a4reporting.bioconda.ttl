@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-a4reporting a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Automated Affymetrix Array Analysis Reporting Package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/a4Reporting_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/a4Reporting/a4Reporting_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/a4Reporting_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-a4reporting/bioconductor-a4reporting_1.58.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-xtable" ;
    schema:identifier biotools:a4reporting ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-a4reporting" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/a4Reporting.html" .

