@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-a4reporting a schema1:SoftwareApplication ;
    schema1:alternateName "Automated Affymetrix Array Analysis Reporting Package" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Utility functions to facilitate the reporting of the Automated Affymetrix Array Analysis Reporting set of packages." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/a4Reporting_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/a4Reporting/a4Reporting_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/a4Reporting_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-a4reporting/bioconductor-a4reporting_1.58.0_src_all.tar.gz" ;
    schema1:identifier "biotools:a4reporting" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-a4reporting" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/a4Reporting.html" .

