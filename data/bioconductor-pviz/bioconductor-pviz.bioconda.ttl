@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pviz a schema1:SoftwareApplication ;
    schema1:alternateName "Peptide Annotation and Data Visualization using Gviz" ;
    schema1:citation "doi:10.1007/978-1-4939-3037-1_10" ;
    schema1:description "Pviz adapts the Gviz package for protein sequences and data." ;
    schema1:identifier biotools:pviz ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-pviz" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Pviz.html" .

