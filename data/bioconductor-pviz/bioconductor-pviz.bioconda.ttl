@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pviz a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1007/978-1-4939-3037-1_10" ;
    schema1:description "Peptide Annotation and Data Visualization using Gviz" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Pviz_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Pviz/Pviz_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Pviz_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pviz/bioconductor-pviz_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-biovizbase",
        "bioconductor-genomicranges",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "r-base",
        "r-data.table" ;
    schema1:identifier biotools:pviz ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-pviz" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Pviz.html" .

