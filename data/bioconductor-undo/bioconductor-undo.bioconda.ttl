@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-undo a schema1:SoftwareApplication ;
    schema1:alternateName "Unsupervised Deconvolution of Tumor-Stromal Mixed Expressions" ;
    schema1:citation "doi:10.1093/bioinformatics/btu607" ;
    schema1:description "UNDO is an R package for unsupervised deconvolution of tumor and stromal mixed expression data. It detects marker genes and deconvolutes the mixing expression data without any prior knowledge." ;
    schema1:identifier <https://bio.tools/biotools:undo> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-undo" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/UNDO.html" .

