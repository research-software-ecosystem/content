@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-undo a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu607" ;
    schema:description "Unsupervised Deconvolution of Tumor-Stromal Mixed Expressions" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/UNDO_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/UNDO/UNDO_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/UNDO_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-undo/bioconductor-undo_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "r-base",
        "r-boot",
        "r-mass",
        "r-nnls" ;
    schema:identifier biotools:undo ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-undo" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/UNDO.html" .

