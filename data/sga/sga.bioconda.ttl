@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sga a schema:SoftwareApplication ;
    schema:description "SGA - String Graph Assembler. SGA is a de novo assembler for DNA sequence reads. It is based on Gene Myers string graph formulation of assembly and uses the FM-index/Burrows-Wheeler transform to efficiently find overlaps between sequence reads." ;
    schema:downloadUrl "https://github.com/jts/sga/archive/v0.10.15.tar.gz" ;
    schema:hasPart "bamtools",
        "sparsehash",
        "zlib" ;
    schema:identifier biotools:sga ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "sga" ;
    schema:softwareVersion "0.10.15" ;
    schema:url "https://github.com/jts/sga" .

