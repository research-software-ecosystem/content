@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:polypolish a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:operation_2429,
        edam:topic_0102,
        edam:topic_0157,
        edam:topic_0196 ;
    schema1:codeRepository "https://github.com/rrwick/Polypolish" ;
    schema1:dateCreated "2022-09-22" ;
    schema1:description "\"Polypolish is a tool for polishing genome assemblies with short reads.Polypolish uses SAM files where each read has been aligned to all possible locations (not just a single best location).This allows it to repair errors in repeat regions that other alignment-based polishers cannot fix.\"" ;
    schema1:encodingFormat "fasta",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_0523,
        edam:operation_0525,
        edam:operation_3195,
        edam:operation_3198,
        edam:operation_3440 ;
    schema1:identifier biotools:Polypolish,
        bioconda:polypolish ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=2c992e509aa5dd9d>,
        <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1613?version=2> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "polypolish" ;
    schema1:softwareVersion "0.6.1" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/polypolish" .

<https://usegalaxy.eu> a schema1:WebSite .

