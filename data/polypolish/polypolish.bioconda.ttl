@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:polypolish a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1009802" ;
    schema:description "Polishing genome assemblies with short reads." ;
    schema:downloadUrl "https://github.com/rrwick/Polypolish/archive/refs/tags/v0.6.1.tar.gz" ;
    schema:identifier biotools:polypolish ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "polypolish" ;
    schema:softwareHelp "https://github.com/rrwick/Polypolish/wiki" ;
    schema:softwareVersion "0.6.1" ;
    schema:url "https://github.com/rrwick/Polypolish" .

