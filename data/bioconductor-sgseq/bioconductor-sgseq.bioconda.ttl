@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sgseq a schema1:SoftwareApplication ;
    schema1:description "Splice event prediction and quantification from RNA-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SGSeq_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SGSeq/SGSeq_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SGSeq_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sgseq/bioconductor-sgseq_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-igraph",
        "r-runit" ;
    schema1:identifier biotools:sgseq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-sgseq" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SGSeq.html" .

