@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:circtools a schema:SoftwareApplication ;
    schema:author "BarryDigby" ;
    schema:citation "doi:10.1093/bioinformatics/bty948" ;
    schema:description "circtools - a circular RNA toolbox." ;
    schema:downloadUrl "https://pypi.io/packages/source/c/circtools/circtools-2.0.5.post2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:circtools ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "BarryDigby" ;
    schema:name "circtools" ;
    schema:softwareHelp "https://docs.circ.tools/en/latest" ;
    schema:softwareVersion "2.0.5.post2" ;
    schema:url "https://github.com/jakobilab/circtools" .

