@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:predicthaplo a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/TCBB.2013.145" ;
    schema:description "This software aims at reconstructing haplotypes from next-generation sequencing data." ;
    schema:downloadUrl "https://github.com/cbg-ethz/PredictHaplo/archive/2.1.4.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack" ;
    schema:identifier biotools:PredictHaplo ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "predicthaplo" ;
    schema:softwareVersion "2.1.4" ;
    schema:url "https://github.com/cbg-ethz/PredictHaplo" .

