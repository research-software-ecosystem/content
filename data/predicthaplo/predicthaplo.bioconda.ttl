@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:predicthaplo a schema1:SoftwareApplication ;
    schema1:alternateName "This software aims at reconstructing haplotypes from next-generation sequencing data." ;
    schema1:citation "doi:10.1109/TCBB.2013.145" ;
    schema1:description "This software aims at reconstructing haplotypes from next-generation sequencing data." ;
    schema1:identifier <https://bio.tools/biotools:PredictHaplo> ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "predicthaplo" ;
    schema1:softwareVersion "2.1.4" ;
    schema1:url "https://github.com/cbg-ethz/PredictHaplo" .

