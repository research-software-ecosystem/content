@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-omiccircos a schema:SoftwareApplication ;
    schema:citation "doi:10.4137/cin.s13495" ;
    schema:description "High-quality circular visualization of omics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/OmicCircos_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OmicCircos/OmicCircos_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OmicCircos_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-omiccircos/bioconductor-omiccircos_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicranges",
        "r-base" ;
    schema:identifier biotools:omiccircos ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-omiccircos" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/OmicCircos.html" .

