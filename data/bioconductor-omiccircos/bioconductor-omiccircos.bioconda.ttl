@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-omiccircos a schema1:SoftwareApplication ;
    schema1:alternateName "High-quality circular visualization of omics data" ;
    schema1:citation "doi:10.4137/cin.s13495" ;
    schema1:description "OmicCircos is an R application and package for generating high-quality circular plots for omics data." ;
    schema1:identifier <https://bio.tools/biotools:omiccircos> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-omiccircos" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/OmicCircos.html" .

