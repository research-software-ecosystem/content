@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ngscheckmate a schema1:SoftwareApplication ;
    schema1:alternateName "Software package for identifying next generation sequencing (NGS) data files from the same individual." ;
    schema1:description "This version is built from a pull request which fixes a handful of known bugs." ;
    schema1:identifier <https://bio.tools/biotools:ngscheckmate> ;
    schema1:license "MIT" ;
    schema1:name "ngscheckmate" ;
    schema1:softwareVersion "1.0.1" ;
    schema1:url "https://github.com/parklab/NGSCheckMate" .

