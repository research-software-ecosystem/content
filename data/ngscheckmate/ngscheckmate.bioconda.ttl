@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ngscheckmate a schema:SoftwareApplication ;
    schema:description "Software package for identifying next generation sequencing (NGS) data files from the same individual." ;
    schema:downloadUrl "https://github.com/parklab/NGSCheckMate/archive/ef7a38c51dadbd4ef5b6b6db60775f239926f0a8.zip" ;
    schema:hasPart "bcftools",
        "bowtie",
        "python",
        "samtools",
        "zlib" ;
    schema:identifier biotools:ngscheckmate ;
    schema:license "MIT" ;
    schema:name "ngscheckmate" ;
    schema:softwareHelp "https://github.com/parklab/NGSCheckMate/blob/master/Documentation.pdf" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "https://github.com/parklab/NGSCheckMate" .

