@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-altcdfenvs a schema1:SoftwareApplication ;
    schema1:alternateName "alternative CDF environments (aka probeset mappings)" ;
    schema1:description "Convenience data structures and functions to handle cdfenvs" ;
    schema1:identifier biotools:altcdfenvs ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-altcdfenvs" ;
    schema1:softwareVersion "2.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/altcdfenvs.html" .

