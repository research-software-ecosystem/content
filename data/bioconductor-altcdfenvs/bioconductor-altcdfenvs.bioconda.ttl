@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-altcdfenvs a schema:SoftwareApplication ;
    schema:description "alternative CDF environments (aka probeset mappings)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/altcdfenvs_2.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/altcdfenvs/altcdfenvs_2.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/altcdfenvs_2.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-altcdfenvs/bioconductor-altcdfenvs_2.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-hypergraph",
        "bioconductor-makecdfenv",
        "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:altcdfenvs ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-altcdfenvs" ;
    schema:softwareVersion "2.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/altcdfenvs.html" .

