@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ensembl-vep a schema:SoftwareApplication ;
    schema:description "Ensembl Variant Effect Predictor" ;
    schema:downloadUrl "https://github.com/Ensembl/ensembl-vep/archive/refs/tags/release/116.0.tar.gz" ;
    schema:hasPart "curl",
        "perl",
        "perl-archive-zip",
        "perl-dbi",
        "perl-libwww-perl",
        "unzip" ;
    schema:identifier biotools:vep ;
    schema:license "Apache-2.0" ;
    schema:name "ensembl-vep" ;
    schema:softwareHelp "https://useast.ensembl.org/info/docs/tools/vep/script/vep_tutorial.html" ;
    schema:softwareVersion "116.0" ;
    schema:url "https://www.ensembl.org/info/docs/tools/vep/index.html" .

