@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ensembl-vep a schema1:SoftwareApplication ;
    schema1:alternateName "Ensembl Variant Effect Predictor" ;
    schema1:description "The VEP determines the effect of your variants (SNPs, insertions, deletions, CNVs or structural variants) on genes, transcripts, and protein sequence, as well as regulatory regions." ;
    schema1:identifier biotools:vep ;
    schema1:license "Apache-2.0" ;
    schema1:name "ensembl-vep" ;
    schema1:softwareVersion "116.1" ;
    schema1:url "https://www.ensembl.org/info/docs/tools/vep/index.html" .

