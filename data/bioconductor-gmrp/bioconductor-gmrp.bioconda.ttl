@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gmrp a schema1:SoftwareApplication ;
    schema1:alternateName "GWAS-based Mendelian Randomization and Path Analyses" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Perform Mendelian randomization analysis of multiple SNPs to determine risk factors causing disease of study and to exclude confounding variabels and perform path analysis to construct path of risk factors to the disease." ;
    schema1:identifier biotools:gmrp ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-gmrp" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GMRP.html" .

