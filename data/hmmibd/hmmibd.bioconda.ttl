@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:hmmibd a schema1:SoftwareApplication ;
    schema1:alternateName "A hidden Markov model for detecting segments of shared ancestry (identity by descent) in haploid genomes" ;
    schema1:citation "doi:10.1186/s12936-018-2349-7" ;
    schema1:description "A hidden Markov model for detecting segments of shared ancestry (identity by descent) in haploid genomes" ;
    schema1:identifier biotools:hmmIBD ;
    schema1:license "GPL-3.0-only" ;
    schema1:maintainer "d-callan" ;
    schema1:name "hmmibd" ;
    schema1:softwareVersion "2.1.3" ;
    schema1:url "https://github.com/glipsnort/hmmIBD" .

