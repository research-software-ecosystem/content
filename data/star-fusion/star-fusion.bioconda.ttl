@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:star-fusion a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-019-1842-9" ;
    schema:description "STAR-Fusion fusion variant caller. All dependencies required to run FusionInspector and FusionAnnotator are included." ;
    schema:downloadUrl "https://github.com/STAR-Fusion/STAR-Fusion/releases/download/STAR-Fusion-v1.15.1/STAR-Fusion-v1.15.1.FULL.tar.gz" ;
    schema:identifier biotools:star-fusion ;
    schema:license "BSD-3-Clause" ;
    schema:name "star-fusion" ;
    schema:softwareHelp "https://github.com/STAR-Fusion/STAR-Fusion/wiki" ;
    schema:softwareVersion "1.15.1" ;
    schema:url "https://github.com/STAR-Fusion/STAR-Fusion" .

