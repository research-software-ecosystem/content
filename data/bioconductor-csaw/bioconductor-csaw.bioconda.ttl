@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-csaw a schema1:SoftwareApplication ;
    schema1:alternateName "ChIP-Seq Analysis with Windows" ;
    schema1:description "Detection of differentially bound regions in ChIP-seq data with sliding windows, with methods for normalization and proper FDR control." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/csaw_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/csaw/csaw_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/csaw_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-csaw/bioconductor-csaw_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:csaw" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-csaw" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/csaw.html" .

