@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-csaw a schema:SoftwareApplication ;
    schema:description "ChIP-Seq Analysis with Windows" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/csaw_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/csaw/csaw_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/csaw_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-csaw/bioconductor-csaw_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-edger",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-metapod",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:csaw ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-csaw" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/csaw.html" .

