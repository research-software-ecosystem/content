@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/cyto.a.22735" ;
    schema:description "Mapping cell populations in flow cytometry data for cross-sample comparisons using the Friedman-Rafsky Test" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowMap_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/flowMap/flowMap_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/flowMap_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowmap/bioconductor-flowmap_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-abind",
        "r-ade4",
        "r-base",
        "r-doparallel",
        "r-matrix",
        "r-reshape2",
        "r-scales" ;
    schema:identifier biotools:flowmap ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-flowmap" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/flowMap.html" .

