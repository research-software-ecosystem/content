@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowmap a schema1:SoftwareApplication ;
    schema1:alternateName "Mapping cell populations in flow cytometry data for cross-sample comparisons using the Friedman-Rafsky Test" ;
    schema1:citation "doi:10.1002/cyto.a.22735" ;
    schema1:description "flowMap quantifies the similarity of cell populations across multiple flow cytometry samples using a nonparametric multivariate statistical test. The method is able to map cell populations of different size, shape, and proportion across multiple flow cytometry samples. The algorithm can be incorporate in any flow cytometry work flow that requires accurat quantification of similarity between cell populations." ;
    schema1:identifier biotools:flowmap ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-flowmap" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/flowMap.html" .

