@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-variantfiltering a schema1:SoftwareApplication ;
    schema1:alternateName "Filtering of coding and non-coding genetic variants" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Filter genetic variants using different criteria such as inheritance model, amino acid change consequence, minor allele frequencies across human populations, splice site strength, conservation, etc." ;
    schema1:identifier <https://bio.tools/biotools:variantfiltering> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-variantfiltering" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/VariantFiltering.html" .

