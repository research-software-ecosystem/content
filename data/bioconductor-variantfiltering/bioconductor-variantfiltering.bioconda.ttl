@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-variantfiltering a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Filtering of coding and non-coding genetic variants" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/VariantFiltering_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/VariantFiltering/VariantFiltering_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/VariantFiltering_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-variantfiltering/bioconductor-variantfiltering_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-genomicscores",
        "bioconductor-graph",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "bioconductor-rbgl",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dt",
        "r-shiny",
        "r-shinyjs",
        "r-shinythemes",
        "r-shinytree",
        "zlib" ;
    schema:identifier biotools:variantfiltering ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-variantfiltering" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/VariantFiltering.html" .

