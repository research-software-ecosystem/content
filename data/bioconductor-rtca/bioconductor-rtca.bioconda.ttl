@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtca a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.compbiolchem.2013.12.004" ;
    schema:description "Open-source toolkit to analyse data from xCELLigence System (RTCA)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RTCA_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RTCA/RTCA_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RTCA_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtca/bioconductor-rtca_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-gtools",
        "r-rcolorbrewer" ;
    schema:identifier biotools:rtca ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-rtca" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RTCA.html" .

