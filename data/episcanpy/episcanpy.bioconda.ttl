@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:episcanpy a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-021-25131-3" ;
    schema:description "Epigenomics Single-Cell Analysis in Python." ;
    schema:downloadUrl "https://pypi.io/packages/source/e/episcanpy/episcanpy-0.4.0.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:epiScanpy ;
    schema:license "BSD-3-Clause" ;
    schema:name "episcanpy" ;
    schema:softwareVersion "0.4.0" ;
    schema:url "https://github.com/colomemaria/epiScanpy" .

