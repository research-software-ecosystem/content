@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:snakemake a schema:SoftwareApplication ;
    schema:author "corneliusroemer",
        "johanneskoester" ;
    schema:citation "doi:10.1093/bioinformatics/bts480" ;
    schema:description "A popular workflow management system aiming at full in-silico reproducibility." ;
    schema:downloadUrl "https://pypi.io/packages/source/s/snakemake/snakemake-9.23.1.tar.gz" ;
    schema:identifier biotools:snakemake ;
    schema:license "MIT" ;
    schema:maintainer "corneliusroemer",
        "johanneskoester" ;
    schema:name "snakemake" ;
    schema:softwareHelp "https://snakemake.readthedocs.io/en/stable" ;
    schema:softwareVersion "9.23.1" ;
    schema:url "https://snakemake.github.io" .

