@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:maker a schema:SoftwareApplication ;
    schema:description "MAKER is a portable and easily configurable genome annotation pipeline." ;
    schema:downloadUrl "http://weatherby.genetics.utah.edu/maker_downloads/static/maker-3.01.04.tgz" ;
    schema:hasPart "mpich-mpicc",
        "perl",
        "perl-bioperl-core",
        "perl-bit-vector",
        "perl-dbd-pg",
        "perl-dbd-sqlite",
        "perl-dbi",
        "perl-forks",
        "perl-inline-c",
        "perl-io-all",
        "perl-io-prompt",
        "perl-perl-unsafe-signals",
        "perl-perlio-gzip",
        "perl-uri" ;
    schema:identifier biotools:maker ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "maker" ;
    schema:softwareHelp "https://www.yandell-lab.org/software/maker.html" ;
    schema:softwareVersion "3.01.04" ;
    schema:url "https://www.yandell-lab.org/software/maker.html" .

