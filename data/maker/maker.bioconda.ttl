@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:maker a schema1:SoftwareApplication ;
    schema1:alternateName "MAKER is a portable and easily configurable genome annotation pipeline." ;
    schema1:description "MAKER is a portable and easily configurable genome annotation pipeline." ;
    schema1:identifier <https://bio.tools/biotools:maker>,
        "usegalaxy-eu:maker" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "maker" ;
    schema1:softwareVersion "3.01.04" ;
    schema1:url "https://www.yandell-lab.org/software/maker.html" .

