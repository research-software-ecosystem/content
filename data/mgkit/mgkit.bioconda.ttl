@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mgkit a schema:SoftwareApplication ;
    schema:citation "doi:10.6084/m9.figshare.1588384" ;
    schema:description "Metagenomics Framework" ;
    schema:downloadUrl "https://github.com/frubino/mgkit/archive/refs/tags/0.5.8.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "pytest-runner",
        "python" ;
    schema:identifier biotools:mgkit ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "mgkit" ;
    schema:softwareVersion "0.5.8" ;
    schema:url "https://github.com/frubino/mgkit" .

