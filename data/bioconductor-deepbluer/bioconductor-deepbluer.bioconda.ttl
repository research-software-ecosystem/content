@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-deepbluer a schema1:SoftwareApplication ;
    schema1:alternateName "DeepBlueR" ;
    schema1:description "Accessing the DeepBlue Epigenetics Data Server through R." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DeepBlueR_1.27.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/DeepBlueR/DeepBlueR_1.27.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/DeepBlueR_1.27.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-deepbluer/bioconductor-deepbluer_1.27.0_src_all.tar.gz" ;
    schema1:identifier "biotools:deepbluer" ;
    schema1:license "GPL (>=2.0)" ;
    schema1:name "bioconductor-deepbluer" ;
    schema1:softwareVersion "1.27.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/DeepBlueR.html" .

