@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbioinf a schema1:SoftwareApplication ;
    schema1:alternateName "RBioinf" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions and datasets and examples to accompany the monograph R For Bioinformatics." ;
    schema1:identifier <https://bio.tools/biotools:rbioinf> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-rbioinf" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/RBioinf.html" .

