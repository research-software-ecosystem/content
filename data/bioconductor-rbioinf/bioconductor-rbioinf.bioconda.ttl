@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbioinf a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "RBioinf" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RBioinf_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/RBioinf/RBioinf_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/RBioinf_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbioinf/bioconductor-rbioinf_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:rbioinf ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-rbioinf" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/RBioinf.html" .

