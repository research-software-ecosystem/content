@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bracken a schema:SoftwareApplication ;
    schema:citation "doi:10.7717/peerj-cs.104" ;
    schema:description "Bracken (Bayesian Reestimation of Abundance with KrakEN) is a highly accurate statistical method that computes the abundance of species in DNA sequences from a metagenomics sample." ;
    schema:downloadUrl "https://github.com/jenniferlu717/Bracken/archive/v3.1.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:Bracken ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "bracken" ;
    schema:softwareHelp "https://github.com/jenniferlu717/Bracken/blob/v3.1p1/README.md" ;
    schema:softwareVersion "3.1p1" ;
    schema:url "https://github.com/jenniferlu717/Bracken" .

