@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bracken a schema1:SoftwareApplication ;
    schema1:alternateName "Bracken (Bayesian Reestimation of Abundance with KrakEN) is a highly accurate statistical method that computes the abundance of species in DNA sequences from a metagenomics sample." ;
    schema1:citation "doi:10.7717/peerj-cs.104" ;
    schema1:description "Bracken (Bayesian Reestimation of Abundance with KrakEN) is a highly accurate statistical method that computes the abundance of species in DNA sequences from a metagenomics sample." ;
    schema1:identifier <https://bio.tools/biotools:Bracken>,
        "usegalaxy-eu:est_abundance" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "bracken" ;
    schema1:softwareVersion "3.1p1" ;
    schema1:url "https://github.com/jenniferlu717/Bracken" .

