@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-amplican a schema1:SoftwareApplication ;
    schema1:description "Automated analysis of CRISPR experiments" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/amplican_1.32.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/amplican/amplican_1.32.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/amplican_1.32.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-amplican/bioconductor-amplican_1.32.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-pwalign",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-shortread",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-ggthemes",
        "r-gridextra",
        "r-gtable",
        "r-knitr",
        "r-matrix",
        "r-matrixstats",
        "r-rcpp",
        "r-rmarkdown",
        "r-stringr",
        "zlib" ;
    schema1:identifier biotools:amplican ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-amplican" ;
    schema1:softwareVersion "1.32.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/amplican.html" .

