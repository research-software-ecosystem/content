@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-amplican a schema:SoftwareApplication ;
    schema:description "Automated analysis of CRISPR experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/amplican_1.32.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/amplican/amplican_1.32.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/amplican_1.32.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-amplican/bioconductor-amplican_1.32.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-pwalign",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-shortread",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-ggthemes",
        "r-gridextra",
        "r-gtable",
        "r-knitr",
        "r-matrix",
        "r-matrixstats",
        "r-rcpp",
        "r-rmarkdown",
        "r-stringr",
        "zlib" ;
    schema:identifier biotools:amplican ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-amplican" ;
    schema:softwareVersion "1.32.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/amplican.html" .

