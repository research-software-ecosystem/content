@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mob_suite a schema1:SoftwareApplication ;
    schema1:alternateName "MOB-suite is a set of tools for finding, typing and reconstruction of plasmids from draft and complete genome assemblies." ;
    schema1:citation "doi:10.1099/mgen.0.000206",
        "doi:10.1099/mgen.0.000435" ;
    schema1:description "MOB-suite is a set of tools for finding, typing and reconstruction of plasmids from draft and complete genome assemblies." ;
    schema1:identifier <https://bio.tools/biotools:mob-suite>,
        "usegalaxy-eu:mob_recon",
        "usegalaxy-eu:mob_typer" ;
    schema1:license "Apache-2.0" ;
    schema1:name "mob_suite" ;
    schema1:softwareVersion "3.1.9" ;
    schema1:url "https://pypi.org/project/mob-suite/" .

