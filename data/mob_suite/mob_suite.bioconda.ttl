@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mob_suite a schema:SoftwareApplication ;
    schema:citation "doi:10.1099/mgen.0.000206",
        "doi:10.1099/mgen.0.000435" ;
    schema:description "MOB-suite is a set of tools for finding, typing and reconstruction of plasmids from draft and complete genome assemblies." ;
    schema:downloadUrl "https://pypi.io/packages/source/m/mob_suite/mob_suite-3.1.9.tar.gz" ;
    schema:hasPart "pip",
        "pytest-runner",
        "python" ;
    schema:identifier biotools:mob-suite ;
    schema:license "Apache-2.0" ;
    schema:name "mob_suite" ;
    schema:softwareHelp "https://github.com/phac-nml/mob-suite/blob/master/README.md" ;
    schema:softwareVersion "3.1.9" ;
    schema:url "https://pypi.org/project/mob-suite/" .

