@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bader a schema1:SoftwareApplication ;
    schema1:alternateName "Bayesian Analysis of Differential Expression in RNA Sequencing Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "For RNA sequencing count data, BADER fits a Bayesian hierarchical model. The algorithm returns the posterior probability of differential expression for each gene between two groups A and B. The joint posterior distribution of the variables in the model can be returned in the form of posterior samples, which can be used for further down-stream analyses such as gene set enrichment." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BADER_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BADER/BADER_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BADER_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bader/bioconductor-bader_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:bader" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-bader" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BADER.html" .

