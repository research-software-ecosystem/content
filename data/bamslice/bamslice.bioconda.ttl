@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bamslice a schema:SoftwareApplication ;
    schema:author "bwlang" ;
    schema:description "Extract byte ranges from BAM files and convert to interleaved FASTQ format for parallel processing" ;
    schema:downloadUrl "https://github.com/nebiolabs/bamslice/archive/v0.2.1.tar.gz" ;
    schema:hasPart "bzip2",
        "libcurl",
        "libdeflate",
        "openssl",
        "xz",
        "zlib" ;
    schema:identifier biotools:bamslice ;
    schema:license "AGPL-3.0-only" ;
    schema:maintainer "bwlang" ;
    schema:name "bamslice" ;
    schema:softwareHelp "https://docs.rs/bamslice" ;
    schema:softwareVersion "0.2.1" ;
    schema:url "https://github.com/nebiolabs/bamslice" .

