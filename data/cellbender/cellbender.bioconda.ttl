@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cellbender a schema:SoftwareApplication ;
    schema:author "mencian" ;
    schema:citation "doi:10.1038/s41592-023-01943-7" ;
    schema:description "A software package for eliminating technical artifacts from high-throughput single-cell RNA sequencing (scRNA-seq) data" ;
    schema:downloadUrl "https://github.com/broadinstitute/CellBender/archive/v0.3.2.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:CellBender ;
    schema:license "BSD-3-Clause" ;
    schema:maintainer "mencian" ;
    schema:name "cellbender" ;
    schema:softwareHelp "https://cellbender.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.3.2" ;
    schema:url "https://github.com/broadinstitute/CellBender" .

