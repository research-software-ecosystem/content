@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:raxml-ng a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btz305" ;
    schema:description "RAxML Next Generation: faster, easier-to-use and more flexible." ;
    schema:downloadUrl "https://github.com/amkozlov/raxml-ng/releases/download/2.0.2/raxml-ng_v2.0.2_source.zip" ;
    schema:hasPart "gmp",
        "htslib",
        "openmpi" ;
    schema:identifier biotools:RAxML-NG ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "raxml-ng" ;
    schema:softwareVersion "2.0.2" ;
    schema:url "https://github.com/amkozlov/raxml-ng" .

