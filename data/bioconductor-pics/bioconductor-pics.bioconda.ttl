@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pics a schema:SoftwareApplication ;
    schema:description "Probabilistic inference of ChIP-seq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PICS_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/PICS/PICS_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/PICS_2.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pics/bioconductor-pics_2.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:pics ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-pics" ;
    schema:softwareVersion "2.50.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/PICS.html" .

