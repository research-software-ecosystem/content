@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pics a schema1:SoftwareApplication ;
    schema1:alternateName "Probabilistic inference of ChIP-seq" ;
    schema1:description "Probabilistic inference of ChIP-Seq using an empirical Bayes mixture model approach." ;
    schema1:identifier biotools:pics ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-pics" ;
    schema1:softwareVersion "2.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/PICS.html" .

