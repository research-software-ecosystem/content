@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:lexicmap a schema1:SoftwareApplication ;
    bioschemas:output "lexicmap_index",
        "tabular",
        "tsv" ;
    schema1:codeRepository <https://github.com/shenwei356/LexicMap> ;
    schema1:dateCreated "2025-06-16" ;
    schema1:description "LexicMap is a nucleotide sequence alignment tool for efficiently querying genomes." ;
    schema1:encodingFormat "lexicmap_index",
        "tabular",
        "tsv" ;
    schema1:identifier biotools:lexicmap,
        bioconda:lexicmap ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.org> ;
    schema1:keywords "Next Gen Mappers" ;
    schema1:name "lexicmap" ;
    schema1:softwareVersion "0.9.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/lexicmap> .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org> a schema1:WebSite .

