@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:malva a schema:SoftwareApplication ;
    schema:description "genotyping by Mapping-free ALternate-allele detection of known VAriants" ;
    schema:downloadUrl "https://github.com/AlgoLab/malva/archive/v2.0.0.tar.gz" ;
    schema:hasPart "htslib",
        "kmc",
        "zlib" ;
    schema:identifier biotools:malva ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "malva" ;
    schema:softwareVersion "2.0.0" ;
    schema:url "https://algolab.github.io/malva/" .

