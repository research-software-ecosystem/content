@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bttoxin_digger a schema:SoftwareApplication ;
    schema:author "liaochenlanruo" ;
    schema:description "A toxin minging tool for Bacillus thuringiensis" ;
    schema:downloadUrl "https://github.com/liaochenlanruo/BtToxin_Digger/archive/v1.0.10.tar.gz" ;
    schema:hasPart "perl",
        "perl-bioperl",
        "perl-file-tee" ;
    schema:identifier biotools:bttoxin_digger ;
    schema:license "GPLv3" ;
    schema:maintainer "liaochenlanruo" ;
    schema:name "bttoxin_digger" ;
    schema:softwareVersion "1.0.10" ;
    schema:url "https://github.com/liaochenlanruo/BtToxin_Digger/blob/master/README.md" .

