@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-preda a schema1:SoftwareApplication ;
    schema1:alternateName "Position Related Data Analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/btr404" ;
    schema1:description "Package for the position related analysis of quantitative functional genomics data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PREDA_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PREDA/PREDA_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PREDA_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-preda/bioconductor-preda_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:preda" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-preda" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PREDA.html" .

