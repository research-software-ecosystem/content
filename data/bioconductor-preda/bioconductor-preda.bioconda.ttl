@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-preda a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr404" ;
    schema:description "Position Related Data Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PREDA_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PREDA/PREDA_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PREDA_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-preda/bioconductor-preda_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-biobase",
        "bioconductor-multtest",
        "r-base",
        "r-lokern" ;
    schema:identifier biotools:preda ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-preda" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PREDA.html" .

