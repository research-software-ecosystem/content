@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-plier a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Implements the Affymetrix PLIER algorithm" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/plier_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/plier/plier_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/plier_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-plier/bioconductor-plier_1.80.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:plier ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-plier" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/plier.html" .

