@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-plier a schema1:SoftwareApplication ;
    schema1:alternateName "Implements the Affymetrix PLIER algorithm" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The PLIER (Probe Logarithmic Error Intensity Estimate) method produces an improved signal by accounting for experimentally observed patterns in probe behavior and handling error at the appropriately at low and high signal values." ;
    schema1:identifier biotools:plier ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-plier" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/plier.html" .

