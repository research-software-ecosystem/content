@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:emboss a schema:SoftwareApplication ;
    schema:description "The European Molecular Biology Open Software Suite." ;
    schema:downloadUrl "ftp://emboss.open-bio.org/pub/EMBOSS/EMBOSS-6.6.0.tar.gz" ;
    schema:hasPart "libgd",
        "libharu",
        "libpng",
        "openjdk",
        "zlib" ;
    schema:identifier biotools:emboss ;
    schema:license "GPL-2.0-only" ;
    schema:name "emboss" ;
    schema:softwareHelp "https://emboss.sourceforge.net" ;
    schema:softwareVersion "6.6.0" ;
    schema:url "https://emboss.sourceforge.net" .

