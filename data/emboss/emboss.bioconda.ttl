@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:emboss a schema1:SoftwareApplication ;
    schema1:alternateName "The European Molecular Biology Open Software Suite." ;
    schema1:description "The European Molecular Biology Open Software Suite." ;
    schema1:identifier biotools:emboss,
        "usegalaxy-eu:emboss_needle",
        "usegalaxy-eu:emboss_needleall" ;
    schema1:license "GPL-2.0-only" ;
    schema1:name "emboss" ;
    schema1:softwareVersion "6.6.0" ;
    schema1:url "https://emboss.sourceforge.net" .

