@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:rbpbench a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "fasta",
        "html",
        "pdf",
        "png",
        "tabular" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:topic_0080,
        edam:topic_0091,
        edam:topic_0099,
        edam:topic_0128,
        edam:topic_3794 ;
    schema1:codeRepository "https://github.com/michauhl/RBPBench" ;
    schema1:dateCreated "2023-12-03" ;
    schema1:description "Evaluate CLIP-seq and other genomic region data using a comprehensive collection of RBP binding motifs" ;
    schema1:encodingFormat "bed",
        "fasta",
        "html",
        "pdf",
        "png",
        "tabular" ;
    schema1:identifier biotools:rbpbench,
        bioconda:rbpbench ;
    schema1:keywords "CLIP-seq",
        "RNA",
        "Sequence Analysis" ;
    schema1:name "rbpbench" ;
    schema1:softwareVersion "0.8.1" ;
    schema1:url "https://github.com/bgruening/galaxytools/tree/master/tools/rna_tools/rbpbench" .

