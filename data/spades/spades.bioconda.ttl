@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:spades a schema:SoftwareApplication ;
    schema:author "chrisjackson-pellicle",
        "druvus",
        "notestaff" ;
    schema:citation "doi:10.1089/cmb.2012.0021",
        "doi:10.1093/bioinformatics/btz349",
        "doi:10.1093/gigascience/giz100",
        "doi:10.1101/gr.213959.116" ;
    schema:description "SPAdes (St. Petersburg genome assembler) is intended for both standard isolates and single-cell MDA bacteria assemblies." ;
    schema:downloadUrl "https://github.com/ablab/spades/releases/download/v4.3.0/SPAdes-4.3.0.tar.gz" ;
    schema:hasPart "bzip2",
        "doxygen",
        "libgomp",
        "llvm-openmp",
        "openmpi",
        "zlib" ;
    schema:identifier biotools:spades ;
    schema:license "GPL-2.0-only" ;
    schema:maintainer "chrisjackson-pellicle",
        "druvus",
        "notestaff" ;
    schema:name "spades" ;
    schema:softwareHelp "https://ablab.github.io/spades" ;
    schema:softwareVersion "4.3.0" ;
    schema:url "https://github.com/ablab/spades" .

