@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mashmap a schema:SoftwareApplication ;
    schema:author "bkille",
        "mjsteinbaugh" ;
    schema:citation "doi:10.1007/978-3-319-56970-3_5",
        "doi:10.1093/bioinformatics/bty597",
        "doi:10.1101/2023.05.16.540882" ;
    schema:description "A fast approximate aligner for long DNA sequences." ;
    schema:downloadUrl "https://github.com/marbl/MashMap/archive/v3.1.3.tar.gz" ;
    schema:hasPart "gsl",
        "htslib",
        "openblas",
        "perl",
        "zlib" ;
    schema:identifier biotools:mashmap ;
    schema:license "Custom" ;
    schema:maintainer "bkille",
        "mjsteinbaugh" ;
    schema:name "mashmap" ;
    schema:softwareHelp "https://github.com/marbl/MashMap/blob/v3.1.3/README.md" ;
    schema:softwareVersion "3.1.3" ;
    schema:url "https://github.com/marbl/MashMap" .

