@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbowtie a schema1:SoftwareApplication ;
    schema1:alternateName "R bowtie wrapper" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides an R wrapper around the popular bowtie short read aligner and around SpliceMap, a de novo splice junction discovery and alignment tool. The package is used by the QuasR bioconductor package. We recommend to use the QuasR package instead of using Rbowtie directly." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Rbowtie_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rbowtie/Rbowtie_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rbowtie_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbowtie/bioconductor-rbowtie_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rbowtie" ;
    schema1:license "Artistic-2.0 | file LICENSE" ;
    schema1:name "bioconductor-rbowtie" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Rbowtie.html" .

