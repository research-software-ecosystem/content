@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:lightstringgraph a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-662-44753-6_23" ;
    schema:description "LightStringGraphs (LSG) is an external memory string graph construction tool." ;
    schema:downloadUrl "https://github.com/AlgoLab/LightStringGraph/archive/v0.4.0.tar.gz" ;
    schema:hasPart "boost" ;
    schema:identifier biotools:lightstringgraph ;
    schema:license "GPL-3" ;
    schema:name "lightstringgraph" ;
    schema:softwareVersion "0.4.0" ;
    schema:url "http://lsg.algolab.eu" .

