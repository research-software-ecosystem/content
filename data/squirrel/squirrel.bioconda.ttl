@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:squirrel a schema:SoftwareApplication ;
    schema:description "Some QUIck Reconstruction to Resolve Evolutionary Links." ;
    schema:downloadUrl "https://github.com/aineniamh/squirrel/archive/refs/tags/1.3.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:squirrel ;
    schema:license "GPL-3.0-only" ;
    schema:name "squirrel" ;
    schema:softwareHelp "https://github.com/aineniamh/squirrel/blob/1.3.2/README.md" ;
    schema:softwareVersion "1.3.2" ;
    schema:url "https://github.com/aineniamh/squirrel" .

