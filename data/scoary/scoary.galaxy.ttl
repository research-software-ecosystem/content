@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:scoary a schema1:SoftwareApplication ;
    bioschemas:output "newick",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0085,
        edam:topic_0621,
        edam:topic_0625,
        edam:topic_3517 ;
    schema1:codeRepository <https://github.com/AdmiralenOla/Scoary> ;
    schema1:dateCreated "2021-03-18" ;
    schema1:description "Scoary calculates the assocations between all genes in the accessory genome and the traits." ;
    schema1:encodingFormat "newick",
        "tabular" ;
    schema1:identifier biotools:scoary,
        bioconda:scoary ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "scoary" ;
    schema1:softwareVersion "@TOOL_VERSION@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/scoary> .

<https://usegalaxy.cz> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

