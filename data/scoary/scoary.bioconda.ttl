@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:scoary a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-016-1108-8" ;
    schema:description "Microbial pan-GWAS using the output from Roary" ;
    schema:downloadUrl "https://github.com/AdmiralenOla/Scoary/archive/v1.6.16.tar.gz" ;
    schema:hasPart "argparse",
        "ete3",
        "python",
        "scipy",
        "setuptools",
        "six" ;
    schema:identifier biotools:Scoary ;
    schema:license "GPL-3.0" ;
    schema:name "scoary" ;
    schema:softwareVersion "1.6.16" ;
    schema:url "https://github.com/AdmiralenOla/Scoary" .

