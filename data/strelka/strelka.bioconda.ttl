@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:strelka a schema:SoftwareApplication ;
    schema:description "Strelka calls somatic and germline small variants from mapped sequencing reads" ;
    schema:downloadUrl "https://github.com/Illumina/strelka/releases/download/v2.9.10/strelka-2.9.10.centos6_x86_64.tar.bz2" ;
    schema:identifier biotools:strelka ;
    schema:license "GPL-3.0" ;
    schema:name "strelka" ;
    schema:softwareVersion "2.9.10" ;
    schema:url "https://github.com/Illumina/strelka" .

