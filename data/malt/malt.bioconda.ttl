@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:malt a schema:SoftwareApplication ;
    schema:description "A tool for mapping metagenomic data" ;
    schema:downloadUrl "https://maira.cs.uni-tuebingen.de/download/malt/MALT_unix_0_6_2.sh" ;
    schema:identifier biotools:malt ;
    schema:license "GPLv3" ;
    schema:name "malt" ;
    schema:softwareVersion "0.62" ;
    schema:url "http://ab.inf.uni-tuebingen.de/software/malt/" .

