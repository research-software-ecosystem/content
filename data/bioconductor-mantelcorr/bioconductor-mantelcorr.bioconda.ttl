@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mantelcorr a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Compute Mantel Cluster Correlations" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MantelCorr_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MantelCorr/MantelCorr_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MantelCorr_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mantelcorr/bioconductor-mantelcorr_1.80.0_src_all.tar.gz" ;
    schema1:hasPart "r-base" ;
    schema1:identifier biotools:mantelcorr ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-mantelcorr" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MantelCorr.html" .

