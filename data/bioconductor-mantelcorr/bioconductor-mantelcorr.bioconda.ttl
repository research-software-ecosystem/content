@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mantelcorr a schema1:SoftwareApplication ;
    schema1:alternateName "Compute Mantel Cluster Correlations" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Computes Mantel cluster correlations from a (p x n) numeric data matrix (e.g. microarray gene-expression data)." ;
    schema1:identifier <https://bio.tools/biotools:mantelcorr> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-mantelcorr" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MantelCorr.html" .

