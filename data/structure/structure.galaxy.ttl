@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:structure a schema1:SoftwareApplication ;
    bioschemas:output "txt" ;
    schema1:applicationSubCategory edam:topic_3056 ;
    schema1:codeRepository <https://web.stanford.edu/group/pritchardlab/structure.html> ;
    schema1:dateCreated "2017-09-22" ;
    schema1:description "for using multi-locus genotype data to investigate population structure." ;
    schema1:encodingFormat "txt" ;
    schema1:featureList edam:operation_3197 ;
    schema1:identifier biotools:structure,
        bioconda:structure ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Phylogenetics",
        "Variant Analysis" ;
    schema1:name "structure" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/structure> .

<https://usegalaxy.be> a schema1:WebSite .

