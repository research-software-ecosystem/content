@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cafe a schema:SoftwareApplication ;
    schema:description "Computational Analysis of gene Family Evolution (CAFE)" ;
    schema:downloadUrl "https://github.com/hahnlab/CAFE5/releases/download/v5.1/CAFE5-5.1.0.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:cafe ;
    schema:license "IU OPEN SOURCE LICENSE (see https://github.com/hahnlab/CAFE5/blob/master/LICENSE)" ;
    schema:name "cafe" ;
    schema:softwareVersion "5.1.0" ;
    schema:url "https://github.com/hahnlab/CAFE5" .

