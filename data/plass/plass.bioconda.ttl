@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:plass a schema:SoftwareApplication ;
    schema:author "martin-steinegger",
        "milot-mirdita" ;
    schema:citation "doi:10.1038/s41592-019-0437-4",
        "doi:10.1101/2024.03.29.587318" ;
    schema:description "Plass (Protein-Level ASSembler) and PenguiN (Protein-guided Nucleotide assembler) are methods to assemble short read sequencing data on a protein level to proteins or DNA contigs" ;
    schema:downloadUrl "https://github.com/soedinglab/plass/archive/5-cf8933.tar.gz" ;
    schema:hasPart "bzip2",
        "gawk",
        "zlib" ;
    schema:identifier biotools:plass ;
    schema:license "GPLv3" ;
    schema:maintainer "martin-steinegger",
        "milot-mirdita" ;
    schema:name "plass" ;
    schema:softwareVersion "5.cf8933" ;
    schema:url "https://github.com/soedinglab/plass" .

