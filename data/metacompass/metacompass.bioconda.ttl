@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metacompass a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/212506" ;
    schema:description "MetaCompass: Reference-guided Assembly of Metagenomes." ;
    schema:downloadUrl "https://ftp.nandesyn.single-cell.cn/MetaCompass-1.12.tar.gz",
        "https://github.com/marbl/MetaCompass/archive/refs/tags/v1.12.tar.gz" ;
    schema:identifier biotools:MetaCompass ;
    schema:license "Artistic-License-2.0" ;
    schema:name "metacompass" ;
    schema:softwareHelp "https://github.com/marbl/MetaCompass/wiki" ;
    schema:softwareVersion "1.12" ;
    schema:url "https://github.com/marbl/MetaCompass" .

