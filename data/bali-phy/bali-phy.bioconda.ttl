@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bali-phy a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btab129" ;
    schema:description "Bayesian co-estimation of phylogenies and multiple sequence alignments." ;
    schema:downloadUrl "https://github.com/bredelings/bali-phy/archive/4.2.tar.gz" ;
    schema:hasPart "cairo",
        "cereal",
        "eigen",
        "fmt",
        "glib",
        "libboost-devel",
        "xxhash" ;
    schema:identifier biotools:bali-phy ;
    schema:license "GPL-2.0-only" ;
    schema:name "bali-phy" ;
    schema:softwareVersion "4.2" ;
    schema:url "http://www.bali-phy.org" .

