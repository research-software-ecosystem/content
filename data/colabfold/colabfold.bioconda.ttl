@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:colabfold a schema:SoftwareApplication ;
    schema:author "milot-mirdita" ;
    schema:citation "doi:10.1038/s41592-022-01488-1" ;
    schema:description "ColabFold: making protein folding accessible to all" ;
    schema:hasPart "pip",
        "poetry-core",
        "python" ;
    schema:identifier biotools:colabfold ;
    schema:license "MIT" ;
    schema:maintainer "milot-mirdita" ;
    schema:name "colabfold" ;
    schema:softwareVersion "1.5.5" ;
    schema:url "https://github.com/sokrypton/ColabFold" .

