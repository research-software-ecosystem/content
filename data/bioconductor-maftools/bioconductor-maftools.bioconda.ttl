@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-maftools a schema1:SoftwareApplication ;
    schema1:alternateName "Summarize, Analyze and Visualize MAF Files" ;
    schema1:description "Analyze and visualize Mutation Annotation Format (MAF) files from large scale sequencing studies. This package provides various functions to perform most commonly used analyses in cancer genomics and to create feature rich customizable visualzations with minimal effort." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/maftools_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/maftools/maftools_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/maftools_2.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-maftools/bioconductor-maftools_2.26.0_src_all.tar.gz" ;
    schema1:identifier "biotools:maftools",
        "usegalaxy-eu:maftools" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-maftools" ;
    schema1:softwareVersion "2.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/maftools.html" .

