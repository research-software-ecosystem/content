@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-viper a schema1:SoftwareApplication ;
    schema1:alternateName "Virtual Inference of Protein-activity by Enriched Regulon analysis" ;
    schema1:description "Inference of protein activity from gene expression data, including the VIPER and msVIPER algorithms" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/viper_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/viper/viper_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/viper_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-viper/bioconductor-viper_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:viper" ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-viper" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/viper.html" .

