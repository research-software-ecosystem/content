@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-viper a schema:SoftwareApplication ;
    schema:description "Virtual Inference of Protein-activity by Enriched Regulon analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/viper_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/viper/viper_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/viper_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-viper/bioconductor-viper_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-e1071",
        "r-kernsmooth",
        "r-mixtools" ;
    schema:identifier biotools:viper ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-viper" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/viper.html" .

