@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-iranges a schema:SoftwareApplication ;
    schema:description "Foundation of integer range manipulation in Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/IRanges_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IRanges/IRanges_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/IRanges_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-iranges/bioconductor-iranges_2.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:iranges ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-iranges" ;
    schema:softwareVersion "2.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/IRanges.html" .

