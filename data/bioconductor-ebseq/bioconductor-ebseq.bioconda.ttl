@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ebseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt087" ;
    schema:description "An R package for gene and isoform differential expression analysis of RNA-seq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EBSeq_2.8.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBSeq/EBSeq_2.8.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBSeq_2.8.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebseq/bioconductor-ebseq_2.8.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-blockmodeling",
        "r-gplots",
        "r-rcpp",
        "r-rcppeigen",
        "r-testthat",
        "zlib" ;
    schema:identifier biotools:ebseq ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-ebseq" ;
    schema:softwareVersion "2.8.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EBSeq.html" .

