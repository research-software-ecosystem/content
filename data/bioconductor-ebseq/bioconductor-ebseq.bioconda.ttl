@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ebseq a schema1:SoftwareApplication ;
    schema1:alternateName "An R package for gene and isoform differential expression analysis of RNA-seq data" ;
    schema1:citation "doi:10.1093/bioinformatics/btt087" ;
    schema1:description "Differential Expression analysis at both gene and isoform level using RNA-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/EBSeq_2.8.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBSeq/EBSeq_2.8.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBSeq_2.8.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebseq/bioconductor-ebseq_2.8.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ebseq" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ebseq" ;
    schema1:softwareVersion "2.8.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EBSeq.html" .

