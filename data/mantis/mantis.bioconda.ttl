@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mantis a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.cels.2018.05.021" ;
    schema:description "Mantis: A Fast, Small, and Exact Large-Scale Sequence-Search Index." ;
    schema:downloadUrl "https://github.com/splatlab/mantis/archive/0fb7dbb60e4a38aa21da7c85f98565786af5fe62.tar.gz" ;
    schema:hasPart "openssl",
        "sdsl-lite",
        "zlib" ;
    schema:identifier biotools:mantis_index ;
    schema:license "BSD-3-Clause" ;
    schema:name "mantis" ;
    schema:softwareVersion "0.2" ;
    schema:url "https://github.com/splatlab/mantis" .

