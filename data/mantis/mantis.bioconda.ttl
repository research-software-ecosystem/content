@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mantis a schema1:SoftwareApplication ;
    schema1:alternateName "Mantis: A Fast, Small, and Exact Large-Scale Sequence-Search Index." ;
    schema1:citation "doi:10.1016/j.cels.2018.05.021" ;
    schema1:description "Mantis: A Fast, Small, and Exact Large-Scale Sequence-Search Index." ;
    schema1:identifier <https://bio.tools/biotools:mantis_index> ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "mantis" ;
    schema1:softwareVersion "0.2" ;
    schema1:url "https://github.com/splatlab/mantis" .

