  "@id": "https://bio.tools/gcscreen",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "Open-source R package for the analysis of kinetic phenotypic screens read as growth curves in 96-well microplates. Implements a benchmarked, simulation-validated pipeline that goes from raw OD600 trajectories to a hit list: plate-level quality control (control CV, Z'-factor, SSMD), within-plate positional correction by median polish (B-score), normalisation to the median of in-plate controls, and hit calling requiring convergence between per-plate ANOVA and a library-wide linear mixed model with Benjamini-Hochberg FDR control. Also extracts kinetic parameters (maximum specific growth rate, maximum OD, lag time) and supports functional principal component analysis and Monte Carlo validation of pipeline operating characteristics.",
  "sc:name": "gcscreen",
  "sc:softwareVersion": "0.1.0",
  "sc:url": "https://github.com/mparmol/gcscreen"
}