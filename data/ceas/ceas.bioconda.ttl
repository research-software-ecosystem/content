@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ceas a schema:SoftwareApplication ;
    schema:description "CEAS: Cis-regulatory Element Annotation System" ;
    schema:downloadUrl "http://liulab.dfci.harvard.edu/CEAS/src/CEAS-Package-1.0.2.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:ceas ;
    schema:license "Artistic" ;
    schema:name "ceas" ;
    schema:softwareVersion "1.0.2" ;
    schema:url "http://liulab.dfci.harvard.edu/CEAS" .

