@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-roc a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "utilities for ROC, with microarray focus" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ROC_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ROC/ROC_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ROC_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-roc/bioconductor-roc_1.86.0_src_all.tar.gz" ;
    schema1:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-knitr",
        "zlib" ;
    schema1:identifier biotools:roc ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-roc" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ROC.html" .

