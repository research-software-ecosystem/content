@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fasttree a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/molbev/msp077" ;
    schema:description "FastTree infers approximately-maximum-likelihood phylogenetic trees from alignments of nucleotide or protein sequences." ;
    schema:downloadUrl "https://github.com/morgannprice/fasttree/archive/refs/tags/v2.2.0.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:fasttree ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "fasttree" ;
    schema:softwareHelp "https://morgannprice.github.io/fasttree" ;
    schema:softwareVersion "2.2.0" ;
    schema:url "https://morgannprice.github.io/fasttree" .

