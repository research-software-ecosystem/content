@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sistr_cmd a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0147101" ;
    schema:description "Salmonella In Silico Typing Resource (SISTR) commandline tool for serovar prediction" ;
    schema:downloadUrl "https://github.com/phac-nml/sistr_cmd/archive/refs/tags/v1.1.3.tar.gz" ;
    schema:hasPart "numpy",
        "pandas",
        "pip",
        "pycurl",
        "pytables",
        "python",
        "scipy",
        "setuptools" ;
    schema:identifier biotools:SISTR ;
    schema:license "Apache-2.0" ;
    schema:name "sistr_cmd" ;
    schema:softwareVersion "1.1.3" ;
    schema:url "https://github.com/phac-nml/sistr_cmd/" .

