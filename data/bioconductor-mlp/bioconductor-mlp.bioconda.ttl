@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mlp a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-642-24007-2_12" ;
    schema:description "Mean Log P Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MLP_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MLP/MLP_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MLP_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mlp/bioconductor-mlp_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "r-base",
        "r-gplots" ;
    schema:identifier biotools:mlp ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-mlp" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MLP.html" .

