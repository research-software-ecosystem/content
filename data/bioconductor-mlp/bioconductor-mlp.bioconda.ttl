@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mlp a schema1:SoftwareApplication ;
    schema1:alternateName "Mean Log P Analysis" ;
    schema1:citation "doi:10.1007/978-3-642-24007-2_12" ;
    schema1:description "Pathway analysis based on p-values associated to genes from a genes expression analysis of interest. Utility functions enable to extract pathways from the Gene Ontology Biological Process (GOBP), Molecular Function (GOMF) and Cellular Component (GOCC), Kyoto Encyclopedia of Genes of Genomes (KEGG) and Reactome databases. Methodology, and helper functions to display the results as a table, barplot of pathway significance, Gene Ontology graph and pathway significance are available." ;
    schema1:identifier <https://bio.tools/biotools:mlp> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-mlp" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MLP.html" .

