@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:meningotype a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:applicationSubCategory edam:topic_0625,
        edam:topic_3301 ;
    schema1:codeRepository "https://github.com/MDU-PHL/meningotype" ;
    schema1:dateCreated "2023-06-06" ;
    schema1:description "Assign sequence type to N. meningitidis genome assemblies" ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_3196,
        edam:operation_3840 ;
    schema1:identifier biotools:meningotype,
        bioconda:meningotype ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "meningotype" ;
    schema1:softwareVersion "@TOOL_VERSION@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/meningotype" .

