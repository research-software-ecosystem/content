@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-metacca a schema:SoftwareApplication ;
    schema:description "Summary Statistics-Based Multivariate Meta-Analysis of Genome-Wide Association Studies Using Canonical Correlation Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/metaCCA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/metaCCA/metaCCA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/metaCCA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metacca/bioconductor-metacca_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:metacca ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-metacca" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/metaCCA.html" .

