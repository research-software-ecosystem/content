@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chipseqr a schema:SoftwareApplication ;
    schema:description "Identifying Protein Binding Sites in High-Throughput Sequencing Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ChIPseqR_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPseqR/ChIPseqR_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPseqR_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipseqr/bioconductor-chipseqr_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-hilbertvis",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-shortread",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-fbasics",
        "r-timsac",
        "zlib" ;
    schema:identifier biotools:chipseqr ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-chipseqr" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPseqR.html" .

