@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:genesplicer a schema:SoftwareApplication ;
    schema:description "GeneSplicer : A computational method for splice site prediction." ;
    schema:downloadUrl "ftp://ftp.ccb.jhu.edu/pub/software/genesplicer/GeneSplicer.tar.gz",
        "http://www.cs.jhu.edu/~genomics/GeneSplicer/GeneSplicer.tar.gz",
        "https://depot.galaxyproject.org/software/genesplicer/genesplicer_0_2003.04.03_src_all.tar.gz" ;
    schema:identifier biotools:genesplicer ;
    schema:license "OSI" ;
    schema:name "genesplicer" ;
    schema:softwareHelp "https://ccb.jhu.edu/software/genesplicer" ;
    schema:softwareVersion "0_2003.04.03" ;
    schema:url "https://ccb.jhu.edu/software/genesplicer" .

