@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:genesplicer a schema1:SoftwareApplication ;
    schema1:alternateName "GeneSplicer : A computational method for splice site prediction." ;
    schema1:description "GeneSplicer : A computational method for splice site prediction." ;
    schema1:downloadUrl "ftp://ftp.ccb.jhu.edu/pub/software/genesplicer/GeneSplicer.tar.gz",
        "http://www.cs.jhu.edu/~genomics/GeneSplicer/GeneSplicer.tar.gz",
        "https://depot.galaxyproject.org/software/genesplicer/genesplicer_0_2003.04.03_src_all.tar.gz" ;
    schema1:identifier "biotools:genesplicer" ;
    schema1:license "OSI" ;
    schema1:name "genesplicer" ;
    schema1:softwareVersion "0_2003.04.03" ;
    schema1:url "https://ccb.jhu.edu/software/genesplicer" .

