@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-masigpro a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu333" ;
    schema:description "Significant Gene Expression Profile Differences in Time Course Gene Expression Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/maSigPro_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/maSigPro/maSigPro_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/maSigPro_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-masigpro/bioconductor-masigpro_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-mass",
        "r-mclust",
        "r-venn" ;
    schema:identifier biotools:masigpro ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-masigpro" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/maSigPro.html" .

