@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-masigpro a schema1:SoftwareApplication ;
    schema1:alternateName "Significant Gene Expression Profile Differences in Time Course Gene Expression Data" ;
    schema1:citation "doi:10.1093/bioinformatics/btu333" ;
    schema1:description "maSigPro is a regression based approach to find genes for which there are significant gene expression profile differences between experimental groups in time course microarray and RNA-Seq experiments." ;
    schema1:identifier biotools:masigpro ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-masigpro" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/maSigPro.html" .

