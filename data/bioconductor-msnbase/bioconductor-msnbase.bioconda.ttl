@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-msnbase a schema1:SoftwareApplication ;
    schema1:alternateName "Base Functions and Classes for Mass Spectrometry and Proteomics" ;
    schema1:description "MSnbase provides infrastructure for manipulation, processing and visualisation of mass spectrometry and proteomics data, ranging from raw to quantitative and annotated data." ;
    schema1:identifier biotools:msnbase ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-msnbase" ;
    schema1:softwareVersion "2.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MSnbase.html" .

