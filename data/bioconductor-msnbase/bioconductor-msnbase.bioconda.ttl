@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-msnbase a schema1:SoftwareApplication ;
    schema1:description "Base Functions and Classes for Mass Spectrometry and Proteomics" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MSnbase_2.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MSnbase/MSnbase_2.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MSnbase_2.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-msnbase/bioconductor-msnbase_2.36.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-impute",
        "bioconductor-iranges",
        "bioconductor-mscoreutils",
        "bioconductor-mzid",
        "bioconductor-mzr",
        "bioconductor-pcamethods",
        "bioconductor-protgenerics",
        "bioconductor-psmatch",
        "bioconductor-s4vectors",
        "bioconductor-vsn",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-digest",
        "r-ggplot2",
        "r-lattice",
        "r-maldiquant",
        "r-mass",
        "r-plyr",
        "r-rcpp",
        "r-scales",
        "zlib" ;
    schema1:identifier biotools:msnbase ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-msnbase" ;
    schema1:softwareVersion "2.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MSnbase.html" .

