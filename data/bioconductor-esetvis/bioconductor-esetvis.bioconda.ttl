@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-esetvis a schema1:SoftwareApplication ;
    schema1:alternateName "Visualizations of expressionSet Bioconductor object" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Utility functions for visualization of expressionSet (or SummarizedExperiment) Bioconductor object, including spectral map, tsne and linear discriminant analysis. Static plot via the ggplot2 package or interactive via the ggvis or rbokeh packages are available." ;
    schema1:identifier <https://bio.tools/biotools:esetvis> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-esetvis" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/esetVis.html" .

