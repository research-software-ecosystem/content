@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-esetvis a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Visualizations of expressionSet Bioconductor object" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/esetVis_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/esetVis/esetVis_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/esetVis_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-esetvis/bioconductor-esetvis_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-mlp",
        "r-base",
        "r-hexbin",
        "r-mass",
        "r-mpm",
        "r-rtsne" ;
    schema1:identifier biotools:esetvis ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-esetvis" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/esetVis.html" .

