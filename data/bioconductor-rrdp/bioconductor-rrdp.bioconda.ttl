@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rrdp a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Interface to the RDP Classifier" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rRDP_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rRDP/rRDP_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rRDP_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rrdp/bioconductor-rrdp_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "r-base",
        "r-rjava" ;
    schema:identifier biotools:rrdp ;
    schema:license "GPL-2 + file LICENSE" ;
    schema:name "bioconductor-rrdp" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rRDP.html" .

