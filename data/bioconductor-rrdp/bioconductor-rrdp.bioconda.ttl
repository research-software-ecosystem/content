@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rrdp a schema1:SoftwareApplication ;
    schema1:alternateName "Interface to the RDP Classifier" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package installs and interfaces the naive Bayesian classifier for 16S rRNA sequences developed by the Ribosomal Database Project (RDP). With this package the classifier trained with the standard training set can be used or a custom classifier can be trained." ;
    schema1:identifier <https://bio.tools/biotools:rrdp> ;
    schema1:license "GPL-2 + file LICENSE" ;
    schema1:name "bioconductor-rrdp" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rRDP.html" .

