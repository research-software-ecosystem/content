@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-splinter a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Splice Interpreter of Transcripts" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SPLINTER_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SPLINTER/SPLINTER_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SPLINTER_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-splinter/bioconductor-splinter_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-bsgenome.mmusculus.ucsc.mm9",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "bioconductor-pwalign",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-seqlogo",
        "r-base",
        "r-ggplot2",
        "r-googlevis",
        "r-plyr",
        "r-stringr" ;
    schema1:identifier biotools:splinter ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-splinter" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SPLINTER.html" .

