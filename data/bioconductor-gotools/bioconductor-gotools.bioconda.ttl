@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gotools a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for Gene Ontology database" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/goTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/goTools/goTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/goTools_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gotools/bioconductor-gotools_1.84.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-go.db",
        "r-base" ;
    schema1:identifier biotools:gotools ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-gotools" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/goTools.html" .

