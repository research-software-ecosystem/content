@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gotools a schema1:SoftwareApplication ;
    schema1:alternateName "Functions for Gene Ontology database" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Wraper functions for description/comparison of oligo ID list using Gene Ontology database" ;
    schema1:identifier <https://bio.tools/biotools:gotools> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-gotools" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/goTools.html" .

