@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gotools a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Functions for Gene Ontology database" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/goTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/goTools/goTools_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/goTools_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gotools/bioconductor-gotools_1.84.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-go.db",
        "r-base" ;
    schema:identifier biotools:gotools ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-gotools" ;
    schema:softwareVersion "1.84.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/goTools.html" .

