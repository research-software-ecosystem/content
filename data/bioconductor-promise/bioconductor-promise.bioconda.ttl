@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-promise a schema1:SoftwareApplication ;
    schema1:alternateName "PRojection Onto the Most Interesting Statistical Evidence" ;
    schema1:citation "doi:10.1093/bioinformatics/btp357" ;
    schema1:description "A general tool to identify genomic features with a specific biologically interesting pattern of associations with multiple endpoint variables as described in Pounds et. al. (2009) Bioinformatics 25: 2013-2019" ;
    schema1:identifier <https://bio.tools/biotools:promise> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-promise" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PROMISE.html" .

