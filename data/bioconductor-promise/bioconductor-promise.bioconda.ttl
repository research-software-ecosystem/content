@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-promise a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp357" ;
    schema:description "PRojection Onto the Most Interesting Statistical Evidence" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PROMISE_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PROMISE/PROMISE_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PROMISE_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-promise/bioconductor-promise_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-gseabase",
        "r-base" ;
    schema:identifier biotools:promise ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-promise" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PROMISE.html" .

