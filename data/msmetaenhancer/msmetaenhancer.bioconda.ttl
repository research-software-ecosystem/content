@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:msmetaenhancer a schema:SoftwareApplication ;
    schema:author "hechth",
        "martenson",
        "xtrojak" ;
    schema:citation "doi:10.21105/joss.04494" ;
    schema:description "MSMetaEnhancer is a Python tool that adds more annotations (e.g. SMILES, InChI, CAS number) to MSP files." ;
    schema:downloadUrl "https://pypi.io/packages/source/m/msmetaenhancer/msmetaenhancer-0.5.1.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "python" ;
    schema:identifier biotools:msmetaenhancer ;
    schema:license "MIT" ;
    schema:maintainer "hechth",
        "martenson",
        "xtrojak" ;
    schema:name "msmetaenhancer" ;
    schema:softwareHelp "https://msmetaenhancer.readthedocs.io" ;
    schema:softwareVersion "0.5.1" ;
    schema:url "https://github.com/RECETOX/MSMetaEnhancer" .

