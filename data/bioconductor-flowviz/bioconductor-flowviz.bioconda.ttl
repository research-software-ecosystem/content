@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowviz a schema1:SoftwareApplication ;
    schema1:alternateName "Visualization for flow cytometry" ;
    schema1:citation "doi:10.1093/bioinformatics/btn021" ;
    schema1:description "Provides visualization tools for flow cytometry data." ;
    schema1:identifier biotools:flowviz ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-flowviz" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowViz.html" .

