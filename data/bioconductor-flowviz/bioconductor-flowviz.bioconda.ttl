@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowviz a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn021" ;
    schema:description "Visualization for flow cytometry" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowViz_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowViz/flowViz_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowViz_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowviz/bioconductor-flowviz_1.74.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-flowcore",
        "r-base",
        "r-hexbin",
        "r-idpmisc",
        "r-kernsmooth",
        "r-lattice",
        "r-latticeextra",
        "r-mass",
        "r-rcolorbrewer" ;
    schema:identifier biotools:flowviz ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-flowviz" ;
    schema:softwareVersion "1.74.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowViz.html" .

