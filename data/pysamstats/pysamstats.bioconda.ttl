@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pysamstats a schema:SoftwareApplication ;
    schema:description "Calculate read mapping stats from SAM/BAM/CRAM" ;
    schema:downloadUrl "https://github.com/alimanfoo/pysamstats/archive/v1.1.2.tar.gz" ;
    schema:hasPart "cython",
        "pysam",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:pysamstats ;
    schema:license "MIT" ;
    schema:name "pysamstats" ;
    schema:softwareVersion "1.1.2" ;
    schema:url "https://github.com/alimanfoo/pysamstats" .

