@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:revtrans a schema:SoftwareApplication ;
    schema:description "revtrans - performs a reverse translation of a peptide alignment." ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:revtrans ;
    schema:license "GPLv2" ;
    schema:name "revtrans" ;
    schema:softwareVersion "1.4" ;
    schema:url "http://www.cbs.dtu.dk/services/RevTrans-2.0/web/download.php" .

