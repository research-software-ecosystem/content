@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:splitcode a schema:SoftwareApplication ;
    schema:author "Yenaled" ;
    schema:citation "doi:10.1101/2023.03.20.533521" ;
    schema:description "Flexible parsing, interpretation, and editing of technical sequences." ;
    schema:downloadUrl "https://github.com/pachterlab/splitcode/archive/refs/tags/v0.31.6.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:splitcode ;
    schema:license "BSD-2-Clause" ;
    schema:maintainer "Yenaled" ;
    schema:name "splitcode" ;
    schema:softwareHelp "https://splitcode.readthedocs.io" ;
    schema:softwareVersion "0.31.6" ;
    schema:url "https://github.com/pachterlab/splitcode" .

