@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:entrez-direct a schema:SoftwareApplication ;
    schema:description "Entrez Direct (EDirect) - Access to NCBI's Entrez databases" ;
    schema:downloadUrl "https://ftp.ncbi.nlm.nih.gov/entrez/entrezdirect/versions/25.3.20260410/edirect.tar.gz" ;
    schema:identifier biotools:entrez ;
    schema:license "Public Domain" ;
    schema:name "entrez-direct" ;
    schema:softwareHelp "https://ftp.ncbi.nlm.nih.gov/entrez/entrezdirect/versions/25.3.20260410/README" ;
    schema:softwareVersion "25.3" ;
    schema:url "https://ftp.ncbi.nlm.nih.gov/entrez/entrezdirect/versions/25.3.20260410/README" .

