@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-probamr a schema1:SoftwareApplication ;
    schema1:alternateName "Generating SAM file for PSMs in shotgun proteomics data" ;
    schema1:citation "doi:10.1074/mcp.M115.052860" ;
    schema1:description "Mapping PSMs back to genome. The package builds SAM file from shotgun proteomics data The package also provides function to prepare annotation from GTF file." ;
    schema1:identifier <https://bio.tools/biotools:probamr> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-probamr" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/proBAMr.html" .

