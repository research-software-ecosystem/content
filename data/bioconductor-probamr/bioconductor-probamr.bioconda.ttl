@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-probamr a schema:SoftwareApplication ;
    schema:citation "doi:10.1074/mcp.M115.052860" ;
    schema:description "Generating SAM file for PSMs in shotgun proteomics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/proBAMr_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/proBAMr/proBAMr_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/proBAMr_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-probamr/bioconductor-probamr_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biostrings",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-txdbmaker",
        "r-base" ;
    schema:identifier biotools:probamr ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-probamr" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/proBAMr.html" .

