@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kled a schema:SoftwareApplication ;
    schema:author "CoREse" ;
    schema:citation "doi:10.1093/bib/bbae049",
        "doi:10.3389/fgene.2024.1435087" ;
    schema:description "An ultra-fast and sensitive structural variant detection tool for long-read sequencing data." ;
    schema:downloadUrl "https://github.com/CoREse/kled/releases/download/v1.2.11/kledv1.2.11.allmodules.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "gmp",
        "libcurl",
        "libdeflate",
        "libgomp",
        "liblzma-devel",
        "llvm-openmp",
        "openmpi",
        "openssl",
        "zlib" ;
    schema:identifier biotools:kled ;
    schema:license "MIT" ;
    schema:maintainer "CoREse" ;
    schema:name "kled" ;
    schema:softwareHelp "https://github.com/CoREse/kled/blob/v1.2.11/README.md" ;
    schema:softwareVersion "1.2.11" ;
    schema:url "https://github.com/CoREse/kled" .

