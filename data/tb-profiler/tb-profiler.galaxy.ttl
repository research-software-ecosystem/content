@prefix schema1: <http://schema.org/> .

galaxytool:tb-profiler a schema1:SoftwareApplication ;
    bioschemas:output "bam",
        "csv",
        "json",
        "pdf",
        "tabular",
        "txt",
        "vcf" ;
    schema1:codeRepository <https://github.com/jodyphelan/TBProfiler> ;
    schema1:dateCreated "2019-04-02" ;
    schema1:description "Processes M. tuberculosis sequence data to infer strain type and identify known drug resistance markers." ;
    schema1:encodingFormat "bam",
        "csv",
        "json",
        "pdf",
        "tabular",
        "txt",
        "vcf" ;
    schema1:featureList edam:operation_3482 ;
