@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-drugvsdisease a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Comparison of disease and drug profiles using Gene set Enrichment Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DrugVsDisease_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DrugVsDisease/DrugVsDisease_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DrugVsDisease_2.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-drugvsdisease/bioconductor-drugvsdisease_2.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-annotate",
        "bioconductor-arrayexpress",
        "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-cmap2data",
        "bioconductor-drugvsdiseasedata",
        "bioconductor-geoquery",
        "bioconductor-hgu133a.db",
        "bioconductor-hgu133a2.db",
        "bioconductor-hgu133plus2.db",
        "bioconductor-limma",
        "bioconductor-qvalue",
        "r-base",
        "r-runit",
        "r-xtable" ;
    schema:identifier biotools:drugvsdisease ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-drugvsdisease" ;
    schema:softwareVersion "2.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DrugVsDisease.html" .

