@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-harman a schema:SoftwareApplication ;
    schema:description "The removal of batch effects from datasets using a PCA and constrained optimisation based technique" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Harman_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Harman/Harman_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Harman_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-harman/bioconductor-harman_1.38.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ckmeans.1d.dp",
        "r-matrixstats",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:harman ;
    schema:license "GPL-3 + file LICENCE" ;
    schema:name "bioconductor-harman" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Harman.html" .

