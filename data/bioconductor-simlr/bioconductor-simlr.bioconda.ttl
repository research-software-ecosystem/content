@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-simlr a schema1:SoftwareApplication ;
    schema1:alternateName "Single-cell Interpretation via Multi-kernel LeaRning (SIMLR)" ;
    schema1:citation "doi:10.1101/118901" ;
    schema1:description "Single-cell RNA-seq technologies enable high throughput gene expression measurement of individual cells, and allow the discovery of heterogeneity within cell populations. Measurement of cell-to-cell gene expression similarity is critical for the identification, visualization and analysis of cell populations. However, single-cell data introduce challenges to conventional measures of gene expression similarity because of the high level of noise, outliers and dropouts. We develop a novel similarity-learning framework, SIMLR (Single-cell Interpretation via Multi-kernel LeaRning), which learns an appropriate distance metric from the data for dimension reduction, clustering and visualization." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SIMLR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SIMLR/SIMLR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SIMLR_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-simlr/bioconductor-simlr_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:simlr" ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-simlr" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SIMLR.html" .

