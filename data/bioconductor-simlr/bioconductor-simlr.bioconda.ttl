@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-simlr a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/118901" ;
    schema:description "Single-cell Interpretation via Multi-kernel LeaRning (SIMLR)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SIMLR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SIMLR/SIMLR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SIMLR_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-simlr/bioconductor-simlr_1.36.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-pracma",
        "r-rcpp",
        "r-rcppannoy",
        "r-rspectra",
        "zlib" ;
    schema:identifier biotools:simlr ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-simlr" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SIMLR.html" .

