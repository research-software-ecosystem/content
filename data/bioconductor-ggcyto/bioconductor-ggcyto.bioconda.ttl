@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ggcyto a schema1:SoftwareApplication ;
    schema1:alternateName "Visualize Cytometry data with ggplot" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "With the dedicated fortify method implemented for flowSet, ncdfFlowSet and GatingSet classes, both raw and gated flow cytometry data can be plotted directly with ggplot. ggcyto wrapper and some customed layers also make it easy to add gates and population statistics to the plot." ;
    schema1:identifier biotools:ggcyto ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-ggcyto" ;
    schema1:softwareVersion "1.38.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ggcyto.html" .

