@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ggcyto a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Visualize Cytometry data with ggplot" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ggcyto_1.38.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ggcyto/ggcyto_1.38.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ggcyto_1.38.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ggcyto/bioconductor-ggcyto_1.38.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-flowcore",
        "bioconductor-flowworkspace",
        "bioconductor-ncdfflow",
        "r-base",
        "r-data.table",
        "r-ggplot2",
        "r-gridextra",
        "r-hexbin",
        "r-plyr",
        "r-rcolorbrewer",
        "r-rlang",
        "r-scales" ;
    schema:identifier biotools:ggcyto ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-ggcyto" ;
    schema:softwareVersion "1.38.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ggcyto.html" .

