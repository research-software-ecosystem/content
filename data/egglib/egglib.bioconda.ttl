@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:egglib a schema:SoftwareApplication ;
    schema:author "ranwez" ;
    schema:citation "doi:10.1111/1755-0998.13672" ;
    schema:description "Evolutionary Genetics and Genomics Library" ;
    schema:downloadUrl "https://pypi.org/packages/source/e/egglib/egglib-3.6.1.tar.gz" ;
    schema:hasPart "htslib",
        "numpydoc",
        "pip",
        "python",
        "setuptools-scm",
        "sphinx",
        "svgwrite",
        "swig" ;
    schema:identifier biotools:egglib ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "ranwez" ;
    schema:name "egglib" ;
    schema:softwareHelp "https://www.egglib.org/index.html" ;
    schema:softwareVersion "3.6.1" ;
    schema:url "https://egglib.org" .

