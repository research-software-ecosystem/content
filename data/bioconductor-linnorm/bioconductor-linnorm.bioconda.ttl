@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-linnorm a schema:SoftwareApplication ;
    schema:description "Linear model and normality based normalization and transformation method (Linnorm)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Linnorm_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Linnorm/Linnorm_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Linnorm_2.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-linnorm/bioconductor-linnorm_2.34.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-amap",
        "r-apcluster",
        "r-base",
        "r-ellipse",
        "r-fastcluster",
        "r-fpc",
        "r-ggdendro",
        "r-ggplot2",
        "r-gmodels",
        "r-igraph",
        "r-mass",
        "r-mclust",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-rtsne",
        "r-statmod",
        "r-vegan",
        "r-zoo",
        "zlib" ;
    schema:identifier biotools:linnorm ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-linnorm" ;
    schema:softwareVersion "2.34.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Linnorm.html" .

