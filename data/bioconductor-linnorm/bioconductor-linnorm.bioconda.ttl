@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-linnorm a schema1:SoftwareApplication ;
    schema1:alternateName "Linear model and normality based normalization and transformation method (Linnorm)" ;
    schema1:description "Linnorm is an algorithm for normalizing and transforming RNA-seq, single cell RNA-seq, ChIP-seq count data or any large scale count data. It has been independently reviewed by Tian et al. on Nature Methods (https://doi.org/10.1038/s41592-019-0425-8). Linnorm can work with raw count, CPM, RPKM, FPKM and TPM." ;
    schema1:identifier biotools:linnorm ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-linnorm" ;
    schema1:softwareVersion "2.34.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Linnorm.html" .

