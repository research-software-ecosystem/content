@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-slqpcr a schema1:SoftwareApplication ;
    schema1:alternateName "Functions for analysis of real-time quantitative PCR data at SIRS-Lab GmbH" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for analysis of real-time quantitative PCR data at SIRS-Lab GmbH" ;
    schema1:identifier <https://bio.tools/biotools:slqpcr> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-slqpcr" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SLqPCR.html" .

