@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-slqpcr a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Functions for analysis of real-time quantitative PCR data at SIRS-Lab GmbH" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SLqPCR_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SLqPCR/SLqPCR_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SLqPCR_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-slqpcr/bioconductor-slqpcr_1.76.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:slqpcr ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-slqpcr" ;
    schema:softwareVersion "1.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SLqPCR.html" .

