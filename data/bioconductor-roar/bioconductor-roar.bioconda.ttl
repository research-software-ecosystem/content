@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-roar a schema1:SoftwareApplication ;
    schema1:alternateName "Identify differential APA usage from RNA-seq alignments" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Identify preferential usage of APA sites, comparing two biological conditions, starting from known alternative sites and alignments obtained from standard RNA-seq experiments." ;
    schema1:identifier biotools:roar ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-roar" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/roar.html" .

