@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-roar a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Identify differential APA usage from RNA-seq alignments" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/roar_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/roar/roar_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/roar_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-roar/bioconductor-roar_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base" ;
    schema1:identifier biotools:roar ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-roar" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/roar.html" .

