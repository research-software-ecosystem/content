@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sibeliaz a schema:SoftwareApplication ;
    schema:description "A fast whole-genome aligner based on de Bruijn graphs." ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:sibeliaz ;
    schema:license "Custom OSS" ;
    schema:name "sibeliaz" ;
    schema:softwareHelp "https://github.com/medvedevgroup/SibeliaZ/blob/v1.2.7/README.md" ;
    schema:softwareVersion "1.2.7" ;
    schema:url "https://github.com/medvedevgroup/SibeliaZ" .

