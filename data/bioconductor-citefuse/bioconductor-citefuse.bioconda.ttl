@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-citefuse a schema1:SoftwareApplication ;
    schema1:alternateName "CiteFuse: multi-modal analysis of CITE-seq data" ;
    schema1:description "CiteFuse pacakage implements a suite of methods and tools for CITE-seq data from pre-processing to integrative analytics, including doublet detection, network-based modality integration, cell type clustering, differential RNA and protein expression analysis, ADT evaluation, ligand-receptor interaction analysis, and interactive web-based visualisation of the analyses." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CiteFuse_1.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CiteFuse/CiteFuse_1.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CiteFuse_1.22.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-citefuse/bioconductor-citefuse_1.22.0_src_all.tar.gz" ;
    schema1:identifier "biotools:citefuse" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-citefuse" ;
    schema1:softwareVersion "1.22.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CiteFuse.html" .

