@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cfassay a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13014-015-0529-y" ;
    schema:description "Statistical analysis for the Colony Formation Assay" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CFAssay_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CFAssay/CFAssay_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CFAssay_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cfassay/bioconductor-cfassay_1.44.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:cfassay ;
    schema:license "LGPL" ;
    schema:name "bioconductor-cfassay" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CFAssay.html" .

