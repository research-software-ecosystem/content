@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cfassay a schema1:SoftwareApplication ;
    schema1:alternateName "Statistical analysis for the Colony Formation Assay" ;
    schema1:citation "doi:10.1186/s13014-015-0529-y" ;
    schema1:description "The package provides functions for calculation of linear-quadratic cell survival curves and for ANOVA of experimental 2-way designs along with the colony formation assay." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CFAssay_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CFAssay/CFAssay_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CFAssay_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cfassay/bioconductor-cfassay_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cfassay" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-cfassay" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CFAssay.html" .

