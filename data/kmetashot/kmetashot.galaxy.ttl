@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:kmetashot a schema1:SoftwareApplication ;
    bioschemas:output "csv" ;
    schema1:applicationSubCategory edam:topic_3174 ;
    schema1:codeRepository <https://github.com/gdefazio/kMetaShot> ;
    schema1:dateCreated "2025-12-18" ;
    schema1:description "an alignment-free taxonomic classifier based on k-mer/minimizer counting" ;
    schema1:encodingFormat "csv" ;
    schema1:identifier biotools:kmetashot,
        bioconda:kmetashot ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.org> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "kmetashot" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/kmetashot> .

<https://usegalaxy.cz> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org> a schema1:WebSite .

