@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sizepower a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Sample Size and Power Calculation in Micorarray Studies" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sizepower_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sizepower/sizepower_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sizepower_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sizepower/bioconductor-sizepower_1.80.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:sizepower ;
    schema:license "LGPL" ;
    schema:name "bioconductor-sizepower" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sizepower.html" .

