@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-tweedeseq a schema:SoftwareApplication ;
    schema:description "RNA-seq data analysis using the Poisson-Tweedie family of distributions" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/tweeDEseq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/tweeDEseq/tweeDEseq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/tweeDEseq_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tweedeseq/bioconductor-tweedeseq_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-cqn",
        "bioconductor-edger",
        "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mass",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:tweedeseq ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-tweedeseq" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/tweeDEseq.html" .

