@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:spapros a schema1:SoftwareApplication ;
    bioschemas:output "pdf",
        "png",
        "svg",
        "tabular" ;
    schema1:codeRepository "https://github.com/theislab/spapros" ;
    schema1:dateCreated "2024-08-25" ;
    schema1:description "Select and evaluate probe sets for targeted spatial transcriptomics." ;
    schema1:encodingFormat "pdf",
        "png",
        "svg",
        "tabular" ;
    schema1:featureList edam:operation_0337,
        edam:operation_2419 ;
    schema1:identifier biotools:spapros,
        bioconda:spapros ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=9adf0402b641042c> ;
    schema1:keywords "Sequence Analysis",
        "Single Cell",
        "Transcriptomics" ;
    schema1:name "spapros" ;
    schema1:softwareVersion "0.1.5" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/spapros" .

<https://usegalaxy.eu> a schema1:WebSite .

