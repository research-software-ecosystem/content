@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:spapros a schema:SoftwareApplication ;
    schema:author "heylf" ;
    schema:citation "doi:10.1038/s41592-024-02496-z" ;
    schema:description "Probe set selection for targeted spatial transcriptomics." ;
    schema:downloadUrl "https://pypi.org/packages/source/s/spapros/spapros-0.1.6.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "python" ;
    schema:identifier biotools:spapros ;
    schema:license "MIT" ;
    schema:maintainer "heylf" ;
    schema:name "spapros" ;
    schema:softwareHelp "https://spapros.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.1.6" ;
    schema:url "https://github.com/theislab/spapros" .

