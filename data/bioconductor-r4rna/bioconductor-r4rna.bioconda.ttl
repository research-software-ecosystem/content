@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-r4rna a schema:SoftwareApplication ;
    schema:description "An R package for RNA visualization and analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/R4RNA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/R4RNA/R4RNA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/R4RNA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-r4rna/bioconductor-r4rna_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "r-base" ;
    schema:identifier biotools:r4rna ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-r4rna" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/R4RNA.html" .

