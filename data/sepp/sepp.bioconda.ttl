@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sepp a schema:SoftwareApplication ;
    schema:description "SATe-enabled phylogenetic placement." ;
    schema:downloadUrl "https://github.com/smirarab/sepp/archive/v4.5.6.tar.gz" ;
    schema:hasPart "dendropy",
        "hatchling",
        "hmmer",
        "openjdk",
        "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:sepp ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "sepp" ;
    schema:softwareHelp "https://github.com/smirarab/sepp/blob/v4.5.6/README.md" ;
    schema:softwareVersion "4.5.6" ;
    schema:url "https://github.com/smirarab/sepp" .

