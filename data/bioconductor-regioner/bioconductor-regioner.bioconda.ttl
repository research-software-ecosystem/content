@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-regioner a schema:SoftwareApplication ;
    schema:description "Association analysis of genomic regions based on permutation tests" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/regioneR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/regioneR/regioneR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/regioneR_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-regioner/bioconductor-regioner_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-memoise" ;
    schema:identifier biotools:regioner ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-regioner" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/regioneR.html" .

