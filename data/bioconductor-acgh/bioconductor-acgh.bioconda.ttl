@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-acgh a schema1:SoftwareApplication ;
    schema1:alternateName "Classes and functions for Array Comparative Genomic Hybridization data" ;
    schema1:citation "doi:10.1093/bioinformatics/bti677" ;
    schema1:description "Functions for reading aCGH data from image analysis output files and clone information files, creation of aCGH S3 objects for storing these data. Basic methods for accessing/replacing, subsetting, printing and plotting aCGH objects." ;
    schema1:identifier biotools:acgh ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-acgh" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/aCGH.html" .

