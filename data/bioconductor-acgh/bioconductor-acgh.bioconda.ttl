@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-acgh a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bti677" ;
    schema:description "Classes and functions for Array Comparative Genomic Hybridization data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/aCGH_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/aCGH/aCGH_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/aCGH_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-acgh/bioconductor-acgh_1.88.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-multtest",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-survival",
        "zlib" ;
    schema:identifier biotools:acgh ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-acgh" ;
    schema:softwareVersion "1.88.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/aCGH.html" .

