@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-descan2 a schema1:SoftwareApplication ;
    schema1:alternateName "Differential Enrichment Scan 2" ;
    schema1:description "Integrated peak and differential caller, specifically designed for broad epigenomic signals." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DEScan2_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEScan2/DEScan2_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DEScan2_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-descan2/bioconductor-descan2_1.30.0_src_all.tar.gz" ;
    schema1:identifier "biotools:descan2" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-descan2" ;
    schema1:softwareVersion "1.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DEScan2.html" .

