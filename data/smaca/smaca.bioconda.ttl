@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:smaca a schema:SoftwareApplication ;
    schema:author "erdanieee",
        "loucerac" ;
    schema:citation "doi:10.1002/humu.24120",
        "doi:10.5281/zenodo.3731299" ;
    schema:description "smaca is a python tool to detect putative SMA carriers and estimate the absolute SMN1 copy-number in a population." ;
    schema:downloadUrl "https://pypi.org/packages/source/s/smaca/smaca-1.2.4rc11.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "pysam",
        "python",
        "setuptools",
        "setuptools-scm" ;
    schema:identifier biotools:smaca ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "erdanieee",
        "loucerac" ;
    schema:name "smaca" ;
    schema:softwareVersion "1.2.4rc11" ;
    schema:url "https://github.com/babelomics/SMAca" .

