                    }
                ],
                "citationCount": 36,
                "date": "2015-02-01T00:00:00Z",
                "journal": "BMC bioinformatics",
                "title": "MeSH ORA framework: R/Bioconductor packages to support MeSH over-representation analysis."
            },
