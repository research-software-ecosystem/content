@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-proloc a schema1:SoftwareApplication ;
    schema1:alternateName "A unifying bioinformatics framework for spatial proteomics" ;
    schema1:description "The pRoloc package implements machine learning and visualisation methods for the analysis and interogation of quantitiative mass spectrometry data to reliably infer protein sub-cellular localisation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pRoloc_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pRoloc/pRoloc_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pRoloc_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-proloc/bioconductor-proloc_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:proloc" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-proloc" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pRoloc.html" .

