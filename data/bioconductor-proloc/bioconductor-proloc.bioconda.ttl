@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-proloc a schema:SoftwareApplication ;
    schema:description "A unifying bioinformatics framework for spatial proteomics" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pRoloc_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pRoloc/pRoloc_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pRoloc_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-proloc/bioconductor-proloc_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biomart",
        "bioconductor-mlinterfaces",
        "bioconductor-msnbase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-caret",
        "r-class",
        "r-coda",
        "r-colorspace",
        "r-dendextend",
        "r-e1071",
        "r-fnn",
        "r-ggplot2",
        "r-gtools",
        "r-hexbin",
        "r-kernlab",
        "r-knitr",
        "r-laplacesdemon",
        "r-lattice",
        "r-mass",
        "r-mclust",
        "r-mixtools",
        "r-mvtnorm",
        "r-nnet",
        "r-plyr",
        "r-proxy",
        "r-randomforest",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-sampling",
        "r-scales",
        "zlib" ;
    schema:identifier biotools:proloc ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-proloc" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pRoloc.html" .

