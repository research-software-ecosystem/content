@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genefilter a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "genefilter: methods for filtering genes from high-throughput experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/genefilter_1.92.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genefilter/genefilter_1.92.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/genefilter_1.92.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genefilter/bioconductor-genefilter_1.92.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-matrixgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-survival",
        "zlib" ;
    schema:identifier biotools:genefilter ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genefilter" ;
    schema:softwareVersion "1.92.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/genefilter.html" .

