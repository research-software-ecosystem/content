@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genefilter a schema1:SoftwareApplication ;
    schema1:alternateName "genefilter: methods for filtering genes from high-throughput experiments" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Some basic functions for filtering genes." ;
    schema1:identifier <https://bio.tools/biotools:genefilter> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genefilter" ;
    schema1:softwareVersion "1.92.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/genefilter.html" .

