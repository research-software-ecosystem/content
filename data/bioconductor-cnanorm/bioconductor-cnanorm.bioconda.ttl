@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cnanorm a schema1:SoftwareApplication ;
    schema1:description "A normalization method for Copy Number Aberration in cancer samples" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CNAnorm_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CNAnorm/CNAnorm_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CNAnorm_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cnanorm/bioconductor-cnanorm_1.56.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-dnacopy",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:cnanorm ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-cnanorm" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CNAnorm.html" .

