@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cnanorm a schema:SoftwareApplication ;
    schema:description "A normalization method for Copy Number Aberration in cancer samples" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CNAnorm_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CNAnorm/CNAnorm_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CNAnorm_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cnanorm/bioconductor-cnanorm_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-dnacopy",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:cnanorm ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-cnanorm" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CNAnorm.html" .

