@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mapredictdsc a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btt492" ;
    schema1:description "Phenotype prediction using microarray data: approach of the best overall team in the IMPROVER Diagnostic Signature Challenge" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/maPredictDSC_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/maPredictDSC/maPredictDSC_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/maPredictDSC_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mapredictdsc/bioconductor-mapredictdsc_1.48.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affy",
        "bioconductor-annotationdbi",
        "bioconductor-gcrma",
        "bioconductor-hgu133plus2.db",
        "bioconductor-limma",
        "bioconductor-lungcanceracvssccgeo",
        "bioconductor-roc",
        "r-base",
        "r-caret",
        "r-class",
        "r-e1071",
        "r-mass",
        "r-rocr" ;
    schema1:identifier biotools:mapredictdsc ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-mapredictdsc" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/maPredictDSC.html" .

