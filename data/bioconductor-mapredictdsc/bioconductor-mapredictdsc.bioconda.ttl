@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mapredictdsc a schema1:SoftwareApplication ;
    schema1:alternateName "Phenotype prediction using microarray data: approach of the best overall team in the IMPROVER Diagnostic Signature Challenge" ;
    schema1:citation "doi:10.1093/bioinformatics/btt492" ;
    schema1:description "This package implements the classification pipeline of the best overall team (Team221) in the IMPROVER Diagnostic Signature Challenge. Additional functionality is added to compare 27 combinations of data preprocessing, feature selection and classifier types." ;
    schema1:identifier <https://bio.tools/biotools:mapredictdsc> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-mapredictdsc" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/maPredictDSC.html" .

