@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:genomad a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41587-023-01953-y" ;
    schema:description "Identification of mobile genetic elements." ;
    schema:downloadUrl "https://pypi.io/packages/source/g/genomad/genomad-1.12.0.tar.gz" ;
    schema:hasPart "flit-core",
        "pip",
        "python" ;
    schema:identifier biotools:genomad ;
    schema:license "BSD-4-Clause" ;
    schema:name "genomad" ;
    schema:softwareHelp "https://portal.nersc.gov/genomad" ;
    schema:softwareVersion "1.12.0" ;
    schema:url "https://portal.nersc.gov/genomad" .

