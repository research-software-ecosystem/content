@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:binette a schema:SoftwareApplication ;
    schema:author "JeanMainguy" ;
    schema:citation "doi:10.21105/joss.06782" ;
    schema:description "A fast and accurate binning refinement tool to constructs high quality MAGs from the output of multiple binning tools." ;
    schema:downloadUrl "https://github.com/genotoul-bioinfo/binette/archive/refs/tags/v1.2.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:binette ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "JeanMainguy" ;
    schema:name "binette" ;
    schema:softwareHelp "https://binette.readthedocs.io" ;
    schema:softwareVersion "1.2.1" ;
    schema:url "https://github.com/genotoul-bioinfo/binette" .

