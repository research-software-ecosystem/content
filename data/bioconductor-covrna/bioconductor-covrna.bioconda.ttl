@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-covrna a schema1:SoftwareApplication ;
    schema1:alternateName "Multivariate Analysis of Transcriptomic Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides the analysis methods fourthcorner and RLQ analysis for large-scale transcriptomic data." ;
    schema1:identifier <https://bio.tools/biotools:covrna> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-covrna" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/covRNA.html" .

