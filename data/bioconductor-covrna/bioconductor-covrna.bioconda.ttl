@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-covrna a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Multivariate Analysis of Transcriptomic Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/covRNA_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/covRNA/covRNA_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/covRNA_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-covrna/bioconductor-covrna_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-genefilter",
        "r-ade4",
        "r-base" ;
    schema:identifier biotools:covrna ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-covrna" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/covRNA.html" .

