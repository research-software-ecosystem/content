@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hictk a schema:SoftwareApplication ;
    schema:author "jonnings",
        "robomics" ;
    schema:citation "doi:10.5281/zenodo.8214221" ;
    schema:description "Blazing fast toolkit to work with .hic and .cool files" ;
    schema:downloadUrl "https://github.com/paulsengroup/hictk/archive/refs/tags/v2.2.0.tar.gz" ;
    schema:hasPart "hdf5",
        "libarchive",
        "libdeflate",
        "libopentelemetry-cpp",
        "zstd" ;
    schema:identifier biotools:hictk ;
    schema:license "MIT" ;
    schema:maintainer "jonnings",
        "robomics" ;
    schema:name "hictk" ;
    schema:softwareHelp "https://hictk.readthedocs.io/en/stable/" ;
    schema:softwareVersion "2.2.0" ;
    schema:url "https://github.com/paulsengroup/hictk" .

