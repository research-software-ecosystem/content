@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cosmiq a schema:SoftwareApplication ;
    schema:citation "doi:10.5167/uzh-107947" ;
    schema:description "cosmiq - COmbining Single Masses Into Quantities" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cosmiq_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cosmiq/cosmiq_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cosmiq_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cosmiq/bioconductor-cosmiq_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-faahko",
        "bioconductor-massspecwavelet",
        "bioconductor-xcms",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-pracma",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:cosmiq ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-cosmiq" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cosmiq.html" .

