@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-diffbind a schema1:SoftwareApplication ;
    schema1:alternateName "Differential Binding Analysis of ChIP-Seq Peak Data" ;
    schema1:description "Compute differentially bound sites from multiple ChIP-seq experiments using affinity (quantitative) data. Also enables occupancy (overlap) analysis and plotting functions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DiffBind_3.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DiffBind/DiffBind_3.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DiffBind_3.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffbind/bioconductor-diffbind_3.20.0_src_all.tar.gz" ;
    schema1:identifier "biotools:diffbind",
        "usegalaxy-eu:diffbind" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-diffbind" ;
    schema1:softwareVersion "3.20.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DiffBind.html" .

