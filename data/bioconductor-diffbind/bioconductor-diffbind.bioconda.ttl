@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-diffbind a schema1:SoftwareApplication ;
    schema1:description "Differential Binding Analysis of ChIP-Seq Peak Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DiffBind_3.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DiffBind/DiffBind_3.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DiffBind_3.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffbind/bioconductor-diffbind_3.20.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-apeglm",
        "bioconductor-biocparallel",
        "bioconductor-deseq2",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-greylistchip",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-systempiper",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-amap",
        "r-ashr",
        "r-base",
        "r-dplyr",
        "r-ggplot2",
        "r-ggrepel",
        "r-gplots",
        "r-lattice",
        "r-locfit",
        "r-rcolorbrewer",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:diffbind ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-diffbind" ;
    schema1:softwareVersion "3.20.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DiffBind.html" .

