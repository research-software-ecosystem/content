@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:spoa a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.214270.116" ;
    schema:description "SIMD partial order alignment tool/library." ;
    schema:downloadUrl "https://github.com/rvaser/spoa/archive/refs/tags/4.1.5.tar.gz" ;
    schema:hasPart "cereal",
        "cpu_features",
        "libgomp",
        "llvm-openmp",
        "simde",
        "zlib" ;
    schema:identifier biotools:spoa ;
    schema:license "MIT" ;
    schema:name "spoa" ;
    schema:softwareHelp "https://github.com/rvaser/spoa/blob/4.1.5/README.md" ;
    schema:softwareVersion "4.1.5" ;
    schema:url "https://github.com/rvaser/spoa" .

