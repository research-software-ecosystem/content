@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cexor a schema1:SoftwareApplication ;
    schema1:citation "doi:10.14806/ej.21.0.837" ;
    schema1:description "An R package to uncover high-resolution protein-DNA interactions in ChIP-exo replicates" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CexoR_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CexoR/CexoR_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CexoR_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cexor/bioconductor-cexor_1.48.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-genomation",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-idr",
        "r-rcolorbrewer" ;
    schema1:identifier biotools:cexor ;
    schema1:license "Artistic-2.0 | GPL-2 + file LICENSE" ;
    schema1:name "bioconductor-cexor" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CexoR.html" .

