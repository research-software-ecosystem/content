@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-multidataset a schema1:SoftwareApplication ;
    schema1:description "Implementation of MultiDataSet and ResultSet" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MultiDataSet_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MultiDataSet/MultiDataSet_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MultiDataSet_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-multidataset/bioconductor-multidataset_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-ggplot2",
        "r-ggrepel",
        "r-qqman" ;
    schema1:identifier biotools:multidataset ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-multidataset" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MultiDataSet.html" .

