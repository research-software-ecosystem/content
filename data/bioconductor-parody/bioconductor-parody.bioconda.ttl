@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-parody a schema1:SoftwareApplication ;
    schema1:alternateName "Parametric And Resistant Outlier DYtection" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Provide routines for univariate and multivariate outlier detection with a focus on parametric methods, but support for some methods based on resistant statistics." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/parody_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/parody/parody_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/parody_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-parody/bioconductor-parody_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:parody" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-parody" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/parody.html" .

