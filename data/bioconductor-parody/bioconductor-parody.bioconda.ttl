        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/parody/parody_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/parody_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-parody/bioconductor-parody_1.68.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:parody ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-parody" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/parody.html" .

