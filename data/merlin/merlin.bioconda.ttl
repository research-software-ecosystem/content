@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:merlin a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ng786" ;
    schema:description "MERLIN uses sparse trees to represent gene flow in pedigrees and is a fast pedigree analysis package" ;
    schema:downloadUrl "http://csg.sph.umich.edu/abecasis/merlin/download/merlin-1.1.2.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Merlin ;
    schema:license "OpenSource" ;
    schema:name "merlin" ;
    schema:softwareVersion "1.1.2" ;
    schema:url "http://csg.sph.umich.edu/abecasis/merlin" .

