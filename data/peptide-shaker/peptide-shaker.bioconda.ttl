@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:peptide-shaker a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.3109" ;
    schema:description "Independent platform for interpretation of proteomics identification results." ;
    schema:downloadUrl "https://genesis.ugent.be/maven2/eu/isas/peptideshaker/PeptideShaker/3.0.11/PeptideShaker-3.0.11.zip" ;
    schema:identifier biotools:peptide-shaker ;
    schema:license "Apache-2.0" ;
    schema:name "peptide-shaker" ;
    schema:softwareHelp "https://github.com/compomics/peptide-shaker/blob/master/README.md" ;
    schema:softwareVersion "3.0.11" ;
    schema:url "https://compomics.github.io/projects/peptide-shaker.html" .

