@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:peptide-shaker a schema1:SoftwareApplication ;
    schema1:alternateName "Independent platform for interpretation of proteomics identification results." ;
    schema1:citation "doi:10.1038/nbt.3109" ;
    schema1:description "PeptideShaker is a search engine independent platform for interpretation of proteomics identification results from multiple search engines, currently supporting X!Tandem, MS-GF+, Metamorpheus, MS Amanda, OMSSA, MyriMatch, Comet, Tide, Mascot, Andromeda and mzIdentML. By combining the results from multiple search engines, while re-calculating PTM localization scores and redoing the protein inference, PeptideShaker attempts to give you the best possible understanding of your proteomics data!" ;
    schema1:downloadUrl "https://genesis.ugent.be/maven2/eu/isas/peptideshaker/PeptideShaker/3.0.11/PeptideShaker-3.0.11.zip" ;
    schema1:identifier "biotools:peptide-shaker",
        "usegalaxy-eu:peptide_shaker" ;
    schema1:license "Apache-2.0" ;
    schema1:name "peptide-shaker" ;
    schema1:softwareVersion "3.0.11" ;
    schema1:url "https://compomics.github.io/projects/peptide-shaker.html" .

