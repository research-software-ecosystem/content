@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rarevariantvis a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btw359" ;
    schema1:description "A suite for analysis of rare genomic variants in whole genome sequencing data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RareVariantVis_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RareVariantVis/RareVariantVis_2.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RareVariantVis_2.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rarevariantvis/bioconductor-rarevariantvis_2.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-bsgenome",
        "bioconductor-bsgenome.hsapiens.ucsc.hg19",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-genomicscores",
        "bioconductor-iranges",
        "bioconductor-phastcons100way.ucsc.hg19",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-txdb.hsapiens.ucsc.hg19.knowngene",
        "bioconductor-variantannotation",
        "r-base",
        "r-googlevis",
        "r-gtools" ;
    schema1:identifier biotools:rarevariantvis ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-rarevariantvis" ;
    schema1:softwareVersion "2.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RareVariantVis.html" .

