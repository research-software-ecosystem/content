@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:plassembler a schema:SoftwareApplication ;
    schema:author "gbouras13" ;
    schema:citation "doi:10.1093/bioinformatics/btad409" ;
    schema:description "Quickly and accurately assemble plasmids in hybrid sequenced bacterial isolates." ;
    schema:downloadUrl "https://pypi.io/packages/source/p/plassembler/plassembler-1.8.2.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "python" ;
    schema:identifier biotools:plassembler ;
    schema:license "MIT" ;
    schema:maintainer "gbouras13" ;
    schema:name "plassembler" ;
    schema:softwareHelp "https://plassembler.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.8.2" ;
    schema:url "https://github.com/gbouras13/plassembler" .

