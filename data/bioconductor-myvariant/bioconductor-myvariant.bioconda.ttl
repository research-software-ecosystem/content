@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-myvariant a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/035667" ;
    schema:description "Accesses MyVariant.info variant query and annotation services" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/myvariant_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/myvariant/myvariant_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/myvariant_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-myvariant/bioconductor-myvariant_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomeinfodb",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-variantannotation",
        "r-base",
        "r-hmisc",
        "r-httr",
        "r-jsonlite",
        "r-magrittr",
        "r-plyr" ;
    schema:identifier biotools:myvariant ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-myvariant" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/myvariant.html" .

