@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-myvariant a schema1:SoftwareApplication ;
    schema1:alternateName "Accesses MyVariant.info variant query and annotation services" ;
    schema1:citation "doi:10.1101/035667" ;
    schema1:description "MyVariant.info is a comprehensive aggregation of variant annotation resources. myvariant is a wrapper for querying MyVariant.info services" ;
    schema1:identifier biotools:myvariant ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-myvariant" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/myvariant.html" .

