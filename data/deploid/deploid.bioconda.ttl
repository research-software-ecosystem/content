@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:deploid a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx530" ;
    schema:description "A software that deconvolutes mixed genomes with unknown proportions." ;
    schema:downloadUrl "https://github.com/mcveanlab/DEploid/archive/v0.5-release.tar.gz" ;
    schema:hasPart "cppunit",
        "zlib" ;
    schema:identifier biotools:DEploid ;
    schema:license "GPLv3" ;
    schema:name "deploid" ;
    schema:softwareVersion "0.5" ;
    schema:url "http://deploid.readthedocs.io/en/latest/index.html" .

