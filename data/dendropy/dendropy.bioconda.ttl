@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dendropy a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btq228" ;
    schema:description "A Python library for phylogenetics and phylogenetic computing: reading, writing, simulation, processing and manipulation of phylogenetic trees (phylogenies) and characters." ;
    schema:downloadUrl "https://github.com/jeetsukumaran/DendroPy/archive/refs/tags/v5.0.8.tar.gz" ;
    schema:hasPart "pip",
        "pytest-runner",
        "python",
        "setuptools" ;
    schema:identifier biotools:dendropy ;
    schema:license "BSD-3-Clause" ;
    schema:name "dendropy" ;
    schema:softwareHelp "https://dendropy.org" ;
    schema:softwareVersion "5.0.8" ;
    schema:url "https://github.com/jeetsukumaran/DendroPy" .

