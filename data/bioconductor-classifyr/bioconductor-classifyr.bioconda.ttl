@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-classifyr a schema:SoftwareApplication ;
    schema:description "A framework for cross-validated classification problems, with applications to differential variability and differential distribution testing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ClassifyR_3.14.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ClassifyR/ClassifyR_3.14.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ClassifyR_3.14.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-classifyr/bioconductor-classifyr_3.14.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "bioconductor-dcanr",
        "bioconductor-genefilter",
        "bioconductor-multiassayexperiment",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-broom",
        "r-dplyr",
        "r-generics",
        "r-ggplot2",
        "r-ggpubr",
        "r-ggupset",
        "r-ranger",
        "r-reshape2",
        "r-rlang",
        "r-survival",
        "r-tidyr",
        "zlib" ;
    schema:identifier biotools:classifyr ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-classifyr" ;
    schema:softwareVersion "3.14.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ClassifyR.html" .

