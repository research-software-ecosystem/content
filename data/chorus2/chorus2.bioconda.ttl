@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:chorus2 a schema1:SoftwareApplication ;
    schema1:alternateName "A pipeline to select oligonucleotides for fluorescence in situ hbridization (Oligo-FISH)." ;
    schema1:description "A pipeline to select oligonucleotides for fluorescence in situ hbridization (Oligo-FISH)." ;
