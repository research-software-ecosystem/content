@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:chorus2 a schema:SoftwareApplication ;
    schema:author "forrestzhang",
        "ljq12697",
        "zhangtaolab" ;
    schema:description "A pipeline to select oligonucleotides for fluorescence in situ hbridization (Oligo-FISH)." ;
    schema:downloadUrl "https://github.com/zhangtaolab/Chorus2/archive/v2.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:chorus2 ;
    schema:license "MIT" ;
    schema:maintainer "forrestzhang",
        "ljq12697",
        "zhangtaolab" ;
    schema:name "chorus2" ;
    schema:softwareHelp "https://chorus2.readthedocs.io/en/dev/" ;
    schema:softwareVersion "2.1" ;
    schema:url "https://github.com/zhangtaolab/Chorus2" .

