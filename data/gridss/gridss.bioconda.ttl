@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gridss a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.222109.117",
        "doi:10.1186/s13059-021-02423-x" ;
    schema:description "GRIDSS: The Genomic Rearrangement IDentification Software Suite." ;
    schema:downloadUrl "https://github.com/PapenfussLab/gridss/releases/download/v2.13.2/gridss-2.13.2.tar.gz" ;
    schema:hasPart "htslib",
        "liblzma-devel",
        "ncurses",
        "zlib" ;
    schema:identifier biotools:gridss ;
    schema:license "GPL-3.0-only" ;
    schema:name "gridss" ;
    schema:softwareVersion "2.13.2" ;
    schema:url "https://github.com/PapenfussLab/gridss" .

