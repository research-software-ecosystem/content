@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-inspect a schema1:SoftwareApplication ;
    schema1:description "Modeling RNA synthesis, processing and degradation with RNA-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/INSPEcT_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/INSPEcT/INSPEcT_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/INSPEcT_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-inspect/bioconductor-inspect_1.40.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-deseq2",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-plgem",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-txdb.mmusculus.ucsc.mm9.knowngene",
        "r-base",
        "r-desolve",
        "r-kernsmooth",
        "r-proc",
        "r-readxl",
        "r-rootsolve",
        "r-shiny" ;
    schema1:identifier biotools:inspect ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-inspect" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/INSPEcT.html" .

