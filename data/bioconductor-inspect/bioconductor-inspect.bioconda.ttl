@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-inspect a schema1:SoftwareApplication ;
    schema1:alternateName "Modeling RNA synthesis, processing and degradation with RNA-seq data" ;
    schema1:description "INSPEcT (INference of Synthesis, Processing and dEgradation rates from Transcriptomic data) RNA-seq data in time-course experiments or steady-state conditions, with or without the support of nascent RNA data." ;
    schema1:identifier biotools:inspect ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-inspect" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/INSPEcT.html" .

