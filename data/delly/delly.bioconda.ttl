@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:delly a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bts378" ;
    schema:description "Structural variant discovery by integrated paired-end and split-read analysis" ;
    schema:downloadUrl "https://github.com/dellytools/delly/archive/v2.1.0.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "htslib",
        "xz",
        "zlib" ;
    schema:identifier biotools:delly2 ;
    schema:license "BSD-3-Clause" ;
    schema:name "delly" ;
    schema:softwareHelp "https://github.com/dellytools/delly/blob/v2.1.0/README.md" ;
    schema:softwareVersion "2.1.0" ;
    schema:url "https://github.com/dellytools/delly" .

