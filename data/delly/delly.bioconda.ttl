@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:delly a schema1:SoftwareApplication ;
    schema1:alternateName "Structural variant discovery by integrated paired-end and split-read analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/bts378" ;
    schema1:description "Structural variant discovery by integrated paired-end and split-read analysis" ;
    schema1:downloadUrl "https://github.com/dellytools/delly/archive/v2.1.0.tar.gz" ;
    schema1:identifier "biotools:delly2",
        "usegalaxy-eu:delly_call",
        "usegalaxy-eu:delly_classify",
        "usegalaxy-eu:delly_cnv",
        "usegalaxy-eu:delly_filter",
        "usegalaxy-eu:delly_lr",
        "usegalaxy-eu:delly_merge" ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "delly" ;
    schema1:softwareVersion "2.1.0" ;
    schema1:url "https://github.com/dellytools/delly" .

