@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:peakranger a schema:SoftwareApplication ;
    schema:description "PeakRanger is a multi-purporse software suite for analyzing next-generation sequencing (NGS) data." ;
    schema:downloadUrl "http://downloads.sourceforge.net/project/ranger/Source%20codes/PeakRanger-1.18-src.zip" ;
    schema:hasPart "boost-cpp",
        "zlib" ;
    schema:identifier biotools:peakranger ;
    schema:license "Artistic License 2.0" ;
    schema:name "peakranger" ;
    schema:softwareVersion "1.18" ;
    schema:url "http://ranger.sourceforge.net" .

