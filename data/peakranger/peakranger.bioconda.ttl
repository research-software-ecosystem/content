@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:peakranger a schema1:SoftwareApplication ;
    schema1:alternateName "PeakRanger is a multi-purporse software suite for analyzing next-generation sequencing (NGS) data." ;
    schema1:description "PeakRanger is a multi-purporse software suite for analyzing next-generation sequencing (NGS) data." ;
    schema1:identifier biotools:peakranger ;
    schema1:license "Artistic License 2.0" ;
    schema1:name "peakranger" ;
    schema1:softwareVersion "1.18" ;
    schema1:url "http://ranger.sourceforge.net" .

