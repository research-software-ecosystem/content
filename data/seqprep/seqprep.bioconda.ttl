@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seqprep a schema:SoftwareApplication ;
    schema:citation "doi:10.1134/S1021443716020175" ;
    schema:description "Tool for stripping adaptors and/or merging paired reads with overlap into single reads." ;
    schema:downloadUrl "https://github.com/jstjohn/SeqPrep/archive/v1.3.2.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:seqprep ;
    schema:license "MIT" ;
    schema:name "seqprep" ;
    schema:softwareHelp "https://github.com/jstjohn/SeqPrep/blob/v1.3.2/README.md" ;
    schema:softwareVersion "1.3.2" ;
    schema:url "https://github.com/jstjohn/SeqPrep" .

