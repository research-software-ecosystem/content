@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:seqprep a schema1:SoftwareApplication ;
    bioschemas:output "fastq.gz" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196,
        edam:topic_0622,
        edam:topic_0632,
        edam:topic_3168 ;
    schema1:codeRepository "https://github.com/jstjohn/SeqPrep" ;
    schema1:dateCreated "2024-01-15" ;
    schema1:description "Tool for merging paired-end Illumina reads and trimming adapters." ;
    schema1:encodingFormat "fastq.gz" ;
    schema1:featureList edam:operation_3095,
        edam:topic_2953 ;
    schema1:identifier biotools:seqprep,
        bioconda:seqprep ;
    schema1:keywords "Fastq Manipulation",
        "Sequence Analysis" ;
    schema1:name "seqprep" ;
    schema1:softwareVersion "1.3.2" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/seqprep" .

