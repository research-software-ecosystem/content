@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:varvamp a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "fasta",
        "pdf",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0632,
        edam:topic_0781 ;
    schema1:codeRepository "https://github.com/jonas-fuchs/varVAMP/" ;
    schema1:dateCreated "2024-01-27" ;
    schema1:description "Variable VirusAMPlicons (varVAMP) is a tool to design primers for highly diverse viruses" ;
    schema1:encodingFormat "bed",
        "fasta",
        "pdf",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_0308 ;
    schema1:identifier biotools:varvamp,
        bioconda:varvamp ;
    schema1:isPartOf <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1627?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "varvamp" ;
    schema1:softwareVersion "1.3" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/varvamp" .

<https://workflowhub.eu> a schema1:WebSite .

