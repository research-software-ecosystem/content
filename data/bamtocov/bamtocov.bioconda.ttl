@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bamtocov a schema:SoftwareApplication ;
    schema:author "telatin" ;
    schema:citation "doi:10.3390/bioengineering8050059" ;
    schema:description "Extract coverage information from BAM files, supporting stranded and physical coverage and streams." ;
    schema:hasPart "htslib",
        "pcre",
        "zlib" ;
    schema:identifier biotools:bamtocov ;
    schema:license "MIT" ;
    schema:maintainer "telatin" ;
    schema:name "bamtocov" ;
    schema:softwareVersion "2.8.0" ;
    schema:url "https://github.com/telatin/bamtocov" .

