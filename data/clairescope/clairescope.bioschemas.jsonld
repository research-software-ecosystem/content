  "@id": "https://bio.tools/clairescope",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "CLAIREscope (Cellular Landscape Analysis, Interpretation & Results Explorer) is an open-source interactive platform for reproducible single-cell transcriptomics analysis, built with Python, Scanpy, and Streamlit. It integrates data preprocessing, quality control, multi-sample exploration, dimensionality reduction, cell composition analysis, gene expression visualization and statistics, gene signature and correlation analysis, differential expression, heatmaps, trajectory and pseudotime modeling, and pathway enrichment within a unified analytical workflow. Interactive parameter tuning and visualization enable rapid exploration and refinement of biological hypotheses without repeatedly rebuilding analysis pipelines. CLAIREscope supports reproducible analysis and publication-ready output generation, bridging interactive data exploration with downstream biological interpretation.",
  "sc:name": "CLAIREscope",
  "sc:softwareVersion": "1.0.0",
  "sc:url": "https://github.com/ccneko/CLAIREscope"
}