@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flagme a schema1:SoftwareApplication ;
    schema1:alternateName "Analysis of Metabolomics GC/MS Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Fragment-level analysis of gas chromatography-massspectrometry metabolomics data." ;
    schema1:identifier biotools:flagme ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-flagme" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flagme.html" .

