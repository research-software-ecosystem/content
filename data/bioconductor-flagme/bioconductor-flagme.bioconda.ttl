@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flagme a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Analysis of Metabolomics GC/MS Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flagme_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flagme/flagme_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flagme_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flagme/bioconductor-flagme_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-camera",
        "bioconductor-gcspikelite",
        "bioconductor-xcms",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-gplots",
        "r-mass",
        "r-sparsem",
        "zlib" ;
    schema:identifier biotools:flagme ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-flagme" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flagme.html" .

