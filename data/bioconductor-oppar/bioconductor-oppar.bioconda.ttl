@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-oppar a schema1:SoftwareApplication ;
    schema1:alternateName "Outlier profile and pathway analysis in R" ;
    schema1:description "The R implementation of mCOPA package published by Wang et al. (2012). Oppar provides methods for Cancer Outlier profile Analysis. Although initially developed to detect outlier genes in cancer studies, methods presented in oppar can be used for outlier profile analysis in general. In addition, tools are provided for gene set enrichment and pathway analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/oppar_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/oppar/oppar_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/oppar_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-oppar/bioconductor-oppar_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:oppar" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-oppar" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/oppar.html" .

