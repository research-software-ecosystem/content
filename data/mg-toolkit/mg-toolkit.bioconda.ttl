@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mg-toolkit a schema:SoftwareApplication ;
    schema:description "Metagenomics toolkit." ;
    schema:downloadUrl "https://pypi.io/packages/source/m/mg-toolkit/mg-toolkit-0.10.4.tar.gz" ;
    schema:hasPart "pip",
        "pytest-runner",
        "python" ;
    schema:identifier biotools:MGnify ;
    schema:license "Apache-2.0" ;
    schema:name "mg-toolkit" ;
    schema:softwareVersion "0.10.4" ;
    schema:url "https://www.ebi.ac.uk/metagenomics" .

