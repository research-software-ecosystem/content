@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pal2nal a schema:SoftwareApplication ;
    schema:author "liaochenlanruo" ;
    schema:description "robust conversion of protein sequence alignments into the corresponding codon alignments" ;
    schema:downloadUrl "https://github.com/liaochenlanruo/PAL2NAL/archive/v14.1.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:pal2nal ;
    schema:license "GPLv2.0" ;
    schema:maintainer "liaochenlanruo" ;
    schema:name "pal2nal" ;
    schema:softwareVersion "14.1" ;
    schema:url "http://www.bork.embl.de/pal2nal/" .

