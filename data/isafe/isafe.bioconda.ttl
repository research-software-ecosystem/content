@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:isafe a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.4606" ;
    schema:description "A program for identifying a favored mutation in positive selective sweep." ;
    schema:downloadUrl "https://github.com/alek0991/iSAFE/archive/refs/tags/v1.1.1.tar.gz" ;
    schema:identifier biotools:isafe ;
    schema:license "BSD-3-Clause" ;
    schema:name "isafe" ;
    schema:softwareVersion "1.1.1" ;
    schema:url "https://github.com/alek0991/iSAFE" .

