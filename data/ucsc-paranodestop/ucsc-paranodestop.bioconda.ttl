@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ucsc-paranodestop a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bib/bbs038" ;
    schema:description " Shut down parasol node daemons on a list of machines " ;
    schema:downloadUrl "http://hgdownload.cse.ucsc.edu/admin/exe/userApps.archive/userApps.v469.src.tgz" ;
    schema:hasPart "libopenssl-static",
        "libpng",
        "libuuid",
        "mysql-connector-c",
        "zlib" ;
    schema:identifier biotools:UCSC_Genome_Browser_Utilities ;
    schema:license "Varies; see http://genome.ucsc.edu/license" ;
    schema:name "ucsc-paranodestop" ;
    schema:softwareHelp "https://github.com/ucscGenomeBrowser/kent/blob/master/README" ;
    schema:softwareVersion "469" ;
    schema:url "https://hgdownload.cse.ucsc.edu/admin/exe/" .

