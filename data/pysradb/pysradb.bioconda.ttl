@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pysradb a schema:SoftwareApplication ;
    schema:author "saketkc" ;
    schema:citation "doi:10.12688/f1000research.18676.1" ;
    schema:description "Python package for retrieving metadata and downloading datasets from SRA/ENA/GEO" ;
    schema:downloadUrl "https://pypi.io/packages/source/p/pysradb/pysradb-2.5.1.tar.gz" ;
    schema:hasPart "hatchling",
        "pip",
        "python" ;
    schema:identifier biotools:pysradb ;
    schema:license "BSD-3-Clause" ;
    schema:maintainer "saketkc" ;
    schema:name "pysradb" ;
    schema:softwareHelp "https://saketkc.github.io/pysradb" ;
    schema:softwareVersion "2.5.1" ;
    schema:url "https://github.com/saketkc/pysradb" .

