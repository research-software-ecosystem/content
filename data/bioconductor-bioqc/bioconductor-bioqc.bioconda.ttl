@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bioqc a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-017-3661-2" ;
    schema:description "Detect tissue heterogeneity in expression profiles with gene sets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BioQC_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BioQC/BioQC_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BioQC_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bioqc/bioconductor-bioqc_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-edger",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:bioqc ;
    schema:license "GPL (>=3) + file LICENSE" ;
    schema:name "bioconductor-bioqc" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BioQC.html" .

