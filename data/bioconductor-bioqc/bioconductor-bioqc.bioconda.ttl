@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bioqc a schema1:SoftwareApplication ;
    schema1:alternateName "Detect tissue heterogeneity in expression profiles with gene sets" ;
    schema1:citation "doi:10.1186/s12864-017-3661-2" ;
    schema1:description "BioQC performs quality control of high-throughput expression data based on tissue gene signatures. It can detect tissue heterogeneity in gene expression data. The core algorithm is a Wilcoxon-Mann-Whitney test that is optimised for high performance." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BioQC_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BioQC/BioQC_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BioQC_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bioqc/bioconductor-bioqc_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:bioqc" ;
    schema1:license "GPL (>=3) + file LICENSE" ;
    schema1:name "bioconductor-bioqc" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BioQC.html" .

