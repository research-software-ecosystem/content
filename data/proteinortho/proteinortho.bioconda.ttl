@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:proteinortho a schema:SoftwareApplication ;
    schema:citation "doi:10.3389/fbinf.2023.1322477" ;
    schema:description "Proteinortho is a tool to detect orthologous genes within different species." ;
    schema:downloadUrl "https://gitlab.com/paulklemm_PHD/proteinortho/-/archive/v6.3.6/proteinortho-v6.3.6.tar.gz" ;
    schema:hasPart "libblas",
        "libgomp",
        "liblapacke",
        "llvm-openmp" ;
    schema:identifier biotools:proteinortho ;
    schema:license "GPL-3.0-only" ;
    schema:name "proteinortho" ;
    schema:softwareHelp "https://gitlab.com/paulklemm_PHD/proteinortho/-/blob/master/README.md" ;
    schema:softwareVersion "6.3.6" ;
    schema:url "https://gitlab.com/paulklemm_PHD/proteinortho" .

