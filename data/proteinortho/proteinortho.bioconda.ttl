@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:proteinortho a schema1:SoftwareApplication ;
    schema1:alternateName "Proteinortho is a tool to detect orthologous genes within different species." ;
    schema1:citation "doi:10.3389/fbinf.2023.1322477" ;
    schema1:description "Proteinortho is a tool to detect orthologous genes within different species." ;
    schema1:identifier <https://bio.tools/biotools:proteinortho>,
        "usegalaxy-eu:proteinortho",
        "usegalaxy-eu:proteinortho_grab_proteins",
        "usegalaxy-eu:proteinortho_summary" ;
    schema1:license "GPL-3.0-only" ;
    schema1:name "proteinortho" ;
    schema1:softwareVersion "6.3.6" ;
    schema1:url "https://gitlab.com/paulklemm_PHD/proteinortho" .

