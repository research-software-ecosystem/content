    schema1:dateCreated "2020-02-05" ;
    schema1:description "Proteinortho is a tool to detect orthologous proteins/genes within different species." ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_0291,
        edam:operation_2403,
        edam:topic_0080,
        edam:topic_0164 ;
    schema1:identifier biotools:proteinortho,
        bioconda:proteinortho ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
