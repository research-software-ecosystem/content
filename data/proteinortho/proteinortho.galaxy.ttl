        <https://workflowhub.eu/workflows/358?version=1> ;
    schema1:keywords "Proteomics" ;
    schema1:name "proteinortho" ;
    schema1:softwareVersion "6.3.6" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/proteinortho> .

