@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tiberius a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btae685" ;
    schema:description "Tiberius is a deep learning gene-finder." ;
    schema:downloadUrl "https://github.com/Gaius-Augustus/Tiberius/archive/refs/tags/v2.0.6.tar.gz" ;
    schema:hasPart "hatchling",
        "pip",
        "python" ;
    schema:identifier biotools:tiberius ;
    schema:license "MIT" ;
    schema:name "tiberius" ;
    schema:softwareHelp "https://github.com/Gaius-Augustus/Tiberius/blob/v2.0.6/README.md" ;
    schema:softwareVersion "2.0.6" ;
    schema:url "https://github.com/Gaius-Augustus/Tiberius" .

