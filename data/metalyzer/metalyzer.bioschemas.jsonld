      "sc:citation": {
        "@id": "https://doi.org/10.64898/2025.12.17.692011"
      },
      "sc:description": "MetAlyzer is an R package and interactive Shiny application designed to process and analyze targeted metabolomics data, specifically handling outputs from the biocrates platform. It provides tools for data preprocessing, statistical testing, and visualization of differential metabolites.",
