    schema1:dateCreated "2024-08-25" ;
    schema1:description "Convert GTDB taxonomy to NCBI taxdump format" ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_2409,
        edam:operation_2427,
        edam:operation_2429,
        edam:operation_3429,
        edam:topic_0102 ;
    schema1:identifier biotools:gtdb_to_taxdump,
        bioconda:gtdb_to_taxdump ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=cf0159c14418525e>,
        <https://usegalaxy.eu/published/workflow?id=e4dabaf57668dbd1>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://workflowhub.eu/workflows/2099?version=3> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "gtdb_to_taxdump" ;
    schema1:softwareVersion "0.1.9" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/gtdb_to_taxdump> .

