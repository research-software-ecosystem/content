@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rcgh a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv718" ;
    schema:description "Comprehensive Pipeline for Analyzing and Visualizing Array-Based CGH Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rCGH_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rCGH/rCGH_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rCGH_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rcgh/bioconductor-rcgh_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-acgh",
        "bioconductor-affy",
        "bioconductor-annotationdbi",
        "bioconductor-dnacopy",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-org.hs.eg.db",
        "bioconductor-seqinfo",
        "bioconductor-txdb.hsapiens.ucsc.hg18.knowngene",
        "bioconductor-txdb.hsapiens.ucsc.hg19.knowngene",
        "bioconductor-txdb.hsapiens.ucsc.hg38.knowngene",
        "r-base",
        "r-ggplot2",
        "r-lattice",
        "r-mclust",
        "r-plyr",
        "r-shiny" ;
    schema:identifier biotools:rcgh ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-rcgh" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rCGH.html" .

