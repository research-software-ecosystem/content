  "description": "Offline tool for cleaning tables of human gene and protein identifiers (TXT, CSV, TSV, XLSX). It maps approved symbols, aliases, previous symbols, Ensembl gene, UniProt, Entrez, RefSeq and HGNC identifiers to current HGNC approved symbols with cross-references, using a bundled HGNC snapshot. Excel date-corrupted symbols are recovered where the original is unambiguous and flagged for manual review otherwise; no input row is dropped. Each run records the tool version and HGNC release and writes a per-row audit table.",
  "editPermission": {
    "type": "private"
  },
  "function": [
    {
      "cmd": "gene-tidy genes.csv --out outputs/",
      "input": [
        {
          "data": {
            "term": "Gene identifier",
            "uri": "http://edamontology.org/data_1025"
          },
          "format": [
            {
              "term": "xlsx",
              "uri": "http://edamontology.org/format_3620"
            },
            {
