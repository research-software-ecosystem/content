              "uri": "http://edamontology.org/format_3752"
            },
            {
              "term": "TSV",
              "uri": "http://edamontology.org/format_3475"
            }
          ]
        }
      ],
      "note": "Map a table of mixed human gene identifiers to current HGNC approved symbols; ambiguous and unmatched rows are written to separate files.",
      "operation": [
        {
          "term": "ID mapping",
          "uri": "http://edamontology.org/operation_3282"
        }
