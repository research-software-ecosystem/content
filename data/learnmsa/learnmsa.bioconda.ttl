@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:learnmsa a schema:SoftwareApplication ;
    schema:author "felbecker" ;
    schema:citation "doi:10.1093/gigascience/giac104" ;
    schema:description "learnMSA: Learning and Aligning large Protein Families" ;
    schema:downloadUrl "https://pypi.io/packages/source/l/learnMSA/learnmsa-2.0.16.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:learnMSA ;
    schema:license "MIT" ;
    schema:maintainer "felbecker" ;
    schema:name "learnmsa" ;
    schema:softwareVersion "2.0.16" ;
    schema:url "https://github.com/Gaius-Augustus/learnMSA" .

