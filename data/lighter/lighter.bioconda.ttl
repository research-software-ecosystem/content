@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:lighter a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-014-0509-9" ;
    schema:description "Lighter is a kmer-based error correction method for whole genome sequencing data." ;
    schema:downloadUrl "https://github.com/mourisl/Lighter/archive/v1.1.3.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Lighter ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "lighter" ;
    schema:softwareHelp "https://github.com/mourisl/Lighter/blob/v1.1.3/README.md" ;
    schema:softwareVersion "1.1.3" ;
    schema:url "https://github.com/mourisl/Lighter" .

