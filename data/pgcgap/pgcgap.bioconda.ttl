@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pgcgap a schema:SoftwareApplication ;
    schema:author "liaochenlanruo" ;
    schema:description "A prokaryotic genomics and comparative genomics analysis pipeline" ;
    schema:downloadUrl "https://github.com/liaochenlanruo/pgcgap/archive/v1.0.35.tar.gz" ;
    schema:hasPart "perl",
        "perl-bioperl",
        "perl-file-copy-recursive",
        "perl-file-tee" ;
    schema:identifier biotools:pgcgap ;
    schema:license "GPLv3" ;
    schema:maintainer "liaochenlanruo" ;
    schema:name "pgcgap" ;
    schema:softwareHelp "https://liaochenlanruo.fun/pgcgap/" ;
    schema:softwareVersion "1.0.35" ;
    schema:url "https://github.com/liaochenlanruo/pgcgap/blob/master/README.md" .

