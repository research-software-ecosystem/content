@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biomformat a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "An interface package for the BIOM file format" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/biomformat_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/biomformat/biomformat_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/biomformat_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biomformat/bioconductor-biomformat_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rhdf5",
        "r-base",
        "r-jsonlite",
        "r-matrix",
        "r-plyr" ;
    schema:identifier biotools:biomformat ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-biomformat" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/biomformat.html" .

