@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:macs2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2008-9-9-r137" ;
    schema:description "Model Based Analysis for ChIP-Seq data." ;
    schema:downloadUrl "https://pypi.io/packages/source/M/MACS2/MACS2-2.2.9.1.tar.gz" ;
    schema:hasPart "cykhash",
        "cython",
        "hmmlearn",
        "numpy",
        "pip",
        "python",
        "wheel" ;
    schema:identifier biotools:macs ;
    schema:license "BSD-3-Clause" ;
    schema:name "macs2" ;
    schema:softwareHelp "https://macs3-project.github.io/MACS" ;
    schema:softwareVersion "2.2.9.1" ;
    schema:url "https://github.com/macs3-project/MACS" .

