@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:souporcell a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/699637v1" ;
    schema:description "Clustering scRNAseq by genotypes." ;
    schema:downloadUrl "https://github.com/wheaton5/souporcell/archive/refs/tags/v2.5.tar.gz" ;
    schema:identifier biotools:souporcell ;
    schema:license "MIT" ;
    schema:name "souporcell" ;
    schema:softwareVersion "2.5" ;
    schema:url "https://github.com/wheaton5/souporcell" .

