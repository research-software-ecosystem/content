@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mgfr a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-015-1785-9" ;
    schema:description "Marker Gene Finder in RNA-seq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MGFR_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/MGFR/MGFR_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/MGFR_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mgfr/bioconductor-mgfr_1.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-biomart",
        "r-base" ;
    schema:identifier biotools:mgfr ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-mgfr" ;
    schema:softwareVersion "1.32.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/MGFR.html" .

