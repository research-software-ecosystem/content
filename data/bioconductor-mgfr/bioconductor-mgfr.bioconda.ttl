@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mgfr a schema1:SoftwareApplication ;
    schema1:alternateName "Marker Gene Finder in RNA-seq data" ;
    schema1:citation "doi:10.1186/s12864-015-1785-9" ;
    schema1:description "The package is designed to detect marker genes from RNA-seq data." ;
    schema1:identifier biotools:mgfr ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-mgfr" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/MGFR.html" .

