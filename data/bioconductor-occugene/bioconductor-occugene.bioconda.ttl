@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-occugene a schema1:SoftwareApplication ;
    schema1:alternateName "Functions for Multinomial Occupancy Distribution" ;
    schema1:citation "doi:10.1007/978-1-59745-321-9_22" ;
    schema1:description "Statistical tools for building random mutagenesis libraries for prokaryotes. The package has functions for handling the occupancy distribution for a multinomial and for estimating the number of essential genes in random transposon mutagenesis libraries." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/occugene_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/occugene/occugene_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/occugene_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-occugene/bioconductor-occugene_1.70.0_src_all.tar.gz" ;
    schema1:identifier "biotools:occugene" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-occugene" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/occugene.html" .

