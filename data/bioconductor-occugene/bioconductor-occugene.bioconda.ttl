@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-occugene a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-59745-321-9_22" ;
    schema:description "Functions for Multinomial Occupancy Distribution" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/occugene_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/occugene/occugene_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/occugene_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-occugene/bioconductor-occugene_1.70.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:occugene ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-occugene" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/occugene.html" .

