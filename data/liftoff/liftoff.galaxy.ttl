@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:liftoff a schema1:SoftwareApplication ;
    bioschemas:output "gff3",
        "txt" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:operation_2429,
        edam:topic_0102,
        edam:topic_0196,
        edam:topic_0203,
        edam:topic_3512,
        edam:topic_3794 ;
    schema1:codeRepository <https://github.com/agshumate/Liftoff> ;
    schema1:dateCreated "2026-02-02" ;
    schema1:description "Lift gene annotations between genome assemblies using Liftoff" ;
    schema1:encodingFormat "gff3",
        "txt" ;
    schema1:featureList edam:operation_0523,
        edam:operation_0525,
        edam:operation_2429,
        edam:operation_3440,
        edam:topic_0102 ;
    schema1:identifier biotools:liftoff,
        bioconda:liftoff ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org/published/workflow?id=84b447be2f1c5870> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "liftoff" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc> .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org> a schema1:WebSite .

<https://usegalaxy.org.au> a schema1:WebSite .

