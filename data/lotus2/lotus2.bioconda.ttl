@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:lotus2 a schema1:SoftwareApplication ;
    schema1:alternateName "LotuS2 is a lightweight complete 16S/18S/ITS pipeline. Deprecated in favour of LotuS3." ;
    schema1:citation "doi:10.1186/s40168-022-01365-1" ;
    schema1:description "LotuS2 is a lightweight complete 16S/18S/ITS pipeline. Deprecated in favour of LotuS3." ;
    schema1:identifier biotools:lotus2 ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "nsoranzo" ;
    schema1:name "lotus2" ;
    schema1:softwareVersion "2.34.1" ;
    schema1:url "http://lotus2.earlham.ac.uk/" .

