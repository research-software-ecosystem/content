@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:lotus2 a schema:SoftwareApplication ;
    schema:author "nsoranzo" ;
    schema:citation "doi:10.1186/s40168-022-01365-1" ;
    schema:description "LotuS2 is a lightweight complete 16S/18S/ITS pipeline" ;
    schema:downloadUrl "https://github.com/hildebra/lotus2/archive/refs/tags/v2.34.1.tar.gz" ;
    schema:identifier biotools:lotus2 ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "nsoranzo" ;
    schema:name "lotus2" ;
    schema:softwareVersion "2.34.1" ;
    schema:url "http://lotus2.earlham.ac.uk/" .

