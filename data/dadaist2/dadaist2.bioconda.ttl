@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:dadaist2 a schema1:SoftwareApplication ;
    schema1:alternateName "Command line wrapper to run DADA2 on a set of paired-end reads" ;
    schema1:citation "doi:10.3390/ijms22105309" ;
    schema1:description "Command line wrapper to run DADA2 on a set of paired-end reads with several exporting tools to generate plots and numerical ecology analyses" ;
    schema1:identifier biotools:dadaist2 ;
    schema1:license "MIT" ;
    schema1:maintainer "telatin" ;
    schema1:name "dadaist2" ;
    schema1:softwareVersion "1.3.1" ;
    schema1:url "https://quadram-institute-bioscience.github.io/dadaist2" .

