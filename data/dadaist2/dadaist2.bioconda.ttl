@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dadaist2 a schema:SoftwareApplication ;
    schema:author "telatin" ;
    schema:citation "doi:10.3390/ijms22105309" ;
    schema:description "Command line wrapper to run DADA2 on a set of paired-end reads" ;
    schema:downloadUrl "https://github.com/quadram-institute-bioscience/dadaist2/archive/v1.3.1.tar.gz" ;
    schema:identifier biotools:dadaist2 ;
    schema:license "MIT" ;
    schema:maintainer "telatin" ;
    schema:name "dadaist2" ;
    schema:softwareVersion "1.3.1" ;
    schema:url "https://quadram-institute-bioscience.github.io/dadaist2" .

