@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bpipe a schema1:SoftwareApplication ;
    schema1:alternateName "Bpipe - a tool for running and managing bioinformatics pipelines" ;
    schema1:citation "doi:10.1093/bioinformatics/bts167" ;
    schema1:description "Bpipe - a tool for running and managing bioinformatics pipelines" ;
    schema1:identifier <https://bio.tools/biotools:bpipe> ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "bpipe" ;
    schema1:softwareVersion "0.9.13" ;
    schema1:url "http://docs.bpipe.org/" .

