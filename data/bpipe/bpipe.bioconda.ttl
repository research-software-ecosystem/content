@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bpipe a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bts167" ;
    schema:description "Bpipe - a tool for running and managing bioinformatics pipelines" ;
    schema:downloadUrl "https://github.com/ssadedin/bpipe/releases/download/0.9.13/bpipe-0.9.13.tar.gz" ;
    schema:identifier biotools:bpipe ;
    schema:license "BSD-3-Clause" ;
    schema:name "bpipe" ;
    schema:softwareVersion "0.9.13" ;
    schema:url "http://docs.bpipe.org/" .

