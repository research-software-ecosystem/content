@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ratatosk a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-020-02244-4" ;
    schema:description "Hybrid error correction of long reads using colored de Bruijn graphs." ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:ratatosk ;
    schema:license "BSD-2-Clause" ;
    schema:name "ratatosk" ;
    schema:softwareHelp "https://github.com/DecodeGenetics/Ratatosk/blob/v0.9.0/README.md" ;
    schema:softwareVersion "0.9.0" ;
    schema:url "https://github.com/DecodeGenetics/Ratatosk" .

