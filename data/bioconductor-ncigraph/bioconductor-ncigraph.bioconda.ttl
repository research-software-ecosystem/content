@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ncigraph a schema1:SoftwareApplication ;
    schema1:alternateName "Pathways from the NCI Pathways Database" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Provides various methods to load the pathways from the NCI Pathways Database in R graph objects and to re-format them." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/NCIgraph_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NCIgraph/NCIgraph_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/NCIgraph_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ncigraph/bioconductor-ncigraph_1.58.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ncigraph" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-ncigraph" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/NCIgraph.html" .

