@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ncigraph a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Pathways from the NCI Pathways Database" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/NCIgraph_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/NCIgraph/NCIgraph_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/NCIgraph_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ncigraph/bioconductor-ncigraph_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-kegggraph",
        "bioconductor-rbgl",
        "bioconductor-rcy3",
        "r-base",
        "r-r.oo" ;
    schema:identifier biotools:ncigraph ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-ncigraph" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/NCIgraph.html" .

