@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pcaexplorer a schema1:SoftwareApplication ;
    schema1:citation "doi:10.18547/gcb.2017.vol3.iss1.e39" ;
    schema1:description "Interactive Visualization of RNA-seq Data Using a Principal Components Approach" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pcaExplorer_3.4.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pcaExplorer/pcaExplorer_3.4.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pcaExplorer_3.4.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pcaexplorer/bioconductor-pcaexplorer_3.4.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biomart",
        "bioconductor-deseq2",
        "bioconductor-genefilter",
        "bioconductor-genomicranges",
        "bioconductor-go.db",
        "bioconductor-gostats",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-mosdef",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-topgo",
        "r-base",
        "r-base64enc",
        "r-dt",
        "r-ggplot2",
        "r-ggrepel",
        "r-heatmaply",
        "r-knitr",
        "r-nmf",
        "r-pheatmap",
        "r-plotly",
        "r-plyr",
        "r-rmarkdown",
        "r-scales",
        "r-shiny",
        "r-shinyace",
        "r-shinybs",
        "r-shinydashboard",
        "r-threejs",
        "r-tidyr" ;
    schema1:identifier biotools:pcaexplorer ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-pcaexplorer" ;
    schema1:softwareVersion "3.4.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pcaExplorer.html" .

