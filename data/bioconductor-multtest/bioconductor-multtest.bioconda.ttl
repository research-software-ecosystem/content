@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-multtest a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/0-387-29362-0_15" ;
    schema:description "Resampling-based multiple hypothesis testing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/multtest_2.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/multtest/multtest_2.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/multtest_2.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-multtest/bioconductor-multtest_2.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mass",
        "r-survival",
        "zlib" ;
    schema:identifier biotools:multtest ;
    schema:license "LGPL" ;
    schema:name "bioconductor-multtest" ;
    schema:softwareVersion "2.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/multtest.html" .

