@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-epivizrdata a schema1:SoftwareApplication ;
    schema1:alternateName "Data Management API for epiviz interactive visualization app" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Serve data from Bioconductor Objects through a WebSocket connection." ;
    schema1:identifier biotools:epivizrdata ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-epivizrdata" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/epivizrData.html" .

