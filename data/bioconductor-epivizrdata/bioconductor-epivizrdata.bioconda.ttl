@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-epivizrdata a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Data Management API for epiviz interactive visualization app" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/epivizrData_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/epivizrData/epivizrData_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/epivizrData_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epivizrdata/bioconductor-epivizrdata_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-ensembldb",
        "bioconductor-epivizrserver",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-organismdbi",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "r-base" ;
    schema:identifier biotools:epivizrdata ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-epivizrdata" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/epivizrData.html" .

