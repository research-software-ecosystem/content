@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bcbio-nextgen a schema:SoftwareApplication ;
    schema:description "Validated, scalable, community developed variant calling, RNA-seq and small RNA analysis" ;
    schema:downloadUrl "https://github.com/bcbio/bcbio-nextgen/archive/refs/tags/v1.2.9.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:bcbio-nextgen ;
    schema:license "MIT" ;
    schema:name "bcbio-nextgen" ;
    schema:softwareVersion "1.2.9" ;
    schema:url "https://github.com/bcbio/bcbio-nextgen" .

