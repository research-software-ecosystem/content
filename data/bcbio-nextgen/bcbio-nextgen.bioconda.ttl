@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bcbio-nextgen a schema1:SoftwareApplication ;
    schema1:alternateName "Validated, scalable, community developed variant calling, RNA-seq and small RNA analysis" ;
    schema1:description "Validated, scalable, community developed variant calling, RNA-seq and small RNA analysis" ;
    schema1:identifier <https://bio.tools/biotools:bcbio-nextgen> ;
    schema1:license "MIT" ;
    schema1:name "bcbio-nextgen" ;
    schema1:softwareVersion "1.2.9" ;
    schema1:url "https://github.com/bcbio/bcbio-nextgen" .

