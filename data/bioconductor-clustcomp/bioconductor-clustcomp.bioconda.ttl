@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clustcomp a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Clustering Comparison Package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/clustComp_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clustComp/clustComp_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clustComp_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clustcomp/bioconductor-clustcomp_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-sm" ;
    schema:identifier biotools:clustcomp ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-clustcomp" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/clustComp.html" .

