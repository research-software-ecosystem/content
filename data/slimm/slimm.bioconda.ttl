@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:slimm a schema:SoftwareApplication ;
    schema:author "temehi" ;
    schema:citation "doi:10.7717/peerj.3138" ;
    schema:description "SLIMM - Species Level Identification of Microbes from Metagenomes" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:slimm ;
    schema:license "https://github.com/seqan/slimm/blob/master/LICENSE" ;
    schema:maintainer "temehi" ;
    schema:name "slimm" ;
    schema:softwareVersion "0.3.4" ;
    schema:url "https://github.com/seqan/slimm/blob/master/README.md" .

