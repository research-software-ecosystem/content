@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:slimm a schema1:SoftwareApplication ;
    schema1:alternateName "SLIMM - Species Level Identification of Microbes from Metagenomes" ;
    schema1:citation "doi:10.7717/peerj.3138" ;
    schema1:description "SLIMM - Species Level Identification of Microbes from Metagenomes" ;
    schema1:license "https://github.com/seqan/slimm/blob/master/LICENSE" ;
    schema1:maintainer "temehi" ;
    schema1:name "slimm" ;
    schema1:softwareVersion "0.3.4" ;
    schema1:url "https://github.com/seqan/slimm/blob/master/README.md" .

