@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trtools a schema:SoftwareApplication ;
    schema:author "LiterallyUniqueLogin",
        "aryarm" ;
    schema:citation "doi:10.1093/bioinformatics/btaa736" ;
    schema:description "Toolkit for genome-wide analysis of tandem repeats." ;
    schema:downloadUrl "https://pypi.org/packages/source/t/trtools/trtools-6.1.0.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "python" ;
    schema:identifier biotools:trtools ;
    schema:license "MIT" ;
    schema:maintainer "LiterallyUniqueLogin",
        "aryarm" ;
    schema:name "trtools" ;
    schema:softwareHelp "https://trtools.readthedocs.io" ;
    schema:softwareVersion "6.1.0" ;
    schema:url "https://github.com/gymreklab/TRTools" .

