      "sc:citation": {
        "@id": "https://doi.org/10.64898/2026.05.08.723876"
      },
      "sc:description": "MucOneUp is a specialized simulation framework designed for generating MUC1 Variable Number Tandem Repeat (VNTR) reference sequences. It simulates targeted variants and generates platform-specific sequencing reads (Illumina, Nanopore, PacBio) for systematic benchmarking of variant detection tools.",
      "sc:featureList": {
        "@id": "edam:operation_0265"
      },
