@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bti310",
        "doi:10.1093/bioinformatics/btq057" ;
    schema:description "Genomic mapping and alignment program for mRNA and EST sequences." ;
    schema:downloadUrl "http://research-pub.gene.com/gmap/src/gmap-gsnap-2025-07-31.tar.gz" ;
    schema:hasPart "bzip2",
        "perl",
        "zlib" ;
    schema:identifier biotools:gmap ;
    schema:license "Apache-2.0" ;
    schema:name "gmap" ;
    schema:softwareHelp "http://research-pub.gene.com/gmap" ;
    schema:softwareVersion "2025.07.31" ;
    schema:url "http://research-pub.gene.com/gmap" .

