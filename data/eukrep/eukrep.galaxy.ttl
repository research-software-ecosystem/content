@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:eukrep a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "txt" ;
    schema1:applicationSubCategory edam:topic_3174 ;
    schema1:codeRepository "https://github.com/patrickwest/EukRep" ;
    schema1:dateCreated "2025-07-30" ;
    schema1:description "Classification of Eukaryotic and Prokaryotic sequences from metagenomic datasets" ;
    schema1:encodingFormat "fasta",
        "txt" ;
    schema1:featureList edam:operation_2478,
        edam:topic_0640 ;
    schema1:identifier biotools:eukrep,
        bioconda:eukrep ;
    schema1:keywords "Metagenomics" ;
    schema1:name "eukrep" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/eukrep" .

