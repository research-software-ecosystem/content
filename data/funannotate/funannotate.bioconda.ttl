@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:funannotate a schema:SoftwareApplication ;
    schema:author "nextgenusfs" ;
    schema:citation "doi:10.5281/zenodo.1134477" ;
    schema:description "funannotate: eukaryotic genome annotation pipeline." ;
    schema:downloadUrl "https://pypi.org/packages/source/f/funannotate/funannotate-1.8.17.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:funannotate ;
    schema:license "BSD-2-Clause" ;
    schema:maintainer "nextgenusfs" ;
    schema:name "funannotate" ;
    schema:softwareHelp "https://funannotate.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.8.17" ;
    schema:url "https://github.com/nextgenusfs/funannotate" .

