    schema:identifier biotools:tophat-recondition ;
    schema:license "BSD-2-Clause" ;
    schema:maintainer "cbrueffer" ;
    schema:name "tophat-recondition" ;
    schema:softwareVersion "1.4" ;
    schema:url "https://github.com/cbrueffer/tophat-recondition" .

