@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:krakenuniq a schema:SoftwareApplication ;
    schema:description "Metagenomics classifier with unique k-mer counting for more specific results" ;
    schema:downloadUrl "https://github.com/fbreitwieser/krakenuniq/archive/v1.0.4.tar.gz" ;
    schema:hasPart "bzip2",
        "perl",
        "zlib" ;
    schema:identifier biotools:krakenhll ;
    schema:license "GPLv3" ;
    schema:name "krakenuniq" ;
    schema:softwareVersion "1.0.4" ;
    schema:url "https://github.com/fbreitwieser/krakenuniq" .

