@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seqtk a schema:SoftwareApplication ;
    schema:description "Seqtk is a fast and lightweight tool for processing sequences in the FASTA or FASTQ format." ;
    schema:downloadUrl "https://github.com/lh3/seqtk/archive/v1.5.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:seqtk ;
    schema:license "MIT" ;
    schema:name "seqtk" ;
    schema:softwareHelp "https://github.com/lh3/seqtk/blob/v1.5/README.md" ;
    schema:softwareVersion "1.5" ;
    schema:url "https://github.com/lh3/seqtk" .

