@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:seqtk a schema1:SoftwareApplication ;
    schema1:alternateName "Seqtk is a fast and lightweight tool for processing sequences in the FASTA or FASTQ format." ;
    schema1:description "Seqtk is a fast and lightweight tool for processing sequences in the FASTA or FASTQ format." ;
    schema1:identifier <https://bio.tools/biotools:seqtk>,
        "usegalaxy-eu:seqtk_comp",
        "usegalaxy-eu:seqtk_cutN",
        "usegalaxy-eu:seqtk_dropse",
        "usegalaxy-eu:seqtk_fqchk",
        "usegalaxy-eu:seqtk_hety",
        "usegalaxy-eu:seqtk_listhet",
        "usegalaxy-eu:seqtk_mergefa",
        "usegalaxy-eu:seqtk_mergepe",
        "usegalaxy-eu:seqtk_mutfa",
        "usegalaxy-eu:seqtk_randbase",
        "usegalaxy-eu:seqtk_sample",
        "usegalaxy-eu:seqtk_seq",
        "usegalaxy-eu:seqtk_subseq",
        "usegalaxy-eu:seqtk_telo",
        "usegalaxy-eu:seqtk_trimfq" ;
    schema1:license "MIT" ;
    schema1:name "seqtk" ;
    schema1:softwareVersion "1.5" ;
    schema1:url "https://github.com/lh3/seqtk" .

