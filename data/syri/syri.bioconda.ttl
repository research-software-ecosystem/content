@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:syri a schema:SoftwareApplication ;
    schema:author "mnshgl0110" ;
    schema:citation "doi:10.1186/s13059-019-1911-0" ;
    schema:description "Synteny and rearrangement identifier between whole-genome assemblies." ;
    schema:downloadUrl "https://github.com/schneebergerlab/syri/archive/refs/tags/v1.7.1.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:SyRI ;
    schema:license "MIT" ;
    schema:maintainer "mnshgl0110" ;
    schema:name "syri" ;
    schema:softwareHelp "https://schneebergerlab.github.io/syri" ;
    schema:softwareVersion "1.7.1" ;
    schema:url "https://github.com/schneebergerlab/syri" .

