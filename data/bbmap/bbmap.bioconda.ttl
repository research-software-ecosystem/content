@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bbmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0185056" ;
    schema:description "BBMap is a short read aligner, as well as various other bioinformatic tools." ;
    schema:downloadUrl "https://downloads.sourceforge.net/project/bbmap/BBMap_39.81b.tar.gz" ;
    schema:hasPart "bzip2",
        "openjdk",
        "patchelf",
        "pbzip2",
        "samtools" ;
    schema:identifier biotools:bbmap ;
    schema:license "BSD-3-Clause-LBNL" ;
    schema:name "bbmap" ;
    schema:softwareHelp "https://bbmap.org" ;
    schema:softwareVersion "39.81" ;
    schema:url "https://sourceforge.net/projects/bbmap" .

