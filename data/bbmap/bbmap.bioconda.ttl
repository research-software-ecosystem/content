@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bbmap a schema1:SoftwareApplication ;
    schema1:alternateName "BBMap is a short read aligner, as well as various other bioinformatic tools." ;
    schema1:citation "doi:10.1371/journal.pone.0185056" ;
    schema1:description "BBMap is a short read aligner, as well as various other bioinformatic tools." ;
    schema1:identifier <https://bio.tools/biotools:bbmap>,
        "usegalaxy-eu:bbtools_bbduk",
        "usegalaxy-eu:bbtools_bbmap",
        "usegalaxy-eu:bbtools_bbmerge",
        "usegalaxy-eu:bbtools_bbnorm",
        "usegalaxy-eu:bbtools_callvariants",
        "usegalaxy-eu:bbtools_tadpole" ;
    schema1:license "BSD-3-Clause-LBNL" ;
    schema1:name "bbmap" ;
    schema1:softwareVersion "40.02" ;
    schema1:url "https://github.com/bbushnell/BBTools" .

