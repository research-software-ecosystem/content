@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:idba a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-642-12683-3_28" ;
    schema:description "IDBA is a practical iterative De Bruijn Graph De Novo Assembler for sequence assembly in bioinformatics." ;
    schema:downloadUrl "https://github.com/loneknightpy/idba/archive/1.1.3.tar.gz" ;
    schema:hasPart "gawk",
        "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:idba ;
    schema:license "GPL2" ;
    schema:name "idba" ;
    schema:softwareHelp "https://i.cs.hku.hk/~alse/hkubrg/projects/idba_ud" ;
    schema:softwareVersion "1.1.3" ;
    schema:url "https://i.cs.hku.hk/~alse/hkubrg/projects/idba_ud" .

