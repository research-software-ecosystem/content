@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-methylkit a schema:SoftwareApplication ;
    schema:description "DNA methylation analysis from high-throughput bisulfite sequencing results" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/methylKit_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methylKit/methylKit_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/methylKit_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylkit/bioconductor-methylkit_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-fastseg",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-qvalue",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-emdbook",
        "r-gtools",
        "r-kernsmooth",
        "r-mclust",
        "r-mgcv",
        "r-r.utils",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:methylkit ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-methylkit" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/methylKit.html" .

