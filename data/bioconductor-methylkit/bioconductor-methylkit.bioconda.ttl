@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-methylkit a schema1:SoftwareApplication ;
    schema1:alternateName "DNA methylation analysis from high-throughput bisulfite sequencing results" ;
    schema1:description "methylKit is an R package for DNA methylation analysis and annotation from high-throughput bisulfite sequencing. The package is designed to deal with sequencing data from RRBS and its variants, but also target-capture methods and whole genome bisulfite sequencing. It also has functions to analyze base-pair resolution 5hmC data from experimental protocols such as oxBS-Seq and TAB-Seq. Methylation calling can be performed directly from Bismark aligned BAM files." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/methylKit_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methylKit/methylKit_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/methylKit_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylkit/bioconductor-methylkit_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:methylkit" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-methylkit" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/methylKit.html" .

