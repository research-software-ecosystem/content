@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seqbuster a schema:SoftwareApplication ;
    schema:description "miRNA and isomiR annotation" ;
    schema:downloadUrl "https://github.com/lpantano/seqbuster/archive/miraligner-3.5.tar.gz" ;
    schema:identifier biotools:seqbuster ;
    schema:license "MIT" ;
    schema:name "seqbuster" ;
    schema:softwareVersion "3.5" ;
    schema:url "https://github.com/lpantano/seqbuster" .

