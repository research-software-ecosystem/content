@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowpeaks a schema1:SoftwareApplication ;
    schema1:alternateName "An R package for flow data clustering" ;
    schema1:description "A fast and automatic clustering to classify the cells into subpopulations based on finding the peaks from the overall density function generated by K-means." ;
    schema1:identifier <https://bio.tools/biotools:flowpeaks> ;
    schema1:license "Artistic-1.0" ;
    schema1:name "bioconductor-flowpeaks" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowPeaks.html" .

