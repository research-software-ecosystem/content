@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowpeaks a schema1:SoftwareApplication ;
    schema1:description "An R package for flow data clustering" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/flowPeaks_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowPeaks/flowPeaks_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowPeaks_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowpeaks/bioconductor-flowpeaks_1.56.0_src_all.tar.gz" ;
    schema1:hasPart "gsl",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:flowpeaks ;
    schema1:license "Artistic-1.0" ;
    schema1:name "bioconductor-flowpeaks" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowPeaks.html" .

