@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:quicktree a schema:SoftwareApplication ;
    schema:description "Fast implementation of the neighbour-joining phylogenetic inference method." ;
    schema:downloadUrl "https://github.com/khowe/quicktree/archive/v2.5.tar.gz" ;
    schema:identifier biotools:quicktree ;
    schema:license "Apache-2.0" ;
    schema:name "quicktree" ;
    schema:softwareVersion "2.5" ;
    schema:url "https://github.com/khowe/quicktree" .

