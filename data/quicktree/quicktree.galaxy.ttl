@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:quicktree a schema1:SoftwareApplication ;
    bioschemas:output "newick" ;
    schema1:applicationSubCategory edam:topic_3293 ;
    schema1:codeRepository <https://github.com/khowe/quicktree> ;
    schema1:dateCreated "2024-11-21" ;
    schema1:description "neighbour-joining phylogenetic inference" ;
    schema1:encodingFormat "newick" ;
    schema1:featureList edam:operation_0540 ;
    schema1:identifier biotools:quicktree,
        bioconda:quicktree ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.be>,
        <https://usegalaxy.eu>,
        <https://workflowhub.eu/workflows/1650?version=1> ;
    schema1:keywords "Phylogenetics" ;
    schema1:name "quicktree" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/quicktree> .

<https://galaxytrakr.org> a schema1:WebSite .

<https://usegalaxy.be> a schema1:WebSite .

