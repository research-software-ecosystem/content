@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-regsplice a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "L1-regularization based methods for detection of differential splicing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/regsplice_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/regsplice/regsplice_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/regsplice_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-regsplice/bioconductor-regsplice_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-edger",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-glmnet",
        "r-pbapply" ;
    schema:identifier biotools:regsplice ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-regsplice" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/regsplice.html" .

