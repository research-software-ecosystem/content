@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-regsplice a schema1:SoftwareApplication ;
    schema1:alternateName "L1-regularization based methods for detection of differential splicing" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Statistical methods for detection of differential splicing (differential exon usage) in RNA-seq and exon microarray data, using L1-regularization (lasso) to improve power." ;
    schema1:identifier biotools:regsplice ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-regsplice" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/regsplice.html" .

