@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chromstar a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/038612" ;
    schema:description "Combinatorial and Differential Chromatin State Analysis for ChIP-Seq Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/chromstaR_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/chromstaR/chromstaR_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/chromstaR_1.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chromstar/bioconductor-chromstar_1.28.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-bamsignals",
        "bioconductor-biocgenerics",
        "bioconductor-chromstardata",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "r-base",
        "r-doparallel",
        "r-foreach",
        "r-ggplot2",
        "r-mvtnorm",
        "r-reshape2" ;
    schema:identifier biotools:chromstar ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-chromstar" ;
    schema:softwareVersion "1.28.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/chromstaR.html" .

