@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:fgmp a schema1:SoftwareApplication ;
    schema1:alternateName "FGMP: assessing fungal genome completeness and gene content." ;
    schema1:citation "doi:10.1101/049619" ;
    schema1:description "FGMP: assessing fungal genome completeness and gene content." ;
    schema1:identifier <https://bio.tools/biotools:fgmp> ;
    schema1:license "MIT" ;
    schema1:name "fgmp" ;
    schema1:softwareVersion "1.0.3" ;
    schema1:url "https://github.com/stajichlab/FGMP" .

