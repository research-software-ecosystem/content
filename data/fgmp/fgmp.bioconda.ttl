@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fgmp a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/049619" ;
    schema:description "FGMP: assessing fungal genome completeness and gene content." ;
    schema:downloadUrl "https://github.com/stajichlab/FGMP/archive/ed86439.tar.gz" ;
    schema:hasPart "augustus",
        "blast",
        "emboss",
        "exonerate",
        "hmmer",
        "perl",
        "perl-bioperl",
        "perl-ipc-run" ;
    schema:identifier biotools:fgmp ;
    schema:license "MIT" ;
    schema:name "fgmp" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/stajichlab/FGMP" .

