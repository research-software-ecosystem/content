@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ichip a schema1:SoftwareApplication ;
    schema1:alternateName "Bayesian Modeling of ChIP-chip Data Through Hidden Ising Models" ;
    schema1:citation "doi:10.1093/bioinformatics/btq032" ;
    schema1:description "Hidden Ising models are implemented to identify enriched genomic regions in ChIP-chip data.  They can be used to analyze the data from multiple platforms (e.g., Affymetrix, Agilent, and NimbleGen), and the data with single to multiple replicates." ;
    schema1:identifier <https://bio.tools/biotools:ichip> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-ichip" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/iChip.html" .

