@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ichip a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btq032" ;
    schema:description "Bayesian Modeling of ChIP-chip Data Through Hidden Ising Models" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/iChip_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iChip/iChip_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iChip_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ichip/bioconductor-ichip_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:ichip ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-ichip" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/iChip.html" .

