@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rgsepd a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene Set Enrichment / Projection Displays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rgsepd_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rgsepd/rgsepd_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rgsepd_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgsepd/bioconductor-rgsepd_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biomart",
        "bioconductor-deseq2",
        "bioconductor-go.db",
        "bioconductor-goseq",
        "bioconductor-org.hs.eg.db",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-gplots" ;
    schema:identifier biotools:rgsepd ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-rgsepd" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rgsepd.html" .

