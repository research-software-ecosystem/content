@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgsepd a schema1:SoftwareApplication ;
    schema1:alternateName "Gene Set Enrichment / Projection Displays" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "R/GSEPD is a bioinformatics package for R to help disambiguate transcriptome samples (a matrix of RNA-Seq counts at transcript IDs) by automating differential expression (with DESeq2), then gene set enrichment (with GOSeq), and finally a N-dimensional projection to quantify in which ways each sample is like either treatment group." ;
    schema1:identifier <https://bio.tools/biotools:rgsepd> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-rgsepd" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rgsepd.html" .

