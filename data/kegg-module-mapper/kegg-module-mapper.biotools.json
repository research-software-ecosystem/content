        {
          "term": "Metabolic pathway prediction",
          "uri": "http://edamontology.org/operation_3929"
        }
      ],
      "output": [
        {
          "data": {
            "term": "KEGG object identifier",
            "uri": "http://edamontology.org/data_1154"
