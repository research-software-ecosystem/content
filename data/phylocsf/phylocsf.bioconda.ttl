@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phylocsf a schema:SoftwareApplication ;
    schema:description "Phylogenetic analysis of multi-species genome sequence alignments to identify conserved protein-coding regions" ;
    schema:downloadUrl "https://github.com/RomainFeron/PhyloCSF/archive/1.0.1-conda.tar.gz" ;
    schema:hasPart "glpk",
        "gsl",
        "ocaml" ;
    schema:identifier biotools:phyloCSF ;
    schema:license "AGPL-3.0" ;
    schema:name "phylocsf" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "https://github.com/mlin/PhyloCSF/wiki" .

