@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-affycontam a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "structured corruption of affymetrix cel file data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/affyContam_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affyContam/affyContam_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affyContam_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affycontam/bioconductor-affycontam_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affydata",
        "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:affycontam ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-affycontam" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/affyContam.html" .

