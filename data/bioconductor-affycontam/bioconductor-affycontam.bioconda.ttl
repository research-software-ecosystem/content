@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affycontam a schema1:SoftwareApplication ;
    schema1:alternateName "structured corruption of affymetrix cel file data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "structured corruption of cel file data to demonstrate QA effectiveness" ;
    schema1:identifier biotools:affycontam ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-affycontam" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affyContam.html" .

