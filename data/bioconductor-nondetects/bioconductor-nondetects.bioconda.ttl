@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-nondetects a schema1:SoftwareApplication ;
    schema1:alternateName "Non-detects in qPCR data" ;
    schema1:description "Methods to model and impute non-detects in the results of qPCR experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/nondetects_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nondetects/nondetects_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/nondetects_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-nondetects/bioconductor-nondetects_2.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:nondetects" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-nondetects" ;
    schema1:softwareVersion "2.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/nondetects.html" .

