@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-nondetects a schema:SoftwareApplication ;
    schema:description "Non-detects in qPCR data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/nondetects_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nondetects/nondetects_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/nondetects_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-nondetects/bioconductor-nondetects_2.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-htqpcr",
        "bioconductor-limma",
        "r-arm",
        "r-base",
        "r-mvtnorm" ;
    schema:identifier biotools:nondetects ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-nondetects" ;
    schema:softwareVersion "2.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/nondetects.html" .

