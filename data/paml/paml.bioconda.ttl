@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:paml a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/13.5.555" ;
    schema:description "A package of programs for phylogenetic analyses of DNA or protein sequences using maximum likelihood." ;
    schema:downloadUrl "https://github.com/abacus-gene/paml/archive/refs/tags/v4.10.10.tar.gz" ;
    schema:hasPart "tar",
        "wget" ;
    schema:identifier biotools:paml ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "paml" ;
    schema:softwareHelp "https://github.com/abacus-gene/paml/wiki" ;
    schema:softwareVersion "4.10.10" ;
    schema:url "https://evomics.org/resources/software/molecular-evolution-software/paml" .

