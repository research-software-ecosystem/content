@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:poretools a schema1:SoftwareApplication ;
    bioschemas:output "fastq",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0654,
        edam:topic_3168 ;
    schema1:codeRepository <https://poretools.readthedocs.io/en/latest/> ;
    schema1:dateCreated "2017-12-17" ;
    schema1:description "A flexible toolkit for exploring datasets generated by nanopore sequencing devices from MinION for the purposes of quality control and downstream analysis." ;
    schema1:encodingFormat "fastq",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_2478,
        edam:topic_0640 ;
    schema1:identifier biotools:poretools,
        bioconda:poretools ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Fasta Manipulation",
        "Fastq Manipulation" ;
    schema1:name "poretools" ;
    schema1:softwareVersion "0.6.1a1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/poretools> .

<https://usegalaxy.cz> a schema1:WebSite .

