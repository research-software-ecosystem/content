@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:consent a schema:SoftwareApplication ;
    schema:author "natir" ;
    schema:citation "doi:10.1038/s41598-020-80757-5" ;
    schema:description "Scalable long read self-correction and assembly polishing with multiple sequence alignment." ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:consent-correct ;
    schema:license "AGPL-3.0-or-later" ;
    schema:maintainer "natir" ;
    schema:name "consent" ;
    schema:softwareHelp "https://github.com/morispi/CONSENT/blob/v2.2.2/README.md" ;
    schema:softwareVersion "2.2.2" ;
    schema:url "https://github.com/morispi/CONSENT" .

