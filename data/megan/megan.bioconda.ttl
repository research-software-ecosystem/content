@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:megan a schema1:SoftwareApplication ;
    schema1:alternateName "A tool for studying the taxonomic content of a set of DNA reads" ;
    schema1:description "A tool for studying the taxonomic content of a set of DNA reads" ;
    schema1:identifier biotools:megan ;
    schema1:license "GPL >=3" ;
    schema1:name "megan" ;
    schema1:softwareVersion "6.25.10" ;
    schema1:url "https://megan.cs.uni-tuebingen.de/" .

