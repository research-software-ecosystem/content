@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:megan a schema:SoftwareApplication ;
    schema:description "A tool for studying the taxonomic content of a set of DNA reads" ;
    schema:hasPart "openjdk" ;
    schema:identifier biotools:megan ;
    schema:license "GPL >=3" ;
    schema:name "megan" ;
    schema:softwareVersion "6.25.10" ;
    schema:url "https://megan.cs.uni-tuebingen.de/" .

