@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:perl-dbd-mysql a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkm964" ;
    schema:description "A MySQL driver for the Perl5 Database Interface (DBI)." ;
    schema:downloadUrl "https://cpan.metacpan.org/authors/id/D/DV/DVEEDEN/DBD-mysql-5.013.tar.gz" ;
    schema:hasPart "mysql",
        "mysql-common",
        "mysql-libs",
        "openssl",
        "perl",
        "perl-data-dumper",
        "perl-dbi",
        "perl-devel-checklib",
        "perl-extutils-makemaker",
        "perl-test-deep",
        "perl-test-simple",
        "perl-time-hires",
        "zlib",
        "zstd" ;
    schema:identifier biotools:dbd ;
    schema:license "Perl_5" ;
    schema:name "perl-dbd-mysql" ;
    schema:softwareHelp "https://dbi.perl.org" ;
    schema:softwareVersion "5.013" ;
    schema:url "https://dbi.perl.org" .

