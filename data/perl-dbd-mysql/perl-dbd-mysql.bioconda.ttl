@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:perl-dbd-mysql a schema1:SoftwareApplication ;
    schema1:alternateName "A MySQL driver for the Perl5 Database Interface (DBI)." ;
    schema1:citation "doi:10.1093/nar/gkm964" ;
