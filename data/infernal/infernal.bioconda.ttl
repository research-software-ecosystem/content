@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:infernal a schema1:SoftwareApplication ;
    schema1:alternateName "Infernal is for searching DNA sequence databases for RNA structure and sequence similarities." ;
    schema1:citation "doi:10.1093/bioinformatics/btt509" ;
    schema1:description "Infernal (INFERence of RNA ALignment) is for searching DNA sequence databases for RNA structure and sequence similarities." ;
    schema1:downloadUrl "http://eddylab.org/infernal/infernal-1.1.5.tar.gz" ;
    schema1:identifier "biotools:infernal" ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "infernal" ;
    schema1:softwareVersion "1.1.5" ;
    schema1:url "http://eddylab.org/infernal" .

