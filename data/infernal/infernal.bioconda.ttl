@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:infernal a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt509" ;
    schema:description "Infernal is for searching DNA sequence databases for RNA structure and sequence similarities." ;
    schema:downloadUrl "http://eddylab.org/infernal/infernal-1.1.5.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "perl",
        "wget" ;
    schema:identifier biotools:infernal ;
    schema:license "BSD-3-Clause" ;
    schema:name "infernal" ;
    schema:softwareHelp "http://eddylab.org/infernal/Userguide.pdf" ;
    schema:softwareVersion "1.1.5" ;
    schema:url "http://eddylab.org/infernal" .

