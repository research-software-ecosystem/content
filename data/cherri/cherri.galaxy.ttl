        edam:topic_0081,
        edam:topic_0602,
        edam:topic_3474 ;
    schema1:codeRepository <https://github.com/BackofenLab/Cherri> ;
    schema1:dateCreated "2022-12-09" ;
    schema1:description "Computational Help Evaluating RNA-RNA interactions" ;
    schema1:encodingFormat "csv",
        "tgz" ;
    schema1:identifier biotools:cherri,
        bioconda:cherri ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu> ;
    schema1:keywords "RNA",
        "Transcriptomics" ;
    schema1:name "cherri" ;
    schema1:softwareVersion "0.7" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/cherri> .

