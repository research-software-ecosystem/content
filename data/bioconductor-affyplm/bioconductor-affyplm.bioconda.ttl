@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affyplm a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for fitting probe-level models" ;
    schema1:description "A package that extends and improves the functionality of the base affy package. Routines that make heavy use of compiled code for speed. Central focus is on implementation of methods for fitting probe-level models and tools using these models. PLM based quality assessment tools." ;
    schema1:identifier biotools:affyplm ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-affyplm" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affyPLM.html" .

