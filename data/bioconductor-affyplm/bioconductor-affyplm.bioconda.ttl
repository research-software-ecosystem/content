@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affyplm a schema1:SoftwareApplication ;
    schema1:description "Methods for fitting probe-level models" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/affyPLM_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affyPLM/affyPLM_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affyPLM_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affyplm/bioconductor-affyplm_1.86.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-gcrma",
        "bioconductor-preprocesscore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:affyplm ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-affyplm" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affyPLM.html" .

