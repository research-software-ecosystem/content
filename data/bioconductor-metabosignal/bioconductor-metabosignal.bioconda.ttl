@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-metabosignal a schema:SoftwareApplication ;
    schema:description "MetaboSignal: a network-based approach to overlay and explore metabolic and signaling KEGG pathways" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MetaboSignal_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MetaboSignal/MetaboSignal_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MetaboSignal_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metabosignal/bioconductor-metabosignal_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biomart",
        "bioconductor-ensdb.hsapiens.v75",
        "bioconductor-hpar",
        "bioconductor-kegggraph",
        "bioconductor-keggrest",
        "bioconductor-mwastools",
        "bioconductor-mygene",
        "bioconductor-org.hs.eg.db",
        "r-base",
        "r-igraph",
        "r-rcurl" ;
    schema:identifier biotools:metabosignal ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-metabosignal" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MetaboSignal.html" .

