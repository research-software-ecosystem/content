@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:samblaster a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu314" ;
    schema:description "Mark duplicates in and extract discordant and split reads from SAM files." ;
    schema:downloadUrl "https://github.com/GregoryFaust/samblaster/releases/download/v.0.1.26/samblaster-v.0.1.26.tar.gz" ;
    schema:identifier biotools:samblaster ;
    schema:license "MIT" ;
    schema:name "samblaster" ;
    schema:softwareHelp "https://github.com/GregoryFaust/samblaster/blob/v.0.1.26/README.md" ;
    schema:softwareVersion "0.1.26" ;
    schema:url "https://github.com/GregoryFaust/samblaster" .

