@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:samblaster a schema1:SoftwareApplication ;
    bioschemas:output "bam",
        "fastqsanger" ;
    schema1:applicationSubCategory edam:operation_2429,
        edam:topic_0102,
        edam:topic_0654,
        edam:topic_3168 ;
    schema1:codeRepository "https://github.com/GregoryFaust/samblaster" ;
    schema1:dateCreated "2016-12-18" ;
    schema1:description "samblaster marks duplicates and can output split and discordant alignments from SAM/BAM files" ;
    schema1:encodingFormat "bam",
        "fastqsanger" ;
    schema1:featureList edam:operation_3199 ;
    schema1:identifier biotools:samblaster,
        bioconda:samblaster ;
    schema1:keywords "Fastq Manipulation",
        "SAM",
        "Variant Analysis" ;
    schema1:name "samblaster" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/samblaster" .

