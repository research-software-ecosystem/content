@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:argnorm a schema1:SoftwareApplication ;
    bioschemas:output "tsv" ;
    schema1:codeRepository "https://github.com/BigDataBiology/argNorm" ;
    schema1:dateCreated "2024-08-28" ;
    schema1:description "argNorm is a tool to normalize antibiotic resistance genes (ARGs) by mapping them to the antibiotic resistance ontology (ARO) created by the CARD database" ;
    schema1:encodingFormat "tsv" ;
    schema1:featureList edam:operation_3672 ;
    schema1:identifier biotools:argnorm,
        bioconda:argnorm ;
    schema1:isPartOf <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/2024?version=4>,
        <https://workflowhub.eu/workflows/2068?version=2> ;
    schema1:keywords "Genome annotation" ;
    schema1:name "argnorm" ;
    schema1:softwareVersion "@VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/argnorm" .

<https://workflowhub.eu> a schema1:WebSite .

