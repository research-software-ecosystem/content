@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-grohmm a schema:SoftwareApplication ;
    schema:description "GRO-seq Analysis Pipeline" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/groHMM_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/groHMM/groHMM_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/groHMM_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-grohmm/bioconductor-grohmm_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mass",
        "zlib" ;
    schema:identifier biotools:grohmm ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-grohmm" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/groHMM.html" .

