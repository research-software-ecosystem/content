@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-grohmm a schema1:SoftwareApplication ;
    schema1:alternateName "GRO-seq Analysis Pipeline" ;
    schema1:description "A pipeline for the analysis of GRO-seq data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/groHMM_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/groHMM/groHMM_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/groHMM_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-grohmm/bioconductor-grohmm_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:grohmm" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-grohmm" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/groHMM.html" .

