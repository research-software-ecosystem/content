@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:pear a schema1:SoftwareApplication ;
    schema1:alternateName "Paired-End reAd mergeR" ;
    schema1:description "Paired-End reAd mergeR" ;
    schema1:identifier biotools:PEAR ;
    schema1:license "CC-BY-NC-SA-3.0" ;
    schema1:name "pear" ;
    schema1:softwareVersion "0.9.11" ;
    schema1:url "https://sco.h-its.org/exelixis/web/software/pear/" .

