@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bufet a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-017-1812-8" ;
    schema:description "Tool that performs the unbiased miRNA functional enrichment analysis (Bleazard et al.) requiring significantly reduced excution times (less than 10 minutes for 1 million iterations)." ;
    schema:downloadUrl "https://github.com/diwis/BUFET/archive/f8bdc647b63326dabc3eb4b100995397acef7e6a.zip" ;
    schema:hasPart "python" ;
    schema:identifier biotools:BUFET ;
    schema:license "file" ;
    schema:name "bufet" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://github.com/diwis/BUFET/" .

