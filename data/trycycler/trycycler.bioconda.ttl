@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:trycycler a schema1:SoftwareApplication ;
    schema1:alternateName "Trycycler is a tool for generating consensus long-read assemblies for bacterial genomes." ;
    schema1:citation "doi:10.1186/s13059-021-02483-z" ;
    schema1:description "Trycycler is a tool for generating consensus long-read assemblies for bacterial genomes." ;
    schema1:identifier <https://bio.tools/biotools:trycycler>,
        "usegalaxy-eu:trycycler_cluster",
        "usegalaxy-eu:trycycler_consensus",
        "usegalaxy-eu:trycycler_partition",
        "usegalaxy-eu:trycycler_reconcile_msa",
        "usegalaxy-eu:trycycler_subsample" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "galladoalba",
        "thanhleviet" ;
    schema1:name "trycycler" ;
    schema1:softwareVersion "0.5.6" ;
    schema1:url "https://github.com/rrwick/Trycycler" .

