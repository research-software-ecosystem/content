@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trycycler a schema:SoftwareApplication ;
    schema:author "galladoalba",
        "thanhleviet" ;
    schema:citation "doi:10.1186/s13059-021-02483-z" ;
    schema:description "Trycycler is a tool for generating consensus long-read assemblies for bacterial genomes." ;
    schema:downloadUrl "https://github.com/rrwick/Trycycler/archive/v0.5.6.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:trycycler ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "galladoalba",
        "thanhleviet" ;
    schema:name "trycycler" ;
    schema:softwareHelp "https://github.com/rrwick/Trycycler/wiki" ;
    schema:softwareVersion "0.5.6" ;
    schema:url "https://github.com/rrwick/Trycycler" .

