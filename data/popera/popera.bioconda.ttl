@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:popera a schema:SoftwareApplication ;
    schema:description "A software for DNase I hypersensitive sites identification." ;
    schema:downloadUrl "https://github.com/forrestzhang/Popera/archive/1.0.3.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:popera ;
    schema:license "MIT" ;
    schema:name "popera" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/forrestzhang/Popera" .

