@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gmapr a schema1:SoftwareApplication ;
    schema1:description "An R interface to the GMAP/GSNAP/GSTRUCT suite" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/gmapR_1.51.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gmapR/gmapR_1.51.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gmapR_1.51.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gmapr/bioconductor-gmapr_1.51.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocio",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-variantannotation",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:gmapr ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gmapr" ;
    schema1:softwareVersion "1.51.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gmapR.html" .

