@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gmapr a schema1:SoftwareApplication ;
    schema1:alternateName "An R interface to the GMAP/GSNAP/GSTRUCT suite" ;
    schema1:description "GSNAP and GMAP are a pair of tools to align short-read data written by Tom Wu.  This package provides convenience methods to work with GMAP and GSNAP from within R. In addition, it provides methods to tally alignment results on a per-nucleotide basis using the bam_tally tool." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/gmapR_1.51.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gmapR/gmapR_1.51.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gmapR_1.51.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gmapr/bioconductor-gmapr_1.51.1_src_all.tar.gz" ;
    schema1:identifier "biotools:gmapr" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gmapr" ;
    schema1:softwareVersion "1.51.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gmapR.html" .

