@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cnorfuzzy a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1752-0509-6-133" ;
    schema:description "Addon to CellNOptR: Fuzzy Logic" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CNORfuzzy_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CNORfuzzy/CNORfuzzy_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CNORfuzzy_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cnorfuzzy/bioconductor-cnorfuzzy_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-cellnoptr",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-nloptr",
        "zlib" ;
    schema:identifier biotools:cnorfuzzy ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-cnorfuzzy" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CNORfuzzy.html" .

