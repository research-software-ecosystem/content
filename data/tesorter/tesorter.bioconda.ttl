@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tesorter a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/hr/uhac017" ;
    schema:description "Lineage-level classification of transposable elements using conserved protein domains." ;
    schema:downloadUrl "https://github.com/zhangrengang/TEsorter/archive/refs/tags/v1.5.1.tar.gz" ;
    schema:hasPart "hmmer",
        "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:TEsorter ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "tesorter" ;
    schema:softwareHelp "https://github.com/zhangrengang/TEsorter/blob/v1.5.1/README.md" ;
    schema:softwareVersion "1.5.1" ;
    schema:url "https://github.com/zhangrengang/TEsorter" .

