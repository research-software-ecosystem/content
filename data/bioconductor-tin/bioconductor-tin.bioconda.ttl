@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-tin a schema:SoftwareApplication ;
    schema:citation "doi:10.4137/CIN.S31363" ;
    schema:description "Transcriptome instability analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/TIN_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TIN/TIN_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TIN_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tin/bioconductor-tin_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-impute",
        "r-aroma.affymetrix",
        "r-base",
        "r-data.table",
        "r-squash",
        "r-stringr",
        "r-wgcna" ;
    schema:identifier biotools:tin ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-tin" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/TIN.html" .

