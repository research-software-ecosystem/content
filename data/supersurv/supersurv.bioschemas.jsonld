      "sc:citation": {
        "@id": "https://doi.org/10.64898/2026.03.11.711010"
      },
      "sc:description": "SuperSurv is an R package that provides a unified framework for building, evaluating, and interpreting ensemble machine learning models for right-censored survival data. It implements techniques like stacking and integrates interpretability tools such as SHAP values and Restricted Mean Survival Time (RMST) contrasts.",
      "sc:featureList": {
        "@id": "edam:operation_3503"
      },
      "sc:license": "MIT",
      "sc:name": "SuperSurv: Unified Framework for Machine Learning Ensembles in Survival Analysis",
      "sc:url": "https://CRAN.R-project.org/package=SuperSurv"
    }
  ]
