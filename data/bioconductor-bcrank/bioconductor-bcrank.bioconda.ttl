@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bcrank a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/nar/gkp381" ;
    schema1:description "Predicting binding site consensus from ranked DNA sequences" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BCRANK_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BCRANK/BCRANK_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BCRANK_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bcrank/bioconductor-bcrank_1.72.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:bcrank ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-bcrank" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BCRANK.html" .

