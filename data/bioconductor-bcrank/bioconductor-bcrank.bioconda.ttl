@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bcrank a schema1:SoftwareApplication ;
    schema1:alternateName "Predicting binding site consensus from ranked DNA sequences" ;
    schema1:citation "doi:10.1093/nar/gkp381" ;
    schema1:description "Functions and classes for de novo prediction of transcription factor binding consensus by heuristic search" ;
    schema1:identifier <https://bio.tools/biotools:bcrank> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-bcrank" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BCRANK.html" .

