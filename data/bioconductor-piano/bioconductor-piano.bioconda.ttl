@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-piano a schema1:SoftwareApplication ;
    schema1:description "Platform for integrative analysis of omics data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/piano_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/piano/piano_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/piano_2.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-piano/bioconductor-piano_2.26.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-fgsea",
        "bioconductor-marray",
        "r-base",
        "r-dt",
        "r-gplots",
        "r-htmlwidgets",
        "r-igraph",
        "r-relations",
        "r-scales",
        "r-shiny",
        "r-shinydashboard",
        "r-shinyjs",
        "r-visnetwork" ;
    schema1:identifier biotools:piano ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-piano" ;
    schema1:softwareVersion "2.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/piano.html" .

