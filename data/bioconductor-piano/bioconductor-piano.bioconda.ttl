@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-piano a schema1:SoftwareApplication ;
    schema1:alternateName "Platform for integrative analysis of omics data" ;
    schema1:description "Piano performs gene set analysis using various statistical methods, from different gene level statistics and a wide range of gene-set collections. Furthermore, the Piano package contains functions for combining the results of multiple runs of gene set analyses." ;
    schema1:identifier <https://bio.tools/biotools:piano> ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-piano" ;
    schema1:softwareVersion "2.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/piano.html" .

