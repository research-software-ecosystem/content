@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-asgsca a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/gepi.21872" ;
    schema:description "Association Studies for multiple SNPs and multiple traits using Generalized Structured Equation Models" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ASGSCA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ASGSCA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASGSCA/ASGSCA_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-asgsca/bioconductor-asgsca_1.44.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mass",
        "r-matrix" ;
    schema:identifier biotools:asgsca ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-asgsca" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ASGSCA.html" .

