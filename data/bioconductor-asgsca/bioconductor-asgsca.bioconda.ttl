@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-asgsca a schema1:SoftwareApplication ;
    schema1:alternateName "Association Studies for multiple SNPs and multiple traits using Generalized Structured Equation Models" ;
    schema1:citation "doi:10.1002/gepi.21872" ;
    schema1:description "The package provides tools to model and test the association between multiple genotypes and multiple traits, taking into account the prior biological knowledge. Genes, and clinical pathways are incorporated in the model as latent variables. The method is based on Generalized Structured Component Analysis (GSCA)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ASGSCA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ASGSCA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASGSCA/ASGSCA_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-asgsca/bioconductor-asgsca_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:asgsca" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-asgsca" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ASGSCA.html" .

