@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ucsc-bigwigtowig a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bib/bbs038" ;
    schema:description "Convert bigWig to wig. This will keep more of the same structure of the original wig than bigWigToBedGraph does, but still will break up large stepped sections into smaller ones." ;
    schema:downloadUrl "https://hgdownload.cse.ucsc.edu/admin/exe/userApps.archive/userApps.v482.src.tgz" ;
    schema:hasPart "bzip2",
        "clangdev",
        "libiconv",
        "liblzma-devel",
        "libopenssl-static",
        "libpng",
        "libuuid",
        "mariadb-connector-c",
        "mysql-connector-c",
        "rsync",
        "zlib" ;
    schema:identifier biotools:UCSC_Genome_Browser_Utilities ;
    schema:license "Varies; see https://genome.ucsc.edu/license" ;
    schema:name "ucsc-bigwigtowig" ;
    schema:softwareHelp "https://github.com/ucscGenomeBrowser/kent/blob/v482_base/README" ;
    schema:softwareVersion "482" ;
    schema:url "https://hgdownload.cse.ucsc.edu/admin/exe" .

