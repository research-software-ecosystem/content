@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:arriba a schema1:SoftwareApplication ;
    schema1:alternateName "Fast and accurate gene fusion detection from RNA-Seq data." ;
    schema1:citation "doi:10.1101/gr.257246.119" ;
    schema1:description "Fast and accurate gene fusion detection from RNA-Seq data." ;
    schema1:identifier biotools:Arriba,
        "usegalaxy-eu:arriba",
        "usegalaxy-eu:arriba_draw_fusions",
        "usegalaxy-eu:arriba_get_filters" ;
    schema1:license "MIT" ;
    schema1:name "arriba" ;
    schema1:softwareVersion "2.5.1" ;
    schema1:url "https://github.com/suhrig/arriba" .

