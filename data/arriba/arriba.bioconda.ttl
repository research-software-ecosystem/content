@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:arriba a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.257246.119" ;
    schema:description "Fast and accurate gene fusion detection from RNA-Seq data." ;
    schema:downloadUrl "https://github.com/suhrig/arriba/releases/download/v2.5.1/arriba_v2.5.1.tar.gz" ;
    schema:hasPart "bzip2",
        "htslib",
        "libdeflate",
        "wget",
        "xz",
        "zlib" ;
    schema:identifier biotools:Arriba ;
    schema:license "MIT" ;
    schema:name "arriba" ;
    schema:softwareHelp "https://github.com/suhrig/arriba/wiki/01-Home" ;
    schema:softwareVersion "2.5.1" ;
    schema:url "https://github.com/suhrig/arriba" .

