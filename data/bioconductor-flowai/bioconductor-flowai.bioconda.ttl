@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowai a schema1:SoftwareApplication ;
    schema1:alternateName "Automatic and interactive quality control for flow cytometry data" ;
    schema1:citation "doi:10.1093/bioinformatics/btw191" ;
    schema1:description "The package is able to perform an automatic or interactive quality control on FCS data acquired using flow cytometry instruments. By evaluating three different properties: 1) flow rate, 2) signal acquisition, 3) dynamic range, the quality control enables the detection and removal of anomalies." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/flowAI_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowAI/flowAI_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowAI_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowai/bioconductor-flowai_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:flowai" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-flowai" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowAI.html" .

