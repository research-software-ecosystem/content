@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-xmapbridge a schema:SoftwareApplication ;
    schema:description "Export plotting files to the xmapBridge for visualisation in X:Map" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/xmapbridge_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/xmapbridge/xmapbridge_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/xmapbridge_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-xmapbridge/bioconductor-xmapbridge_1.68.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:xmapbridge ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-xmapbridge" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/xmapbridge.html" .

