@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-xmapbridge a schema1:SoftwareApplication ;
    schema1:alternateName "Export plotting files to the xmapBridge for visualisation in X:Map" ;
    schema1:description "xmapBridge can plot graphs in the X:Map genome browser. This package exports plotting files in a suitable format." ;
    schema1:identifier biotools:xmapbridge ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-xmapbridge" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/xmapbridge.html" .

