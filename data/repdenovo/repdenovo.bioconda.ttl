@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:repdenovo a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0150719" ;
    schema:description "REPdenovo is designed for constructing repeats directly from sequence reads." ;
    schema:downloadUrl "https://github.com/simoncchu/REPdenovo/archive/refs/tags/v0.1.0.tar.gz" ;
    schema:hasPart "bamtools",
        "zlib" ;
    schema:identifier biotools:repdenovo ;
    schema:license "MIT" ;
    schema:name "repdenovo" ;
    schema:softwareHelp "https://github.com/simoncchu/REPdenovo/blob/v0.1.0/README.md" ;
    schema:softwareVersion "0.1.0" ;
    schema:url "https://github.com/Reedwarbler/REPdenovo" .

