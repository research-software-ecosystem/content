@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-tximport a schema1:SoftwareApplication ;
    schema1:author "roryk" ;
    schema1:description "Import and summarize transcript-level estimates for transcript- and gene-level analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/tximport_1.38.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/tximport/tximport_1.38.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/tximport_1.38.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tximport/bioconductor-tximport_1.38.2_src_all.tar.gz" ;
    schema1:hasPart "r-base" ;
    schema1:identifier biotools:tximport ;
    schema1:license "LGPL (>=2)" ;
    schema1:maintainer "roryk" ;
    schema1:name "bioconductor-tximport" ;
    schema1:softwareVersion "1.38.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/tximport.html" .

