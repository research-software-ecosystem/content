@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-tximport a schema:SoftwareApplication ;
    schema:author "roryk" ;
    schema:description "Import and summarize transcript-level estimates for transcript- and gene-level analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/tximport_1.38.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/tximport/tximport_1.38.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/tximport_1.38.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tximport/bioconductor-tximport_1.38.2_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:tximport ;
    schema:license "LGPL (>=2)" ;
    schema:maintainer "roryk" ;
    schema:name "bioconductor-tximport" ;
    schema:softwareVersion "1.38.2" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/tximport.html" .

