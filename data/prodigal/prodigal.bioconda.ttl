@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:prodigal a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-11-119" ;
    schema:description "Prodigal (Prokaryotic Dynamic Programming Genefinding Algorithm) is a microbial (bacterial and archaeal) gene finding program." ;
    schema:downloadUrl "https://github.com/hyattpd/Prodigal/archive/v2.6.3.zip" ;
    schema:hasPart "unzip",
        "zlib" ;
    schema:identifier biotools:prodigal ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "prodigal" ;
    schema:softwareHelp "https://github.com/hyattpd/Prodigal/wiki" ;
    schema:softwareVersion "2.6.3" ;
    schema:url "https://github.com/hyattpd/Prodigal" .

