@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:migmap a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:topic_0080 ;
    schema1:codeRepository <https://github.com/mikessh/migmap> ;
    schema1:dateCreated "2017-09-28" ;
    schema1:description "mapper for full-length T- and B-cell repertoire sequencing" ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_2403,
        edam:operation_3198,
        edam:topic_0080 ;
    schema1:identifier biotools:MiGMAP,
        bioconda:migmap ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org> ;
    schema1:keywords "RNA",
        "Sequence Analysis" ;
    schema1:name "migmap" ;
    schema1:softwareVersion "@TOOL_VERSION@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/migmap> .

<https://usegalaxy.be> a schema1:WebSite .

<https://usegalaxy.cz> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.no> a schema1:WebSite .

<https://usegalaxy.org> a schema1:WebSite .

