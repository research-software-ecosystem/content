@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-beadarraysnp a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm311" ;
    schema:description "Normalization and reporting of Illumina SNP bead arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/beadarraySNP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/beadarraySNP/beadarraySNP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/beadarraySNP_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beadarraysnp/bioconductor-beadarraysnp_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-quantsmooth",
        "r-base" ;
    schema:identifier biotools:beadarraysnp ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-beadarraysnp" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/beadarraySNP.html" .

