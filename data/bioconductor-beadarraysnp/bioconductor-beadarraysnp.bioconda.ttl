@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-beadarraysnp a schema1:SoftwareApplication ;
    schema1:alternateName "Normalization and reporting of Illumina SNP bead arrays" ;
    schema1:citation "doi:10.1093/bioinformatics/btm311" ;
    schema1:description "Importing data from Illumina SNP experiments and performing copy number calculations and reports." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/beadarraySNP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/beadarraySNP/beadarraySNP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/beadarraySNP_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beadarraysnp/bioconductor-beadarraysnp_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:beadarraysnp" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-beadarraysnp" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/beadarraySNP.html" .

