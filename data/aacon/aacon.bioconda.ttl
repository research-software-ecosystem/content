@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:aacon a schema:SoftwareApplication ;
    schema:description "AACon: A Fast Amino Acid Conservation Calculation Service" ;
    schema:downloadUrl "https://github.com/bartongroup/aacon/releases/download/v1.1/compbio-conservation-1.1.jar" ;
    schema:identifier biotools:aacon ;
    schema:license "Apache-2.0" ;
    schema:name "aacon" ;
    schema:softwareVersion "1.1" ;
    schema:url "https://www.compbio.dundee.ac.uk/aacon/" .

