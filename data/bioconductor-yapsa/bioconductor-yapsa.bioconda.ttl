@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-yapsa a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Yet Another Package for Signature Analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/YAPSA_1.36.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/YAPSA/YAPSA_1.36.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/YAPSA_1.36.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-yapsa/bioconductor-yapsa_1.36.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome.hsapiens.ucsc.hg19",
        "bioconductor-complexheatmap",
        "bioconductor-genomicranges",
        "bioconductor-gtrellis",
        "bioconductor-keggrest",
        "bioconductor-seqinfo",
        "bioconductor-somaticsignatures",
        "bioconductor-variantannotation",
        "r-base",
        "r-circlize",
        "r-corrplot",
        "r-dendextend",
        "r-doparallel",
        "r-dplyr",
        "r-getoptlong",
        "r-ggbeeswarm",
        "r-ggplot2",
        "r-gridextra",
        "r-limsolve",
        "r-magrittr",
        "r-pmcmrplus",
        "r-pracma",
        "r-reshape2" ;
    schema1:identifier biotools:yapsa ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-yapsa" ;
    schema1:softwareVersion "1.36.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/YAPSA.html" .

