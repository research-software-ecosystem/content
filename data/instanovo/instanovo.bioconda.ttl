@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:instanovo a schema:SoftwareApplication ;
    schema:author "BioGeek" ;
    schema:citation "doi:10.1038/s42256-025-01019-5" ;
    schema:description "InstaNovo enables diffusion-powered de novo peptide sequencing in large scale proteomics experiments." ;
    schema:downloadUrl "https://pypi.org/packages/source/i/instanovo/instanovo-1.2.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:instanovo ;
    schema:license "Apache-2.0" ;
    schema:maintainer "BioGeek" ;
    schema:name "instanovo" ;
    schema:softwareHelp "https://instadeepai.github.io/InstaNovo/" ;
    schema:softwareVersion "1.2.2" ;
    schema:url "https://github.com/instadeepai/instanovo" .

