@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-seqarray a schema:SoftwareApplication ;
    schema:description "Data management of large-scale whole-genome sequence variant calls using GDS files" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SeqArray_1.50.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SeqArray/SeqArray_1.50.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SeqArray_1.50.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-seqarray/bioconductor-seqarray_1.50.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-gdsfmt",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-digest",
        "zlib" ;
    schema:identifier biotools:seqarray ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-seqarray" ;
    schema:softwareVersion "1.50.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SeqArray.html" .

