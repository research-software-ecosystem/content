@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-seqarray a schema1:SoftwareApplication ;
    schema1:alternateName "Data management of large-scale whole-genome sequence variant calls using GDS files" ;
    schema1:description "Data management of large-scale whole-genome sequencing variant calls with thousands of individuals: genotypic data (e.g., SNVs, indels and structural variation calls) and annotations in SeqArray GDS files are stored in an array-oriented and compressed manner, with efficient data access using the R programming language." ;
    schema1:identifier <https://bio.tools/biotools:seqarray> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-seqarray" ;
    schema1:softwareVersion "1.50.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SeqArray.html" .

