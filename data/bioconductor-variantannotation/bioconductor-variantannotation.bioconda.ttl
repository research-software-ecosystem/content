@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-variantannotation a schema1:SoftwareApplication ;
    schema1:alternateName "Annotation of Genetic Variants" ;
    schema1:description "Annotate variants, compute amino acid coding changes, predict coding outcomes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/VariantAnnotation_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/VariantAnnotation/VariantAnnotation_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/VariantAnnotation_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-variantannotation/bioconductor-variantannotation_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:variantannotation" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-variantannotation" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/VariantAnnotation.html" .

