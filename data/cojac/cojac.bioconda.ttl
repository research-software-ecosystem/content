@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cojac a schema:SoftwareApplication ;
    schema:author "DrYak" ;
    schema:citation "doi:10.1038/s41564-022-01185-x" ;
    schema:description "Command-line tools to analyse co-occurrence of mutations on amplicons." ;
    schema:downloadUrl "https://github.com/cbg-ethz/cojac/archive/v0.9.3.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "poetry-dynamic-versioning",
        "python" ;
    schema:identifier biotools:cojac ;
    schema:license "GNU General Public License v3 or later (GPLv3+)" ;
    schema:maintainer "DrYak" ;
    schema:name "cojac" ;
    schema:softwareVersion "0.9.3" ;
    schema:url "https://github.com/cbg-ethz/cojac" .

