@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-vegamc a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/bts453" ;
    schema1:description "VegaMC: A Package Implementing a Variational Piecewise Smooth Model for Identification of Driver Chromosomal Imbalances in Cancer" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/VegaMC_3.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/VegaMC/VegaMC_3.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/VegaMC_3.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-vegamc/bioconductor-vegamc_3.48.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biomart",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:vegamc ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-vegamc" ;
    schema1:softwareVersion "3.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/VegaMC.html" .

