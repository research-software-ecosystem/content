@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ivas a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of genetic Variants affecting Alternative Splicing" ;
    schema1:citation "doi:10.1007/s13258-016-0466-7" ;
    schema1:description "Identification of genetic variants affecting alternative splicing." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/IVAS_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IVAS/IVAS_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/IVAS_2.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ivas/bioconductor-ivas_2.30.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ivas" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ivas" ;
    schema1:softwareVersion "2.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/IVAS.html" .

