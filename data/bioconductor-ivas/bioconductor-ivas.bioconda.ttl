@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ivas a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/s13258-016-0466-7" ;
    schema:description "Identification of genetic Variants affecting Alternative Splicing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/IVAS_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IVAS/IVAS_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/IVAS_2.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ivas/bioconductor-ivas_2.30.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-doparallel",
        "r-foreach",
        "r-ggfortify",
        "r-ggplot2",
        "r-lme4",
        "r-matrix" ;
    schema:identifier biotools:ivas ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ivas" ;
    schema:softwareVersion "2.30.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/IVAS.html" .

