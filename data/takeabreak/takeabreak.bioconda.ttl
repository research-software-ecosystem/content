@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:takeabreak a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-319-07953-0_10" ;
    schema:description "tool that can detect inversion breakpoints directly from raw NGS reads, without the need of any reference genome and without de novo assembling the genomes" ;
    schema:downloadUrl "https://github.com/GATB/TakeABreak/releases/download/v1.1.2/TakeABreak-v1.1.2-Source.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:takeabreak ;
    schema:license "GNU Affero General Public License" ;
    schema:name "takeabreak" ;
    schema:softwareVersion "1.1.2" ;
    schema:url "https://colibread.inria.fr/software/takeabreak/" .

