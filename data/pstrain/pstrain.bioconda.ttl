@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pstrain a schema:SoftwareApplication ;
    schema:author "wshuai294" ;
    schema:description "An Iterative Microbial Strains Profiling Algorithm for Shotgun Metagenomic Sequencing Data" ;
    schema:downloadUrl "https://github.com/wshuai294/PStrain/archive/refs/tags/v1.0.3.tar.gz" ;
    schema:identifier biotools:pstrain ;
    schema:license "MIT" ;
    schema:maintainer "wshuai294" ;
    schema:name "pstrain" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/wshuai294/PStrain" .

