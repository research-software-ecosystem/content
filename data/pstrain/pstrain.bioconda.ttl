@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:pstrain a schema1:SoftwareApplication ;
    schema1:alternateName "An Iterative Microbial Strains Profiling Algorithm for Shotgun Metagenomic Sequencing Data" ;
    schema1:description "An Iterative Microbial Strains Profiling Algorithm for Shotgun Metagenomic Sequencing Data" ;
    schema1:identifier <https://bio.tools/biotools:pstrain> ;
    schema1:license "MIT" ;
    schema1:maintainer "wshuai294" ;
    schema1:name "pstrain" ;
    schema1:softwareVersion "1.0.3" ;
    schema1:url "https://github.com/wshuai294/PStrain" .

