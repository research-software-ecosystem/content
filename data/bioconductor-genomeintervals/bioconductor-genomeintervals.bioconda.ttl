@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genomeintervals a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Operations on genomic intervals" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/genomeIntervals_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genomeIntervals/genomeIntervals_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/genomeIntervals_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomeintervals/bioconductor-genomeintervals_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-intervals" ;
    schema:identifier biotools:genomeintervals ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genomeintervals" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/genomeIntervals.html" .

