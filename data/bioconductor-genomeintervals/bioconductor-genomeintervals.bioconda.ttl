@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genomeintervals a schema1:SoftwareApplication ;
    schema1:alternateName "Operations on genomic intervals" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package defines classes for representing genomic intervals and provides functions and methods for working with these. Note: The package provides the basic infrastructure for and is enhanced by the package 'girafe'." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/genomeIntervals_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genomeIntervals/genomeIntervals_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/genomeIntervals_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomeintervals/bioconductor-genomeintervals_1.66.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genomeintervals" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genomeintervals" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/genomeIntervals.html" .

