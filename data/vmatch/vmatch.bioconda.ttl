@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:vmatch a schema:SoftwareApplication ;
    schema:description "The Vmatch large scale sequence analysis software." ;
    schema:identifier biotools:vmatch ;
    schema:license "Unknown" ;
    schema:name "vmatch" ;
    schema:softwareHelp "http://www.vmatch.de" ;
    schema:softwareVersion "2.3.1" ;
    schema:url "http://www.vmatch.de" .

