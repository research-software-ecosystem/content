@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:cutadapt a schema1:SoftwareApplication ;
    schema1:alternateName "Trim adapters from high-throughput sequencing reads" ;
    schema1:citation "doi:10.14806/ej.17.1.200" ;
    schema1:description "Trim adapters from high-throughput sequencing reads" ;
    schema1:downloadUrl "https://pypi.org/packages/source/c/cutadapt/cutadapt-5.2.tar.gz" ;
    schema1:identifier "biotools:cutadapt",
        "usegalaxy-eu:cutadapt" ;
    schema1:license "MIT" ;
    schema1:maintainer "marcelm" ;
    schema1:name "cutadapt" ;
    schema1:softwareVersion "5.2" ;
    schema1:url "https://cutadapt.readthedocs.io/" .

