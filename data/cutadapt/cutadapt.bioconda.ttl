@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cutadapt a schema:SoftwareApplication ;
    schema:author "marcelm" ;
    schema:citation "doi:10.14806/ej.17.1.200" ;
    schema:description "Trim adapters from high-throughput sequencing reads" ;
    schema:downloadUrl "https://pypi.org/packages/source/c/cutadapt/cutadapt-5.2.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python",
        "setuptools-scm" ;
    schema:identifier biotools:cutadapt ;
    schema:license "MIT" ;
    schema:maintainer "marcelm" ;
    schema:name "cutadapt" ;
    schema:softwareVersion "5.2" ;
    schema:url "https://cutadapt.readthedocs.io/" .

