@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-messina a schema1:SoftwareApplication ;
    schema1:alternateName "Single-gene classifiers and outlier-resistant detection of differential expression for two-group and survival problems" ;
    schema1:description "Messina is a collection of algorithms for constructing optimally robust single-gene classifiers, and for identifying differential expression in the presence of outliers or unknown sample subgroups.  The methods have application in identifying lead features to develop into clinical tests (both diagnostic and prognostic), and in identifying differential expression when a fraction of samples show unusual patterns of expression." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/messina_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/messina/messina_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/messina_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-messina/bioconductor-messina_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:messina" ;
    schema1:license "EPL (>= 1.0)" ;
    schema1:name "bioconductor-messina" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/messina.html" .

