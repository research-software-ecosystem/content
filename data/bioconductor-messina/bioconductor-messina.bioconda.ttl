@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-messina a schema:SoftwareApplication ;
    schema:description "Single-gene classifiers and outlier-resistant detection of differential expression for two-group and survival problems" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/messina_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/messina/messina_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/messina_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-messina/bioconductor-messina_1.46.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-foreach",
        "r-ggplot2",
        "r-plyr",
        "r-rcpp",
        "r-survival",
        "zlib" ;
    schema:identifier biotools:messina ;
    schema:license "EPL (>= 1.0)" ;
    schema:name "bioconductor-messina" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/messina.html" .

