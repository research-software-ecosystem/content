@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-metcirc a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx159" ;
    schema:description "Navigating mass spectral similarity in high-resolution MS/MS metabolomics data metabolomics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MetCirc_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MetCirc/MetCirc_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MetCirc_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metcirc/bioconductor-metcirc_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-mscoreutils",
        "bioconductor-s4vectors",
        "bioconductor-spectra",
        "r-amap",
        "r-base",
        "r-circlize",
        "r-ggplot2",
        "r-scales",
        "r-shiny" ;
    schema:identifier biotools:metcirc ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-metcirc" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MetCirc.html" .

