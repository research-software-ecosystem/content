@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:clark a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-015-1419-2" ;
    schema:description "Fast, accurate and versatile k-mer based classification system." ;
    schema:downloadUrl "https://github.com/rouni001/CLARK/archive/refs/tags/v1.3.0.0.tar.gz" ;
    schema:identifier biotools:clark ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "clark" ;
    schema:softwareHelp "http://clark.cs.ucr.edu" ;
    schema:softwareVersion "1.3.0.0" ;
    schema:url "https://github.com/rouni001/CLARK" .

