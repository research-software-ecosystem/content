@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:padloc a schema1:SoftwareApplication ;
    schema1:alternateName "Locate antiviral defence systems in prokaryotic genomes" ;
    schema1:description "Locate antiviral defence systems in prokaryotic genomes" ;
    schema1:identifier biotools:padloc ;
    schema1:license "MIT" ;
    schema1:maintainer "leightonpayne",
        "pentamorfico" ;
    schema1:name "padloc" ;
    schema1:softwareVersion "2.0.0" ;
    schema1:url "https://github.com/padlocbio/padloc" .

