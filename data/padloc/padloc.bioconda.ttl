@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:padloc a schema:SoftwareApplication ;
    schema:author "leightonpayne",
        "pentamorfico" ;
    schema:description "Locate antiviral defence systems in prokaryotic genomes" ;
    schema:downloadUrl "https://github.com/padlocbio/padloc/archive/refs/tags/v2.0.0.tar.gz" ;
    schema:identifier biotools:padloc ;
    schema:license "MIT" ;
    schema:maintainer "leightonpayne",
        "pentamorfico" ;
    schema:name "padloc" ;
    schema:softwareVersion "2.0.0" ;
    schema:url "https://github.com/padlocbio/padloc" .

