@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trf a schema:SoftwareApplication ;
    schema:description "Tandem Repeats Finder is a program to locate and display tandem repeats in DNA sequences." ;
    schema:downloadUrl "https://github.com/Benson-Genomics-Lab/TRF/archive/v4.10.0-rc.2.tar.gz" ;
    schema:identifier biotools:trf ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "trf" ;
    schema:softwareHelp "https://tandem.bu.edu/trf/trf.html" ;
    schema:softwareVersion "4.10.0rc2" ;
    schema:url "https://tandem.bu.edu/trf/trf.html" .

