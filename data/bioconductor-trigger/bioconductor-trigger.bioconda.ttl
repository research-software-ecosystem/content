@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-trigger a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Transcriptional Regulatory Inference from Genetics of Gene ExpRession" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/trigger_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/trigger/trigger_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/trigger_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-trigger/bioconductor-trigger_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-qvalue",
        "bioconductor-sva",
        "libblas",
        "liblapack",
        "r-base",
        "r-corpcor",
        "r-qtl" ;
    schema:identifier biotools:trigger ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-trigger" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/trigger.html" .

