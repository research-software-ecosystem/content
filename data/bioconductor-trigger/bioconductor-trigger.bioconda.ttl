@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-trigger a schema1:SoftwareApplication ;
    schema1:alternateName "Transcriptional Regulatory Inference from Genetics of Gene ExpRession" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This R package provides tools for the statistical analysis of integrative genomic data that involve some combination of: genotypes, high-dimensional intermediate traits (e.g., gene expression, protein abundance), and higher-order traits (phenotypes). The package includes functions to: (1) construct global linkage maps between genetic markers and gene expression; (2) analyze multiple-locus linkage (epistasis) for gene expression; (3) quantify the proportion of genome-wide variation explained by each locus and identify eQTL hotspots; (4) estimate pair-wise causal gene regulatory probabilities and construct gene regulatory networks; and (5) identify causal genes for a quantitative trait of interest." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/trigger_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/trigger/trigger_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/trigger_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-trigger/bioconductor-trigger_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:trigger" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-trigger" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/trigger.html" .

