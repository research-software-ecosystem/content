@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pickgene a schema1:SoftwareApplication ;
    schema1:alternateName "Adaptive Gene Picking for Microarray Expression Data Analysis" ;
    schema1:citation "doi:10.1007/0-387-21679-0_13" ;
    schema1:description "Functions to Analyze Microarray (Gene Expression) Data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pickgene_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pickgene/pickgene_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pickgene_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pickgene/bioconductor-pickgene_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:pickgene" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-pickgene" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pickgene.html" .

