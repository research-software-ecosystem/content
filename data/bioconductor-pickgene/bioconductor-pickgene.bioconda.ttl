@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pickgene a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/0-387-21679-0_13" ;
    schema:description "Adaptive Gene Picking for Microarray Expression Data Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pickgene_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pickgene/pickgene_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pickgene_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pickgene/bioconductor-pickgene_1.82.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mass" ;
    schema:identifier biotools:pickgene ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-pickgene" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pickgene.html" .

