@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gaga a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1214/09-aoas244" ;
    schema1:description "GaGa hierarchical model for high-throughput data analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/gaga_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gaga/gaga_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gaga_2.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gaga/bioconductor-gaga_2.56.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-ebarrays",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-coda",
        "r-mgcv",
        "zlib" ;
    schema1:identifier biotools:gaga ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-gaga" ;
    schema1:softwareVersion "2.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gaga.html" .

