@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gaga a schema1:SoftwareApplication ;
    schema1:alternateName "GaGa hierarchical model for high-throughput data analysis" ;
    schema1:citation "doi:10.1214/09-aoas244" ;
    schema1:description "Implements the GaGa model for high-throughput data analysis, including differential expression analysis, supervised gene clustering and classification. Additionally, it performs sequential sample size calculations using the GaGa and LNNGV models (the latter from EBarrays package)." ;
    schema1:identifier <https://bio.tools/biotools:gaga> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-gaga" ;
    schema1:softwareVersion "2.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gaga.html" .

