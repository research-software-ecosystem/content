@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:mzspeclib a schema1:SoftwareApplication ;
    bioschemas:output "txt" ;
    schema1:applicationSubCategory edam:topic_0121,
        edam:topic_3172 ;
    schema1:codeRepository <https://github.com/HUPO-PSI/mzspeclib-py> ;
    schema1:dateCreated "2025-06-12" ;
    schema1:description "mzspeclib is a library and set of tools for handling, converting, and validating mass spectral libraries in a standardized format. This suite provides Galaxy wrappers for mzspeclib's core functionalities, including conversion and validation of spectral libraries." ;
    schema1:encodingFormat "txt" ;
    schema1:featureList edam:operation_0336,
        edam:operation_3434 ;
    schema1:identifier biotools:mzspeclib,
        bioconda:mzspeclib ;
    schema1:isPartOf <https://usegalaxy.eu> ;
    schema1:keywords "Metabolomics",
        "Proteomics" ;
    schema1:name "mzspeclib" ;
    schema1:softwareVersion "1.0.7" ;
    schema1:url <https://github.com/RECETOX/galaxytools/tree/main/tools/mzspeclib> .

<https://usegalaxy.eu> a schema1:WebSite .

