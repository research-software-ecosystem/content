@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pmultiqc a schema:SoftwareApplication ;
    schema:author "ypriverol" ;
    schema:description "Python package for quality control of proteomics datasets, based on multiqc package." ;
    schema:downloadUrl "https://pypi.org/packages/source/p/pmultiqc/pmultiqc-0.0.44.tar.gz" ;
    schema:hasPart "hatch-vcs",
        "hatchling",
        "pip",
        "python" ;
    schema:identifier biotools:pmultiqc ;
    schema:license "MIT" ;
    schema:maintainer "ypriverol" ;
    schema:name "pmultiqc" ;
    schema:softwareHelp "https://pmultiqc.quantms.org" ;
    schema:softwareVersion "0.0.44" ;
    schema:url "https://github.com/bigbio/pmultiqc" .

