@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:pmultiqc a schema1:SoftwareApplication ;
    schema1:alternateName "Python package for quality control of proteomics datasets, based on multiqc package." ;
    schema1:description "Python package for quality control of proteomics datasets, based on multiqc package." ;
    schema1:identifier biotools:pmultiqc ;
    schema1:license "MIT" ;
    schema1:maintainer "ypriverol" ;
    schema1:name "pmultiqc" ;
    schema1:softwareVersion "0.0.47" ;
    schema1:url "https://github.com/bigbio/pmultiqc" .

