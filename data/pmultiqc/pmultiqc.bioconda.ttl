    schema1:downloadUrl "https://pypi.org/packages/source/p/pmultiqc/pmultiqc-0.0.46.tar.gz" ;
    schema1:identifier "biotools:pmultiqc" ;
    schema1:license "MIT" ;
    schema1:maintainer "ypriverol" ;
    schema1:name "pmultiqc" ;
    schema1:softwareVersion "0.0.46" ;
    schema1:url "https://github.com/bigbio/pmultiqc" .

