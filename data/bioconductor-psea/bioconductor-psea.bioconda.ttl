@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-psea a schema1:SoftwareApplication ;
    schema1:alternateName "Population-Specific Expression Analysis." ;
    schema1:citation "doi:10.1038/scibx.2011.1159" ;
    schema1:description "Deconvolution of gene expression data by Population-Specific Expression Analysis (PSEA)." ;
    schema1:identifier <https://bio.tools/biotools:psea> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-psea" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/PSEA.html" .

