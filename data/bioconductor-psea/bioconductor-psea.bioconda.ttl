@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-psea a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/scibx.2011.1159" ;
    schema:description "Population-Specific Expression Analysis." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PSEA_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/PSEA/PSEA_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/PSEA_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-psea/bioconductor-psea_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-mass" ;
    schema:identifier biotools:psea ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-psea" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/PSEA.html" .

