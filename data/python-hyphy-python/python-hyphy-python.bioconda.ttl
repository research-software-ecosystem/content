@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:python-hyphy-python a schema:SoftwareApplication ;
    schema:description "HyPhy package interface library" ;
    schema:downloadUrl "https://github.com/veg/hyphy-python/archive/0.1.12.tar.gz" ;
    schema:hasPart "libcurl",
        "libgomp",
        "llvm-openmp",
        "pip",
        "python" ;
    schema:identifier biotools:HyPhy ;
    schema:license "MIT" ;
    schema:name "python-hyphy-python" ;
    schema:softwareVersion "0.1.12" ;
    schema:url "https://github.com/veg/hyphy-python" .

