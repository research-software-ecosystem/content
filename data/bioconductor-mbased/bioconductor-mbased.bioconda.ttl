@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mbased a schema1:SoftwareApplication ;
    schema1:alternateName "Package containing functions for ASE analysis using Meta-analysis Based Allele-Specific Expression Detection" ;
    schema1:citation "doi:10.1186/s13059-014-0405-3" ;
    schema1:description "The package implements MBASED algorithm for detecting allele-specific gene expression from RNA count data, where allele counts at individual loci (SNVs) are integrated into a gene-specific measure of ASE, and utilizes simulations to appropriately assess the statistical significance of observed ASE." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MBASED_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MBASED/MBASED_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MBASED_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mbased/bioconductor-mbased_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mbased" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mbased" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MBASED.html" .

