@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mbased a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-014-0405-3" ;
    schema:description "Package containing functions for ASE analysis using Meta-analysis Based Allele-Specific Expression Detection" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MBASED_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MBASED/MBASED_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MBASED_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mbased/bioconductor-mbased_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-genomicranges",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-runit" ;
    schema:identifier biotools:mbased ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-mbased" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MBASED.html" .

