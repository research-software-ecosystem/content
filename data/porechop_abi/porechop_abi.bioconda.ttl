@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:porechop_abi a schema:SoftwareApplication ;
    schema:description "Adapter inferrence and removal of Oxford Nanopore reads." ;
    schema:downloadUrl "https://github.com/bonsai-team/Porechop_ABI/archive/0bc9f17f31d4ec1dcbab4796871cc09324cc143b.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "networkx",
        "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:porechop_abi ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "porechop_abi" ;
    schema:softwareHelp "https://github.com/bonsai-team/Porechop_ABI/blob/master/README.md" ;
    schema:softwareVersion "0.5.1" ;
    schema:url "https://github.com/bonsai-team/Porechop_ABI" .

