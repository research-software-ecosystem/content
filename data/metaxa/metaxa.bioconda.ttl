@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metaxa a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bty482",
        "doi:10.1111/1755-0998.12399" ;
    schema:description "Improved Identification and Taxonomic Classification of Small and Large Subunit rRNA in Metagenomic Data." ;
    schema:downloadUrl "http://microbiology.se/sw/Metaxa2_2.2.3.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:metaxa ;
    schema:license "GPL-3.0" ;
    schema:name "metaxa" ;
    schema:softwareVersion "2.2.3" ;
    schema:url "http://microbiology.se/software/metaxa2/" .

