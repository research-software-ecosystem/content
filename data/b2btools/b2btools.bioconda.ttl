@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:b2btools a schema:SoftwareApplication ;
    schema:author "agdiaz" ;
    schema:citation "doi:10.1016/j.jmb.2022.167579",
        "doi:10.1038/ncomms3741",
        "doi:10.1038/s41598-017-08366-3",
        "doi:10.1093/bioinformatics/btz274",
        "doi:10.1093/bioinformatics/btz912",
        "doi:10.1093/nar/gkaa391",
        "doi:10.1093/nar/gkab425",
        "doi:10.3389/fmolb.2022.959956" ;
    schema:description "The bio2Byte software suite to predict protein biophysical properties." ;
    schema:downloadUrl "https://pypi.org/packages/source/b/b2btools/b2btools-3.0.8.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "wheel" ;
    schema:identifier biotools:b2btools ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "agdiaz" ;
    schema:name "b2btools" ;
    schema:softwareHelp "https://bio2byte.be/b2btools/package-documentation" ;
