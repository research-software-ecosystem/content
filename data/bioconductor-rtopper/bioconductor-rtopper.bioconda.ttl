@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rtopper a schema1:SoftwareApplication ;
    schema1:alternateName "This package is designed to perform Gene Set Analysis across multiple genomic platforms" ;
    schema1:description "the RTopper package is designed to perform and integrate gene set enrichment results across multiple genomic platforms." ;
    schema1:identifier <https://bio.tools/biotools:rtopper> ;
    schema1:license "GPL (>= 3) + file LICENSE" ;
    schema1:name "bioconductor-rtopper" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RTopper.html" .

