      "sc:citation": {
        "@id": "https://doi.org/10.64898/2026.06.15.732227"
      },
      "sc:description": "novelBGC is a web-hosted, quantitative framework designed to prioritize novel biosynthetic gene clusters (BGCs) by integrating multiple similarity and novelty metrics. It processes large genome mining datasets to guide efforts toward clusters most likely to yield new chemical entities.",
