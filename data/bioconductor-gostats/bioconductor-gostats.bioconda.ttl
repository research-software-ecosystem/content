@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gostats a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for manipulating GO and microarrays" ;
    schema1:description "A set of tools for interacting with GO and microarray data. A variety of basic manipulation tools for graphs, hypothesis testing and other simple calculations." ;
    schema1:identifier biotools:gostats ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gostats" ;
    schema1:softwareVersion "2.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GOstats.html" .

