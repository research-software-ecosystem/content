@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gostats a schema:SoftwareApplication ;
    schema:description "Tools for manipulating GO and microarrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GOstats_2.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GOstats/GOstats_2.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GOstats_2.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gostats/bioconductor-gostats_2.76.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-annotationforge",
        "bioconductor-biobase",
        "bioconductor-category",
        "bioconductor-go.db",
        "bioconductor-graph",
        "bioconductor-rbgl",
        "bioconductor-rgraphviz",
        "r-base" ;
    schema:identifier biotools:gostats ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gostats" ;
    schema:softwareVersion "2.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GOstats.html" .

