@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-codelink a schema1:SoftwareApplication ;
    schema1:alternateName "Manipulation of Codelink microarray data" ;
    schema1:description "This package facilitates reading, preprocessing and manipulating Codelink microarray data. The raw data must be exported as text file using the Codelink software." ;
    schema1:identifier biotools:codelink ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-codelink" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/codelink.html" .

