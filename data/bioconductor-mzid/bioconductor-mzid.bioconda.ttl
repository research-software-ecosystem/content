@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mzid a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "An mzIdentML parser for R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/mzID_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mzID/mzID_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mzID_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mzid/bioconductor-mzid_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-protgenerics",
        "r-base",
        "r-doparallel",
        "r-foreach",
        "r-iterators",
        "r-plyr",
        "r-xml" ;
    schema:identifier biotools:mzid ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-mzid" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/mzID.html" .

