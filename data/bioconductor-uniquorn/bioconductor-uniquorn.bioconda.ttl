@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-uniquorn a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of cancer cell lines based on their weighted mutational/ variational fingerprint" ;
    schema1:citation "doi:10.18632/oncotarget.16110" ;
    schema1:description "'Uniquorn' enables users to identify cancer cell lines. Cancer cell line misidentification and cross-contamination reprents a significant challenge for cancer researchers. The identification is vital and in the frame of this package based on the locations/ loci of somatic and germline mutations/ variations. The input format is vcf/ vcf.gz and the files have to contain a single cancer cell line sample (i.e. a single member/genotype/gt column in the vcf file)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Uniquorn_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Uniquorn/Uniquorn_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Uniquorn_2.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-uniquorn/bioconductor-uniquorn_2.30.0_src_all.tar.gz" ;
    schema1:identifier "biotools:uniquorn" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-uniquorn" ;
    schema1:softwareVersion "2.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Uniquorn.html" .

