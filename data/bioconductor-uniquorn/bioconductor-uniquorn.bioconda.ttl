@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-uniquorn a schema1:SoftwareApplication ;
    schema1:citation "doi:10.18632/oncotarget.16110" ;
    schema1:description "Identification of cancer cell lines based on their weighted mutational/ variational fingerprint" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Uniquorn_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Uniquorn/Uniquorn_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Uniquorn_2.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-uniquorn/bioconductor-uniquorn_2.30.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-variantannotation",
        "r-base",
        "r-data.table",
        "r-doparallel",
        "r-foreach",
        "r-r.utils",
        "r-stringr",
        "r-writexls" ;
    schema1:identifier biotools:uniquorn ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-uniquorn" ;
    schema1:softwareVersion "2.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Uniquorn.html" .

