@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyfastx a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bib/bbaa368" ;
    schema:description "pyfastx is a python module for fast random access to sequences from plain and gzipped FASTA/Q file." ;
    schema:downloadUrl "https://github.com/lmdu/pyfastx/archive/2.3.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:pyfastx ;
    schema:license "MIT" ;
    schema:name "pyfastx" ;
    schema:softwareHelp "https://pyfastx.readthedocs.io/en/latest" ;
    schema:softwareVersion "2.3.1" ;
    schema:url "https://github.com/lmdu/pyfastx" .

