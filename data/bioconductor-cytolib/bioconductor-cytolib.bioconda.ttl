@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cytolib a schema1:SoftwareApplication ;
    schema1:alternateName "C++ infrastructure for representing and interacting with the gated cytometry data" ;
    schema1:description "This package provides the core data structure and API to represent and interact with the gated cytometry data." ;
    schema1:identifier <https://bio.tools/biotools:cytolib> ;
    schema1:license "AGPL-3.0-only" ;
    schema1:name "bioconductor-cytolib" ;
    schema1:softwareVersion "2.22.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cytolib.html" .

