@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cytolib a schema:SoftwareApplication ;
    schema:description "C++ infrastructure for representing and interacting with the gated cytometry data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cytolib_2.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cytolib/cytolib_2.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cytolib_2.22.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cytolib/bioconductor-cytolib_2.22.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rhdf5lib",
        "bioconductor-rprotobuflib",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "zlib" ;
    schema:identifier biotools:cytolib ;
    schema:license "AGPL-3.0-only" ;
    schema:name "bioconductor-cytolib" ;
    schema:softwareVersion "2.22.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cytolib.html" .

