@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-metams a schema1:SoftwareApplication ;
    schema1:description "MS-based metabolomics annotation pipeline" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/metaMS_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/metaMS/metaMS_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/metaMS_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metams/bioconductor-metams_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-camera",
        "bioconductor-xcms",
        "r-base",
        "r-matrix",
        "r-robustbase" ;
    schema1:identifier biotools:metams ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-metams" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/metaMS.html" .

