@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-metams a schema1:SoftwareApplication ;
    schema1:alternateName "MS-based metabolomics annotation pipeline" ;
    schema1:description "MS-based metabolomics data processing and compound annotation pipeline." ;
    schema1:identifier <https://bio.tools/biotools:metams> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-metams" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/metaMS.html" .

