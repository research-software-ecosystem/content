@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtrm a schema:SoftwareApplication ;
    schema:description "Identification of Transcriptional Regulatory Modules from Protein-Protein Interaction Networks" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rTRM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rTRM/rTRM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rTRM_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtrm/bioconductor-rtrm_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "r-base",
        "r-dbi",
        "r-igraph",
        "r-rsqlite" ;
    schema:identifier biotools:rtrm ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-rtrm" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rTRM.html" .

