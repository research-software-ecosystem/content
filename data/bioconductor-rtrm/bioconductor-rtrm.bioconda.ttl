@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rtrm a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of Transcriptional Regulatory Modules from Protein-Protein Interaction Networks" ;
    schema1:description "rTRM identifies transcriptional regulatory modules (TRMs) from protein-protein interaction networks." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rTRM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rTRM/rTRM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rTRM_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtrm/bioconductor-rtrm_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rtrm" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-rtrm" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rTRM.html" .

