@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dnabarcodes a schema:SoftwareApplication ;
    schema:description "A tool for creating and analysing DNA barcodes used in Next Generation Sequencing multiplexing experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DNABarcodes_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DNABarcodes/DNABarcodes_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DNABarcodes_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dnabarcodes/bioconductor-dnabarcodes_1.40.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:dnabarcodes ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-dnabarcodes" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DNABarcodes.html" .

