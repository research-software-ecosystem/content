      "sc:author": {
        "@id": "https://orcid.org/0009-0005-4635-7368"
      },
      "sc:description": "visualmd is a local-first workspace for exploring molecular dynamics simulations. It links an interactive 3D protein viewer (Mol*) to trajectory analyses (RMSD, RMSF, radius of gyration, residue contacts, DCCM, PCA, free-energy landscapes, secondary structure and more), so that features in a plot can be related to the corresponding conformations. Figures, data and portable sessions can be exported, including PNG and MP4. Runs on the user’s own machine, with no data uploaded. Linux x86_64 preview release, free to use but not open source.",
      "sc:isAccessibleForFree": true,
      "sc:license": "Proprietary",
      "sc:name": "visualmd",
      "sc:operatingSystem": "Linux",
      "sc:softwareHelp": {
        "@id": "https://github.com/Eswar-mse/visualmd/blob/main/DOCUMENTATION.md"
      },
      "sc:softwareVersion": "0.2.1-preview",
      "sc:url": "https://visualmd.pages.dev/"
    }
  ]
