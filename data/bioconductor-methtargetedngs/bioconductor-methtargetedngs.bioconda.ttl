@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-methtargetedngs a schema1:SoftwareApplication ;
    schema1:alternateName "Perform Methylation Analysis on Next Generation Sequencing Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Perform step by step methylation analysis of Next Generation Sequencing data." ;
    schema1:identifier biotools:methtargetedngs ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-methtargetedngs" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MethTargetedNGS.html" .

