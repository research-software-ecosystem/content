@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-methtargetedngs a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Perform Methylation Analysis on Next Generation Sequencing Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MethTargetedNGS_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MethTargetedNGS/MethTargetedNGS_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MethTargetedNGS_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methtargetedngs/bioconductor-methtargetedngs_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-pwalign",
        "hmmer",
        "r-base",
        "r-gplots",
        "r-seqinr",
        "r-stringr" ;
    schema:identifier biotools:methtargetedngs ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-methtargetedngs" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MethTargetedNGS.html" .

