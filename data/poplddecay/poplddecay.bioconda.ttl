@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:poplddecay a schema1:SoftwareApplication ;
    schema1:alternateName "PopLDdecay: a fast and effective tool for linkage disequilibrium decay analysis based on variant call format (VCF) files." ;
    schema1:citation "doi:10.1093/bioinformatics/bty875" ;
    schema1:description "PopLDdecay: a fast and effective tool for linkage disequilibrium decay analysis based on variant call format (VCF) files." ;
    schema1:identifier <https://bio.tools/biotools:PopLDdecay> ;
    schema1:license "MIT" ;
    schema1:name "poplddecay" ;
    schema1:softwareVersion "3.45" ;
    schema1:url "https://github.com/BGI-shenzhen/PopLDdecay" .

