@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:poplddecay a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bty875" ;
    schema:description "PopLDdecay: a fast and effective tool for linkage disequilibrium decay analysis based on variant call format (VCF) files." ;
    schema:downloadUrl "https://github.com/BGI-shenzhen/PopLDdecay/archive/refs/tags/v3.43.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:PopLDdecay ;
    schema:license "MIT" ;
    schema:name "poplddecay" ;
    schema:softwareHelp "https://github.com/BGI-shenzhen/PopLDdecay/blob/v3.43/README.md" ;
    schema:softwareVersion "3.43" ;
    schema:url "https://github.com/BGI-shenzhen/PopLDdecay" .

