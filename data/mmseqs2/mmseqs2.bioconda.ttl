@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mmseqs2 a schema:SoftwareApplication ;
    schema:author "milot-mirdita" ;
    schema:citation "doi:10.1038/nbt.3988",
        "doi:10.1038/s41467-018-04964-5",
        "doi:10.1093/bioinformatics/btab184",
        "doi:10.1093/bioinformatics/bty1057",
        "doi:10.1101/2024.11.13.623350v1" ;
    schema:description "MMseqs2: ultra fast and sensitive sequence search and clustering suite" ;
    schema:downloadUrl "https://github.com/soedinglab/mmseqs2/archive/18-8cc5c.tar.gz" ;
    schema:hasPart "bzip2",
        "gawk",
        "zlib" ;
    schema:identifier biotools:mmseqs2 ;
    schema:license "MIT" ;
    schema:maintainer "milot-mirdita" ;
    schema:name "mmseqs2" ;
    schema:softwareVersion "18.8cc5c" ;
    schema:url "https://github.com/soedinglab/mmseqs2" .

