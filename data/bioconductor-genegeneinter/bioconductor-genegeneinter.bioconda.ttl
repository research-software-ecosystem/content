@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genegeneinter a schema1:SoftwareApplication ;
    schema1:description "Tools for Testing Gene-Gene Interaction at the Gene Level" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GeneGeneInteR_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/GeneGeneInteR/GeneGeneInteR_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/GeneGeneInteR_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genegeneinter/bioconductor-genegeneinter_1.32.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-snpstats",
        "libblas",
        "liblapack",
        "r-base",
        "r-data.table",
        "r-factominer",
        "r-igraph",
        "r-kernlab",
        "r-mvtnorm" ;
    schema1:identifier biotools:genegeneinter ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-genegeneinter" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/GeneGeneInteR.html" .

