@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-stategra a schema:SoftwareApplication ;
    schema:citation "doi:10.14806/ej.20.a.768" ;
    schema:description "Classes and methods for multi-omics data integration" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/STATegRa_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/STATegRa/STATegRa_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/STATegRa_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-stategra/bioconductor-stategra_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-edger",
        "bioconductor-limma",
        "r-base",
        "r-calibrate",
        "r-foreach",
        "r-ggplot2",
        "r-gplots",
        "r-gridextra",
        "r-mass" ;
    schema:identifier biotools:stategra ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-stategra" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/STATegRa.html" .

