@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:phylip a schema1:SoftwareApplication ;
    schema1:alternateName "Package of programs for inferring phylogenies." ;
    schema1:description "Package of programs for inferring phylogenies." ;
    schema1:identifier biotools:PHYLIP ;
    schema1:license "BSD" ;
    schema1:name "phylip" ;
    schema1:softwareVersion "3.697" ;
    schema1:url "https://phylipweb.github.io/phylip" .

