@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phylip a schema:SoftwareApplication ;
    schema:description "Package of programs for inferring phylogenies." ;
    schema:downloadUrl "https://phylipweb.github.io/phylip/download/phylip-3.697.tar.gz" ;
    schema:identifier biotools:PHYLIP ;
    schema:license "BSD" ;
    schema:name "phylip" ;
    schema:softwareHelp "https://phylipweb.github.io/phylip" ;
    schema:softwareVersion "3.697" ;
    schema:url "https://phylipweb.github.io/phylip" .

