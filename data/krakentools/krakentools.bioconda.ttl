@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:krakentools a schema1:SoftwareApplication ;
    schema1:alternateName "KrakenTools scripts for analysis of Kraken/KrakenUniq/Kraken2/Bracken results" ;
    schema1:description "KrakenTools scripts for analysis of Kraken/KrakenUniq/Kraken2/Bracken results" ;
    schema1:identifier <https://bio.tools/biotools:krakentools> ;
    schema1:license "GPL-3.0" ;
    schema1:name "krakentools" ;
    schema1:softwareVersion "1.2.1" ;
    schema1:url "https://github.com/jenniferlu717/KrakenTools" .

