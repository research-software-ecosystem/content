@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:krakentools a schema:SoftwareApplication ;
    schema:description "KrakenTools scripts for analysis of Kraken/KrakenUniq/Kraken2/Bracken results" ;
    schema:downloadUrl "https://github.com/jenniferlu717/KrakenTools/archive/v1.2.1.tar.gz" ;
    schema:hasPart "python" ;
    schema:identifier biotools:krakentools ;
    schema:license "GPL-3.0" ;
    schema:name "krakentools" ;
    schema:softwareVersion "1.2.1" ;
    schema:url "https://github.com/jenniferlu717/KrakenTools" .

