@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-methped a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13148-015-0103-3" ;
    schema:description "A DNA methylation classifier tool for the identification of pediatric brain tumor subtypes" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MethPed_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MethPed/MethPed_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MethPed_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methped/bioconductor-methped_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-randomforest" ;
    schema:identifier biotools:methped ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-methped" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MethPed.html" .

