@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rcaspar a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A package for survival time prediction based on a piecewise baseline hazard Cox regression model." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RCASPAR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RCASPAR/RCASPAR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RCASPAR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rcaspar/bioconductor-rcaspar_1.56.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:rcaspar ;
    schema:license "GPL (>=3)" ;
    schema:name "bioconductor-rcaspar" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RCASPAR.html" .

