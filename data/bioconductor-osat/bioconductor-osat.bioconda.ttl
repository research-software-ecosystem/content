@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-osat a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2164-13-689" ;
    schema:description "OSAT: Optimal Sample Assignment Tool" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/OSAT_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OSAT/OSAT_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OSAT_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-osat/bioconductor-osat_1.58.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:osat ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-osat" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/OSAT.html" .

