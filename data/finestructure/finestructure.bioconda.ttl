@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:finestructure a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pgen.1002453" ;
    schema:description "fineSTRUCTURE is a fast and powerful algorithm for identifying population structure using dense sequencing data." ;
    schema:downloadUrl "https://people.maths.bris.ac.uk/~madjl/finestructure/fs_4.1.1.zip" ;
    schema:hasPart "clang",
        "perl",
        "r-ape",
        "r-xml" ;
    schema:identifier biotools:fineSTRUCTURE ;
    schema:license "OTHER" ;
    schema:name "finestructure" ;
    schema:softwareVersion "4.1.1" ;
    schema:url "https://people.maths.bris.ac.uk/~madjl/finestructure/finestructure.html" .

