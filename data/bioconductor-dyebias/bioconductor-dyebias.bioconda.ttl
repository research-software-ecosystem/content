@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dyebias a schema:SoftwareApplication ;
    schema:description "The GASSCO method for correcting for slide-dependent gene-specific dye bias" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/dyebias_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dyebias/dyebias_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dyebias_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dyebias/bioconductor-dyebias_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-marray",
        "r-base" ;
    schema:identifier biotools:dyebias ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-dyebias" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/dyebias.html" .

