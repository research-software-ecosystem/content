@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:inforna a schema:SoftwareApplication ;
    schema:description "A server for the design of RNA sequences that fold into a given pseudo-knot free RNA secondary structure." ;
    schema:downloadUrl "https://github.com/BackofenLab/INFO-RNA/archive/1e9bb8236c13f5861f07dc19625c394aaeae4c79.tar.gz" ;
    schema:hasPart "viennarna" ;
    schema:identifier biotools:inforna ;
    schema:license "MIT-like" ;
    schema:name "inforna" ;
    schema:softwareVersion "2.1.2" ;
    schema:url "https://github.com/BackofenLab/INFO-RNA" .

