@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:hapog a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tsv" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196,
        edam:topic_0622 ;
    schema1:codeRepository <https://github.com/institut-de-genomique/HAPO-G> ;
    schema1:dateCreated "2022-09-16" ;
    schema1:description "Hapo-G - Haplotype-Aware Polishing of Genomes" ;
    schema1:encodingFormat "fasta",
        "tsv" ;
    schema1:featureList edam:operation_0525,
        edam:operation_2425,
        edam:operation_3440 ;
    schema1:identifier biotools:hapog,
        bioconda:hapog ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Assembly" ;
    schema1:name "hapog" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/hapog> .

