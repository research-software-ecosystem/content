@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hapog a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nargab/lqab034" ;
    schema:description "Haplotype-Aware Polishing of Genomes." ;
    schema:downloadUrl "https://github.com/institut-de-genomique/HAPO-G/archive/refs/tags/1.3.8.tar.gz" ;
    schema:hasPart "bzip2",
        "curl",
        "htslib",
        "python",
        "setuptools",
        "xz",
        "zlib" ;
    schema:identifier biotools:hapog ;
    schema:license "CECILL-2.1" ;
    schema:name "hapog" ;
    schema:softwareHelp "https://www.genoscope.cns.fr/hapog" ;
    schema:softwareVersion "1.3.8" ;
    schema:url "https://github.com/institut-de-genomique/HAPO-G" .

