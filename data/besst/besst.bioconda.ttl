@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:besst a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-15-281" ;
    schema:description "Scaffolder for genomic assemblies." ;
    schema:downloadUrl "https://pypi.io/packages/source/B/BESST/BESST-2.2.8.tar.gz" ;
    schema:hasPart "mathstats",
        "networkx",
        "pysam",
        "python",
        "scipy",
        "setuptools" ;
    schema:identifier biotools:besst ;
    schema:license "GPL-3.0" ;
    schema:name "besst" ;
    schema:softwareVersion "2.2.8" ;
    schema:url "https://github.com/ksahlin/BESST" .

