@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bnbc a schema1:SoftwareApplication ;
    schema1:alternateName "Bandwise normalization and batch correction of Hi-C data" ;
    schema1:description "Tools to normalize (several) Hi-C data from replicates." ;
    schema1:identifier biotools:bnbc ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-bnbc" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bnbc.html" .

