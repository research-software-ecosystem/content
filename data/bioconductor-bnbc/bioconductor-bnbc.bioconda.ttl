@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bnbc a schema1:SoftwareApplication ;
    schema1:description "Bandwise normalization and batch correction of Hi-C data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/bnbc_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bnbc/bnbc_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bnbc_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bnbc/bioconductor-bnbc_1.32.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-ebimage",
        "bioconductor-genomicranges",
        "bioconductor-hicbricks",
        "bioconductor-iranges",
        "bioconductor-preprocesscore",
        "bioconductor-rhdf5",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-sva",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-matrixstats",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:bnbc ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-bnbc" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bnbc.html" .

