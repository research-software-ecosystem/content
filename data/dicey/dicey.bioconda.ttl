@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dicey a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-020-6635-8" ;
    schema:description "In-silico PCR and variant primer design." ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "htslib",
        "libdeflate",
        "zlib" ;
    schema:identifier biotools:Gear-Genomics ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "dicey" ;
    schema:softwareHelp "https://github.com/gear-genomics/dicey/blob/v0.3.4/README.md" ;
    schema:softwareVersion "0.3.4" ;
    schema:url "https://github.com/gear-genomics/dicey" .

