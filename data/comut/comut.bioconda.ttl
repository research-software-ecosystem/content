@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:comut a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2020.03.18.997361" ;
    schema:description "A Python library for creating comutation plots to visualize genomic and phenotypic information" ;
    schema:downloadUrl "https://github.com/vanallenlab/comut/archive/v0.0.3.tar.gz" ;
    schema:hasPart "matplotlib-base",
        "numpy",
        "palettable",
        "pandas",
        "pip",
        "python" ;
    schema:identifier biotools:comut ;
    schema:license "MIT" ;
    schema:name "comut" ;
    schema:softwareVersion "0.0.3" ;
    schema:url "https://github.com/vanallenlab/comut" .

