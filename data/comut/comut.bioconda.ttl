@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:comut a schema1:SoftwareApplication ;
    schema1:alternateName "A Python library for creating comutation plots to visualize genomic and phenotypic information" ;
    schema1:citation "doi:10.1101/2020.03.18.997361" ;
    schema1:description "A Python library for creating comutation plots to visualize genomic and phenotypic information" ;
    schema1:identifier <https://bio.tools/biotools:comut> ;
    schema1:license "MIT" ;
    schema1:name "comut" ;
    schema1:softwareVersion "0.0.3" ;
    schema1:url "https://github.com/vanallenlab/comut" .

