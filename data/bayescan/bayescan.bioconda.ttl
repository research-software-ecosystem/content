@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bayescan a schema:SoftwareApplication ;
    schema:citation "doi:10.1534/genetics.108.092221" ;
    schema:description "Phylogenetics - Randomized Axelerated Maximum Likelihood." ;
    schema:downloadUrl "https://cmpg.unibe.ch/software/BayeScan/files/BayeScan2.1.zip" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:bayescan ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "bayescan" ;
    schema:softwareHelp "https://cmpg.unibe.ch/software/BayeScan/files/BayeScan2.1_manual.pdf" ;
    schema:softwareVersion "2.1" ;
    schema:url "https://cmpg.unibe.ch/software/BayeScan" .

