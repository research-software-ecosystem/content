@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rsat-core a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gky317" ;
    schema:description "Regulatory Sequence Analysis Tools (RSAT)" ;
    schema:downloadUrl "https://github.com/rsa-tools/rsat-code/archive/refs/tags/2025.04.04.tar.gz" ;
    schema:identifier biotools:rsat ;
    schema:license "GNU Affero General Public License v3" ;
    schema:name "rsat-core" ;
    schema:softwareVersion "2025.04.04" ;
    schema:url "http://rsat.eu" .

