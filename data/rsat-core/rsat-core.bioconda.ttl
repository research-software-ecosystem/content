@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:rsat-core a schema1:SoftwareApplication ;
    schema1:alternateName "Regulatory Sequence Analysis Tools (RSAT)" ;
    schema1:citation "doi:10.1093/nar/gky317" ;
    schema1:description "Detection and analysis of regulatory signals in non-coding sequences." ;
    schema1:identifier <https://bio.tools/biotools:rsat> ;
    schema1:license "GNU Affero General Public License v3" ;
    schema1:name "rsat-core" ;
    schema1:softwareVersion "2025.04.04" ;
    schema1:url "http://rsat.eu" .

