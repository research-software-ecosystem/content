@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgadem a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1371/journal.pone.0016432" ;
    schema1:description "de novo motif discovery" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rGADEM_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/rGADEM/rGADEM_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/rGADEM_2.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgadem/bioconductor-rgadem_2.54.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-seqlogo",
        "libblas",
        "liblapack",
        "r-base" ;
    schema1:identifier biotools:rgadem ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-rgadem" ;
    schema1:softwareVersion "2.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/rGADEM.html" .

