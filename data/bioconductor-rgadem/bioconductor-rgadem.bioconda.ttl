@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgadem a schema1:SoftwareApplication ;
    schema1:alternateName "de novo motif discovery" ;
    schema1:citation "doi:10.1371/journal.pone.0016432" ;
    schema1:description "rGADEM is an efficient de novo motif discovery tool for large-scale genomic sequence data. It is an open-source R package, which is based on the GADEM software." ;
    schema1:identifier <https://bio.tools/biotools:rgadem> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-rgadem" ;
    schema1:softwareVersion "2.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/rGADEM.html" .

