@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-meshes a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "MeSH Enrichment and Semantic analyses" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/meshes_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/meshes/meshes_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/meshes_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-meshes/bioconductor-meshes_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-annotationhub",
        "bioconductor-dose",
        "bioconductor-enrichplot",
        "bioconductor-gosemsim",
        "bioconductor-meshdbi",
        "r-base",
        "r-yulab.utils" ;
    schema:identifier biotools:meshes ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-meshes" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/meshes.html" .

