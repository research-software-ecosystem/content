@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gtrellis a schema:SoftwareApplication ;
    schema:description "Genome Level Trellis Layout" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/gtrellis_1.42.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gtrellis/gtrellis_1.42.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gtrellis_1.42.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gtrellis/bioconductor-gtrellis_1.42.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicranges",
        "bioconductor-iranges",
        "r-base",
        "r-circlize",
        "r-getoptlong" ;
    schema:identifier biotools:gtrellis ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-gtrellis" ;
    schema:softwareVersion "1.42.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/gtrellis.html" .

