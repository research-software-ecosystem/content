@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gtrellis a schema1:SoftwareApplication ;
    schema1:alternateName "Genome Level Trellis Layout" ;
    schema1:description "Genome level Trellis graph visualizes genomic data conditioned by genomic categories (e.g. chromosomes). For each genomic category, multiple dimensional data which are represented as tracks describe different features from different aspects. This package provides high flexibility to arrange genomic categories and to add self-defined graphics in the plot." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/gtrellis_1.42.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gtrellis/gtrellis_1.42.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gtrellis_1.42.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gtrellis/bioconductor-gtrellis_1.42.1_src_all.tar.gz" ;
    schema1:identifier "biotools:gtrellis" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-gtrellis" ;
    schema1:softwareVersion "1.42.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gtrellis.html" .

