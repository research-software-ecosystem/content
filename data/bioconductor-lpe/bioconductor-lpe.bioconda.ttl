@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lpe a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for analyzing microarray data using Local Pooled Error (LPE) method" ;
    schema1:citation "doi:10.1093/bioinformatics/btg264" ;
    schema1:description "This LPE library is used to do significance analysis of microarray data with small number of replicates. It uses resampling based FDR adjustment, and gives less conservative results than traditional 'BH' or 'BY' procedures. Data accepted is raw data in txt format from MAS4, MAS5 or dChip. Data can also be supplied after normalization. LPE library is primarily used for analyzing data between two conditions. To use it for paired data, see LPEP library. For using LPE in multiple conditions, use HEM library." ;
    schema1:identifier <https://bio.tools/biotools:lpe> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-lpe" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/LPE.html" .

