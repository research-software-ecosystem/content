@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:breakdancer a schema:SoftwareApplication ;
    schema:description "SV detection from paired end reads mapping" ;
    schema:downloadUrl "https://github.com/genome/breakdancer/archive/v1.4.5.tar.gz" ;
    schema:hasPart "ncurses",
        "perl",
        "sed",
        "zlib" ;
    schema:identifier biotools:breakdancer ;
    schema:license "GPLv3" ;
    schema:name "breakdancer" ;
    schema:softwareVersion "1.4.5" ;
    schema:url "https://github.com/genome/breakdancer" .

