@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbgl a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bth458" ;
    schema:description "An interface to the BOOST graph library" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RBGL_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RBGL/RBGL_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RBGL_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbgl/bioconductor-rbgl_1.86.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "zlib" ;
    schema:identifier biotools:rbgl ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-rbgl" ;
    schema:softwareVersion "1.86.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RBGL.html" .

