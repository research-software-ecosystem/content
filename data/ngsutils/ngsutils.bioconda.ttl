@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ngsutils a schema:SoftwareApplication ;
    schema:description "Tools for next-generation sequencing analysis http://ngsutils.org" ;
    schema:downloadUrl "https://github.com/ngsutils/ngsutils/archive/ngsutils-0.5.9.tar.gz" ;
    schema:hasPart "coverage",
        "cython",
        "eta",
        "pip",
        "pysam",
        "python",
        "samtools",
        "swalign" ;
    schema:identifier biotools:ngsutils ;
    schema:license "BSD" ;
    schema:name "ngsutils" ;
    schema:softwareVersion "0.5.9" ;
    schema:url "http://ngsutils.org" .

