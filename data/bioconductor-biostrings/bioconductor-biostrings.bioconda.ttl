@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biostrings a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Efficient manipulation of biological strings" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Biostrings_2.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Biostrings/Biostrings_2.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Biostrings_2.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biostrings/bioconductor-biostrings_2.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-crayon",
        "zlib" ;
    schema:identifier biotools:biostrings ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-biostrings" ;
    schema:softwareVersion "2.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Biostrings.html" .

