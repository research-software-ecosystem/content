@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biostrings a schema1:SoftwareApplication ;
    schema1:alternateName "Efficient manipulation of biological strings" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Memory efficient string containers, string matching algorithms, and other utilities, for fast manipulation of large biological sequences or sets of sequences." ;
    schema1:identifier <https://bio.tools/biotools:biostrings> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biostrings" ;
    schema1:softwareVersion "2.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Biostrings.html" .

