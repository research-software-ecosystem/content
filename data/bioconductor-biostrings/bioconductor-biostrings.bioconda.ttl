@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biostrings a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Efficient manipulation of biological strings" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Biostrings_2.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Biostrings/Biostrings_2.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Biostrings_2.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biostrings/bioconductor-biostrings_2.78.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-crayon",
        "zlib" ;
    schema1:identifier biotools:biostrings ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biostrings" ;
    schema1:softwareVersion "2.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Biostrings.html" .

