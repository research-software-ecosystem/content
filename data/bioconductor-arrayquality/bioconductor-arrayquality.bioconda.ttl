@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-arrayquality a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn647" ;
    schema:description "Assessing array quality on spotted arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/arrayQuality_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/arrayQuality/arrayQuality_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/arrayQuality_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-arrayquality/bioconductor-arrayquality_1.88.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "bioconductor-marray",
        "r-base",
        "r-gridbase",
        "r-hexbin",
        "r-rcolorbrewer" ;
    schema:identifier biotools:arrayquality ;
    schema:license "LGPL" ;
    schema:name "bioconductor-arrayquality" ;
    schema:softwareVersion "1.88.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/arrayQuality.html" .

