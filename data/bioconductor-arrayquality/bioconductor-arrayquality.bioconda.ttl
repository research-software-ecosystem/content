@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-arrayquality a schema1:SoftwareApplication ;
    schema1:alternateName "Assessing array quality on spotted arrays" ;
    schema1:citation "doi:10.1093/bioinformatics/btn647" ;
    schema1:description "Functions for performing print-run and array level quality assessment." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/arrayQuality_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/arrayQuality/arrayQuality_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/arrayQuality_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-arrayquality/bioconductor-arrayquality_1.88.0_src_all.tar.gz" ;
    schema1:identifier "biotools:arrayquality" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-arrayquality" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/arrayQuality.html" .

