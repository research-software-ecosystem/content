@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:raven a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "gfa1" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196,
        edam:topic_0622,
        edam:topic_3673 ;
    schema1:codeRepository "https://github.com/lbcb-sci/raven" ;
    schema1:dateCreated "2020-11-04" ;
    schema1:description "Raven is a de novo genome assembler for long uncorrected reads." ;
    schema1:encodingFormat "fasta",
        "gfa1" ;
    schema1:featureList edam:operation_0524,
        edam:operation_0525,
        edam:operation_3219,
        edam:operation_3440 ;
    schema1:identifier biotools:raven,
        bioconda:raven-assembler ;
    schema1:keywords "Assembly" ;
    schema1:name "raven" ;
    schema1:softwareVersion "1.8.3" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/raven" .

