@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-a4core a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Automated Affymetrix Array Analysis Core Package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/a4Core_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/a4Core/a4Core_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/a4Core_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-a4core/bioconductor-a4core_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-glmnet" ;
    schema:identifier biotools:a4core ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-a4core" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/a4Core.html" .

