@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-a4core a schema1:SoftwareApplication ;
    schema1:alternateName "Automated Affymetrix Array Analysis Core Package" ;
