@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chipcomp a schema1:SoftwareApplication ;
    schema1:alternateName "Quantitative comparison of multiple ChIP-seq datasets" ;
    schema1:description "ChIPComp detects differentially bound sharp binding sites across multiple conditions considering matching control." ;
    schema1:identifier <https://bio.tools/biotools:chipcomp> ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-chipcomp" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPComp.html" .

