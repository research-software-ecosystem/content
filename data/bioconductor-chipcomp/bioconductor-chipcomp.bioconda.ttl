@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chipcomp a schema:SoftwareApplication ;
    schema:description "Quantitative comparison of multiple ChIP-seq datasets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ChIPComp_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPComp/ChIPComp_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPComp_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipcomp/bioconductor-chipcomp_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-bsgenome.hsapiens.ucsc.hg19",
        "bioconductor-bsgenome.mmusculus.ucsc.mm9",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:chipcomp ;
    schema:license "GPL" ;
    schema:name "bioconductor-chipcomp" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPComp.html" .

