@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:matchms a schema:SoftwareApplication ;
    schema:author "hechth",
        "maximskorik" ;
    schema:citation "doi:10.1186/s13321-024-00878-1",
        "doi:10.21105/joss.02411" ;
    schema:description "Python library for fuzzy comparison of mass spectrum data and other Python objects." ;
    schema:downloadUrl "https://pypi.org/packages/source/m/matchms/matchms-0.33.1.tar.gz" ;
    schema:hasPart "pdm-backend",
        "pip",
        "python" ;
    schema:identifier biotools:matchms ;
    schema:license "Apache-2.0" ;
    schema:maintainer "hechth",
        "maximskorik" ;
    schema:name "matchms" ;
    schema:softwareHelp "https://matchms.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.33.1" ;
    schema:url "https://github.com/matchms/matchms" .

