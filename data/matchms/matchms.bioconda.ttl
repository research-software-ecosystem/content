@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:matchms a schema1:SoftwareApplication ;
    schema1:alternateName "Python library for fuzzy comparison of mass spectrum data and other Python objects." ;
