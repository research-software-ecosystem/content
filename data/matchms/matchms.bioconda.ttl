        "doi:10.21105/joss.02411" ;
    schema1:description "Python library for fuzzy comparison of mass spectrum data and other Python objects." ;
    schema1:downloadUrl "https://pypi.org/packages/source/m/matchms/matchms-0.33.1.tar.gz" ;
