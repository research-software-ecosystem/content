@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sights a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1177/1087057114548853" ;
    schema1:description "Statistics and dIagnostic Graphs for HTS" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/sights_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sights/sights_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sights_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sights/bioconductor-sights_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-qvalue",
        "r-base",
        "r-ggplot2",
        "r-lattice",
        "r-mass",
        "r-reshape2" ;
    schema1:identifier biotools:sights ;
    schema1:license "GPL-3 | file LICENSE" ;
    schema1:name "bioconductor-sights" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/sights.html" .

