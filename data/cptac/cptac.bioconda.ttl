@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cptac a schema:SoftwareApplication ;
    schema:author "old-rob" ;
    schema:citation "doi:10.1021/acs.jproteome.0c00919" ;
    schema:description "Python packaging for CPTAC data" ;
    schema:downloadUrl "https://pypi.io/packages/source/c/cptac/cptac-1.5.13.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:cptac ;
    schema:license "Apache-2.0" ;
    schema:maintainer "old-rob" ;
    schema:name "cptac" ;
    schema:softwareHelp "https://paynelab.github.io/cptac/" ;
    schema:softwareVersion "1.5.13" ;
    schema:url "https://pypi.org/project/cptac/" .

