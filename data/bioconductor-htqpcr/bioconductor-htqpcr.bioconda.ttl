@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-htqpcr a schema:SoftwareApplication ;
    schema:description "Automated analysis of high-throughput qPCR data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HTqPCR_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HTqPCR/HTqPCR_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HTqPCR_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-htqpcr/bioconductor-htqpcr_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-limma",
        "r-base",
        "r-gplots",
        "r-rcolorbrewer" ;
    schema:identifier biotools:htqpcr ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-htqpcr" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HTqPCR.html" .

