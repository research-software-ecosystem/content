@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:samtools a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for dealing with SAM, BAM and CRAM files" ;
    schema1:description "Tools for dealing with SAM, BAM and CRAM files" ;
    schema1:identifier biotools:samtools,
        "usegalaxy-eu:samtools_flagstat" ;
    schema1:license "MIT" ;
    schema1:name "samtools" ;
    schema1:softwareVersion "1.24" ;
    schema1:url "https://github.com/samtools/samtools" .

