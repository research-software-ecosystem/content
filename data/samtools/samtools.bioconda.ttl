@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:samtools a schema:SoftwareApplication ;
    schema:description "Tools for dealing with SAM, BAM and CRAM files" ;
    schema:downloadUrl "https://github.com/samtools/samtools/releases/download/1.23.1/samtools-1.23.1.tar.bz2" ;
    schema:hasPart "htslib",
        "ncurses",
        "zlib" ;
    schema:identifier biotools:samtools ;
    schema:license "MIT" ;
    schema:name "samtools" ;
    schema:softwareVersion "1.23.1" ;
    schema:url "https://github.com/samtools/samtools" .

