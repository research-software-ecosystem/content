@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mhcflurry a schema:SoftwareApplication ;
    schema:author "jonasscheid" ;
    schema:citation "doi:10.1016/j.cels.2018.05.014",
        "doi:10.1016/j.cels.2020.06.010" ;
    schema:description "MHC Binding Predictor" ;
    schema:downloadUrl "https://pypi.org/packages/source/m/mhcflurry/mhcflurry-2.2.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:mhcflurry ;
    schema:license "Apache-2.0" ;
    schema:maintainer "jonasscheid" ;
    schema:name "mhcflurry" ;
    schema:softwareHelp "https://openvax.github.io/mhcflurry" ;
    schema:softwareVersion "2.2.1" ;
    schema:url "https://github.com/openvax/mhcflurry" .

