@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mhcflurry a schema1:SoftwareApplication ;
    schema1:alternateName "MHC Binding Predictor" ;
    schema1:citation "doi:10.1016/j.cels.2018.05.014",
        "doi:10.1016/j.cels.2020.06.010" ;
    schema1:description "MHC Binding Predictor" ;
    schema1:downloadUrl "https://pypi.org/packages/source/m/mhcflurry/mhcflurry-2.2.1.tar.gz" ;
    schema1:identifier "biotools:mhcflurry" ;
    schema1:license "Apache-2.0" ;
    schema1:maintainer "jonasscheid" ;
    schema1:name "mhcflurry" ;
    schema1:softwareVersion "2.2.1" ;
    schema1:url "https://github.com/openvax/mhcflurry" .

