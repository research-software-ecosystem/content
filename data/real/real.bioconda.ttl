@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:real a schema:SoftwareApplication ;
    schema:citation "doi:10.1145/1854776.1854801" ;
    schema:description "REad ALigner for Next-Generation sequencing reads." ;
    schema:downloadUrl "https://github.com/solonas13/REAL/archive/master.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:real ;
    schema:license "file" ;
    schema:name "real" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://nms.kcl.ac.uk/informatics/projects/real/?id=man" .

