@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-eudysbiome a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12918-016-0344-6" ;
    schema:description "Cartesian plot and contingency test on 16S Microbial data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/eudysbiome_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/eudysbiome/eudysbiome_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/eudysbiome_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-eudysbiome/bioconductor-eudysbiome_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-rsamtools",
        "r-base",
        "r-plyr",
        "r-r.utils" ;
    schema:identifier biotools:eudysbiome ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-eudysbiome" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/eudysbiome.html" .

