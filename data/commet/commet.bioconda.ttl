@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:commet a schema1:SoftwareApplication ;
    schema1:alternateName "Comparing and combining multiple metagenomic datasets." ;
    schema1:citation "doi:10.1109/BIBM.2014.6999135" ;
    schema1:description "Comparing and combining multiple metagenomic datasets." ;
    schema1:identifier biotools:commet ;
    schema1:license "AGPL-3.0-or-later" ;
    schema1:name "commet" ;
    schema1:softwareVersion "24.7.14" ;
    schema1:url "https://github.com/pierrepeterlongo/commet" .

