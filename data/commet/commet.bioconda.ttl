@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:commet a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/BIBM.2014.6999135" ;
    schema:description "Comparing and combining multiple metagenomic datasets." ;
    schema:downloadUrl "https://github.com/pierrepeterlongo/commet/archive/6802910e8dbd50b40d569783a3b0c062e2466da6.zip" ;
    schema:hasPart "r-base",
        "zlib" ;
    schema:identifier biotools:commet ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "commet" ;
    schema:softwareHelp "https://colibread.inria.fr/software/commet" ;
    schema:softwareVersion "24.7.14" ;
    schema:url "https://github.com/pierrepeterlongo/commet" .

