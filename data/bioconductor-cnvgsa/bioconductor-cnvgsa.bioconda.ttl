@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cnvgsa a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene Set Analysis of (Rare) Copy Number Variants" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cnvGSA_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cnvGSA/cnvGSA_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cnvGSA_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cnvgsa/bioconductor-cnvgsa_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicranges",
        "r-base",
        "r-brglm",
        "r-doparallel",
        "r-foreach",
        "r-splitstackshape" ;
    schema:identifier biotools:cnvgsa ;
    schema:license "LGPL" ;
    schema:name "bioconductor-cnvgsa" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cnvGSA.html" .

