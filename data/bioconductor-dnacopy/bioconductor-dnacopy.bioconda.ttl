@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dnacopy a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "DNA Copy Number Data Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DNAcopy_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.23/bioc/src/contrib/Archive/DNAcopy/DNAcopy_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.23/bioc/src/contrib/DNAcopy_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dnacopy/bioconductor-dnacopy_1.86.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:dnacopy ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-dnacopy" ;
    schema:softwareVersion "1.86.0" ;
    schema:url "https://bioconductor.org/packages/3.23/bioc/html/DNAcopy.html" .

