@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-basespacer a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "R SDK for BaseSpace RESTful API" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BaseSpaceR_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BaseSpaceR/BaseSpaceR_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BaseSpaceR_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-basespacer/bioconductor-basespacer_1.54.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-rcurl",
        "r-rjsonio" ;
    schema:identifier biotools:basespacer ;
    schema:license "Apache License 2.0" ;
    schema:name "bioconductor-basespacer" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BaseSpaceR.html" .

