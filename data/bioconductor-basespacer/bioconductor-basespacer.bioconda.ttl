@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-basespacer a schema1:SoftwareApplication ;
    schema1:alternateName "R SDK for BaseSpace RESTful API" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A rich R interface to Illumina's BaseSpace cloud computing environment, enabling the fast development of data analysis and visualisation tools." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BaseSpaceR_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BaseSpaceR/BaseSpaceR_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BaseSpaceR_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-basespacer/bioconductor-basespacer_1.54.0_src_all.tar.gz" ;
    schema1:identifier "biotools:basespacer" ;
    schema1:license "Apache License 2.0" ;
    schema1:name "bioconductor-basespacer" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BaseSpaceR.html" .

