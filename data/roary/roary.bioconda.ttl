@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:roary a schema1:SoftwareApplication ;
    schema1:alternateName "Rapid large-scale prokaryote pan genome analysis" ;
    schema1:description "Rapid large-scale prokaryote pan genome analysis" ;
    schema1:identifier <https://bio.tools/biotools:roary>,
        "usegalaxy-eu:roary" ;
    schema1:license "GPL-3.0" ;
    schema1:name "roary" ;
    schema1:softwareVersion "3.13.0" ;
    schema1:url "https://github.com/sanger-pathogens/Roary" .

