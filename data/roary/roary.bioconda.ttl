@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:roary a schema:SoftwareApplication ;
    schema:description "Rapid large-scale prokaryote pan genome analysis" ;
    schema:downloadUrl "http://search.cpan.org/CPAN/authors/id/A/AJ/AJPAGE/Bio-Roary-3.13.0.tar.gz" ;
    schema:hasPart "bedtools",
        "blast",
        "cd-hit",
        "fasttree",
        "mafft",
        "mcl",
        "parallel",
        "perl",
        "perl-array-utils",
        "perl-bioperl",
        "perl-data-dumper",
        "perl-digest-md5-file",
        "perl-env-path",
        "perl-exception-class",
        "perl-extutils-makemaker",
        "perl-file-find-rule",
        "perl-file-grep",
        "perl-file-path",
        "perl-file-slurper",
        "perl-file-temp",
        "perl-file-which",
        "perl-getopt-long",
        "perl-graph",
        "perl-graph-readwrite",
        "perl-log-log4perl",
        "perl-moose",
        "perl-perlio-utf8_strict",
        "perl-test-files",
        "perl-test-most",
        "perl-test-output",
        "perl-text-csv",
        "prank" ;
    schema:identifier biotools:roary ;
    schema:license "GPL-3.0" ;
    schema:name "roary" ;
    schema:softwareVersion "3.13.0" ;
    schema:url "https://github.com/sanger-pathogens/Roary" .

