@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-frma a schema1:SoftwareApplication ;
    schema1:alternateName "Frozen RMA and Barcode" ;
    schema1:description "Preprocessing and analysis for single microarrays and microarray batches." ;
    schema1:identifier <https://bio.tools/biotools:frma> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-frma" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/frma.html" .

