@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-frma a schema:SoftwareApplication ;
    schema:description "Frozen RMA and Barcode" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/frma_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/frma/frma_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/frma_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-frma/bioconductor-frma_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-oligo",
        "bioconductor-oligoclasses",
        "bioconductor-preprocesscore",
        "r-base",
        "r-dbi",
        "r-mass" ;
    schema:identifier biotools:frma ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-frma" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/frma.html" .

