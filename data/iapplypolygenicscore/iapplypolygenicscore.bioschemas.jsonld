      "sc:citation": [
        "pubmed:41488031",
        "pmcid:PMC12755996",
        {
          "@id": "https://doi.org/10.1016/J.GIMO.2025.103467"
        }
      ],
      "sc:description": "ApplyPolygenicScore is an open-source R package on CRAN that parses genotype/dosage data from VCF files, matches variants to the component SNPs of an existing polygenic score, and computes individual polygenic scores via the additive weighted-sum-of-dosages model; it is peer-reviewed and demonstrated on a cancer patient cohort.",
