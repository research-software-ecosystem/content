@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:randfold a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bth374" ;
    schema:description "Minimum free energy of folding randomization test software." ;
    schema:downloadUrl "https://gitlab.psb.ugent.be/biocomp/randfold/-/archive/2.0.1/randfold-2.0.1.tar.gz" ;
    schema:identifier biotools:randfold ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "randfold" ;
    schema:softwareHelp "http://bioinformatics.psb.ugent.be/software/details/Randfold" ;
    schema:softwareVersion "2.0.1" ;
    schema:url "http://bioinformatics.psb.ugent.be/software/details/Randfold" .

