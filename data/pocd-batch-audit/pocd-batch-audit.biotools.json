                        "uri": "http://edamontology.org/data_3273"
                    },
                    "format": [
                        {
                            "term": "CSV",
                            "uri": "http://edamontology.org/format_3752"
                        }
                    ]
                }
            ],
            "note": "Audits batch/group confounding in reused public bulk transcriptomic datasets and emits per-contrast-unit verdicts.",
            "operation": [
                {
                    "term": "Expression analysis",
                    "uri": "http://edamontology.org/operation_2495"
                }
            ],
