    "biotoolsID": "pocd-batch-audit",
    "description": "Three-gate batch/confound audit engine for reused public bulk transcriptomic datasets. Tests whether batch labels are structurally entangled with biological groups (structural confounding, technical separability with permutation test, stratification nesting) and emits per-contrast-unit verdicts (stop / correct / proceed / normalize) so that public-data reanalyses do not report batch artifacts as biological findings.",
    "editPermission": {
        "type": "private"
    },
    "function": [
        {
            "cmd": "batch-audit --matrix <expression.tsv> --samples <samples.tsv> --outdir <outdir>",
            "input": [
                {
                    "data": {
                        "term": "Gene expression matrix",
                        "uri": "http://edamontology.org/data_3112"
                    },
                    "format": [
                        {
                            "term": "TSV",
                            "uri": "http://edamontology.org/format_3475"
                        }
                    ]
                },
                {
                    "data": {
