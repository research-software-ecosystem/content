      "sc:description": "Three-gate batch/confound audit engine for reused public bulk transcriptomic datasets. Tests whether batch labels are structurally entangled with biological groups (structural confounding, technical separability with permutation test, stratification nesting) and emits per-contrast-unit verdicts (stop / correct / proceed / normalize) so that public-data reanalyses do not report batch artifacts as biological findings.",
      "sc:featureList": {
        "@id": "edam:operation_2495"
      },
      "sc:license": "MIT",
      "sc:name": "pocd-batch-audit",
      "sc:operatingSystem": [
        "Linux",
        "Mac",
        "Windows"
      ],
      "sc:softwareVersion": "1.0.0",
      "sc:url": "https://github.com/eagle-wk/pocd-batch-audit"
    },
