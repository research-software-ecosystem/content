@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bakta a schema:SoftwareApplication ;
    schema:author "oschwengers" ;
    schema:citation "doi:10.1099/mgen.0.000685",
        "doi:10.5281/zenodo.4247252" ;
    schema:description "Rapid & standardized annotation of bacterial genomes, MAGs & plasmids." ;
    schema:downloadUrl "https://github.com/oschwengers/bakta/archive/v1.12.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:bakta ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "oschwengers" ;
    schema:name "bakta" ;
    schema:softwareHelp "https://github.com/oschwengers/bakta/blob/v1.12.0/README.md" ;
    schema:softwareVersion "1.12.0" ;
    schema:url "https://github.com/oschwengers/bakta" .

