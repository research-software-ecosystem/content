@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-spia a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn577" ;
    schema:description "Signaling Pathway Impact Analysis (SPIA) using combined evidence of pathway over-representation and unusual signaling perturbations" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SPIA_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SPIA/SPIA_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SPIA_2.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-spia/bioconductor-spia_2.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-kegggraph",
        "r-base" ;
    schema:identifier biotools:spia ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-spia" ;
    schema:softwareVersion "2.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SPIA.html" .

