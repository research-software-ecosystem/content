@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-spia a schema1:SoftwareApplication ;
    schema1:alternateName "Signaling Pathway Impact Analysis (SPIA) using combined evidence of pathway over-representation and unusual signaling perturbations" ;
    schema1:citation "doi:10.1093/bioinformatics/btn577" ;
    schema1:description "This package implements the Signaling Pathway Impact Analysis (SPIA) which uses the information form a list of differentially expressed genes and their log fold changes together with signaling pathways topology, in order to identify the pathways most relevant to the condition under the study." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SPIA_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SPIA/SPIA_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SPIA_2.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-spia/bioconductor-spia_2.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:spia" ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-spia" ;
    schema1:softwareVersion "2.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SPIA.html" .

