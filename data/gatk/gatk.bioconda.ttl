@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:gatk a schema1:SoftwareApplication ;
    schema1:alternateName "The full Genome Analysis Toolkit (GATK) framework, v3" ;
    schema1:description "The full Genome Analysis Toolkit (GATK) framework, v3" ;
    schema1:identifier <https://bio.tools/biotools:gatk> ;
    schema1:license "BSD" ;
    schema1:name "gatk" ;
    schema1:softwareVersion "3.8" ;
    schema1:url "https://www.broadinstitute.org/gatk/" .

