@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gatk a schema:SoftwareApplication ;
    schema:description "The full Genome Analysis Toolkit (GATK) framework, v3" ;
    schema:downloadUrl "https://storage.googleapis.com/gatk-software/package-archive/gatk/GenomeAnalysisTK-3.8-1-0-gf15c1c3ef.tar.bz2" ;
    schema:identifier biotools:gatk ;
    schema:license "BSD" ;
    schema:name "gatk" ;
    schema:softwareVersion "3.8" ;
    schema:url "https://www.broadinstitute.org/gatk/" .

