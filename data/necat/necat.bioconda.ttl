@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:necat a schema1:SoftwareApplication ;
    schema1:alternateName "NECAT is an error correction and de-novo assembly tool for Nanopore long noisy reads." ;
