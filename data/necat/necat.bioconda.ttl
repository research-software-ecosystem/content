@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:necat a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41467-020-20236-7" ;
    schema:description "NECAT is an error correction and de-novo assembly tool for Nanopore long noisy reads." ;
    schema:downloadUrl "https://github.com/xiaochuanle/NECAT/archive/v0.0.1_update20200803.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:necat ;
    schema:license "Unknown" ;
    schema:name "necat" ;
    schema:softwareHelp "https://github.com/xiaochuanle/NECAT/blob/master/README.md" ;
    schema:softwareVersion "0.0.1_update20200803" ;
    schema:url "https://github.com/xiaochuanle/NECAT" .

