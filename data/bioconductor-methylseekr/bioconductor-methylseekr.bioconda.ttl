@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-methylseekr a schema:SoftwareApplication ;
    schema:description "Segmentation of Bis-seq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MethylSeekR_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MethylSeekR/MethylSeekR_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MethylSeekR_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylseekr/bioconductor-methylseekr_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-bsgenome",
        "bioconductor-geneplotter",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "r-base",
        "r-mhsmm" ;
    schema:identifier biotools:methylseekr ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-methylseekr" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MethylSeekR.html" .

