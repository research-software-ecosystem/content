@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-methylseekr a schema1:SoftwareApplication ;
    schema1:alternateName "Segmentation of Bis-seq data" ;
    schema1:description "This is a package for the discovery of regulatory regions from Bis-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MethylSeekR_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MethylSeekR/MethylSeekR_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MethylSeekR_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylseekr/bioconductor-methylseekr_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:methylseekr" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-methylseekr" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MethylSeekR.html" .

