@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-copa a schema:SoftwareApplication ;
    schema:description "Functions to perform cancer outlier profile analysis." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/copa_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/copa/copa_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/copa_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-copa/bioconductor-copa_1.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:copa ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-copa" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/copa.html" .

