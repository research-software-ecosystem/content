@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-copa a schema1:SoftwareApplication ;
    schema1:alternateName "Functions to perform cancer outlier profile analysis." ;
    schema1:description "COPA is a method to find genes that undergo recurrent fusion in a given cancer type by finding pairs of genes that have mutually exclusive outlier profiles." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/copa_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/copa/copa_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/copa_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-copa/bioconductor-copa_1.78.0_src_all.tar.gz" ;
    schema1:identifier "biotools:copa",
        "usegalaxy-eu:copa" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-copa" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/copa.html" .

