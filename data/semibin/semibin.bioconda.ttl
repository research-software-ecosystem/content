@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:semibin a schema:SoftwareApplication ;
    schema:author "luispedro",
        "psj1997" ;
    schema:citation "doi:10.1038/s41467-022-29843-y",
        "doi:10.1093/bioinformatics/btad209" ;
    schema:description "Metagenomic binning with siamese neural networks" ;
    schema:downloadUrl "https://pypi.io/packages/source/S/SemiBin/semibin-2.3.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:semibin ;
    schema:license "MIT" ;
    schema:maintainer "luispedro",
        "psj1997" ;
    schema:name "semibin" ;
    schema:softwareHelp "https://semibin.readthedocs.io/en/latest/" ;
    schema:softwareVersion "2.3.0" ;
    schema:url "https://github.com/BigDataBiology/SemiBin" .

