@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-crisprvariants a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for counting and visualising mutations in a target location" ;
    schema1:description "CrispRVariants provides tools for analysing the results of a CRISPR-Cas9 mutagenesis sequencing experiment, or other sequencing experiments where variants within a given region are of interest. These tools allow users to localize variant allele combinations with respect to any genomic location (e.g. the Cas9 cut site), plot allele combinations and calculate mutation rates with flexible filtering of unrelated variants." ;
    schema1:identifier biotools:crisprvariants ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-crisprvariants" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CrispRVariants.html" .

