@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-crisprvariants a schema:SoftwareApplication ;
    schema:description "Tools for counting and visualising mutations in a target location" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CrispRVariants_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CrispRVariants/CrispRVariants_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CrispRVariants_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-crisprvariants/bioconductor-crisprvariants_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "r-base",
        "r-ggplot2",
        "r-gridextra",
        "r-reshape2" ;
    schema:identifier biotools:crisprvariants ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-crisprvariants" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CrispRVariants.html" .

