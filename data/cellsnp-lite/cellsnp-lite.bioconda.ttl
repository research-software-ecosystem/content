@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cellsnp-lite a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btab358" ;
    schema:description "Efficient genotyping bi-allelic SNPs on single cells." ;
    schema:downloadUrl "https://github.com/single-cell-genetics/cellsnp-lite/archive/aad18644adcde853c313362a856a24245c9b91f7.tar.gz" ;
    schema:hasPart "bzip2",
        "htslib",
        "libcurl",
        "xz",
        "zlib" ;
    schema:identifier biotools:cellsnp-lite ;
    schema:license "Apache-2.0" ;
    schema:name "cellsnp-lite" ;
    schema:softwareHelp "https://cellsnp-lite.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.2.3" ;
    schema:url "https://github.com/single-cell-genetics/cellsnp-lite" .

