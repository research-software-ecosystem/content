@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:cellsnp-lite a schema1:SoftwareApplication ;
    schema1:alternateName "Efficient genotyping bi-allelic SNPs on single cells." ;
