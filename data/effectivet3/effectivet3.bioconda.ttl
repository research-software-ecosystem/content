@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:effectivet3 a schema:SoftwareApplication ;
    schema:description "Command line NoD (clinod), for  predicting nucleolar localization sequences." ;
    schema:downloadUrl "https://depot.galaxyproject.org/software/TTSS_GUI/TTSS_GUI_1.0.1_src_all.jar" ;
    schema:hasPart "coreutils",
        "curl",
        "openjdk" ;
    schema:identifier biotools:effectivet3 ;
    schema:license "Apache License, Version 2.0 + others used internally" ;
    schema:name "effectivet3" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "http://www.compbio.dundee.ac.uk/nod" .

