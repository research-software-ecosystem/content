@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pcamethods a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm069" ;
    schema:description "A collection of PCA methods" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pcaMethods_2.2.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pcaMethods/pcaMethods_2.2.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pcaMethods_2.2.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pcamethods/bioconductor-pcamethods_2.2.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mass",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:pcamethods ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-pcamethods" ;
    schema:softwareVersion "2.2.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pcaMethods.html" .

