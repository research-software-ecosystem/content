@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:kmindex a schema1:SoftwareApplication ;
    bioschemas:output "kmindex" ;
    schema1:codeRepository <https://github.com/tlemane/kmindex> ;
    schema1:dateCreated "2025-12-10" ;
    schema1:description "Index and query k-mers from sequencing samples using Bloom filters" ;
    schema1:encodingFormat "kmindex" ;
    schema1:identifier biotools:kmindex,
        bioconda:kmindex ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.org> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "kmindex" ;
    schema1:softwareVersion "0.6.1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/kmindex> .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org> a schema1:WebSite .

