@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ibmq a schema1:SoftwareApplication ;
    schema1:description "integrated Bayesian Modeling of eQTL data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/iBMQ_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iBMQ/iBMQ_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iBMQ_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ibmq/bioconductor-ibmq_1.50.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "gsl",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ggplot2",
        "zlib" ;
    schema1:identifier biotools:ibmq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ibmq" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/iBMQ.html" .

