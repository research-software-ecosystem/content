@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genvisr a schema:SoftwareApplication ;
    schema:description "Genomic Visualizations in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GenVisR_1.42.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenVisR/GenVisR_1.42.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenVisR_1.42.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genvisr/bioconductor-genvisr_1.42.2_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-seqinfo",
        "bioconductor-variantannotation",
        "r-base",
        "r-data.table",
        "r-dbi",
        "r-ggplot2",
        "r-gridextra",
        "r-gtable",
        "r-gtools",
        "r-plyr",
        "r-reshape2",
        "r-scales",
        "r-viridis" ;
    schema:identifier biotools:genvisr ;
    schema:license "GPL-3 + file LICENSE" ;
    schema:name "bioconductor-genvisr" ;
    schema:softwareVersion "1.42.2" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GenVisR.html" .

