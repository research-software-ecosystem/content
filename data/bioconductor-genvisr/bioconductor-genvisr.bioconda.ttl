@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genvisr a schema1:SoftwareApplication ;
    schema1:alternateName "Genomic Visualizations in R" ;
    schema1:description "Produce highly customizable publication quality graphics for genomic data primarily at the cohort level." ;
    schema1:identifier <https://bio.tools/biotools:genvisr> ;
    schema1:license "GPL-3 + file LICENSE" ;
    schema1:name "bioconductor-genvisr" ;
    schema1:softwareVersion "1.42.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GenVisR.html" .

