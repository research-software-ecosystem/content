@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:magicblast a schema:SoftwareApplication ;
    schema:author "boratyng" ;
    schema:citation "doi:10.1186/s12859-019-2996-x" ;
    schema:description "NCBI BLAST next generation read mapper" ;
    schema:hasPart "bzip2",
        "libxml2",
        "ncbi-vdb",
        "zlib" ;
    schema:identifier biotools:magicblast ;
    schema:license "Public Domain" ;
    schema:maintainer "boratyng" ;
    schema:name "magicblast" ;
    schema:softwareVersion "1.7.0" ;
    schema:url "https://ncbi.github.io/magicblast/" .

