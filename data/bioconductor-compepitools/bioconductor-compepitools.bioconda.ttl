@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-compepitools a schema:SoftwareApplication ;
    schema:description "Tools for computational epigenomics" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/compEpiTools_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/compEpiTools/compEpiTools_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/compEpiTools_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-compepitools/bioconductor-compepitools_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-go.db",
        "bioconductor-iranges",
        "bioconductor-methylpipe",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-topgo",
        "bioconductor-xvector",
        "r-base",
        "r-gplots" ;
    schema:identifier biotools:compepitools ;
    schema:license "GPL" ;
    schema:name "bioconductor-compepitools" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/compEpiTools.html" .

