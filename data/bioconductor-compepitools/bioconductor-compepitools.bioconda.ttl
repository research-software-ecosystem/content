@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-compepitools a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for computational epigenomics" ;
    schema1:description "Tools for computational epigenomics developed for the analysis, integration and simultaneous visualization of various (epi)genomics data types across multiple genomic regions in multiple samples." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/compEpiTools_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/compEpiTools/compEpiTools_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/compEpiTools_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-compepitools/bioconductor-compepitools_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:compepitools" ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-compepitools" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/compEpiTools.html" .

