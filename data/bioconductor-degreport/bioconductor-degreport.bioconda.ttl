@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-degreport a schema1:SoftwareApplication ;
    schema1:alternateName "Report of DEG analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Creation of ready-to-share figures of differential expression analyses of count data. It integrates some of the code mentioned in DESeq2 and edgeR vignettes, and report a ranked list of genes according to the fold changes mean and variability for each selected gene." ;
    schema1:identifier biotools:degreport ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-degreport" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DEGreport.html" .

