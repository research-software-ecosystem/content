@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-degreport a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Report of DEG analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DEGreport_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEGreport/DEGreport_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DEGreport_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-degreport/bioconductor-degreport_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-complexheatmap",
        "bioconductor-consensusclusterplus",
        "bioconductor-deseq2",
        "bioconductor-edger",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-broom",
        "r-circlize",
        "r-cluster",
        "r-cowplot",
        "r-dendextend",
        "r-dplyr",
        "r-ggdendro",
        "r-ggplot2",
        "r-ggrepel",
        "r-knitr",
        "r-logging",
        "r-magrittr",
        "r-psych",
        "r-rcolorbrewer",
        "r-reshape",
        "r-rlang",
        "r-scales",
        "r-stringi",
        "r-stringr",
        "r-tibble",
        "r-tidyr" ;
    schema:identifier biotools:degreport ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-degreport" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DEGreport.html" .

