@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bgeedb a schema1:SoftwareApplication ;
    schema1:alternateName "Annotation and gene expression data retrieval from Bgee database. TopAnat, an anatomical entities Enrichment Analysis tool for UBERON ontology" ;
    schema1:citation "doi:10.12688/f1000research.9973.1" ;
    schema1:description "A package for the annotation and gene expression data download from Bgee database, and TopAnat analysis: GO-like enrichment of anatomical terms, mapped to genes by expression patterns." ;
    schema1:identifier biotools:bgeedb ;
    schema1:license "GPL-3 + file LICENSE" ;
    schema1:name "bioconductor-bgeedb" ;
    schema1:softwareVersion "2.38.1" ;
    schema1:url "https://bioconductor.org/packages/3.23/bioc/html/BgeeDB.html" .

