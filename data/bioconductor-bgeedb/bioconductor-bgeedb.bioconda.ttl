@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bgeedb a schema1:SoftwareApplication ;
    schema1:citation "doi:10.12688/f1000research.9973.1" ;
    schema1:description "Annotation and gene expression data retrieval from Bgee database. TopAnat, an anatomical entities Enrichment Analysis tool for UBERON ontology" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BgeeDB_2.38.1.tar.gz",
        "https://bioconductor.org/packages/3.23/bioc/src/contrib/Archive/BgeeDB/BgeeDB_2.38.1.tar.gz",
        "https://bioconductor.org/packages/3.23/bioc/src/contrib/BgeeDB_2.38.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bgeedb/bioconductor-bgeedb_2.38.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "bioconductor-hdf5array",
        "bioconductor-topgo",
        "bioconductor-zellkonverter",
        "r-anndata",
        "r-base",
        "r-bread",
        "r-curl",
        "r-data.table",
        "r-digest",
        "r-dplyr",
        "r-r.utils",
        "r-rcurl",
        "r-rsqlite",
        "r-tidyr" ;
    schema1:identifier biotools:bgeedb ;
    schema1:license "GPL-3 + file LICENSE" ;
    schema1:name "bioconductor-bgeedb" ;
    schema1:softwareVersion "2.38.1" ;
    schema1:url "https://bioconductor.org/packages/3.23/bioc/html/BgeeDB.html" .

