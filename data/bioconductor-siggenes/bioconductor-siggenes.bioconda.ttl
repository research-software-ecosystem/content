@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-siggenes a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-9-144" ;
    schema:description "Multiple Testing using SAM and Efron's Empirical Bayes Approaches" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/siggenes_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/siggenes/siggenes_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/siggenes_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-siggenes/bioconductor-siggenes_1.84.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-multtest",
        "r-base",
        "r-scrime" ;
    schema:identifier biotools:siggenes ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-siggenes" ;
    schema:softwareVersion "1.84.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/siggenes.html" .

