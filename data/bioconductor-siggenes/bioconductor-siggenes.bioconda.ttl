@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-siggenes a schema1:SoftwareApplication ;
    schema1:alternateName "Multiple Testing using SAM and Efron's Empirical Bayes Approaches" ;
    schema1:citation "doi:10.1186/1471-2105-9-144" ;
    schema1:description "Identification of differentially expressed genes and estimation of the False Discovery Rate (FDR) using both the Significance Analysis of Microarrays (SAM) and the Empirical Bayes Analyses of Microarrays (EBAM)." ;
    schema1:identifier <https://bio.tools/biotools:siggenes> ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-siggenes" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/siggenes.html" .

