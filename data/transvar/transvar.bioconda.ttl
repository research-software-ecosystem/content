@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:transvar a schema:SoftwareApplication ;
    schema:description "Transcript-based variant annotator." ;
    schema:downloadUrl "https://pypi.org/packages/source/t/transvar/TransVar-2.5.10.20211024.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:transvar ;
    schema:license "MIT" ;
    schema:name "transvar" ;
    schema:softwareHelp "https://transvar.readthedocs.io" ;
    schema:softwareVersion "2.5.10.20211024" ;
    schema:url "https://github.com/zwdzwd/transvar" .

