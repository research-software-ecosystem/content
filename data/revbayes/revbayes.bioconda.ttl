@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:revbayes a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/sysbio/syu039",
        "doi:10.1093/sysbio/syw021" ;
    schema:description "Bayesian Phylogenetic Inference Using Graphical Models and an Interactive Model-Specification Language." ;
    schema:downloadUrl "https://github.com/revbayes/revbayes/archive/refs/tags/v1.3.2.tar.gz" ;
    schema:hasPart "boost-cpp",
        "libgomp",
        "llvm-openmp",
        "openmpi" ;
    schema:identifier biotools:revbayes ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "revbayes" ;
    schema:softwareHelp "https://revbayes.github.io/tutorials" ;
    schema:softwareVersion "1.3.2" ;
    schema:url "https://revbayes.github.io" .

