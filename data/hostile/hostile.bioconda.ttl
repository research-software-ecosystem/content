@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hostile a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btad728" ;
    schema:description "Hostile: accurate host decontamination." ;
    schema:downloadUrl "https://pypi.org/packages/source/h/hostile/hostile-2.0.2.tar.gz" ;
    schema:hasPart "flit-core",
        "pip",
        "python" ;
    schema:identifier biotools:hostile ;
    schema:license "MIT" ;
    schema:name "hostile" ;
    schema:softwareHelp "https://github.com/bede/hostile/blob/2.0.2/README.md" ;
    schema:softwareVersion "2.0.2" ;
    schema:url "https://github.com/bede/hostile" .

