@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mapdia a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.jprot.2015.09.013" ;
    schema:description "Performs essential data preprocessing, including novel retention time-based normalization method and a sequence of peptide/fragment selection steps, and more importantly, hierarchical model-based statistical significance analysis for multi-group comparisons under representative experimental designs." ;
    schema:downloadUrl "https://sourceforge.net/projects/mapdia/files/mapDIA_v3.1.0.tar.gz" ;
    schema:identifier biotools:MAPDIA ;
    schema:license "file" ;
    schema:name "mapdia" ;
    schema:softwareVersion "3.1.0" ;
    schema:url "https://sourceforge.net/projects/mapdia" .

