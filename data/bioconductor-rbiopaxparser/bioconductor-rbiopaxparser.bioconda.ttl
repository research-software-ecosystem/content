@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbiopaxparser a schema1:SoftwareApplication ;
    schema1:alternateName "Parses BioPax files and represents them in R" ;
    schema1:description "Parses BioPAX files and represents them in R, at the moment BioPAX level 2 and level 3 are supported." ;
    schema1:identifier biotools:rbiopaxparser ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-rbiopaxparser" ;
    schema1:softwareVersion "2.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rBiopaxParser.html" .

