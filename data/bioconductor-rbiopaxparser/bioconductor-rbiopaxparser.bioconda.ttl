@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbiopaxparser a schema:SoftwareApplication ;
    schema:description "Parses BioPax files and represents them in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rBiopaxParser_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rBiopaxParser/rBiopaxParser_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rBiopaxParser_2.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbiopaxparser/bioconductor-rbiopaxparser_2.50.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-data.table",
        "r-xml" ;
    schema:identifier biotools:rbiopaxparser ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-rbiopaxparser" ;
    schema:softwareVersion "2.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rBiopaxParser.html" .

