@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:masurca a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt476" ;
    schema:description "MaSuRCA (Maryland Super-Read Celera Assembler) genome assembly software." ;
    schema:downloadUrl "https://github.com/alekseyzimin/masurca/releases/download/v4.1.4/MaSuRCA-4.1.4.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "gdbm",
        "libxcrypt",
        "ncurses",
        "openssl",
        "xz",
        "zlib" ;
    schema:identifier biotools:masurca ;
    schema:license "GPL-3.0-only" ;
    schema:name "masurca" ;
    schema:softwareHelp "https://github.com/alekseyzimin/masurca/blob/v4.1.4/README.md" ;
    schema:softwareVersion "4.1.4" ;
    schema:url "https://masurca.blogspot.co.uk" .

