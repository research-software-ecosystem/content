@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biseq a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bib/bbv095" ;
    schema1:description "Processing and analyzing bisulfite sequencing data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BiSeq_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiSeq/BiSeq_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiSeq_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biseq/bioconductor-biseq_1.50.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-globaltest",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-betareg",
        "r-formula",
        "r-lokern" ;
    schema1:identifier biotools:biseq ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-biseq" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BiSeq.html" .

