@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ea-utils a schema:SoftwareApplication ;
    schema:citation "doi:10.2174/1875036201307010001" ;
    schema:description "Command-line tools for processing biological sequencing data." ;
    schema:downloadUrl "https://github.com/ExpressionAnalysis/ea-utils/archive/1.04.807.tar.gz" ;
    schema:hasPart "gsl",
        "openblas",
        "zlib" ;
    schema:identifier biotools:ea-utils ;
    schema:license "MIT" ;
    schema:name "ea-utils" ;
    schema:softwareVersion "1.1.2.779" ;
    schema:url "https://expressionanalysis.github.io/ea-utils/" .

