@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ea-utils a schema1:SoftwareApplication ;
    schema1:alternateName "Command-line tools for processing biological sequencing data." ;
    schema1:citation "doi:10.2174/1875036201307010001" ;
