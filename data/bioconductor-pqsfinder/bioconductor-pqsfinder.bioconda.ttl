@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pqsfinder a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btv272" ;
    schema1:description "Identification of potential quadruplex forming sequences" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pqsfinder_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pqsfinder/pqsfinder_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pqsfinder_2.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pqsfinder/bioconductor-pqsfinder_2.26.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:pqsfinder ;
    schema1:license "BSD_2_clause + file LICENSE" ;
    schema1:name "bioconductor-pqsfinder" ;
    schema1:softwareVersion "2.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pqsfinder.html" .

