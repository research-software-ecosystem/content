@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:esimsa a schema:SoftwareApplication ;
    schema:description "Simple deconvolution of electrospray ionization peak lists" ;
    schema:downloadUrl "http://www.ms-utils.org/esimsa.c" ;
    schema:identifier biotools:esimsa ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "esimsa" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://www.ms-utils.org/esimsa.html" .

