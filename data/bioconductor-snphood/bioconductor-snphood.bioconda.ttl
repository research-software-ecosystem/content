@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-snphood a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw127" ;
    schema:description "SNPhood: Investigate, quantify and visualise the epigenomic neighbourhood of SNPs using NGS data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SNPhood_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SNPhood/SNPhood_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SNPhood_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-snphood/bioconductor-snphood_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-deseq2",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "r-base",
        "r-checkmate",
        "r-cluster",
        "r-data.table",
        "r-ggplot2",
        "r-gridextra",
        "r-lattice",
        "r-rcolorbrewer",
        "r-reshape2",
        "r-scales" ;
    schema:identifier biotools:snphood ;
    schema:license "LGPL (>= 3)" ;
    schema:name "bioconductor-snphood" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SNPhood.html" .

