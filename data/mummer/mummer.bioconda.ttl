@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mummer a schema1:SoftwareApplication ;
    schema1:alternateName "MUMmer is a system for rapidly aligning entire genomes" ;
    schema1:description "MUMmer is a system for rapidly aligning entire genomes" ;
    schema1:identifier <https://bio.tools/biotools:mummer> ;
    schema1:license "The Artistic License" ;
    schema1:name "mummer" ;
    schema1:softwareVersion "3.23" ;
    schema1:url "http://mummer.sourceforge.net/" .

