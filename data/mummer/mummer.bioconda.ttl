@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mummer a schema:SoftwareApplication ;
    schema:description "MUMmer is a system for rapidly aligning entire genomes" ;
    schema:downloadUrl "https://downloads.sourceforge.net/project/mummer/mummer/3.23/MUMmer3.23.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:mummer ;
    schema:license "The Artistic License" ;
    schema:name "mummer" ;
    schema:softwareVersion "3.23" ;
    schema:url "http://mummer.sourceforge.net/" .

