@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:fastp a schema1:SoftwareApplication ;
    schema1:alternateName "A ultra-fast FASTQ preprocessor with full features (QC/adapters/trimming/filtering/splitting...)." ;
    schema1:citation "doi:10.1002/imt2.107" ;
    schema1:description "A ultra-fast FASTQ preprocessor with full features (QC/adapters/trimming/filtering/splitting...)." ;
    schema1:downloadUrl "https://github.com/OpenGene/fastp/archive/v1.3.6.tar.gz" ;
    schema1:identifier "biotools:fastp",
        "usegalaxy-eu:fastp" ;
    schema1:license "MIT" ;
    schema1:name "fastp" ;
    schema1:softwareVersion "1.3.6" ;
    schema1:url "https://github.com/OpenGene/fastp" .

