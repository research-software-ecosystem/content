@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fastp a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/imt2.107" ;
    schema:description "A ultra-fast FASTQ preprocessor with full features (QC/adapters/trimming/filtering/splitting...)." ;
    schema:downloadUrl "https://github.com/OpenGene/fastp/archive/v1.3.6.tar.gz" ;
    schema:hasPart "isa-l",
        "libdeflate",
        "libhwy" ;
    schema:identifier biotools:fastp ;
    schema:license "MIT" ;
    schema:name "fastp" ;
    schema:softwareHelp "https://github.com/OpenGene/fastp/blob/v1.3.6/README.md" ;
    schema:softwareVersion "1.3.6" ;
    schema:url "https://github.com/OpenGene/fastp" .

