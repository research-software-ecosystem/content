@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clusterexperiment a schema1:SoftwareApplication ;
    schema1:alternateName "Compare Clusterings for Single-Cell Sequencing" ;
    schema1:description "Provides functionality for running and comparing many different clusterings of single-cell sequencing data or other large mRNA Expression data sets." ;
    schema1:identifier biotools:clusterexperiment ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-clusterexperiment" ;
    schema1:softwareVersion "2.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clusterExperiment.html" .

