@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clusterexperiment a schema1:SoftwareApplication ;
    schema1:description "Compare Clusterings for Single-Cell Sequencing" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/clusterExperiment_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clusterExperiment/clusterExperiment_2.30.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clusterExperiment_2.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clusterexperiment/bioconductor-clusterexperiment_2.30.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocsingular",
        "bioconductor-delayedarray",
        "bioconductor-edger",
        "bioconductor-hdf5array",
        "bioconductor-limma",
        "bioconductor-mbkmeans",
        "bioconductor-s4vectors",
        "bioconductor-singlecellexperiment",
        "bioconductor-summarizedexperiment",
        "bioconductor-zinbwave",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-ape",
        "r-base",
        "r-cluster",
        "r-kernlab",
        "r-locfdr",
        "r-matrix",
        "r-matrixstats",
        "r-nmf",
        "r-phylobase",
        "r-pracma",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-scales",
        "r-stringr",
        "zlib" ;
    schema1:identifier biotools:clusterexperiment ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-clusterexperiment" ;
    schema1:softwareVersion "2.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clusterExperiment.html" .

