@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:python-tripal a schema:SoftwareApplication ;
    schema:description "Tripal API library" ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/df/0f/74f673fd20ff1dd6b26606dac6c2c8f2935df88c6fb6702ab81cd7bd0c86/tripal-3.2.1.tar.gz" ;
    schema:hasPart "click",
        "python",
        "pyyaml",
        "requests",
        "setuptools",
        "wrapt" ;
    schema:identifier biotools:tripal ;
    schema:license "MIT License" ;
    schema:name "python-tripal" ;
    schema:softwareVersion "3.2.1" ;
    schema:url "https://github.com/galaxy-genome-annotation/python-tripal" .

