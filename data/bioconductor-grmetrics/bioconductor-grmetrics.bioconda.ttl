@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-grmetrics a schema1:SoftwareApplication ;
    schema1:alternateName "Calculate growth-rate inhibition (GR) metrics" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for calculating and visualizing growth-rate inhibition (GR) metrics." ;
    schema1:identifier <https://bio.tools/biotools:grmetrics> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-grmetrics" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GRmetrics.html" .

