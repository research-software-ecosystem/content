@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-grmetrics a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Calculate growth-rate inhibition (GR) metrics" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GRmetrics_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GRmetrics/GRmetrics_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GRmetrics_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-grmetrics/bioconductor-grmetrics_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-drc",
        "r-ggplot2",
        "r-plotly" ;
    schema1:identifier biotools:grmetrics ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-grmetrics" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GRmetrics.html" .

