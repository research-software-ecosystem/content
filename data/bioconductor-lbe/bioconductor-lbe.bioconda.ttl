@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lbe a schema1:SoftwareApplication ;
    schema1:alternateName "Estimation of the false discovery rate" ;
    schema1:citation "doi:10.1093/bioinformatics/bti063" ;
    schema1:description "LBE is an efficient procedure for estimating the proportion of true null hypotheses, the false discovery rate (and so the q-values) in the framework of estimating procedures based on the marginal distribution of the p-values without assumption for the alternative hypothesis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/LBE_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LBE/LBE_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/LBE_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lbe/bioconductor-lbe_1.78.0_src_all.tar.gz" ;
    schema1:identifier "biotools:lbe" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-lbe" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/LBE.html" .

