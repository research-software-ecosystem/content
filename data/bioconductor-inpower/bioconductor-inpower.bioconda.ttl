@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-inpower a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "An R package for computing the number of susceptibility SNPs" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/INPower_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/INPower/INPower_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/INPower_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-inpower/bioconductor-inpower_1.46.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mvtnorm" ;
    schema:identifier biotools:inpower ;
    schema:license "GPL-2 + file LICENSE" ;
    schema:name "bioconductor-inpower" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/INPower.html" .

