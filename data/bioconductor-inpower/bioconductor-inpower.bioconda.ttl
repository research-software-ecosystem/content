@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-inpower a schema1:SoftwareApplication ;
    schema1:alternateName "An R package for computing the number of susceptibility SNPs" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "An R package for computing the number of susceptibility SNPs and power of future studies" ;
    schema1:identifier biotools:inpower ;
    schema1:license "GPL-2 + file LICENSE" ;
    schema1:name "bioconductor-inpower" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/INPower.html" .

