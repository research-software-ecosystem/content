galaxytool:mageck a schema1:SoftwareApplication ;
    bioschemas:output "pdf",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0199,
        edam:topic_0622,
        edam:topic_3053 ;
    schema1:codeRepository <https://sourceforge.net/projects/mageck/> ;
    schema1:dateCreated "2017-11-08" ;
    schema1:description "Model-based Analysis of Genome-wide CRISPR-Cas9 Knockout (MAGeCK) is a computational tool to identifyimportant genes from the recent genome-scale CRISPR-Cas9 knockout screens technology." ;
    schema1:encodingFormat "pdf",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_3197 ;
    schema1:identifier biotools:mageck,
        bioconda:mageck ;
    schema1:isPartOf <https://galaxy.pasteur.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://workflowhub.eu/workflows/1534?version=1> ;
    schema1:keywords "Genome editing" ;
    schema1:name "mageck" ;
    schema1:softwareVersion "0.5.9.2" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/mageck> .

