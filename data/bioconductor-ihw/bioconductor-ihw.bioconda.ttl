@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ihw a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3885" ;
    schema1:description "Independent Hypothesis Weighting" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/IHW_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IHW/IHW_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/IHW_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ihw/bioconductor-ihw_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-lpsymphony",
        "r-base",
        "r-fdrtool",
        "r-slam" ;
    schema1:identifier biotools:IHW ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ihw" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/IHW.html" .

