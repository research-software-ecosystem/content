@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ihw a schema1:SoftwareApplication ;
    schema1:alternateName "Independent Hypothesis Weighting" ;
    schema1:citation "doi:10.1038/nmeth.3885" ;
    schema1:description "Independent hypothesis weighting (IHW) is a multiple testing procedure that increases power compared to the method of Benjamini and Hochberg by assigning data-driven weights to each hypothesis. The input to IHW is a two-column table of p-values and covariates. The covariate can be any continuous-valued or categorical variable that is thought to be informative on the statistical properties of each hypothesis test, while it is independent of the p-value under the null hypothesis." ;
    schema1:identifier <https://bio.tools/biotools:IHW> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ihw" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/IHW.html" .

