@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-transview a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Read density map construction and accession. Visualization of ChIPSeq and RNASeq data sets" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/TransView_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/TransView/TransView_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/TransView_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-transview/bioconductor-transview_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rhtslib",
        "bioconductor-s4vectors",
        "bioconductor-zlibbioc",
        "libblas",
        "liblapack",
        "r-base",
        "r-gplots" ;
    schema1:identifier biotools:transview ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-transview" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/TransView.html" .

