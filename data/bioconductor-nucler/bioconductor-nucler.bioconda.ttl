@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-nucler a schema:SoftwareApplication ;
    schema:description "Nucleosome positioning package for R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/nucleR_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/nucleR/nucleR_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/nucleR_2.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-nucler/bioconductor-nucler_2.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-shortread",
        "r-base",
        "r-dplyr",
        "r-ggplot2",
        "r-magrittr" ;
    schema:identifier biotools:nucler ;
    schema:license "LGPL (>= 3)" ;
    schema:name "bioconductor-nucler" ;
    schema:softwareVersion "2.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/nucleR.html" .

