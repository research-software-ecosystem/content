@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-nucler a schema1:SoftwareApplication ;
    schema1:alternateName "Nucleosome positioning package for R" ;
    schema1:description "Nucleosome positioning for Tiling Arrays and NGS experiments." ;
    schema1:identifier biotools:nucler ;
    schema1:license "LGPL (>= 3)" ;
    schema1:name "bioconductor-nucler" ;
    schema1:softwareVersion "2.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/nucleR.html" .

