@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-camera a schema1:SoftwareApplication ;
    schema1:alternateName "Collection of annotation related methods for mass spectrometry data" ;
    schema1:description "Annotation of peaklists generated by xcms, rule based annotation of isotopes and adducts, isotope validation, EIC correlation based tagging of unknown adducts and fragments" ;
    schema1:identifier <https://bio.tools/biotools:camera> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-camera" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CAMERA.html" .

