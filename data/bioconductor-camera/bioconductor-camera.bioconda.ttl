@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-camera a schema:SoftwareApplication ;
    schema:description "Collection of annotation related methods for mass spectrometry data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CAMERA_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CAMERA/CAMERA_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CAMERA_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-camera/bioconductor-camera_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "bioconductor-rbgl",
        "bioconductor-xcms",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-hmisc",
        "r-igraph",
        "zlib" ;
    schema:identifier biotools:camera ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-camera" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CAMERA.html" .

