@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rpa a schema:SoftwareApplication ;
    schema:description "RPA: Robust Probabilistic Averaging for probe-level analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RPA_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RPA/RPA_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RPA_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rpa/bioconductor-rpa_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biocgenerics",
        "bioconductor-biocstyle",
        "bioconductor-phyloseq",
        "r-base",
        "r-rmarkdown" ;
    schema:identifier biotools:rpa ;
    schema:license "BSD_2_clause + file LICENSE" ;
    schema:name "bioconductor-rpa" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RPA.html" .

