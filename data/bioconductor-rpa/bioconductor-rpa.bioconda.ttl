@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rpa a schema1:SoftwareApplication ;
    schema1:alternateName "RPA: Robust Probabilistic Averaging for probe-level analysis" ;
    schema1:description "Probabilistic analysis of probe reliability and differential gene expression on short oligonucleotide arrays." ;
    schema1:identifier biotools:rpa ;
    schema1:license "BSD_2_clause + file LICENSE" ;
    schema1:name "bioconductor-rpa" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RPA.html" .

