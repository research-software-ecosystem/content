@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rtg-tools a schema:SoftwareApplication ;
    schema:description "RealTimeGenomics Tools -- Utilities for accurate VCF comparison and manipulation." ;
    schema:downloadUrl "https://github.com/RealTimeGenomics/rtg-tools/releases/download/3.13/rtg-tools-3.13-nojre.zip" ;
    schema:identifier biotools:rtg_core ;
    schema:license "BSD-2-Clause" ;
    schema:name "rtg-tools" ;
    schema:softwareHelp "https://realtimegenomics.github.io/rtg-tools/index.html" ;
    schema:softwareVersion "3.13" ;
    schema:url "https://github.com/RealTimeGenomics/rtg-tools" .

