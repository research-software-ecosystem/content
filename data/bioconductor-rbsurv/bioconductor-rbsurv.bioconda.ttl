@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbsurv a schema:SoftwareApplication ;
    schema:citation "doi:10.18637/jss.v029.i01" ;
    schema:description "Robust likelihood-based survival modeling with microarray data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rbsurv_2.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rbsurv/rbsurv_2.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rbsurv_2.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbsurv/bioconductor-rbsurv_2.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-survival" ;
    schema:identifier biotools:rbsurv ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-rbsurv" ;
    schema:softwareVersion "2.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rbsurv.html" .

