@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbsurv a schema1:SoftwareApplication ;
    schema1:alternateName "Robust likelihood-based survival modeling with microarray data" ;
    schema1:citation "doi:10.18637/jss.v029.i01" ;
    schema1:description "This package selects genes associated with survival." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rbsurv_2.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rbsurv/rbsurv_2.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rbsurv_2.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbsurv/bioconductor-rbsurv_2.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rbsurv" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-rbsurv" ;
    schema1:softwareVersion "2.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rbsurv.html" .

