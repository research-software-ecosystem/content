@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rain a schema:SoftwareApplication ;
    schema:description "Rhythmicity Analysis Incorporating Non-parametric Methods" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rain_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rain/rain_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rain_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rain/bioconductor-rain_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-multtest",
        "r-base",
        "r-gmp" ;
    schema:identifier biotools:rain ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-rain" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rain.html" .

