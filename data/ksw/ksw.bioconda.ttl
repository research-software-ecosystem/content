@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ksw a schema:SoftwareApplication ;
    schema:description "Ksw: (interactive) smith-waterman in C" ;
    schema:downloadUrl "https://github.com/nh13/ksw/releases/download/0.3.0/0.3.0.tar.gz" ;
    schema:hasPart "coreutils",
        "zlib" ;
    schema:identifier biotools:ksw ;
    schema:license "MIT" ;
    schema:name "ksw" ;
    schema:softwareVersion "0.3.0" ;
    schema:url "https://github.com/nh13/ksw" .

