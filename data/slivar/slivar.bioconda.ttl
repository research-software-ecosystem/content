@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:slivar a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13073-020-00761-2" ;
    schema:description "filter/annotate variants in VCF/BCF format with simple expressions." ;
    schema:downloadUrl "https://github.com/brentp/slivar/archive/refs/tags/v0.3.4.tar.gz" ;
    schema:hasPart "curl",
        "htslib",
        "tar" ;
    schema:identifier biotools:somalier ;
    schema:license "MIT" ;
    schema:name "slivar" ;
    schema:softwareHelp "https://github.com/brentp/slivar/blob/v0.3.4/README.md" ;
    schema:softwareVersion "0.3.4" ;
    schema:url "https://github.com/brentp/slivar" .

