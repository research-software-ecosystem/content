      "sc:description": "PANDIA is a multimodal AI system designed for robust and interpretable assessment of neonatal pain. It fuses hierarchical representation learning, graph-based reasoning, and meta-learning to analyze video, audio, and physiological signals from infants.",
      "sc:featureList": {
        "@id": "edam:operation_3283"
      },
      "sc:name": "PANDIA: Personalized Adaptive Neuro-symbolic Data-fusion for Infant Assessment",
      "sc:url": "https://github.com/oussama123-ai/pandia"
    },
