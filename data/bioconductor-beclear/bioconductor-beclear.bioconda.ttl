@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-beclear a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0159921" ;
    schema:description "Correction of batch effects in DNA methylation data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BEclear_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BEclear/BEclear_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BEclear_2.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beclear/bioconductor-beclear_2.26.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-abind",
        "r-base",
        "r-data.table",
        "r-dixontest",
        "r-futile.logger",
        "r-ids",
        "r-matrix",
        "r-rcpp",
        "r-rdpack",
        "zlib" ;
    schema:identifier biotools:beclear ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-beclear" ;
    schema:softwareVersion "2.26.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BEclear.html" .

