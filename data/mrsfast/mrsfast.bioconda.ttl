@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:mrsfast a schema1:SoftwareApplication ;
    schema1:alternateName "mrsFAST - micro-read substitution-only Fast Alignment Search Tool." ;
    schema1:citation "doi:10.1038/nmeth0810-576" ;
    schema1:description "mrsFAST - micro-read substitution-only Fast Alignment Search Tool." ;
    schema1:identifier biotools:mrsfast ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "mrsfast" ;
    schema1:softwareVersion "3.4.2" ;
    schema1:url "https://github.com/sfu-compbio/mrsfast" .

