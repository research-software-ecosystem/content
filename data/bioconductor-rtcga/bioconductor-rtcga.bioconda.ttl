@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtcga a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "The Cancer Genome Atlas Data Integration" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RTCGA_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RTCGA/RTCGA_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RTCGA_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtcga/bioconductor-rtcga_1.40.0_src_all.tar.gz" ;
    schema:hasPart "r-assertthat",
        "r-base",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-ggthemes",
        "r-htmltools",
        "r-knitr",
        "r-purrr",
        "r-rcurl",
        "r-rmarkdown",
        "r-rvest",
        "r-scales",
        "r-stringi",
        "r-survival",
        "r-survminer",
        "r-viridis",
        "r-xml",
        "r-xml2" ;
    schema:identifier biotools:rtcga ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-rtcga" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RTCGA.html" .

