@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-specond a schema1:SoftwareApplication ;
    schema1:alternateName "Condition specific detection from expression data" ;
    schema1:citation "doi:10.1186/gb-2011-12-12-413" ;
    schema1:description "This package performs a gene expression data analysis to detect condition-specific genes. Such genes are significantly up- or down-regulated in a small number of conditions. It does so by fitting a mixture of normal distributions to the expression values. Conditions can be environmental conditions, different tissues, organs or any other sources that you wish to compare in terms of gene expression." ;
    schema1:identifier biotools:specond ;
    schema1:license "LGPL (>=2)" ;
    schema1:name "bioconductor-specond" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SpeCond.html" .

