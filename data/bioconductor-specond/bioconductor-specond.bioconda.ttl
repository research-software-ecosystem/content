@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-specond a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2011-12-12-413" ;
    schema:description "Condition specific detection from expression data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SpeCond_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SpeCond/SpeCond_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SpeCond_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-specond/bioconductor-specond_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-fields",
        "r-hwriter",
        "r-mclust",
        "r-rcolorbrewer" ;
    schema:identifier biotools:specond ;
    schema:license "LGPL (>=2)" ;
    schema:name "bioconductor-specond" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SpeCond.html" .

