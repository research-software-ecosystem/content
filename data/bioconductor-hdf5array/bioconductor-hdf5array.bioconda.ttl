@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hdf5array a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "HDF5 datasets as array-like objects in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HDF5Array_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HDF5Array/HDF5Array_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HDF5Array_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hdf5array/bioconductor-hdf5array_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-delayedarray",
        "bioconductor-h5mread",
        "bioconductor-iranges",
        "bioconductor-rhdf5",
        "bioconductor-s4arrays",
        "bioconductor-s4vectors",
        "bioconductor-sparsearray",
        "r-base",
        "r-matrix" ;
    schema:identifier biotools:hdf5array ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-hdf5array" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HDF5Array.html" .

