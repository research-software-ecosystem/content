@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hdf5array a schema1:SoftwareApplication ;
    schema1:alternateName "HDF5 datasets as array-like objects in R" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The HDF5Array package is an HDF5 backend for DelayedArray objects. It implements the HDF5Array, H5SparseMatrix, H5ADMatrix, and TENxMatrix classes, 4 convenient and memory-efficient array-like containers for representing and manipulating either: (1) a conventional (a.k.a. dense) HDF5 dataset, (2) an HDF5 sparse matrix (stored in CSR/CSC/Yale format), (3) the central matrix of an h5ad file (or any matrix in the /layers group), or (4) a 10x Genomics sparse matrix. All these containers are DelayedArray extensions and thus support all operations (delayed or block-processed) supported by DelayedArray objects." ;
    schema1:identifier <https://bio.tools/biotools:hdf5array> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-hdf5array" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HDF5Array.html" .

