@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-arrmnormalization a schema1:SoftwareApplication ;
    schema1:alternateName "Adaptive Robust Regression normalization for Illumina methylation data" ;
    schema1:citation "doi:10.1186/s13059-014-0503-2" ;
    schema1:description "Perform the Adaptive Robust Regression method (ARRm) for the normalization of methylation data from the Illumina Infinium HumanMethylation 450k assay." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ARRmNormalization_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ARRmNormalization_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ARRmNormalization/ARRmNormalization_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-arrmnormalization/bioconductor-arrmnormalization_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:arrmnormalization" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-arrmnormalization" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ARRmNormalization.html" .

