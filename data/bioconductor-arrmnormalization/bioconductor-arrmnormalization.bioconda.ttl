@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-arrmnormalization a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-014-0503-2" ;
    schema:description "Adaptive Robust Regression normalization for Illumina methylation data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ARRmNormalization_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ARRmNormalization_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ARRmNormalization/ARRmNormalization_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-arrmnormalization/bioconductor-arrmnormalization_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-arrmdata",
        "r-base" ;
    schema:identifier biotools:arrmnormalization ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-arrmnormalization" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ARRmNormalization.html" .

