@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-aims a schema1:SoftwareApplication ;
    schema1:alternateName "AIMS : Absolute Assignment of Breast Cancer Intrinsic Molecular Subtype" ;
    schema1:citation "doi:10.1093/jnci/dju357" ;
    schema1:description "This package contains the AIMS implementation. It contains necessary functions to assign the five intrinsic molecular subtypes (Luminal A, Luminal B, Her2-enriched, Basal-like, Normal-like). Assignments could be done on individual samples as well as on dataset of gene expression data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/AIMS_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AIMS_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AIMS/AIMS_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aims/bioconductor-aims_1.42.0_src_all.tar.gz" ;
    schema1:identifier "biotools:aims" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-aims" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AIMS.html" .

