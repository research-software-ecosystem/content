@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-aims a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/jnci/dju357" ;
    schema:description "AIMS : Absolute Assignment of Breast Cancer Intrinsic Molecular Subtype" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/AIMS_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AIMS_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AIMS/AIMS_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aims/bioconductor-aims_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-e1071" ;
    schema:identifier biotools:aims ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-aims" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/AIMS.html" .

