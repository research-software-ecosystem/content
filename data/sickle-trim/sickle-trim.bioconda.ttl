@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sickle-trim a schema:SoftwareApplication ;
    schema:description "Windowed Adaptive Trimming for fastq files using quality." ;
    schema:downloadUrl "https://github.com/najoshi/sickle/archive/v1.33.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:sickle ;
    schema:license "MIT" ;
    schema:name "sickle-trim" ;
    schema:softwareHelp "https://github.com/najoshi/sickle/blob/v1.33/README.md" ;
    schema:softwareVersion "1.33" ;
    schema:url "https://github.com/najoshi/sickle" .

