@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsri a schema1:SoftwareApplication ;
    schema1:alternateName "Gene Set Regulation Index" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The GSRI package estimates the number of differentially expressed genes in gene sets, utilizing the concept of the Gene Set Regulation Index (GSRI)." ;
    schema1:identifier biotools:gsri ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-gsri" ;
    schema1:softwareVersion "2.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSRI.html" .

