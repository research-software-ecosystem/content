@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gsri a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene Set Regulation Index" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GSRI_2.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSRI/GSRI_2.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSRI_2.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsri/bioconductor-gsri_2.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-genefilter",
        "bioconductor-gseabase",
        "bioconductor-les",
        "r-base",
        "r-fdrtool" ;
    schema:identifier biotools:gsri ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-gsri" ;
    schema:softwareVersion "2.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GSRI.html" .

