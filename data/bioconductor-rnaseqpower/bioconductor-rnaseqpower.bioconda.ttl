@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rnaseqpower a schema1:SoftwareApplication ;
    schema1:alternateName "Sample size for RNAseq studies" ;
    schema1:citation "doi:10.1089/cmb.2012.0283" ;
    schema1:description "RNA-seq, sample size" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RNASeqPower_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RNASeqPower/RNASeqPower_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RNASeqPower_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rnaseqpower/bioconductor-rnaseqpower_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rnaseqpower" ;
    schema1:license "LGPL (>=2)" ;
    schema1:name "bioconductor-rnaseqpower" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RNASeqPower.html" .

