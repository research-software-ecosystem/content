@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rnaseqpower a schema:SoftwareApplication ;
    schema:citation "doi:10.1089/cmb.2012.0283" ;
    schema:description "Sample size for RNAseq studies" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RNASeqPower_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RNASeqPower/RNASeqPower_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RNASeqPower_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rnaseqpower/bioconductor-rnaseqpower_1.50.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:rnaseqpower ;
    schema:license "LGPL (>=2)" ;
    schema:name "bioconductor-rnaseqpower" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RNASeqPower.html" .

