@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:qtlseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1111/tpj.12105" ;
    schema:description "QTL-seq: pipeline to identify causative mutations responsible for a phenotype." ;
    schema:downloadUrl "https://github.com/YuSugihara/QTL-seq/releases/download/v2.3.0/QTL-seq-2.3.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:qtlseq ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "qtlseq" ;
    schema:softwareVersion "2.3.0" ;
    schema:url "https://github.com/YuSugihara/QTL-seq" .

