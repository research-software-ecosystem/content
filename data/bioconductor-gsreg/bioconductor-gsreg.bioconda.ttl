@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsreg a schema1:SoftwareApplication ;
    schema1:citation "doi:10.4137/CIN.S14066" ;
    schema1:description "Gene Set Regulation (GS-Reg)" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GSReg_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSReg/GSReg_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSReg_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsreg/bioconductor-gsreg_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-genomicfeatures",
        "bioconductor-homo.sapiens",
        "bioconductor-org.hs.eg.db",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:gsreg ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-gsreg" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSReg.html" .

