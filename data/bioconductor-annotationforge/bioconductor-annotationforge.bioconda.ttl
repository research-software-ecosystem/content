@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annotationforge a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for building SQLite-based annotation data packages" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Provides code for generating Annotation packages and their databases.  Packages produced are intended to be used with AnnotationDbi." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/AnnotationForge_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AnnotationForge_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AnnotationForge/AnnotationForge_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationforge/bioconductor-annotationforge_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:annotationforge" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-annotationforge" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationForge.html" .

