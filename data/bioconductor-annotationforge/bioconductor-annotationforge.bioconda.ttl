@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annotationforge a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Tools for building SQLite-based annotation data packages" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/AnnotationForge_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AnnotationForge_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AnnotationForge/AnnotationForge_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationforge/bioconductor-annotationforge_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-s4vectors",
        "r-base",
        "r-dbi",
        "r-rcurl",
        "r-rsqlite",
        "r-xml" ;
    schema:identifier biotools:annotationforge ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-annotationforge" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationForge.html" .

