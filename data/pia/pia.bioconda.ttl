@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pia a schema:SoftwareApplication ;
    schema:citation "doi:10.1021/acs.jproteome.5b00121" ;
    schema:description "PIA is a toolbox for MS based protein inference and identification analysis." ;
    schema:downloadUrl "https://github.com/medbioinf/pia/releases/download/1.5.9/pia-1.5.9.zip" ;
    schema:identifier biotools:pia ;
    schema:license "BSD-3-Clause" ;
    schema:name "pia" ;
    schema:softwareVersion "1.5.9" ;
    schema:url "https://github.com/medbioinf/pia" .

