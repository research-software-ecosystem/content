@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-beaddatapackr a schema1:SoftwareApplication ;
    schema1:alternateName "Compression of Illumina BeadArray data" ;
    schema1:description "Provides functionality for the compression and decompression of raw bead-level data from the Illumina BeadArray platform." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BeadDataPackR_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BeadDataPackR/BeadDataPackR_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BeadDataPackR_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beaddatapackr/bioconductor-beaddatapackr_1.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:beaddatapackr" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-beaddatapackr" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BeadDataPackR.html" .

