@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-beaddatapackr a schema:SoftwareApplication ;
    schema:description "Compression of Illumina BeadArray data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BeadDataPackR_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BeadDataPackR/BeadDataPackR_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BeadDataPackR_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beaddatapackr/bioconductor-beaddatapackr_1.62.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:beaddatapackr ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-beaddatapackr" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BeadDataPackR.html" .

