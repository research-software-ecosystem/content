@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-m3drop a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/1873-3468.12684" ;
    schema:description "Michaelis-Menten Modelling of Dropouts in single-cell RNASeq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/M3Drop_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/M3Drop/M3Drop_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/M3Drop_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-m3drop/bioconductor-m3drop_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-scater",
        "r-base",
        "r-bbmle",
        "r-gplots",
        "r-hmisc",
        "r-irlba",
        "r-matrix",
        "r-matrixstats",
        "r-numderiv",
        "r-rcolorbrewer",
        "r-reldist",
        "r-statmod" ;
    schema:identifier biotools:m3drop ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-m3drop" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/M3Drop.html" .

