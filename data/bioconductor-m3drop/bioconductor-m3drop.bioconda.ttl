@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-m3drop a schema1:SoftwareApplication ;
    schema1:alternateName "Michaelis-Menten Modelling of Dropouts in single-cell RNASeq" ;
    schema1:citation "doi:10.1002/1873-3468.12684" ;
    schema1:description "This package fits a model to the pattern of dropouts in single-cell RNASeq data. This model is used as a null to identify significantly variable (i.e. differentially expressed) genes for use in downstream analysis, such as clustering cells. Also includes an method for calculating exact Pearson residuals in UMI-tagged data using a library-size aware negative binomial model." ;
    schema1:identifier biotools:m3drop ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-m3drop" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/M3Drop.html" .

