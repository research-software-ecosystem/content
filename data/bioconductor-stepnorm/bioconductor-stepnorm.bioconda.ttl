@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-stepnorm a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1109/IEMBS.2004.1403830" ;
    schema1:description "Stepwise normalization functions for cDNA microarrays" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/stepNorm_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/stepNorm/stepNorm_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/stepNorm_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-stepnorm/bioconductor-stepnorm_1.82.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-marray",
        "r-base",
        "r-mass" ;
    schema1:identifier biotools:stepnorm ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-stepnorm" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/stepNorm.html" .

