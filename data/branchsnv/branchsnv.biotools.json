        {
            "cmd": "branchsnv find \\\n  --alignment alignment.nex \\\n  --tree tree.nwk \\\n  --outgroup-file outgroup_tips.txt \\\n  --clade-tips clade_tips.txt \\\n  --mode both \\\n  --output branch_snvs.tsv \\\n  --members-output branch_members.txt \\\n  --report branchsnv_report.json",
