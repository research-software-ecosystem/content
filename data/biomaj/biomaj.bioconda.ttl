@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:biomaj a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn325" ;
    schema:description "Automates the update cycle and the supervision of the locally mirrored databank repository" ;
    schema:downloadUrl "https://pypi.python.org/packages/ae/27/1ca70bd9b7c33dc66068d970158a0af1f79ad8823c5bb04cccb21a4eec3b/biomaj-3.0.19.tar.gz" ;
    schema:hasPart "bcrypt",
        "drmaa",
        "elasticsearch",
        "future",
        "ldap3",
        "mock",
        "nose",
        "pip",
        "pycurl",
        "pymongo",
        "python",
        "setuptools",
        "tabulate" ;
    schema:identifier biotools:biomaj ;
    schema:license "GNU Affero General Public License v3 or later (AGPLv3+)" ;
    schema:name "biomaj" ;
    schema:softwareVersion "3.0.19" ;
    schema:url "http://biomaj.genouest.org" .

