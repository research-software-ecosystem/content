@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:biomaj a schema1:SoftwareApplication ;
    schema1:alternateName "Automates the update cycle and the supervision of the locally mirrored databank repository" ;
    schema1:citation "doi:10.1093/bioinformatics/btn325" ;
    schema1:description "Automates the update cycle and the supervision of the locally mirrored databank repository" ;
    schema1:identifier biotools:biomaj ;
    schema1:license "GNU Affero General Public License v3 or later (AGPLv3+)" ;
    schema1:name "biomaj" ;
    schema1:softwareVersion "3.0.19" ;
    schema1:url "http://biomaj.genouest.org" .

