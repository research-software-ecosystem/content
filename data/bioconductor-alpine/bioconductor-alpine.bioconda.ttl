@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-alpine a schema1:SoftwareApplication ;
    schema1:alternateName "alpine" ;
    schema1:description "Fragment sequence bias modeling and correction for RNA-seq transcript abundance estimation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/alpine_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/alpine/alpine_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/alpine_1.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-alpine/bioconductor-alpine_1.26.0_src_all.tar.gz" ;
    schema1:identifier "biotools:alpine" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-alpine" ;
    schema1:softwareVersion "1.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/alpine.html" .

