@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mity a schema:SoftwareApplication ;
    schema:author "tm4zza" ;
    schema:citation "doi:10.26502/jbsb.5107074" ;
    schema:description "Mity is a bioinformatic analysis pipeline designed to call mitochondrial SNV and INDEL variants from Whole Genome Sequencing (WGS) data." ;
    schema:downloadUrl "https://github.com/KCCG/mity/archive/refs/tags/2.0.1.zip" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:mity ;
    schema:license "MIT" ;
    schema:maintainer "tm4zza" ;
    schema:name "mity" ;
    schema:softwareHelp "https://github.com/KCCG/mity/blob/2.0.1/README.md" ;
    schema:softwareVersion "2.0.1" ;
    schema:url "https://github.com/KCCG/mity" .

