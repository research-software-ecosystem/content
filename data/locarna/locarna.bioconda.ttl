@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:locarna a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.0030065" ;
    schema:description "Multiple alignment of RNAs." ;
    schema:downloadUrl "https://github.com/s-will/LocARNA/releases/download/v2.0.1/locarna-2.0.1.tar.gz" ;
    schema:hasPart "perl",
        "viennarna" ;
    schema:identifier biotools:locarna ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "locarna" ;
    schema:softwareHelp "https://s-will.github.io/LocARNA" ;
    schema:softwareVersion "2.0.1" ;
    schema:url "https://github.com/s-will/LocARNA" .

