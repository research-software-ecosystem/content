@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:adapter_removal a schema1:SoftwareApplication ;
    bioschemas:output "fastqsanger",
        "txt" ;
    schema1:codeRepository "https://github.com/MikkelSchubert/adapterremoval" ;
    schema1:dateCreated "2022-05-04" ;
    schema1:description "Removes residual adapter sequences from single-end (SE) or paired-end (PE) FASTQ reads." ;
    schema1:encodingFormat "fastqsanger",
        "txt" ;
    schema1:featureList edam:operation_0232,
        edam:operation_3192,
        edam:operation_3237 ;
    schema1:identifier biotools:adapterremoval,
        bioconda:adapterremoval ;
    schema1:keywords "Fasta Manipulation",
        "Sequence Analysis" ;
    schema1:name "adapter_removal" ;
    schema1:softwareVersion "2.3.4" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/adapter_removal" .

