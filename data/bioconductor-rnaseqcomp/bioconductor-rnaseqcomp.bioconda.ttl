@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rnaseqcomp a schema:SoftwareApplication ;
    schema:description "Benchmarks for RNA-seq Quantification Pipelines" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rnaseqcomp_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rnaseqcomp/rnaseqcomp_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rnaseqcomp_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rnaseqcomp/bioconductor-rnaseqcomp_1.40.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:rnaseqcomp ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-rnaseqcomp" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rnaseqcomp.html" .

