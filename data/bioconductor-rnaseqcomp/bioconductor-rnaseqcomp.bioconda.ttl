@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rnaseqcomp a schema1:SoftwareApplication ;
    schema1:alternateName "Benchmarks for RNA-seq Quantification Pipelines" ;
    schema1:description "Several quantitative and visualized benchmarks for RNA-seq quantification pipelines. Two-condition quantifications for genes, transcripts, junctions or exons by each pipeline with necessary meta information should be organized into numeric matrices in order to proceed the evaluation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rnaseqcomp_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rnaseqcomp/rnaseqcomp_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rnaseqcomp_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rnaseqcomp/bioconductor-rnaseqcomp_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rnaseqcomp" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-rnaseqcomp" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rnaseqcomp.html" .

