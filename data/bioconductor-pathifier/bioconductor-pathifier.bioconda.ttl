@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pathifier a schema:SoftwareApplication ;
    schema:citation "doi:10.1073/pnas.1219651110" ;
    schema:description "Quantify deregulation of pathways in cancer" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pathifier_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pathifier/pathifier_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pathifier_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathifier/bioconductor-pathifier_1.48.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-princurve",
        "r-r.oo" ;
    schema:identifier biotools:pathifier ;
    schema:license "Artistic-1.0" ;
    schema:name "bioconductor-pathifier" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pathifier.html" .

