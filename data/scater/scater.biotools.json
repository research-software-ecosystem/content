                    }
                ],
                "citationCount": 1756,
                "date": "2017-04-01T00:00:00Z",
                "journal": "Bioinformatics (Oxford, England)",
                "title": "Scater: pre-processing, quality control, normalization and visualization of single-cell RNA-seq data in R."
