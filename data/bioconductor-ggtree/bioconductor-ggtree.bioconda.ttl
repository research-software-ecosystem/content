@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ggtree a schema:SoftwareApplication ;
    schema:citation "doi:10.1111/2041-210X.12628" ;
    schema:description "an R package for visualization of tree and annotation data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ggtree_4.0.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ggtree/ggtree_4.0.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ggtree_4.0.4.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ggtree/bioconductor-ggtree_4.0.4_src_all.tar.gz" ;
    schema:hasPart "bioconductor-treeio",
        "r-ape",
        "r-aplot",
        "r-base",
        "r-cli",
        "r-dplyr",
        "r-ggfun",
        "r-ggiraph",
        "r-ggplot2",
        "r-magrittr",
        "r-purrr",
        "r-rlang",
        "r-scales",
        "r-tidyr",
        "r-tidytree",
        "r-yulab.utils" ;
    schema:identifier biotools:ggtree ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-ggtree" ;
    schema:softwareVersion "4.0.4" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ggtree.html" .

