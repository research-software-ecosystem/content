@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-deformats a schema1:SoftwareApplication ;
    schema1:alternateName "Differential gene expression data formats converter" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Convert between different data formats used by differential gene expression analysis tools." ;
    schema1:identifier <https://bio.tools/biotools:deformats> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-deformats" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DEFormats.html" .

