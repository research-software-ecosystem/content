@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:carna a schema:SoftwareApplication ;
    schema:description "Constraint-based Alignment of RNA Ensembles" ;
    schema:downloadUrl "http://www.bioinf.uni-leipzig.de/~will/Software/CARNA/Releases/carna-1.3.3.tar.gz" ;
    schema:hasPart "gecode",
        "locarna" ;
    schema:identifier biotools:carna ;
    schema:license "GPL" ;
    schema:name "carna" ;
    schema:softwareVersion "1.3.3" ;
    schema:url "https://www.bioinf.uni-leipzig.de/~will/Software/CARNA/" .

