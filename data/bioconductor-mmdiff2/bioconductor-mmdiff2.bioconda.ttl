@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mmdiff2 a schema1:SoftwareApplication ;
    schema1:alternateName "Statistical Testing for ChIP-Seq data sets" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package detects statistically significant differences between read enrichment profiles in different ChIP-Seq samples. To take advantage of shape differences it uses Kernel methods (Maximum Mean Discrepancy, MMD)." ;
    schema1:identifier <https://bio.tools/biotools:mmdiff2> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mmdiff2" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MMDiff2.html" .

