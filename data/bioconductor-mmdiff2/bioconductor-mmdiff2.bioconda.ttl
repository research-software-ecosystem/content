@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mmdiff2 a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Statistical Testing for ChIP-Seq data sets" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MMDiff2_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MMDiff2/MMDiff2_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MMDiff2_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mmdiff2/bioconductor-mmdiff2_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "r-base",
        "r-ggplot2",
        "r-locfit",
        "r-rcolorbrewer",
        "r-shiny" ;
    schema1:identifier biotools:mmdiff2 ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mmdiff2" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MMDiff2.html" .

