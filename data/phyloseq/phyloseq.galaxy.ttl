    schema1:encodingFormat "pdf",
        "phyloseq",
        "tabular" ;
    schema1:featureList edam:operation_0337 ;
    schema1:identifier biotools:phyloseq,
        bioconda:bioconductor-phyloseq ;
    schema1:isPartOf <https://galaxy.mesocentre.uca.fr>,
