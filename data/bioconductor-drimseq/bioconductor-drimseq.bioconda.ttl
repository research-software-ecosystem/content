@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-drimseq a schema:SoftwareApplication ;
    schema:description "Differential transcript usage and tuQTL analyses with Dirichlet-multinomial model in RNA-seq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DRIMSeq_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DRIMSeq/DRIMSeq_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DRIMSeq_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-drimseq/bioconductor-drimseq_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-edger",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "r-base",
        "r-ggplot2",
        "r-mass",
        "r-reshape2" ;
    schema:identifier biotools:drimseq ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-drimseq" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DRIMSeq.html" .

