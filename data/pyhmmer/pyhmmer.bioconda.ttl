@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyhmmer a schema:SoftwareApplication ;
    schema:author "althonos" ;
    schema:citation "doi:10.1093/bioinformatics/btad214" ;
    schema:description "Cython bindings and Python interface to HMMER3." ;
    schema:downloadUrl "https://pypi.org/packages/source/p/pyhmmer/pyhmmer-0.12.1.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python",
        "scikit-build-core",
        "setuptools" ;
    schema:identifier biotools:pyhmmer ;
    schema:license "MIT" ;
    schema:maintainer "althonos" ;
    schema:name "pyhmmer" ;
    schema:softwareHelp "https://pyhmmer.readthedocs.io" ;
    schema:softwareVersion "0.12.1" ;
    schema:url "https://github.com/althonos/pyhmmer" .

