@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cummerbund a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nprot.2012.016" ;
    schema:description "Analysis, exploration, manipulation, and visualization of Cufflinks high-throughput sequencing data." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cummeRbund_2.48.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/cummeRbund/cummeRbund_2.48.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/cummeRbund_2.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cummerbund/bioconductor-cummerbund_2.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-gviz",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "r-base",
        "r-fastcluster",
        "r-ggplot2",
        "r-plyr",
        "r-reshape2",
        "r-rsqlite" ;
    schema:identifier biotools:cummerbund ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-cummerbund" ;
    schema:softwareVersion "2.48.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/cummeRbund.html" .

