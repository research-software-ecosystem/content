@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cummerbund a schema1:SoftwareApplication ;
    schema1:alternateName "Analysis, exploration, manipulation, and visualization of Cufflinks high-throughput sequencing data." ;
    schema1:citation "doi:10.1038/nprot.2012.016" ;
    schema1:description "Allows for persistent storage, access, exploration, and manipulation of Cufflinks high-throughput sequencing data.  In addition, provides numerous plotting functions for commonly used visualizations." ;
    schema1:identifier biotools:cummerbund ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-cummerbund" ;
    schema1:softwareVersion "2.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/cummeRbund.html" .

