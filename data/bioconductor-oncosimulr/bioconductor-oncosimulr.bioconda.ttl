@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-oncosimulr a schema:SoftwareApplication ;
    schema:description "Forward Genetic Simulation of Cancer Progression with Epistasis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/OncoSimulR_4.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OncoSimulR/OncoSimulR_4.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OncoSimulR_4.12.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-oncosimulr/bioconductor-oncosimulr_4.12.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-rgraphviz",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-car",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-ggrepel",
        "r-gtools",
        "r-igraph",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-smatr",
        "r-stringr",
        "zlib" ;
    schema:identifier biotools:oncosimulr ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-oncosimulr" ;
    schema:softwareVersion "4.12.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/OncoSimulR.html" .

