@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chipqc a schema1:SoftwareApplication ;
    schema1:description "Quality metrics for ChIPseq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ChIPQC_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/ChIPQC/ChIPQC_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/ChIPQC_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipqc/bioconductor-chipqc_1.42.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-chipseq",
        "bioconductor-diffbind",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-txdb.celegans.ucsc.ce6.ensgene",
        "bioconductor-txdb.dmelanogaster.ucsc.dm3.ensgene",
        "bioconductor-txdb.hsapiens.ucsc.hg18.knowngene",
        "bioconductor-txdb.hsapiens.ucsc.hg19.knowngene",
        "bioconductor-txdb.mmusculus.ucsc.mm10.knowngene",
        "bioconductor-txdb.mmusculus.ucsc.mm9.knowngene",
        "bioconductor-txdb.rnorvegicus.ucsc.rn4.ensgene",
        "r-base",
        "r-ggplot2",
        "r-gtools",
        "r-nozzle.r1",
        "r-reshape2" ;
    schema1:identifier biotools:chipqc ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-chipqc" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/ChIPQC.html" .

