@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hem a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bth192" ;
    schema:description "Heterogeneous error model for identification of differentially expressed genes under multiple conditions" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HEM_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HEM/HEM_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HEM_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hem/bioconductor-hem_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:hem ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-hem" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HEM.html" .

