@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hem a schema1:SoftwareApplication ;
    schema1:alternateName "Heterogeneous error model for identification of differentially expressed genes under multiple conditions" ;
    schema1:citation "doi:10.1093/bioinformatics/bth192" ;
    schema1:description "This package fits heterogeneous error models for analysis of microarray data" ;
    schema1:identifier <https://bio.tools/biotools:hem> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-hem" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HEM.html" .

