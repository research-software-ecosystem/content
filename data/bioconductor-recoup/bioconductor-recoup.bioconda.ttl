@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-recoup a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "An R package for the creation of complex genomic profile plots" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/recoup_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/recoup/recoup_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/recoup_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-recoup/bioconductor-recoup_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-complexheatmap",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-txdbmaker",
        "r-base",
        "r-circlize",
        "r-ggplot2",
        "r-httr",
        "r-rsqlite",
        "r-stringr" ;
    schema:identifier biotools:recoup ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-recoup" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/recoup.html" .

