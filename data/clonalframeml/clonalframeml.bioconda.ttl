@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:clonalframeml a schema:SoftwareApplication ;
    schema:description "Efficient inferencing of recombination in bacterial genomes." ;
    schema:downloadUrl "https://github.com/xavierdidelot/ClonalFrameML/archive/refs/tags/v1.20.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:clonalframeml ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "clonalframeml" ;
    schema:softwareHelp "https://github.com/xavierdidelot/clonalframeml/wiki" ;
    schema:softwareVersion "1.2" ;
    schema:url "https://github.com/xavierdidelot/ClonalFrameML" .

