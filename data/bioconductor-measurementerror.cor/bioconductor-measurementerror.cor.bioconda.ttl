@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-measurementerror.cor a schema1:SoftwareApplication ;
    schema1:alternateName "Measurement Error model estimate for correlation coefficient" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Two-stage measurement error model for correlation estimation with smaller bias than the usual sample correlation" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MeasurementError.cor_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MeasurementError.cor/MeasurementError.cor_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MeasurementError.cor_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-measurementerror.cor/bioconductor-measurementerror.cor_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:measurementerror.cor" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-measurementerror.cor" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MeasurementError.cor.html" .

