@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-measurementerror.cor a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Measurement Error model estimate for correlation coefficient" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MeasurementError.cor_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MeasurementError.cor/MeasurementError.cor_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MeasurementError.cor_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-measurementerror.cor/bioconductor-measurementerror.cor_1.82.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:measurementerror.cor ;
    schema:license "LGPL" ;
    schema:name "bioconductor-measurementerror.cor" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MeasurementError.cor.html" .

