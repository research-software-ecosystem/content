@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyfasta a schema:SoftwareApplication ;
    schema:description "fast, memory-efficient, pythonic (and command-line) access to fasta sequence files" ;
    schema:downloadUrl "https://pypi.python.org/packages/source/p/pyfasta/pyfasta-0.5.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:pyfasta ;
    schema:license "MIT" ;
    schema:name "pyfasta" ;
    schema:softwareVersion "0.5.2" ;
    schema:url "http://github.com/brentp/pyfasta/" .

