@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-qsea a schema:SoftwareApplication ;
    schema:description "IP-seq data analysis and vizualization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/qsea_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/qsea/qsea_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/qsea_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qsea/bioconductor-qsea_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-hmmcopy",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-gtools",
        "r-zoo",
        "zlib" ;
    schema:identifier biotools:qsea ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-qsea" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/qsea.html" .

