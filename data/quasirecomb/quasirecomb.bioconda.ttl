@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:quasirecomb a schema:SoftwareApplication ;
    schema:citation "doi:10.1089/cmb.2012.0232" ;
    schema:description "Software of Inference of Quasispecies subjected to Recombination" ;
    schema:downloadUrl "https://github.com/cbg-ethz/QuasiRecomb/releases/download/v1.2/QuasiRecomb.jar" ;
    schema:identifier biotools:QuasiRecomb ;
    schema:license "GNU GPLv3" ;
    schema:name "quasirecomb" ;
    schema:softwareVersion "1.2" ;
    schema:url "https://github.com/cbg-ethz/QuasiRecomb" .

