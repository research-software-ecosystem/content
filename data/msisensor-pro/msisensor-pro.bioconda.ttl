@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:msisensor-pro a schema1:SoftwareApplication ;
    schema1:alternateName "Microsatellite Instability (MSI) detection using high-throughput sequencing data." ;
