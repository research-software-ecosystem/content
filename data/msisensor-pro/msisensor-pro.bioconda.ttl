@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:msisensor-pro a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.gpb.2020.02.001" ;
    schema:description "Microsatellite Instability (MSI) detection using high-throughput sequencing data." ;
    schema:downloadUrl "https://github.com/xjtu-omics/msisensor-pro/archive/v1.3.0.tar.gz" ;
    schema:hasPart "bzip2",
        "htslib",
        "libcurl",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:msisensor-pro ;
    schema:license "Custom Licence" ;
    schema:name "msisensor-pro" ;
    schema:softwareHelp "https://github.com/xjtu-omics/msisensor-pro/wiki" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "https://github.com/xjtu-omics/msisensor-pro" .

