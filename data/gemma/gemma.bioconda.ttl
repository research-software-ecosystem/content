@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gemma a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ng.2310" ;
    schema:description "Linear mixed models (LMMs) for genome-wide association (GWA)." ;
    schema:downloadUrl "https://github.com/genetics-statistics/GEMMA/archive/refs/tags/v0.98.5.tar.gz" ;
    schema:hasPart "eigen",
        "gsl",
        "openblas",
        "zlib" ;
    schema:identifier biotools:gemma_algorithm ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "gemma" ;
    schema:softwareHelp "https://github.com/genetics-statistics/GEMMA/blob/v0.98.5/README.md" ;
    schema:softwareVersion "0.98.5" ;
    schema:url "https://github.com/genetics-statistics/GEMMA" .

