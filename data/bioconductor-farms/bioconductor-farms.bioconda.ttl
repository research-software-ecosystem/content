@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-farms a schema:SoftwareApplication ;
    schema:description "FARMS - Factor Analysis for Robust Microarray Summarization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/farms_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/farms/farms_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/farms_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-farms/bioconductor-farms_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "r-base",
        "r-mass" ;
    schema:identifier biotools:farms ;
    schema:license "LGPL (>= 2.1)" ;
    schema:name "bioconductor-farms" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/farms.html" .

