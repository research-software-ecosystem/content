@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:rasusa a schema1:SoftwareApplication ;
    bioschemas:output "bam" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:operation_2403,
        edam:topic_0080,
        edam:topic_0196,
        edam:topic_0622,
        edam:topic_3168,
        edam:topic_3170 ;
    schema1:codeRepository "https://github.com/mbhall88/rasusa" ;
    schema1:dateCreated "2024-02-16" ;
    schema1:description "Randomly subsample sequencing reads to a specified coverage" ;
    schema1:encodingFormat "bam" ;
    schema1:featureList edam:operation_3180,
        edam:operation_3218 ;
    schema1:identifier biotools:rasusa,
        bioconda:rasusa ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "rasusa" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/rasusa" .

