@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:treesimulator a schema:SoftwareApplication ;
    schema:author "annazhukova" ;
    schema:citation "doi:10.1101/2024.09.09.24313296" ;
    schema:description "Simulation of rooted phylogenetic trees under a given Multitype Birth–Death (MTBD) model." ;
    schema:downloadUrl "https://pypi.org/packages/source/t/treesimulator/treesimulator-0.2.27.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:treesimulator ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "annazhukova" ;
    schema:name "treesimulator" ;
    schema:softwareHelp "https://github.com/evolbioinfo/treesimulator/blob/0.2.27/README.md" ;
    schema:softwareVersion "0.2.27" ;
    schema:url "https://github.com/evolbioinfo/treesimulator" .

