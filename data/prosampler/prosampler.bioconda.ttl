@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:prosampler a schema:SoftwareApplication ;
    schema:description "An ultra-fast motif finding program in large ChIP-seq datasets." ;
    schema:downloadUrl "https://github.com/zhengchangsulab/ProSampler/raw/master/PROSMPLER_v1.5.tar.gz" ;
    schema:identifier biotools:prosampler ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "prosampler" ;
    schema:softwareVersion "1.5" ;
    schema:url "https://github.com/zhengchangsulab/ProSampler" .

