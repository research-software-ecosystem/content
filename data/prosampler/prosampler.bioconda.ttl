@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:prosampler a schema1:SoftwareApplication ;
    schema1:alternateName "An ultra-fast motif finding program in large ChIP-seq datasets." ;
    schema1:description "An ultra-fast motif finding program in large ChIP-seq datasets." ;
    schema1:identifier <https://bio.tools/biotools:prosampler> ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "prosampler" ;
    schema1:softwareVersion "1.5" ;
    schema1:url "https://github.com/zhengchangsulab/ProSampler" .

