@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trimal a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp348" ;
    schema:description "A tool for the automated removal of spurious sequences or poorly aligned regions from a multiple sequence alignment" ;
    schema:downloadUrl "https://github.com/inab/trimal/archive/refs/tags/v1.5.1.tar.gz" ;
    schema:identifier biotools:trimAl ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "trimal" ;
    schema:softwareHelp "https://trimal.readthedocs.io" ;
    schema:softwareVersion "1.5.1" ;
    schema:url "https://trimal.readthedocs.io" .

