@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gfastats a schema:SoftwareApplication ;
    schema:description "The swiss army knife for genome assembly" ;
    schema:downloadUrl "https://github.com/vgl-hub/gfastats/releases/download/v1.3.11/gfastats.v1.3.11-with_submodules.zip" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:gfastats ;
    schema:license "MIT" ;
    schema:name "gfastats" ;
    schema:softwareVersion "1.3.11" ;
    schema:url "https://github.com/vgl-hub/gfastats" .

