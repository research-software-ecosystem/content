@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:gfastats a schema1:SoftwareApplication ;
    schema1:alternateName "The swiss army knife for genome assembly" ;
    schema1:description "The swiss army knife for genome assembly" ;
    schema1:identifier <https://bio.tools/biotools:gfastats>,
        "usegalaxy-eu:gfastats" ;
    schema1:license "MIT" ;
    schema1:name "gfastats" ;
    schema1:softwareVersion "1.3.11" ;
    schema1:url "https://github.com/vgl-hub/gfastats" .

