@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dyndoc a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Dynamic document tools" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DynDoc_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DynDoc/DynDoc_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DynDoc_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dyndoc/bioconductor-dyndoc_1.88.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:dyndoc ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-dyndoc" ;
    schema:softwareVersion "1.88.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DynDoc.html" .

