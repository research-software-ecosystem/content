@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dyndoc a schema1:SoftwareApplication ;
    schema1:alternateName "Dynamic document tools" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A set of functions to create and interact with dynamic documents and vignettes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DynDoc_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DynDoc/DynDoc_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DynDoc_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dyndoc/bioconductor-dyndoc_1.88.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dyndoc" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-dyndoc" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DynDoc.html" .

