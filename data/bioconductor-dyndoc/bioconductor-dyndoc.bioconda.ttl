@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dyndoc a schema1:SoftwareApplication ;
    schema1:alternateName "Dynamic document tools" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A set of functions to create and interact with dynamic documents and vignettes." ;
    schema1:identifier <https://bio.tools/biotools:dyndoc> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-dyndoc" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DynDoc.html" .

