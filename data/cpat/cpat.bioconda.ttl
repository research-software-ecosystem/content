@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:cpat a schema1:SoftwareApplication ;
    schema1:alternateName "Coding Potential Assessment Tool." ;
    schema1:citation "doi:10.1093/nar/gkt006" ;
    schema1:description "Coding Potential Assessment Tool." ;
    schema1:identifier <https://bio.tools/biotools:cpat>,
        "usegalaxy-eu:cpat" ;
    schema1:license "GPL-2.0-or-later" ;
    schema1:name "cpat" ;
    schema1:softwareVersion "3.0.5" ;
    schema1:url "https://github.com/liguowang/cpat" .

