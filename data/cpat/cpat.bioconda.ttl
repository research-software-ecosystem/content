@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cpat a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkt006" ;
    schema:description "Coding Potential Assessment Tool." ;
    schema:downloadUrl "https://pypi.io/packages/source/C/CPAT/CPAT-3.0.5.tar.gz" ;
    schema:hasPart "bx-python",
        "cython",
        "nose",
        "numpy",
        "pip",
        "pysam",
        "python" ;
    schema:identifier biotools:cpat ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "cpat" ;
    schema:softwareHelp "https://cpat.readthedocs.io/en/latest" ;
    schema:softwareVersion "3.0.5" ;
    schema:url "https://github.com/liguowang/cpat" .

