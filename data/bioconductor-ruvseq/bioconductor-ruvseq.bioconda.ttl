@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ruvseq a schema1:SoftwareApplication ;
    schema1:description "Remove Unwanted Variation from RNA-Seq Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RUVSeq_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RUVSeq/RUVSeq_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RUVSeq_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ruvseq/bioconductor-ruvseq_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-edaseq",
        "bioconductor-edger",
        "r-base",
        "r-mass" ;
    schema1:identifier biotools:ruvseq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ruvseq" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RUVSeq.html" .

