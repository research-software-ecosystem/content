@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:alder a schema:SoftwareApplication ;
    schema:citation "doi:10.1534/genetics.112.147330" ;
    schema:description "The ALDER software computes the weighted linkage disequilibrium (LD) statistic for making inference about population admixture" ;
    schema:downloadUrl "http://cb.csail.mit.edu/cb/alder/alder_v1.03.tar.gz" ;
    schema:hasPart "fftw",
        "liblapack" ;
    schema:identifier biotools:alder ;
    schema:license "Custom OSS" ;
    schema:name "alder" ;
    schema:softwareVersion "1.03" ;
    schema:url "http://cb.csail.mit.edu/cb/alder/" .

