@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rots a schema1:SoftwareApplication ;
    schema1:alternateName "Reproducibility-Optimized Test Statistic" ;
    schema1:citation "doi:10.1109/tcbb.2007.1078" ;
    schema1:description "Calculates the Reproducibility-Optimized Test Statistic (ROTS) for differential testing in omics data." ;
    schema1:identifier <https://bio.tools/biotools:rots> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-rots" ;
    schema1:softwareVersion "2.2.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ROTS.html" .

