@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rots a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/tcbb.2007.1078" ;
    schema:description "Reproducibility-Optimized Test Statistic" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ROTS_2.2.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ROTS/ROTS_2.2.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ROTS_2.2.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rots/bioconductor-rots_2.2.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocparallel",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-lme4",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:rots ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-rots" ;
    schema:softwareVersion "2.2.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ROTS.html" .

