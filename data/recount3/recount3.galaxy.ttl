@prefix bioconda: <https://bioconda.github.io/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:recount3 a schema1:SoftwareApplication ;
    schema1:applicationSubCategory edam:topic_3168 ;
    schema1:description "Retrieve harmonized RNA-seq gene expression data from recount3" ;
    schema1:featureList edam:operation_2238,
        edam:operation_3800 ;
    schema1:identifier biotools:recount,
        bioconda:bioconductor-recount3 ;
    schema1:keywords "Data Source",
        "Transcriptomics" ;
    schema1:name "recount3" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/LieberInstitute/recount3" .

