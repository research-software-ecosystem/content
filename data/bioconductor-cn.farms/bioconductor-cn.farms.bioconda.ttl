@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cn.farms a schema1:SoftwareApplication ;
    schema1:alternateName "cn.FARMS - factor analysis for copy number estimation" ;
    schema1:citation "doi:10.1093/nar/gkr197" ;
    schema1:description "This package implements the cn.FARMS algorithm for copy number variation (CNV) analysis. cn.FARMS allows to analyze the most common Affymetrix (250K-SNP6.0) array types, supports high-performance computing using snow and ff." ;
    schema1:identifier biotools:cn.farms ;
    schema1:license "LGPL (>= 2.0)" ;
    schema1:name "bioconductor-cn.farms" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cn.farms.html" .

