@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:verifybamid2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.246934.118" ;
    schema:description "A robust tool for DNA contamination estimation from sequence reads using ancestry-agnostic method." ;
    schema:downloadUrl "https://github.com/Griffan/VerifyBamID/archive/refs/tags/v2.0.3.tar.gz" ;
    schema:hasPart "bzip2",
        "curl",
        "htslib",
        "openssl",
        "xz",
        "zlib" ;
    schema:identifier biotools:verifybamid ;
    schema:license "MIT" ;
    schema:name "verifybamid2" ;
    schema:softwareHelp "https://griffan.github.io/VerifyBamID" ;
    schema:softwareVersion "2.0.3" ;
    schema:url "https://github.com/Griffan/VerifyBamID" .

