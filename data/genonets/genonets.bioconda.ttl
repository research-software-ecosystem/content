@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:genonets a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkw313" ;
    schema:description "Framework for creating and analyzing genotype networks from data." ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/fb/ea/acf63ad7b54fc16ddacd0a9d1f4da4c455b5efe6fe7ec30b7eb2b0bd69e4/genonets-2.0.tar.gz" ;
    schema:hasPart "pip",
        "poetry",
        "python" ;
    schema:identifier biotools:genonets ;
    schema:license "MIT License" ;
    schema:name "genonets" ;
    schema:softwareVersion "2.0" ;
    schema:url "https://github.com/fkhalid/genonets" .

