@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gwama a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-11-288" ;
    schema:description "Genome-Wide Association Meta Analysis" ;
    schema:downloadUrl "http://www.geenivaramu.ee/tools/GWAMA_v2.2.2.zip" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:GWAMA ;
    schema:license "BSD-3-clause" ;
    schema:name "gwama" ;
    schema:softwareVersion "2.2.2" ;
    schema:url "https://www.geenivaramu.ee/en/tools/gwama" .

