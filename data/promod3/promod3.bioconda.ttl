@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:promod3 a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1008667" ;
    schema:description "ProMod3 is a tool for protein structure prediction and refinement" ;
    schema:downloadUrl "https://git.scicore.unibas.ch/schwede/ProMod3/-/archive/3.6.0/promod3-3.6.0.tar.gz" ;
    schema:hasPart "eigen",
        "libboost-devel",
        "libboost-python-devel",
        "openmm",
        "openstructure",
        "python" ;
    schema:identifier biotools:promod3 ;
    schema:license "Apache-2.0" ;
    schema:name "promod3" ;
    schema:softwareHelp "https://openstructure.org/promod3/" ;
    schema:softwareVersion "3.6.0" ;
    schema:url "https://openstructure.org/promod3/" .

