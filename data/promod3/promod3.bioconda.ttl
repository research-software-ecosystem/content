@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:promod3 a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1371/journal.pcbi.1008667" ;
    schema1:description "ProMod3 is a tool for protein structure prediction and refinement" ;
    schema1:downloadUrl "https://git.scicore.unibas.ch/schwede/ProMod3/-/archive/3.6.0/promod3-3.6.0.tar.gz" ;
    schema1:hasPart "eigen",
        "libboost-devel",
        "libboost-python-devel",
        "openmm",
        "openstructure",
        "python" ;
    schema1:identifier biotools:promod3 ;
    schema1:license "Apache-2.0" ;
    schema1:name "promod3" ;
    schema1:softwareHelp "https://openstructure.org/promod3/" ;
    schema1:softwareVersion "3.6.0" ;
    schema1:url "https://openstructure.org/promod3/" .

