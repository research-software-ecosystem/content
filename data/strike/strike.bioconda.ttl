@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:strike a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr587" ;
    schema:description "A program to evaluate protein multiple sequence alignments using a single protein structure." ;
    schema:downloadUrl "http://www.tcoffee.org/Projects/strike/download/strike_v1.2.tar.bz2" ;
    schema:identifier biotools:STRIKE ;
    schema:license "file" ;
    schema:name "strike" ;
    schema:softwareVersion "1.2" ;
    schema:url "http://www.tcoffee.org/Projects/strike/index.html" .

