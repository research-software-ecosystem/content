@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:purge_dups a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btaa025" ;
    schema:description "purge_dups is a package used to purge haplotigs and overlaps in an assembly based on read depth." ;
    schema:downloadUrl "https://github.com/dfguan/purge_dups/archive/v1.2.6.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:purge_dups ;
    schema:license "MIT" ;
    schema:name "purge_dups" ;
    schema:softwareHelp "https://github.com/dfguan/purge_dups/blob/v{[ version }}/README.md" ;
    schema:softwareVersion "1.2.6" ;
    schema:url "https://github.com/dfguan/purge_dups" .

