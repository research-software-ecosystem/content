@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-prebs a schema1:SoftwareApplication ;
    schema1:alternateName "Probe region expression estimation for RNA-seq data for improved microarray comparability" ;
    schema1:description "The prebs package aims at making RNA-sequencing (RNA-seq) data more comparable to microarray data. The comparability is achieved by summarizing sequencing-based expressions of probe regions using a modified version of RMA algorithm. The pipeline takes mapped reads in BAM format as an input and produces either gene expressions or original microarray probe set expressions as an output." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/prebs_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/prebs/prebs_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/prebs_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-prebs/bioconductor-prebs_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:prebs" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-prebs" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/prebs.html" .

