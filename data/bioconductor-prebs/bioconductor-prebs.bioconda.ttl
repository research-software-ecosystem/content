@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-prebs a schema:SoftwareApplication ;
    schema:description "Probe region expression estimation for RNA-seq data for improved microarray comparability" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/prebs_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/prebs/prebs_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/prebs_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-prebs/bioconductor-prebs_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rpa",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base" ;
    schema:identifier biotools:prebs ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-prebs" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/prebs.html" .

