@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-swathxtend a schema:SoftwareApplication ;
    schema:citation "doi:10.1074/mcp.M115.055558" ;
    schema:description "SWATH extended library generation and statistical data analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SwathXtend_2.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SwathXtend/SwathXtend_2.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SwathXtend_2.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-swathxtend/bioconductor-swathxtend_2.32.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-e1071",
        "r-lattice",
        "r-openxlsx",
        "r-venndiagram" ;
    schema:identifier biotools:swathxtend ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-swathxtend" ;
    schema:softwareVersion "2.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SwathXtend.html" .

