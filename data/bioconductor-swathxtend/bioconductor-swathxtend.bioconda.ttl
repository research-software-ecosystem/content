@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-swathxtend a schema1:SoftwareApplication ;
    schema1:alternateName "SWATH extended library generation and statistical data analysis" ;
    schema1:citation "doi:10.1074/mcp.M115.055558" ;
    schema1:description "Contains utility functions for integrating spectral libraries for SWATH and statistical data analysis for SWATH generated data." ;
    schema1:identifier biotools:swathxtend ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-swathxtend" ;
    schema1:softwareVersion "2.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SwathXtend.html" .

