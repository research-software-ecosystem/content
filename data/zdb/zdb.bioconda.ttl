@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:zdb a schema:SoftwareApplication ;
    schema:author "bkm",
        "njohner" ;
    schema:description "zDB is both a bacterial comparative genomics pipeline and a tool to visualize the results" ;
    schema:downloadUrl "https://github.com/metagenlab/zDB/archive/refs/tags/v1.3.12.tar.gz" ;
    schema:identifier biotools:zDB ;
    schema:license "MIT" ;
    schema:maintainer "bkm",
        "njohner" ;
    schema:name "zdb" ;
    schema:softwareHelp "https://zdb.readthedocs.io/en/latest/" ;
    schema:softwareVersion "1.3.12" ;
    schema:url "https://github.com/metagenlab/zDB/" .

