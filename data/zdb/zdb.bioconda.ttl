@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:zdb a schema1:SoftwareApplication ;
    schema1:alternateName "zDB is both a bacterial comparative genomics pipeline and a tool to visualize the results" ;
    schema1:description "zDB is both a bacterial comparative genomics pipeline and a tool to visualize the results" ;
    schema1:identifier biotools:zDB ;
    schema1:license "MIT" ;
    schema1:maintainer "bkm",
        "njohner" ;
    schema1:name "zdb" ;
    schema1:softwareVersion "1.3.12" ;
    schema1:url "https://github.com/metagenlab/zDB/" .

