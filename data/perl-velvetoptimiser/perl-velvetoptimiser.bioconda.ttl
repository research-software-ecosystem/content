@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:perl-velvetoptimiser a schema:SoftwareApplication ;
    schema:description "Automatically optimise three of Velvet's assembly parameters." ;
    schema:downloadUrl "https://github.com/tseemann/VelvetOptimiser/archive/2.2.6.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:velvetoptimiser ;
    schema:license "GPLv2" ;
    schema:name "perl-velvetoptimiser" ;
    schema:softwareVersion "2.2.6" ;
    schema:url "https://github.com/tseemann/VelvetOptimiser" .

