@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rpx a schema1:SoftwareApplication ;
    schema1:alternateName "R Interface to the ProteomeXchange Repository" ;
    schema1:citation "doi:10.1038/nbt.2839" ;
    schema1:description "The rpx package implements an interface to proteomics data submitted to the ProteomeXchange consortium." ;
    schema1:identifier biotools:rpx ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-rpx" ;
    schema1:softwareVersion "2.18.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rpx.html" .

