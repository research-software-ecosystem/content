@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rpx a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.2839" ;
    schema:description "R Interface to the ProteomeXchange Repository" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rpx_2.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rpx/rpx_2.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rpx_2.18.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rpx/bioconductor-rpx_2.18.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocfilecache",
        "r-base",
        "r-curl",
        "r-jsonlite",
        "r-rcurl",
        "r-xml2" ;
    schema:identifier biotools:rpx ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-rpx" ;
    schema:softwareVersion "2.18.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rpx.html" .

