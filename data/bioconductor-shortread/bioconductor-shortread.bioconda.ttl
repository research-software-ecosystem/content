@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-shortread a schema1:SoftwareApplication ;
    schema1:alternateName "FASTQ input and manipulation" ;
    schema1:description "This package implements sampling, iteration, and input of FASTQ files. The package includes functions for filtering and trimming reads, and for generating a quality assessment report. Data are represented as DNAStringSet-derived objects, and easily manipulated for a diversity of purposes.  The package also contains legacy support for early single-end, ungapped alignment formats." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ShortRead_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ShortRead/ShortRead_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ShortRead_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-shortread/bioconductor-shortread_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:shortread" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-shortread" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ShortRead.html" .

