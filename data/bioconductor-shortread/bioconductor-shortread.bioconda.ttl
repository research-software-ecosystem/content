@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-shortread a schema:SoftwareApplication ;
    schema:description "FASTQ input and manipulation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ShortRead_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ShortRead/ShortRead_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ShortRead_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-shortread/bioconductor-shortread_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-pwalign",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-hwriter",
        "r-lattice",
        "r-latticeextra",
        "zlib" ;
    schema:identifier biotools:shortread ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-shortread" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ShortRead.html" .

