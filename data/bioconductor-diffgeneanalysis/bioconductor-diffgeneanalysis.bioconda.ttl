@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-diffgeneanalysis a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Performs differential gene expression Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/diffGeneAnalysis_1.92.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/diffGeneAnalysis/diffGeneAnalysis_1.92.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/diffGeneAnalysis_1.92.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffgeneanalysis/bioconductor-diffgeneanalysis_1.92.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-minpack.lm" ;
    schema:identifier biotools:diffgeneanalysis ;
    schema:license "GPL" ;
    schema:name "bioconductor-diffgeneanalysis" ;
    schema:softwareVersion "1.92.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/diffGeneAnalysis.html" .

