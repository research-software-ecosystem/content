@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-diffgeneanalysis a schema1:SoftwareApplication ;
    schema1:alternateName "Performs differential gene expression Analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Analyze microarray data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/diffGeneAnalysis_1.92.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/diffGeneAnalysis/diffGeneAnalysis_1.92.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/diffGeneAnalysis_1.92.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-diffgeneanalysis/bioconductor-diffgeneanalysis_1.92.0_src_all.tar.gz" ;
    schema1:identifier "biotools:diffgeneanalysis" ;
    schema1:license "GPL" ;
    schema1:name "bioconductor-diffgeneanalysis" ;
    schema1:softwareVersion "1.92.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/diffGeneAnalysis.html" .

