@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mutmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.2095" ;
    schema:description "MutMap: pipeline to identify causative mutations responsible for a phenotype." ;
    schema:downloadUrl "https://github.com/YuSugihara/MutMap/releases/download/v2.4.0/MutMap-2.4.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:mutmap ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "mutmap" ;
    schema:softwareVersion "2.4.0" ;
    schema:url "https://github.com/YuSugihara/MutMap" .

