@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bubbletree a schema1:SoftwareApplication ;
    schema1:alternateName "BubbleTree: an intuitive visualization to elucidate tumoral aneuploidy and clonality in somatic mosaicism using next generation sequencing data" ;
    schema1:citation "doi:10.1093/nar/gkv1102" ;
    schema1:description "CNV analysis in groups of tumor samples." ;
    schema1:identifier <https://bio.tools/biotools:bubbletree> ;
    schema1:license "LGPL (>= 3)" ;
    schema1:name "bioconductor-bubbletree" ;
    schema1:softwareVersion "2.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/BubbleTree.html" .

