@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-michip a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "MiChip Parsing and Summarizing Functions" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MiChip_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MiChip/MiChip_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MiChip_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-michip/bioconductor-michip_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:michip ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-michip" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MiChip.html" .

