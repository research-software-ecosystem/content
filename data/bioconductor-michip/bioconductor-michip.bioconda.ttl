@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-michip a schema1:SoftwareApplication ;
    schema1:alternateName "MiChip Parsing and Summarizing Functions" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package takes the MiChip miRNA microarray .grp scanner output files and parses these out, providing summary and plotting functions to analyse MiChip hybridizations. A set of hybridizations is packaged into an ExpressionSet allowing it to be used by other BioConductor packages." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MiChip_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MiChip/MiChip_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MiChip_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-michip/bioconductor-michip_1.64.0_src_all.tar.gz" ;
    schema1:identifier "biotools:michip" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-michip" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MiChip.html" .

