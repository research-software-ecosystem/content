@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:homopolish a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-021-02282-6" ;
    schema:description "High-quality Nanopore-only genome polisher." ;
    schema:downloadUrl "https://github.com/SeaneryChang/homopolish/releases/download/v0.4.2/homopolish_0.4.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:homopolish ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "homopolish" ;
    schema:softwareVersion "0.4.2" ;
    schema:url "https://github.com/ythuang0522/homopolish" .

