@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ping a schema1:SoftwareApplication ;
    schema1:alternateName "Probabilistic inference for Nucleosome Positioning with MNase-based or Sonicated Short-read Data" ;
    schema1:description "Probabilistic inference of ChIP-Seq using an empirical Bayes mixture model approach." ;
    schema1:identifier <https://bio.tools/biotools:ping> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ping" ;
    schema1:softwareVersion "2.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/PING.html" .

