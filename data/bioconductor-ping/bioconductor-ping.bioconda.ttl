@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ping a schema1:SoftwareApplication ;
    schema1:description "Probabilistic inference for Nucleosome Positioning with MNase-based or Sonicated Short-read Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PING_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/PING/PING_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/PING_2.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ping/bioconductor-ping_2.50.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "bioconductor-pics",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "r-base",
        "r-fda" ;
    schema1:identifier biotools:ping ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ping" ;
    schema1:softwareVersion "2.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/PING.html" .

