@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dada2 a schema1:SoftwareApplication ;
    schema1:alternateName "Accurate, high-resolution sample inference from amplicon sequencing data" ;
    schema1:description "The dada2 package infers exact amplicon sequence variants (ASVs) from high-throughput amplicon sequencing data, replacing the coarser and less accurate OTU clustering approach. The dada2 pipeline takes as input demultiplexed fastq files, and outputs the sequence variants and their sample-wise abundances after removing substitution and chimera errors. Taxonomic classification is available via a native implementation of the RDP naive Bayesian classifier, and species-level assignment to 16S rRNA gene fragments by exact matching." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/dada2_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dada2/dada2_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dada2_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dada2/bioconductor-dada2_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dada2" ;
    schema1:license "LGPL-2" ;
    schema1:name "bioconductor-dada2" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/dada2.html" .

