@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dada2 a schema:SoftwareApplication ;
    schema:description "Accurate, high-resolution sample inference from amplicon sequencing data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/dada2_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/dada2/dada2_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/dada2_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dada2/bioconductor-dada2_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-shortread",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ggplot2",
        "r-rcpp",
        "r-rcppparallel",
        "r-reshape2",
        "zlib" ;
    schema:identifier biotools:dada2 ;
    schema:license "LGPL-2" ;
    schema:name "bioconductor-dada2" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/dada2.html" .

