@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:canu a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "fasta.gz",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0622 ;
    schema1:codeRepository <https://github.com/marbl/canu> ;
    schema1:dateCreated "2018-06-07" ;
    schema1:description "Canu is a hierarchical assembly pipeline designed for high-noise single-molecule sequencing (such as the PacBio RS II/Sequel or Oxford Nanopore MinION)." ;
    schema1:encodingFormat "fasta",
        "fasta.gz",
        "txt" ;
    schema1:featureList edam:operation_0524 ;
    schema1:identifier biotools:canu,
        bioconda:canu ;
    schema1:isPartOf <https://galaxy.mesocentre.uca.fr>,
        <https://galaxytrakr.org>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=93d7a5704ec1d82d>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org.au/published/workflow?id=344b2ad2604939bc> ;
    schema1:keywords "Assembly" ;
    schema1:name "canu" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/bgruening/galaxytools/tree/master/tools/canu> .

<https://galaxy.mesocentre.uca.fr> a schema1:WebSite .

