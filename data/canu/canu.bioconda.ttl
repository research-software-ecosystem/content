@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:canu a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.4277",
        "doi:10.1101/gr.215087.116",
        "doi:10.1101/gr.263566.120" ;
    schema:description "Canu is a fork of the Celera Assembler designed for high-noise single-molecule sequencing." ;
    schema:hasPart "boost-cpp",
        "curl",
        "gnuplot",
        "libgomp",
        "llvm-openmp",
        "xorg-libxfixes",
        "zlib" ;
    schema:identifier biotools:canu ;
    schema:license "GPL-2.0-or-later and others" ;
    schema:name "canu" ;
    schema:softwareHelp "https://canu.readthedocs.org" ;
    schema:softwareVersion "2.3" ;
    schema:url "https://github.com/marbl/canu" .

