@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:minimac4 a schema1:SoftwareApplication ;
    schema1:alternateName "Computationally efficient genotype imputation." ;
    schema1:description "Minimac4 is a lower memory and more computationally efficient implementation of the genotype imputation algorithms in minimac/mininac2/minimac3." ;
    schema1:identifier biotools:minimac4 ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "minimac4" ;
    schema1:softwareVersion "4.1.6" ;
    schema1:url "https://github.com/statgen/Minimac4" .

