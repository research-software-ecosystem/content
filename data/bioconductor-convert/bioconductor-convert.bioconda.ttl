@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-convert a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Convert Microarray Data Objects" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/convert_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/convert/convert_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/convert_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-convert/bioconductor-convert_1.86.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-limma",
        "bioconductor-marray",
        "r-base" ;
    schema:identifier biotools:convert ;
    schema:license "LGPL" ;
    schema:name "bioconductor-convert" ;
    schema:softwareVersion "1.86.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/convert.html" .

