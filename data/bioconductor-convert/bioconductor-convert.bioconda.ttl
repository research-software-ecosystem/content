@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-convert a schema1:SoftwareApplication ;
    schema1:alternateName "Convert Microarray Data Objects" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Define coerce methods for microarray data objects." ;
    schema1:identifier biotools:convert ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-convert" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/convert.html" .

