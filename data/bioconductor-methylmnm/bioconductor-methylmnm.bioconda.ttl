@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-methylmnm a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.156539.113" ;
    schema:description "detect different methylation level (DMR)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/methylMnM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methylMnM/methylMnM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/methylMnM_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylmnm/bioconductor-methylmnm_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-edger",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-statmod",
        "zlib" ;
    schema:identifier biotools:methylmnm ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-methylmnm" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/methylMnM.html" .

