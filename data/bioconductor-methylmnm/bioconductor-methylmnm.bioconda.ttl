@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-methylmnm a schema1:SoftwareApplication ;
    schema1:alternateName "detect different methylation level (DMR)" ;
    schema1:citation "doi:10.1101/gr.156539.113" ;
    schema1:description "To give the exactly p-value and q-value of MeDIP-seq and MRE-seq data for different samples comparation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/methylMnM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methylMnM/methylMnM_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/methylMnM_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylmnm/bioconductor-methylmnm_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:methylmnm" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-methylmnm" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/methylMnM.html" .

