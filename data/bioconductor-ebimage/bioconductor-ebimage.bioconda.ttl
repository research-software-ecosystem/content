@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ebimage a schema1:SoftwareApplication ;
    schema1:alternateName "Image processing and analysis toolbox for R" ;
    schema1:description "EBImage provides general purpose functionality for image processing and analysis. In the context of (high-throughput) microscopy-based cellular assays, EBImage offers tools to segment cells and extract quantitative cellular descriptors. This allows the automation of such tasks using the R programming language and facilitates the use of other tools in the R environment for signal processing, statistical modeling, machine learning and visualization with image data." ;
    schema1:identifier biotools:ebimage ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-ebimage" ;
    schema1:softwareVersion "4.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EBImage.html" .

