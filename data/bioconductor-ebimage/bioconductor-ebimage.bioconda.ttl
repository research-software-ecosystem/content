@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ebimage a schema:SoftwareApplication ;
    schema:description "Image processing and analysis toolbox for R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EBImage_4.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBImage/EBImage_4.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBImage_4.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebimage/bioconductor-ebimage_4.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-abind",
        "r-base",
        "r-fftwtools",
        "r-htmltools",
        "r-htmlwidgets",
        "r-jpeg",
        "r-locfit",
        "r-png",
        "r-rcurl",
        "r-tiff",
        "zlib" ;
    schema:identifier biotools:ebimage ;
    schema:license "LGPL" ;
    schema:name "bioconductor-ebimage" ;
    schema:softwareVersion "4.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EBImage.html" .

