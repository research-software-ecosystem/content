@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-epigenomix a schema:SoftwareApplication ;
    schema:description "Epigenetic and gene transcription data normalization and integration with mixture models" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/epigenomix_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/epigenomix/epigenomix_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/epigenomix_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epigenomix/bioconductor-epigenomix_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-beadarray",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-mcmcpack" ;
    schema:identifier biotools:epigenomix ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-epigenomix" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/epigenomix.html" .

