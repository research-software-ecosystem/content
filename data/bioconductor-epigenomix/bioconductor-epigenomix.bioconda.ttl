@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-epigenomix a schema1:SoftwareApplication ;
    schema1:alternateName "Epigenetic and gene transcription data normalization and integration with mixture models" ;
    schema1:description "A package for the integrative analysis of RNA-seq or microarray based gene transcription and histone modification data obtained by ChIP-seq. The package provides methods for data preprocessing and matching as well as methods for fitting bayesian mixture models in order to detect genes with differences in both data types." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/epigenomix_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/epigenomix/epigenomix_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/epigenomix_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epigenomix/bioconductor-epigenomix_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:epigenomix" ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-epigenomix" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/epigenomix.html" .

