@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biocparallel a schema1:SoftwareApplication ;
    schema1:alternateName "Bioconductor facilities for parallel evaluation" ;
    schema1:citation "doi:10.1214/14-STS476" ;
    schema1:description "This package provides modified versions and novel implementation of functions for parallel evaluation, tailored to use with Bioconductor objects." ;
    schema1:identifier <https://bio.tools/biotools:biocparallel> ;
    schema1:license "GPL-2 | GPL-3 | BSL-1.0" ;
    schema1:name "bioconductor-biocparallel" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BiocParallel.html" .

