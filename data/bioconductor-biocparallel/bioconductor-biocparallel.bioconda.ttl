@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biocparallel a schema:SoftwareApplication ;
    schema:citation "doi:10.1214/14-STS476" ;
    schema:description "Bioconductor facilities for parallel evaluation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BiocParallel_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocParallel/BiocParallel_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiocParallel_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocparallel/bioconductor-biocparallel_1.44.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-codetools",
        "r-cpp11",
        "r-futile.logger",
        "r-snow",
        "zlib" ;
    schema:identifier biotools:biocparallel ;
    schema:license "GPL-2 | GPL-3 | BSL-1.0" ;
    schema:name "bioconductor-biocparallel" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BiocParallel.html" .

