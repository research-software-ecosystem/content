@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biocparallel a schema1:SoftwareApplication ;
    schema1:alternateName "Bioconductor facilities for parallel evaluation" ;
    schema1:citation "doi:10.1214/14-STS476" ;
    schema1:description "This package provides modified versions and novel implementation of functions for parallel evaluation, tailored to use with Bioconductor objects." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BiocParallel_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocParallel/BiocParallel_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiocParallel_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocparallel/bioconductor-biocparallel_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:biocparallel" ;
    schema1:license "GPL-2 | GPL-3 | BSL-1.0" ;
    schema1:name "bioconductor-biocparallel" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BiocParallel.html" .

