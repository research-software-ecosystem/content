@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:orientagraph a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2021.02.02.429467" ;
    schema:description "Maximum likelihood network orientation for admixture graphs" ;
    schema:downloadUrl "https://github.com/sriramlab/OrientAGraph/archive/0f81b2604993285a56fbf83384481274f7c89883.zip" ;
    schema:hasPart "boost",
        "gsl",
        "zlib" ;
    schema:identifier biotools:orientagraph ;
    schema:license "GPL3" ;
    schema:name "orientagraph" ;
    schema:softwareVersion "1.1" ;
    schema:url "https://github.com/sriramlab/OrientAGraph" .

