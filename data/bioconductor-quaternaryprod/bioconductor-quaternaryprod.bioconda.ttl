@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-quaternaryprod a schema:SoftwareApplication ;
    schema:description "Computes the Quaternary Dot Product Scoring Statistic for Signed and Unsigned Causal Graphs" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/QuaternaryProd_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/QuaternaryProd/QuaternaryProd_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/QuaternaryProd_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-quaternaryprod/bioconductor-quaternaryprod_1.44.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dplyr",
        "r-rcpp",
        "r-yaml",
        "zlib" ;
    schema:identifier biotools:quaternaryprod ;
    schema:license "GPL (>=3)" ;
    schema:name "bioconductor-quaternaryprod" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/QuaternaryProd.html" .

