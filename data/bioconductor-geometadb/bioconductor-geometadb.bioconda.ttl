@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-geometadb a schema:SoftwareApplication ;
    schema:description "A compilation of metadata from NCBI GEO" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GEOmetadb_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEOmetadb/GEOmetadb_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GEOmetadb_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geometadb/bioconductor-geometadb_1.72.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-r.utils",
        "r-rsqlite" ;
    schema:identifier biotools:geometadb ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-geometadb" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GEOmetadb.html" .

