@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-girafe a schema:SoftwareApplication ;
    schema:description "Genome Intervals and Read Alignments for Functional Exploration" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/girafe_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/girafe/girafe_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/girafe_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-girafe/bioconductor-girafe_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomeintervals",
        "bioconductor-iranges",
        "bioconductor-pwalign",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-shortread",
        "libblas",
        "liblapack",
        "r-base",
        "r-intervals" ;
    schema:identifier biotools:girafe ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-girafe" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/girafe.html" .

