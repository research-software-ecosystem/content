@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-deepsnv a schema:SoftwareApplication ;
    schema:description "Detection of subclonal SNVs in deep sequencing data." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/deepSNV_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/deepSNV/deepSNV_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/deepSNV_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-deepsnv/bioconductor-deepsnv_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rhtslib",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-vgam",
        "zlib" ;
    schema:identifier biotools:deepsnv ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-deepsnv" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/deepSNV.html" .

