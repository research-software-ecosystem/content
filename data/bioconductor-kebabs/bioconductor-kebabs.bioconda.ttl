@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-kebabs a schema:SoftwareApplication ;
    schema:description "Kernel-Based Analysis of Biological Sequences" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/kebabs_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/kebabs/kebabs_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/kebabs_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-kebabs/bioconductor-kebabs_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-apcluster",
        "r-base",
        "r-e1071",
        "r-kernlab",
        "r-liblinear",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:kebabs ;
    schema:license "GPL (>= 2.1)" ;
    schema:name "bioconductor-kebabs" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/kebabs.html" .

