@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-scran a schema:SoftwareApplication ;
    schema:description "Methods for Single-Cell RNA-Seq Data Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/scran_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scran/scran_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/scran_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-scran/bioconductor-scran_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-beachmat",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biocsingular",
        "bioconductor-bluster",
        "bioconductor-delayedarray",
        "bioconductor-edger",
        "bioconductor-limma",
        "bioconductor-matrixgenerics",
        "bioconductor-metapod",
        "bioconductor-s4arrays",
        "bioconductor-s4vectors",
        "bioconductor-scuttle",
        "bioconductor-singlecellexperiment",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-dqrng",
        "r-igraph",
        "r-matrix",
        "r-rcpp",
        "r-statmod",
        "zlib" ;
    schema:identifier biotools:scran ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-scran" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/scran.html" .

