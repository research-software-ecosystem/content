@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-scran a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for Single-Cell RNA-Seq Data Analysis" ;
    schema1:description "Implements miscellaneous functions for interpretation of single-cell RNA-seq data. Methods are provided for assignment of cell cycle phase, detection of highly variable and significantly correlated genes, identification of marker genes, and other common tasks in routine single-cell analysis workflows." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/scran_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scran/scran_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/scran_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-scran/bioconductor-scran_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:scran" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-scran" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/scran.html" .

