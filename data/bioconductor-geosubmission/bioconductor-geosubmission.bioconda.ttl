@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-geosubmission a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Prepares microarray data for submission to GEO" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GEOsubmission_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GEOsubmission/GEOsubmission_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GEOsubmission_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geosubmission/bioconductor-geosubmission_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:geosubmission ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-geosubmission" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GEOsubmission.html" .

