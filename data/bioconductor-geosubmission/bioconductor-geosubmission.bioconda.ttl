@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-geosubmission a schema1:SoftwareApplication ;
    schema1:alternateName "Prepares microarray data for submission to GEO" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Helps to easily submit a microarray dataset and the associated sample information to GEO by preparing a single file for upload (direct deposit)." ;
    schema1:identifier <https://bio.tools/biotools:geosubmission> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-geosubmission" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GEOsubmission.html" .

