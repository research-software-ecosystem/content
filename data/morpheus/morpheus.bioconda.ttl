@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:morpheus a schema:SoftwareApplication ;
    schema:citation "doi:10.1021/pr301024c" ;
    schema:description "mass spectrometry–based proteomics database search algorithm" ;
    schema:downloadUrl "https://github.com/cwenger/Morpheus/releases/download/r290/Morpheus_mzML_Mono.tar.gz" ;
    schema:identifier biotools:morpheus ;
    schema:license "MIT" ;
    schema:name "morpheus" ;
    schema:softwareHelp "https://cwenger.github.io/Morpheus/" ;
    schema:softwareVersion "290" ;
    schema:url "https://github.com/cwenger/Morpheus/" .

