@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:xtandem a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bth092" ;
    schema:description "X! Tandem open source is software that can match tandem mass spectra with peptide sequences, in a process that has come to be known as protein identification." ;
    schema:downloadUrl "https://depot.galaxyproject.org/software/xtandem/xtandem_15.12.15.2_src_all.zip" ;
    schema:hasPart "dos2unix",
        "expat",
        "zlib" ;
    schema:identifier biotools:xtandem ;
    schema:license "The-Artistic-License" ;
    schema:name "xtandem" ;
    schema:softwareHelp "https://www.thegpm.org/TANDEM/index.html" ;
    schema:softwareVersion "15.12.15.2" ;
    schema:url "https://www.thegpm.org/TANDEM/index.html" .

