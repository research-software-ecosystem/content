@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:repeatscout a schema:SoftwareApplication ;
    schema:description "De novo identification of repeat families in large genomes." ;
    schema:downloadUrl "https://github.com/Dfam-consortium/RepeatScout/archive/refs/tags/v1.0.7.tar.gz" ;
    schema:identifier biotools:RepeatScout ;
    schema:license "CC0" ;
    schema:name "repeatscout" ;
    schema:softwareHelp "https://github.com/Dfam-consortium/RepeatScout/blob/v1.0.7/README.md" ;
    schema:softwareVersion "1.0.7" ;
    schema:url "https://github.com/Dfam-consortium/RepeatScout" .

