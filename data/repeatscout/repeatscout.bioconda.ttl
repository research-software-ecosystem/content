@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:repeatscout a schema1:SoftwareApplication ;
    schema1:alternateName "De novo identification of repeat families in large genomes." ;
    schema1:description "De novo identification of repeat families in large genomes." ;
    schema1:identifier <https://bio.tools/biotools:RepeatScout> ;
    schema1:license "CC0" ;
    schema1:name "repeatscout" ;
    schema1:softwareVersion "1.0.7" ;
    schema1:url "https://github.com/Dfam-consortium/RepeatScout" .

