@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:freebayes a schema:SoftwareApplication ;
    schema:author "jpuritz",
        "mencian" ;
    schema:citation "doi:10.48550/arXiv.1207.3907" ;
    schema:description "Bayesian haplotype-based polymorphism discovery and genotyping." ;
    schema:hasPart "bzip2",
        "htslib",
        "seqlib",
        "simde",
        "vcflib",
        "wget",
        "xz",
        "zlib" ;
    schema:identifier biotools:freebayes ;
    schema:license "MIT" ;
    schema:maintainer "jpuritz",
        "mencian" ;
    schema:name "freebayes" ;
    schema:softwareHelp "https://github.com/freebayes/freebayes/blob/v1.3.10/README.md" ;
    schema:softwareVersion "1.3.10" ;
    schema:url "https://github.com/freebayes/freebayes" .

