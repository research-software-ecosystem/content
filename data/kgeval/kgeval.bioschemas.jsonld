      "sc:citation": {
        "@id": "https://doi.org/10.48550/arXiv.2508.21774"
      },
      "sc:description": "Code and data accompanying an assessment of 17 biomedical knowledge graphs (KGs) against 28 transparency and reusability subcriteria. The criteria cover access, provenance, documentation, versioning, evaluation and licensing. The repository contains the evaluation table, a script that maps node and edge labels from each KG to Biolink Model categories, and code to reproduce the manuscript figures, including node-type, edge-type and source comparisons across KGs.",
      "sc:name": "KGEval",
      "sc:url": "https://github.com/kcortes133/KGEval"
    }
  ]
