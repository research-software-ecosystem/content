@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-quantsmooth a schema1:SoftwareApplication ;
    schema1:alternateName "Quantile smoothing and genomic visualization of array data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Implements quantile smoothing as introduced in: Quantile smoothing of array CGH data; Eilers PH, de Menezes RX; Bioinformatics. 2005 Apr 1;21(7):1146-53." ;
    schema1:identifier biotools:quantsmooth ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-quantsmooth" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/quantsmooth.html" .

