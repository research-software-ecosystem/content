@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-quantsmooth a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Quantile smoothing and genomic visualization of array data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/quantsmooth_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/quantsmooth/quantsmooth_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/quantsmooth_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-quantsmooth/bioconductor-quantsmooth_1.76.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-quantreg" ;
    schema:identifier biotools:quantsmooth ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-quantsmooth" ;
    schema:softwareVersion "1.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/quantsmooth.html" .

