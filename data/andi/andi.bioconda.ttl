@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:andi a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu815" ;
    schema:description "Efficient Estimation of Evolutionary Distances" ;
    schema:downloadUrl "https://github.com/EvolBioInf/andi/releases/download/v1.15/andi-1.15.tar.gz" ;
    schema:hasPart "gsl",
        "libdivsufsort",
        "mkl",
        "openblas" ;
    schema:identifier biotools:andi ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "andi" ;
    schema:softwareVersion "1.15" ;
    schema:url "https://github.com/evolbioinf/andi/" .

