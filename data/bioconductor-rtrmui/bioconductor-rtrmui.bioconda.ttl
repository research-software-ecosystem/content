@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rtrmui a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "A shiny user interface for rTRM" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rTRMui_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rTRMui/rTRMui_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rTRMui_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rtrmui/bioconductor-rtrmui_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-motifdb",
        "bioconductor-org.hs.eg.db",
        "bioconductor-org.mm.eg.db",
        "bioconductor-rtrm",
        "r-base",
        "r-shiny" ;
    schema:identifier biotools:rtrmui ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-rtrmui" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rTRMui.html" .

