@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rtrmui a schema1:SoftwareApplication ;
    schema1:alternateName "A shiny user interface for rTRM" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides a web interface to compute transcriptional regulatory modules with rTRM." ;
    schema1:identifier biotools:rtrmui ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-rtrmui" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rTRMui.html" .

