@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:segemehl a schema:SoftwareApplication ;
    schema:description "Short read mapping with gaps." ;
    schema:downloadUrl "http://www.bioinf.uni-leipzig.de/Software/segemehl/downloads/segemehl-0.3.4.tar.gz" ;
    schema:hasPart "htslib",
        "ncurses",
        "zlib" ;
    schema:identifier biotools:segemehl ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "segemehl" ;
    schema:softwareHelp "http://www.bioinf.uni-leipzig.de/Software/segemehl" ;
    schema:softwareVersion "0.3.4" ;
    schema:url "http://www.bioinf.uni-leipzig.de/Software/segemehl" .

