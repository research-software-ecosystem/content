@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:antarna a schema:SoftwareApplication ;
    schema:description "antaRNA is a python based implementation of ant-colony optimization of the RNA inverse folding problem." ;
    schema:downloadUrl "https://github.com/RobertKleinkauf/antarna/archive/v2.0.6.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:antarna ;
    schema:license "MIT" ;
    schema:name "antarna" ;
    schema:softwareVersion "2.0.6" ;
    schema:url "https://github.com/RobertKleinkauf/antarna" .

