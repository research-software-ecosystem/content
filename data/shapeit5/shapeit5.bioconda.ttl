@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:shapeit5 a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2022.10.19.512867" ;
    schema:description "Fast and accurate method for estimation of haplotypes (phasing)." ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "htslib",
        "libcurl",
        "libdeflate",
        "xz",
        "zlib" ;
    schema:identifier biotools:shapeit5 ;
    schema:license "MIT" ;
    schema:name "shapeit5" ;
    schema:softwareHelp "https://odelaneau.github.io/shapeit5" ;
    schema:softwareVersion "5.1.1" ;
    schema:url "https://odelaneau.github.io/shapeit5" .

