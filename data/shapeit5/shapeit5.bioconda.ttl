@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:shapeit5 a schema1:SoftwareApplication ;
    schema1:alternateName "Fast and accurate method for estimation of haplotypes (phasing)." ;
    schema1:citation "doi:10.1101/2022.10.19.512867" ;
    schema1:description "This package provides the software SHAPEIT5. SHAPEIT5 estimates haplotypes in large datasets (WGS, WES, SNP array), with a special focus on rare variants." ;
    schema1:identifier "biotools:shapeit5" ;
    schema1:license "MIT" ;
    schema1:name "shapeit5" ;
    schema1:softwareVersion "5.1.1" ;
    schema1:url "https://odelaneau.github.io/shapeit5" .

