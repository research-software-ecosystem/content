@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hmmcopy a schema1:SoftwareApplication ;
    schema1:alternateName "Copy number prediction with correction for GC and mappability bias for HTS data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Corrects GC and mappability biases for readcounts (i.e. coverage) in non-overlapping windows of fixed length for single whole genome samples, yielding a rough estimate of copy number for furthur analysis.  Designed for rapid correction of high coverage whole genome tumour and normal samples." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HMMcopy_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HMMcopy/HMMcopy_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HMMcopy_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hmmcopy/bioconductor-hmmcopy_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:hmmcopy" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-hmmcopy" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HMMcopy.html" .

