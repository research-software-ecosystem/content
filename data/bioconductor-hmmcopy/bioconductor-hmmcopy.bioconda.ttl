@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hmmcopy a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Copy number prediction with correction for GC and mappability bias for HTS data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HMMcopy_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HMMcopy/HMMcopy_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HMMcopy_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hmmcopy/bioconductor-hmmcopy_1.52.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "zlib" ;
    schema:identifier biotools:hmmcopy ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-hmmcopy" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HMMcopy.html" .

