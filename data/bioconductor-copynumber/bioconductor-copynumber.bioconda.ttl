@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-copynumber a schema1:SoftwareApplication ;
    schema1:alternateName "Segmentation of single- and multi-track copy number data by penalized least squares regression." ;
    schema1:description "Penalized least squares regression is applied to fit piecewise constant curves to copy number data to locate genomic regions of constant copy number. Procedures are available for individual segmentation of each sample, joint segmentation of several samples and joint segmentation of the two data tracks from SNP-arrays. Several plotting functions are available for visualization of the data and the segmentation results." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/copynumber_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.16/bioc/src/contrib/Archive/copynumber/copynumber_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.16/bioc/src/contrib/copynumber_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-copynumber/bioconductor-copynumber_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:copynumber" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-copynumber" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.16/bioc/html/copynumber.html" .

