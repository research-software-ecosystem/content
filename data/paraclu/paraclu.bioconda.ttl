@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:paraclu a schema:SoftwareApplication ;
    schema:description "Paraclu finds clusters in data attached to sequences." ;
    schema:downloadUrl "https://gitlab.com/mcfrith/paraclu/-/archive/10/paraclu-10.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:paraclu ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "paraclu" ;
    schema:softwareVersion "10" ;
    schema:url "https://gitlab.com/mcfrith/paraclu" .

