@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-seqpattern a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Visualising oligonucleotide patterns and motif occurrences across a set of sorted sequences" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/seqPattern_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/seqPattern/seqPattern_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/seqPattern_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-seqpattern/bioconductor-seqpattern_1.42.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "r-base",
        "r-kernsmooth",
        "r-plotrix" ;
    schema1:identifier biotools:seqpattern ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-seqpattern" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/seqPattern.html" .

