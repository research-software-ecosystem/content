@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:hapcut2 a schema1:SoftwareApplication ;
    bioschemas:output "txt",
        "vcf" ;
    schema1:codeRepository "https://github.com/vibansal/HapCUT2" ;
    schema1:dateCreated "2022-10-20" ;
    schema1:description "Robust and accurate haplotype assembly for diverse sequencing technologies" ;
    schema1:encodingFormat "txt",
        "vcf" ;
    schema1:featureList edam:operation_0487,
        edam:operation_3225 ;
    schema1:identifier biotools:hapcut2,
        bioconda:hapcut2 ;
    schema1:keywords "Assembly" ;
    schema1:name "hapcut2" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/hapcut2" .

