@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-splicinggraphs a schema1:SoftwareApplication ;
    schema1:alternateName "Create, manipulate, visualize splicing graphs, and assign RNA-seq reads to them" ;
    schema1:citation "doi:10.1093/bioinformatics/18.suppl_1.s181" ;
    schema1:description "This package allows the user to create, manipulate, and visualize splicing graphs and their bubbles based on a gene model for a given organism. Additionally it allows the user to assign RNA-seq reads to the edges of a set of splicing graphs, and to summarize them in different ways." ;
    schema1:identifier biotools:splicinggraphs ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-splicinggraphs" ;
    schema1:softwareVersion "1.50.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SplicingGraphs.html" .

