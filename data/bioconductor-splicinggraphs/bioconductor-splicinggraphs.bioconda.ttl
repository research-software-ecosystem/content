@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-splicinggraphs a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/18.suppl_1.s181" ;
    schema:description "Create, manipulate, visualize splicing graphs, and assign RNA-seq reads to them" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SplicingGraphs_1.50.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SplicingGraphs/SplicingGraphs_1.50.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SplicingGraphs_1.50.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-splicinggraphs/bioconductor-splicinggraphs_1.50.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-graph",
        "bioconductor-iranges",
        "bioconductor-rgraphviz",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-igraph" ;
    schema:identifier biotools:splicinggraphs ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-splicinggraphs" ;
    schema:softwareVersion "1.50.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SplicingGraphs.html" .

