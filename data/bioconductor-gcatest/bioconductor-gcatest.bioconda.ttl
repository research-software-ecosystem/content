@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gcatest a schema1:SoftwareApplication ;
    schema1:alternateName "Genotype Conditional Association TEST" ;
    schema1:citation "doi:10.1101/012682" ;
    schema1:description "GCAT is an association test for genome wide association studies that controls for population structure under a general class of trait models.  This test conditions on the trait, which makes it immune to confounding by unmodeled environmental factors.  Population structure is modeled via logistic factors, which are estimated using the `lfa` package." ;
    schema1:identifier biotools:gcatest ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-gcatest" ;
    schema1:softwareVersion "2.10.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gcatest.html" .

