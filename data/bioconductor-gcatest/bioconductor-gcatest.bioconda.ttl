@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gcatest a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/012682" ;
    schema:description "Genotype Conditional Association TEST" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/gcatest_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gcatest/gcatest_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gcatest_2.10.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gcatest/bioconductor-gcatest_2.10.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-lfa",
        "r-base" ;
    schema:identifier biotools:gcatest ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-gcatest" ;
    schema:softwareVersion "2.10.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/gcatest.html" .

