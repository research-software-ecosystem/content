@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:erne a schema:SoftwareApplication ;
    schema:description "ERNE - Extended Randomized Numerical alignEr" ;
    schema:downloadUrl "https://downloads.sourceforge.net/project/erne/2.1.1/erne-2.1.1-source.tar.gz" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "zlib" ;
    schema:identifier biotools:erne ;
    schema:license "GPLv3" ;
    schema:name "erne" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "http://erne.sourceforge.net" .

