@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:erne a schema1:SoftwareApplication ;
    schema1:alternateName "ERNE - Extended Randomized Numerical alignEr" ;
    schema1:description "ERNE - Extended Randomized Numerical alignEr" ;
    schema1:identifier <https://bio.tools/biotools:erne> ;
    schema1:license "GPLv3" ;
    schema1:name "erne" ;
    schema1:softwareVersion "2.1.1" ;
    schema1:url "http://erne.sourceforge.net" .

