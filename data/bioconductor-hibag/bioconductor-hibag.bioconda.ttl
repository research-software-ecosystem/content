@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hibag a schema1:SoftwareApplication ;
    schema1:alternateName "HLA Genotype Imputation with Attribute Bagging" ;
    schema1:description "Imputes HLA classical alleles using GWAS SNP data, and it relies on a training set of HLA and SNP genotypes. HIBAG can be used by researchers with published parameter estimates instead of requiring access to large training sample datasets. It combines the concepts of attribute bagging, an ensemble classifier method, with haplotype inference for SNPs and HLA types. Attribute bagging is a technique which improves the accuracy and stability of classifier ensembles using bootstrap aggregating and random variable selection." ;
    schema1:identifier <https://bio.tools/biotools:hibag> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-hibag" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HIBAG.html" .

