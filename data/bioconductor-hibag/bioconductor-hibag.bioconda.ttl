@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hibag a schema:SoftwareApplication ;
    schema:description "HLA Genotype Imputation with Attribute Bagging" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HIBAG_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HIBAG/HIBAG_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HIBAG_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hibag/bioconductor-hibag_1.46.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-rcppparallel",
        "zlib" ;
    schema:identifier biotools:hibag ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-hibag" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HIBAG.html" .

