@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-savr a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Parse and analyze Illumina SAV files" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/savR_1.37.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/savR/savR_1.37.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/savR_1.37.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-savr/bioconductor-savr_1.37.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-ggplot2",
        "r-gridextra",
        "r-reshape2",
        "r-scales",
        "r-xml" ;
    schema:identifier biotools:savr ;
    schema:license "AGPL-3" ;
    schema:name "bioconductor-savr" ;
    schema:softwareVersion "1.37.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/savR.html" .

