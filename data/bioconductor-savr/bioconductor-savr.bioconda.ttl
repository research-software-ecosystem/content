@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-savr a schema1:SoftwareApplication ;
    schema1:alternateName "Parse and analyze Illumina SAV files" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Parse Illumina Sequence Analysis Viewer (SAV) files, access data, and generate QC plots." ;
    schema1:identifier biotools:savr ;
    schema1:license "AGPL-3" ;
    schema1:name "bioconductor-savr" ;
    schema1:softwareVersion "1.37.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/savR.html" .

