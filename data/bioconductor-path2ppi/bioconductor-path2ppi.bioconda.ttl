@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-path2ppi a schema:SoftwareApplication ;
    schema:description "Prediction of pathway-related protein-protein interaction networks" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Path2PPI_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Path2PPI/Path2PPI_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Path2PPI_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-path2ppi/bioconductor-path2ppi_1.40.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-igraph" ;
    schema:identifier biotools:path2ppi ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-path2ppi" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Path2PPI.html" .

