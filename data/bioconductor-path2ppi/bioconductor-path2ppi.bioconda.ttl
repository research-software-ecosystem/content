@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-path2ppi a schema1:SoftwareApplication ;
    schema1:alternateName "Prediction of pathway-related protein-protein interaction networks" ;
    schema1:description "Package to predict protein-protein interaction (PPI) networks in target organisms for which only a view information about PPIs is available. Path2PPI predicts PPI networks based on sets of proteins which can belong to a certain pathway from well-established model organisms. It helps to combine and transfer information of a certain pathway or biological process from several reference organisms to one target organism. Path2PPI only depends on the sequence similarity of the involved proteins." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Path2PPI_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Path2PPI/Path2PPI_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Path2PPI_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-path2ppi/bioconductor-path2ppi_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:path2ppi" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-path2ppi" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Path2PPI.html" .

