@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-targetscore a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt599" ;
    schema:description "TargetScore: Infer microRNA targets using microRNA-overexpression data and sequence information" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/TargetScore_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TargetScore/TargetScore_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TargetScore_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-targetscore/bioconductor-targetscore_1.48.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-matrix",
        "r-pracma" ;
    schema:identifier biotools:targetscore ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-targetscore" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/TargetScore.html" .

