@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-uniprot.ws a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "R Interface to UniProt Web Services" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/UniProt.ws_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/UniProt.ws/UniProt.ws_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/UniProt.ws_2.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-uniprot.ws/bioconductor-uniprot.ws_2.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocbaseutils",
        "bioconductor-biocfilecache",
        "bioconductor-biocgenerics",
        "r-base",
        "r-httr2",
        "r-jsonlite",
        "r-progress",
        "r-rjsoncons",
        "r-rlang" ;
    schema:identifier biotools:uniprot.ws ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-uniprot.ws" ;
    schema:softwareVersion "2.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/UniProt.ws.html" .

