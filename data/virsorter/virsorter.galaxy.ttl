@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:virsorter a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_3174 ;
    schema1:codeRepository <https://github.com/jiarong/VirSorter2/> ;
    schema1:dateCreated "2024-06-20" ;
    schema1:description "VirSorter2 applies a multi-classifier, expert-guided approach to detect diverse DNA and RNA virus genomes." ;
    schema1:encodingFormat "fasta",
        "tabular",
        "txt" ;
    schema1:featureList edam:data_1872,
        edam:operation_3460 ;
    schema1:identifier biotools:virsorter,
        bioconda:virsorter ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=62392daea25a3980>,
        <https://usegalaxy.eu/published/workflow?id=87231a6a7938cb95>,
        <https://usegalaxy.fr> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "virsorter" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/Helmholtz-UFZ/ufz-galaxy-tools/blob/main/tools/virsorter> .

