@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-peca a schema1:SoftwareApplication ;
    schema1:alternateName "Probe-level Expression Change Averaging" ;
    schema1:citation "doi:10.1007/978-1-4939-6518-2_11" ;
    schema1:description "Calculates Probe-level Expression Change Averages (PECA) to identify differential expression in Affymetrix gene expression microarray studies or in proteomic studies using peptide-level mesurements respectively." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PECA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PECA/PECA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PECA_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-peca/bioconductor-peca_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:peca" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-peca" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PECA.html" .

