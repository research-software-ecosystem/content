@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-peca a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-4939-6518-2_11" ;
    schema:description "Probe-level Expression Change Averaging" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PECA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PECA/PECA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PECA_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-peca/bioconductor-peca_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-genefilter",
        "bioconductor-limma",
        "bioconductor-preprocesscore",
        "bioconductor-rots",
        "r-aroma.affymetrix",
        "r-aroma.core",
        "r-base" ;
    schema:identifier biotools:peca ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-peca" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PECA.html" .

