@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:multiqc a schema:SoftwareApplication ;
    schema:author "ewels" ;
    schema:citation "doi:10.1093/bioinformatics/btw354" ;
    schema:description "Aggregate results from bioinformatics analyses across many samples into a single report." ;
    schema:downloadUrl "https://github.com/MultiQC/MultiQC/archive/v1.35.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:multiqc ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "ewels" ;
    schema:name "multiqc" ;
    schema:softwareHelp "https://docs.seqera.io/multiqc/" ;
    schema:softwareVersion "1.35" ;
    schema:url "https://seqera.io/multiqc" .

