@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:drep a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ismej.2017.126" ;
    schema:description "De-replication of microbial genomes assembled from multiple samples." ;
    schema:downloadUrl "https://pypi.io/packages/source/d/drep/drep-3.7.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:drep ;
    schema:license "MIT" ;
    schema:name "drep" ;
    schema:softwareHelp "https://drep.readthedocs.io/en/latest" ;
    schema:softwareVersion "3.7.1" ;
    schema:url "https://github.com/MrOlm/drep" .

