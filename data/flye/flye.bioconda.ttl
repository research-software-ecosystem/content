@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:flye a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41587-019-0072-8",
        "doi:10.1038/s41592-020-00971-x",
        "doi:10.1073/pnas.1604560113" ;
    schema:description "A fast and accurate de novo assembler for single molecule sequencing reads using repeat graphs." ;
    schema:downloadUrl "https://github.com/fenderglass/Flye/archive/2.9.6.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:Flye ;
    schema:license "BSD-3-Clause" ;
    schema:name "flye" ;
    schema:softwareHelp "https://github.com/mikolmogorov/Flye/blob/flye/docs/USAGE.md" ;
    schema:softwareVersion "2.9.6" ;
    schema:url "https://github.com/mikolmogorov/Flye" .

