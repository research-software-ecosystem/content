@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chippeakanno a schema:SoftwareApplication ;
    schema:description "Batch annotation of the peaks identified from either ChIP-seq, ChIP-chip experiments, or any experiments that result in large number of genomic interval data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ChIPpeakAnno_3.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPpeakAnno/ChIPpeakAnno_3.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPpeakAnno_3.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chippeakanno/bioconductor-chippeakanno_3.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-ensembldb",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-graph",
        "bioconductor-interactionset",
        "bioconductor-iranges",
        "bioconductor-keggrest",
        "bioconductor-multtest",
        "bioconductor-pwalign",
        "bioconductor-rbgl",
        "bioconductor-regioner",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "bioconductor-universalmotif",
        "r-base",
        "r-data.table",
        "r-dbi",
        "r-dplyr",
        "r-ggplot2",
        "r-matrixstats",
        "r-scales",
        "r-stringr",
        "r-tibble",
        "r-tidyr",
        "r-venndiagram" ;
    schema:identifier biotools:chippeakanno ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-chippeakanno" ;
    schema:softwareVersion "3.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPpeakAnno.html" .

