@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ropls a schema1:SoftwareApplication ;
    schema1:description "PCA, PLS(-DA) and OPLS(-DA) for multivariate analysis and feature selection of omics data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ropls_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ropls/ropls_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ropls_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ropls/bioconductor-ropls_1.42.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-multiassayexperiment",
        "bioconductor-multidataset",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-ggplot2",
        "r-plotly" ;
    schema1:identifier biotools:ropls ;
    schema1:license "CeCILL" ;
    schema1:name "bioconductor-ropls" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ropls.html" .

