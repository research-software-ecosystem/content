@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mirintegrator a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/srep29251" ;
    schema:description "Integrating microRNA expression into signaling pathways for pathway analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/mirIntegrator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mirIntegrator/mirIntegrator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mirIntegrator_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mirintegrator/bioconductor-mirintegrator_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-graph",
        "bioconductor-org.hs.eg.db",
        "bioconductor-rgraphviz",
        "bioconductor-rontotools",
        "r-base",
        "r-ggplot2" ;
    schema:identifier biotools:mirintegrator ;
    schema:license "GPL (>=3)" ;
    schema:name "bioconductor-mirintegrator" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/mirIntegrator.html" .

