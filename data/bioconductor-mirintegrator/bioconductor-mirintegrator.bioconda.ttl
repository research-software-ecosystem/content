@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mirintegrator a schema1:SoftwareApplication ;
    schema1:alternateName "Integrating microRNA expression into signaling pathways for pathway analysis" ;
    schema1:citation "doi:10.1038/srep29251" ;
    schema1:description "Tools for augmenting signaling pathways to perform pathway analysis of microRNA and mRNA expression levels." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/mirIntegrator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mirIntegrator/mirIntegrator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mirIntegrator_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mirintegrator/bioconductor-mirintegrator_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mirintegrator" ;
    schema1:license "GPL (>=3)" ;
    schema1:name "bioconductor-mirintegrator" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mirIntegrator.html" .

