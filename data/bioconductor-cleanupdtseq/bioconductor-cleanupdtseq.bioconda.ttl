@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cleanupdtseq a schema:SoftwareApplication ;
    schema:description "cleanUpdTSeq cleans up artifacts from polyadenylation sites from oligo(dT)-mediated 3' end RNA sequending data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cleanUpdTSeq_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cleanUpdTSeq/cleanUpdTSeq_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cleanUpdTSeq_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cleanupdtseq/bioconductor-cleanupdtseq_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-bsgenome.drerio.ucsc.danrer7",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-e1071",
        "r-seqinr",
        "r-stringr" ;
    schema:identifier biotools:cleanupdtseq ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-cleanupdtseq" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cleanUpdTSeq.html" .

