@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-teqc a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr122" ;
    schema:description "Quality control for target capture experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/TEQC_4.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TEQC/TEQC_4.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TEQC_4.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-teqc/bioconductor-teqc_4.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-hwriter" ;
    schema:identifier biotools:teqc ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-teqc" ;
    schema:softwareVersion "4.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/TEQC.html" .

