@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:desalt a schema:SoftwareApplication ;
    schema:description "De Bruijn graph-based Spliced Aligner for Long Transcriptome reads." ;
    schema:downloadUrl "https://github.com/ydLiu-HIT/deSALT/archive/v1.5.6.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:deSALT ;
    schema:license "MIT" ;
    schema:name "desalt" ;
    schema:softwareHelp "https://github.com/ydLiu-HIT/deSALT/blob/v1.5.6/README.md" ;
    schema:softwareVersion "1.5.6" ;
    schema:url "https://github.com/ydLiu-HIT/deSALT" .

