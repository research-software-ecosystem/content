@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genetclassifier a schema:SoftwareApplication ;
    schema:description "Classify diseases and build associated gene networks using gene expression profiles" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/geNetClassifier_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geNetClassifier/geNetClassifier_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geNetClassifier_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genetclassifier/bioconductor-genetclassifier_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-ebarrays",
        "bioconductor-minet",
        "r-base",
        "r-e1071" ;
    schema:identifier biotools:genetclassifier ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-genetclassifier" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/geNetClassifier.html" .

