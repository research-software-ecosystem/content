@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genetclassifier a schema1:SoftwareApplication ;
    schema1:alternateName "Classify diseases and build associated gene networks using gene expression profiles" ;
    schema1:description "Comprehensive package to automatically train and validate a multi-class SVM classifier based on gene expression data. Provides transparent selection of gene markers, their coexpression networks, and an interface to query the classifier." ;
    schema1:identifier biotools:genetclassifier ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-genetclassifier" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/geNetClassifier.html" .

