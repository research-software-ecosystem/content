@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gffutils a schema:SoftwareApplication ;
    schema:description "Work with GFF and GTF files in a flexible database framework" ;
    schema:downloadUrl "https://pypi.io/packages/source/g/gffutils/gffutils-0.14.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:GFFutils ;
    schema:license "MIT" ;
    schema:name "gffutils" ;
    schema:softwareHelp "http://daler.github.io/gffutils/" ;
    schema:softwareVersion "0.14" ;
    schema:url "https://github.com/daler/gffutils" .

