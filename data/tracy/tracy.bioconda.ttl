@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:tracy a schema1:SoftwareApplication ;
    schema1:alternateName "Basecalling, alignment, assembly and deconvolution of Sanger chromatogram trace files" ;
    schema1:citation "doi:10.1186/s12864-020-6635-8" ;
    schema1:description "Basecalling, alignment, assembly and deconvolution of Sanger chromatogram trace files" ;
    schema1:identifier <https://bio.tools/biotools:Gear-Genomics> ;
    schema1:license "BSD-3-Clause" ;
    schema1:name "tracy" ;
    schema1:softwareVersion "0.8.1" ;
    schema1:url "https://github.com/gear-genomics/tracy" .

