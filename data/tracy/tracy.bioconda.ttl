@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tracy a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-020-6635-8" ;
    schema:description "Basecalling, alignment, assembly and deconvolution of Sanger chromatogram trace files" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "htslib",
        "libdeflate",
        "zlib" ;
    schema:identifier biotools:Gear-Genomics ;
    schema:license "BSD-3-Clause" ;
    schema:name "tracy" ;
    schema:softwareHelp "https://github.com/gear-genomics/tracy/blob/v0.8.1/README.md" ;
    schema:softwareVersion "0.8.1" ;
    schema:url "https://github.com/gear-genomics/tracy" .

