@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-survcomp a schema1:SoftwareApplication ;
    schema1:alternateName "Performance Assessment and Comparison for Survival Analysis" ;
    schema1:description "Assessment and Comparison for Performance of Risk Prediction (Survival) Models." ;
    schema1:identifier biotools:survcomp ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-survcomp" ;
    schema1:softwareVersion "1.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/survcomp.html" .

