@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-survcomp a schema:SoftwareApplication ;
    schema:description "Performance Assessment and Comparison for Survival Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/survcomp_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/survcomp/survcomp_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/survcomp_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-survcomp/bioconductor-survcomp_1.60.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bootstrap",
        "r-ipred",
        "r-kernsmooth",
        "r-prodlim",
        "r-rmeta",
        "r-suppdists",
        "r-survival",
        "r-survivalroc",
        "zlib" ;
    schema:identifier biotools:survcomp ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-survcomp" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/survcomp.html" .

