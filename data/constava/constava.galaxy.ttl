@prefix schema1: <http://schema.org/> .

galaxytool:constava a schema1:SoftwareApplication ;
    bioschemas:output "csv" ;
    schema1:applicationSubCategory edam:topic_0130 ;
    schema1:codeRepository <https://github.com/bio2byte/constava> ;
    schema1:dateCreated "2024-08-13" ;
    schema1:description "Calculate 'conformational states probabilities' and 'conformational state variability' from a protein structure ensemble" ;
    schema1:encodingFormat "csv" ;
    schema1:featureList edam:operation_0249 ;
    schema1:identifier biotools:constava,
        bioconda:constava ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Proteomics",
        "Statistics" ;
    schema1:name "constava" ;
    schema1:softwareVersion "1.2.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/constava> .

