@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:infercnv a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:codeRepository <https://github.com/broadinstitute/infercnv> ;
    schema1:dateCreated "2024-07-23" ;
    schema1:description "Infer Copy Number Variation from Single-Cell RNA-Seq Data" ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_0531,
        edam:operation_2495,
        edam:operation_3432,
        edam:operation_3680,
        edam:operation_3961 ;
    schema1:identifier biotools:infercnv,
        bioconda:bioconductor-infercnv ;
    schema1:isPartOf <https://usegalaxy.eu> ;
    schema1:keywords "Single Cell",
        "Transcriptomics",
        "Variant Analysis" ;
    schema1:name "infercnv" ;
    schema1:softwareVersion "1.26.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/infercnv> .

<https://usegalaxy.eu> a schema1:WebSite .

