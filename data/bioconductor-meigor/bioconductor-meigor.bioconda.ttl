@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-meigor a schema1:SoftwareApplication ;
    schema1:alternateName "MEIGOR - MEtaheuristics for bIoinformatics Global Optimization" ;
    schema1:citation "doi:10.1186/1471-2105-15-136" ;
    schema1:description "MEIGOR provides a comprehensive environment for performing global optimization tasks in bioinformatics and systems biology. It leverages advanced metaheuristic algorithms to efficiently search the solution space and is specifically tailored to handle the complexity and high-dimensionality of biological datasets. This package supports various optimization routines and is integrated with Bioconductor's infrastructure for a seamless analysis workflow." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MEIGOR_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MEIGOR/MEIGOR_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MEIGOR_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-meigor/bioconductor-meigor_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:meigor" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-meigor" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MEIGOR.html" .

