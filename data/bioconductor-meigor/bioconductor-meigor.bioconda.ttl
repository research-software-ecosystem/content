@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-meigor a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-15-136" ;
    schema:description "MEIGOR - MEtaheuristics for bIoinformatics Global Optimization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MEIGOR_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MEIGOR/MEIGOR_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MEIGOR_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-meigor/bioconductor-meigor_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-cnorode",
        "r-base",
        "r-desolve",
        "r-rsolnp",
        "r-snowfall" ;
    schema:identifier biotools:meigor ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-meigor" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MEIGOR.html" .

