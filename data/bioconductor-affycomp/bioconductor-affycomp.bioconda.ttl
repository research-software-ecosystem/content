@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affycomp a schema1:SoftwareApplication ;
    schema1:alternateName "Graphics Toolbox for Assessment of Affymetrix Expression Measures" ;
    schema1:citation "doi:10.1093/bioinformatics/btg410" ;
    schema1:description "The package contains functions that can be used to compare expression measures for Affymetrix Oligonucleotide Arrays." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/affycomp_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affycomp/affycomp_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affycomp_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affycomp/bioconductor-affycomp_1.86.0_src_all.tar.gz" ;
    schema1:identifier "biotools:affycomp" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-affycomp" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affycomp.html" .

