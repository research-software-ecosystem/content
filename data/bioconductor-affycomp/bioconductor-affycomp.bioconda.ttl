@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affycomp a schema1:SoftwareApplication ;
    schema1:alternateName "Graphics Toolbox for Assessment of Affymetrix Expression Measures" ;
    schema1:citation "doi:10.1093/bioinformatics/btg410" ;
    schema1:description "The package contains functions that can be used to compare expression measures for Affymetrix Oligonucleotide Arrays." ;
    schema1:identifier <https://bio.tools/biotools:affycomp> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-affycomp" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affycomp.html" .

