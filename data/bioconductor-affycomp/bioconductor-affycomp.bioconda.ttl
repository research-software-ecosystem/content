@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-affycomp a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btg410" ;
    schema:description "Graphics Toolbox for Assessment of Affymetrix Expression Measures" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/affycomp_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affycomp/affycomp_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affycomp_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affycomp/bioconductor-affycomp_1.86.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:affycomp ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-affycomp" ;
    schema:softwareVersion "1.86.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/affycomp.html" .

