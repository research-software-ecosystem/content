@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:links a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "graph_dot",
        "tabular" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:operation_2429,
        edam:topic_0102,
        edam:topic_0196,
        edam:topic_3168 ;
    schema1:codeRepository <https://github.com/bcgsc/LINKS> ;
    schema1:dateCreated "2022-02-23" ;
    schema1:description "Scaffold genome assemblies with long reads." ;
    schema1:encodingFormat "fasta",
        "graph_dot",
        "tabular" ;
    schema1:featureList edam:operation_0525,
        edam:operation_3192,
        edam:operation_3198,
        edam:operation_3216,
        edam:operation_3219,
        edam:operation_3440 ;
    schema1:identifier biotools:links,
        bioconda:links ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Assembly" ;
    schema1:name "links" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy+@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/links> .

<https://galaxytrakr.org> a schema1:WebSite .

<https://usegalaxy.cz> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org.au> a schema1:WebSite .

