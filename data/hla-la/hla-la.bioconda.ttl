@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hla-la a schema:SoftwareApplication ;
    schema:description "HLA typing from short and long reads" ;
    schema:downloadUrl "https://github.com/DiltheyLab/HLA-LA/archive/v1.0.4.tar.gz" ;
    schema:hasPart "bamtools",
        "boost-cpp",
        "perl-bio-db-hts",
        "perl-bio-featureio",
        "perl-bioperl",
        "perl-bioperl-core",
        "perl-list-moreutils",
        "perl-text-levenshtein",
        "zlib" ;
    schema:identifier biotools:hla-la ;
    schema:license "GPL" ;
    schema:name "hla-la" ;
    schema:softwareVersion "1.0.4" ;
    schema:url "https://github.com/DiltheyLab/HLA-LA" .

