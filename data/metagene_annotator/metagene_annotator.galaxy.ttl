@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:metagene_annotator a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0621,
        edam:topic_0622 ;
    schema1:codeRepository "http://metagene.nig.ac.jp/" ;
    schema1:dateCreated "2018-03-21" ;
    schema1:description "MetaGeneAnnotator gene-finding program for prokaryote and phage" ;
    schema1:encodingFormat "bed",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_0361,
        edam:topic_0221 ;
    schema1:identifier biotools:metageneannotator,
        bioconda:metagene_annotator ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=3dcf09e75d707573>,
        <https://usegalaxy.eu/published/workflow?id=799b924edd3c401b>,
        <https://usegalaxy.eu/published/workflow?id=9b9e1e28f3683f92>,
        <https://usegalaxy.eu/published/workflow?id=a644e6b450dabca8> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "metagene_annotator" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproteomics/tools-galaxyp/tree/master/metagene_annotator" .

<https://usegalaxy.eu> a schema1:WebSite .

