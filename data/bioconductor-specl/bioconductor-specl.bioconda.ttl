@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-specl a schema:SoftwareApplication ;
    schema:description "specL - Prepare Peptide Spectrum Matches for Use in Targeted Proteomics" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/specL_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/specL/specL_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/specL_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-specl/bioconductor-specl_1.44.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-dbi",
        "r-protviz",
        "r-rsqlite",
        "r-seqinr" ;
    schema:identifier biotools:specl ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-specl" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/specL.html" .

