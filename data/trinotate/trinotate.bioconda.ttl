@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trinotate a schema:SoftwareApplication ;
    schema:description "Trinotate is a comprehensive annotation suite designed for automatic functional annotation of transcriptomes, particularly de novo assembled transcriptomes, from model or non-model organisms" ;
    schema:downloadUrl "https://github.com/Trinotate/Trinotate/archive/refs/tags/Trinotate-v4.0.2.tar.gz" ;
    schema:hasPart "perl",
        "perl-app-cpanminus",
        "perl-dbd-sqlite",
        "perl-dbi",
        "perl-file-find-rule",
        "perl-module-build" ;
    schema:identifier biotools:trinotate ;
    schema:license "BSD-3-Clause" ;
    schema:name "trinotate" ;
    schema:softwareVersion "4.0.2" ;
    schema:url "https://trinotate.github.io/" .

