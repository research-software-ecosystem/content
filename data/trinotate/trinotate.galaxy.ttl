@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:trinotate a schema1:SoftwareApplication ;
    bioschemas:output "sqlite",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0203,
        edam:topic_3308 ;
    schema1:codeRepository <https://trinotate.github.io/> ;
    schema1:dateCreated "2016-11-15" ;
    schema1:description "Trinotate is a comprehensive annotation suite designed for automatic functional annotation of de novo transcriptomes." ;
    schema1:encodingFormat "sqlite",
        "tabular" ;
    schema1:featureList edam:operation_3672 ;
    schema1:identifier biotools:trinotate,
        bioconda:trinotate ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://workflowhub.eu/workflows/1716?version=1> ;
    schema1:keywords "RNA",
        "Transcriptomics" ;
    schema1:name "trinotate" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/trinotate> .

<https://usegalaxy.cz> a schema1:WebSite .

