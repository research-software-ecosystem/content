@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-fishalyser a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "FISHalyseR a package for automated FISH quantification" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/FISHalyseR_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/FISHalyseR/FISHalyseR_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/FISHalyseR_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fishalyser/bioconductor-fishalyser_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-ebimage",
        "r-abind",
        "r-base" ;
    schema:identifier biotools:fishalyser ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-fishalyser" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/FISHalyseR.html" .

