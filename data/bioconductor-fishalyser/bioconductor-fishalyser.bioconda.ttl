@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-fishalyser a schema1:SoftwareApplication ;
    schema1:alternateName "FISHalyseR a package for automated FISH quantification" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "FISHalyseR provides functionality to process and analyse digital cell culture images, in particular to quantify FISH probes within nuclei. Furthermore, it extract the spatial location of each nucleus as well as each probe enabling spatial co-localisation analysis." ;
    schema1:identifier biotools:fishalyser ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-fishalyser" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/FISHalyseR.html" .

