@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chromplot a schema1:SoftwareApplication ;
    schema1:alternateName "Global visualization tool of genomic data" ;
    schema1:citation "doi:10.1093/bioinformatics/btw137" ;
    schema1:description "Package designed to visualize genomic data along the chromosomes, where the vertical chromosomes are sorted by number, with sex chromosomes at the end." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/chromPlot_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/chromPlot/chromPlot_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/chromPlot_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chromplot/bioconductor-chromplot_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:chromplot" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-chromplot" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/chromPlot.html" .

