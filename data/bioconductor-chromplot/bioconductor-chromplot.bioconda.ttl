@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chromplot a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw137" ;
    schema:description "Global visualization tool of genomic data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/chromPlot_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/chromPlot/chromPlot_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/chromPlot_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chromplot/bioconductor-chromplot_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biomart",
        "bioconductor-genomicranges",
        "r-base" ;
    schema:identifier biotools:chromplot ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-chromplot" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/chromPlot.html" .

