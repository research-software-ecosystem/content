@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rdgidb a schema1:SoftwareApplication ;
    schema1:alternateName "R Wrapper for DGIdb" ;
    schema1:citation "doi:10.12688/f1000research.9357.1" ;
    schema1:description "The rDGIdb package provides a wrapper for the Drug Gene Interaction Database (DGIdb). For simplicity, the wrapper query function and output resembles the user interface and results format provided on the DGIdb website (https://www.dgidb.org/)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rDGIdb_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/rDGIdb/rDGIdb_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/rDGIdb_1.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rdgidb/bioconductor-rdgidb_1.28.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rdgidb" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-rdgidb" ;
    schema1:softwareVersion "1.28.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/rDGIdb.html" .

