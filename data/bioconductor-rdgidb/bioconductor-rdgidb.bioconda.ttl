@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rdgidb a schema:SoftwareApplication ;
    schema:citation "doi:10.12688/f1000research.9357.1" ;
    schema:description "R Wrapper for DGIdb" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rDGIdb_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/rDGIdb/rDGIdb_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/rDGIdb_1.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rdgidb/bioconductor-rdgidb_1.28.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-httr",
        "r-jsonlite" ;
    schema:identifier biotools:rdgidb ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-rdgidb" ;
    schema:softwareVersion "1.28.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/rDGIdb.html" .

