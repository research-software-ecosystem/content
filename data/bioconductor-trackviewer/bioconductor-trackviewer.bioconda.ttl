@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-trackviewer a schema1:SoftwareApplication ;
    schema1:alternateName "A R/Bioconductor package with web interface for drawing elegant interactive tracks or lollipop plot to facilitate integrated analysis of multi-omics data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Visualize mapped reads along with annotation as track layers for NGS dataset such as ChIP-seq, RNA-seq, miRNA-seq, DNA-seq, SNPs and methylation data." ;
    schema1:identifier biotools:trackviewer ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-trackviewer" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/trackViewer.html" .

