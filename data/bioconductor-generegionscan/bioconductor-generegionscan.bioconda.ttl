@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-generegionscan a schema:SoftwareApplication ;
    schema:description "GeneRegionScan" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GeneRegionScan_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneRegionScan/GeneRegionScan_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneRegionScan_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-generegionscan/bioconductor-generegionscan_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affxparser",
        "bioconductor-biobase",
        "bioconductor-biostrings",
        "bioconductor-s4vectors",
        "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:generegionscan ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-generegionscan" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GeneRegionScan.html" .

