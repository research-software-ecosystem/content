@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kmergenie a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt310" ;
    schema:description "KmerGenie estimates the best k-mer length for genome de novo assembly." ;
    schema:downloadUrl "http://kmergenie.bx.psu.edu/kmergenie-1.7051.tar.gz" ;
    schema:hasPart "python",
        "r-base",
        "wget",
        "zlib" ;
    schema:identifier biotools:kmergenie ;
    schema:license "Free Software License" ;
    schema:name "kmergenie" ;
    schema:softwareHelp "http://kmergenie.bx.psu.edu/README" ;
    schema:softwareVersion "1.7051" ;
    schema:url "http://kmergenie.bx.psu.edu" .

