@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowploidy a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Analyze flow cytometer data to determine sample ploidy" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowPloidy_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowPloidy/flowPloidy_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowPloidy_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowploidy/bioconductor-flowploidy_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-flowcore",
        "r-base",
        "r-car",
        "r-catools",
        "r-knitr",
        "r-minpack.lm",
        "r-rmarkdown",
        "r-shiny" ;
    schema:identifier biotools:flowploidy ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-flowploidy" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowPloidy.html" .

