@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowploidy a schema1:SoftwareApplication ;
    schema1:alternateName "Analyze flow cytometer data to determine sample ploidy" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Determine sample ploidy via flow cytometry histogram analysis. Reads Flow Cytometry Standard (FCS) files via the flowCore bioconductor package, and provides functions for determining the DNA ploidy of samples based on internal standards." ;
    schema1:identifier biotools:flowploidy ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-flowploidy" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowPloidy.html" .

