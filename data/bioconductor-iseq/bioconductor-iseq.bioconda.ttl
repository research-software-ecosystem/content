@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-iseq a schema1:SoftwareApplication ;
    schema1:alternateName "Bayesian Hierarchical Modeling of ChIP-seq Data Through Hidden Ising Models" ;
    schema1:citation "doi:10.1111/j.1541-0420.2009.01379.x" ;
    schema1:description "Bayesian hidden Ising models are implemented to identify IP-enriched genomic regions from ChIP-seq data. They can be used to analyze ChIP-seq data with and without controls and replicates." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/iSeq_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iSeq/iSeq_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iSeq_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-iseq/bioconductor-iseq_1.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:iseq" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-iseq" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/iSeq.html" .

