@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-iseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1111/j.1541-0420.2009.01379.x" ;
    schema:description "Bayesian Hierarchical Modeling of ChIP-seq Data Through Hidden Ising Models" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/iSeq_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iSeq/iSeq_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iSeq_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-iseq/bioconductor-iseq_1.62.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:iseq ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-iseq" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/iSeq.html" .

