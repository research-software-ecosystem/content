@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mrbayes a schema:SoftwareApplication ;
    schema:description "Bayesian Inference of Phylogeny" ;
    schema:downloadUrl "https://github.com/NBISweden/MrBayes/archive/v3.2.7.tar.gz" ;
    schema:hasPart "beagle-lib",
        "ncurses",
        "openmpi",
        "readline" ;
    schema:identifier biotools:mrbayes ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "mrbayes" ;
    schema:softwareHelp "https://nbisweden.github.io/MrBayes/" ;
    schema:softwareVersion "3.2.7" ;
    schema:url "https://github.com/NBISweden/MrBayes" .

