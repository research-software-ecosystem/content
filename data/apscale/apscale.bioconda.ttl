@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:apscale a schema:SoftwareApplication ;
    schema:author "DominikBuchner" ;
    schema:description "Advanced Pipeline for Simple yet Comprehensive AnaLysEs of DNA metabarcoding data." ;
    schema:downloadUrl "https://pypi.org/packages/source/a/apscale/apscale-4.3.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:apscale ;
    schema:license "MIT" ;
    schema:maintainer "DominikBuchner" ;
    schema:name "apscale" ;
    schema:softwareHelp "https://github.com/DominikBuchner/apscale/blob/main/README.md" ;
    schema:softwareVersion "4.3.2" ;
    schema:url "https://github.com/DominikBuchner/apscale" .

