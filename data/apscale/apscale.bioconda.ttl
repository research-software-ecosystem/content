@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:apscale a schema1:SoftwareApplication ;
    schema1:alternateName "Advanced Pipeline for Simple yet Comprehensive AnaLysEs of DNA metabarcoding data." ;
    schema1:description "Advanced Pipeline for Simple yet Comprehensive AnaLysEs of DNA metabarcoding data." ;
    schema1:identifier <https://bio.tools/biotools:apscale> ;
    schema1:license "MIT" ;
    schema1:maintainer "DominikBuchner" ;
    schema1:name "apscale" ;
    schema1:softwareVersion "4.3.3" ;
    schema1:url "https://github.com/DominikBuchner/apscale" .

