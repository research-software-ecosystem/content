@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hyperdraw a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Visualizing Hypergaphs" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/hyperdraw_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/hyperdraw/hyperdraw_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/hyperdraw_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hyperdraw/bioconductor-hyperdraw_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-hypergraph",
        "bioconductor-rgraphviz",
        "graphviz",
        "r-base" ;
    schema:identifier biotools:hyperdraw ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-hyperdraw" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/hyperdraw.html" .

