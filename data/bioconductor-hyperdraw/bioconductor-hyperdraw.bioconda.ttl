@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hyperdraw a schema1:SoftwareApplication ;
    schema1:alternateName "Visualizing Hypergaphs" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for visualizing hypergraphs." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/hyperdraw_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/hyperdraw/hyperdraw_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/hyperdraw_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hyperdraw/bioconductor-hyperdraw_1.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:hyperdraw" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-hyperdraw" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/hyperdraw.html" .

