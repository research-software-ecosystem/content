@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hyperdraw a schema1:SoftwareApplication ;
    schema1:alternateName "Visualizing Hypergaphs" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for visualizing hypergraphs." ;
    schema1:identifier biotools:hyperdraw ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-hyperdraw" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/hyperdraw.html" .

