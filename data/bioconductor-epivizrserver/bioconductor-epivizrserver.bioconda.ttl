@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-epivizrserver a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "WebSocket server infrastructure for epivizr apps and packages" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/epivizrServer_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/epivizrServer/epivizrServer_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/epivizrServer_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-epivizrserver/bioconductor-epivizrserver_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "r-base",
        "r-httpuv",
        "r-mime",
        "r-r6",
        "r-rjson" ;
    schema1:identifier biotools:epivizrserver ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-epivizrserver" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/epivizrServer.html" .

