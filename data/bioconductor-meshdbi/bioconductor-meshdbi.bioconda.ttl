@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-meshdbi a schema1:SoftwareApplication ;
    schema1:alternateName "DBI to construct MeSH-related package from sqlite file" ;
    schema1:description "The package is unified implementation of MeSH.db, MeSH.AOR.db, and MeSH.PCR.db and also is interface to construct Gene-MeSH package (MeSH.XXX.eg.db). loadMeSHDbiPkg import sqlite file and generate MeSH.XXX.eg.db." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MeSHDbi_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MeSHDbi/MeSHDbi_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MeSHDbi_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-meshdbi/bioconductor-meshdbi_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:meshdbi" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-meshdbi" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MeSHDbi.html" .

