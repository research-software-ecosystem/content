@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-meshdbi a schema:SoftwareApplication ;
    schema:description "DBI to construct MeSH-related package from sqlite file" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MeSHDbi_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MeSHDbi/MeSHDbi_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MeSHDbi_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-meshdbi/bioconductor-meshdbi_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "r-base",
        "r-rsqlite" ;
    schema:identifier biotools:meshdbi ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-meshdbi" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MeSHDbi.html" .

