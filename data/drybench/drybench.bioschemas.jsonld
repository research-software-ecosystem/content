  "@id": "https://bio.tools/drybench",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:additionalType": [
    "Bioinformatics portal",
    "Desktop application",
    "Suite",
    "Web application"
  ],
  "sc:applicationSubCategory": {
    "@id": "edam:topic_4019"
  },
  "sc:description": "Drybench is a free suite of in-browser research tools for biology and drug development. It covers assay analysis (dose-response and IC50/EC50 fitting, ELISA and protein standard curves, qPCR fold change, plate QC), lab calculations (molarity, dilutions, serial dilutions, A280, buffers), DNA and protein sequence tools (reverse complement, primer Tm, dimer and hairpin checks, protein MW and pI), plasmid maps with restriction digests, small-molecule drug-likeness, protein structure lookup, bioreactor simulation, and clinical-trial and FDA approval data. Each result names its method, data source and limits. The tools run in the web browser, and no account is needed",
  "sc:featureList": {
    "@id": "edam:operation_2403"
  },
  "sc:isAccessibleForFree": true,
  "sc:name": "Drybench",
  "sc:softwareHelp": {
    "@id": "https://www.drybench.com/docs"
  },
  "sc:softwareVersion": "v1",
  "sc:url": "https://www.drybench.com"
