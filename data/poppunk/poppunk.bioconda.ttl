@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:poppunk a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.241455.118" ;
    schema:description "PopPUNK (POPulation Partitioning Using Nucleotide Kmers)" ;
    schema:downloadUrl "https://github.com/bacpop/poppunk/archive/v2.7.8.tar.gz" ;
    schema:hasPart "boost-cpp",
        "eigen",
        "pip",
        "pybind11",
        "python",
        "zlib" ;
    schema:identifier biotools:poppunk ;
    schema:license "Apache-2.0" ;
    schema:name "poppunk" ;
    schema:softwareHelp "https://poppunk.bacpop.org/index.html" ;
    schema:softwareVersion "2.7.8" ;
    schema:url "https://poppunk.bacpop.org" .

