@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-minfi a schema1:SoftwareApplication ;
    schema1:alternateName "Analyze Illumina Infinium DNA methylation arrays" ;
    schema1:description "Tools to analyze & visualize Illumina Infinium methylation arrays." ;
    schema1:identifier biotools:minfi ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-minfi" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/minfi.html" .

