@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-minfi a schema1:SoftwareApplication ;
    schema1:description "Analyze Illumina Infinium DNA methylation arrays" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/minfi_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/minfi/minfi_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/minfi_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-minfi/bioconductor-minfi_1.56.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bumphunter",
        "bioconductor-delayedarray",
        "bioconductor-delayedmatrixstats",
        "bioconductor-genefilter",
        "bioconductor-genomicranges",
        "bioconductor-geoquery",
        "bioconductor-hdf5array",
        "bioconductor-illuminaio",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-preprocesscore",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-siggenes",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-beanplot",
        "r-data.table",
        "r-lattice",
        "r-mass",
        "r-mclust",
        "r-nlme",
        "r-nor1mix",
        "r-quadprog",
        "r-rcolorbrewer",
        "r-reshape" ;
    schema1:identifier biotools:minfi ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-minfi" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/minfi.html" .

