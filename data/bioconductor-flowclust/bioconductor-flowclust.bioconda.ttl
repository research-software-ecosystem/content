@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowclust a schema:SoftwareApplication ;
    schema:description "Clustering for Flow Cytometry" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowClust_3.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowClust/flowClust_3.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowClust_3.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowclust/bioconductor-flowclust_3.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-flowcore",
        "bioconductor-graph",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:flowclust ;
    schema:license "MIT" ;
    schema:name "bioconductor-flowclust" ;
    schema:softwareVersion "3.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowClust.html" .

