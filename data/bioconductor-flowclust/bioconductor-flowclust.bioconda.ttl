@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowclust a schema1:SoftwareApplication ;
    schema1:alternateName "Clustering for Flow Cytometry" ;
    schema1:description "Robust model-based clustering using a t-mixture model with Box-Cox transformation. Note: users should have GSL installed. Windows users: 'consult the README file available in the inst directory of the source distribution for necessary configuration instructions'." ;
    schema1:identifier biotools:flowclust ;
    schema1:license "MIT" ;
    schema1:name "bioconductor-flowclust" ;
    schema1:softwareVersion "3.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowClust.html" .

