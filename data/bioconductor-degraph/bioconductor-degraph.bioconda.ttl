@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-degraph a schema:SoftwareApplication ;
    schema:citation "doi:10.1214/11-AOAS528" ;
    schema:description "Two-sample tests on a graph" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DEGraph_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEGraph/DEGraph_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DEGraph_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-degraph/bioconductor-degraph_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-kegggraph",
        "bioconductor-ncigraph",
        "bioconductor-rbgl",
        "bioconductor-rgraphviz",
        "r-base",
        "r-lattice",
        "r-mvtnorm",
        "r-r.methodss3",
        "r-r.utils",
        "r-rrcov" ;
    schema:identifier biotools:degraph ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-degraph" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DEGraph.html" .

