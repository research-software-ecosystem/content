@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-glimma a schema1:SoftwareApplication ;
    schema1:alternateName "Interactive visualizations for gene expression analysis" ;
    schema1:citation "doi:10.1101/096107" ;
    schema1:description "This package produces interactive visualizations for RNA-seq data analysis, utilizing output from limma, edgeR, or DESeq2. It produces interactive htmlwidgets versions of popular RNA-seq analysis plots to enhance the exploration of analysis results by overlaying interactive features. The plots can be viewed in a web browser or embedded in notebook documents." ;
    schema1:identifier <https://bio.tools/biotools:glimma> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-glimma" ;
    schema1:softwareVersion "2.20.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Glimma.html" .

