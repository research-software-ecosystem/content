@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-glimma a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/096107" ;
    schema:description "Interactive visualizations for gene expression analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Glimma_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Glimma/Glimma_2.20.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Glimma_2.20.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-glimma/bioconductor-glimma_2.20.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-deseq2",
        "bioconductor-edger",
        "bioconductor-limma",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-htmlwidgets",
        "r-jsonlite" ;
    schema:identifier biotools:glimma ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-glimma" ;
    schema:softwareVersion "2.20.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Glimma.html" .

