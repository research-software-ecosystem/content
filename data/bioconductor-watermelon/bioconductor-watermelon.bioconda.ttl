@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-watermelon a schema:SoftwareApplication ;
    schema:description "Illumina DNA methylation array normalization and metrics" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/wateRmelon_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/wateRmelon/wateRmelon_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/wateRmelon_2.16.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-watermelon/bioconductor-watermelon_2.16.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-illuminahumanmethylation450kanno.ilmn12.hg19",
        "bioconductor-illuminaio",
        "bioconductor-limma",
        "bioconductor-lumi",
        "bioconductor-methylumi",
        "bioconductor-roc",
        "r-base",
        "r-matrixstats" ;
    schema:identifier biotools:watermelon ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-watermelon" ;
    schema:softwareVersion "2.16.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/wateRmelon.html" .

