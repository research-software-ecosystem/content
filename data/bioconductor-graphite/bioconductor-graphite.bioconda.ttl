@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-graphite a schema1:SoftwareApplication ;
    schema1:alternateName "GRAPH Interaction from pathway Topological Environment" ;
    schema1:description "Graph objects from pathway topology derived from KEGG, Panther, PathBank, PharmGKB, Reactome SMPDB and WikiPathways databases." ;
    schema1:identifier biotools:graphite ;
    schema1:license "AGPL-3" ;
    schema1:name "bioconductor-graphite" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/graphite.html" .

