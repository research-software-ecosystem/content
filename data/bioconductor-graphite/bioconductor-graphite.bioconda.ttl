@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-graphite a schema:SoftwareApplication ;
    schema:description "GRAPH Interaction from pathway Topological Environment" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/graphite_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/graphite/graphite_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/graphite_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-graphite/bioconductor-graphite_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-dir.expiry",
        "bioconductor-graph",
        "r-base",
        "r-httr",
        "r-lifecycle",
        "r-purrr",
        "r-rappdirs",
        "r-rlang" ;
    schema:identifier biotools:graphite ;
    schema:license "AGPL-3" ;
    schema:name "bioconductor-graphite" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/graphite.html" .

