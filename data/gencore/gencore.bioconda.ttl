@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gencore a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-019-3280-9" ;
    schema:description "Generate consensus reads to reduce sequencing noises and remove duplications." ;
    schema:downloadUrl "https://github.com/OpenGene/gencore/archive/v0.17.2.tar.gz" ;
    schema:hasPart "htslib",
        "zlib" ;
    schema:identifier biotools:gencore ;
    schema:license "MIT" ;
    schema:name "gencore" ;
    schema:softwareHelp "https://github.com/OpenGene/gencore/blob/v0.17.2/README.md" ;
    schema:softwareVersion "0.17.2" ;
    schema:url "https://github.com/OpenGene/gencore" .

