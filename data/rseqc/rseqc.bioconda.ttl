@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rseqc a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bts356" ;
    schema:description "QC package for RNA-seq data." ;
    schema:downloadUrl "https://pypi.org/packages/source/r/rseqc/rseqc-5.0.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:rseqc ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "rseqc" ;
    schema:softwareHelp "https://rseqc.sourceforge.net/#usage-information" ;
    schema:softwareVersion "5.0.4" ;
    schema:url "https://rseqc.sourceforge.net" .

