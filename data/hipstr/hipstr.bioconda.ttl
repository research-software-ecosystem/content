@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:hipstr a schema1:SoftwareApplication ;
    schema1:alternateName "Genotype and phase short tandem repeats using Illumina whole-genome sequencing data" ;
    schema1:citation "doi:10.1038/nmeth.4267" ;
    schema1:description "Genotype and phase short tandem repeats using Illumina whole-genome sequencing data" ;
    schema1:identifier <https://bio.tools/biotools:hipstr> ;
    schema1:license "GPL-2.0-only" ;
    schema1:name "hipstr" ;
    schema1:softwareVersion "0.7" ;
    schema1:url "https://github.com/tfwillems/HipSTR" .

