@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-variancepartition a schema1:SoftwareApplication ;
    schema1:description "Quantify and interpret drivers of variation in multilevel gene expression experiments" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/variancePartition_1.40.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/variancePartition/variancePartition_1.40.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/variancePartition_1.40.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-variancepartition/bioconductor-variancepartition_1.40.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocparallel",
        "bioconductor-limma",
        "r-aod",
        "r-base",
        "r-corpcor",
        "r-fancova",
        "r-ggplot2",
        "r-gplots",
        "r-gtools",
        "r-iterators",
        "r-lme4",
        "r-lmertest",
        "r-mass",
        "r-matrix",
        "r-matrixstats",
        "r-pbkrtest",
        "r-rdpack",
        "r-reformulas",
        "r-remacor",
        "r-reshape2",
        "r-rhpcblasctl",
        "r-rlang",
        "r-scales" ;
    schema1:identifier biotools:variancepartition ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-variancepartition" ;
    schema1:softwareVersion "1.40.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/variancePartition.html" .

