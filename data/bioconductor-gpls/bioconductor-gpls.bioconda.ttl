@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gpls a schema:SoftwareApplication ;
    schema:citation "doi:10.1198/106186005X47697" ;
    schema:description "Classification using generalized partial least squares" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/gpls_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gpls/gpls_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gpls_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gpls/bioconductor-gpls_1.82.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:gpls ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gpls" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/gpls.html" .

