@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gpls a schema1:SoftwareApplication ;
    schema1:alternateName "Classification using generalized partial least squares" ;
    schema1:citation "doi:10.1198/106186005X47697" ;
    schema1:description "Classification using generalized partial least squares for two-group and multi-group (more than 2 group) classification." ;
    schema1:identifier <https://bio.tools/biotools:gpls> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gpls" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/gpls.html" .

