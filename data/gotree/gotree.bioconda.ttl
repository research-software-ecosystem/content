@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gotree a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nargab/lqab075" ;
    schema:description "gotree is a set of command line tools to manipulate phylogenetic trees." ;
    schema:downloadUrl "https://github.com/evolbioinfo/gotree/archive/v0.5.1.tar.gz" ;
    schema:identifier biotools:gotree ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "gotree" ;
    schema:softwareHelp "https://github.com/evolbioinfo/gotree/blob/v0.5.1/README.md" ;
    schema:softwareVersion "0.5.1" ;
    schema:url "https://github.com/evolbioinfo/gotree" .

