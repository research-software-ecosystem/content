@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-synergyfinder a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btx162" ;
    schema1:description "Calculate and Visualize Synergy Scores for Drug Combinations" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/synergyfinder_3.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/synergyfinder/synergyfinder_3.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/synergyfinder_3.18.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-synergyfinder/bioconductor-synergyfinder_3.18.0_src_all.tar.gz" ;
    schema1:hasPart "r-base",
        "r-dplyr",
        "r-drc",
        "r-furrr",
        "r-future",
        "r-ggforce",
        "r-ggplot2",
        "r-ggrepel",
        "r-gstat",
        "r-kriging",
        "r-lattice",
        "r-magrittr",
        "r-metr",
        "r-mice",
        "r-nleqslv",
        "r-pbapply",
        "r-plotly",
        "r-purrr",
        "r-reshape2",
        "r-sp",
        "r-spatialextremes",
        "r-stringr",
        "r-tidyr",
        "r-tidyverse",
        "r-vegan" ;
    schema1:identifier biotools:synergyfinder ;
    schema1:license "Mozilla Public License 2.0" ;
    schema1:name "bioconductor-synergyfinder" ;
    schema1:softwareVersion "3.18.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/synergyfinder.html" .

