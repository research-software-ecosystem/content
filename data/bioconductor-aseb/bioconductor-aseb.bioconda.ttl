@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-aseb a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gks437" ;
    schema:description "Predict Acetylated Lysine Sites" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ASEB_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ASEB_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ASEB/ASEB_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-aseb/bioconductor-aseb_1.54.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:aseb ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-aseb" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ASEB.html" .

