@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-aseb a schema1:SoftwareApplication ;
    schema1:alternateName "Predict Acetylated Lysine Sites" ;
    schema1:citation "doi:10.1093/nar/gks437" ;
    schema1:description "ASEB is an R package to predict lysine sites that can be acetylated by a specific KAT-family." ;
    schema1:identifier biotools:aseb ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-aseb" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ASEB.html" .

