@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pathrender a schema1:SoftwareApplication ;
    schema1:alternateName "Render molecular pathways" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "build graphs from pathway databases, render them by Rgraphviz." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pathRender_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pathRender/pathRender_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pathRender_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathrender/bioconductor-pathrender_1.78.0_src_all.tar.gz" ;
    schema1:identifier "biotools:pathrender" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-pathrender" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pathRender.html" .

