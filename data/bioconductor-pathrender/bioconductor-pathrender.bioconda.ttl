@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pathrender a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Render molecular pathways" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pathRender_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pathRender/pathRender_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pathRender_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathrender/bioconductor-pathrender_1.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-cmap",
        "bioconductor-graph",
        "bioconductor-rgraphviz",
        "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:pathrender ;
    schema:license "LGPL" ;
    schema:name "bioconductor-pathrender" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pathRender.html" .

