@prefix schema1: <http://schema.org/> .

galaxytool:pacu a schema1:SoftwareApplication ;
    bioschemas:output "bam",
        "html" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:topic_0080,
        edam:topic_3293 ;
    schema1:codeRepository <https://github.com/BioinformaticsPlatformWIV-ISP/PACU> ;
    schema1:dateCreated "2024-08-13" ;
    schema1:description "PACU is a workflow for whole genome sequencing based phylogeny of Illumina and ONT R9/R10 data." ;
    schema1:encodingFormat "bam",
        "html" ;
    schema1:featureList edam:operation_3432 ;
    schema1:identifier biotools:pacu,
        bioconda:pacu_snp ;
    schema1:isPartOf <https://usegalaxy.eu> ;
    schema1:keywords "Phylogenetics",
        "Sequence Analysis" ;
    schema1:name "pacu" ;
    schema1:softwareVersion "0.0.5" ;
