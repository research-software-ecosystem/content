@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sim a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-10-203" ;
    schema:description "Integrated Analysis on two human genomic datasets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SIM_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SIM/SIM_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SIM_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sim/bioconductor-sim_1.80.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-globaltest",
        "bioconductor-quantsmooth",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-quantreg",
        "zlib" ;
    schema:identifier biotools:sim ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-sim" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SIM.html" .

