@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sim a schema1:SoftwareApplication ;
    schema1:alternateName "Integrated Analysis on two human genomic datasets" ;
    schema1:citation "doi:10.1186/1471-2105-10-203" ;
    schema1:description "Finds associations between two human genomic datasets." ;
    schema1:identifier <https://bio.tools/biotools:sim> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-sim" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SIM.html" .

