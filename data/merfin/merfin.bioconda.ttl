@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:merfin a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-022-01445-y",
        "doi:10.1101/2022.12.01.518724" ;
    schema:description "Improved variant filtering and polishing via k-mer validation." ;
    schema:hasPart "bzip2",
        "gzip",
        "libgomp",
        "llvm-openmp",
        "pigz",
        "xz" ;
    schema:identifier biotools:merfin ;
    schema:license "Apache-2.0" ;
    schema:name "merfin" ;
    schema:softwareHelp "https://github.com/arangrhie/merfin/blob/v1.1/README.md" ;
    schema:softwareVersion "1.1" ;
    schema:url "https://github.com/arangrhie/merfin" .

