@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:nonpareil a schema1:SoftwareApplication ;
    bioschemas:output "json",
        "tabular",
        "txt" ;
    schema1:codeRepository "http://nonpareil.readthedocs.io" ;
    schema1:dateCreated "2017-11-03" ;
    schema1:description "Estimate average coverage in metagenomic datasets" ;
    schema1:encodingFormat "json",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_0004 ;
    schema1:identifier biotools:nonpareil,
        bioconda:nonpareil ;
    schema1:keywords "Metagenomics" ;
    schema1:name "nonpareil" ;
    schema1:softwareVersion "3.5.5" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/nonpareil" .

