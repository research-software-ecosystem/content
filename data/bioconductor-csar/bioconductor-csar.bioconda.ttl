@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-csar a schema1:SoftwareApplication ;
    schema1:description "Statistical tools for the analysis of ChIP-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CSAR_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CSAR/CSAR_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CSAR_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-csar/bioconductor-csar_1.62.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:csar ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-csar" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CSAR.html" .

