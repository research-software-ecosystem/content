@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mlinterfaces a schema1:SoftwareApplication ;
    schema1:alternateName "Uniform interfaces to R machine learning procedures for data in Bioconductor containers" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides uniform interfaces to machine learning code for data in R and Bioconductor containers." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MLInterfaces_1.90.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MLInterfaces/MLInterfaces_1.90.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MLInterfaces_1.90.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mlinterfaces/bioconductor-mlinterfaces_1.90.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mlinterfaces" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-mlinterfaces" ;
    schema1:softwareVersion "1.90.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MLInterfaces.html" .

