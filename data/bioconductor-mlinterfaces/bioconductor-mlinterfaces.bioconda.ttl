@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mlinterfaces a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Uniform interfaces to R machine learning procedures for data in Bioconductor containers" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MLInterfaces_1.90.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MLInterfaces/MLInterfaces_1.90.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MLInterfaces_1.90.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mlinterfaces/bioconductor-mlinterfaces_1.90.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genefilter",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-fpc",
        "r-gbm",
        "r-gdata",
        "r-ggvis",
        "r-hwriter",
        "r-magrittr",
        "r-mass",
        "r-mlbench",
        "r-pls",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rpart",
        "r-sfsmisc",
        "r-shiny",
        "r-threejs",
        "zlib" ;
    schema:identifier biotools:mlinterfaces ;
    schema:license "LGPL" ;
    schema:name "bioconductor-mlinterfaces" ;
    schema:softwareVersion "1.90.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MLInterfaces.html" .

