@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowclean a schema1:SoftwareApplication ;
    schema1:alternateName "flowClean" ;
    schema1:description "A quality control tool for flow cytometry data based on compositional data analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/flowClean_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowClean/flowClean_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowClean_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowclean/bioconductor-flowclean_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:flowclean" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-flowclean" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowClean.html" .

