@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowclean a schema:SoftwareApplication ;
    schema:description "flowClean" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowClean_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowClean/flowClean_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowClean_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowclean/bioconductor-flowclean_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-flowcore",
        "r-base",
        "r-bit",
        "r-changepoint",
        "r-sfsmisc" ;
    schema:identifier biotools:flowclean ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-flowclean" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowClean.html" .

