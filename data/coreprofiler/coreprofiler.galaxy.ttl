@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:coreprofiler a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "json",
        "tabular",
        "tsv" ;
    schema1:applicationSubCategory edam:topic_0091,
        edam:topic_3293,
        edam:topic_3301 ;
    schema1:codeRepository <https://gitlab.com/ifb-elixirfr/abromics/coreprofiler> ;
    schema1:dateCreated "2025-07-22" ;
    schema1:description "CoreProfiler, a tool for cgMLST allele calling from bacterial genome assemblies" ;
    schema1:encodingFormat "fasta",
        "json",
        "tabular",
        "tsv" ;
    schema1:featureList edam:operation_3840 ;
    schema1:identifier biotools:coreprofiler,
        bioconda:coreprofiler ;
    schema1:isPartOf <https://galaxy.pasteur.fr>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.org>,
        <https://workflowhub.eu/workflows/2055?version=3> ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "coreprofiler" ;
    schema1:softwareVersion "2.0.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/coreprofiler> .

