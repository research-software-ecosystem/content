@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-vanillaice a schema:SoftwareApplication ;
    schema:description "A Hidden Markov Model for high throughput genotyping arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/VanillaICE_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/VanillaICE/VanillaICE_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/VanillaICE_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-vanillaice/bioconductor-vanillaice_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-bsgenome.hsapiens.ucsc.hg18",
        "bioconductor-crlmm",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-oligoclasses",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-foreach",
        "r-lattice",
        "r-matrixstats",
        "zlib" ;
    schema:identifier biotools:vanillaice ;
    schema:license "LGPL-2" ;
    schema:name "bioconductor-vanillaice" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/VanillaICE.html" .

