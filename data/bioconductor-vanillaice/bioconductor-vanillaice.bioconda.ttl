@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-vanillaice a schema1:SoftwareApplication ;
    schema1:alternateName "A Hidden Markov Model for high throughput genotyping arrays" ;
    schema1:description "Hidden Markov Models for characterizing chromosomal alteration in high throughput SNP arrays." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/VanillaICE_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/VanillaICE/VanillaICE_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/VanillaICE_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-vanillaice/bioconductor-vanillaice_1.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:vanillaice" ;
    schema1:license "LGPL-2" ;
    schema1:name "bioconductor-vanillaice" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/VanillaICE.html" .

