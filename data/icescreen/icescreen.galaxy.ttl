        edam:topic_0602,
        edam:topic_0622,
        edam:topic_0798,
        edam:topic_3175 ;
    schema1:codeRepository <https://forgemia.inra.fr/ices_imes_analysis/icescreen> ;
    schema1:dateCreated "2022-01-04" ;
    schema1:description "identification of ICEs and IMEs in Bacillota genomes." ;
    schema1:encodingFormat "embl.gz",
        "genbank.gz",
        "gff3.gz",
        "gz",
        "tabular",
        "tar.gz",
        "txt" ;
    schema1:featureList edam:operation_2421,
        edam:operation_3092,
        edam:topic_3074 ;
    schema1:identifier biotools:icescreen,
        bioconda:icescreen ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.org> ;
    schema1:keywords "Genome annotation" ;
