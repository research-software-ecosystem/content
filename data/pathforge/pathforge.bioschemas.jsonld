      "sc:citation": {
        "@id": "https://doi.org/10.48550/arXiv.2512.17517"
      },
      "sc:description": "PathForge is a modular benchmarking framework for multiple instance learning in computational pathology. It supports whole slide image feature extraction, HDF5 artifact generation, tile overviews, benchmarking, pipeline optimization, classification, regression, survival and retrieval tasks, and support for model inference and visualization.",
