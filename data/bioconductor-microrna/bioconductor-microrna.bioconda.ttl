@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-microrna a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Data and functions for dealing with microRNAs" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/microRNA_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/microRNA/microRNA_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/microRNA_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-microrna/bioconductor-microrna_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:microrna ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-microrna" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/microRNA.html" .

