@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-microrna a schema1:SoftwareApplication ;
    schema1:alternateName "Data and functions for dealing with microRNAs" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Different data resources for microRNAs and some functions for manipulating them." ;
    schema1:identifier biotools:microrna ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-microrna" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/microRNA.html" .

