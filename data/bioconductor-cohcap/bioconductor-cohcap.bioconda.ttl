@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cohcap a schema:SoftwareApplication ;
    schema:description "CpG Island Analysis Pipeline for Illumina Methylation Array and Targeted BS-Seq Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/COHCAP_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/COHCAP/COHCAP_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/COHCAP_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cohcap/bioconductor-cohcap_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-cohcapanno",
        "libblas",
        "liblapack",
        "perl",
        "r-base",
        "r-bh",
        "r-gplots",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-writexls" ;
    schema:identifier biotools:cohcap ;
    schema:license "GPL-3.0-only" ;
    schema:name "bioconductor-cohcap" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/COHCAP.html" .

