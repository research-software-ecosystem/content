@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sonicparanoid a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bty631",
        "doi:10.1101/2023.05.14.540736" ;
    schema:description "SonicParanoid: fast, accurate, and comprehensive orthology inference with machine learning and language models" ;
    schema:downloadUrl "https://pypi.org/packages/source/s/sonicparanoid/sonicparanoid-2.0.9.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "python",
        "python-build" ;
    schema:identifier biotools:SonicParanoid ;
    schema:license "GPL-3.0-only" ;
    schema:name "sonicparanoid" ;
    schema:softwareHelp "https://gitlab.com/salvo981/sonicparanoid2/-/wikis/home" ;
    schema:softwareVersion "2.0.9" ;
    schema:url "https://gitlab.com/salvo981/sonicparanoid2" .

