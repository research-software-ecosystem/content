@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:htslib a schema1:SoftwareApplication ;
    schema1:alternateName "C library for high-throughput sequencing data formats." ;
    schema1:description "C library for high-throughput sequencing data formats." ;
    schema1:identifier <https://bio.tools/biotools:HTSlib> ;
    schema1:license "MIT" ;
    schema1:name "htslib" ;
    schema1:softwareVersion "1.24" ;
    schema1:url "https://github.com/samtools/htslib" .

