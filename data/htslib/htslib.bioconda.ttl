@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:htslib a schema:SoftwareApplication ;
    schema:description "C library for high-throughput sequencing data formats." ;
    schema:downloadUrl "https://github.com/samtools/htslib/releases/download/1.23.1/htslib-1.23.1.tar.bz2" ;
    schema:hasPart "bzip2",
        "libcurl",
        "libdeflate",
        "openssl",
        "xz",
        "zlib" ;
    schema:identifier biotools:HTSlib ;
    schema:license "MIT" ;
    schema:name "htslib" ;
    schema:softwareHelp "http://www.htslib.org/" ;
    schema:softwareVersion "1.23.1" ;
    schema:url "https://github.com/samtools/htslib" .

