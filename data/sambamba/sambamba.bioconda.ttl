@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sambamba a schema:SoftwareApplication ;
    schema:author "mjsteinbaugh" ;
    schema:citation "doi:10.1093/bioinformatics/btv098" ;
    schema:description "Tools for working with SAM/BAM data." ;
    schema:downloadUrl "https://github.com/biod/sambamba/archive/refs/tags/v1.0.1.tar.gz" ;
    schema:hasPart "bzip2",
        "ldc",
        "lz4-c",
        "wget",
        "xz",
        "zlib" ;
    schema:identifier biotools:sambamba ;
    schema:license "GPL-2.0-only" ;
    schema:maintainer "mjsteinbaugh" ;
    schema:name "sambamba" ;
    schema:softwareHelp "https://lomereiter.github.io/sambamba/docs/sambamba-view.html" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "https://github.com/biod/sambamba" .

