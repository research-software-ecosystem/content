@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:orthodb a schema1:SoftwareApplication ;
    schema1:alternateName "Interface to OrthoDB REST API." ;
    schema1:citation "doi:10.1093/nar/gkac996" ;
    schema1:description "Python interface to OrthoDB REST API with some additional functionality." ;
    schema1:identifier biotools:orthodb,
        "PMID:36350662" ;
    schema1:license "GPL3" ;
    schema1:maintainer "ftegenfe" ;
    schema1:name "orthodb" ;
    schema1:softwareVersion "0.9.1" ;
    schema1:url "https://www.ezlab.org/orthodb_v12_userguide.html" .

