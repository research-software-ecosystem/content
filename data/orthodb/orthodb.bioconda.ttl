@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:orthodb a schema:SoftwareApplication ;
    schema:author "ftegenfe" ;
    schema:citation "doi:10.1093/nar/gkac996" ;
    schema:description "Interface to OrthoDB REST API." ;
    schema:downloadUrl "https://gitlab.com/ezlab/orthodb_py/-/archive/0.9.1/orthodb_py-0.9.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:orthodb ;
    schema:license "GPL3" ;
    schema:maintainer "ftegenfe" ;
    schema:name "orthodb" ;
    schema:softwareHelp "https://www.ezlab.org/orthodb_v12_userguide.html#api" ;
    schema:softwareVersion "0.9.1" ;
    schema:url "https://www.ezlab.org/orthodb_v12_userguide.html" .

