@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biobase a schema:SoftwareApplication ;
    schema:description "Biobase: Base functions for Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Biobase_2.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Biobase/Biobase_2.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Biobase_2.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biobase/bioconductor-biobase_2.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:biobase ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-biobase" ;
    schema:softwareVersion "2.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Biobase.html" .

