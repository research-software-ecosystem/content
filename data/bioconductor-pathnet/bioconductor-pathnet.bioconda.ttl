@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pathnet a schema1:SoftwareApplication ;
    schema1:alternateName "An R package for pathway analysis using topological information" ;
    schema1:description "PathNet uses topological information present in pathways and differential expression levels of genes (obtained from microarray experiment) to identify pathways that are 1) significantly enriched and 2) associated with each other in the context of differential expression. The algorithm is described in: PathNet: A tool for pathway analysis using topological information. Dutta B, Wallqvist A, and Reifman J. Source Code for Biology and Medicine 2012 Sep 24;7(1):10." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PathNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PathNet/PathNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PathNet_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathnet/bioconductor-pathnet_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:pathnet" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-pathnet" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PathNet.html" .

