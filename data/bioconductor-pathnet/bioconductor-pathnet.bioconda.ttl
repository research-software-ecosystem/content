@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pathnet a schema:SoftwareApplication ;
    schema:description "An R package for pathway analysis using topological information" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PathNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PathNet/PathNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PathNet_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathnet/bioconductor-pathnet_1.50.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:pathnet ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-pathnet" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PathNet.html" .

