@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ldhelmet a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pgen.1003090" ;
    schema:description "Software program for statistical inference of fine-scale crossover recombination rates from population genetic data." ;
    schema:downloadUrl "https://downloads.sourceforge.net/project/ldhelmet/LDhelmet_v1.10.tgz" ;
    schema:hasPart "boost-cpp",
        "gsl",
        "libcblas" ;
    schema:identifier biotools:LDhelmet ;
    schema:license "GPL3" ;
    schema:name "ldhelmet" ;
    schema:softwareVersion "1.1" ;
    schema:url "http://sourceforge.net/projects/ldhelmet/" .

