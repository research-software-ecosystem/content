  "@id": "https://bio.tools/agingresearch.news",
  "@type": "sc:SoftwareApplication",
  "biotools:primaryContact": "Boris Djordjevic",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:additionalType": [
    "Web API",
    "Web application"
  ],
  "sc:description": "AgingResearch.News is a web application for finding and following research on aging and age-related disease. It connects biomedical papers with evidence summaries, clinical trials, research grants and related topics. Readers can search the public site, use topic RSS feeds, or connect an AI assistant through its MCP API. Paper summaries are generated and checked by AI, with links to the underlying research and its limitations. Public reading is free; personalised features and higher API allowances require an account or paid plan.",
  "sc:isAccessibleForFree": true,
  "sc:license": "Proprietary",
  "sc:name": "AgingResearch.News",
