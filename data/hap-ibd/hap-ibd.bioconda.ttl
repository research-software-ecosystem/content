@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hap-ibd a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ajhg.2020.02.010" ;
    schema:description "Hap-ibd Detects identity-by-descent (IBD) segments and homozygosity-by-descent (HBD) segments in phased genotype data." ;
    schema:downloadUrl "https://faculty.washington.edu/browning/hap-ibd.jar" ;
    schema:identifier biotools:hap-ibd ;
    schema:license "Apache-2.0" ;
    schema:name "hap-ibd" ;
    schema:softwareHelp "https://github.com/browning-lab/hap-ibd/blob/master/README.md" ;
    schema:softwareVersion "1.0.rev20May22.818" ;
    schema:url "https://github.com/browning-lab/hap-ibd" .

