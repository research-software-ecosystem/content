  "@graph": [
    {
      "@id": "https://bio.tools/firender",
      "@type": "sc:SoftwareApplication",
      "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
      "sc:additionalType": "Desktop application",
      "sc:applicationSubCategory": [
        {
          "@id": "edam:topic_3383"
        },
        {
          "@id": "edam:topic_3382"
        }
      ],
      "sc:author": {
        "@id": "https://orcid.org/0000-0001-9675-8681"
      },
      "sc:description": "Desktop application for viewing, analysing and presenting 3D and 4D microscopy and tomography volumes, such as confocal, light-sheet, two-photon, volume EM and micro-CT data. It opens common microscope formats directly and renders on the GPU or CPU (maximum intensity projection, opacity blending, shaded and shadowed volume rendering, iso-surfaces, clipping planes, linked slice views). Analysis tools include 3D segmentation and object counting (watershed and deep-learning nuclei segmentation for 3D stacks and 2D images), spot detection, filament tracing, colocalisation, tracking, deconvolution, 3D filters and measurements with CSV/Excel export. A free edition covers viewing, rendering and measurement; analysis and export need a paid licence.",
      "sc:featureList": [
        {
          "@id": "edam:operation_3443"
        },
        {
          "@id": "edam:operation_0337"
        }
      ],
      "sc:isAccessibleForFree": true,
      "sc:license": "Proprietary",
      "sc:name": "FiRender",
      "sc:operatingSystem": [
        "Mac",
        "Windows"
      ],
      "sc:provider": "Maddisys Limited",
