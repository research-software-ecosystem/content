@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:seqkit a schema1:SoftwareApplication ;
    schema1:alternateName "A cross-platform and ultrafast toolkit for FASTA/Q file manipulation." ;
    schema1:citation "doi:10.1371/journal.pone.0163962" ;
    schema1:description "A cross-platform and ultrafast toolkit for FASTA/Q file manipulation." ;
    schema1:identifier biotools:seqkit,
        "usegalaxy-eu:seqkit_fx2tab",
        "usegalaxy-eu:seqkit_head",
        "usegalaxy-eu:seqkit_locate",
        "usegalaxy-eu:seqkit_sort",
        "usegalaxy-eu:seqkit_stats",
        "usegalaxy-eu:seqkit_translate" ;
    schema1:license "MIT" ;
    schema1:name "seqkit" ;
    schema1:softwareVersion "2.13.0" ;
    schema1:url "https://github.com/shenwei356/seqkit" .

