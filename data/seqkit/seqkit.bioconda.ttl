@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:seqkit a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0163962" ;
    schema:description "A cross-platform and ultrafast toolkit for FASTA/Q file manipulation." ;
    schema:downloadUrl "https://github.com/shenwei356/seqkit/archive/refs/tags/v2.13.0.tar.gz" ;
    schema:identifier biotools:seqkit ;
    schema:license "MIT" ;
    schema:name "seqkit" ;
    schema:softwareHelp "https://bioinf.shenwei.me/seqkit" ;
    schema:softwareVersion "2.13.0" ;
    schema:url "https://github.com/shenwei356/seqkit" .

