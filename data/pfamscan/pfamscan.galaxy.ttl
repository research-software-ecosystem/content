@prefix schema1: <http://schema.org/> .

galaxytool:pfamscan a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:topic_0080 ;
    schema1:codeRepository "http://ftp.ebi.ac.uk/pub/databases/Pfam/Tools/" ;
    schema1:dateCreated "2023-02-02" ;
    schema1:description "Search a FASTA sequence against a library of Pfam HMM." ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_2479,
        edam:topic_0639 ;
    schema1:identifier biotools:pfamscan,
        bioconda:pfam_scan ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=11eba1b28ec87963>,
        <https://usegalaxy.eu/published/workflow?id=1f9a9a7998ef5ab3>,
        <https://usegalaxy.eu/published/workflow?id=47a0407867a90f95>,
        <https://usegalaxy.eu/published/workflow?id=87231a6a7938cb95>,
        <https://usegalaxy.eu/published/workflow?id=9b025479fade745d>,
        <https://usegalaxy.eu/published/workflow?id=b7a3cbcd32734e8b>,
        <https://usegalaxy.org.au>,
