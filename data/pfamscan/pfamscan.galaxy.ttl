        <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1688?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "pfamscan" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/bgruening/galaxytools/tree/master/tools/pfamscan" .

