@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rvtests a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw079" ;
    schema:description "Rare variant test software for next generation sequencing data" ;
    schema:downloadUrl "https://github.com/zhanxw/rvtests/archive/v2.1.0.tar.gz" ;
    schema:hasPart "clangdev",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:rvtests ;
    schema:license "GPL" ;
    schema:name "rvtests" ;
    schema:softwareVersion "2.1.0" ;
    schema:url "https://github.com/zhanxw/rvtests" .

