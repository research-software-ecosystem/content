@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-weaver a schema1:SoftwareApplication ;
    schema1:alternateName "Tools and extensions for processing Sweave documents" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides enhancements on the Sweave() function in the base package.  In particular a facility for caching code chunk results is included." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/weaver_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/weaver/weaver_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/weaver_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-weaver/bioconductor-weaver_1.76.0_src_all.tar.gz" ;
    schema1:identifier "biotools:weaver" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-weaver" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/weaver.html" .

