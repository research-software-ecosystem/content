@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-weaver a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Tools and extensions for processing Sweave documents" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/weaver_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/weaver/weaver_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/weaver_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-weaver/bioconductor-weaver_1.76.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-codetools",
        "r-digest" ;
    schema:identifier biotools:weaver ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-weaver" ;
    schema:softwareVersion "1.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/weaver.html" .

