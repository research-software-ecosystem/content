@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rhdf5 a schema:SoftwareApplication ;
    schema:description "R Interface to HDF5" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rhdf5_2.54.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rhdf5/rhdf5_2.54.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rhdf5_2.54.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rhdf5/bioconductor-rhdf5_2.54.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rhdf5filters",
        "bioconductor-rhdf5lib",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:rhdf5 ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-rhdf5" ;
    schema:softwareVersion "2.54.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rhdf5.html" .

