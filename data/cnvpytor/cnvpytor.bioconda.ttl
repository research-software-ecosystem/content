@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cnvpytor a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/gigascience/giab074" ;
    schema:description "Python extension of CNVnator." ;
    schema:downloadUrl "https://pypi.io/packages/source/c/cnvpytor/CNVpytor-1.3.2.tar.gz" ;
    schema:hasPart "chardet",
        "gnureadline",
        "h5py",
        "matplotlib-base",
        "numpy",
        "pathlib",
        "pip",
        "pysam",
        "python",
        "requests",
        "scipy",
        "setuptools",
        "xlsxwriter" ;
    schema:identifier biotools:cnvpytor ;
    schema:license "MIT" ;
    schema:name "cnvpytor" ;
    schema:softwareHelp "https://abyzovlab.github.io/CNVpytor" ;
    schema:softwareVersion "1.3.2" ;
    schema:url "https://github.com/abyzovlab/CNVpytor" .

