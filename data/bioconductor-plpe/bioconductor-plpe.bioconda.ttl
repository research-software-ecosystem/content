@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-plpe a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Local Pooled Error Test for Differential Expression with Paired High-throughput Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PLPE_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PLPE/PLPE_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PLPE_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-plpe/bioconductor-plpe_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-lpe",
        "r-base",
        "r-mass" ;
    schema:identifier biotools:plpe ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-plpe" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PLPE.html" .

