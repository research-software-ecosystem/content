@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-plpe a schema1:SoftwareApplication ;
    schema1:alternateName "Local Pooled Error Test for Differential Expression with Paired High-throughput Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package performs tests for paired high-throughput data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PLPE_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PLPE/PLPE_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PLPE_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-plpe/bioconductor-plpe_1.70.0_src_all.tar.gz" ;
    schema1:identifier "biotools:plpe" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-plpe" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PLPE.html" .

