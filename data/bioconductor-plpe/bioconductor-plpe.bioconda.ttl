@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-plpe a schema1:SoftwareApplication ;
    schema1:alternateName "Local Pooled Error Test for Differential Expression with Paired High-throughput Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package performs tests for paired high-throughput data." ;
    schema1:identifier <https://bio.tools/biotools:plpe> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-plpe" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PLPE.html" .

