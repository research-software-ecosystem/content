@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyfaidx a schema:SoftwareApplication ;
    schema:citation "doi:10.7287/peerj.preprints.970v1" ;
    schema:description "pyfaidx: efficient pythonic random access to fasta subsequences" ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/19/af/da148aaa8e75c9890a41dbe5516f8006def2b74831e66acf79f81bb7bb5b/pyfaidx-0.9.0.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools-scm" ;
    schema:identifier biotools:pyfaidx ;
    schema:license "BSD" ;
    schema:name "pyfaidx" ;
    schema:softwareHelp "https://pypi.org/project/pyfaidx" ;
    schema:softwareVersion "0.9.0.4" ;
    schema:url "https://github.com/mdshw5/pyfaidx" .

