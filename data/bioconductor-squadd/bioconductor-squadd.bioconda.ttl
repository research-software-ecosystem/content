@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-squadd a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Add-on of the SQUAD Software" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SQUADD_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/SQUADD/SQUADD_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/SQUADD_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-squadd/bioconductor-squadd_1.52.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:squadd ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-squadd" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/SQUADD.html" .

