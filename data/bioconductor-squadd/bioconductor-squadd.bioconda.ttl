@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-squadd a schema1:SoftwareApplication ;
    schema1:alternateName "Add-on of the SQUAD Software" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package SQUADD is a SQUAD add-on. It permits to generate SQUAD simulation matrix, prediction Heat-Map and Correlation Circle from PCA analysis." ;
    schema1:identifier <https://bio.tools/biotools:squadd> ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-squadd" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/SQUADD.html" .

