@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rhtslib a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "HTSlib high-throughput sequencing library as an R package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Rhtslib_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rhtslib/Rhtslib_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rhtslib_3.6.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rhtslib/bioconductor-rhtslib_3.6.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:rhtslib ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-rhtslib" ;
    schema:softwareVersion "3.6.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Rhtslib.html" .

