@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gcrisprtools a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Suite of Functions for Pooled Crispr Screen QC and Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/gCrisprTools_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/gCrisprTools/gCrisprTools_2.16.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/gCrisprTools_2.16.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gcrisprtools/bioconductor-gcrisprtools_2.16.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-complexheatmap",
        "bioconductor-limma",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-ggplot2",
        "r-rmarkdown",
        "r-robustrankaggreg" ;
    schema:identifier biotools:gcrisprtools ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gcrisprtools" ;
    schema:softwareVersion "2.16.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/gCrisprTools.html" .

