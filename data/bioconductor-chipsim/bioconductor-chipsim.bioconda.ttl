@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chipsim a schema1:SoftwareApplication ;
    schema1:alternateName "Simulation of ChIP-seq experiments" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A general framework for the simulation of ChIP-seq data. Although currently focused on nucleosome positioning the package is designed to support different types of experiments." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ChIPsim_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPsim/ChIPsim_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPsim_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipsim/bioconductor-chipsim_1.64.0_src_all.tar.gz" ;
    schema1:identifier "biotools:chipsim" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-chipsim" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPsim.html" .

