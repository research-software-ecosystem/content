@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:coverm a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btaf147" ;
    schema:description "CoverM aims to be a configurable, easy to use and fast DNA read coverage and relative abundance calculator focused on metagenomics applications." ;
    schema:downloadUrl "https://github.com/wwood/coverm/archive/v0.7.0.tar.gz" ;
    schema:hasPart "gsl",
        "openblas",
        "zlib" ;
    schema:identifier biotools:coverm ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "coverm" ;
    schema:softwareHelp "https://github.com/wwood/CoverM/blob/v0.7.0/README.md" ;
    schema:softwareVersion "0.7.0" ;
    schema:url "https://github.com/wwood/CoverM" .

