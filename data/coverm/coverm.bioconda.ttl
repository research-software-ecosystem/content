@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:coverm a schema1:SoftwareApplication ;
    schema1:alternateName "CoverM aims to be a configurable, easy to use and fast DNA read coverage and relative abundance calculator focused on metagenomics applications." ;
    schema1:citation "doi:10.1093/bioinformatics/btaf147" ;
    schema1:description "CoverM aims to be a configurable, easy to use and fast DNA read coverage and relative abundance calculator focused on metagenomics application." ;
    schema1:downloadUrl "https://github.com/wwood/coverm/archive/v0.7.0.tar.gz" ;
    schema1:identifier "biotools:coverm",
        "usegalaxy-eu:coverm_contig",
        "usegalaxy-eu:coverm_genome" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "coverm" ;
    schema1:softwareVersion "0.7.0" ;
    schema1:url "https://github.com/wwood/CoverM" .

