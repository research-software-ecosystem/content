@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kmer-jellyfish a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr011" ;
    schema:description "Jellyfish is a tool for fast, memory-efficient counting of k-mers in DNA. A k-mer is a substring of length k, and counting the occurrences of all such substrings is a central step in many analyses of DNA sequence." ;
    schema:downloadUrl "https://github.com/gmarcais/Jellyfish/releases/download/v2.3.1/jellyfish-2.3.1.tar.gz" ;
    schema:hasPart "perl",
        "pip",
        "python" ;
    schema:identifier biotools:jellyfish ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "kmer-jellyfish" ;
    schema:softwareHelp "https://genome.umd.edu/docs/JellyfishUserGuide.pdf" ;
    schema:softwareVersion "2.3.1" ;
    schema:url "https://genome.umd.edu/jellyfish.html" .

