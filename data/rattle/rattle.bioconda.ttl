@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rattle a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-022-02715-w" ;
    schema:description "Reference-free reconstruction and quantification of transcriptomes from long-read sequencing." ;
    schema:downloadUrl "https://github.com/comprna/RATTLE/releases/download/v1.0/RATTLE-1.0.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:rattle ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "rattle" ;
    schema:softwareHelp "https://github.com/comprna/RATTLE/blob/v1.0/README.md" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://github.com/comprna/RATTLE" .

