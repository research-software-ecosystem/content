@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ffpe a schema1:SoftwareApplication ;
    schema1:alternateName "Quality assessment and control for FFPE microarray expression data" ;
    schema1:description "Identify low-quality data using metrics developed for expression data derived from Formalin-Fixed, Paraffin-Embedded (FFPE) data.  Also a function for making Concordance at the Top plots (CAT-plots)." ;
    schema1:identifier biotools:ffpe ;
    schema1:license "GPL (>2)" ;
    schema1:name "bioconductor-ffpe" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ffpe.html" .

