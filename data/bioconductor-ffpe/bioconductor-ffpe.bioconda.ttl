@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ffpe a schema:SoftwareApplication ;
    schema:description "Quality assessment and control for FFPE microarray expression data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ffpe_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ffpe/ffpe_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ffpe_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ffpe/bioconductor-ffpe_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-lumi",
        "bioconductor-methylumi",
        "r-base",
        "r-sfsmisc",
        "r-ttr" ;
    schema:identifier biotools:ffpe ;
    schema:license "GPL (>2)" ;
    schema:name "bioconductor-ffpe" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ffpe.html" .

