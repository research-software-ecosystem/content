@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ffpe a schema1:SoftwareApplication ;
    schema1:description "Quality assessment and control for FFPE microarray expression data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ffpe_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ffpe/ffpe_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ffpe_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ffpe/bioconductor-ffpe_1.54.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-lumi",
        "bioconductor-methylumi",
        "r-base",
        "r-sfsmisc",
        "r-ttr" ;
    schema1:identifier biotools:ffpe ;
    schema1:license "GPL (>2)" ;
    schema1:name "bioconductor-ffpe" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ffpe.html" .

