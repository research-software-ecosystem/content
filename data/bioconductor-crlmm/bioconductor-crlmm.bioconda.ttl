@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-crlmm a schema:SoftwareApplication ;
    schema:description "Genotype Calling (CRLMM) and Copy Number Analysis tool for Affymetrix SNP 5.0 and 6.0 and Illumina arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/crlmm_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/crlmm/crlmm_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/crlmm_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-crlmm/bioconductor-crlmm_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-illuminaio",
        "bioconductor-limma",
        "bioconductor-oligoclasses",
        "bioconductor-preprocesscore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-beanplot",
        "r-ellipse",
        "r-ff",
        "r-foreach",
        "r-lattice",
        "r-matrixstats",
        "r-mvtnorm",
        "r-rcppeigen",
        "r-vgam",
        "zlib" ;
    schema:identifier biotools:crlmm ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-crlmm" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/crlmm.html" .

