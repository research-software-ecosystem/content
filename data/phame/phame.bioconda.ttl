@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phame a schema:SoftwareApplication ;
    schema:description "A tool to derive SNP matrices and phylogenetic tree from raw reads, contigs, and full genomes." ;
    schema:downloadUrl "https://github.com/mshakya/phame/archive/1.0.3.tar.gz" ;
    schema:hasPart "make",
        "perl",
        "zlib" ;
    schema:identifier biotools:phame ;
    schema:license "GPLV2" ;
    schema:name "phame" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/LANL-Bioinformatics/PhaME" .

