@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-edger a schema1:SoftwareApplication ;
    schema1:description "Empirical Analysis of Digital Gene Expression Data in R" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/edgeR_4.8.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/edgeR/edgeR_4.8.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/edgeR_4.8.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-edger/bioconductor-edger_4.8.2_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-locfit",
        "zlib" ;
    schema1:identifier biotools:edger ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-edger" ;
    schema1:softwareVersion "4.8.2" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/edgeR.html" .

