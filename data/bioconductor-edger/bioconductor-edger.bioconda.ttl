@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-edger a schema:SoftwareApplication ;
    schema:description "Empirical Analysis of Digital Gene Expression Data in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/edgeR_4.8.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/edgeR/edgeR_4.8.2.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/edgeR_4.8.2.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-edger/bioconductor-edger_4.8.2_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-locfit",
        "zlib" ;
    schema:identifier biotools:edger ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-edger" ;
    schema:softwareVersion "4.8.2" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/edgeR.html" .

