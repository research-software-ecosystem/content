@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:msalign2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/s00216-009-3166-1" ;
    schema:description "Aligns 2 CE-MS or LC-MS datasets using accurate mass information." ;
    schema:downloadUrl "http://www.ms-utils.org/msalign2/msalign2.zip" ;
    schema:hasPart "libgd",
        "zlib" ;
    schema:identifier biotools:msalign2 ;
    schema:license "GPL3" ;
    schema:name "msalign2" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://www.ms-utils.org/msalign2/index.html" .

