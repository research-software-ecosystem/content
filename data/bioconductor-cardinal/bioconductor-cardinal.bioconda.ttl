@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cardinal a schema1:SoftwareApplication ;
    schema1:alternateName "A mass spectrometry imaging toolbox for statistical analysis" ;
    schema1:description "Implements statistical & computational tools for analyzing mass spectrometry imaging datasets, including methods for efficient pre-processing, spatial segmentation, and classification." ;
    schema1:identifier <https://bio.tools/biotools:cardinal>,
        "usegalaxy-eu:cardinal_segmentations" ;
    schema1:license "Artistic-2.0 | file LICENSE" ;
    schema1:name "bioconductor-cardinal" ;
    schema1:softwareVersion "3.12.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Cardinal.html" .

