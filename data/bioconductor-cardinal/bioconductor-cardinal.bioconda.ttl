@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cardinal a schema:SoftwareApplication ;
    schema:description "A mass spectrometry imaging toolbox for statistical analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Cardinal_3.12.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Cardinal/Cardinal_3.12.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Cardinal_3.12.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cardinal/bioconductor-cardinal_3.12.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-cardinalio",
        "bioconductor-ebimage",
        "bioconductor-matter",
        "bioconductor-protgenerics",
        "bioconductor-s4vectors",
        "r-base",
        "r-irlba",
        "r-matrix",
        "r-nlme" ;
    schema:identifier biotools:cardinal ;
    schema:license "Artistic-2.0 | file LICENSE" ;
    schema:name "bioconductor-cardinal" ;
    schema:softwareVersion "3.12.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Cardinal.html" .

