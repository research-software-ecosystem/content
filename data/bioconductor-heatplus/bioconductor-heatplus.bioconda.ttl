@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-heatplus a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Heatmaps with row and/or column covariates and colored clusters" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Heatplus_3.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Heatplus/Heatplus_3.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Heatplus_3.18.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-heatplus/bioconductor-heatplus_3.18.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:heatplus ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-heatplus" ;
    schema:softwareVersion "3.18.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Heatplus.html" .

