@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-heatplus a schema1:SoftwareApplication ;
    schema1:alternateName "Heatmaps with row and/or column covariates and colored clusters" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Display a rectangular heatmap (intensity plot) of a data matrix. By default, both samples (columns) and features (row) of the matrix are sorted according to a hierarchical clustering, and the corresponding dendrogram is plotted. Optionally, panels with additional information about samples and features can be added to the plot." ;
    schema1:identifier biotools:heatplus ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-heatplus" ;
    schema1:softwareVersion "3.18.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Heatplus.html" .

