@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-otubase a schema1:SoftwareApplication ;
    schema1:alternateName "Provides structure and functions for the analysis of OTU data" ;
    schema1:citation "doi:10.1093/bioinformatics/btr196" ;
    schema1:description "Provides a platform for Operational Taxonomic Unit based analysis" ;
    schema1:identifier biotools:otubase ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-otubase" ;
    schema1:softwareVersion "1.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/OTUbase.html" .

