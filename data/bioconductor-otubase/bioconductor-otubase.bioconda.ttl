@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-otubase a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr196" ;
    schema:description "Provides structure and functions for the analysis of OTU data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/OTUbase_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OTUbase/OTUbase_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OTUbase_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-otubase/bioconductor-otubase_1.60.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-shortread",
        "r-base",
        "r-vegan" ;
    schema:identifier biotools:otubase ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-otubase" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/OTUbase.html" .

