@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:tidehunter a schema1:SoftwareApplication ;
    schema1:alternateName "TideHunter: efficient and sensitive tandem repeat detection from noisy long reads using seed-and-chain." ;
    schema1:citation "doi:10.1093/bioinformatics/btz376" ;
    schema1:description "TideHunter: efficient and sensitive tandem repeat detection from noisy long reads using seed-and-chain." ;
    schema1:identifier biotools:TideHunter ;
    schema1:license "MIT" ;
    schema1:name "tidehunter" ;
    schema1:softwareVersion "1.5.6" ;
    schema1:url "https://github.com/yangao07/TideHunter" .

