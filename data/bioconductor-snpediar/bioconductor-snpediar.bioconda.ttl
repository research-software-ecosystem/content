@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-snpediar a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-1-4419-9863-7_1039" ;
    schema:description "Query data from SNPedia" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SNPediaR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SNPediaR/SNPediaR_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SNPediaR_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-snpediar/bioconductor-snpediar_1.36.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-jsonlite",
        "r-rcurl" ;
    schema:identifier biotools:snpediar ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-snpediar" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SNPediaR.html" .

