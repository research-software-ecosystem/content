@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:nextdenovo a schema1:SoftwareApplication ;
    schema1:alternateName "String graph-based de novo assembler for long reads (CLR, HiFi and ONT)" ;
    schema1:citation "doi:10.1101/2023.03.09.531669" ;
    schema1:description "String graph-based de novo assembler for long reads (CLR, HiFi and ONT)" ;
    schema1:identifier <https://bio.tools/biotools:nextdenovo>,
        "usegalaxy-eu:nextdenovo" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "nextdenovo" ;
    schema1:softwareVersion "2.5.2" ;
    schema1:url "https://github.com/Nextomics/NextDenovo" .

