@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:nextdenovo a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2023.03.09.531669" ;
    schema:description "String graph-based de novo assembler for long reads (CLR, HiFi and ONT)" ;
    schema:hasPart "bzip2",
        "libcurl",
        "libdeflate",
        "libxcrypt",
        "openssl",
        "python",
        "zlib" ;
    schema:identifier biotools:nextdenovo ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "nextdenovo" ;
    schema:softwareHelp "https://nextdenovo.readthedocs.io/en/latest" ;
    schema:softwareVersion "2.5.2" ;
    schema:url "https://github.com/Nextomics/NextDenovo" .

