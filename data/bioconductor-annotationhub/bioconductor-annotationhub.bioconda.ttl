@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annotationhub a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Client to access AnnotationHub resources" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/AnnotationHub_4.0.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AnnotationHub_4.0.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AnnotationHub/AnnotationHub_4.0.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annotationhub/bioconductor-annotationhub_4.0.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocbaseutils",
        "bioconductor-biocfilecache",
        "bioconductor-biocgenerics",
        "bioconductor-biocversion",
        "bioconductor-s4vectors",
        "r-base",
        "r-biocmanager",
        "r-curl",
        "r-dplyr",
        "r-httr2",
        "r-rappdirs",
        "r-rsqlite",
        "r-yaml" ;
    schema1:identifier biotools:annotationhub ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-annotationhub" ;
    schema1:softwareVersion "4.0.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AnnotationHub.html" .

