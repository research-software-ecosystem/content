@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chopsticks a schema1:SoftwareApplication ;
    schema1:alternateName "The 'snp.matrix' and 'X.snp.matrix' Classes" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Implements classes and methods for large-scale SNP association studies" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/chopsticks_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/chopsticks/chopsticks_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/chopsticks_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chopsticks/bioconductor-chopsticks_1.76.0_src_all.tar.gz" ;
    schema1:identifier "biotools:chopsticks" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-chopsticks" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/chopsticks.html" .

