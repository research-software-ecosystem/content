@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:oases a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bts094" ;
    schema:description "De novo transcriptome assembler for short reads." ;
    schema:hasPart "git-lfs",
        "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:oases ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "oases" ;
    schema:softwareHelp "https://github.com/dzerbino/oases/blob/0.2.09/README.md" ;
    schema:softwareVersion "0.2.09" ;
    schema:url "https://github.com/dzerbino/oases" .

