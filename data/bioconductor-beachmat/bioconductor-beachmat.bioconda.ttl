@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-beachmat a schema1:SoftwareApplication ;
    schema1:description "Compiling Bioconductor to Handle Each Matrix Type" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/beachmat_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/beachmat/beachmat_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/beachmat_2.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-beachmat/bioconductor-beachmat_2.26.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-assorthead",
        "bioconductor-biocgenerics",
        "bioconductor-delayedarray",
        "bioconductor-sparsearray",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:beachmat ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-beachmat" ;
    schema1:softwareVersion "2.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/beachmat.html" .

