@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:snippy a schema:SoftwareApplication ;
    schema:description "Rapid bacterial SNP calling and core genome alignments" ;
    schema:downloadUrl "https://github.com/tseemann/snippy/archive/v4.6.0.tar.gz" ;
    schema:identifier biotools:snippy ;
    schema:license "GPL-2.0" ;
    schema:name "snippy" ;
    schema:softwareVersion "4.6.0" ;
    schema:url "https://github.com/tseemann/snippy" .

