@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:snippy a schema1:SoftwareApplication ;
    schema1:alternateName "Rapid bacterial SNP calling and core genome alignments" ;
    schema1:description "Rapid bacterial SNP calling and core genome alignments" ;
    schema1:identifier biotools:snippy,
        "usegalaxy-eu:snippy" ;
    schema1:license "GPL-2.0" ;
    schema1:name "snippy" ;
    schema1:softwareVersion "4.6.0" ;
    schema1:url "https://github.com/tseemann/snippy" .

