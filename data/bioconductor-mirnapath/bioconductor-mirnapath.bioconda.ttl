@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mirnapath a schema:SoftwareApplication ;
    schema:description "miRNApath: Pathway Enrichment for miRNA Expression Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/miRNApath_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/miRNApath/miRNApath_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/miRNApath_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mirnapath/bioconductor-mirnapath_1.70.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:mirnapath ;
    schema:license "LGPL-2.1" ;
    schema:name "bioconductor-mirnapath" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/miRNApath.html" .

