@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:scepia a schema:SoftwareApplication ;
    schema:author "maarten-vd-sande",
        "rebecza",
        "simonvh" ;
    schema:description "Single Cell Epigenome-based Inference of Activity" ;
    schema:downloadUrl "https://github.com/vanheeringen-lab/scepia/releases/download/0.5.1/scepia-0.5.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:scepia ;
    schema:license "MIT" ;
    schema:maintainer "maarten-vd-sande",
        "rebecza",
        "simonvh" ;
    schema:name "scepia" ;
    schema:softwareVersion "0.5.1" ;
    schema:url "https://github.com/vanheeringen-lab/scepia" .

