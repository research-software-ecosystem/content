@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:cactus a schema1:SoftwareApplication ;
    bioschemas:output "gfa2.gz",
        "h5",
        "maf",
        "tar",
        "vg" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:operation_2403,
        edam:operation_2429,
        edam:topic_0080,
        edam:topic_0084,
        edam:topic_0102,
        edam:topic_0196,
        edam:topic_0622,
        edam:topic_3293 ;
    schema1:codeRepository <https://github.com/ComparativeGenomicsToolkit/cactus> ;
    schema1:dateCreated "2022-01-28" ;
    schema1:description "Cactus is a reference-free whole-genome multiple alignment program" ;
    schema1:encodingFormat "gfa2.gz",
        "h5",
        "maf",
        "tar",
        "vg" ;
    schema1:featureList edam:operation_0492,
        edam:operation_3182 ;
    schema1:identifier biotools:cactus ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "cactus" ;
    schema1:softwareVersion "2.7.1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/cactus> .

