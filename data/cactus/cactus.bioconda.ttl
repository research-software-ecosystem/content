@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:cactus a schema1:SoftwareApplication ;
    schema1:alternateName "Cactus is a reference-free whole-genome multiple alignment program based upon notion of Cactus graphs." ;
    schema1:citation "doi:10.1038/s41586-020-2871-y",
        "doi:10.1089/cmb.2010.0252",
        "doi:10.1101/gr.123356.111" ;
    schema1:description "Cactus is a reference-free whole-genome multiple alignment program based upon notion of Cactus graphs." ;
    schema1:identifier <https://bio.tools/biotools:cactus>,
        "usegalaxy-eu:cactus_cactus",
        "usegalaxy-eu:cactus_export" ;
    schema1:license "MIT" ;
    schema1:name "cactus" ;
    schema1:softwareVersion "3.1.4" ;
    schema1:url "https://github.com/ComparativeGenomicsToolkit/cactus" .

