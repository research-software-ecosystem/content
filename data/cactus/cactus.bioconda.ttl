@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cactus a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41586-020-2871-y",
        "doi:10.1089/cmb.2010.0252",
        "doi:10.1101/gr.123356.111" ;
    schema:description "Cactus is a reference-free whole-genome multiple alignment program based upon notion of Cactus graphs." ;
    schema:downloadUrl "https://github.com/ComparativeGenomicsToolkit/cactus/releases/download/v3.1.4/cactus-v3.1.4.tar.gz" ;
    schema:hasPart "backports.zoneinfo",
        "biopython",
        "bzip2",
        "cigar",
        "decorator",
        "hdf5",
        "jemalloc",
        "libdeflate",
        "libxml2",
        "networkx",
        "pip",
        "pysam",
        "python",
        "toil",
        "zlib" ;
    schema:identifier biotools:cactus ;
    schema:license "MIT" ;
    schema:name "cactus" ;
    schema:softwareHelp "https://github.com/ComparativeGenomicsToolkit/cactus/blob/v3.1.4/README.md" ;
    schema:softwareVersion "3.1.4" ;
    schema:url "https://github.com/ComparativeGenomicsToolkit/cactus" .

