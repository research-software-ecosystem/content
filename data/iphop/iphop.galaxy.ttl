@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:iphop a schema1:SoftwareApplication ;
    bioschemas:output "csv" ;
    schema1:codeRepository "https://bitbucket.org/srouxjgi/iphop/" ;
    schema1:dateCreated "2024-10-14" ;
    schema1:description "Integrated Phage Host Prediction" ;
    schema1:encodingFormat "csv" ;
    schema1:featureList edam:operation_3731 ;
    schema1:identifier biotools:iphop,
        bioconda:iphop ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=62392daea25a3980>,
        <https://usegalaxy.eu/published/workflow?id=c62d65832377e376> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "iphop" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/Helmholtz-UFZ/ufz-galaxy-tools/blob/main/tools/iphop/" .

<https://usegalaxy.eu> a schema1:WebSite .

