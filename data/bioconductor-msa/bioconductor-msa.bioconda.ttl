@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-msa a schema1:SoftwareApplication ;
    schema1:alternateName "Multiple Sequence Alignment" ;
    schema1:description "The 'msa' package provides a unified R/Bioconductor interface to the multiple sequence alignment algorithms ClustalW, ClustalOmega, and Muscle. All three algorithms are integrated in the package, therefore, they do not depend on any external software tools and are available for all major platforms. The multiple sequence alignment algorithms are complemented by a function for pretty-printing multiple sequence alignments using the LaTeX package TeXshade." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/msa_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/msa/msa_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/msa_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-msa/bioconductor-msa_1.42.0_src_all.tar.gz" ;
    schema1:identifier "biotools:msa" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-msa" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/msa.html" .

