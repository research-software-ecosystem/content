@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-msa a schema:SoftwareApplication ;
    schema:description "Multiple Sequence Alignment" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/msa_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/msa/msa_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/msa_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-msa/bioconductor-msa_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:msa ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-msa" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/msa.html" .

