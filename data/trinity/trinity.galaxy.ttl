    schema1:keywords "RNA",
        "Transcriptomics" ;
    schema1:name "trinity" ;
    schema1:softwareVersion "2.15.1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/trinity> .

