@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trinity a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.1883",
        "doi:10.1038/nprot.2013.084" ;
    schema:description "Trinity assembles transcript sequences from Illumina RNA-Seq data." ;
    schema:downloadUrl "https://github.com/trinityrnaseq/trinityrnaseq/releases/download/Trinity-v2.15.2/trinityrnaseq-v2.15.2.FULL.tar.gz" ;
    schema:hasPart "htslib",
        "libgomp",
        "llvm-openmp",
        "perl",
        "rsync",
        "zlib" ;
    schema:identifier biotools:trinity ;
    schema:license "BSD-3-Clause" ;
    schema:name "trinity" ;
    schema:softwareHelp "https://github.com/trinityrnaseq/trinityrnaseq/wiki" ;
    schema:softwareVersion "2.15.2" ;
    schema:url "https://github.com/trinityrnaseq/trinityrnaseq" .

