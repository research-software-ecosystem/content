@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ncdfflow a schema1:SoftwareApplication ;
    schema1:alternateName "ncdfFlow: A package that provides HDF5 based storage for flow cytometry data." ;
    schema1:citation "doi:10.1016/j.copbio.2012.09.003" ;
    schema1:description "Provides HDF5 storage based methods and functions for manipulation of flow cytometry data." ;
    schema1:identifier biotools:ncdfflow ;
    schema1:license "AGPL-3.0-only" ;
    schema1:name "bioconductor-ncdfflow" ;
    schema1:softwareVersion "2.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ncdfFlow.html" .

