@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ncdfflow a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.copbio.2012.09.003" ;
    schema:description "ncdfFlow: A package that provides HDF5 based storage for flow cytometry data." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ncdfFlow_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ncdfFlow/ncdfFlow_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ncdfFlow_2.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ncdfflow/bioconductor-ncdfflow_2.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-flowcore",
        "bioconductor-rhdf5lib",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-cpp11",
        "zlib" ;
    schema:identifier biotools:ncdfflow ;
    schema:license "AGPL-3.0-only" ;
    schema:name "bioconductor-ncdfflow" ;
    schema:softwareVersion "2.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ncdfFlow.html" .

