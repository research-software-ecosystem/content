@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-makecdfenv a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-13-56" ;
    schema:description "CDF Environment Maker" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/makecdfenv_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/makecdfenv/makecdfenv_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/makecdfenv_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-makecdfenv/bioconductor-makecdfenv_1.86.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyio",
        "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:makecdfenv ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-makecdfenv" ;
    schema:softwareVersion "1.86.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/makecdfenv.html" .

