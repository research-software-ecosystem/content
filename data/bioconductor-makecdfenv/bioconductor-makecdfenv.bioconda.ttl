@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-makecdfenv a schema1:SoftwareApplication ;
    schema1:alternateName "CDF Environment Maker" ;
    schema1:citation "doi:10.1186/1471-2105-13-56" ;
    schema1:description "This package has two functions. One reads a Affymetrix chip description file (CDF) and creates a hash table environment containing the location/probe set membership mapping. The other creates a package that automatically loads that environment." ;
    schema1:identifier biotools:makecdfenv ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-makecdfenv" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/makecdfenv.html" .

