@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:guidemaker a schema:SoftwareApplication ;
    schema:author "arivers",
        "ravinpoudel" ;
    schema:citation "doi:10.5281/zenodo.4849258" ;
    schema:description "GuideMaker: Software to design gRNAs pools in non-model genomes and CRISPR-Cas systems" ;
    schema:downloadUrl "https://github.com/USDA-ARS-GBRU/GuideMaker/archive/v0.4.2.tar.gz" ;
    schema:hasPart "biopython",
        "pip",
        "python" ;
    schema:identifier biotools:GuideMaker ;
    schema:license "CC0-1.0" ;
    schema:maintainer "arivers",
        "ravinpoudel" ;
    schema:name "guidemaker" ;
    schema:softwareHelp "https://guidemaker.org/" ;
    schema:softwareVersion "0.4.2" ;
    schema:url "https://guidemaker.app.scinet.usda.gov/" .

