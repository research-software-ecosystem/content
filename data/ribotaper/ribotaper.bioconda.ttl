@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ribotaper a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3688" ;
    schema:description "RiboTaper is a new analysis pipeline for Ribosome Profiling (Ribo-seq) experiments, which exploits the triplet periodicity of ribosomal footprints to call translated regions." ;
    schema:downloadUrl "https://ohlerlab.mdc-berlin.de/files/RiboTaper/RiboTaper-1.3.1a.tar.gz" ;
    schema:hasPart "bedtools",
        "r-ade4",
        "r-domc",
        "r-foreach",
        "r-iterators",
        "r-multitaper",
        "r-seqinr",
        "r-xnomial",
        "samtools" ;
    schema:identifier biotools:ribotaper ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "ribotaper" ;
    schema:softwareVersion "1.3.1a" ;
    schema:url "https://ohlerlab.mdc-berlin.de/software/RiboTaper_126/" .

