      "sc:citation": {
        "@id": "https://doi.org/10.20944/preprints202610.1918.v2"
      },
      "sc:description": "Open tool that ranks existing drugs for each disease in a biomedical knowledge graph (PrimeKG extended with Open Targets and STRING) and shows the evidence behind every candidate. Only candidates backed by evidence checked against held-out data are shown, with how often each kind of evidence was right. Includes OREVID-bench, a public, reproducible drug-repurposing benchmark with TxGNN run on the same splits. Research use only: it generates hypotheses and is not a clinical tool.",
      "sc:featureList": {
        "@id": "edam:operation_2423"
      },
