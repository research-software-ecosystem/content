@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pathostat a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "PathoStat Statistical Microbiome Analysis Package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PathoStat_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PathoStat/PathoStat_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PathoStat_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathostat/bioconductor-pathostat_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocstyle",
        "bioconductor-complexheatmap",
        "bioconductor-deseq2",
        "bioconductor-edger",
        "bioconductor-limma",
        "bioconductor-phyloseq",
        "r-ape",
        "r-base",
        "r-corpcor",
        "r-devtools",
        "r-dplyr",
        "r-dt",
        "r-ggplot2",
        "r-glmnet",
        "r-gmodels",
        "r-knitr",
        "r-matrixstats",
        "r-plotly",
        "r-plyr",
        "r-rcolorbrewer",
        "r-rentrez",
        "r-reshape2",
        "r-rocr",
        "r-scales",
        "r-shiny",
        "r-shinyjs",
        "r-tidyr",
        "r-vegan",
        "r-webshot",
        "r-xml" ;
    schema:identifier biotools:pathostat ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-pathostat" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PathoStat.html" .

