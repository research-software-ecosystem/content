@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pathostat a schema1:SoftwareApplication ;
    schema1:alternateName "PathoStat Statistical Microbiome Analysis Package" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The purpose of this package is to perform Statistical Microbiome Analysis on metagenomics results from sequencing data samples. In particular, it supports analyses on the PathoScope generated report files. PathoStat provides various functionalities including Relative Abundance charts, Diversity estimates and plots, tests of Differential Abundance, Time Series visualization, and Core OTU analysis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PathoStat_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PathoStat/PathoStat_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PathoStat_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pathostat/bioconductor-pathostat_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:pathostat" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-pathostat" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PathoStat.html" .

