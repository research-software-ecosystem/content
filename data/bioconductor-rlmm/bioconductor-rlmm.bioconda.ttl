@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rlmm a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bti741" ;
    schema:description "A Genotype Calling Algorithm for Affymetrix SNP Arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RLMM_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RLMM/RLMM_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RLMM_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rlmm/bioconductor-rlmm_1.72.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mass" ;
    schema:identifier biotools:rlmm ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-rlmm" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RLMM.html" .

