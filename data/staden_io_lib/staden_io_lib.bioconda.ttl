@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:staden_io_lib a schema:SoftwareApplication ;
    schema:description "Staden io_lib is a library of file reading and writing code e.g. for SAM/BAM/CRAM." ;
    schema:downloadUrl "https://github.com/jkbonfield/io_lib/releases/download/io_lib-1-15-1/io_lib-1.15.1.tar.gz" ;
    schema:hasPart "bzip2",
        "libcurl",
        "libdeflate",
        "xz",
        "zlib" ;
    schema:identifier biotools:staden_io_lib ;
    schema:license "BSD-3-Clause" ;
    schema:name "staden_io_lib" ;
    schema:softwareHelp "https://github.com/jkbonfield/io_lib/blob/io_lib-1-15-1/README.md" ;
    schema:softwareVersion "1.15.1" ;
    schema:url "https://github.com/jkbonfield/io_lib" .

