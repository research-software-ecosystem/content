@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-exomecopy a schema1:SoftwareApplication ;
    schema1:alternateName "Copy number variant detection from exome sequencing read depth" ;
    schema1:citation "doi:10.2202/1544-6115.1732" ;
    schema1:description "Detection of copy number variants (CNV) from exome sequencing samples, including unpaired samples.  The package implements a hidden Markov model which uses positional covariates, such as background read depth and GC-content, to simultaneously normalize and segment the samples into regions of constant copy count." ;
    schema1:identifier <https://bio.tools/biotools:exomecopy> ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "bioconductor-exomecopy" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/exomeCopy.html" .

