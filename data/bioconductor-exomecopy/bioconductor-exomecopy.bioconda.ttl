@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-exomecopy a schema1:SoftwareApplication ;
    schema1:citation "doi:10.2202/1544-6115.1732" ;
    schema1:description "Copy number variant detection from exome sequencing read depth" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/exomeCopy_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/exomeCopy/exomeCopy_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/exomeCopy_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-exomecopy/bioconductor-exomecopy_1.48.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "libblas",
        "liblapack",
        "r-base" ;
    schema1:identifier biotools:exomecopy ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "bioconductor-exomecopy" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/exomeCopy.html" .

