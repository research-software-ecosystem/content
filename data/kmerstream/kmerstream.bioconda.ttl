@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kmerstream a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu713" ;
    schema:description "Streaming algorithm for computing kmer statistics for massive genomics datasets" ;
    schema:downloadUrl "https://github.com/pmelsted/KmerStream/archive/v1.1.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:kmerstream ;
    schema:license "free software license" ;
    schema:name "kmerstream" ;
    schema:softwareVersion "1.1" ;
    schema:url "https://github.com/pmelsted/KmerStream" .

