@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dirichletmultinomial a schema1:SoftwareApplication ;
    schema1:alternateName "Dirichlet-Multinomial Mixture Model Machine Learning for Microbiome Data" ;
    schema1:citation "doi:10.1371/journal.pone.0030126" ;
    schema1:description "Dirichlet-multinomial mixture models can be used to describe variability in microbial metagenomic data. This package is an interface to code originally made available by Holmes, Harris, and Quince, 2012, PLoS ONE 7(2): 1-15, as discussed further in the man page for this package, ?DirichletMultinomial." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DirichletMultinomial_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DirichletMultinomial/DirichletMultinomial_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DirichletMultinomial_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dirichletmultinomial/bioconductor-dirichletmultinomial_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dirichletmultinomial" ;
    schema1:license "LGPL-3" ;
    schema1:name "bioconductor-dirichletmultinomial" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DirichletMultinomial.html" .

