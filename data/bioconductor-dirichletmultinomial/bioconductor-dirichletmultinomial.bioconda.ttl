@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dirichletmultinomial a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0030126" ;
    schema:description "Dirichlet-Multinomial Mixture Model Machine Learning for Microbiome Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DirichletMultinomial_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DirichletMultinomial/DirichletMultinomial_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DirichletMultinomial_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dirichletmultinomial/bioconductor-dirichletmultinomial_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "gsl",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:dirichletmultinomial ;
    schema:license "LGPL-3" ;
    schema:name "bioconductor-dirichletmultinomial" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DirichletMultinomial.html" .

