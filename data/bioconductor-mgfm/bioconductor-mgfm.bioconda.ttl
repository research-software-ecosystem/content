@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mgfm a schema1:SoftwareApplication ;
    schema1:alternateName "Marker Gene Finder in Microarray gene expression data" ;
    schema1:citation "doi:10.1186/s12864-015-1785-9" ;
    schema1:description "The package is designed to detect marker genes from Microarray gene expression data sets" ;
    schema1:identifier <https://bio.tools/biotools:mgfm> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-mgfm" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MGFM.html" .

