@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mgfm a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-015-1785-9" ;
    schema:description "Marker Gene Finder in Microarray gene expression data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MGFM_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MGFM/MGFM_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MGFM_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mgfm/bioconductor-mgfm_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "r-base" ;
    schema:identifier biotools:mgfm ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-mgfm" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MGFM.html" .

