@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lpnet a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv327" ;
    schema:description "Linear Programming Model for Network Inference" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/lpNet_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lpNet/lpNet_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/lpNet_2.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lpnet/bioconductor-lpnet_2.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-kegggraph",
        "r-base",
        "r-lpsolve" ;
    schema:identifier biotools:lpnet ;
    schema:license "Artistic License 2.0" ;
    schema:name "bioconductor-lpnet" ;
    schema:softwareVersion "2.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/lpNet.html" .

