@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lpnet a schema1:SoftwareApplication ;
    schema1:alternateName "Linear Programming Model for Network Inference" ;
    schema1:citation "doi:10.1093/bioinformatics/btv327" ;
    schema1:description "lpNet aims at infering biological networks, in particular signaling and gene networks. For that it takes perturbation data, either steady-state or time-series, as input and generates an LP model which allows the inference of signaling networks. For parameter identification either leave-one-out cross-validation or stratified n-fold cross-validation can be used." ;
    schema1:identifier biotools:lpnet ;
    schema1:license "Artistic License 2.0" ;
    schema1:name "bioconductor-lpnet" ;
    schema1:softwareVersion "2.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/lpNet.html" .

