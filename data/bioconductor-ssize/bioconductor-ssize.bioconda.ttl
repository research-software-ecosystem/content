@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ssize a schema1:SoftwareApplication ;
    schema1:alternateName "Estimate Microarray Sample Size" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for computing and displaying sample size information for gene expression arrays." ;
    schema1:identifier biotools:ssize ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-ssize" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ssize.html" .

