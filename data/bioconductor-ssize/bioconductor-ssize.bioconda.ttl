@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ssize a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Estimate Microarray Sample Size" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ssize_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ssize/ssize_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ssize_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ssize/bioconductor-ssize_1.84.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-gdata",
        "r-xtable" ;
    schema:identifier biotools:ssize ;
    schema:license "LGPL" ;
    schema:name "bioconductor-ssize" ;
    schema:softwareVersion "1.84.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ssize.html" .

