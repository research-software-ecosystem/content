@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ssize a schema1:SoftwareApplication ;
    schema1:alternateName "Estimate Microarray Sample Size" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for computing and displaying sample size information for gene expression arrays." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ssize_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ssize/ssize_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ssize_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ssize/bioconductor-ssize_1.84.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ssize" ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-ssize" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ssize.html" .

