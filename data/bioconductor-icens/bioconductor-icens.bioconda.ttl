@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-icens a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "NPMLE for Censored and Truncated Data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Icens_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Icens/Icens_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Icens_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-icens/bioconductor-icens_1.82.0_src_all.tar.gz" ;
    schema1:hasPart "r-base",
        "r-survival" ;
    schema1:identifier biotools:icens ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-icens" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Icens.html" .

