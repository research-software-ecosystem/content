@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-icens a schema1:SoftwareApplication ;
    schema1:alternateName "NPMLE for Censored and Truncated Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Many functions for computing the NPMLE for censored and truncated data." ;
    schema1:identifier biotools:icens ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-icens" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Icens.html" .

