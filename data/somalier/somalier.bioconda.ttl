@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:somalier a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13073-020-00761-2" ;
    schema:description "Fast sample-swap and relatedness checks on BAMs/CRAMs/VCFs/GVCFs." ;
    schema:downloadUrl "https://github.com/brentp/somalier/archive/refs/tags/v0.3.2.tar.gz" ;
    schema:hasPart "curl",
        "htslib",
        "openblas" ;
    schema:identifier biotools:somalier ;
    schema:license "MIT" ;
    schema:name "somalier" ;
    schema:softwareHelp "https://github.com/brentp/somalier/blob/v0.3.2/README.md" ;
    schema:softwareVersion "0.3.2" ;
    schema:url "https://github.com/brentp/somalier" .

