@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:crossmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt730" ;
    schema:description "CrossMap is a program for convenient conversion of genome coordinates and genomeannotation files between assemblies." ;
    schema:downloadUrl "https://github.com/liguowang/CrossMap/archive/v0.7.3.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:crossmap ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "crossmap" ;
    schema:softwareHelp "https://crossmap.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.7.3" ;
    schema:url "https://crossmap.sourceforge.net" .

