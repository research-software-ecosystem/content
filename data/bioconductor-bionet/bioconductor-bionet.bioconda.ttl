@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bionet a schema:SoftwareApplication ;
    schema:description "Routines for the functional analysis of biological networks" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BioNet_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BioNet/BioNet_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BioNet_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bionet/bioconductor-bionet_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-graph",
        "bioconductor-rbgl",
        "r-base",
        "r-igraph" ;
    schema:identifier biotools:bionet ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-bionet" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BioNet.html" .

