      ],
      "sc:description": "CAPHEINE is a comprehensive computational workflow that automates exploratory evolutionary analysis using unaligned pathogen sequences and a reference genome. It is designed to study site-level selection dynamics, positive selection, and lineage-specific shifts in selective pressure.",
      "sc:name": "CAPHEINE: A workflow for automating selection analyses using HyPhy",
      "sc:url": "https://github.com/veg/CAPHEINE"
    }
