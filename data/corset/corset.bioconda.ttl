@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:corset a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-014-0410-6" ;
    schema:description "Software for clustering de novo assembled transcripts and counting overlapping reads." ;
    schema:downloadUrl "https://github.com/Oshlack/Corset/archive/version-1.09.tar.gz" ;
    schema:hasPart "samtools",
        "zlib" ;
    schema:identifier biotools:corset ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "corset" ;
    schema:softwareHelp "https://github.com/Oshlack/Corset/wiki" ;
    schema:softwareVersion "1.09" ;
    schema:url "https://github.com/Oshlack/Corset" .

