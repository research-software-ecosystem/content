@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-nnnorm a schema1:SoftwareApplication ;
    schema1:alternateName "Spatial and intensity based normalization of cDNA microarray data based on robust neural nets" ;
    schema1:citation "doi:10.1093/bioinformatics/bti397" ;
    schema1:description "This package allows to detect and correct for spatial and intensity biases with two-channel microarray data. The normalization method implemented in this package is based on robust neural networks fitting." ;
    schema1:identifier <https://bio.tools/biotools:nnnorm> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-nnnorm" ;
    schema1:softwareVersion "2.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/nnNorm.html" .

