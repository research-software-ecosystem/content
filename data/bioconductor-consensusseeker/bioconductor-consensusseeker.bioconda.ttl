@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-consensusseeker a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1515/sagmb-2014-0098" ;
    schema1:description "Detection of consensus regions inside a group of experiences using genomic positions and genomic ranges" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/consensusSeekeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/consensusSeekeR/consensusSeekeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/consensusSeekeR_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-consensusseeker/bioconductor-consensusseeker_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-stringr" ;
    schema1:identifier biotools:consensusseeker ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-consensusseeker" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/consensusSeekeR.html" .

