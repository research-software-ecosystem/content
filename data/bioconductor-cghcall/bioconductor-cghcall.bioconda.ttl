@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cghcall a schema1:SoftwareApplication ;
    schema1:alternateName "Calling aberrations for array CGH tumor profiles." ;
    schema1:citation "doi:10.1093/bioinformatics/btm030" ;
    schema1:description "Calls aberrations for array CGH data using a six state mixture model as well as several biological concepts that are ignored by existing algorithms. Visualization of profiles is also provided." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CGHcall_2.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CGHcall/CGHcall_2.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CGHcall_2.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cghcall/bioconductor-cghcall_2.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cghcall" ;
    schema1:license "GPL (http://www.gnu.org/copyleft/gpl.html)" ;
    schema1:name "bioconductor-cghcall" ;
    schema1:softwareVersion "2.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CGHcall.html" .

