@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cghcall a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm030" ;
    schema:description "Calling aberrations for array CGH tumor profiles." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CGHcall_2.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CGHcall/CGHcall_2.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CGHcall_2.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cghcall/bioconductor-cghcall_2.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-cghbase",
        "bioconductor-dnacopy",
        "bioconductor-impute",
        "r-base",
        "r-snowfall" ;
    schema:identifier biotools:cghcall ;
    schema:license "GPL (http://www.gnu.org/copyleft/gpl.html)" ;
    schema:name "bioconductor-cghcall" ;
    schema:softwareVersion "2.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CGHcall.html" .

