@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-absseq a schema1:SoftwareApplication ;
    schema1:alternateName "ABSSeq: a new RNA-Seq analysis method based on modelling absolute expression differences" ;
    schema1:description "Inferring differential expression genes by absolute counts difference between two groups, utilizing Negative binomial distribution and moderating fold-change according to heterogeneity of dispersion across expression level." ;
    schema1:identifier biotools:absseq ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-absseq" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ABSSeq.html" .

