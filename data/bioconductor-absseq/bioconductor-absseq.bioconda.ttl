@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-absseq a schema:SoftwareApplication ;
    schema:description "ABSSeq: a new RNA-Seq analysis method based on modelling absolute expression differences" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ABSSeq_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ABSSeq_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ABSSeq/ABSSeq_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-absseq/bioconductor-absseq_1.64.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "r-base",
        "r-locfit" ;
    schema:identifier biotools:absseq ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-absseq" ;
    schema:softwareVersion "1.64.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ABSSeq.html" .

