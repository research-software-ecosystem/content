@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:augur a schema:SoftwareApplication ;
    schema:author "corneliusroemer",
        "huddlej",
        "joverlee521",
        "nextstrain-bot",
        "victorlin" ;
    schema:citation "doi:10.21105/joss.02906" ;
    schema:description "Process pathogen genome data for the Nextstrain platform." ;
    schema:downloadUrl "https://github.com/nextstrain/augur/releases/download/33.4.1/nextstrain_augur-33.4.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:Augur ;
    schema:license "AGPL-3.0-only" ;
    schema:maintainer "corneliusroemer",
        "huddlej",
        "joverlee521",
        "nextstrain-bot",
        "victorlin" ;
    schema:name "augur" ;
    schema:softwareHelp "https://docs.nextstrain.org/projects/augur" ;
    schema:softwareVersion "33.4.1" ;
    schema:url "https://github.com/nextstrain/augur" .

