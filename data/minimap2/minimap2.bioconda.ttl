@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:minimap2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bty191" ;
    schema:description "A versatile pairwise aligner for genomic and spliced nucleotide sequences." ;
    schema:downloadUrl "https://github.com/lh3/minimap2/archive/v2.31.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:minimap2 ;
    schema:license "MIT" ;
    schema:name "minimap2" ;
    schema:softwareHelp "https://lh3.github.io/minimap2/minimap2.html" ;
    schema:softwareVersion "2.31" ;
    schema:url "https://github.com/lh3/minimap2" .

