@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:minimap2 a schema1:SoftwareApplication ;
    schema1:alternateName "A versatile pairwise aligner for genomic and spliced nucleotide sequences." ;
    schema1:citation "doi:10.1093/bioinformatics/bty191" ;
    schema1:description "A versatile pairwise aligner for genomic and spliced nucleotide sequences." ;
    schema1:identifier biotools:minimap2,
        "usegalaxy-eu:minimap2" ;
    schema1:license "MIT" ;
    schema1:name "minimap2" ;
    schema1:softwareVersion "2.31" ;
    schema1:url "https://github.com/lh3/minimap2" .

