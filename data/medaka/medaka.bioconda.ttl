@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:medaka a schema1:SoftwareApplication ;
    schema1:alternateName "A tool to create consensus sequences and variant calls from nanopore sequencing data using neural networks." ;
    schema1:description "A tool to create consensus sequences and variant calls from nanopore sequencing data using neural networks." ;
    schema1:identifier biotools:medaka,
        "usegalaxy-eu:medaka_consensus",
        "usegalaxy-eu:medaka_consensus_pipeline",
        "usegalaxy-eu:medaka_variant",
        "usegalaxy-eu:medaka_variant_pipeline" ;
    schema1:license "Oxford Nanopore Technologies PLC. Public License Version 1.0" ;
    schema1:name "medaka" ;
    schema1:softwareVersion "2.2.2" ;
    schema1:url "https://github.com/nanoporetech/medaka" .

