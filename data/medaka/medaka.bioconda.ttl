@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:medaka a schema:SoftwareApplication ;
    schema:description "A tool to create consensus sequences and variant calls from nanopore sequencing data using neural networks." ;
    schema:downloadUrl "https://pypi.org/packages/source/m/medaka/medaka-2.2.2.tar.gz" ;
    schema:hasPart "bzip2",
        "cffi",
        "htslib",
        "libcurl",
        "pip",
        "python",
        "xz",
        "zlib" ;
    schema:identifier biotools:medaka ;
    schema:license "Oxford Nanopore Technologies PLC. Public License Version 1.0" ;
    schema:name "medaka" ;
    schema:softwareHelp "https://github.com/nanoporetech/medaka/blob/v2.2.2/README.md" ;
    schema:softwareVersion "2.2.2" ;
    schema:url "https://github.com/nanoporetech/medaka" .

