@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:hicap a schema1:SoftwareApplication ;
    bioschemas:output "genbank",
        "svg",
        "tabular" ;
    schema1:codeRepository <https://github.com/scwatts/hicap> ;
    schema1:dateCreated "2026-03-26" ;
    schema1:description "Identify cap locus serotype and structure in Haemophilus influenzae assemblies" ;
    schema1:encodingFormat "genbank",
        "svg",
        "tabular" ;
    schema1:identifier biotools:hicap,
        bioconda:hicap ;
    schema1:isPartOf <https://usegalaxy.eu> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "hicap" ;
    schema1:softwareVersion "1.0.4" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/hicap> .

<https://usegalaxy.eu> a schema1:WebSite .

