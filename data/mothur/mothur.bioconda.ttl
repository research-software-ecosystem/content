@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mothur a schema:SoftwareApplication ;
    schema:citation "doi:10.1128/AEM.01541-09" ;
    schema:description "This project seeks to develop a single piece of open-source, expandable software to fill the bioinformatics needs of the microbial ecology community." ;
    schema:downloadUrl "https://github.com/mothur/mothur/archive/refs/tags/v1.48.5.tar.gz" ;
    schema:hasPart "blast",
        "boost-cpp",
        "bzip2",
        "gsl",
        "hdf5",
        "readline",
        "sra-tools",
        "vsearch",
        "zlib" ;
    schema:identifier biotools:mothur ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "mothur" ;
    schema:softwareHelp "https://mothur.org/wiki/mothur_manual" ;
    schema:softwareVersion "1.48.5" ;
    schema:url "https://www.mothur.org" .

