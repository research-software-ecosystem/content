@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbm a schema1:SoftwareApplication ;
    schema1:alternateName "RBM: a R package for microarray and RNA-Seq data analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Use A Resampling-Based Empirical Bayes Approach to Assess Differential Expression in Two-Color Microarrays and RNA-Seq data sets." ;
    schema1:identifier <https://bio.tools/biotools:rbm> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-rbm" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RBM.html" .

