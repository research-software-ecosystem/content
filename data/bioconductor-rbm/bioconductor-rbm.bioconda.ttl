@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rbm a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "RBM: a R package for microarray and RNA-Seq data analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RBM_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RBM/RBM_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RBM_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbm/bioconductor-rbm_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "bioconductor-marray",
        "r-base" ;
    schema:identifier biotools:rbm ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-rbm" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RBM.html" .

