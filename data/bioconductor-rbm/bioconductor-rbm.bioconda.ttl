@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rbm a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "RBM: a R package for microarray and RNA-Seq data analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RBM_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RBM/RBM_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RBM_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rbm/bioconductor-rbm_1.42.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-limma",
        "bioconductor-marray",
        "r-base" ;
    schema1:identifier biotools:rbm ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-rbm" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RBM.html" .

