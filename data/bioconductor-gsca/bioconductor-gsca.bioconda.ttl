@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsca a schema1:SoftwareApplication ;
    schema1:description "GSCA: Gene Set Context Analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GSCA_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSCA/GSCA_2.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSCA_2.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsca/bioconductor-gsca_2.40.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-rhdf5",
        "r-base",
        "r-ggplot2",
        "r-gplots",
        "r-rcolorbrewer",
        "r-reshape2",
        "r-shiny",
        "r-sp" ;
    schema1:identifier biotools:gsca ;
    schema1:license "GPL(>=2)" ;
    schema1:name "bioconductor-gsca" ;
    schema1:softwareVersion "2.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSCA.html" .

