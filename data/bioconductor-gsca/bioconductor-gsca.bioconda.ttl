@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsca a schema1:SoftwareApplication ;
    schema1:alternateName "GSCA: Gene Set Context Analysis" ;
    schema1:description "GSCA takes as input several lists of activated and repressed genes. GSCA then searches through a compendium of publicly available gene expression profiles for biological contexts that are enriched with a specified pattern of gene expression. GSCA provides both traditional R functions and interactive, user-friendly user interface." ;
    schema1:identifier biotools:gsca ;
    schema1:license "GPL(>=2)" ;
    schema1:name "bioconductor-gsca" ;
    schema1:softwareVersion "2.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSCA.html" .

