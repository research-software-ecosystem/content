@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-r3cseq a schema1:SoftwareApplication ;
    schema1:alternateName "Analysis of Chromosome Conformation Capture and Next-generation Sequencing (3C-seq)" ;
    schema1:citation "doi:10.1093/nar/gkt373" ;
    schema1:description "This package is used for the analysis of long-range chromatin interactions from 3C-seq assay." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/r3Cseq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/r3Cseq/r3Cseq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/r3Cseq_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-r3cseq/bioconductor-r3cseq_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:r3cseq" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-r3cseq" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/r3Cseq.html" .

