@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-r3cseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkt373" ;
    schema:description "Analysis of Chromosome Conformation Capture and Next-generation Sequencing (3C-seq)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/r3Cseq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/r3Cseq/r3Cseq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/r3Cseq_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-r3cseq/bioconductor-r3cseq_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-qvalue",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-seqinfo",
        "r-base",
        "r-data.table",
        "r-rcolorbrewer",
        "r-sqldf",
        "r-vgam" ;
    schema:identifier biotools:r3cseq ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-r3cseq" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/r3Cseq.html" .

