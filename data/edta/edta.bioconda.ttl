@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:edta a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2022.10.09.511471",
        "doi:10.1186/s13059-019-1905-y" ;
    schema:description "Extensive de-novo TE Annotator." ;
    schema:downloadUrl "https://github.com/oushujun/EDTA/archive/v2.3.0.tar.gz" ;
    schema:identifier biotools:EDTA ;
    schema:license "GPL-3.0-only" ;
    schema:name "edta" ;
    schema:softwareHelp "https://github.com/oushujun/EDTA/wiki" ;
    schema:softwareVersion "2.3.0" ;
    schema:url "https://github.com/oushujun/EDTA" .

