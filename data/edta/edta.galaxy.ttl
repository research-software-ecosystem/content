@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:edta a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "gff3",
        "xml" ;
    schema1:applicationSubCategory edam:data_1301,
        edam:topic_0621,
        edam:topic_0749,
        edam:topic_0769,
        edam:topic_0780,
        edam:topic_0798 ;
    schema1:codeRepository <https://github.com/oushujun/EDTA> ;
    schema1:dateCreated "2022-10-16" ;
    schema1:description "The EDTA package was designed to filter out false discoveries in raw TE candidates and generate a high-quality non-redundant TE library for whole-genome TE annotations. " ;
    schema1:encodingFormat "fasta",
        "gff3",
        "xml" ;
    schema1:featureList edam:operation_0362,
        edam:operation_0524,
        edam:operation_3629,
        edam:topic_0222 ;
    schema1:identifier biotools:edta,
        bioconda:edta ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "edta" ;
    schema1:softwareVersion "@WRAPPER_VERSION@+@VERSION_SUFFIX@" ;
    schema1:url galaxytool:edta .

<https://usegalaxy.be> a schema1:WebSite .

<https://usegalaxy.cz> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

<https://usegalaxy.org.au> a schema1:WebSite .

