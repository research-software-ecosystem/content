@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mgsa a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkq045" ;
    schema:description "Model-based gene set analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/mgsa_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mgsa/mgsa_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mgsa_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mgsa/bioconductor-mgsa_1.58.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-gplots",
        "zlib" ;
    schema:identifier biotools:mgsa ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-mgsa" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/mgsa.html" .

