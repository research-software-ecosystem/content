@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mgsa a schema1:SoftwareApplication ;
    schema1:alternateName "Model-based gene set analysis" ;
    schema1:citation "doi:10.1093/nar/gkq045" ;
    schema1:description "Model-based Gene Set Analysis (MGSA) is a Bayesian modeling approach for gene set enrichment. The package mgsa implements MGSA and tools to use MGSA together with the Gene Ontology." ;
    schema1:identifier biotools:mgsa ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mgsa" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mgsa.html" .

