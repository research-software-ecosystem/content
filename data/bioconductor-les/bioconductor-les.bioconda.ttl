@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-les a schema:SoftwareApplication ;
    schema:citation "doi:10.1089/cmb.2008.0226" ;
    schema:description "Identifying Differential Effects in Tiling Microarray Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/les_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/les/les_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/les_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-les/bioconductor-les_1.60.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-boot",
        "r-fdrtool",
        "r-gplots",
        "r-rcolorbrewer" ;
    schema:identifier biotools:les ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-les" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/les.html" .

