@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-randpack a schema1:SoftwareApplication ;
    schema1:alternateName "Randomization routines for Clinical Trials" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A suite of classes and functions for randomizing patients in clinical trials." ;
    schema1:identifier <https://bio.tools/biotools:randpack> ;
    schema1:license "Artistic 2.0" ;
    schema1:name "bioconductor-randpack" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/randPack.html" .

