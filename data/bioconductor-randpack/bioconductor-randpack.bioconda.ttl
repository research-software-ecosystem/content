@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-randpack a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Randomization routines for Clinical Trials" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/randPack_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/randPack/randPack_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/randPack_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-randpack/bioconductor-randpack_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:randpack ;
    schema:license "Artistic 2.0" ;
    schema:name "bioconductor-randpack" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/randPack.html" .

