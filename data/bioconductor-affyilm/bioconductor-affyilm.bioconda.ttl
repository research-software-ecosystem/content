@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affyilm a schema1:SoftwareApplication ;
    schema1:alternateName "Linear Model of background subtraction and the Langmuir isotherm" ;
    schema1:citation "doi:10.1186/1748-7188-4-15" ;
    schema1:description "affyILM is a preprocessing tool which estimates gene expression levels for Affymetrix Gene Chips. Input from physical chemistry is employed to first background subtract intensities before calculating concentrations on behalf of the Langmuir model." ;
    schema1:identifier biotools:affyilm ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-affyilm" ;
    schema1:softwareVersion "1.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affyILM.html" .

