@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-affyilm a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1748-7188-4-15" ;
    schema:description "Linear Model of background subtraction and the Langmuir isotherm" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/affyILM_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affyILM/affyILM_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affyILM_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affyilm/bioconductor-affyilm_1.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affxparser",
        "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-gcrma",
        "r-base" ;
    schema:identifier biotools:affyilm ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-affyilm" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/affyILM.html" .

