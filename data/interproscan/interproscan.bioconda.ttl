@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:interproscan a schema:SoftwareApplication ;
    schema:description "InterPro integrates together predictive information about proteins function from a number of partner resources" ;
    schema:downloadUrl "https://github.com/ebi-pf-team/interproscan/archive/5.59-91.0.tar.gz" ;
    schema:identifier biotools:interproscan_ebi ;
    schema:license "GPLv3" ;
    schema:name "interproscan" ;
    schema:softwareVersion "5.59_91.0" ;
    schema:url "https://github.com/ebi-pf-team/interproscan" .

