@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-methylumi a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1186/1471-2164-14-293" ;
    schema1:description "Handle Illumina methylation data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/methylumi_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methylumi/methylumi_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/methylumi_2.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylumi/bioconductor-methylumi_2.56.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-fdb.infiniummethylation.hg19",
        "bioconductor-genefilter",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-illuminaio",
        "bioconductor-iranges",
        "bioconductor-minfi",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-ggplot2",
        "r-lattice",
        "r-matrixstats",
        "r-reshape2",
        "r-scales" ;
    schema1:identifier biotools:methylumi ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-methylumi" ;
    schema1:softwareVersion "2.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/methylumi.html" .

