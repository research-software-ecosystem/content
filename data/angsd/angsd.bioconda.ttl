@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:angsd a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-014-0356-4" ;
    schema:description "ANGSD: Analysis of next generation Sequencing Data" ;
    schema:downloadUrl "http://popgen.dk/software/download/angsd/angsd0.940.tar.gz" ;
    schema:hasPart "bzip2",
        "htslib",
        "xz",
        "zlib" ;
    schema:identifier biotools:angsd ;
    schema:license "GPLv3, MIT" ;
    schema:name "angsd" ;
    schema:softwareVersion "0.94" ;
    schema:url "http://www.popgen.dk/angsd/index.php/ANGSD" .

