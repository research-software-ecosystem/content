@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-seqtools a schema1:SoftwareApplication ;
    schema1:alternateName "Analysis of nucleotide, sequence and quality content on fastq files" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Analyze read length, phred scores and alphabet frequency and DNA k-mers on uncompressed and compressed fastq files." ;
    schema1:identifier <https://bio.tools/biotools:seqtools> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-seqtools" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.20/bioc/html/seqTools.html" .

