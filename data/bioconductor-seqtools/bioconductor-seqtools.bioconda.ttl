@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-seqtools a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Analysis of nucleotide, sequence and quality content on fastq files" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/seqTools_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/seqTools/seqTools_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/seqTools_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-seqtools/bioconductor-seqtools_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-zlibbioc",
        "libblas",
        "liblapack",
        "r-base",
        "zlib" ;
    schema:identifier biotools:seqtools ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-seqtools" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/seqTools.html" .

