@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pandar a schema1:SoftwareApplication ;
    schema1:alternateName "PANDA Algorithm" ;
    schema1:description "Runs PANDA, an algorithm for discovering novel network structure by combining information from multiple complementary data sources." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pandaR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pandaR/pandaR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pandaR_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pandar/bioconductor-pandar_1.42.0_src_all.tar.gz" ;
    schema1:identifier "biotools:pandar" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-pandar" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pandaR.html" .

