@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pandar a schema:SoftwareApplication ;
    schema:description "PANDA Algorithm" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pandaR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pandaR/pandaR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pandaR_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pandar/bioconductor-pandar_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "r-base",
        "r-ggplot2",
        "r-hexbin",
        "r-igraph",
        "r-matrixstats",
        "r-plyr",
        "r-reshape",
        "r-runit" ;
    schema:identifier biotools:pandar ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-pandar" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pandaR.html" .

