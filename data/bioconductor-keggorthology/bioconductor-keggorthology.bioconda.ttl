@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-keggorthology a schema1:SoftwareApplication ;
    schema1:alternateName "graph support for KO, KEGG Orthology" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "graphical representation of the Feb 2010 KEGG Orthology. The KEGG orthology is a set of pathway IDs that are not to be confused with the KEGG ortholog IDs." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/keggorthology_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/keggorthology/keggorthology_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/keggorthology_2.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-keggorthology/bioconductor-keggorthology_2.62.0_src_all.tar.gz" ;
    schema1:identifier "biotools:keggorthology" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-keggorthology" ;
    schema1:softwareVersion "2.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/keggorthology.html" .

