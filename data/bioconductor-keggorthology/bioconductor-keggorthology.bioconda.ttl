@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-keggorthology a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "graph support for KO, KEGG Orthology" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/keggorthology_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/keggorthology/keggorthology_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/keggorthology_2.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-keggorthology/bioconductor-keggorthology_2.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-graph",
        "bioconductor-hgu95av2.db",
        "r-base",
        "r-dbi" ;
    schema:identifier biotools:keggorthology ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-keggorthology" ;
    schema:softwareVersion "2.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/keggorthology.html" .

