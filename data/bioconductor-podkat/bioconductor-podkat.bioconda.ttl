@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-podkat a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Position-Dependent Kernel Association Test" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/podkat_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/podkat/podkat_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/podkat_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-podkat/bioconductor-podkat_1.42.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rhtslib",
        "bioconductor-rsamtools",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:podkat ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-podkat" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/podkat.html" .

