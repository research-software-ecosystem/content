@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-podkat a schema1:SoftwareApplication ;
    schema1:alternateName "Position-Dependent Kernel Association Test" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides an association test that is capable of dealing with very rare and even private variants. This is accomplished by a kernel-based approach that takes the positions of the variants into account. The test can be used for pre-processed matrix data, but also directly for variant data stored in VCF files. Association testing can be performed whole-genome, whole-exome, or restricted to pre-defined regions of interest. The test is complemented by tools for analyzing and visualizing the results." ;
    schema1:identifier biotools:podkat ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-podkat" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/podkat.html" .

