@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-npgsea a schema:SoftwareApplication ;
    schema:description "Permutation approximation methods for gene set enrichment analysis (non-permutation GSEA)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/npGSEA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/npGSEA/npGSEA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/npGSEA_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-npgsea/bioconductor-npgsea_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-gseabase",
        "r-base" ;
    schema:identifier biotools:npgsea ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-npgsea" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/npGSEA.html" .

