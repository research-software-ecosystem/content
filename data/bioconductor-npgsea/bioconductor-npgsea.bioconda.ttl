@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-npgsea a schema1:SoftwareApplication ;
    schema1:alternateName "Permutation approximation methods for gene set enrichment analysis (non-permutation GSEA)" ;
    schema1:description "Current gene set enrichment methods rely upon permutations for inference.  These approaches are computationally expensive and have minimum achievable p-values based on the number of permutations, not on the actual observed statistics.  We have derived three parametric approximations to the permutation distributions of two gene set enrichment test statistics.  We are able to reduce the computational burden and granularity issues of permutation testing with our method, which is implemented in this package. npGSEA calculates gene set enrichment statistics and p-values without the computational cost of permutations.  It is applicable in settings where one or many gene sets are of interest.  There are also built-in plotting functions to help users visualize results." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/npGSEA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/npGSEA/npGSEA_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/npGSEA_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-npgsea/bioconductor-npgsea_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:npgsea" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-npgsea" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/npGSEA.html" .

