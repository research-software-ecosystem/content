@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metabat2 a schema:SoftwareApplication ;
    schema:citation "doi:10.7717/peerj.1165" ;
    schema:description "Metagenome binning." ;
    schema:hasPart "boost-cpp",
        "htslib",
        "libdeflate",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:MetaBAT_2 ;
    schema:license "BSD-3-Clause-LBNL" ;
    schema:name "metabat2" ;
    schema:softwareHelp "https://bitbucket.org/berkeleylab/metabat/src/v2.18/README.md" ;
    schema:softwareVersion "2.18_23_gc869c52" ;
    schema:url "https://bitbucket.org/berkeleylab/metabat" .

