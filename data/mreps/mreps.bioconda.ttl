@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mreps a schema:SoftwareApplication ;
    schema:description "mreps is a flexible and efficient software for identifying serial repeats (usually called tandem repeats) in DNA sequences." ;
    schema:downloadUrl "https://github.com/gregorykucherov/mreps/archive/2.6.01.tar.gz" ;
    schema:identifier biotools:mreps ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "mreps" ;
    schema:softwareVersion "2.6.01" ;
    schema:url "http://mreps.univ-mlv.fr" .

