@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mreps a schema1:SoftwareApplication ;
    schema1:alternateName "mreps is a flexible and efficient software for identifying serial repeats (usually called tandem repeats) in DNA sequences." ;
    schema1:description "mreps is a flexible and efficient software for identifying serial repeats (usually called tandem repeats) in DNA sequences." ;
    schema1:identifier <https://bio.tools/biotools:mreps> ;
    schema1:license "GPL-2.0-or-later" ;
    schema1:name "mreps" ;
    schema1:softwareVersion "2.6.01" ;
    schema1:url "http://mreps.univ-mlv.fr" .

