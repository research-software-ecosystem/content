@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:admixture a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.094052.109" ;
    schema:description "ADMIXTURE is a software tool for maximum likelihood estimation of individual ancestries from multilocus SNP genotype datasets." ;
    schema:identifier biotools:admixture ;
    schema:license "Free for Academic Use" ;
    schema:name "admixture" ;
    schema:softwareVersion "1.3.0" ;
    schema:url "http://www.genetics.ucla.edu/software/admixture/index.html" .

