@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bayestyper a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41588-018-0145-5" ;
    schema:description "A method for variant graph genotyping based on exact alignment of k-mers." ;
    schema:downloadUrl "https://github.com/bioinformatics-centre/BayesTyper/archive/v1.5.tar.gz" ;
    schema:hasPart "boost-cpp",
        "zlib" ;
    schema:identifier biotools:bayestyper ;
    schema:license "MIT" ;
    schema:name "bayestyper" ;
    schema:softwareHelp "https://github.com/bioinformatics-centre/BayesTyper/blob/v1.5/README.md" ;
    schema:softwareVersion "1.5" ;
    schema:url "https://github.com/bioinformatics-centre/BayesTyper" .

