@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sva a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pgen.0030161" ;
    schema:description "Surrogate Variable Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sva_3.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sva/sva_3.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sva_3.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sva/bioconductor-sva_3.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "bioconductor-edger",
        "bioconductor-genefilter",
        "bioconductor-limma",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrixstats",
        "r-mgcv",
        "zlib" ;
    schema:identifier biotools:sva ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-sva" ;
    schema:softwareVersion "3.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sva.html" .

