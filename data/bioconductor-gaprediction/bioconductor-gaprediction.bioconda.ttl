@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gaprediction a schema1:SoftwareApplication ;
    schema1:alternateName "Prediction of gestational age with Illumina HumanMethylation450 data" ;
    schema1:citation "doi:10.1186/s13059-016-1063-4" ;
    schema1:description "[GAprediction] predicts gestational age using Illumina HumanMethylation450 CpG data." ;
    schema1:identifier biotools:gaprediction ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-gaprediction" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GAprediction.html" .

