@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mygene a schema1:SoftwareApplication ;
    schema1:alternateName "Access MyGene.Info_ services" ;
    schema1:citation "doi:10.1101/009333" ;
    schema1:description "MyGene.Info_ provides simple-to-use REST web services to query/retrieve gene annotation data. It's designed with simplicity and performance emphasized. *mygene*, is an easy-to-use R wrapper to access MyGene.Info_ services." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/mygene_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mygene/mygene_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mygene_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mygene/bioconductor-mygene_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mygene" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-mygene" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mygene.html" .

