@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kat a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw663" ;
    schema:description "KAT is a suite of tools that analyse jellyfish hashes or sequence files (fasta or fastq) using kmer counts." ;
    schema:downloadUrl "https://github.com/TGAC/KAT/archive/Release-2.4.2.tar.gz" ;
    schema:hasPart "boost-cpp",
        "matplotlib-base",
        "numpy",
        "pip",
        "python",
        "scipy",
        "tabulate",
        "zlib" ;
    schema:identifier biotools:kat ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "kat" ;
    schema:softwareHelp "https://kat.readthedocs.io/en/latest" ;
    schema:softwareVersion "2.4.2" ;
    schema:url "https://github.com/TGAC/KAT" .

