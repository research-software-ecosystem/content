@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:deeplc a schema:SoftwareApplication ;
    schema:author "compomics" ;
    schema:citation "doi:10.1038/s41592-021-01301-5" ;
    schema:description "DeepLC: Retention time prediction for (modified) peptides using Deep Learning." ;
    schema:downloadUrl "https://pypi.io/packages/source/D/DeepLC/deeplc-3.1.13.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:deeplc ;
    schema:license "Apache-2.0" ;
    schema:maintainer "compomics" ;
    schema:name "deeplc" ;
    schema:softwareHelp "https://github.com/compomics/DeepLC/blob/v3.1.13/README.md" ;
    schema:softwareVersion "3.1.13" ;
    schema:url "https://compomics.github.io/projects/DeepLC" .

