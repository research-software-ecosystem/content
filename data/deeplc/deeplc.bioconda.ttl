@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:deeplc a schema1:SoftwareApplication ;
    schema1:alternateName "DeepLC: Retention time prediction for (modified) peptides using Deep Learning." ;
    schema1:citation "doi:10.1038/s41592-021-01301-5" ;
    schema1:description "DeepLC: Retention time prediction for (modified) peptides using Deep Learning." ;
    schema1:identifier biotools:deeplc ;
    schema1:license "Apache-2.0" ;
    schema1:maintainer "compomics" ;
    schema1:name "deeplc" ;
    schema1:softwareVersion "4.2.0" ;
    schema1:url "https://compomics.github.io/projects/DeepLC" .

