@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rapidnj a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-540-87361-7_10" ;
    schema:description "RapidNJ is an algorithmic engineered implementation of canonical neighbour-joining. It uses an efficient search heuristic to speed-up the core computations of the neighbour-joining method that enables RapidNJ to outperform other state-of-the-art neighbour-joining implementations." ;
    schema:downloadUrl "https://github.com/somme89/rapidNJ/archive/ed2d36e219d9db16778b941b5054c0fd021b528a.tar.gz" ;
    schema:identifier biotools:rapidnj ;
    schema:license "GPL-2.0-only" ;
    schema:name "rapidnj" ;
    schema:softwareHelp "https://github.com/somme89/rapidNJ/blob/master/README" ;
    schema:softwareVersion "2.3.3" ;
    schema:url "https://birc.au.dk/software/rapidnj" .

