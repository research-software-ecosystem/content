@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bsmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-10-232" ;
    schema:description "BSMAP is a short reads mapping software for bisulfite sequencing reads." ;
    schema:downloadUrl "https://github.com/xi11west/bsmap/raw/main/bsmap-2.90.tgz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:bsmap ;
    schema:license "GNU GPL v3" ;
    schema:name "bsmap" ;
    schema:softwareVersion "2.9" ;
    schema:url "https://code.google.com/archive/p/bsmap/" .

