@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-starbiotrek a schema1:SoftwareApplication ;
    schema1:alternateName "StarBioTrek" ;
    schema1:citation "doi:10.1186/s12918-015-0211-x" ;
    schema1:description "This tool StarBioTrek presents some methodologies to measure pathway activity and cross-talk among pathways integrating also the information of network data." ;
    schema1:identifier <https://bio.tools/biotools:starbiotrek> ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-starbiotrek" ;
    schema1:softwareVersion "1.28.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/StarBioTrek.html" .

