@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-starbiotrek a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12918-015-0211-x" ;
    schema:description "StarBioTrek" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/StarBioTrek_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/StarBioTrek/StarBioTrek_1.28.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/StarBioTrek_1.28.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-starbiotrek/bioconductor-starbiotrek_1.28.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-graphite",
        "bioconductor-spidermir",
        "r-base",
        "r-e1071",
        "r-ggplot2",
        "r-igraph",
        "r-mlmetrics",
        "r-reshape2",
        "r-rocr" ;
    schema:identifier biotools:starbiotrek ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-starbiotrek" ;
    schema:softwareVersion "1.28.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/StarBioTrek.html" .

