@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-category a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Category Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Category_2.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Category/Category_2.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Category_2.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-category/bioconductor-category_2.76.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genefilter",
        "bioconductor-graph",
        "bioconductor-gseabase",
        "bioconductor-rbgl",
        "r-base",
        "r-dbi",
        "r-matrix" ;
    schema:identifier biotools:category ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-category" ;
    schema:softwareVersion "2.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Category.html" .

