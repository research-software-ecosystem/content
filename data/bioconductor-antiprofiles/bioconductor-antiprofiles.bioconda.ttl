@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-antiprofiles a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-13-272" ;
    schema:description "Implementation of gene expression anti-profiles" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/antiProfiles_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/antiProfiles/antiProfiles_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/antiProfiles_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-antiprofiles/bioconductor-antiprofiles_1.50.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-locfit",
        "r-matrixstats" ;
    schema:identifier biotools:antiprofiles ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-antiprofiles" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/antiProfiles.html" .

