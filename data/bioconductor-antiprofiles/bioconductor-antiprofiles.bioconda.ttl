@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-antiprofiles a schema1:SoftwareApplication ;
    schema1:alternateName "Implementation of gene expression anti-profiles" ;
    schema1:citation "doi:10.1186/1471-2105-13-272" ;
    schema1:description "Implements gene expression anti-profiles as described in Corrada Bravo et al., BMC Bioinformatics 2012, 13:272 doi:10.1186/1471-2105-13-272." ;
    schema1:identifier biotools:antiprofiles ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-antiprofiles" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/antiProfiles.html" .

