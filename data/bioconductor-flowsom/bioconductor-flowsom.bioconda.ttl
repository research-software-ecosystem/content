@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowsom a schema1:SoftwareApplication ;
    schema1:alternateName "Using self-organizing maps for visualization and interpretation of cytometry data" ;
    schema1:citation "doi:10.1002/cyto.a.22625" ;
    schema1:description "FlowSOM offers visualization options for cytometry data, by using Self-Organizing Map clustering and Minimal Spanning Trees." ;
    schema1:identifier <https://bio.tools/biotools:flowsom> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-flowsom" ;
    schema1:softwareVersion "2.18.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/FlowSOM.html" .

