@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowsom a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1002/cyto.a.22625" ;
    schema1:description "Using self-organizing maps for visualization and interpretation of cytometry data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/FlowSOM_2.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/FlowSOM/FlowSOM_2.18.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/FlowSOM_2.18.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowsom/bioconductor-flowsom_2.18.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-consensusclusterplus",
        "bioconductor-flowcore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-colorramps",
        "r-dplyr",
        "r-ggforce",
        "r-ggnewscale",
        "r-ggplot2",
        "r-ggpubr",
        "r-igraph",
        "r-magrittr",
        "r-rlang",
        "r-rtsne",
        "r-tidyr",
        "r-xml",
        "zlib" ;
    schema1:identifier biotools:flowsom ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-flowsom" ;
    schema1:softwareVersion "2.18.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/FlowSOM.html" .

