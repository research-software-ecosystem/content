@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:phylodeep a schema1:SoftwareApplication ;
    bioschemas:output "csv",
        "png" ;
    schema1:applicationSubCategory edam:topic_0084,
        edam:topic_2269,
        edam:topic_3305,
        edam:topic_3474 ;
    schema1:codeRepository "https://github.com/evolbioinfo/phylodeep" ;
    schema1:dateCreated "2024-09-05" ;
    schema1:description "PhyloDeep is a python library for parameter estimation and model selection from phylogenetic trees, based on deep learning." ;
    schema1:encodingFormat "csv",
        "png" ;
    schema1:featureList edam:operation_0323,
        edam:operation_0326,
        edam:operation_3891,
        edam:operation_3942 ;
    schema1:identifier biotools:phylodeep,
        bioconda:phylodeep ;
    schema1:keywords "Phylogenetics" ;
    schema1:name "phylodeep" ;
    schema1:softwareVersion "0.9" ;
    schema1:url "https://gitlab.pasteur.fr/galaxy-team/galaxy-tools/-/tree/master/tools/phylodeep" .

