@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:rnaz a schema1:SoftwareApplication ;
    schema1:alternateName "Predicting structural noncoding RNAs." ;
    schema1:description "Predicting structural noncoding RNAs." ;
    schema1:identifier biotools:rnaz,
        "usegalaxy-eu:rnaz",
        "usegalaxy-eu:rnaz_annotate",
        "usegalaxy-eu:rnaz_cluster",
        "usegalaxy-eu:rnaz_randomize_aln",
        "usegalaxy-eu:rnaz_select_seqs",
        "usegalaxy-eu:rnaz_window" ;
    schema1:license "MIT-like" ;
    schema1:name "rnaz" ;
    schema1:softwareVersion "2.1.1" ;
    schema1:url "https://github.com/ViennaRNA/RNAz" .

