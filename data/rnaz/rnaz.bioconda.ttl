@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnaz a schema:SoftwareApplication ;
    schema:description "Predicting structural noncoding RNAs." ;
    schema:downloadUrl "https://github.com/ViennaRNA/RNAz/archive/v2.1.1.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:rnaz ;
    schema:license "MIT-like" ;
    schema:name "rnaz" ;
    schema:softwareHelp "https://www.tbi.univie.ac.at/software/RNAz" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "https://github.com/ViennaRNA/RNAz" .

