@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ebarrays a schema:SoftwareApplication ;
    schema:citation "doi:10.1111/j.1541-0420.2006.00611.x" ;
    schema:description "Unified Approach for Simultaneous Gene Clustering and Differential Expression Identification" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EBarrays_2.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBarrays/EBarrays_2.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBarrays_2.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebarrays/bioconductor-ebarrays_2.74.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-lattice",
        "zlib" ;
    schema:identifier biotools:ebarrays ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-ebarrays" ;
    schema:softwareVersion "2.74.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EBarrays.html" .

