@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ebarrays a schema1:SoftwareApplication ;
    schema1:alternateName "Unified Approach for Simultaneous Gene Clustering and Differential Expression Identification" ;
    schema1:citation "doi:10.1111/j.1541-0420.2006.00611.x" ;
    schema1:description "EBarrays provides tools for the analysis of replicated/unreplicated microarray data." ;
    schema1:identifier <https://bio.tools/biotools:ebarrays> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-ebarrays" ;
    schema1:softwareVersion "2.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EBarrays.html" .

