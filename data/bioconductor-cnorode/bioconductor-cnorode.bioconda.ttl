@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cnorode a schema1:SoftwareApplication ;
    schema1:alternateName "ODE add-on to CellNOptR" ;
    schema1:citation "doi:10.1186/1752-0509-6-133" ;
    schema1:description "Logic based ordinary differential equation (ODE) add-on to CellNOptR." ;
    schema1:identifier <https://bio.tools/biotools:cnorode> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-cnorode" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CNORode.html" .

