@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cnorode a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1752-0509-6-133" ;
    schema:description "ODE add-on to CellNOptR" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CNORode_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CNORode/CNORode_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CNORode_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cnorode/bioconductor-cnorode_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-cellnoptr",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-genalg",
        "zlib" ;
    schema:identifier biotools:cnorode ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-cnorode" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CNORode.html" .

