@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ctsge a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx116" ;
    schema:description "Clustering of Time Series Gene Expression data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ctsGE_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ctsGE/ctsGE_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ctsGE_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ctsge/bioconductor-ctsge_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "r-base",
        "r-ccapp",
        "r-ggplot2",
        "r-reshape2",
        "r-shiny",
        "r-stringr" ;
    schema:identifier biotools:ctsge ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ctsge" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ctsGE.html" .

