@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ctsge a schema1:SoftwareApplication ;
    schema1:alternateName "Clustering of Time Series Gene Expression data" ;
    schema1:citation "doi:10.1093/bioinformatics/btx116" ;
    schema1:description "Methodology for supervised clustering of potentially many predictor variables, such as genes etc., in time series datasets Provides functions that help the user assigning genes to predefined set of model profiles." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ctsGE_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ctsGE/ctsGE_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ctsGE_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ctsge/bioconductor-ctsge_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ctsge" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ctsge" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ctsGE.html" .

