@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:htseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btac166",
        "doi:10.1093/bioinformatics/btu638" ;
    schema:description "HTSeq is a Python library to facilitate processing and analysis of data from high-throughput sequencing (HTS) experiments." ;
    schema:downloadUrl "https://pypi.org/packages/source/h/htseq/htseq-2.1.2.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "pysam",
        "python",
        "setuptools",
        "swig" ;
    schema:identifier biotools:htseq ;
    schema:license "GPL-3.0-only" ;
    schema:name "htseq" ;
    schema:softwareHelp "https://htseq.readthedocs.io/en/latest" ;
    schema:softwareVersion "2.1.2" ;
    schema:url "https://github.com/htseq/htseq" .

