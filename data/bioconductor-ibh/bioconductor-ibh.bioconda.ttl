@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ibh a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Interaction Based Homogeneity for Evaluating Gene Lists" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ibh_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ibh/ibh_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ibh_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ibh/bioconductor-ibh_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-simpintlists",
        "r-base" ;
    schema:identifier biotools:ibh ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-ibh" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ibh.html" .

