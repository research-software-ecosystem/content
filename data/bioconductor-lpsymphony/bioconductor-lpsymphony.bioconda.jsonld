  "@id": "bioconda:bioconductor-lpsymphony",
  "@type": "schema1:SoftwareApplication",
  "schema1:alternateName": "Symphony integer linear programming solver in R",
  "schema1:citation": "doi:10.1007/0-387-23529-9_5",
  "schema1:description": "This package was derived from Rsymphony_0.1-17 from CRAN. These packages provide an R interface to SYMPHONY, an open-source linear programming solver written in C++. The main difference between this package and Rsymphony is that it includes the solver source code (SYMPHONY version 5.6), while Rsymphony expects to find header and library files on the users' system. Thus the intention of lpsymphony is to provide an easy to install interface to SYMPHONY. For Windows, precompiled DLLs are included in this package.",
  "schema1:downloadUrl": [
    "https://bioconductor.org/packages/3.22/bioc/src/contrib/lpsymphony_1.38.0.tar.gz",
    "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lpsymphony/lpsymphony_1.38.0.tar.gz",
    "https://bioarchive.galaxyproject.org/lpsymphony_1.38.0.tar.gz",
    "https://depot.galaxyproject.org/software/bioconductor-lpsymphony/bioconductor-lpsymphony_1.38.0_src_all.tar.gz"
  ],
