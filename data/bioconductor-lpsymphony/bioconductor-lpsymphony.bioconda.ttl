@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lpsymphony a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/0-387-23529-9_5" ;
    schema:description "Symphony integer linear programming solver in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/lpsymphony_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lpsymphony/lpsymphony_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/lpsymphony_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lpsymphony/bioconductor-lpsymphony_1.38.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:lpsymphony ;
    schema:license "EPL" ;
    schema:name "bioconductor-lpsymphony" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/lpsymphony.html" .

