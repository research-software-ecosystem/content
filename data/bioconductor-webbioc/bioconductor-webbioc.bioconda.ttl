@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-webbioc a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/0-387-29362-0_18" ;
    schema:description "Bioconductor Web Interface" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/webbioc_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/webbioc/webbioc_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/webbioc_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-webbioc/bioconductor-webbioc_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-annaffy",
        "bioconductor-biobase",
        "bioconductor-gcrma",
        "bioconductor-multtest",
        "bioconductor-qvalue",
        "bioconductor-vsn",
        "r-base",
        "r-biocmanager" ;
    schema:identifier biotools:webbioc ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-webbioc" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/webbioc.html" .

