@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:jvarkit a schema:SoftwareApplication ;
    schema:author "DrYak" ;
    schema:citation "doi:10.6084/m9.figshare.1425030" ;
    schema:description "Java utilities for Bioinformatics." ;
    schema:downloadUrl "https://github.com/lindenb/jvarkit/archive/v2024.08.25.tar.gz" ;
    schema:hasPart "coreutils",
        "gawk",
        "gradle",
        "openjdk" ;
    schema:identifier biotools:jvarkit ;
    schema:license "MIT License" ;
    schema:maintainer "DrYak" ;
    schema:name "jvarkit" ;
    schema:softwareVersion "2024.08.25" ;
    schema:url "https://github.com/lindenb/jvarkit" .

