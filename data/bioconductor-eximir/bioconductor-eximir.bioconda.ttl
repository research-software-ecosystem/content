@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-eximir a schema1:SoftwareApplication ;
    schema1:alternateName "R functions for the normalization of Exiqon miRNA array data" ;
    schema1:citation "doi:10.1186/1756-0500-7-302" ;
    schema1:description "This package contains functions for reading raw data in ImaGene TXT format obtained from Exiqon miRCURY LNA arrays, annotating them with appropriate GAL files, and normalizing them using a spike-in probe-based method. Other platforms and data formats are also supported." ;
    schema1:identifier <https://bio.tools/biotools:eximir> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-eximir" ;
    schema1:softwareVersion "2.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ExiMiR.html" .

