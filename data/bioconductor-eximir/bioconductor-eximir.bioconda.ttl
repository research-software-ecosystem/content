@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-eximir a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1756-0500-7-302" ;
    schema:description "R functions for the normalization of Exiqon miRNA array data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ExiMiR_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ExiMiR/ExiMiR_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ExiMiR_2.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-eximir/bioconductor-eximir_2.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-limma",
        "bioconductor-preprocesscore",
        "r-base" ;
    schema:identifier biotools:eximir ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-eximir" ;
    schema:softwareVersion "2.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ExiMiR.html" .

