@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kallisto a schema:SoftwareApplication ;
    schema:author "mjsteinbaugh" ;
    schema:citation "doi:10.1038/nbt.3519" ;
    schema:description "Quantifying abundances of transcripts from RNA-Seq data, or more generally of target sequences using high-throughput sequencing reads." ;
    schema:downloadUrl "https://github.com/pachterlab/kallisto/archive/refs/tags/v0.52.0.tar.gz" ;
    schema:hasPart "bzip2",
        "hdf5",
        "libcurl",
        "xz",
        "zlib",
        "zlib-ng" ;
    schema:identifier biotools:kallisto ;
    schema:license "BSD-2-Clause" ;
    schema:maintainer "mjsteinbaugh" ;
    schema:name "kallisto" ;
    schema:softwareHelp "https://pachterlab.github.io/kallisto/manual.html" ;
    schema:softwareVersion "0.52.0" ;
    schema:url "https://pachterlab.github.io/kallisto" .

