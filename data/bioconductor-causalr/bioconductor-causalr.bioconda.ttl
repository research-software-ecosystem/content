@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-causalr a schema1:SoftwareApplication ;
    schema1:alternateName "Causal network analysis methods" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Causal network analysis methods for regulator prediction and network reconstruction from genome scale data." ;
    schema1:identifier biotools:causalr ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-causalr" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CausalR.html" .

