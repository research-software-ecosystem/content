@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-causalr a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Causal network analysis methods" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CausalR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CausalR/CausalR_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CausalR_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-causalr/bioconductor-causalr_1.42.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-igraph" ;
    schema:identifier biotools:causalr ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-causalr" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CausalR.html" .

