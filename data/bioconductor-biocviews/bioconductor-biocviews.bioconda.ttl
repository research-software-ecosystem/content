@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biocviews a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Categorized views of R package repositories" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/biocViews_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/biocViews/biocViews_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/biocViews_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocviews/bioconductor-biocviews_1.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "bioconductor-rbgl",
        "r-base",
        "r-biocmanager",
        "r-rcurl",
        "r-runit",
        "r-xml" ;
    schema:identifier biotools:biocviews ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-biocviews" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/biocViews.html" .

