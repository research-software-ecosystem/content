@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-trio a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Testing of SNPs and SNP Interactions in Case-Parent Trio Studies" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/trio_3.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/trio/trio_3.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/trio_3.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-trio/bioconductor-trio_3.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-siggenes",
        "r-base",
        "r-data.table",
        "r-logicreg",
        "r-survival" ;
    schema:identifier biotools:trio ;
    schema:license "LGPL-2" ;
    schema:name "bioconductor-trio" ;
    schema:softwareVersion "3.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/trio.html" .

