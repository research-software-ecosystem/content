@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-trio a schema1:SoftwareApplication ;
    schema1:alternateName "Testing of SNPs and SNP Interactions in Case-Parent Trio Studies" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Testing SNPs and SNP interactions with a genotypic TDT. This package furthermore contains functions for computing pairwise values of LD measures and for identifying LD blocks, as well as functions for setting up matched case pseudo-control genotype data for case-parent trios in order to run trio logic regression, for imputing missing genotypes in trios, for simulating case-parent trios with disease risk dependent on SNP interaction, and for power and sample size calculation in trio data." ;
    schema1:identifier <https://bio.tools/biotools:trio> ;
    schema1:license "LGPL-2" ;
    schema1:name "bioconductor-trio" ;
    schema1:softwareVersion "3.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/trio.html" .

