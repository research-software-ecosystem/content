@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:oakvar a schema:SoftwareApplication ;
    schema:author "rkimoakbioinformatics" ;
    schema:description "OakVar - Genomic Variant Analysis Platform" ;
    schema:downloadUrl "https://pypi.org/packages/source/O/OakVar/oakvar-2.13.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:oakvar ;
    schema:license "AGPL-3.0-or-later" ;
    schema:maintainer "rkimoakbioinformatics" ;
    schema:name "oakvar" ;
    schema:softwareHelp "https://rkimoakbioinformatics.github.io/oakvar" ;
    schema:softwareVersion "2.13.0" ;
    schema:url "https://github.com/rkimoakbioinformatics/oakvar" .

