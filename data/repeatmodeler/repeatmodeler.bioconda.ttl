@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:repeatmodeler a schema:SoftwareApplication ;
    schema:description "RepeatModeler is a de-novo repeat family identification and modeling package." ;
    schema:downloadUrl "https://github.com/Dfam-consortium/RepeatModeler/archive/refs/tags/2.0.8.tar.gz" ;
    schema:hasPart "perl",
        "perl-devel-size",
        "perl-file-which",
        "perl-libwww-perl",
        "perl-lwp-protocol-https",
        "perl-uri",
        "rmblast" ;
    schema:identifier biotools:RepeatModeler ;
    schema:license "Open Software License v2.1" ;
    schema:name "repeatmodeler" ;
    schema:softwareHelp "https://www.repeatmasker.org/RepeatModeler" ;
    schema:softwareVersion "2.0.8" ;
    schema:url "https://www.repeatmasker.org/RepeatModeler" .

