@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:repeatmodeler a schema1:SoftwareApplication ;
    schema1:alternateName "RepeatModeler is a de-novo repeat family identification and modeling package." ;
    schema1:description "RepeatModeler is a de-novo repeat family identification and modeling package." ;
    schema1:downloadUrl "https://github.com/Dfam-consortium/RepeatModeler/archive/refs/tags/2.0.8.tar.gz" ;
    schema1:identifier "biotools:RepeatModeler",
        "usegalaxy-eu:repeatmodeler" ;
    schema1:license "Open Software License v2.1" ;
    schema1:name "repeatmodeler" ;
    schema1:softwareVersion "2.0.8" ;
    schema1:url "https://www.repeatmasker.org/RepeatModeler" .

