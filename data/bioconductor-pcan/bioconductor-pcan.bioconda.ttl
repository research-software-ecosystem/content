@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pcan a schema1:SoftwareApplication ;
    schema1:alternateName "Phenotype Consensus ANalysis (PCAN)" ;
    schema1:description "Phenotypes comparison based on a pathway consensus approach. Assess the relationship between candidate genes and a set of phenotypes based on additional genes related to the candidate (e.g. Pathways or network neighbors)." ;
    schema1:identifier <https://bio.tools/biotools:pcan> ;
    schema1:license "CC BY-NC-ND 4.0" ;
    schema1:name "bioconductor-pcan" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PCAN.html" .

