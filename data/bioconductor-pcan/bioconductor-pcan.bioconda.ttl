@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pcan a schema:SoftwareApplication ;
    schema:description "Phenotype Consensus ANalysis (PCAN)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PCAN_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PCAN/PCAN_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PCAN_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pcan/bioconductor-pcan_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "r-base" ;
    schema:identifier biotools:pcan ;
    schema:license "CC BY-NC-ND 4.0" ;
    schema:name "bioconductor-pcan" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PCAN.html" .

