                            "uri": "http://edamontology.org/format_3752"
                        },
                        {
                            "term": "TSV",
                            "uri": "http://edamontology.org/format_3475"
                        }
                    ]
                }
            ],
            "note": "Input: raw count matrix and sample sheet (CSV/TSV) plus a YAML configuration naming modules, contrasts and thresholds. Output: CSV tables of host-signal fractions and exclusion mask, QC metrics, differential expression per contrast, heritable/environmental decomposition, entropy and pathway/TF activity scores; optional PNG figures from the Python layer.",
            "operation": [
                {
                    "term": "Differential gene expression profiling",
                    "uri": "http://edamontology.org/operation_3223"
                },
