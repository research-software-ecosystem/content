@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ucsc-websync a schema1:SoftwareApplication ;
    schema1:alternateName "download from https server, using files.txt on their end to get the list of files" ;
    schema1:citation "doi:10.1093/bib/bbs038" ;
    schema1:description "download from https server, using files.txt on their end to get the list of files" ;
    schema1:identifier biotools:UCSC_Genome_Browser_Utilities ;
    schema1:license "varies; see http://genome.ucsc.edu/license" ;
    schema1:name "ucsc-websync" ;
    schema1:softwareVersion "469" ;
    schema1:url "http://hgdownload.cse.ucsc.edu/admin/exe/" .

