@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-iterativebma a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2008-9-7-r118" ;
    schema:description "The Iterative Bayesian Model Averaging (BMA) algorithm" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/iterativeBMA_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iterativeBMA/iterativeBMA_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iterativeBMA_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-iterativebma/bioconductor-iterativebma_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-bma",
        "r-leaps" ;
    schema:identifier biotools:iterativebma ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-iterativebma" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/iterativeBMA.html" .

