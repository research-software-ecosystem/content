@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kraken a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2014-15-3-r46" ;
    schema:description "Kraken is a system for assigning taxonomic labels to short DNA sequences, usually obtained through metagenomic studies." ;
    schema:downloadUrl "https://github.com/DerrickWood/kraken/archive/v1.1.1.tar.gz" ;
    schema:hasPart "llvm-openmp",
        "perl" ;
    schema:identifier biotools:kraken ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "kraken" ;
    schema:softwareHelp "https://ccb.jhu.edu/software/kraken" ;
    schema:softwareVersion "1.1.1" ;
    schema:url "https://ccb.jhu.edu/software/kraken" .

