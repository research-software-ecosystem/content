@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-simbindprofiles a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Similar Binding Profiles" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SimBindProfiles_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/SimBindProfiles/SimBindProfiles_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/SimBindProfiles_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-simbindprofiles/bioconductor-simbindprofiles_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-limma",
        "bioconductor-ringo",
        "r-base",
        "r-mclust" ;
    schema:identifier biotools:simbindprofiles ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-simbindprofiles" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/SimBindProfiles.html" .

