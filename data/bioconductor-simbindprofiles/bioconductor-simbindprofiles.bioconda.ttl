@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-simbindprofiles a schema1:SoftwareApplication ;
    schema1:alternateName "Similar Binding Profiles" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "SimBindProfiles identifies common and unique binding regions in genome tiling array data. This package does not rely on peak calling, but directly compares binding profiles processed on the same array platform. It implements a simple threshold approach, thus allowing retrieval of commonly and differentially bound regions between datasets as well as events of compensation and increased binding." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SimBindProfiles_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/SimBindProfiles/SimBindProfiles_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/SimBindProfiles_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-simbindprofiles/bioconductor-simbindprofiles_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:simbindprofiles" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-simbindprofiles" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/SimBindProfiles.html" .

