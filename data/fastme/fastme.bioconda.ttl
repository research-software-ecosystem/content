@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fastme a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/molbev/msv150" ;
    schema:description "a comprehensive, accurate and fast distance-based phylogeny inference program." ;
    schema:downloadUrl "https://gite.lirmm.fr/atgc/FastME/-/archive/v2.1.6.3/FastME-v2.1.6.3.tar.gz" ;
    schema:identifier biotools:fastme ;
    schema:license "GPL-3.0-only" ;
    schema:name "fastme" ;
    schema:softwareHelp "http://www.atgc-montpellier.fr/fastme/usersguide.php" ;
    schema:softwareVersion "2.1.6.3" ;
    schema:url "http://www.atgc-montpellier.fr/fastme/binaries.php" .

