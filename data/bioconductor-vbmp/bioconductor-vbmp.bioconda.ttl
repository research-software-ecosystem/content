@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-vbmp a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm535" ;
    schema:description "Variational Bayesian Multinomial Probit Regression" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/vbmp_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/vbmp/vbmp_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/vbmp_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-vbmp/bioconductor-vbmp_1.78.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:vbmp ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-vbmp" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/vbmp.html" .

