@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-vbmp a schema1:SoftwareApplication ;
    schema1:alternateName "Variational Bayesian Multinomial Probit Regression" ;
    schema1:citation "doi:10.1093/bioinformatics/btm535" ;
    schema1:description "Variational Bayesian Multinomial Probit Regression with Gaussian Process Priors. It estimates class membership posterior probability employing variational and sparse approximation to the full posterior. This software also incorporates feature weighting by means of Automatic Relevance Determination." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/vbmp_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/vbmp/vbmp_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/vbmp_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-vbmp/bioconductor-vbmp_1.78.0_src_all.tar.gz" ;
    schema1:identifier "biotools:vbmp" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-vbmp" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/vbmp.html" .

