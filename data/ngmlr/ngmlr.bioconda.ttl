@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ngmlr a schema1:SoftwareApplication ;
    schema1:alternateName "ngmlr is a long-read mapper designed to align PacBio or Oxford Nanopore reads to a reference genome and optimized for structural variation detection." ;
    schema1:citation "doi:10.1038/s41592-018-0001-7" ;
    schema1:description "ngmlr is a long-read mapper designed to align PacBio or Oxford Nanopore reads to a reference genome and optimized for structural variation detection." ;
    schema1:identifier <https://bio.tools/biotools:ngmlr> ;
    schema1:license "MIT" ;
    schema1:name "ngmlr" ;
    schema1:softwareVersion "0.2.7" ;
    schema1:url "https://github.com/philres/ngmlr" .

