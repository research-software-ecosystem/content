@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ngmlr a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-018-0001-7" ;
    schema:description "ngmlr is a long-read mapper designed to align PacBio or Oxford Nanopore reads to a reference genome and optimized for structural variation detection." ;
    schema:downloadUrl "https://github.com/philres/ngmlr/archive/v0.2.7.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:ngmlr ;
    schema:license "MIT" ;
    schema:name "ngmlr" ;
    schema:softwareHelp "https://github.com/philres/ngmlr/blob/v0.2.7/README.md" ;
    schema:softwareVersion "0.2.7" ;
    schema:url "https://github.com/philres/ngmlr" .

