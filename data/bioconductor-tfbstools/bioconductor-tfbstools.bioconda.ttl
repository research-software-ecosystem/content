@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-tfbstools a schema:SoftwareApplication ;
    schema:description "Software Package for Transcription Factor Binding Site (TFBS) Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/TFBSTools_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TFBSTools/TFBSTools_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TFBSTools_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tfbstools/bioconductor-tfbstools_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-dirichletmultinomial",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-pwalign",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-seqlogo",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-catools",
        "r-dbi",
        "r-gtools",
        "r-rsqlite",
        "r-tfmpvalue",
        "r-xml",
        "zlib" ;
    schema:identifier biotools:tfbstools ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-tfbstools" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/TFBSTools.html" .

