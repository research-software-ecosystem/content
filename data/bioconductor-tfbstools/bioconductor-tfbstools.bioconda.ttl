@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-tfbstools a schema1:SoftwareApplication ;
    schema1:alternateName "Software Package for Transcription Factor Binding Site (TFBS) Analysis" ;
    schema1:description "TFBSTools is a package for the analysis and manipulation of transcription factor binding sites. It includes matrices conversion between Position Frequency Matirx (PFM), Position Weight Matirx (PWM) and Information Content Matrix (ICM). It can also scan putative TFBS from sequence/alignment, query JASPAR database and provides a wrapper of de novo motif discovery software." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/TFBSTools_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TFBSTools/TFBSTools_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TFBSTools_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-tfbstools/bioconductor-tfbstools_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:tfbstools" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-tfbstools" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/TFBSTools.html" .

