@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:plink a schema1:SoftwareApplication ;
    bioschemas:output "pbed",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_3517 ;
    schema1:codeRepository "https://www.cog-genomics.org/plink" ;
    schema1:dateCreated "2020-09-14" ;
    schema1:description "Whole genome association analysis toolset, designed to perform a range of basic, large-scale analyses in a computationally efficient manner." ;
    schema1:encodingFormat "pbed",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_3197 ;
    schema1:identifier biotools:plink,
        bioconda:plink ;
    schema1:keywords "Genome-Wide Association Study" ;
    schema1:name "plink" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/plink" .

