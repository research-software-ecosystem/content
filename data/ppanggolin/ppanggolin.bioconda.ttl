@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ppanggolin a schema:SoftwareApplication ;
    schema:author "JeanMainguy",
        "axbazin",
        "jpjarnoux" ;
    schema:citation "doi:10.1101/836239" ;
    schema:description "PPanGGOLiN: Depicting microbial species diversity via a Partitioned PanGenome Graph." ;
    schema:downloadUrl "https://github.com/labgem/PPanGGOLiN/archive/2.3.0.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python",
        "setuptools-scm" ;
    schema:identifier biotools:PPanGGOLiN ;
    schema:license "CeCiLL-2.1" ;
    schema:maintainer "JeanMainguy",
        "axbazin",
        "jpjarnoux" ;
    schema:name "ppanggolin" ;
    schema:softwareHelp "https://ppanggolin.readthedocs.io" ;
    schema:softwareVersion "2.3.0" ;
    schema:url "https://github.com/labgem/PPanGGOLiN" .

