@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rsubread a schema:SoftwareApplication ;
    schema:description "Mapping, quantification and variant analysis of sequencing data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Rsubread_2.24.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rsubread/Rsubread_2.24.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rsubread_2.24.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rsubread/bioconductor-rsubread_2.24.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "zlib" ;
    schema:identifier biotools:rsubread ;
    schema:license "GPL (>=3)" ;
    schema:name "bioconductor-rsubread" ;
    schema:softwareVersion "2.24.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Rsubread.html" .

