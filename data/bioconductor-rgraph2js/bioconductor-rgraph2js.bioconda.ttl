@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgraph2js a schema1:SoftwareApplication ;
    schema1:alternateName "Convert a Graph into a D3js Script" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Generator of web pages which display interactive network/graph visualizations with D3js, jQuery and Raphael." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RGraph2js_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RGraph2js/RGraph2js_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RGraph2js_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgraph2js/bioconductor-rgraph2js_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rgraph2js" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-rgraph2js" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RGraph2js.html" .

