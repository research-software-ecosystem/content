@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cortex_con a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ng.1028" ;
    schema:description "cortex_con (primary contact Mario Caccamo) is for consensus genome assembly" ;
    schema:downloadUrl "https://sourceforge.net/projects/cortexassembler/files/cortex_con/cortex_con_beta_0.04c.zip" ;
    schema:identifier biotools:cortex ;
    schema:license "GPL3" ;
    schema:name "cortex_con" ;
    schema:softwareVersion "0.04c" ;
    schema:url "http://cortexassembler.sourceforge.net/index.html" .

