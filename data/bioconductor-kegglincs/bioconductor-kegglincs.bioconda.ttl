@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-kegglincs a schema1:SoftwareApplication ;
    schema1:alternateName "Visualize all edges within a KEGG pathway and overlay LINCS data" ;
    schema1:citation "doi:10.7490/f1000research.1113436.1" ;
    schema1:description "See what is going on 'under the hood' of KEGG pathways by explicitly re-creating the pathway maps from information obtained from KGML files." ;
    schema1:identifier biotools:kegglincs ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-kegglincs" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/KEGGlincs.html" .

