@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-kegglincs a schema:SoftwareApplication ;
    schema:citation "doi:10.7490/f1000research.1113436.1" ;
    schema:description "Visualize all edges within a KEGG pathway and overlay LINCS data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/KEGGlincs_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/KEGGlincs/KEGGlincs_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/KEGGlincs_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-kegglincs/bioconductor-kegglincs_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-hgu133a.db",
        "bioconductor-kegggraph",
        "bioconductor-keggrest",
        "bioconductor-kodata",
        "bioconductor-org.hs.eg.db",
        "cytoscape",
        "r-base",
        "r-gtools",
        "r-httr",
        "r-igraph",
        "r-plyr",
        "r-rjsonio",
        "r-xml" ;
    schema:identifier biotools:kegglincs ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-kegglincs" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/KEGGlincs.html" .

