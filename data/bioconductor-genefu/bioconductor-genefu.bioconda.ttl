@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genefu a schema1:SoftwareApplication ;
    schema1:alternateName "Computation of Gene Expression-Based Signatures in Breast Cancer" ;
    schema1:citation "doi:10.1093/bioinformatics/btv693" ;
    schema1:description "This package contains functions implementing various tasks usually required by gene expression analysis, especially in breast cancer studies: gene mapping between different microarray platforms, identification of molecular subtypes, implementation of published gene signatures, gene selection, and survival analysis." ;
    schema1:identifier <https://bio.tools/biotools:genefu> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genefu" ;
    schema1:softwareVersion "2.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/genefu.html" .

