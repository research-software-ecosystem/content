@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genefu a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv693" ;
    schema:description "Computation of Gene Expression-Based Signatures in Breast Cancer" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/genefu_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/genefu/genefu_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/genefu_2.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genefu/bioconductor-genefu_2.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-aims",
        "bioconductor-biomart",
        "bioconductor-impute",
        "bioconductor-limma",
        "bioconductor-survcomp",
        "r-amap",
        "r-base",
        "r-ic10",
        "r-ic10trainingdata",
        "r-mclust" ;
    schema:identifier biotools:genefu ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genefu" ;
    schema:softwareVersion "2.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/genefu.html" .

