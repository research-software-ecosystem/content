@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowbeads a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "flowBeads: Analysis of flow bead data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowBeads_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowBeads/flowBeads_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowBeads_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowbeads/bioconductor-flowbeads_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-flowcore",
        "r-base",
        "r-knitr",
        "r-rrcov",
        "r-xtable" ;
    schema:identifier biotools:flowbeads ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-flowbeads" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowBeads.html" .

