@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:igdiscover a schema:SoftwareApplication ;
    schema:author "marcelm" ;
    schema:citation "doi:10.1038/ncomms13642" ;
    schema:description "Analyze antibody repertoires and discover new V genes" ;
    schema:downloadUrl "https://pypi.io/packages/source/i/igdiscover/igdiscover-0.15.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools_scm" ;
    schema:identifier biotools:igdiscover ;
    schema:license "MIT" ;
    schema:maintainer "marcelm" ;
    schema:name "igdiscover" ;
    schema:softwareVersion "0.15.1" ;
    schema:url "https://igdiscover.se/" .

