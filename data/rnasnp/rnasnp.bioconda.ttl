@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:rnasnp a schema1:SoftwareApplication ;
    schema1:alternateName "Efficient detection of local RNA secondary structure changes induced by SNPs." ;
    schema1:description "Efficient detection of local RNA secondary structure changes induced by SNPs." ;
    schema1:identifier <https://bio.tools/biotools:rnasnp> ;
    schema1:license "RTH" ;
    schema1:name "rnasnp" ;
    schema1:softwareVersion "1.2" ;
    schema1:url "http://rth.dk/resources/rnasnp/software" .

