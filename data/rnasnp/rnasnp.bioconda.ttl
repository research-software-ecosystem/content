@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnasnp a schema:SoftwareApplication ;
    schema:description "Efficient detection of local RNA secondary structure changes induced by SNPs." ;
    schema:downloadUrl "http://rth.dk/resources/rnasnp/software_src/RNAsnp-1.2.tar.gz" ;
    schema:identifier biotools:rnasnp ;
    schema:license "RTH" ;
    schema:name "rnasnp" ;
    schema:softwareVersion "1.2" ;
    schema:url "http://rth.dk/resources/rnasnp/software" .

