@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:haptools a schema:SoftwareApplication ;
    schema:author "aryarm" ;
    schema:citation "doi:10.1093/bioinformatics/btad104" ;
    schema:description "Ancestry and haplotype aware simulation of genotypes and phenotypes for complex trait analysis" ;
    schema:downloadUrl "https://pypi.io/packages/source/h/haptools/haptools-0.6.2.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "python" ;
    schema:identifier biotools:haptools ;
    schema:license "MIT" ;
    schema:maintainer "aryarm" ;
    schema:name "haptools" ;
    schema:softwareHelp "https://haptools.readthedocs.io" ;
    schema:softwareVersion "0.6.2" ;
    schema:url "https://github.com/cast-genomics/haptools" .

