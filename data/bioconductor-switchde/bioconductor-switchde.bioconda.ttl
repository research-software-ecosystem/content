@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-switchde a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw798" ;
    schema:description "Switch-like differential expression across single-cell trajectories" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/switchde_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/switchde/switchde_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/switchde_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-switchde/bioconductor-switchde_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-singlecellexperiment",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-dplyr",
        "r-ggplot2" ;
    schema:identifier biotools:switchde ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-switchde" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/switchde.html" .

