@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-switchde a schema1:SoftwareApplication ;
    schema1:alternateName "Switch-like differential expression across single-cell trajectories" ;
    schema1:citation "doi:10.1093/bioinformatics/btw798" ;
    schema1:description "Inference and detection of switch-like differential expression across single-cell RNA-seq trajectories." ;
    schema1:identifier <https://bio.tools/biotools:switchde> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-switchde" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/switchde.html" .

