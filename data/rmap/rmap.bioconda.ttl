@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rmap a schema:SoftwareApplication ;
    schema:description "rmap is a short reads mapper for next-generation sequencing data" ;
    schema:downloadUrl "http://smithlabresearch.org/downloads/rmap-2.1.tar.bz2" ;
    schema:identifier biotools:rmap ;
    schema:license "GNU General Public License v3 (GPLv3)" ;
    schema:name "rmap" ;
    schema:softwareVersion "2.1" ;
    schema:url "http://smithlabresearch.org/software/rmap/" .

