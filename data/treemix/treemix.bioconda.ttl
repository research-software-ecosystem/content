@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:treemix a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pgen.1002967" ;
    schema:description "TreeMix is a method for inferring the patterns of population splits and mixtures in the history of a set of populations." ;
    schema:downloadUrl "https://bitbucket.org/nygcresearch/treemix/downloads/treemix-1.13.tar.gz" ;
    schema:hasPart "boost-cpp",
        "gsl",
        "libcblas",
        "zlib" ;
    schema:identifier biotools:TreeMix ;
    schema:license "GPLv3" ;
    schema:name "treemix" ;
    schema:softwareVersion "1.13" ;
    schema:url "http://pritchardlab.stanford.edu/software.html" .

