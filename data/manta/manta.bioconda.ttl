@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:manta a schema:SoftwareApplication ;
    schema:description "Structural variant and indel caller for mapped sequencing data" ;
    schema:downloadUrl "https://github.com/Illumina/manta/releases/download/v1.6.0/manta-1.6.0.release_src.tar.bz2" ;
    schema:hasPart "boost-cpp",
        "python" ;
    schema:identifier biotools:Manta9235 ;
    schema:license "GPL-3.0-only" ;
    schema:name "manta" ;
    schema:softwareVersion "1.6.0" ;
    schema:url "https://github.com/Illumina/manta" .

