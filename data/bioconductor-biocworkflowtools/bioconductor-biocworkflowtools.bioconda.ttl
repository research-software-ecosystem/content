@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biocworkflowtools a schema1:SoftwareApplication ;
    schema1:alternateName "Tools to aid the development of Bioconductor Workflow packages" ;
    schema1:description "Provides functions to ease the transition between Rmarkdown and LaTeX documents when authoring a Bioconductor Workflow." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/BiocWorkflowTools_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocWorkflowTools/BiocWorkflowTools_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiocWorkflowTools_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocworkflowtools/bioconductor-biocworkflowtools_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:BiocWorkflowTools" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-biocworkflowtools" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BiocWorkflowTools.html" .

