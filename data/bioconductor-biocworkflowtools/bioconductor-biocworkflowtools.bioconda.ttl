@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biocworkflowtools a schema:SoftwareApplication ;
    schema:description "Tools to aid the development of Bioconductor Workflow packages" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BiocWorkflowTools_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BiocWorkflowTools/BiocWorkflowTools_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BiocWorkflowTools_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biocworkflowtools/bioconductor-biocworkflowtools_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocstyle",
        "r-base",
        "r-bookdown",
        "r-git2r",
        "r-httr",
        "r-knitr",
        "r-rmarkdown",
        "r-rstudioapi",
        "r-stringr",
        "r-usethis" ;
    schema:identifier biotools:BiocWorkflowTools ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-biocworkflowtools" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BiocWorkflowTools.html" .

