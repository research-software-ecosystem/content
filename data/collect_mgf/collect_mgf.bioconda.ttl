@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:collect_mgf a schema:SoftwareApplication ;
    schema:description "Collects MGF files and dd_results from an XMass setup_QDD.tcl experiment to a single MGF file." ;
    schema:downloadUrl "http://www.ms-utils.org/collect_mgf.c" ;
    schema:identifier biotools:collect_mgf ;
    schema:license "GPL-3.0" ;
    schema:name "collect_mgf" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://www.ms-utils.org/collect_mgf.c" .

