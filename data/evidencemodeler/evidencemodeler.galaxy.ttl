@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:evidencemodeler a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "gff" ;
    schema1:applicationSubCategory edam:topic_0114,
        edam:topic_0203 ;
    schema1:codeRepository <https://github.com/EVidenceModeler/EVidenceModeler?tab=readme-ov-file> ;
    schema1:dateCreated "2024-07-19" ;
    schema1:description "EVidenceModeler (EVM) combines ab intio genetic predictions with protein and transcript alignments in weighted consensus genetic structures." ;
    schema1:encodingFormat "fasta",
        "gff" ;
    schema1:featureList edam:operation_2454 ;
    schema1:identifier biotools:EvidenceModeler,
        bioconda:evidencemodeler ;
    schema1:isPartOf <https://usegalaxy.eu> ;
    schema1:keywords "Genome annotation" ;
    schema1:name "evidencemodeler" ;
    schema1:softwareVersion "2.1.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/evidencemodeler> .

<https://usegalaxy.eu> a schema1:WebSite .

