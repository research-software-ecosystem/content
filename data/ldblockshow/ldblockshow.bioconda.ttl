@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ldblockshow a schema:SoftwareApplication ;
    schema:description "A tool for showing linkage disequilibrium heatmaps from variant call format (VCF) files." ;
    schema:downloadUrl "https://github.com/BGI-shenzhen/LDBlockShow/archive/v1.41.tar.gz" ;
    schema:hasPart "perl",
        "zlib" ;
    schema:identifier biotools:ldblockshow ;
    schema:license "MIT" ;
    schema:name "ldblockshow" ;
    schema:softwareVersion "1.41" ;
    schema:url "https://github.com/BGI-shenzhen/LDBlockShow" .

