@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chromheatmap a schema1:SoftwareApplication ;
    schema1:alternateName "Heat map plotting by genome coordinate" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The ChromHeatMap package can be used to plot genome-wide data (e.g. expression, CGH, SNP) along each strand of a given chromosome as a heat map. The generated heat map can be used to interactively identify probes and genes of interest." ;
    schema1:identifier <https://bio.tools/biotools:chromheatmap> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-chromheatmap" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ChromHeatMap.html" .

