@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:fastqc a schema1:SoftwareApplication ;
    schema1:alternateName "A quality control tool for high throughput sequence data." ;
    schema1:description "A quality control tool for high throughput sequence data." ;
    schema1:identifier <https://bio.tools/biotools:fastqc>,
        "usegalaxy-eu:fastqc" ;
    schema1:license "GPL >=3" ;
    schema1:name "fastqc" ;
    schema1:softwareVersion "0.12.1" ;
    schema1:url "http://www.bioinformatics.babraham.ac.uk/projects/fastqc/" .

