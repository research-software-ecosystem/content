@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fastqc a schema:SoftwareApplication ;
    schema:description "A quality control tool for high throughput sequence data." ;
    schema:downloadUrl "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v0.12.1.zip" ;
    schema:identifier biotools:fastqc ;
    schema:license "GPL >=3" ;
    schema:name "fastqc" ;
    schema:softwareVersion "0.12.1" ;
    schema:url "http://www.bioinformatics.babraham.ac.uk/projects/fastqc/" .

