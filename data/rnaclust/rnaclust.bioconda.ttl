@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:rnaclust a schema:SoftwareApplication ;
    schema:author "pvanheus" ;
    schema:description "A tool for clustering of RNAs based on their secondary structures using LocARNA" ;
    schema:downloadUrl "http://www.bioinf.uni-leipzig.de/~kristin/Software/RNAclust/RNAclust-1.3.tar.gz" ;
    schema:hasPart "locarna",
        "viennarna" ;
    schema:identifier biotools:RNAclust ;
    schema:license "GPL-2.0" ;
    schema:maintainer "pvanheus" ;
    schema:name "rnaclust" ;
    schema:softwareVersion "1.3" ;
    schema:url "http://www.bioinf.uni-leipzig.de/~kristin/Software/RNAclust/" .

