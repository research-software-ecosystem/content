@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-kcsmart a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1756-0500-3-298" ;
    schema:description "Multi sample aCGH analysis package using kernel convolution" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/KCsmart_2.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/KCsmart/KCsmart_2.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/KCsmart_2.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-kcsmart/bioconductor-kcsmart_2.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-multtest",
        "bioconductor-siggenes",
        "r-base",
        "r-kernsmooth" ;
    schema:identifier biotools:kcsmart ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-kcsmart" ;
    schema:softwareVersion "2.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/KCsmart.html" .

