@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chromvar a schema1:SoftwareApplication ;
    schema1:alternateName "Chromatin Variation Across Regions" ;
    schema1:citation "doi:10.1038/nmeth.4401" ;
    schema1:description "Determine variation in chromatin accessibility across sets of annotations or peaks. Designed primarily for single-cell or sparse chromatin accessibility data, e.g. from scATAC-seq or sparse bulk ATAC or DNAse-seq experiments." ;
    schema1:identifier biotools:chromvar ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-chromvar" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/chromVAR.html" .

