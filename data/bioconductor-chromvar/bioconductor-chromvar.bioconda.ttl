@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chromvar a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.4401" ;
    schema1:description "Chromatin Variation Across Regions" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/chromVAR_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/chromVAR/chromVAR_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/chromVAR_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chromvar/bioconductor-chromvar_1.32.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-tfbstools",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dt",
        "r-ggplot2",
        "r-matrix",
        "r-miniui",
        "r-nabor",
        "r-plotly",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-rtsne",
        "r-shiny",
        "zlib" ;
    schema1:identifier biotools:chromvar ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-chromvar" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/chromVAR.html" .

