@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-seqlogo a schema1:SoftwareApplication ;
    schema1:alternateName "Sequence logos for DNA sequence alignments" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "seqLogo takes the position weight matrix of a DNA sequence motif and plots the corresponding sequence logo as introduced by Schneider and Stephens (1990)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/seqLogo_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/seqLogo/seqLogo_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/seqLogo_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-seqlogo/bioconductor-seqlogo_1.76.0_src_all.tar.gz" ;
    schema1:identifier "biotools:seqlogo" ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-seqlogo" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/seqLogo.html" .

