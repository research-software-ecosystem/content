@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-seqlogo a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Sequence logos for DNA sequence alignments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/seqLogo_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/seqLogo/seqLogo_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/seqLogo_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-seqlogo/bioconductor-seqlogo_1.76.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:seqlogo ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-seqlogo" ;
    schema:softwareVersion "1.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/seqLogo.html" .

