@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:beagle-lib a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/sysbio/syr100" ;
    schema:description "A general purpose library for evaluating the likelihood of sequence evolution on phylogenetic trees." ;
    schema:downloadUrl "https://github.com/beagle-dev/beagle-lib/archive/v4.0.1.tar.gz" ;
    schema:hasPart "openjdk" ;
    schema:identifier biotools:beagle-lib ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "beagle-lib" ;
    schema:softwareHelp "https://github.com/beagle-dev/beagle-lib/blob/v4.0.1/README.md" ;
    schema:softwareVersion "4.0.1" ;
    schema:url "https://github.com/beagle-dev/beagle-lib" .

