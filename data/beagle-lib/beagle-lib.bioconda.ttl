@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:beagle-lib a schema1:SoftwareApplication ;
    schema1:alternateName "A general purpose library for evaluating the likelihood of sequence evolution on phylogenetic trees." ;
