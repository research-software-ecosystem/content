@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-topgo a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btl140" ;
    schema1:description "Enrichment Analysis for Gene Ontology" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/topGO_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/topGO/topGO_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/topGO_2.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-topgo/bioconductor-topgo_2.62.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-go.db",
        "bioconductor-graph",
        "r-base",
        "r-dbi",
        "r-lattice",
        "r-matrixstats",
        "r-sparsem" ;
    schema1:identifier biotools:topgo ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-topgo" ;
    schema1:softwareVersion "2.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/topGO.html" .

