@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tedna a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu365" ;
    schema:description "Tedna is a lightweight de novo transposable element assembler." ;
    schema:downloadUrl "https://github.com/mzytnicki/tedna/archive/refs/tags/1.3.1.tar.gz" ;
    schema:hasPart "sparsehash" ;
    schema:identifier biotools:tedna ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "tedna" ;
    schema:softwareHelp "https://github.com/mzytnicki/tedna/blob/1.3.1/README.md" ;
    schema:softwareVersion "1.3.1" ;
    schema:url "https://github.com/mzytnicki/tedna" .

