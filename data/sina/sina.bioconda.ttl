@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sina a schema:SoftwareApplication ;
    schema:author "epruesse" ;
    schema:citation "doi:10.1093/bioinformatics/bts252" ;
    schema:description "Reference based multiple sequence alignment" ;
    schema:downloadUrl "https://github.com/epruesse/SINA/releases/download/v1.7.2/sina-1.7.2.tar.gz" ;
    schema:hasPart "arb-bio-devel",
        "boost-cpp",
        "glib",
        "tbb-devel",
        "zlib" ;
    schema:identifier biotools:SINA ;
    schema:license "GPLv3" ;
    schema:maintainer "epruesse" ;
    schema:name "sina" ;
    schema:softwareHelp "https://sina.readthedocs.io" ;
    schema:softwareVersion "1.7.2" ;
    schema:url "https://github.com/epruesse/SINA" .

