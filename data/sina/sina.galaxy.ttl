@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:sina a schema1:SoftwareApplication ;
    bioschemas:output "data",
        "fasta",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:data_3028,
        edam:operation_2403,
        edam:operation_2481,
        edam:topic_0080,
        edam:topic_0097,
        edam:topic_0099,
        edam:topic_0637,
        edam:topic_3168 ;
    schema1:codeRepository <https://sina.readthedocs.io/en/latest/> ;
    schema1:dateCreated "2019-10-11" ;
    schema1:description "SINA reference based multiple sequence alignment" ;
    schema1:encodingFormat "data",
        "fasta",
        "tabular",
        "txt" ;
    schema1:featureList edam:data_1872,
        edam:operation_0258,
        edam:operation_0294,
        edam:operation_0492,
        edam:operation_3460 ;
    schema1:identifier biotools:sina,
        bioconda:sina ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "sina" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/sina> .

