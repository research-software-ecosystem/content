@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dexseq a schema:SoftwareApplication ;
    schema:description "Inference of differential exon usage in RNA-Seq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DEXSeq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DEXSeq/DEXSeq_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DEXSeq_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dexseq/bioconductor-dexseq_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biomart",
        "bioconductor-deseq2",
        "bioconductor-genefilter",
        "bioconductor-geneplotter",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-hwriter",
        "r-rcolorbrewer",
        "r-statmod",
        "r-stringr" ;
    schema:identifier biotools:dexseq ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-dexseq" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DEXSeq.html" .

