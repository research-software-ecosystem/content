@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genomicinteractions a schema1:SoftwareApplication ;
    schema1:alternateName "Utilities for handling genomic interaction data" ;
    schema1:citation "doi:10.1186/s12864-015-2140-x" ;
    schema1:description "Utilities for handling genomic interaction data such as ChIA-PET or Hi-C, annotating genomic features with interaction information, and producing plots and summary statistics." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GenomicInteractions_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicInteractions/GenomicInteractions_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicInteractions_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomicinteractions/bioconductor-genomicinteractions_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genomicinteractions" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-genomicinteractions" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicInteractions.html" .

