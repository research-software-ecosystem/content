@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyani a schema:SoftwareApplication ;
    schema:citation "doi:10.1039/C5AY02550H" ;
    schema:description "pyani provides a package and script for calculation of genome-scale average nucleotide identity." ;
    schema:downloadUrl "https://github.com/widdowquinn/pyani/archive/v0.2.13.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:pyani ;
    schema:license "MIT" ;
    schema:name "pyani" ;
    schema:softwareHelp "https://widdowquinn.github.io/pyani" ;
    schema:softwareVersion "0.2.13.1" ;
    schema:url "https://github.com/widdowquinn/pyani" .

