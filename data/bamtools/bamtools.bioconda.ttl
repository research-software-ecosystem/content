@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bamtools a schema:SoftwareApplication ;
    schema:description "C++ API & command-line toolkit for working with BAM data." ;
    schema:downloadUrl "https://github.com/pezmaster31/bamtools/archive/v2.5.3.tar.gz" ;
    schema:hasPart "jsoncpp",
        "zlib" ;
    schema:identifier biotools:bamtools ;
    schema:license "MIT" ;
    schema:name "bamtools" ;
    schema:softwareHelp "https://github.com/pezmaster31/bamtools/wiki" ;
    schema:softwareVersion "2.5.3" ;
    schema:url "https://github.com/pezmaster31/bamtools" .

