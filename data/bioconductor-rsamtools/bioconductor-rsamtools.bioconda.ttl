@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rsamtools a schema1:SoftwareApplication ;
    schema1:alternateName "Binary alignment (BAM), FASTA, variant call (BCF), and tabix file import" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package provides an interface to the 'samtools', 'bcftools', and 'tabix' utilities for manipulating SAM (Sequence Alignment / Map), FASTA, binary variant call (BCF) and compressed indexed tab-delimited (tabix) files." ;
    schema1:identifier biotools:rsamtools ;
    schema1:license "Artistic-2.0 | file LICENSE" ;
    schema1:name "bioconductor-rsamtools" ;
    schema1:softwareVersion "2.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Rsamtools.html" .

