@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rsamtools a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Binary alignment (BAM), FASTA, variant call (BCF), and tabix file import" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Rsamtools_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rsamtools/Rsamtools_2.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rsamtools_2.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rsamtools/bioconductor-rsamtools_2.26.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rhtslib",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bitops",
        "zlib" ;
    schema:identifier biotools:rsamtools ;
    schema:license "Artistic-2.0 | file LICENSE" ;
    schema:name "bioconductor-rsamtools" ;
    schema:softwareVersion "2.26.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Rsamtools.html" .

