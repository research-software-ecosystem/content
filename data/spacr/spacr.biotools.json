  "function": [
    {
      "cmd": "spacr-run mask --settings settings.csv ; spacr-run measure --settings settings.csv",
      "input": [
        {
          "data": {
            "term": "Raw image",
            "uri": "http://edamontology.org/data_3424"
          },
          "format": [
            {
              "term": "PNG",
              "uri": "http://edamontology.org/format_3603"
            },
            {
              "term": "OME-TIFF",
              "uri": "http://edamontology.org/format_3727"
            },
            {
              "term": "TIFF",
              "uri": "http://edamontology.org/format_3591"
            }
          ]
        }
      ],
      "note": "Mask and Measure modules: Cellpose segmentation of cells, nuclei, pathogens and organelles, followed by morphology, intensity, texture, spatial and colocalization measurement of every object into a SQLite project, with object crops.",
      "operation": [
        {
          "term": "Quantification",
          "uri": "http://edamontology.org/operation_3799"
        },
        {
          "term": "Feature extraction",
          "uri": "http://edamontology.org/operation_3937"
        },
        {
          "term": "Image analysis",
          "uri": "http://edamontology.org/operation_3443"
        }
      ],
      "output": [
        {
          "data": {
            "term": "Image",
            "uri": "http://edamontology.org/data_2968"
          },
          "format": [
            {
              "term": "PNG",
              "uri": "http://edamontology.org/format_3603"
            },
            {
              "term": "TIFF",
              "uri": "http://edamontology.org/format_3591"
            }
          ]
        },
        {
          "data": {
            "term": "Matrix",
            "uri": "http://edamontology.org/data_2082"
          },
          "format": [
            {
              "term": "CSV",
              "uri": "http://edamontology.org/format_3752"
            },
            {
              "term": "SQLite format",
              "uri": "http://edamontology.org/format_3621"
            }
          ]
        }
      ]
    },
    {
      "cmd": "spacr-run classify --settings settings.csv",
      "input": [
        {
          "data": {
            "term": "Image",
            "uri": "http://edamontology.org/data_2968"
          },
          "format": [
            {
              "term": "PNG",
              "uri": "http://edamontology.org/format_3603"
            },
            {
              "term": "TIFF",
              "uri": "http://edamontology.org/format_3591"
            }
          ]
        }
      ],
      "note": "Annotate and Classify modules: keyboard-driven labelling of object crops with active-learning queues, then training of image or measurement-based classifiers, with held-out performance recorded alongside each checkpoint.",
      "operation": [
        {
          "term": "Image annotation",
          "uri": "http://edamontology.org/operation_3553"
        },
        {
          "term": "Classification",
          "uri": "http://edamontology.org/operation_2990"
        }
      ],
      "output": [
        {
          "data": {
            "term": "Score",
            "uri": "http://edamontology.org/data_1772"
          },
          "format": [
            {
              "term": "CSV",
              "uri": "http://edamontology.org/format_3752"
            },
            {
              "term": "SQLite format",
              "uri": "http://edamontology.org/format_3621"
            }
          ]
        }
      ]
    },
    {
      "cmd": "spacr-run map_barcodes --settings settings.csv",
      "input": [
        {
          "data": {
            "term": "Nucleic acid sequence",
            "uri": "http://edamontology.org/data_2977"
          },
          "format": [
            {
              "term": "FASTQ",
              "uri": "http://edamontology.org/format_1930"
            }
          ]
        }
      ],
      "note": "Map Barcodes module: assigns sequencing reads to plate wells and to gRNA barcodes, and reports per-well guide abundance with collision and coverage QC.",
      "operation": [
        {
          "term": "Genotyping",
          "uri": "http://edamontology.org/operation_3196"
        },
        {
          "term": "Read mapping",
          "uri": "http://edamontology.org/operation_3198"
        },
        {
          "term": "Demultiplexing",
          "uri": "http://edamontology.org/operation_3933"
        }
      ],
      "output": [
        {
          "data": {
            "term": "Matrix",
            "uri": "http://edamontology.org/data_2082"
          },
          "format": [
            {
              "term": "CSV",
              "uri": "http://edamontology.org/format_3752"
            },
            {
              "term": "SQLite format",
              "uri": "http://edamontology.org/format_3621"
            }
          ]
        }
      ]
    },
    {
      "cmd": "spacr-run regression --settings settings.csv",
      "input": [
        {
          "data": {
            "term": "Matrix",
            "uri": "http://edamontology.org/data_2082"
          },
          "format": [
            {
              "term": "CSV",
              "uri": "http://edamontology.org/format_3752"
            },
            {
              "term": "SQLite format",
              "uri": "http://edamontology.org/format_3621"
            }
          ]
        }
      ],
      "note": "Regression module: estimates guide, gene, condition and control effects with model families suited to continuous, fractional and count responses, and returns a ranked gene-level hit list.",
      "operation": [
        {
          "term": "Regression analysis",
          "uri": "http://edamontology.org/operation_3659"
        },
        {
          "term": "Statistical inference",
          "uri": "http://edamontology.org/operation_3658"
        }
      ],
      "output": [
        {
          "data": {
            "term": "Genotype/phenotype report",
            "uri": "http://edamontology.org/data_0920"
          },
          "format": [
            {
              "term": "CSV",
              "uri": "http://edamontology.org/format_3752"
            }
          ]
        }
      ]
    },
