@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:miniprot a schema1:SoftwareApplication ;
    schema1:alternateName "Miniprot aligns a protein sequence against a genome with affine gap penalty, splicing and frameshift. It is primarily intended for annotating protein-coding genes in a new species using known genes from other species." ;
    schema1:citation "doi:10.1093/bioinformatics/btad014" ;
    schema1:description "Miniprot aligns a protein sequence against a genome with affine gap penalty, splicing and frameshift. It is primarily intended for annotating protein-coding genes in a new species using known genes from other species." ;
    schema1:identifier <https://bio.tools/biotools:miniprot>,
        "usegalaxy-eu:miniprot",
        "usegalaxy-eu:miniprot_index" ;
    schema1:license "MIT" ;
    schema1:name "miniprot" ;
    schema1:softwareVersion "0.18" ;
    schema1:url "https://github.com/lh3/miniprot" .

