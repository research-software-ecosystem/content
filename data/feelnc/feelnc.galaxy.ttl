@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:feelnc a schema1:SoftwareApplication ;
    bioschemas:output "gtf",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0659 ;
    schema1:codeRepository <https://github.com/tderrien/FEELnc> ;
    schema1:dateCreated "2018-03-27" ;
    schema1:description "Galaxy wrapper for FEELnc" ;
    schema1:encodingFormat "gtf",
        "txt" ;
    schema1:featureList edam:data_2018,
        edam:operation_0226,
        edam:operation_2990,
        edam:topic_2230 ;
    schema1:identifier biotools:feelnc,
        bioconda:feelnc ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au>,
        <https://workflowhub.eu/workflows/1324?version=1>,
        <https://workflowhub.eu/workflows/1484?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "feelnc" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/feelnc> .

