@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:isaac4 a schema:SoftwareApplication ;
    schema:author "cbrueffer" ;
    schema:citation "doi:10.1093/bioinformatics/btt314" ;
    schema:description "Ultra-fast whole-genome alignment for Illumina sequencing platforms." ;
    schema:downloadUrl "https://github.com/Illumina/Isaac4/archive/Isaac-04.18.11.09.tar.gz" ;
    schema:hasPart "boost-cpp",
        "libxml2",
        "libxslt",
        "markdown",
        "zlib" ;
    schema:identifier biotools:isaac ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "cbrueffer" ;
    schema:name "isaac4" ;
    schema:softwareVersion "04.18.11.09" ;
    schema:url "https://github.com/Illumina/Isaac4" .

