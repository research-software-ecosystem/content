@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genenetworkbuilder a schema1:SoftwareApplication ;
    schema1:alternateName "GeneNetworkBuilder: a bioconductor package for building regulatory network using ChIP-chip/ChIP-seq data and Gene Expression Data" ;
    schema1:description "Appliation for discovering direct or indirect targets of transcription factors using ChIP-chip or ChIP-seq, and microarray or RNA-seq gene expression data. Inputting a list of genes of potential targets of one TF from ChIP-chip or ChIP-seq, and the gene expression results, GeneNetworkBuilder generates a regulatory network of the TF." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GeneNetworkBuilder_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneNetworkBuilder/GeneNetworkBuilder_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneNetworkBuilder_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genenetworkbuilder/bioconductor-genenetworkbuilder_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genenetworkbuilder" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-genenetworkbuilder" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GeneNetworkBuilder.html" .

