@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:vsearch a schema1:SoftwareApplication ;
    schema1:alternateName "A versatile open source tool for metagenomics (USEARCH alternative)." ;
    schema1:citation "doi:10.7717/peerj.2584" ;
    schema1:description "A versatile open source tool for metagenomics (USEARCH alternative)." ;
    schema1:identifier <https://bio.tools/biotools:vsearch>,
        "usegalaxy-eu:vsearch_alignment",
        "usegalaxy-eu:vsearch_chimera_detection",
        "usegalaxy-eu:vsearch_clustering",
        "usegalaxy-eu:vsearch_dereplication",
        "usegalaxy-eu:vsearch_masking",
        "usegalaxy-eu:vsearch_search",
        "usegalaxy-eu:vsearch_shuffling",
        "usegalaxy-eu:vsearch_sorting" ;
    schema1:license "GPL-3.0-or-later OR BSD-2-Clause" ;
    schema1:name "vsearch" ;
    schema1:softwareVersion "2.31.0" ;
    schema1:url "https://github.com/torognes/vsearch" .

