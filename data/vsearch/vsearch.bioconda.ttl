@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:vsearch a schema:SoftwareApplication ;
    schema:citation "doi:10.7717/peerj.2584" ;
    schema:description "A versatile open source tool for metagenomics (USEARCH alternative)." ;
    schema:downloadUrl "https://github.com/torognes/vsearch/archive/v2.31.0.tar.gz" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:vsearch ;
    schema:license "GPL-3.0-or-later OR BSD-2-Clause" ;
    schema:name "vsearch" ;
    schema:softwareHelp "https://torognes.github.io/vsearch" ;
    schema:softwareVersion "2.31.0" ;
    schema:url "https://github.com/torognes/vsearch" .

