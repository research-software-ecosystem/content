@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pepnovo a schema:SoftwareApplication ;
    schema:description "PepNovo serves as a high throughput de novo peptide sequencing tool for tandem mass spectrometry data" ;
    schema:downloadUrl "http://proteomics.ucsd.edu/Software/PepNovo/PepNovo.20120423.zip" ;
    schema:identifier biotools:pepnovo ;
    schema:license "BSD" ;
    schema:name "pepnovo" ;
    schema:softwareVersion "20101117" ;
    schema:url "http://proteomics.ucsd.edu/Software/PepNovo/" .

