@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cd-hit a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/17.3.282",
        "doi:10.1093/bioinformatics/18.1.77" ;
    schema:description "Clusters and compares protein or nucleotide sequences." ;
    schema:downloadUrl "https://github.com/weizhongli/cdhit/archive/V4.8.1.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:cd-hit ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "cd-hit" ;
    schema:softwareHelp "https://github.com/weizhongli/cdhit/wiki" ;
    schema:softwareVersion "4.8.1" ;
    schema:url "https://github.com/weizhongli/cdhit" .

