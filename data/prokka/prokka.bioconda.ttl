@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:prokka a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu153" ;
    schema:description "Rapid annotation of prokaryotic genomes" ;
    schema:downloadUrl "https://github.com/tseemann/prokka/archive/v1.15.6.tar.gz" ;
    schema:hasPart "blast",
        "hmmer",
        "infernal",
        "perl",
        "perl-bioperl",
        "perl-xml-simple" ;
    schema:identifier biotools:prokka ;
    schema:license "GPL-3.0-only" ;
    schema:name "prokka" ;
    schema:softwareVersion "1.15.6" ;
    schema:url "https://github.com/tseemann/prokka" .

