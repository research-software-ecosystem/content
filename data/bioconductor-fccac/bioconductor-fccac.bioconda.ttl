@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-fccac a schema:SoftwareApplication ;
    schema:description "functional Canonical Correlation Analysis to evaluate Covariance between nucleic acid sequencing datasets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/fCCAC_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/fCCAC/fCCAC_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/fCCAC_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fccac/bioconductor-fccac_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-complexheatmap",
        "bioconductor-genomation",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base",
        "r-fda",
        "r-ggplot2",
        "r-rcolorbrewer" ;
    schema:identifier biotools:fccac ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-fccac" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/fCCAC.html" .

