@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:circos a schema1:SoftwareApplication ;
    schema1:alternateName "Circos is a software package for visualizing data and information. It visualizes data in a circular layout" ;
    schema1:citation "doi:10.1101/gr.092759.109" ;
    schema1:description "Circos is a software package for visualizing data and information. It visualizes data in a circular layout" ;
    schema1:identifier <https://bio.tools/biotools:circos>,
        "usegalaxy-eu:circos" ;
    schema1:license "GNU General Public License v2 (GPLv2)" ;
    schema1:name "circos" ;
    schema1:softwareVersion "0.69.9" ;
    schema1:url "http://circos.ca" .

