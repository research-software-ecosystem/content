@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:circos a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.092759.109" ;
    schema:description "Circos is a software package for visualizing data and information. It visualizes data in a circular layout" ;
    schema:downloadUrl "http://circos.ca/distribution/circos-0.69-9.tgz" ;
    schema:identifier biotools:circos ;
    schema:license "GNU General Public License v2 (GPLv2)" ;
    schema:name "circos" ;
    schema:softwareVersion "0.69.9" ;
    schema:url "http://circos.ca" .

