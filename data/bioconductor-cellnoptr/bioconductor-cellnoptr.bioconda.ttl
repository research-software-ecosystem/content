@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cellnoptr a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1752-0509-6-133" ;
    schema:description "Training of boolean logic models of signalling networks using prior knowledge networks and perturbation data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CellNOptR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CellNOptR/CellNOptR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CellNOptR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cellnoptr/bioconductor-cellnoptr_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "bioconductor-rbgl",
        "bioconductor-rgraphviz",
        "graphviz",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ggplot2",
        "r-igraph",
        "r-rcurl",
        "r-rmarkdown",
        "r-stringi",
        "r-stringr",
        "r-xml",
        "zlib" ;
    schema:identifier biotools:cellnoptr ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-cellnoptr" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CellNOptR.html" .

