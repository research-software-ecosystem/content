@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cellnoptr a schema1:SoftwareApplication ;
    schema1:alternateName "Training of boolean logic models of signalling networks using prior knowledge networks and perturbation data" ;
    schema1:citation "doi:10.1186/1752-0509-6-133" ;
    schema1:description "This package does optimisation of boolean logic networks of signalling pathways based on a previous knowledge network and a set of data upon perturbation of the nodes in the network." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CellNOptR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CellNOptR/CellNOptR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CellNOptR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cellnoptr/bioconductor-cellnoptr_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cellnoptr" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-cellnoptr" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CellNOptR.html" .

