@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:varlociraptor a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-020-01993-6" ;
    schema:description "Flexible, uncertainty-aware variant calling with parameter free filtration via FDR control." ;
    schema:downloadUrl "https://github.com/varlociraptor/varlociraptor/archive/v8.9.5.tar.gz" ;
    schema:hasPart "blis",
        "bzip2",
        "clangdev",
        "gsl",
        "libcblas",
        "openssl",
        "xz",
        "zlib" ;
    schema:identifier biotools:varlociraptor ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "varlociraptor" ;
    schema:softwareHelp "https://varlociraptor.github.io" ;
    schema:softwareVersion "8.9.5" ;
    schema:url "https://github.com/varlociraptor/varlociraptor" .

