@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:fastool a schema1:SoftwareApplication ;
    schema1:alternateName "A simple and quick tool to read huge FastQ and FastA files (both normal and gzipped) and manipulate them." ;
    schema1:description "A simple and quick tool to read huge FastQ and FastA files (both normal and gzipped) and manipulate them." ;
    schema1:identifier <https://bio.tools/biotools:Fastool> ;
    schema1:license "MIT" ;
    schema1:name "fastool" ;
    schema1:softwareVersion "0.1.4" ;
    schema1:url "https://github.com/fstrozzi/Fastool" .

