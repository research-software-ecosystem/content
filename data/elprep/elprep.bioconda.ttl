@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:elprep a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0244471" ;
    schema:description "elPrep is a high-performance tool for preparing .sam/.bam files for variant calling in sequencing pipelines. It can be used as a drop-in replacement for SAMtools/Picard/GATK4." ;
    schema:downloadUrl "https://github.com/ExaScience/elprep/archive/refs/tags/v5.1.3.tar.gz" ;
    schema:identifier biotools:Elprep ;
    schema:license "AGPL-3.0-only" ;
    schema:name "elprep" ;
    schema:softwareVersion "5.1.3" ;
    schema:url "https://github.com/ExaScience/elprep" .

