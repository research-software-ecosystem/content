@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowdensity a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu677" ;
    schema:description "Sequential Flow Cytometry Data Gating" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowDensity_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowDensity/flowDensity_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowDensity_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowdensity/bioconductor-flowdensity_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-flowcore",
        "bioconductor-flowviz",
        "libxml2",
        "r-base",
        "r-car",
        "r-gplots",
        "r-polyclip" ;
    schema:identifier biotools:flowdensity ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-flowdensity" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowDensity.html" .

