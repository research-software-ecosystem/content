@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:itsxpress a schema:SoftwareApplication ;
    schema:author "arivers",
        "seina001" ;
    schema:citation "doi:10.12688/f1000research.15704.1",
        "doi:10.5281/zenodo.1304349" ;
    schema:description "ITSxpress: Software to rapidly trim the Internally Transcribed Spacer (ITS) region from FASTQ files." ;
    schema:downloadUrl "https://github.com/USDA-ARS-GBRU/itsxpress/archive/v2.1.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "setuptools-scm" ;
    schema:identifier biotools:ITSxpress ;
    schema:license "CC0-1.0" ;
    schema:maintainer "arivers",
        "seina001" ;
    schema:name "itsxpress" ;
    schema:softwareVersion "2.1.4" ;
    schema:url "http://github.com/usda-ars-gbru/itsxpress" .

