@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phenix a schema:SoftwareApplication ;
    schema:description "Public Health England SNP calling pipeline" ;
    schema:downloadUrl "https://github.com/phe-bioinformatics/PHEnix/archive/1-4-1a.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python" ;
    schema:identifier biotools:phenix ;
    schema:license "GPL3" ;
    schema:name "phenix" ;
    schema:softwareVersion "1.4.1a" ;
    schema:url "https://github.com/phe-bioinformatics/PHEnix" .

