@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:any2fasta a schema1:SoftwareApplication ;
    schema1:alternateName "Convert various sequence formats to FASTA" ;
    schema1:description "Convert various sequence formats to FASTA" ;
    schema1:identifier <https://bio.tools/biotools:any2fasta> ;
    schema1:license "GPL-3.0" ;
    schema1:name "any2fasta" ;
    schema1:softwareVersion "0.8.1" ;
    schema1:url "https://github.com/tseemann/any2fasta" .

