@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:any2fasta a schema:SoftwareApplication ;
    schema:description "Convert various sequence formats to FASTA" ;
    schema:downloadUrl "https://github.com/tseemann/any2fasta/archive/v0.8.1.tar.gz" ;
    schema:identifier biotools:any2fasta ;
    schema:license "GPL-3.0" ;
    schema:name "any2fasta" ;
    schema:softwareVersion "0.8.1" ;
    schema:url "https://github.com/tseemann/any2fasta" .

