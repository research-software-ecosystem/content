@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:segmetrics a schema1:SoftwareApplication ;
    bioschemas:output "tsv" ;
    schema1:codeRepository "https://github.com/bmcv" ;
    schema1:dateCreated "2022-10-07" ;
    schema1:description "Image segmentation and object detection performance measures" ;
    schema1:encodingFormat "tsv" ;
    schema1:featureList edam:operation_3443 ;
    schema1:identifier biotools:segmetrics,
        bioconda:segmetrics ;
    schema1:isPartOf <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1517?version=1> ;
    schema1:keywords "Imaging" ;
    schema1:name "segmetrics" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/BMCV/galaxy-image-analysis/tree/master/tools/segmetrics/" .

<https://workflowhub.eu> a schema1:WebSite .

