        biotools:segmetrics,
        bioconda:segmetrics ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.org>,
        <https://workflowhub.eu/workflows/1517?version=1> ;
    schema1:keywords "Imaging" ;
    schema1:name "segmetrics" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
