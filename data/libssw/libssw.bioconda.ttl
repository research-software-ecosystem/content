@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:libssw a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0082138" ;
    schema:description "An SIMD Smith-Waterman C/C++/Python/Java Library for Use in Genomic Applications." ;
    schema:downloadUrl "https://github.com/mengyao/Complete-Striped-Smith-Waterman-Library/archive/v1.2.5.tar.gz" ;
    schema:hasPart "openjdk",
        "zlib" ;
    schema:identifier biotools:ssw ;
    schema:license "MIT" ;
    schema:name "libssw" ;
    schema:softwareHelp "https://github.com/mengyao/Complete-Striped-Smith-Waterman-Library/blob/v1.2.5/README.md" ;
    schema:softwareVersion "1.2.5" ;
    schema:url "https://github.com/mengyao/Complete-Striped-Smith-Waterman-Library" .

