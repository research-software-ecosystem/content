@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-guideseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12864-017-3746-y" ;
    schema:description "GUIDE-seq and PEtag-seq analysis pipeline" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GUIDEseq_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GUIDEseq/GUIDEseq_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GUIDEseq_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-guideseq/bioconductor-guideseq_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-chippeakanno",
        "bioconductor-crisprseek",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-multtest",
        "bioconductor-pwalign",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "r-base",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-hash",
        "r-matrixstats",
        "r-openxlsx",
        "r-patchwork",
        "r-purrr",
        "r-rio",
        "r-rlang",
        "r-stringr",
        "r-tidyr" ;
    schema:identifier biotools:guideseq ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-guideseq" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GUIDEseq.html" .

