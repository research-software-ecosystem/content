@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:demuxlet a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.4042" ;
    schema:description "Genetic multiplexing of barcoded single cell RNA-seq." ;
    schema:downloadUrl "https://github.com/statgen/demuxlet/archive/f5044eb9ed5c6678aa3a80a8f2be7db7748ee732.zip" ;
    schema:hasPart "htslib",
        "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:demuxlet ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "demuxlet" ;
    schema:softwareHelp "https://github.com/statgen/demuxlet" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://github.com/statgen/demuxlet" .

