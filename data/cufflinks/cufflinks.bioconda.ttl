@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cufflinks a schema:SoftwareApplication ;
    schema:description "Transcriptome assembly and differential expression analysis for RNA-Seq." ;
    schema:hasPart "python" ;
    schema:identifier biotools:cufflinks ;
    schema:license "Boost Software License" ;
    schema:name "cufflinks" ;
    schema:softwareVersion "2.2.1" ;
    schema:url "http://cole-trapnell-lab.github.io/cufflinks/" .

