@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-acme a schema1:SoftwareApplication ;
    schema1:description "Algorithms for Calculating Microarray Enrichment (ACME)" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ACME_2.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ACME_2.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ACME/ACME_2.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-acme/bioconductor-acme_2.66.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:acme ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-acme" ;
    schema1:softwareVersion "2.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ACME.html" .

