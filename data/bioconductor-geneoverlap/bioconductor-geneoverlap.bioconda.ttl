@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-geneoverlap a schema1:SoftwareApplication ;
    schema1:alternateName "Test and visualize gene overlaps" ;
    schema1:citation "doi:10.1167/iovs.16-20618" ;
    schema1:description "Test two sets of gene lists and visualize the results." ;
    schema1:identifier biotools:geneoverlap ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-geneoverlap" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GeneOverlap.html" .

