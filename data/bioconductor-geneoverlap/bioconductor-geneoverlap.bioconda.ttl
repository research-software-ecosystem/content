@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-geneoverlap a schema:SoftwareApplication ;
    schema:citation "doi:10.1167/iovs.16-20618" ;
    schema:description "Test and visualize gene overlaps" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GeneOverlap_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneOverlap/GeneOverlap_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneOverlap_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geneoverlap/bioconductor-geneoverlap_1.46.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-gplots",
        "r-rcolorbrewer" ;
    schema:identifier biotools:geneoverlap ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-geneoverlap" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GeneOverlap.html" .

