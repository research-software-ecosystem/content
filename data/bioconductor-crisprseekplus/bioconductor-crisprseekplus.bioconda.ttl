@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-crisprseekplus a schema1:SoftwareApplication ;
    schema1:alternateName "crisprseekplus" ;
    schema1:citation "doi:10.1371/journal.pone.0108424" ;
    schema1:description "Bioinformatics platform containing interface to work with offTargetAnalysis and compare2Sequences in the CRISPRseek package, and GUIDEseqAnalysis." ;
    schema1:identifier <https://bio.tools/biotools:crisprseekplus> ;
    schema1:license "GPL-3 + file LICENSE" ;
    schema1:name "bioconductor-crisprseekplus" ;
    schema1:softwareVersion "1.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/crisprseekplus.html" .

