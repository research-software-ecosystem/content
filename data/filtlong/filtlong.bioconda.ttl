@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:filtlong a schema:SoftwareApplication ;
    schema:description "Filtlong is a tool for filtering long reads. It can take a set of long reads and produce a smaller, better subset. It uses both read length (longer is better) and read identity (higher is better) when choosing which reads pass the filter." ;
    schema:downloadUrl "https://github.com/rrwick/Filtlong/archive/v0.3.1.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:filtlong ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "filtlong" ;
    schema:softwareHelp "https://github.com/rrwick/Filtlong/blob/v0.3.1/README.md" ;
    schema:softwareVersion "0.3.1" ;
    schema:url "https://github.com/rrwick/Filtlong" .

