@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:filtlong a schema1:SoftwareApplication ;
    schema1:alternateName "Filtlong is a tool for filtering long reads. It can take a set of long reads and produce a smaller, better subset. It uses both read length (longer is better) and read identity (higher is better) when choosing which reads pass the filter." ;
    schema1:description "Filtlong is a tool for filtering long reads. It can take a set of long reads and produce a smaller, better subset. It uses both read length (longer is better) and read identity (higher is better) when choosing which reads pass the filter." ;
    schema1:identifier <https://bio.tools/biotools:filtlong>,
        "usegalaxy-eu:filtlong" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "filtlong" ;
    schema1:softwareVersion "0.3.1" ;
    schema1:url "https://github.com/rrwick/Filtlong" .

