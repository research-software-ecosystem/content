@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-derfinder a schema:SoftwareApplication ;
    schema:description "Annotation-agnostic differential expression analysis of RNA-seq data at base-pair resolution via the DER Finder approach" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/derfinder_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/derfinder/derfinder_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/derfinder_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-derfinder/bioconductor-derfinder_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-bumphunter",
        "bioconductor-derfinderhelper",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicfiles",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-qvalue",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-hmisc" ;
    schema:identifier biotools:derfinder ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-derfinder" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/derfinder.html" .

