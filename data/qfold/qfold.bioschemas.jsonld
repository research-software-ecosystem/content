  "sc:description": "QFold provides molecular similarity analysis using molecular fingerprints and machine-learning-based electronic-property predictions. The current web-server implementation also supports electronic-property estimation for molecules beyond the original QM9 molecular-size domain. Predictions outside the validated applicability domain should be treated as exploratory.",
  "sc:name": "QFold",
  "sc:url": "https://qfold.biochemoinfo.com"
