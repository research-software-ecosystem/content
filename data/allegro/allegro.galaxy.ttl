@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:allegro a schema1:SoftwareApplication ;
    bioschemas:output "allegro_descent",
        "allegro_fparam",
        "allegro_ihaplo",
        "txt" ;
    schema1:applicationSubCategory edam:operation_2403,
        edam:topic_0080,
        edam:topic_0654,
        edam:topic_0749 ;
    schema1:codeRepository "http://www.decode.com/software/" ;
    schema1:dateCreated "2017-11-19" ;
    schema1:description "Linkage and haplotype analysis from deCODE" ;
    schema1:encodingFormat "allegro_descent",
        "allegro_fparam",
        "allegro_ihaplo",
        "txt" ;
    schema1:featureList edam:operation_0238 ;
    schema1:identifier biotools:allegro,
        bioconda:allegro ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "allegro" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/allegro" .

