@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:fraggenescan a schema:SoftwareApplication ;
    schema:author "keuv-grvl" ;
    schema:citation "doi:10.1093/nar/gkq747" ;
    schema:description "FragGeneScan is an application for finding (fragmented) genes in short reads." ;
    schema:downloadUrl "http://downloads.sourceforge.net/project/fraggenescan/FragGeneScan1.32.tar.gz" ;
    schema:identifier biotools:fraggenescan ;
    schema:license "BSD" ;
    schema:maintainer "keuv-grvl" ;
    schema:name "fraggenescan" ;
    schema:softwareHelp "https://sourceforge.net/projects/fraggenescan" ;
    schema:softwareVersion "1.32" ;
    schema:url "https://sourceforge.net/projects/fraggenescan" .

