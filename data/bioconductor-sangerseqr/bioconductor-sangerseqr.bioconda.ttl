@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sangerseqr a schema:SoftwareApplication ;
    schema:description "Tools for Sanger Sequencing Data in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sangerseqR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sangerseqR/sangerseqR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sangerseqR_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sangerseqr/bioconductor-sangerseqr_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-pwalign",
        "r-base",
        "r-shiny",
        "r-stringr" ;
    schema:identifier biotools:sangerseqr ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-sangerseqr" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sangerseqR.html" .

