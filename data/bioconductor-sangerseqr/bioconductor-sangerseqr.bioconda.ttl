@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sangerseqr a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for Sanger Sequencing Data in R" ;
    schema1:description "This package contains several tools for analyzing Sanger Sequencing data files in R, including reading .scf and .ab1 files, making basecalls and plotting chromatograms." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/sangerseqR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sangerseqR/sangerseqR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sangerseqR_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sangerseqr/bioconductor-sangerseqr_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:sangerseqr" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-sangerseqr" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/sangerseqR.html" .

