@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pyranges a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btz615" ;
    schema:description "Performant Pythonic GenomicRanges." ;
    schema:downloadUrl "https://pypi.io/packages/source/p/pyranges/pyranges-0.1.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools-scm" ;
    schema:identifier biotools:PyRanges ;
    schema:license "MIT" ;
    schema:name "pyranges" ;
    schema:softwareHelp "https://pyranges.readthedocs.io" ;
    schema:softwareVersion "0.1.4" ;
    schema:url "https://github.com/endrebak/pyranges" .

