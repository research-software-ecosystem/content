@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:r-spp a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.1508" ;
    schema:description "Analysis of ChIP-seq and other functional sequencing data [Kharchenko PV (2008) <DOI:10.1038/nbt.1508>]." ;
    schema:downloadUrl "/src/contrib/Archive/spp/spp_1.16.0.tar.gz",
        "/src/contrib/spp_1.16.0.tar.gz" ;
    schema:hasPart "bioconductor-rsamtools",
        "r-base",
        "r-bh",
        "r-catools",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:spp ;
    schema:license "GPL-2.0-only" ;
    schema:name "r-spp" ;
    schema:softwareHelp "https://CRAN.R-project.org/package=spp" ;
    schema:softwareVersion "1.16.0" ;
    schema:url "https://CRAN.R-project.org/package=spp" .

