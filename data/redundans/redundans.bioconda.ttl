@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:redundans a schema:SoftwareApplication ;
    schema:author "Dfupa" ;
    schema:description "Redundans is a pipeline that assists an assembly of heterozygous/polymorphic genomes." ;
    schema:downloadUrl "https://github.com/Gabaldonlab/redundans/archive/refs/tags/v2.01.tar.gz" ;
    schema:hasPart "perl",
        "pillow",
        "pip",
        "python",
        "zlib" ;
    schema:identifier biotools:redundans ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "Dfupa" ;
    schema:name "redundans" ;
    schema:softwareVersion "2.01" ;
    schema:url "https://github.com/Gabaldonlab/redundans/" .

