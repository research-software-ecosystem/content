@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mbttest a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1371/journal.pone.0123658" ;
    schema1:description "Multiple Beta t-Tests" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MBttest_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MBttest/MBttest_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MBttest_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mbttest/bioconductor-mbttest_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "r-base",
        "r-gplots",
        "r-gtools" ;
    schema1:identifier biotools:mbttest ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-mbttest" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MBttest.html" .

