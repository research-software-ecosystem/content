        edam:topic_3293,
        edam:topic_3512 ;
    schema1:codeRepository "https://github.com/mossmatters/HybPiper" ;
    schema1:dateCreated "2023-08-30" ;
    schema1:description "Analyse targeted sequence capture data" ;
    schema1:encodingFormat "fasta",
        "tar",
        "txt" ;
    schema1:featureList edam:data_0925,
        edam:operation_0310,
        edam:operation_3192,
        edam:operation_3198,
        edam:topic_0196 ;
    schema1:identifier biotools:HybPiper,
