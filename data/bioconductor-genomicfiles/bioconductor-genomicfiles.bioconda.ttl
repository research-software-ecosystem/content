@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genomicfiles a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Distributed computing by file or by range" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GenomicFiles_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GenomicFiles/GenomicFiles_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GenomicFiles_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genomicfiles/bioconductor-genomicfiles_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocbaseutils",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "bioconductor-variantannotation",
        "r-base" ;
    schema1:identifier biotools:genomicfiles ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genomicfiles" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GenomicFiles.html" .

