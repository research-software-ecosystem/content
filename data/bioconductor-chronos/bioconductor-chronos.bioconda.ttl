@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chronos a schema1:SoftwareApplication ;
    schema1:alternateName "CHRONOS: A time-varying method for microRNA-mediated sub-pathway enrichment analysis" ;
    schema1:description "A package used for efficient unraveling of the inherent dynamic properties of pathways. MicroRNA-mediated subpathway topologies are extracted and evaluated by exploiting the temporal transition and the fold change activity of the linked genes/microRNAs." ;
    schema1:identifier biotools:CHRONOS ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-chronos" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CHRONOS.html" .

