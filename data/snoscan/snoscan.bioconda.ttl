@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:snoscan a schema:SoftwareApplication ;
    schema:description "Search for C/D box methylation guide snoRNA genes in a genomic sequence" ;
    schema:downloadUrl "http://lowelab.ucsc.edu/software/snoscan-1.0.tar.gz" ;
    schema:hasPart "perl",
        "perl-module-build" ;
    schema:identifier biotools:snoscan ;
    schema:license "GNU General Public License, version 2" ;
    schema:name "snoscan" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://lowelab.ucsc.edu/snoscan" .

