@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cytoscape a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.1239303" ;
    schema:description "Cytoscape: an open source platform for network analysis and visualization." ;
    schema:downloadUrl "https://github.com/cytoscape/cytoscape/releases/download/3.10.4/Cytoscape_3_10_4_unix.sh" ;
    schema:hasPart "font-ttf-dejavu-sans-mono",
        "fontconfig",
        "freetype",
        "openjdk" ;
    schema:identifier biotools:cytoscape ;
    schema:license "LGPL" ;
    schema:name "cytoscape" ;
    schema:softwareVersion "3.10.4" ;
    schema:url "https://cytoscape.org" .

