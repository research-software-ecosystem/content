@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:lineagespot a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:applicationSubCategory edam:topic_0199,
        edam:topic_3168,
        edam:topic_3174,
        edam:topic_3299,
        edam:topic_3512 ;
    schema1:codeRepository "https://www.bioconductor.org/packages/release/bioc/html/lineagespot.html" ;
    schema1:dateCreated "2023-07-04" ;
    schema1:description "Identification of SARS-CoV-2 related metagenomic mutations based on a single (or a list of) variant(s) file(s)" ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_3227 ;
    schema1:identifier biotools:lineagespot,
        bioconda:r-base ;
    schema1:keywords "Metagenomics",
        "Sequence Analysis" ;
    schema1:name "lineagespot" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/lineagespot" .

