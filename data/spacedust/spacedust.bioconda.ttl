@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:spacedust a schema:SoftwareApplication ;
    schema:author "milot-mirdita" ;
    schema:citation "doi:10.1101/2024.10.02.616292v1" ;
    schema:description "De novo discovery of conserved gene clusters in microbial genomes with Spacedust" ;
    schema:downloadUrl "https://github.com/soedinglab/spacedust/archive/2-e56c505.tar.gz" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:spacedust ;
    schema:license "GPL-3" ;
    schema:maintainer "milot-mirdita" ;
    schema:name "spacedust" ;
    schema:softwareVersion "2.e56c505" ;
    schema:url "https://github.com/soedinglab/spacedust" .

