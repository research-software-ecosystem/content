@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mosaics a schema1:SoftwareApplication ;
    schema1:alternateName "MOSAiCS (MOdel-based one and two Sample Analysis and Inference for ChIP-Seq)" ;
    schema1:citation "doi:10.1198/jasa.2011.ap09706" ;
    schema1:description "This package provides functions for fitting MOSAiCS and MOSAiCS-HMM, a statistical framework to analyze one-sample or two-sample ChIP-seq data of transcription factor binding and histone modification." ;
    schema1:identifier <https://bio.tools/biotools:mosaics> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-mosaics" ;
    schema1:softwareVersion "2.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mosaics.html" .

