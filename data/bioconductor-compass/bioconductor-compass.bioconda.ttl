@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-compass a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.3187" ;
    schema:description "Combinatorial Polyfunctionality Analysis of Single Cells" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/COMPASS_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/COMPASS/COMPASS_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/COMPASS_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-compass/bioconductor-compass_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocstyle",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-abind",
        "r-base",
        "r-clue",
        "r-coda",
        "r-data.table",
        "r-dplyr",
        "r-foreach",
        "r-knitr",
        "r-magrittr",
        "r-pdist",
        "r-plyr",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-reshape2",
        "r-rlang",
        "r-rmarkdown",
        "r-scales",
        "r-tidyr",
        "zlib" ;
    schema:identifier biotools:compass ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-compass" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/COMPASS.html" .

