@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-compass a schema1:SoftwareApplication ;
    schema1:alternateName "Combinatorial Polyfunctionality Analysis of Single Cells" ;
    schema1:citation "doi:10.1038/nbt.3187" ;
    schema1:description "COMPASS is a statistical framework that enables unbiased analysis of antigen-specific T-cell subsets. COMPASS uses a Bayesian hierarchical framework to model all observed cell-subsets and select the most likely to be antigen-specific while regularizing the small cell counts that often arise in multi-parameter space. The model provides a posterior probability of specificity for each cell subset and each sample, which can be used to profile a subject's immune response to external stimuli such as infection or vaccination." ;
    schema1:identifier biotools:compass ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-compass" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/COMPASS.html" .

