@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowworkspace a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1186/1471-2105-13-252" ;
    schema1:description "Infrastructure for representing and interacting with gated and ungated cytometry data sets." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/flowWorkspace_4.22.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowWorkspace/flowWorkspace_4.22.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowWorkspace_4.22.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowworkspace/bioconductor-flowworkspace_4.22.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-cytolib",
        "bioconductor-delayedarray",
        "bioconductor-flowcore",
        "bioconductor-graph",
        "bioconductor-ncdfflow",
        "bioconductor-rbgl",
        "bioconductor-rgraphviz",
        "bioconductor-rhdf5lib",
        "bioconductor-rprotobuflib",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-cpp11",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-matrixstats",
        "r-scales",
        "r-xml",
        "zlib" ;
    schema1:identifier biotools:flowworkspace ;
    schema1:license "AGPL-3.0-only" ;
    schema1:name "bioconductor-flowworkspace" ;
    schema1:softwareVersion "4.22.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowWorkspace.html" .

