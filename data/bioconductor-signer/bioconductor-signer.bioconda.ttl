@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-signer a schema1:SoftwareApplication ;
    schema1:alternateName "Empirical Bayesian approach to mutational signature discovery" ;
    schema1:description "The signeR package provides an empirical Bayesian approach to mutational signature discovery. It is designed to analyze single nucleotide variation (SNV) counts in cancer genomes, but can also be applied to other features as well. Functionalities to characterize signatures or genome samples according to exposure patterns are also provided." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/signeR_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/signeR/signeR_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/signeR_2.12.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-signer/bioconductor-signer_2.12.0_src_all.tar.gz" ;
    schema1:identifier "biotools:signer" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-signer" ;
    schema1:softwareVersion "2.12.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/signeR.html" .

