@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-signer a schema:SoftwareApplication ;
    schema:description "Empirical Bayesian approach to mutational signature discovery" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/signeR_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/signeR/signeR_2.12.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/signeR_2.12.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-signer/bioconductor-signer_2.12.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocfilecache",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-variantannotation",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-ada",
        "r-base",
        "r-broom",
        "r-bsplus",
        "r-class",
        "r-clue",
        "r-cowplot",
        "r-dplyr",
        "r-dt",
        "r-e1071",
        "r-future",
        "r-future.apply",
        "r-ggplot2",
        "r-ggpubr",
        "r-glmnet",
        "r-kknn",
        "r-listenv",
        "r-magrittr",
        "r-mass",
        "r-maxstat",
        "r-nloptr",
        "r-nmf",
        "r-pheatmap",
        "r-pmcmrplus",
        "r-ppclust",
        "r-proc",
        "r-proxy",
        "r-pvclust",
        "r-randomforest",
        "r-rcolorbrewer",
        "r-rcpp",
        "r-rcpparmadillo",
        "r-readr",
        "r-reshape2",
        "r-scales",
        "r-shiny",
        "r-shinycssloaders",
        "r-shinydashboard",
        "r-shinywidgets",
        "r-survival",
        "r-survminer",
        "r-tibble",
        "r-tidyr",
        "r-vgam",
        "zlib" ;
    schema:identifier biotools:signer ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-signer" ;
    schema:softwareVersion "2.12.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/signeR.html" .

