@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dmrcaller a schema1:SoftwareApplication ;
    schema1:alternateName "Differentially Methylated Regions Caller" ;
    schema1:description "Uses Bisulfite sequencing data in two conditions and identifies differentially methylated regions between the conditions in CG and non-CG context. The input is the CX report files produced by Bismark and the output is a list of DMRs stored as GRanges objects." ;
    schema1:identifier biotools:dmrcaller ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-dmrcaller" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DMRcaller.html" .

