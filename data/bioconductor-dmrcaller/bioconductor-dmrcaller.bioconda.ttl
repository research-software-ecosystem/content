@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dmrcaller a schema:SoftwareApplication ;
    schema:description "Differentially Methylated Regions Caller" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DMRcaller_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DMRcaller/DMRcaller_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DMRcaller_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dmrcaller/bioconductor-dmrcaller_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-interactionset",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-betareg",
        "r-biocmanager",
        "r-inflection",
        "r-rcpp",
        "r-rcpproll",
        "r-stringr",
        "zlib" ;
    schema:identifier biotools:dmrcaller ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-dmrcaller" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DMRcaller.html" .

