@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-impute a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-642-57489-4_7" ;
    schema:description "impute: Imputation for microarray data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/impute_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/impute/impute_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/impute_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-impute/bioconductor-impute_1.84.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:impute ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "bioconductor-impute" ;
    schema:softwareVersion "1.84.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/impute.html" .

