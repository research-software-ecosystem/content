@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-impute a schema1:SoftwareApplication ;
    schema1:alternateName "impute: Imputation for microarray data" ;
    schema1:citation "doi:10.1007/978-3-642-57489-4_7" ;
    schema1:description "Imputation for microarray data (currently KNN only)" ;
    schema1:identifier <https://bio.tools/biotools:impute> ;
    schema1:license "GPL-2.0-or-later" ;
    schema1:name "bioconductor-impute" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/impute.html" .

