@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bhc a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-10-242" ;
    schema:description "Bayesian Hierarchical Clustering" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BHC_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/BHC/BHC_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/BHC_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bhc/bioconductor-bhc_1.54.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "r-base" ;
    schema:identifier biotools:bhc ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-bhc" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/BHC.html" .

