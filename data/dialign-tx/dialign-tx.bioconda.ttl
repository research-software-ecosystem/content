@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dialign-tx a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkq442" ;
    schema:description "DIALIGN-TX is a greedy and progressive approaches for segment-based multiple sequence alignment." ;
    schema:downloadUrl "https://master.dl.sourceforge.net/project/old-software-collection/DIALIGN-TX_1.0.2.tar.gz" ;
    schema:identifier biotools:dialign-tx ;
    schema:license "LGPL-2.1-or-later" ;
    schema:name "dialign-tx" ;
    schema:softwareHelp "http://dialign-tx.gobics.de" ;
    schema:softwareVersion "1.0.2" ;
    schema:url "https://dialign.gobics.de" .

