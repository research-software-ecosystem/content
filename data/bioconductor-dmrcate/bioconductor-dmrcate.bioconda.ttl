@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dmrcate a schema:SoftwareApplication ;
    schema:description "Methylation array and sequencing spatial analysis methods" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DMRcate_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DMRcate/DMRcate_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DMRcate_3.6.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dmrcate/bioconductor-dmrcate_3.6.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationhub",
        "bioconductor-biomart",
        "bioconductor-bsseq",
        "bioconductor-edger",
        "bioconductor-experimenthub",
        "bioconductor-genomicranges",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-minfi",
        "bioconductor-missmethyl",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-plyr" ;
    schema:identifier biotools:dmrcate ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-dmrcate" ;
    schema:softwareVersion "3.6.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DMRcate.html" .

