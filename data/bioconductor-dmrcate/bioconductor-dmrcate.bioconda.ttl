@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dmrcate a schema1:SoftwareApplication ;
    schema1:alternateName "Methylation array and sequencing spatial analysis methods" ;
    schema1:description "De novo identification and extraction of differentially methylated regions (DMRs) from the human genome using Whole Genome Bisulfite Sequencing (WGBS) and Illumina Infinium Array (450K and EPIC) data. Provides functionality for filtering probes possibly confounded by SNPs and cross-hybridisation. Includes GRanges generation and plotting functions." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DMRcate_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DMRcate/DMRcate_3.6.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DMRcate_3.6.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dmrcate/bioconductor-dmrcate_3.6.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dmrcate" ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-dmrcate" ;
    schema1:softwareVersion "3.6.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DMRcate.html" .

