@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:intarna a schema:SoftwareApplication ;
    schema:author "BackofenLab",
        "martin-raden" ;
    schema:citation "doi:10.1093/bioinformatics/btn544",
        "doi:10.1093/nar/gkx279",
        "doi:10.1093/nar/gky329" ;
    schema:description "Efficient RNA-RNA interaction prediction incorporating seeding and accessibility of interacting sites." ;
    schema:downloadUrl "https://github.com/BackofenLab/IntaRNA/releases/download/v3.4.1/intaRNA-3.4.1.tar.gz" ;
    schema:hasPart "boost-cpp",
        "doxygen",
        "libgomp",
        "llvm-openmp",
        "perl",
        "viennarna",
        "zlib" ;
    schema:identifier biotools:intarna ;
    schema:license "MIT" ;
    schema:maintainer "BackofenLab",
        "martin-raden" ;
    schema:name "intarna" ;
    schema:softwareHelp "https://backofenlab.github.io/IntaRNA" ;
    schema:softwareVersion "3.4.1" ;
    schema:url "https://github.com/BackofenLab/IntaRNA" .

