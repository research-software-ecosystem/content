@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:foldmason a schema:SoftwareApplication ;
    schema:author "gamcil",
        "martin-steinegger",
        "milot-mirdita" ;
    schema:citation "doi:10.1101/2024.08.01.606130v3" ;
    schema:description "Multiple Protein Structure Alignment at Scale with FoldMason" ;
    schema:downloadUrl "https://github.com/steineggerlab/foldmason/archive/4-dd3c235.tar.gz" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:foldmason ;
    schema:license "GPL-3" ;
    schema:maintainer "gamcil",
        "martin-steinegger",
        "milot-mirdita" ;
    schema:name "foldmason" ;
    schema:softwareVersion "4.dd3c235" ;
    schema:url "https://github.com/steineggerlab/foldmason" .

