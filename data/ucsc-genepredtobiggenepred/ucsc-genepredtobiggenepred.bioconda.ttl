@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ucsc-genepredtobiggenepred a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bib/bbs038" ;
    schema1:description "Converts genePred or genePredExt to bigGenePred input (bed format with extra fields)." ;
    schema1:downloadUrl "https://hgdownload.cse.ucsc.edu/admin/exe/userApps.archive/userApps.v482.src.tgz" ;
    schema1:hasPart "bzip2",
        "clangdev",
        "libiconv",
        "liblzma-devel",
        "libopenssl-static",
        "libpng",
        "libuuid",
        "mariadb-connector-c",
        "mysql-connector-c",
        "rsync",
        "zlib" ;
    schema1:identifier biotools:UCSC_Genome_Browser_Utilities ;
    schema1:license "Varies; see https://genome.ucsc.edu/license" ;
    schema1:name "ucsc-genepredtobiggenepred" ;
    schema1:softwareHelp "https://github.com/ucscGenomeBrowser/kent/blob/v482_base/README" ;
    schema1:softwareVersion "482" ;
    schema1:url "https://hgdownload.cse.ucsc.edu/admin/exe" .

