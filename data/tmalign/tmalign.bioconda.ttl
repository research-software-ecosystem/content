@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tmalign a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/prot.20264",
        "doi:10.1093/nar/gki524" ;
    schema:description "TM-align sequence-order independent protein structure alignment." ;
    schema:downloadUrl "https://github.com/pylelab/USalign/archive/61b50fbe09235deb70bcec42000b723c4def49ca.tar.gz" ;
    schema:identifier biotools:tm-score ;
    schema:license "BSD-like" ;
    schema:name "tmalign" ;
    schema:softwareHelp "https://aideepmed.com/TM-align" ;
    schema:softwareVersion "20240303" ;
    schema:url "https://github.com/pylelab/USalign" .

