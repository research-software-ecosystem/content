@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:nerpa a schema1:SoftwareApplication ;
    schema1:alternateName "A tool for discovering biosynthetic gene clusters of nonribosomal peptides." ;
    schema1:citation "doi:10.1101/2024.11.19.624380v3",
        "doi:10.3390/metabo11100693" ;
    schema1:description "Nerpa is a tool for linking biosynthetic gene clusters (BGCs) to known nonribosomal peptides (NRPs). BGCs are predicted in genome sequences (FASTA or GBK) with antiSMASH (Medema et al, 2011). Known NRPs are accepted in the SMILES format and processed with rBAN (Ricart et al, 2019)." ;
    schema1:identifier biotools:nerpa ;
    schema1:license "Dual-licensed under GPLv3 or CC BY-NC-SA 4.0" ;
    schema1:maintainer "alexeigurevich" ;
    schema1:name "nerpa" ;
    schema1:softwareVersion "2.1.0" ;
    schema1:url "https://github.com/gurevichlab/nerpa" .

