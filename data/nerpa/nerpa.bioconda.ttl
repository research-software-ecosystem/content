@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:nerpa a schema:SoftwareApplication ;
    schema:author "alexeigurevich" ;
    schema:citation "doi:10.1101/2024.11.19.624380v3",
        "doi:10.3390/metabo11100693" ;
    schema:description "A tool for discovering biosynthetic gene clusters of nonribosomal peptides." ;
    schema:downloadUrl "https://github.com/gurevichlab/nerpa/releases/download/nerpa_2.1.0/nerpa-2.1.0.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "wget" ;
    schema:identifier biotools:nerpa ;
    schema:license "Dual-licensed under GPLv3 or CC BY-NC-SA 4.0" ;
    schema:maintainer "alexeigurevich" ;
    schema:name "nerpa" ;
    schema:softwareHelp "https://github.com/gurevichlab/nerpa/blob/nerpa_2.1.0/README.md" ;
    schema:softwareVersion "2.1.0" ;
    schema:url "https://github.com/gurevichlab/nerpa" .

