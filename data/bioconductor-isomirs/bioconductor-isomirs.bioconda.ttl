@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-isomirs a schema1:SoftwareApplication ;
    schema1:alternateName "Analyze isomiRs and miRNAs from small RNA-seq" ;
    schema1:citation "doi:10.1093/bioinformatics/btv632" ;
    schema1:description "Characterization of miRNAs and isomiRs, clustering and differential expression." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/isomiRs_1.38.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/isomiRs/isomiRs_1.38.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/isomiRs_1.38.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-isomirs/bioconductor-isomirs_1.38.1_src_all.tar.gz" ;
    schema1:identifier "biotools:isomirs" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-isomirs" ;
    schema1:softwareVersion "1.38.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/isomiRs.html" .

