@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-isomirs a schema1:SoftwareApplication ;
    schema1:alternateName "Analyze isomiRs and miRNAs from small RNA-seq" ;
    schema1:citation "doi:10.1093/bioinformatics/btv632" ;
    schema1:description "Characterization of miRNAs and isomiRs, clustering and differential expression." ;
    schema1:identifier <https://bio.tools/biotools:isomirs> ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-isomirs" ;
    schema1:softwareVersion "1.38.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/isomiRs.html" .

