@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:peakzilla a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt470" ;
    schema:description "Peakzilla identifies sites of enrichment and transcription factor binding sites from transcription factor ChIP-seq and ChIP-exo experiments at hight accuracy and resolution." ;
    schema:downloadUrl "https://github.com/steinmann/peakzilla/archive/0fc94780ee1a8c2b6395b5c7489e21a70eeb5217.tar.gz" ;
    schema:hasPart "python" ;
    schema:identifier biotools:peakzilla ;
    schema:license "GPLv2" ;
    schema:name "peakzilla" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://stark.imp.ac.at/data/peakzilla" .

