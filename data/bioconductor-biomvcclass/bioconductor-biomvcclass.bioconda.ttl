@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-biomvcclass a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Model-View-Controller (MVC) Classes That Use Biobase" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BioMVCClass_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BioMVCClass/BioMVCClass_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BioMVCClass_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biomvcclass/bioconductor-biomvcclass_1.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-graph",
        "bioconductor-mvcclass",
        "bioconductor-rgraphviz",
        "r-base" ;
    schema:identifier biotools:biomvcclass ;
    schema:license "LGPL" ;
    schema:name "bioconductor-biomvcclass" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BioMVCClass.html" .

