@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biomvcclass a schema1:SoftwareApplication ;
    schema1:alternateName "Model-View-Controller (MVC) Classes That Use Biobase" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Creates classes used in model-view-controller (MVC) design" ;
    schema1:identifier <https://bio.tools/biotools:biomvcclass> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-biomvcclass" ;
    schema1:softwareVersion "1.78.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/BioMVCClass.html" .

