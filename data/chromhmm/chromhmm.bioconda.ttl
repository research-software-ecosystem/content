@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:chromhmm a schema:SoftwareApplication ;
    schema:description "ChromHMM is software for learning and characterizing chromatin states. ChromHMM can integrate multiple chromatin datasets such as ChIP-seq data of various histone modifications to discover de novo the major re-occuring combinatorial and spatial patterns of marks." ;
    schema:downloadUrl "https://github.com/jernst98/ChromHMM/archive/v1.28.tar.gz" ;
    schema:identifier biotools:chromhmm ;
    schema:license "GPLv3" ;
    schema:name "chromhmm" ;
    schema:softwareVersion "1.28" ;
    schema:url "https://github.com/jernst98/ChromHMM" .

