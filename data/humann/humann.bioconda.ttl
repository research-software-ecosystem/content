@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:humann a schema:SoftwareApplication ;
    schema:citation "doi:10.7554/eLife.65088" ;
    schema:description "HUMAnN: The HMP Unified Metabolic Analysis Network, version 3" ;
    schema:downloadUrl "https://pypi.io/packages/source/h/humann/humann-3.9.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:humann ;
    schema:license "MIT" ;
    schema:name "humann" ;
    schema:softwareHelp "http://huttenhower.sph.harvard.edu/humann" ;
    schema:softwareVersion "3.9" ;
    schema:url "https://huttenhower.sph.harvard.edu/humann" .

