@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sispa a schema1:SoftwareApplication ;
    schema1:alternateName "SISPA: Method for Sample Integrated Set Profile Analysis" ;
    schema1:citation "doi:10.1093/nar/gkv1503" ;
    schema1:description "Sample Integrated Set Profile Analysis (SISPA) is a method designed to define sample groups with similar gene set enrichment profiles." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SISPA_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/SISPA/SISPA_1.30.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/SISPA_1.30.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sispa/bioconductor-sispa_1.30.0_src_all.tar.gz" ;
    schema1:identifier "biotools:sispa" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-sispa" ;
    schema1:softwareVersion "1.30.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/SISPA.html" .

