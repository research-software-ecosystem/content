@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sourmash a schema:SoftwareApplication ;
    schema:author "bluegenes",
        "ctb",
        "luizirber" ;
    schema:citation "doi:10.12688/f1000research.19675.1",
        "doi:10.21105/joss.00027",
        "doi:10.5281/zenodo.11557883" ;
    schema:description "Quickly search, compare, and analyze genomic and metagenomic data sets." ;
    schema:downloadUrl "https://pypi.io/packages/source/s/sourmash/sourmash-4.9.4.tar.gz" ;
    schema:identifier biotools:sourmash ;
    schema:license "BSD-3-Clause" ;
    schema:maintainer "bluegenes",
        "ctb",
        "luizirber" ;
    schema:name "sourmash" ;
    schema:softwareHelp "https://sourmash.readthedocs.io/" ;
    schema:softwareVersion "4.9.4" ;
    schema:url "https://github.com/sourmash-bio/sourmash" .

