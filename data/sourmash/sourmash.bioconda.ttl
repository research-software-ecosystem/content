@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:sourmash a schema1:SoftwareApplication ;
    schema1:alternateName "Quickly search, compare, and analyze genomic and metagenomic data sets." ;
