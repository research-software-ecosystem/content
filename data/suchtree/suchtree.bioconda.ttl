@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:suchtree a schema:SoftwareApplication ;
    schema:author "ryneches" ;
    schema:citation "doi:10.21105/joss.00678" ;
    schema:description "A python library for doing fast, thread-safe computations on phylogenetic trees" ;
    schema:downloadUrl "https://pypi.io/packages/source/s/SuchTree/suchtree-1.3.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "python",
        "scipy",
        "setuptools" ;
    schema:identifier biotools:suchtree ;
    schema:license "BSD" ;
    schema:maintainer "ryneches" ;
    schema:name "suchtree" ;
    schema:softwareHelp "https://github.com/ryneches/SuchTree/blob/master/README.md" ;
    schema:softwareVersion "1.3" ;
    schema:url "https://github.com/ryneches/SuchTree/" .

