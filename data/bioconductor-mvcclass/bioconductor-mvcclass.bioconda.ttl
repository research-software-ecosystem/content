@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mvcclass a schema1:SoftwareApplication ;
    schema1:alternateName "Model-View-Controller (MVC) Classes" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Creates classes used in model-view-controller (MVC) design" ;
    schema1:identifier <https://bio.tools/biotools:mvcclass> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-mvcclass" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MVCClass.html" .

