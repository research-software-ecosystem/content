@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:physher a schema:SoftwareApplication ;
    schema:author "4ment" ;
    schema:citation "doi:10.1186/s12862-014-0163-6" ;
    schema:description "A multi-algorithmic framework for phylogenetic inference." ;
    schema:downloadUrl "https://github.com/4ment/physher/archive/refs/tags/v2.0.1.tar.gz" ;
    schema:hasPart "gsl" ;
    schema:identifier biotools:physher ;
    schema:license "GPL-2.0-or-later" ;
    schema:maintainer "4ment" ;
    schema:name "physher" ;
    schema:softwareVersion "2.0.1" ;
    schema:url "https://github.com/4ment/physher" .

