@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-annmap a schema1:SoftwareApplication ;
    schema1:alternateName "Genome annotation and visualisation package pertaining to Affymetrix arrays and NGS analysis." ;
    schema1:citation "doi:10.1093/nar/gkm779" ;
    schema1:description "annmap provides annotation mappings for Affymetrix exon arrays and coordinate based queries to support deep sequencing data analysis. Database access is hidden behind the API which provides a set of functions such as genesInRange(), geneToExon(), exonDetails(), etc. Functions to plot gene architecture and BAM file data are also provided. Underlying data are from Ensembl. The annmap database can be downloaded from: https://figshare.manchester.ac.uk/account/articles/16685071" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/annmap_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annmap/annmap_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annmap_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annmap/bioconductor-annmap_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:annmap" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-annmap" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/annmap.html" .

