@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-annmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkm779" ;
    schema:description "Genome annotation and visualisation package pertaining to Affymetrix arrays and NGS analysis." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/annmap_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/annmap/annmap_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/annmap_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-annmap/bioconductor-annmap_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genefilter",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "r-base",
        "r-dbi",
        "r-digest",
        "r-lattice",
        "r-rmysql" ;
    schema:identifier biotools:annmap ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-annmap" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/annmap.html" .

