@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lumi a schema:SoftwareApplication ;
    schema:description "BeadArray Specific Methods for Illumina Methylation and Expression Microarrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/lumi_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lumi/lumi_2.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/lumi_2.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lumi/bioconductor-lumi_2.62.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-methylumi",
        "bioconductor-preprocesscore",
        "r-base",
        "r-dbi",
        "r-kernsmooth",
        "r-lattice",
        "r-mass",
        "r-mgcv",
        "r-nleqslv",
        "r-rsqlite" ;
    schema:identifier biotools:lumi ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-lumi" ;
    schema:softwareVersion "2.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/lumi.html" .

