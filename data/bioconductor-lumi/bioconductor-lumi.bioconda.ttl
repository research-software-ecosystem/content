@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lumi a schema1:SoftwareApplication ;
    schema1:alternateName "BeadArray Specific Methods for Illumina Methylation and Expression Microarrays" ;
    schema1:description "The lumi package provides an integrated solution for the Illumina microarray data analysis. It includes functions of Illumina BeadStudio (GenomeStudio) data input, quality control, BeadArray-specific variance stabilization, normalization and gene annotation at the probe level. It also includes the functions of processing Illumina methylation microarrays, especially Illumina Infinium methylation microarrays." ;
    schema1:identifier biotools:lumi ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-lumi" ;
    schema1:softwareVersion "2.62.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/lumi.html" .

