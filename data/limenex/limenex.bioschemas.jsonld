      "sc:citation": [
        "pubmed:42306852",
        {
          "@id": "https://doi.org/10.1093/nar/gkag384"
        }
      ],
      "sc:description": "LiMeNEx (Lipid Metabolic Network Explorer) is an interactive webserver for exploring lipid biochemical gene-regulatory networks. Unlike existing pathway resources that focus solely on metabolic reactions, LiMeNEx integrates the upstream transcriptional regulatory layer, linking lipids, enzymes, and transcription factors in a single framework. It covers 504 curated biochemical reactions across 22 lipid pathways, involving 330 enzymatic genes and 345 transcription factors mapped across 50 human tissues and 11 physiological systems. Three consoles: Pathway, Reaction, and TF-Gene, let users query a lipid, enzyme, or transcription factor and get interactive network visualizations, literature-backed evidence tables, and exportable data (SVG/JSON/CSV), enabling system-level, hypothesis-driven investigation of lipid metabolism and related disorders.",
      "sc:isAccessibleForFree": true,
      "sc:name": "LimeNex",
      "sc:softwareHelp": {
        "@id": "https://limenex.raylab.iiitd.edu.in/tutorial"
      },
      "sc:softwareVersion": "1.0",
      "sc:url": "https://limenex.raylab.iiitd.edu.in/"
    }
  ]
