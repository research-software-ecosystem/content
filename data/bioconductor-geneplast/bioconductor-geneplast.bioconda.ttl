@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-geneplast a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Evolutionary and plasticity analysis of orthologous groups" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/geneplast_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneplast/geneplast_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneplast_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geneplast/bioconductor-geneplast_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "r-ape",
        "r-base",
        "r-data.table",
        "r-igraph",
        "r-snow" ;
    schema1:identifier biotools:geneplast ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-geneplast" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/geneplast.html" .

