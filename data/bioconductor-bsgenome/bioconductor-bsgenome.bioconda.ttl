@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bsgenome a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Software infrastructure for efficient representation of full genomes and their SNPs" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BSgenome_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BSgenome/BSgenome_1.78.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BSgenome_1.78.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bsgenome/bioconductor-bsgenome_1.78.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocio",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-xvector",
        "r-base",
        "r-matrixstats" ;
    schema:identifier biotools:bsgenome ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-bsgenome" ;
    schema:softwareVersion "1.78.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BSgenome.html" .

