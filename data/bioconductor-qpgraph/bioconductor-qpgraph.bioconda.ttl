@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-qpgraph a schema1:SoftwareApplication ;
    schema1:alternateName "Estimation of Genetic and Molecular Regulatory Networks from High-Throughput Genomics Data" ;
    schema1:description "Estimate gene and eQTL networks from high-throughput expression and genotyping assays." ;
    schema1:identifier <https://bio.tools/biotools:qpgraph> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-qpgraph" ;
    schema1:softwareVersion "2.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/qpgraph.html" .

