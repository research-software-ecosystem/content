@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:diamond a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-021-01101-x" ;
    schema:description "Accelerated BLAST compatible local sequence aligner." ;
    schema:hasPart "sqlite",
        "zlib",
        "zstd-static" ;
    schema:identifier biotools:diamond ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "diamond" ;
    schema:softwareHelp "https://github.com/bbuchfink/diamond/wiki" ;
    schema:softwareVersion "2.2.2" ;
    schema:url "https://github.com/bbuchfink/diamond" .

