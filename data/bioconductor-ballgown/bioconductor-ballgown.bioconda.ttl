@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ballgown a schema1:SoftwareApplication ;
    schema1:alternateName "Flexible, isoform-level differential expression analysis" ;
    schema1:citation "doi:10.1038/nbt.3172" ;
    schema1:description "Tools for statistical analysis of assembled transcriptomes, including flexible differential expression analysis, visualization of transcript structures, and matching of assembled transcripts to annotation." ;
    schema1:identifier biotools:ballgown ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ballgown" ;
    schema1:softwareVersion "2.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ballgown.html" .

