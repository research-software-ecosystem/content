@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ballgown a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nbt.3172" ;
    schema1:description "Flexible, isoform-level differential expression analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ballgown_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ballgown/ballgown_2.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ballgown_2.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ballgown/bioconductor-ballgown_2.42.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-sva",
        "r-base",
        "r-rcolorbrewer" ;
    schema1:identifier biotools:ballgown ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-ballgown" ;
    schema1:softwareVersion "2.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ballgown.html" .

