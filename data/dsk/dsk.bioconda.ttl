@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dsk a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt020" ;
    schema:description "DSK is a k-mer counter for reads or genomes." ;
    schema:downloadUrl "https://github.com/GATB/dsk/archive/v2.3.3.tar.gz" ;
    schema:hasPart "cppunit",
        "zlib" ;
    schema:identifier biotools:dsk ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "dsk" ;
    schema:softwareVersion "2.3.3" ;
    schema:url "https://github.com/GATB/dsk" .

