@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:nxtrim a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv057" ;
    schema:description "Software to remove Nextera Mate Pair adapters and categorise reads according to the orientation implied by the adapter location." ;
    schema:downloadUrl "https://github.com/sequencing/NxTrim/archive/v0.4.3.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:nxtrim ;
    schema:license "BSD-2-Clause" ;
    schema:name "nxtrim" ;
    schema:softwareHelp "https://github.com/sequencing/NxTrim" ;
    schema:softwareVersion "0.4.3" ;
    schema:url "https://github.com/sequencing/NxTrim" .

