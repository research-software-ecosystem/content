@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-risa a schema:SoftwareApplication ;
    schema:description "Converting experimental metadata from ISA-tab into Bioconductor data structures" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Risa_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/Risa/Risa_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Risa_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-risa/bioconductor-risa_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-biocviews",
        "bioconductor-xcms",
        "libblas",
        "liblapack",
        "r-base",
        "r-rcpp" ;
    schema:identifier biotools:risa ;
    schema:license "LGPL" ;
    schema:name "bioconductor-risa" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/Risa.html" .

