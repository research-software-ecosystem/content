@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-simat a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-015-0681-2" ;
    schema:description "GC-SIM-MS data processing and alaysis tool" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SIMAT_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SIMAT/SIMAT_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SIMAT_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-simat/bioconductor-simat_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-mzr",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-ggplot2",
        "r-rcpp",
        "r-reshape2",
        "zlib" ;
    schema:identifier biotools:simat ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-simat" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SIMAT.html" .

