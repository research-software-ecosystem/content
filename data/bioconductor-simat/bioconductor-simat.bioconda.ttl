@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-simat a schema1:SoftwareApplication ;
    schema1:alternateName "GC-SIM-MS data processing and alaysis tool" ;
    schema1:citation "doi:10.1186/s12859-015-0681-2" ;
    schema1:description "This package provides a pipeline for analysis of GC-MS data acquired in selected ion monitoring (SIM) mode. The tool also provides a guidance in choosing appropriate fragments for the targets of interest by using an optimization algorithm. This is done by considering overlapping peaks from a provided library by the user." ;
    schema1:identifier <https://bio.tools/biotools:simat> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-simat" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SIMAT.html" .

