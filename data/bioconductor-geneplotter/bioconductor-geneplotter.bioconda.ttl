@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-geneplotter a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Graphics related functions for Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/geneplotter_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneplotter/geneplotter_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneplotter_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geneplotter/bioconductor-geneplotter_1.88.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "r-base",
        "r-lattice",
        "r-rcolorbrewer" ;
    schema:identifier biotools:geneplotter ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-geneplotter" ;
    schema:softwareVersion "1.88.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/geneplotter.html" .

