@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-geneplotter a schema1:SoftwareApplication ;
    schema1:alternateName "Graphics related functions for Bioconductor" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for plotting genomic data" ;
    schema1:identifier <https://bio.tools/biotools:geneplotter> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-geneplotter" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/geneplotter.html" .

