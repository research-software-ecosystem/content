@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-timecourse a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Statistical Analysis for Developmental Microarray Time Course Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/timecourse_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/timecourse/timecourse_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/timecourse_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-timecourse/bioconductor-timecourse_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-limma",
        "bioconductor-marray",
        "r-base",
        "r-mass" ;
    schema:identifier biotools:timecourse ;
    schema:license "LGPL" ;
    schema:name "bioconductor-timecourse" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/timecourse.html" .

