@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-timecourse a schema1:SoftwareApplication ;
    schema1:alternateName "Statistical Analysis for Developmental Microarray Time Course Data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions for data analysis and graphical displays for developmental microarray time course data." ;
    schema1:identifier <https://bio.tools/biotools:timecourse> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-timecourse" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/timecourse.html" .

