@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:wtdbg a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41592-019-0669-3" ;
    schema:description "Wtdbg2: A fuzzy Bruijn graph approach to long noisy reads assembly." ;
    schema:downloadUrl "https://github.com/ruanjue/wtdbg2/archive/v2.5.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:wtdbg2 ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "wtdbg" ;
    schema:softwareHelp "https://github.com/ruanjue/wtdbg2/blob/v2.5/README.md" ;
    schema:softwareVersion "2.5" ;
    schema:url "https://github.com/ruanjue/wtdbg2" .

