@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-made4 a schema1:SoftwareApplication ;
    schema1:alternateName "Multivariate analysis of microarray data using ADE4" ;
    schema1:description "Multivariate data analysis and graphical display of microarray data. Functions include for supervised dimension reduction (between group analysis) and joint dimension reduction of 2 datasets (coinertia analysis). It contains functions that require R package ade4." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/made4_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/made4/made4_1.84.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/made4_1.84.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-made4/bioconductor-made4_1.84.0_src_all.tar.gz" ;
    schema1:identifier "biotools:made4" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-made4" ;
    schema1:softwareVersion "1.84.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/made4.html" .

