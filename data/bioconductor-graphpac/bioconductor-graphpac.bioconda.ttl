@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-graphpac a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-15-86" ;
    schema:description "Identification of Mutational Clusters in Proteins via a Graph Theoretical Approach." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GraphPAC_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/GraphPAC/GraphPAC_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/GraphPAC_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-graphpac/bioconductor-graphpac_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-ipac",
        "r-base",
        "r-igraph",
        "r-rmallow",
        "r-tsp" ;
    schema:identifier biotools:graphpac ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-graphpac" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/GraphPAC.html" .

