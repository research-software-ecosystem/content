@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-graphpac a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of Mutational Clusters in Proteins via a Graph Theoretical Approach." ;
    schema1:citation "doi:10.1186/1471-2105-15-86" ;
    schema1:description "Identifies mutational clusters of amino acids in a protein while utilizing the proteins tertiary structure via a graph theoretical model." ;
    schema1:identifier biotools:graphpac ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-graphpac" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/GraphPAC.html" .

