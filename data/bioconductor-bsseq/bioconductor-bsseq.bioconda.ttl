@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bsseq a schema1:SoftwareApplication ;
    schema1:description "Analyze, manage and store whole-genome methylation data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/bsseq_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bsseq/bsseq_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bsseq_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bsseq/bioconductor-bsseq_1.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-assorthead",
        "bioconductor-beachmat",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-bsgenome",
        "bioconductor-delayedarray",
        "bioconductor-delayedmatrixstats",
        "bioconductor-genomicranges",
        "bioconductor-hdf5array",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rhdf5",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-gtools",
        "r-locfit",
        "r-permute",
        "r-r.utils",
        "r-rcpp",
        "r-scales",
        "zlib" ;
    schema1:identifier biotools:bsseq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-bsseq" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bsseq.html" .

