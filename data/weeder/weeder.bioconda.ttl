@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:weeder a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/0471250953.bi0211s47" ;
    schema:description "Motif (transcription factor binding sites) discovery in sequences from coregulated genes of a single species. This is a new Weeder release rewritten to be faster and optimized for large ChIP-Seq data." ;
    schema:downloadUrl "http://159.149.160.88/modtools/downloads/weeder2.0.tar.gz" ;
    schema:identifier biotools:weeder ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "weeder" ;
    schema:softwareHelp "http://159.149.160.88/modtools" ;
    schema:softwareVersion "2.0" ;
    schema:url "http://159.149.160.88/modtools" .

