@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:recentrifuge a schema:SoftwareApplication ;
    schema:author "khyox",
        "thanhleviet" ;
    schema:citation "doi:10.1371/journal.pcbi.1006967" ;
    schema:description "Robust comparative analysis and contamination removal for metagenomics." ;
    schema:downloadUrl "https://github.com/khyox/recentrifuge/archive/v2.1.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:Recentrifuge ;
    schema:license "AGPL-3.0-or-later" ;
    schema:maintainer "khyox",
        "thanhleviet" ;
    schema:name "recentrifuge" ;
    schema:softwareHelp "https://github.com/khyox/recentrifuge/wiki" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "https://github.com/khyox/recentrifuge" .

