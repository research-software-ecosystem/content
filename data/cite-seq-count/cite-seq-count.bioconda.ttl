@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cite-seq-count a schema:SoftwareApplication ;
    schema:author "acaprez" ;
    schema:citation "doi:10.5281/zenodo.2590196" ;
    schema:description "A python package to map reads from CITE-seq or hashing data for single cell experiments." ;
    schema:downloadUrl "https://pypi.io/packages/source/C/CITE-seq-Count/CITE-seq-Count-1.4.4.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:CITE-seq-Count ;
    schema:license "MIT" ;
    schema:maintainer "acaprez" ;
    schema:name "cite-seq-count" ;
    schema:softwareHelp "https://hoohm.github.io/CITE-seq-Count" ;
    schema:softwareVersion "1.4.5" ;
    schema:url "https://hoohm.github.io/CITE-seq-Count" .

