@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:meme a schema1:SoftwareApplication ;
    bioschemas:output "gff",
        "html",
        "memepsp",
        "memexml",
        "tabular",
        "txt" ;
    schema1:applicationSubCategory edam:topic_0154,
        edam:topic_0160,
        edam:topic_3169,
        edam:topic_3295,
        edam:topic_3794 ;
    schema1:codeRepository "http://meme-suite.org/" ;
    schema1:dateCreated "2015-12-13" ;
    schema1:description "The MEME Suite allows the biologist to discover novel motifs in collections of unaligned nucleotideor protein sequences, and to perform a wide variety of other motif-based analyses." ;
    schema1:encodingFormat "gff",
        "html",
        "memepsp",
        "memexml",
        "tabular",
        "txt" ;
    schema1:featureList edam:operation_0238,
        edam:operation_0239,
        edam:operation_0240,
        edam:operation_0438 ;
    schema1:identifier biotools:streme,
        bioconda:meme ;
    schema1:isPartOf <https://usegalaxy.org>,
        <https://usegalaxy.org/published/workflow?id=2049d38325423cfe>,
        <https://usegalaxy.org/published/workflow?id=ecb279a9114140ab> ;
    schema1:keywords "ChIP-seq" ;
    schema1:name "meme" ;
    schema1:softwareVersion "5.5.8" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/meme" .

