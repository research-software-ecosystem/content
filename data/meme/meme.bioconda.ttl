@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:meme a schema1:SoftwareApplication ;
    schema1:alternateName "Motif-based sequence analysis tools." ;
    schema1:citation "doi:10.1093/nar/gkv416" ;
    schema1:description "Motif-based sequence analysis tools." ;
    schema1:identifier <https://bio.tools/biotools:meme_suite>,
        "usegalaxy-eu:meme_dreme" ;
    schema1:license "Custom" ;
    schema1:name "meme" ;
    schema1:softwareVersion "5.5.9" ;
    schema1:url "https://meme-suite.org" .

