@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:meme a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkv416" ;
    schema:description "Motif-based sequence analysis tools." ;
    schema:downloadUrl "https://meme-suite.org/meme/meme-software/5.5.9/meme-5.5.9.tar.gz" ;
    schema:hasPart "expat",
        "ghostscript",
        "icu",
        "libgomp",
        "libxml2",
        "libxslt",
        "llvm-openmp",
        "perl",
        "zlib" ;
    schema:identifier biotools:meme_suite ;
    schema:license "Custom" ;
    schema:name "meme" ;
    schema:softwareHelp "https://meme-suite.org/meme/doc/overview.html" ;
    schema:softwareVersion "5.5.9" ;
    schema:url "https://meme-suite.org" .

