@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-protgenerics a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Generic infrastructure for Bioconductor mass spectrometry packages" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ProtGenerics_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ProtGenerics/ProtGenerics_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ProtGenerics_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-protgenerics/bioconductor-protgenerics_1.42.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:protgenerics ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-protgenerics" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ProtGenerics.html" .

