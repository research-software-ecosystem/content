@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-protgenerics a schema1:SoftwareApplication ;
    schema1:alternateName "Generic infrastructure for Bioconductor mass spectrometry packages" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "S4 generic functions and classes needed by Bioconductor proteomics packages." ;
    schema1:identifier biotools:protgenerics ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-protgenerics" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ProtGenerics.html" .

