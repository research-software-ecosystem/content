@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-lola a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btv612" ;
    schema1:description "Locus overlap analysis for enrichment of genomic ranges" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/LOLA_1.40.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LOLA/LOLA_1.40.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/LOLA_1.40.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lola/bioconductor-lola_1.40.1_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "r-base",
        "r-data.table",
        "r-reshape2" ;
    schema1:identifier biotools:lola ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-lola" ;
    schema1:softwareVersion "1.40.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/LOLA.html" .

