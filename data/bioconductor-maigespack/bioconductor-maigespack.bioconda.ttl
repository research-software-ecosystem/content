@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-maigespack a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions to handle cDNA microarray data, including several methods of data analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/maigesPack_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/maigesPack/maigesPack_1.64.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/maigesPack_1.64.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-maigespack/bioconductor-maigespack_1.64.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-convert",
        "bioconductor-graph",
        "bioconductor-limma",
        "bioconductor-marray",
        "libblas",
        "liblapack",
        "r-base" ;
    schema1:identifier biotools:maigespack ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "bioconductor-maigespack" ;
    schema1:softwareVersion "1.64.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/maigesPack.html" .

