@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cma a schema1:SoftwareApplication ;
    schema1:alternateName "Synthesis of microarray-based classification" ;
    schema1:citation "doi:10.1186/1471-2105-9-439" ;
    schema1:description "This package provides a comprehensive collection of various microarray-based classification algorithms both from Machine Learning and Statistics. Variable Selection, Hyperparameter tuning, Evaluation and Comparison can be performed combined or stepwise in a user-friendly environment." ;
    schema1:identifier <https://bio.tools/biotools:cma> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-cma" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CMA.html" .

