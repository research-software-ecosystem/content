@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cma a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-9-439" ;
    schema:description "Synthesis of microarray-based classification" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CMA_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CMA/CMA_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CMA_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cma/bioconductor-cma_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:cma ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-cma" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CMA.html" .

