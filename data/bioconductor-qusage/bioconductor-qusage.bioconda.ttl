@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-qusage a schema:SoftwareApplication ;
    schema:description "qusage: Quantitative Set Analysis for Gene Expression" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/qusage_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/qusage/qusage_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/qusage_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-qusage/bioconductor-qusage_2.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-limma",
        "r-base",
        "r-emmeans",
        "r-fftw",
        "r-nlme" ;
    schema:identifier biotools:qusage ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-qusage" ;
    schema:softwareVersion "2.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/qusage.html" .

