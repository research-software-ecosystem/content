@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-macat a schema1:SoftwareApplication ;
    schema1:alternateName "MicroArray Chromosome Analysis Tool" ;
    schema1:description "This library contains functions to investigate links between differential gene expression and the chromosomal localization of the genes. MACAT is motivated by the common observation of phenomena involving large chromosomal regions in tumor cells. MACAT is the implementation of a statistical approach for identifying significantly differentially expressed chromosome regions. The functions have been tested on a publicly available data set about acute lymphoblastic leukemia (Yeoh et al.Cancer Cell 2002), which is provided in the library 'stjudem'." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/macat_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/macat/macat_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/macat_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-macat/bioconductor-macat_1.76.0_src_all.tar.gz" ;
    schema1:identifier "biotools:macat" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-macat" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/macat.html" .

