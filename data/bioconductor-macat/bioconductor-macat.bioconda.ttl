@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-macat a schema:SoftwareApplication ;
    schema:description "MicroArray Chromosome Analysis Tool" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/macat_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/macat/macat_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/macat_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-macat/bioconductor-macat_1.76.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotate",
        "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:macat ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-macat" ;
    schema:softwareVersion "1.76.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/macat.html" .

