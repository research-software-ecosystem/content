@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-quartpac a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s12859-016-0963-3" ;
    schema:description "Identification of mutational clusters in protein quaternary structures." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/QuartPAC_1.34.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/QuartPAC/QuartPAC_1.34.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/QuartPAC_1.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-quartpac/bioconductor-quartpac_1.34.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graphpac",
        "bioconductor-ipac",
        "bioconductor-spacepac",
        "r-base",
        "r-data.table" ;
    schema:identifier biotools:quartpac ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-quartpac" ;
    schema:softwareVersion "1.34.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/QuartPAC.html" .

