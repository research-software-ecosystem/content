@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-quartpac a schema1:SoftwareApplication ;
    schema1:alternateName "Identification of mutational clusters in protein quaternary structures." ;
    schema1:citation "doi:10.1186/s12859-016-0963-3" ;
    schema1:description "Identifies clustering of somatic mutations in proteins over the entire quaternary structure." ;
    schema1:identifier biotools:quartpac ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-quartpac" ;
    schema1:softwareVersion "1.34.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/QuartPAC.html" .

