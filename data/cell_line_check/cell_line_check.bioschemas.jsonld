      "sc:citation": {
        "@id": "https://doi.org/10.6084/m9.figshare.34965349"
      },
      "sc:description": "Checks whether a cancer cell line's genotype labels hold. For each line and gene it reads every DepMap sequencing entry of the model, relative copy number, RNA expression, CRISPR gene-effect readouts and Cellosaurus curated records, and says whether a wild-type label is supported, questioned or contradicted, with identity warnings for misidentified, contaminated and same-patient lines. Free for 5 lines and 10 genes per check (verdicts); paid plans add the evidence behind each verdict, whole panels, CSV, a methods paragraph and an API. Built on DepMap Public 24Q4 and Cellosaurus (both CC BY 4.0).",
      "sc:featureList": [
        {
          "@id": "edam:operation_3196"
        },
        {
          "@id": "edam:operation_2428"
        }
      ],
      "sc:isAccessibleForFree": true,
      "sc:license": "Proprietary",
      "sc:name": "Cell Line Check",
      "sc:provider": "Cybergenic",
      "sc:softwareHelp": [
        {
          "@id": "https://cybergenic.im/blog/cell-line-wild-type-labels-depmap"
