@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-oscope a schema1:SoftwareApplication ;
    schema1:alternateName "Oscope - A statistical pipeline for identifying oscillatory genes in unsynchronized single cell RNA-seq" ;
    schema1:citation "doi:10.1038/nmeth.3549" ;
    schema1:description "Oscope is a statistical pipeline developed to identifying and recovering the base cycle profiles of oscillating genes in an unsynchronized single cell RNA-seq experiment. The Oscope pipeline includes three modules: a sine model module to search for candidate oscillator pairs; a K-medoids clustering module to cluster candidate oscillators into groups; and an extended nearest insertion module to recover the base cycle order for each oscillator group." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Oscope_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Oscope/Oscope_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Oscope_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-oscope/bioconductor-oscope_1.40.0_src_all.tar.gz" ;
    schema1:identifier "biotools:oscope" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-oscope" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Oscope.html" .

