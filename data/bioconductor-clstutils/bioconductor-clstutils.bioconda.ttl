@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clstutils a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for performing taxonomic assignment" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Tools for performing taxonomic assignment based on phylogeny using pplacer and clst." ;
    schema1:identifier biotools:clstutils ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-clstutils" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clstutils.html" .

