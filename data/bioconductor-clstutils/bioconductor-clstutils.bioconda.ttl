@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clstutils a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Tools for performing taxonomic assignment" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/clstutils_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clstutils/clstutils_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clstutils_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clstutils/bioconductor-clstutils_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-clst",
        "r-ape",
        "r-base",
        "r-lattice",
        "r-rjson",
        "r-rsqlite" ;
    schema:identifier biotools:clstutils ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-clstutils" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/clstutils.html" .

