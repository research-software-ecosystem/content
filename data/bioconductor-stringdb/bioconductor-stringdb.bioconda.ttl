@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-stringdb a schema1:SoftwareApplication ;
    schema1:description "STRINGdb - Protein-Protein Interaction Networks and Functional Enrichment Analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/STRINGdb_2.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/STRINGdb/STRINGdb_2.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/STRINGdb_2.22.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-stringdb/bioconductor-stringdb_2.22.0_src_all.tar.gz" ;
    schema1:hasPart "r-base",
        "r-gplots",
        "r-hash",
        "r-httr",
        "r-igraph",
        "r-plotrix",
        "r-plyr",
        "r-png",
        "r-rcolorbrewer",
        "r-sqldf" ;
    schema1:identifier biotools:stringdb ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-stringdb" ;
    schema1:softwareVersion "2.22.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/STRINGdb.html" .

