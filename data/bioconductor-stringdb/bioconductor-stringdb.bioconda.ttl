@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-stringdb a schema1:SoftwareApplication ;
    schema1:alternateName "STRINGdb - Protein-Protein Interaction Networks and Functional Enrichment Analysis" ;
    schema1:description "The STRINGdb package provides a R interface to the STRING protein-protein interactions database (https://string-db.org)." ;
    schema1:identifier biotools:stringdb ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-stringdb" ;
    schema1:softwareVersion "2.22.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/STRINGdb.html" .

