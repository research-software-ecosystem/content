                    },
                    "format": [
                        {
                            "term": "TSV",
                            "uri": "http://edamontology.org/format_3475"
                        },
                        {
                            "term": "YAML",
                            "uri": "http://edamontology.org/format_3750"
                        }
                    ]
                }
            ],
            "note": "Classifies one variant from a YAML file of evidence, using the 2024 AVCG criteria and decision rules. Add --batch for a TSV file with one variant per row, --json for JSON output, or --report for a one-page Markdown report.",
