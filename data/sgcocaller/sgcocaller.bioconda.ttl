@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sgcocaller a schema:SoftwareApplication ;
    schema:description "Personalized haplotype construction and crossover calling in single-cell DNA sequenced gamete cells." ;
    schema:downloadUrl "https://github.com/ruqianl/sgcocaller/archive/refs/tags/v0.3.9.tar.gz" ;
    schema:hasPart "bzip2",
        "f2c",
        "htslib",
        "pcre",
        "zlib" ;
    schema:identifier biotools:sgcocaller ;
    schema:license "MIT" ;
    schema:name "sgcocaller" ;
    schema:softwareHelp "https://gitlab.svi.edu.au/biocellgen-public/sgcocaller" ;
    schema:softwareVersion "0.3.9" ;
    schema:url "https://gitlab.svi.edu.au/biocellgen-public/sgcocaller" .

