@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:sgcocaller a schema1:SoftwareApplication ;
    schema1:alternateName "Personalized haplotype construction and crossover calling in single-cell DNA sequenced gamete cells." ;
    schema1:description "Personalized haplotype construction and crossover calling in single-cell DNA sequenced gamete cells." ;
    schema1:identifier <https://bio.tools/biotools:sgcocaller> ;
    schema1:license "MIT" ;
    schema1:name "sgcocaller" ;
    schema1:softwareVersion "0.3.9" ;
    schema1:url "https://gitlab.svi.edu.au/biocellgen-public/sgcocaller" .

