@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mast a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/s13059-015-0844-5" ;
    schema:description "Model-based Analysis of Single Cell Transcriptomics" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MAST_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MAST/MAST_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MAST_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mast/bioconductor-mast_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-s4vectors",
        "bioconductor-singlecellexperiment",
        "bioconductor-summarizedexperiment",
        "r-abind",
        "r-base",
        "r-data.table",
        "r-ggplot2",
        "r-matrix",
        "r-plyr",
        "r-progress",
        "r-reshape2",
        "r-stringr" ;
    schema:identifier biotools:mast ;
    schema:license "GPL(>= 2)" ;
    schema:name "bioconductor-mast" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MAST.html" .

