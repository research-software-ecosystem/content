@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mast a schema1:SoftwareApplication ;
    schema1:alternateName "Model-based Analysis of Single Cell Transcriptomics" ;
    schema1:citation "doi:10.1186/s13059-015-0844-5" ;
    schema1:description "Methods and models for handling zero-inflated single cell assay data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MAST_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MAST/MAST_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MAST_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mast/bioconductor-mast_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mast" ;
    schema1:license "GPL(>= 2)" ;
    schema1:name "bioconductor-mast" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MAST.html" .

