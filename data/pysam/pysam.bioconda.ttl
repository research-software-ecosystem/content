@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pysam a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp352" ;
    schema:description "Pysam is a Python module for reading and manipulating SAM/BAM/VCF/BCF files. It's a lightweight wrapper of the htslib C-API, the same one that powers samtools, bcftools, and tabix." ;
    schema:downloadUrl "https://github.com/pysam-developers/pysam/archive/v0.24.0.tar.gz" ;
    schema:hasPart "bzip2",
        "cython",
        "libcurl",
        "libdeflate",
        "openssl",
        "python",
        "setuptools",
        "xz",
        "zlib" ;
    schema:identifier biotools:pysam ;
    schema:license "MIT" ;
    schema:name "pysam" ;
    schema:softwareVersion "0.24.0" ;
    schema:url "https://github.com/pysam-developers/pysam" .

