@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:pysam a schema1:SoftwareApplication ;
    schema1:alternateName "Pysam is a Python module for reading and manipulating SAM/BAM/VCF/BCF files. It's a lightweight wrapper of the htslib C-API, the same one that powers samtools, bcftools, and tabix." ;
    schema1:citation "doi:10.1093/bioinformatics/btp352" ;
    schema1:description "Pysam is a Python module for reading and manipulating SAM/BAM/VCF/BCF files. It's a lightweight wrapper of the htslib C-API, the same one that powers samtools, bcftools, and tabix." ;
    schema1:identifier biotools:pysam ;
    schema1:license "MIT" ;
    schema1:name "pysam" ;
    schema1:softwareVersion "0.24.0" ;
    schema1:url "https://github.com/pysam-developers/pysam" .

