@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-anota a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr146" ;
    schema:description "ANalysis Of Translational Activity (ANOTA)." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/anota_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/anota/anota_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/anota_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-anota/bioconductor-anota_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-multtest",
        "bioconductor-qvalue",
        "r-base" ;
    schema:identifier biotools:anota ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-anota" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/anota.html" .

