@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-panp a schema:SoftwareApplication ;
    schema:citation "doi:10.1109/BIBE.2007.4375552" ;
    schema:description "Presence-Absence Calls from Negative Strand Matching Probesets" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/panp_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/panp/panp_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/panp_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-panp/bioconductor-panp_1.80.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:panp ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-panp" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/panp.html" .

