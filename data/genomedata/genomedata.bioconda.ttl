@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:genomedata a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btq164" ;
    schema:description "Tools for accessing large amounts of genomic data." ;
    schema:downloadUrl "https://pypi.org/packages/source/g/genomedata/genomedata-1.7.4.tar.gz" ;
    schema:hasPart "hdf5",
        "pip",
        "python",
        "setuptools_scm",
        "zlib" ;
    schema:identifier biotools:genomedata ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "genomedata" ;
    schema:softwareHelp "https://genomedata.readthedocs.io/en/latest" ;
    schema:softwareVersion "1.7.4" ;
    schema:url "http://genomedata.hoffmanlab.org" .

