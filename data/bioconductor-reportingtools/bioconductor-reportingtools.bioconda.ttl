@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-reportingtools a schema1:SoftwareApplication ;
    schema1:description "Tools for making reports in various formats" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ReportingTools_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ReportingTools/ReportingTools_2.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ReportingTools_2.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-reportingtools/bioconductor-reportingtools_2.50.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotate",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-category",
        "bioconductor-deseq2",
        "bioconductor-edger",
        "bioconductor-ggbio",
        "bioconductor-gostats",
        "bioconductor-gseabase",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-pfam.db",
        "r-base",
        "r-ggplot2",
        "r-hwriter",
        "r-knitr",
        "r-lattice",
        "r-r.utils",
        "r-xml" ;
    schema1:identifier biotools:reportingtools ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-reportingtools" ;
    schema1:softwareVersion "2.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ReportingTools.html" .

