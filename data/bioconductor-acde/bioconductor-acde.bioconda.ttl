@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-acde a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-0-387-49317-6_9" ;
    schema:description "Artificial Components Detection of Differentially Expressed Genes" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/acde_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/acde/acde_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/acde_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-acde/bioconductor-acde_1.40.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-boot" ;
    schema:identifier biotools:acde ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-acde" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/acde.html" .

