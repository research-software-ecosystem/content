@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-acde a schema1:SoftwareApplication ;
    schema1:alternateName "Artificial Components Detection of Differentially Expressed Genes" ;
    schema1:citation "doi:10.1007/978-0-387-49317-6_9" ;
    schema1:description "This package provides a multivariate inferential analysis method for detecting differentially expressed genes in gene expression data. It uses artificial components, close to the data's principal components but with an exact interpretation in terms of differential genetic expression, to identify differentially expressed genes while controlling the false discovery rate (FDR). The methods on this package are described in the vignette or in the article 'Multivariate Method for Inferential Identification of Differentially Expressed Genes in Gene Expression Experiments' by J. P. Acosta, L. Lopez-Kleine and S. Restrepo (2015, pending publication)." ;
    schema1:identifier biotools:acde ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-acde" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/acde.html" .

