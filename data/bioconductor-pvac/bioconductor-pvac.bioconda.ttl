@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pvac a schema1:SoftwareApplication ;
    schema1:alternateName "PCA-based gene filtering for Affymetrix arrays" ;
    schema1:citation "doi:10.1093/nar/gkr241" ;
    schema1:description "The package contains the function for filtering genes by the proportion of variation accounted for by the first principal component (PVAC)." ;
    schema1:identifier <https://bio.tools/biotools:pvac> ;
    schema1:license "LGPL (>= 2.0)" ;
    schema1:name "bioconductor-pvac" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pvac.html" .

