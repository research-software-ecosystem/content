@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pvac a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkr241" ;
    schema:description "PCA-based gene filtering for Affymetrix arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pvac_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pvac/pvac_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pvac_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pvac/bioconductor-pvac_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:pvac ;
    schema:license "LGPL (>= 2.0)" ;
    schema:name "bioconductor-pvac" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/pvac.html" .

