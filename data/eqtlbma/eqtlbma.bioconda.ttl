@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:eqtlbma a schema:SoftwareApplication ;
    schema:description "Package to detect eQTLs jointly in multiple subgroups (e.g. tissues) via Bayesian Model Averaging." ;
    schema:downloadUrl "https://github.com/timflutre/eqtlbma/archive/v1.3.3.tar.gz" ;
    schema:hasPart "gsl",
        "openblas",
        "perl",
        "texinfo",
        "zlib" ;
    schema:identifier biotools:eQtlBma ;
    schema:license "GPLv3" ;
    schema:name "eqtlbma" ;
    schema:softwareVersion "1.3.3" ;
    schema:url "https://github.com/timflutre/eqtlbma" .

