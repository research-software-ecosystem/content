@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pwomics a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv323" ;
    schema:description "Pathway-based data integration of omics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/pwOmics_1.34.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/pwOmics/pwOmics_1.34.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/pwOmics_1.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pwomics/bioconductor-pwomics_1.34.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-annotationhub",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-genomicranges",
        "bioconductor-graph",
        "bioconductor-rbiopaxparser",
        "bioconductor-stringdb",
        "r-base",
        "r-data.table",
        "r-gplots",
        "r-igraph" ;
    schema:identifier biotools:pwomics ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-pwomics" ;
    schema:softwareVersion "1.34.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/pwOmics.html" .

