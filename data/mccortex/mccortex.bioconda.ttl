@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mccortex a schema:SoftwareApplication ;
    schema:description "De novo genome assembly and multisample variant calling." ;
    schema:downloadUrl "https://github.com/mcveanlab/mccortex/releases/download/mccortex-1.0/mccortex1_0.tar.gz" ;
    schema:hasPart "bzip2",
        "libcurl",
        "libdeflate",
        "xz",
        "zlib" ;
    schema:identifier biotools:mccortex ;
    schema:license "MIT" ;
    schema:name "mccortex" ;
    schema:softwareHelp "https://github.com/mcveanlab/mccortex/wiki" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://github.com/mcveanlab/mccortex" .

