@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:foldseek a schema:SoftwareApplication ;
    schema:author "martin-steinegger",
        "milot-mirdita" ;
    schema:citation "doi:10.1038/s41586-023-06510-w",
        "doi:10.1038/s41587-023-01773-0",
        "doi:10.1101/2024.04.14.589414" ;
    schema:description "Foldseek: fast and accurate protein structure search" ;
    schema:downloadUrl "https://github.com/steineggerlab/foldseek/archive/10-941cd33.tar.gz" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:foldseek ;
    schema:license "GPL-3" ;
    schema:maintainer "martin-steinegger",
        "milot-mirdita" ;
    schema:name "foldseek" ;
    schema:softwareVersion "10.941cd33" ;
    schema:url "https://github.com/steineggerlab/foldseek" .

