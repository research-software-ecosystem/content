@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ssake a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btl629" ;
    schema:description "SSAKE is a genomics application for de novo assembly of millions of very short DNA sequences." ;
    schema:downloadUrl "https://github.com/warrenlr/SSAKE/archive/v4.0.tar.gz" ;
    schema:identifier biotools:ssake ;
    schema:license "GPL-2.0" ;
    schema:name "ssake" ;
    schema:softwareVersion "4.0" ;
    schema:url "https://github.com/warrenlr/SSAKE" .

