@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gpa a schema:SoftwareApplication ;
    schema:description "GPA (Genetic analysis incorporating Pleiotropy and Annotation)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GPA_1.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GPA/GPA_1.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GPA_1.22.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gpa/bioconductor-gpa_1.22.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dt",
        "r-ggplot2",
        "r-ggrepel",
        "r-plyr",
        "r-rcpp",
        "r-shiny",
        "r-shinybs",
        "r-vegan",
        "zlib" ;
    schema:identifier biotools:GPA ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-gpa" ;
    schema:softwareVersion "1.22.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GPA.html" .

