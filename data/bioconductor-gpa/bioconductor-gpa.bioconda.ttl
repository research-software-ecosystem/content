@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gpa a schema1:SoftwareApplication ;
    schema1:alternateName "GPA (Genetic analysis incorporating Pleiotropy and Annotation)" ;
    schema1:description "This package provides functions for fitting GPA, a statistical framework to prioritize GWAS results by integrating pleiotropy information and annotation data. In addition, it also includes ShinyGPA, an interactive visualization toolkit to investigate pleiotropic architecture." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GPA_1.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GPA/GPA_1.22.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GPA_1.22.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gpa/bioconductor-gpa_1.22.0_src_all.tar.gz" ;
    schema1:identifier "biotools:GPA" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-gpa" ;
    schema1:softwareVersion "1.22.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GPA.html" .

