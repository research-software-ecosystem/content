@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:flexbar a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btx330",
        "doi:10.3390/biology1030895" ;
    schema:description "Flexible barcode and adapter removal." ;
    schema:downloadUrl "https://github.com/seqan/flexbar/archive/v3.5.0.tar.gz" ;
    schema:hasPart "bzip2",
        "seqan-library",
        "tbb-devel",
        "wget",
        "zlib" ;
    schema:identifier biotools:flexbar ;
    schema:license "BSD-3-Clause" ;
    schema:name "flexbar" ;
    schema:softwareHelp "https://github.com/seqan/flexbar/wiki" ;
    schema:softwareVersion "3.5.0" ;
    schema:url "https://github.com/seqan/flexbar" .

