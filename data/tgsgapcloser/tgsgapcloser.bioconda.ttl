@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tgsgapcloser a schema:SoftwareApplication ;
    schema:author "cchd0001" ;
    schema:citation "doi:10.1093/gigascience/giaa094" ;
    schema:description "A gap-closing software tool that uses error-prone long reads generated by third-generation-sequence techniques (Pacbio, Oxford Nanopore, etc.) or preassembled contigs to fill N-gap in the genome assembly." ;
    schema:downloadUrl "https://github.com/BGI-Qingdao/TGS-GapCloser/releases/download/v1.2.1/TGS-GapCloser-1.2.1_ml.zip" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:TGS-GapCloser ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "cchd0001" ;
    schema:name "tgsgapcloser" ;
    schema:softwareHelp "https://github.com/BGI-Qingdao/TGS-GapCloser/blob/v1.2.1/README.md" ;
    schema:softwareVersion "1.2.1" ;
    schema:url "https://github.com/BGI-Qingdao/TGS-GapCloser" .

