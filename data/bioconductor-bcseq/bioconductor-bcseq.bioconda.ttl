@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-bcseq a schema1:SoftwareApplication ;
    schema1:alternateName "Fast Sequence Mapping in High-Throughput shRNA and CRISPR Screens" ;
    schema1:description "This Rcpp-based package implements a highly efficient data structure and algorithm for performing alignment of short reads from CRISPR or shRNA screens to reference barcode library. Sequencing error are considered and matching qualities are evaluated based on Phred scores. A Bayes' classifier is employed to predict the originating barcode of a read. The package supports provision of user-defined probability models for evaluating matching qualities. The package also supports multi-threading." ;
    schema1:identifier biotools:bcSeq ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-bcseq" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bcSeq.html" .

