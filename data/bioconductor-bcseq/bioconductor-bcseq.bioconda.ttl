@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bcseq a schema:SoftwareApplication ;
    schema:description "Fast Sequence Mapping in High-Throughput shRNA and CRISPR Screens" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/bcSeq_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bcSeq/bcSeq_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bcSeq_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bcseq/bioconductor-bcseq_1.32.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-matrix",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:bcSeq ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-bcseq" ;
    schema:softwareVersion "1.32.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/bcSeq.html" .

