@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-splots a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Visualization of high-throughput assays in microtitre plate or slide format" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/splots_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/splots/splots_1.76.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/splots_1.76.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-splots/bioconductor-splots_1.76.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:splots ;
    schema:license "LGPL" ;
    schema:name "bioconductor-splots" ;
    schema:softwareVersion "1.76.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/splots.html" .

