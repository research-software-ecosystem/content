@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-splots a schema1:SoftwareApplication ;
    schema1:alternateName "Visualization of high-throughput assays in microtitre plate or slide format" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package is here to support legacy usages of it, but it should not be used for new code development. It provides a single function, plotScreen, for visualising data in microtitre plate or slide format. As a better alternative for such functionality, please consider the platetools package on CRAN (https://cran.r-project.org/package=platetools and https://github.com/Swarchal/platetools), or ggplot2 (geom_raster, facet_wrap) as exemplified in the vignette of this package." ;
    schema1:identifier <https://bio.tools/biotools:splots> ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-splots" ;
    schema1:softwareVersion "1.76.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/splots.html" .

