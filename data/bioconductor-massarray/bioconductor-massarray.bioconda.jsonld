  "@id": "bioconda:bioconductor-massarray",
  "@type": "schema1:SoftwareApplication",
  "schema1:alternateName": "Analytical Tools for MassArray Data",
  "schema1:citation": "doi:10.1093/bioinformatics/btp382",
  "schema1:description": "This package is designed for the import, quality control, analysis, and visualization of methylation data generated using Sequenom's MassArray platform.  The tools herein contain a highly detailed amplicon prediction for optimal assay design. Also included are quality control measures of data, such as primer dimer and bisulfite conversion efficiency estimation. Methylation data are calculated using the same algorithms contained in the EpiTyper software package.  Additionally, automatic SNP-detection can be used to flag potentially confounded data from specific CG sites.  Visualization includes barplots of methylation data as well as UCSC Genome Browser-compatible BED tracks.  Multiple assays can be positionally combined for integrated analysis.",
  "schema1:identifier": {
    "@id": "biotools:biotools:massarray"
  },
  "schema1:license": "GPL (>=2)",
  "schema1:name": "bioconductor-massarray",
  "schema1:softwareVersion": "1.62.0",
  "schema1:url": "https://bioconductor.org/packages/3.22/bioc/html/MassArray.html"
}