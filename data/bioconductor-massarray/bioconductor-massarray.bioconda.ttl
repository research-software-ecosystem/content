@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-massarray a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp382" ;
    schema:description "Analytical Tools for MassArray Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MassArray_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MassArray/MassArray_1.62.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MassArray_1.62.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-massarray/bioconductor-massarray_1.62.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:massarray ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-massarray" ;
    schema:softwareVersion "1.62.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MassArray.html" .

