@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:tn93 a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/molbev/msy016" ;
    schema:description "This is a simple program meant to compute pairwise distances between aligned nucleotide sequences in sequential FASTA format using the Tamura Nei 93 distance." ;
    schema:downloadUrl "https://github.com/veg/tn93/archive/v1.0.16.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:tn93 ;
    schema:license "MIT" ;
    schema:name "tn93" ;
    schema:softwareHelp "https://github.com/veg/tn93/blob/v1.0.16/README.md" ;
    schema:softwareVersion "1.0.16" ;
    schema:url "https://github.com/veg/tn93" .

