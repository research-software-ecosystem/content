@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:artic a schema1:SoftwareApplication ;
    bioschemas:output "bam",
        "fasta",
        "tabular",
        "txt",
        "vcf_bgzip" ;
    schema1:applicationSubCategory edam:topic_0622 ;
    schema1:codeRepository <https://github.com/artic-network/fieldbioinformatics> ;
    schema1:dateCreated "2020-04-17" ;
    schema1:description "The artic pipeline is designed to help run the artic bioinformatics protocols;for example the nCoV-2019 novel coronavirus protocol.Features include: read filtering, primer trimming, amplicon coverage normalisation,variant calling and consensus building" ;
    schema1:encodingFormat "bam",
        "fasta",
        "tabular",
        "txt",
        "vcf_bgzip" ;
    schema1:featureList edam:data_0863,
        edam:operation_0292,
        edam:topic_0182 ;
    schema1:identifier biotools:artic,
        bioconda:artic ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au>,
        <https://usegalaxy.org.au/published/workflow?id=aa1d123c0a0929f3>,
        <https://workflowhub.eu/workflows/2195?version=1>,
        <https://workflowhub.eu/workflows/521?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "artic" ;
    schema1:softwareVersion "1.7.3" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/artic> .

<https://usegalaxy.be> a schema1:WebSite .

