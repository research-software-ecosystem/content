@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-scater a schema1:SoftwareApplication ;
    schema1:alternateName "Single-Cell Analysis Toolkit for Gene Expression Data in R" ;
    schema1:description "A collection of tools for doing various analyses of single-cell RNA-seq gene expression data, with a focus on quality control and visualization." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/scater_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scater/scater_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/scater_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-scater/bioconductor-scater_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:scater" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-scater" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/scater.html" .

