@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-scater a schema:SoftwareApplication ;
    schema:description "Single-Cell Analysis Toolkit for Gene Expression Data in R" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/scater_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/scater/scater_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/scater_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-scater/bioconductor-scater_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-beachmat",
        "bioconductor-biocgenerics",
        "bioconductor-biocneighbors",
        "bioconductor-biocparallel",
        "bioconductor-biocsingular",
        "bioconductor-delayedarray",
        "bioconductor-matrixgenerics",
        "bioconductor-s4vectors",
        "bioconductor-scuttle",
        "bioconductor-singlecellexperiment",
        "bioconductor-sparsearray",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-ggbeeswarm",
        "r-ggplot2",
        "r-ggrastr",
        "r-ggrepel",
        "r-matrix",
        "r-pheatmap",
        "r-rcolorbrewer",
        "r-rcppml",
        "r-rlang",
        "r-rtsne",
        "r-uwot",
        "r-viridis" ;
    schema:identifier biotools:scater ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-scater" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/scater.html" .

