@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ruvnormalize a schema1:SoftwareApplication ;
    schema1:alternateName "RUV for normalization of expression array data" ;
    schema1:description "RUVnormalize is meant to remove unwanted variation from gene expression data when the factor of interest is not defined, e.g., to clean up a dataset for general use or to do any kind of unsupervised analysis." ;
    schema1:identifier <https://bio.tools/biotools:ruvnormalize> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-ruvnormalize" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RUVnormalize.html" .

