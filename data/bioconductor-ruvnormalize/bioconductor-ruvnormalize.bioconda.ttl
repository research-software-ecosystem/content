@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ruvnormalize a schema:SoftwareApplication ;
    schema:description "RUV for normalization of expression array data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RUVnormalize_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RUVnormalize/RUVnormalize_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RUVnormalize_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ruvnormalize/bioconductor-ruvnormalize_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-ruvnormalizedata",
        "r-base" ;
    schema:identifier biotools:ruvnormalize ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-ruvnormalize" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RUVnormalize.html" .

