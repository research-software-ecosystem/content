@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-fithic a schema1:SoftwareApplication ;
    schema1:alternateName "Confidence estimation for intra-chromosomal contact maps" ;
    schema1:citation "doi:10.1101/gr.160374" ;
    schema1:description "Fit-Hi-C is a tool for assigning statistical confidence estimates to intra-chromosomal contact maps produced by genome-wide genome architecture assays such as Hi-C." ;
    schema1:identifier biotools:fithic ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-fithic" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/FitHiC.html" .

