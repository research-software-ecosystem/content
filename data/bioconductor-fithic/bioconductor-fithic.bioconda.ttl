@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-fithic a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1101/gr.160374" ;
    schema1:description "Confidence estimation for intra-chromosomal contact maps" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/FitHiC_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/FitHiC/FitHiC_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/FitHiC_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fithic/bioconductor-fithic_1.36.0_src_all.tar.gz" ;
    schema1:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-fdrtool",
        "r-rcpp",
        "zlib" ;
    schema1:identifier biotools:fithic ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-fithic" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/FitHiC.html" .

