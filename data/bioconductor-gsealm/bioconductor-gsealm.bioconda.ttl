@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsealm a schema1:SoftwareApplication ;
    schema1:alternateName "Linear Model Toolset for Gene Set Enrichment Analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/btn465" ;
    schema1:description "Models and methods for fitting linear models to gene expression data, together with tools for computing and using various regression diagnostics." ;
    schema1:identifier biotools:gsealm ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gsealm" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSEAlm.html" .

