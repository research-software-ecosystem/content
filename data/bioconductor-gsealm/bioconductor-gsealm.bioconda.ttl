@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gsealm a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btn465" ;
    schema:description "Linear Model Toolset for Gene Set Enrichment Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GSEAlm_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSEAlm/GSEAlm_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSEAlm_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsealm/bioconductor-gsealm_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base" ;
    schema:identifier biotools:gsealm ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gsealm" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GSEAlm.html" .

