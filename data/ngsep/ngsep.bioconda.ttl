@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ngsep a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btz275" ;
    schema:description "NGSEP - Next Generation Sequencing Experience Platform" ;
    schema:downloadUrl "https://master.dl.sourceforge.net/project/ngsep/Library/NGSEPcore_4.0.1.jar" ;
    schema:identifier biotools:ngsep ;
    schema:license "GPL-3" ;
    schema:name "ngsep" ;
    schema:softwareVersion "4.0.1" ;
    schema:url "https://github.com/NGSEP/NGSEPcore" .

