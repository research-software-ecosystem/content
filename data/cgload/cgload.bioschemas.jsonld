  "@id": "https://bio.tools/cgload",
  "@type": "sc:SoftwareApplication",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
  "sc:description": "Software tool for loading genome assemblies and their structural and functional annotations into relational database. Reconciles annotation formats produced by RefSeq, funannotate, AUGUSTUS/BRAKER and GenBank into single representation, imports eggNOG-mapper functional annotation as queryable GO, KEGG, Pfam and EC records, and verifies load completeness by independently counting features against source files and provider published totals. Supports SQLite, MySQL and PostgreSQL. Written in Python.",
  "sc:name": "cgload",
  "sc:url": "https://github.com/computational-genomics-lab/cgload"
}