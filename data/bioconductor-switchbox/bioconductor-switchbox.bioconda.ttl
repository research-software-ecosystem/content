@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-switchbox a schema:SoftwareApplication ;
    schema:description "Utilities to train and validate classifiers based on pair switching using the K-Top-Scoring-Pair (KTSP) algorithm" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/switchBox_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/switchBox/switchBox_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/switchBox_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-switchbox/bioconductor-switchbox_1.46.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-gplots",
        "r-proc",
        "zlib" ;
    schema:identifier biotools:switchbox ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-switchbox" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/switchBox.html" .

