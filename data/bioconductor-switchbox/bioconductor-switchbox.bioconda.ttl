@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-switchbox a schema1:SoftwareApplication ;
    schema1:alternateName "Utilities to train and validate classifiers based on pair switching using the K-Top-Scoring-Pair (KTSP) algorithm" ;
    schema1:description "The package offer different classifiers based on comparisons of pair of features (TSP), using various decision rules (e.g., majority wins principle)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/switchBox_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/switchBox/switchBox_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/switchBox_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-switchbox/bioconductor-switchbox_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:switchbox" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-switchbox" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/switchBox.html" .

