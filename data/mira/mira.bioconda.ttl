@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mira a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.1917404" ;
    schema:description "MIRA is a whole genome shotgun and EST sequence assembler for Sanger, 454, Solexa (Illumina), IonTorrent data and PacBio (the later at the moment only CCS and error-corrected CLR reads)." ;
    schema:downloadUrl "https://github.com/DrMicrobit/mira/releases/download/V5rc2/mira-V5rc2.tar.bz2" ;
    schema:hasPart "boost-cpp",
        "bzip2",
        "expat",
        "flex",
        "libgomp",
        "llvm-openmp",
        "vim",
        "zlib" ;
    schema:identifier biotools:mira ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "mira" ;
    schema:softwareHelp "https://mira-assembler.sourceforge.net/docs/DefinitiveGuideToMIRA.html" ;
    schema:softwareVersion "5.0.0rc2" ;
    schema:url "https://github.com/DrMicrobit/mira" .

