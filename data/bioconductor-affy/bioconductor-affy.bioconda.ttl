@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-affy a schema:SoftwareApplication ;
    schema:description "Methods for Affymetrix Oligonucleotide Arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/affy_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affy/affy_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affy_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affy/bioconductor-affy_1.88.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-preprocesscore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-biocmanager",
        "zlib" ;
    schema:identifier biotools:affy ;
    schema:license "LGPL (>= 2.0)" ;
    schema:name "bioconductor-affy" ;
    schema:softwareVersion "1.88.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/affy.html" .

