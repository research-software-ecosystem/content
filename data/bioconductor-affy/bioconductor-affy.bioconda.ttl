@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affy a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for Affymetrix Oligonucleotide Arrays" ;
    schema1:description "The package contains functions for exploratory oligonucleotide array analysis. The dependence on tkWidgets only concerns few convenience functions. 'affy' is fully functional without it." ;
    schema1:identifier biotools:affy ;
    schema1:license "LGPL (>= 2.0)" ;
    schema1:name "bioconductor-affy" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affy.html" .

