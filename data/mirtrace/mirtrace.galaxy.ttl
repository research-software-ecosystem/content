@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:mirtrace a schema1:SoftwareApplication ;
    bioschemas:output "html",
        "json",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0659,
        edam:topic_3302 ;
    schema1:codeRepository "https://github.com/friedlanderlab/mirtrace" ;
    schema1:dateCreated "2026-07-21" ;
    schema1:description "miRTrace is a tool for quality control and tracing of small RNA sequencing data. It profiles sequencing quality, read length, sequencing depth and miRNA complexity, the amounts of miRNAs versus undesirable sequences (derived from tRNAs, rRNAs and sequencing artifacts) and the composition of clade-specific miRNAs." ;
    schema1:encodingFormat "html",
        "json",
        "tabular" ;
    schema1:featureList edam:operation_0463,
        edam:operation_3192,
        edam:operation_3792 ;
    schema1:identifier biotools:miRTrace,
        bioconda:mirtrace ;
    schema1:keywords "Transcriptomics" ;
    schema1:name "mirtrace" ;
    schema1:softwareVersion "1.0.1" ;
    schema1:url "https://github.com/bgruening/galaxytools/tree/master/tools/rna_tools/mirtrace" .

