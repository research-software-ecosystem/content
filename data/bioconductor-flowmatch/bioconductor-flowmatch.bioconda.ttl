@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowmatch a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Matching and meta-clustering in flow cytometry" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowMatch_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowMatch/flowMatch_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowMatch_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowmatch/bioconductor-flowmatch_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-flowcore",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:flowmatch ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-flowmatch" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowMatch.html" .

