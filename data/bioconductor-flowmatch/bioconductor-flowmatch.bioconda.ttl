@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowmatch a schema1:SoftwareApplication ;
    schema1:alternateName "Matching and meta-clustering in flow cytometry" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Matching cell populations and building meta-clusters and templates from a collection of FC samples." ;
    schema1:identifier biotools:flowmatch ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-flowmatch" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowMatch.html" .

