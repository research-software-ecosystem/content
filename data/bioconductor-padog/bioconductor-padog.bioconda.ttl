@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-padog a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-13-136" ;
    schema:description "Pathway Analysis with Down-weighting of Overlapping Genes (PADOG)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PADOG_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PADOG/PADOG_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PADOG_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-padog/bioconductor-padog_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-hgu133a.db",
        "bioconductor-hgu133plus2.db",
        "bioconductor-keggdzpathwaysgeo",
        "bioconductor-keggrest",
        "bioconductor-limma",
        "r-base",
        "r-dorng",
        "r-foreach",
        "r-gsa",
        "r-nlme" ;
    schema:identifier biotools:padog ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-padog" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PADOG.html" .

