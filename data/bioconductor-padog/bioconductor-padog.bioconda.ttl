@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-padog a schema1:SoftwareApplication ;
    schema1:alternateName "Pathway Analysis with Down-weighting of Overlapping Genes (PADOG)" ;
    schema1:citation "doi:10.1186/1471-2105-13-136" ;
    schema1:description "This package implements a general purpose gene set analysis method called PADOG that downplays the importance of genes that apear often accross the sets of genes to be analyzed. The package provides also a benchmark for gene set analysis methods in terms of sensitivity and ranking using 24 public datasets from KEGGdzPathwaysGEO package." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PADOG_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PADOG/PADOG_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PADOG_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-padog/bioconductor-padog_1.52.0_src_all.tar.gz" ;
    schema1:identifier "biotools:padog" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-padog" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PADOG.html" .

