@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:eigensoft a schema1:SoftwareApplication ;
    schema1:alternateName "The EIGENSOFT package implements methods for analyzing population structure and performing stratification correction." ;
