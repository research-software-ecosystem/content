    schema1:description "The EIGENSOFT package implements methods for analyzing population structure and performing stratification correction." ;
    schema1:identifier <https://bio.tools/biotools:Eigensoft> ;
    schema1:license "Custom OSS" ;
    schema1:name "eigensoft" ;
    schema1:softwareVersion "9.0.0" ;
    schema1:url "https://github.com/DReichLab/EIG" .

