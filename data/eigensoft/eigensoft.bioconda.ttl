@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:eigensoft a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pgen.0020190" ;
    schema:description "The EIGENSOFT package implements methods for analzing population structure and performing stratification correction" ;
    schema:downloadUrl "https://github.com/DReichLab/EIG/archive/v8.0.0.tar.gz" ;
    schema:hasPart "gsl",
        "openblas" ;
    schema:identifier biotools:Eigensoft ;
    schema:license "Custom OSS" ;
    schema:name "eigensoft" ;
    schema:softwareVersion "8.0.0" ;
    schema:url "https://github.com/DReichLab/EIG" .

