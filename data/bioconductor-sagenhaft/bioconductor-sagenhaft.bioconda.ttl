@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sagenhaft a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Collection of functions for reading and comparing SAGE libraries" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sagenhaft_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sagenhaft/sagenhaft_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sagenhaft_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sagenhaft/bioconductor-sagenhaft_1.80.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-sparsem" ;
    schema:identifier biotools:sagenhaft ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-sagenhaft" ;
    schema:softwareVersion "1.80.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sagenhaft.html" .

