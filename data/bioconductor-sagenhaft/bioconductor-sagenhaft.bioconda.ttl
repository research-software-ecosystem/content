@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sagenhaft a schema1:SoftwareApplication ;
    schema1:alternateName "Collection of functions for reading and comparing SAGE libraries" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package implements several functions useful for analysis of gene expression data by sequencing tags as done in SAGE (Serial Analysis of Gene Expressen) data, i.e. extraction of a SAGE library from sequence files, sequence error correction, library comparison. Sequencing error correction is implementing using an Expectation Maximization Algorithm based on a Mixture Model of tag counts." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/sagenhaft_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sagenhaft/sagenhaft_1.80.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sagenhaft_1.80.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sagenhaft/bioconductor-sagenhaft_1.80.0_src_all.tar.gz" ;
    schema1:identifier "biotools:sagenhaft" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-sagenhaft" ;
    schema1:softwareVersion "1.80.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/sagenhaft.html" .

