@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:msaprobs a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btq338" ;
    schema:description "MSAProbs is a well-established state-of-the-art multiple sequence alignment algorithm for protein sequences." ;
    schema:downloadUrl "https://sourceforge.net/projects/msaprobs/files/MSAProbs-0.9.7.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp",
        "zlib" ;
    schema:identifier biotools:msaprobs ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "msaprobs" ;
    schema:softwareHelp "https://msaprobs.sourceforge.net/homepage.htm#latest" ;
    schema:softwareVersion "0.9.7" ;
    schema:url "https://msaprobs.sourceforge.net/homepage.htm#latest" .

