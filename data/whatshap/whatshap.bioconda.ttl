@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:whatshap a schema:SoftwareApplication ;
    schema:author "marcelm" ;
    schema:citation "doi:10.1089/cmb.2014.0157" ;
    schema:description "Phase genomic variants using DNA sequencing reads (haplotype assembly)." ;
    schema:downloadUrl "https://files.pythonhosted.org/packages/1c/1a/78c4c6d188bea81d146b7e73fe12cf3e2d3c2b0e69542a2ca806908b6fa3/whatshap-2.8.tar.gz" ;
    schema:hasPart "cython",
        "pip",
        "python",
        "setuptools-scm" ;
    schema:identifier biotools:whatshap ;
    schema:license "MIT" ;
    schema:maintainer "marcelm" ;
    schema:name "whatshap" ;
    schema:softwareHelp "https://whatshap.readthedocs.io" ;
    schema:softwareVersion "2.8" ;
    schema:url "https://whatshap.readthedocs.io" .

