@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:whatshap a schema1:SoftwareApplication ;
    schema1:alternateName "Phase genomic variants using DNA sequencing reads (haplotype assembly)." ;
    schema1:citation "doi:10.1089/cmb.2014.0157" ;
    schema1:description "Phase genomic variants using DNA sequencing reads (haplotype assembly)." ;
    schema1:identifier <https://bio.tools/biotools:whatshap> ;
    schema1:license "MIT" ;
    schema1:maintainer "marcelm" ;
    schema1:name "whatshap" ;
    schema1:softwareVersion "2.8" ;
    schema1:url "https://whatshap.readthedocs.io" .

