    "function": [
        {
            "cmd": "python main.py \\\n    -r  <rmats-output-dir> \\\n    -g  <genome.fa> \\\n    -t  <annotation.gtf> \\\n-o ./results \\\n    --job-id myjob \\\n    --fdr 0.05 --psi 0.1 --minjc 10",
            "input": [
                {
                    "data": {
                        "term": "Text data",
                        "uri": "http://edamontology.org/data_2526"
                    }
                }
            ],
            "note": "-r\tDirectory containing the rMATS analysis output files: SE.MATS.JC.txt, A3SS.MATS.JC.txt, A5SS.MATS.JC.txt, RI.MATS.JC.txt, MXE.MATS.JC.txt (missing event types are skipped)\n-g\tGenome FASTA file (a .fai index is created on first use). Must be the same reference genome as used in the rMATS analysis\n-t\tGTF annotation file (requires gene_name / transcript_id attributes). Must be the same reference annotation as used in the rMATS analysis",
