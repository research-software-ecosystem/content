@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:comparems2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/rcm.6162" ;
    schema:description "A simple tool developed to compare, globally, all MS/MS spectra between two datasets (in Mascot Generic Format or MGF)." ;
    schema:downloadUrl "http://www.ms-utils.org/compareMS2.c" ;
    schema:identifier biotools:comparems2 ;
    schema:license "GPL3" ;
    schema:name "comparems2" ;
    schema:softwareVersion "1" ;
    schema:url "http://www.ms-utils.org/compareMS2.html" .

