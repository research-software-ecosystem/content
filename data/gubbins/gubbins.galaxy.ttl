    bioschemas:output "csv",
        "embl",
        "fasta",
        "gff3",
        "phylip",
        "txt",
        "vcf" ;
    schema1:applicationSubCategory edam:topic_0084,
        edam:topic_0625,
        edam:topic_3673 ;
    schema1:dateCreated "2017-06-22" ;
    schema1:description "Gubbins - bacterial recombination detection" ;
    schema1:encodingFormat "csv",
        "embl",
        "fasta",
        "gff3",
        "phylip",
        "txt",
        "vcf" ;
    schema1:featureList edam:operation_0323,
        edam:operation_3196,
        edam:operation_3745 ;
    schema1:identifier biotools:gubbins,
        bioconda:gubbins ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "gubbins" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/gubbins" .

