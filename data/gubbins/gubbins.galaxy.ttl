@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:gubbins a schema1:SoftwareApplication ;
    bioschemas:output "csv",
        "embl",
        "fasta",
        "gff3",
        "phylip",
        "txt",
        "vcf" ;
    schema1:applicationSubCategory edam:topic_0084,
        edam:topic_0625,
        edam:topic_3673 ;
    schema1:codeRepository <https://github.com/nickjcroucher/gubbins> ;
    schema1:dateCreated "2017-06-22" ;
    schema1:description "Gubbins - bacterial recombination detection" ;
    schema1:encodingFormat "csv",
        "embl",
        "fasta",
        "gff3",
        "phylip",
        "txt",
        "vcf" ;
    schema1:featureList edam:operation_0323,
        edam:operation_3196,
        edam:operation_3745 ;
    schema1:identifier biotools:gubbins,
        bioconda:gubbins ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "gubbins" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/gubbins> .

