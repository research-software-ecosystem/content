@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gubbins a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gku1196" ;
    schema:description "Rapid phylogenetic analysis of large samples of recombinant bacterial whole genome sequences using Gubbins." ;
    schema:downloadUrl "https://github.com/nickjcroucher/gubbins/archive/refs/tags/v3.4.3.tar.gz" ;
    schema:hasPart "biopython",
        "dendropy",
        "numba",
        "numpy",
        "pip",
        "python",
        "scipy",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:gubbins ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "gubbins" ;
    schema:softwareHelp "https://nickjcroucher.github.io/gubbins" ;
    schema:softwareVersion "3.4.3" ;
    schema:url "https://github.com/nickjcroucher/gubbins" .

