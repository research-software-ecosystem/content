@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:satrap a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pone.0137436" ;
    schema:description "A SOLiD assembly translation program." ;
    schema:downloadUrl "http://satrap.cribi.unipd.it/download/SATRAP_v0.2.tar.gz",
        "https://depot.galaxyproject.org/software/satrap/satrap_0.2_src_all.tar.gz" ;
    schema:identifier biotools:satrap ;
    schema:license "file" ;
    schema:name "satrap" ;
    schema:softwareVersion "0.2" ;
    schema:url "http://satrap.cribi.unipd.it/cgi-bin/satrap.pl" .

