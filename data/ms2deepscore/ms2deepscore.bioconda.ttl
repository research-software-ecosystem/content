@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ms2deepscore a schema:SoftwareApplication ;
    schema:author "hechth",
        "niekdejonge" ;
    schema:citation "doi:10.1186/s13321-021-00558-4" ;
    schema:description "Deep learning similarity measure for comparing MS/MS spectra with respect to their chemical similarity" ;
    schema:downloadUrl "https://github.com/matchms/ms2deepscore/archive/refs/tags/2.7.2.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:ms2deepscore ;
    schema:license "Apache-2.0" ;
    schema:maintainer "hechth",
        "niekdejonge" ;
    schema:name "ms2deepscore" ;
    schema:softwareVersion "2.7.2" ;
    schema:url "https://github.com/matchms/ms2deepscore" .

