@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cn.mops a schema:SoftwareApplication ;
    schema:description "cn.mops - Mixture of Poissons for CNV detection in NGS data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cn.mops_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cn.mops/cn.mops_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cn.mops_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cn.mops/bioconductor-cn.mops_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:cn.mops ;
    schema:license "LGPL (>= 2.0)" ;
    schema:name "bioconductor-cn.mops" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cn.mops.html" .

