@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clst a schema1:SoftwareApplication ;
    schema1:alternateName "Classification by local similarity threshold" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Package for modified nearest-neighbor classification based on calculation of a similarity threshold distinguishing within-group from between-group comparisons." ;
    schema1:identifier biotools:clst ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-clst" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clst.html" .

