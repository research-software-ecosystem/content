@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clst a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Classification by local similarity threshold" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/clst_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clst/clst_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clst_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clst/bioconductor-clst_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-roc",
        "r-base",
        "r-lattice" ;
    schema:identifier biotools:clst ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-clst" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/clst.html" .

