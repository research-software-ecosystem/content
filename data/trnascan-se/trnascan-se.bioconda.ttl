@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:trnascan-se a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkab688" ;
    schema:description "tRNA detection in large-scale genomic sequences" ;
    schema:downloadUrl "https://github.com/UCSC-LoweLab/tRNAscan-SE/archive/refs/tags/v2.0.12.tar.gz" ;
    schema:hasPart "perl" ;
    schema:identifier biotools:trnascan-se ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "trnascan-se" ;
    schema:softwareHelp "https://lowelab.ucsc.edu/tRNAscan-SE/help.html" ;
    schema:softwareVersion "2.0.12" ;
    schema:url "https://lowelab.ucsc.edu/tRNAscan-SE/" .

