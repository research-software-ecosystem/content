@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:trnascan-se a schema1:SoftwareApplication ;
    schema1:alternateName "tRNA detection in large-scale genomic sequences" ;
    schema1:citation "doi:10.1093/nar/gkab688" ;
    schema1:description "tRNA detection in large-scale genomic sequences" ;
    schema1:downloadUrl "https://github.com/UCSC-LoweLab/tRNAscan-SE/archive/refs/tags/v2.0.13.tar.gz" ;
    schema1:identifier "biotools:trnascan-se" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "trnascan-se" ;
    schema1:softwareVersion "2.0.13" ;
    schema1:url "https://lowelab.ucsc.edu/tRNAscan-SE/" .

