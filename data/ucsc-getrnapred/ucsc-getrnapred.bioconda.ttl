@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:ucsc-getrnapred a schema1:SoftwareApplication ;
    schema1:alternateName "Get virtual RNA for gene predictions." ;
    schema1:citation "doi:10.1093/bib/bbs038" ;
    schema1:description "Get virtual RNA for gene predictions." ;
    schema1:identifier biotools:UCSC_Genome_Browser_Utilities ;
    schema1:license "Varies; see https://genome.ucsc.edu/license" ;
    schema1:name "ucsc-getrnapred" ;
    schema1:softwareVersion "482" ;
    schema1:url "https://hgdownload.cse.ucsc.edu/admin/exe" .

