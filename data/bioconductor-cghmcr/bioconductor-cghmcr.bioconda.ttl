@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cghmcr a schema1:SoftwareApplication ;
    schema1:alternateName "Find chromosome regions showing common gains/losses" ;
    schema1:citation "doi:10.1093/bioinformatics/btv298" ;
    schema1:description "This package provides functions to identify genomic regions of interests based on segmented copy number data from multiple samples." ;
    schema1:identifier biotools:cghmcr ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-cghmcr" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cghMCR.html" .

