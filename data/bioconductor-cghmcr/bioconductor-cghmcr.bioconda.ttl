@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cghmcr a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv298" ;
    schema:description "Find chromosome regions showing common gains/losses" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cghMCR_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cghMCR/cghMCR_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cghMCR_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cghmcr/bioconductor-cghmcr_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-cntools",
        "bioconductor-dnacopy",
        "bioconductor-limma",
        "r-base" ;
    schema:identifier biotools:cghmcr ;
    schema:license "LGPL" ;
    schema:name "bioconductor-cghmcr" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cghMCR.html" .

