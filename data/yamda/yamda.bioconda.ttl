@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:yamda a schema:SoftwareApplication ;
    schema:description "A highly scalable GPU-accelerated de novo motif discovery software package" ;
    schema:downloadUrl "https://github.com/daquang/YAMDA/archive/00e9c9d.tar.gz" ;
    schema:hasPart "python",
        "setuptools" ;
    schema:identifier biotools:yamda ;
    schema:license "MIT" ;
    schema:name "yamda" ;
    schema:softwareVersion "0.1.00e9c9d" ;
    schema:url "https://github.com/daquang/YAMDA" .

