@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-metagenomeseq a schema1:SoftwareApplication ;
    schema1:alternateName "Statistical analysis for sparse high-throughput sequencing" ;
    schema1:citation "doi:10.1038/nmeth.2658" ;
    schema1:description "metagenomeSeq is designed to determine features (be it Operational Taxanomic Unit (OTU), species, etc.) that are differentially abundant between two or more groups of multiple samples. metagenomeSeq is designed to address the effects of both normalization and under-sampling of microbial communities on disease association detection and the testing of feature correlations." ;
    schema1:identifier biotools:metagenomeseq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-metagenomeseq" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/metagenomeSeq.html" .

