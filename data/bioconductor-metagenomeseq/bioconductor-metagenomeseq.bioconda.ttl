@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-metagenomeseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.2658" ;
    schema:description "Statistical analysis for sparse high-throughput sequencing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/metagenomeSeq_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/metagenomeSeq/metagenomeSeq_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/metagenomeSeq_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-metagenomeseq/bioconductor-metagenomeseq_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-limma",
        "bioconductor-wrench",
        "r-base",
        "r-foreach",
        "r-glmnet",
        "r-gplots",
        "r-matrix",
        "r-matrixstats",
        "r-rcolorbrewer" ;
    schema:identifier biotools:metagenomeseq ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-metagenomeseq" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/metagenomeSeq.html" .

