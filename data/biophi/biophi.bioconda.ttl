@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:biophi a schema1:SoftwareApplication ;
    schema1:alternateName "BioPhi open-source antibody design platform." ;
    schema1:description "BioPhi open-source antibody design platform." ;
    schema1:identifier biotools:biophi ;
    schema1:license "MIT" ;
    schema1:name "biophi" ;
    schema1:softwareVersion "1.0.11" ;
    schema1:url "https://github.com/Merck/BioPhi" .

