@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:biophi a schema:SoftwareApplication ;
    schema:description "BioPhi open-source antibody design platform." ;
    schema:downloadUrl "https://github.com/Merck/BioPhi/archive/v1.0.11.tar.gz" ;
    schema:hasPart "pip",
        "pytest",
        "python" ;
    schema:identifier biotools:biophi ;
    schema:license "MIT" ;
    schema:name "biophi" ;
    schema:softwareHelp "https://biophi.dichlab.org" ;
    schema:softwareVersion "1.0.11" ;
    schema:url "https://github.com/Merck/BioPhi" .

