@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pdinfobuilder a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btq431" ;
    schema1:description "Platform Design Information Package Builder" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/pdInfoBuilder_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/pdInfoBuilder/pdInfoBuilder_1.74.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/pdInfoBuilder_1.74.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pdinfobuilder/bioconductor-pdinfobuilder_1.74.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affxparser",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-iranges",
        "bioconductor-oligo",
        "bioconductor-oligoclasses",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-dbi",
        "r-rsqlite",
        "zlib" ;
    schema1:identifier biotools:pdinfobuilder ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-pdinfobuilder" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pdInfoBuilder.html" .

