@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pdinfobuilder a schema1:SoftwareApplication ;
    schema1:alternateName "Platform Design Information Package Builder" ;
    schema1:citation "doi:10.1093/bioinformatics/btq431" ;
    schema1:description "Builds platform design information packages. These consist of a SQLite database containing feature-level data such as x, y position on chip and featureSet ID. The database also incorporates featureSet-level annotation data. The products of this packages are used by the oligo pkg." ;
    schema1:identifier biotools:pdinfobuilder ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-pdinfobuilder" ;
    schema1:softwareVersion "1.74.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/pdInfoBuilder.html" .

