@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:msgf_plus a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ncomms6277" ;
    schema:description "MS-GF+ is a MS/MS database search tool" ;
    schema:downloadUrl "https://github.com/MSGFPlus/msgfplus/releases/download/v2024.03.26/MSGFPlus_v20240326.zip" ;
    schema:hasPart "openjdk" ;
    schema:identifier biotools:MSGFplus ;
    schema:license "https://github.com/msgfplus/msgfplus/blob/master/LICENSE.txt" ;
    schema:name "msgf_plus" ;
    schema:softwareVersion "2024.03.26" ;
    schema:url "https://msgfplus.github.io/" .

