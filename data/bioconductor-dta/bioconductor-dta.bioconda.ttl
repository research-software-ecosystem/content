@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dta a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bts052" ;
    schema:description "Dynamic Transcriptome Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DTA_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DTA/DTA_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DTA_2.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dta/bioconductor-dta_2.56.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-lsd",
        "r-scatterplot3d" ;
    schema:identifier biotools:dta ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-dta" ;
    schema:softwareVersion "2.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DTA.html" .

