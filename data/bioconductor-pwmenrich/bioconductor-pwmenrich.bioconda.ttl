@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-pwmenrich a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "PWM enrichment analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PWMEnrich_4.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PWMEnrich/PWMEnrich_4.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PWMEnrich_4.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pwmenrich/bioconductor-pwmenrich_4.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-s4vectors",
        "bioconductor-seqlogo",
        "r-base",
        "r-evd",
        "r-gdata" ;
    schema:identifier biotools:pwmenrich ;
    schema:license "LGPL (>= 2)" ;
    schema:name "bioconductor-pwmenrich" ;
    schema:softwareVersion "4.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PWMEnrich.html" .

