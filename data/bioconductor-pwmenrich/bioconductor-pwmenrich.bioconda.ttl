@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-pwmenrich a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "PWM enrichment analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PWMEnrich_4.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PWMEnrich/PWMEnrich_4.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PWMEnrich_4.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-pwmenrich/bioconductor-pwmenrich_4.46.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-s4vectors",
        "bioconductor-seqlogo",
        "r-base",
        "r-evd",
        "r-gdata" ;
    schema1:identifier biotools:pwmenrich ;
    schema1:license "LGPL (>= 2)" ;
    schema1:name "bioconductor-pwmenrich" ;
    schema1:softwareVersion "4.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PWMEnrich.html" .

