@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:usher a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41588-021-00862-7" ;
    schema:description "Ultrafast Sample Placement on Existing Trees (UShER)." ;
    schema:downloadUrl "https://github.com/yatisht/usher/archive/v0.6.6.tar.gz" ;
    schema:hasPart "boost-cpp",
        "curl",
        "isa-l",
        "libgomp",
        "llvm-openmp",
        "openmpi",
        "protobuf",
        "tbb-devel",
        "wget" ;
    schema:identifier biotools:usher ;
    schema:license "MIT" ;
    schema:name "usher" ;
    schema:softwareHelp "https://usher-wiki.readthedocs.io/en/latest" ;
    schema:softwareVersion "0.6.6" ;
    schema:url "https://github.com/yatisht/usher" .

