@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-xde a schema:SoftwareApplication ;
    schema:description "XDE: a Bayesian hierarchical model for cross-study analysis of differential gene expression" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/XDE_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/XDE/XDE_2.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/XDE_2.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-xde/bioconductor-xde_2.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genefilter",
        "bioconductor-genemeta",
        "bioconductor-siggenes",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-gtools",
        "r-mvtnorm",
        "r-rcolorbrewer",
        "zlib" ;
    schema:identifier biotools:xde ;
    schema:license "LGPL-2" ;
    schema:name "bioconductor-xde" ;
    schema:softwareVersion "2.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/XDE.html" .

