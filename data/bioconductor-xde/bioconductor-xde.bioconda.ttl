@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-xde a schema1:SoftwareApplication ;
    schema1:alternateName "XDE: a Bayesian hierarchical model for cross-study analysis of differential gene expression" ;
    schema1:description "Multi-level model for cross-study detection of differential gene expression." ;
    schema1:identifier <https://bio.tools/biotools:xde> ;
    schema1:license "LGPL-2" ;
    schema1:name "bioconductor-xde" ;
    schema1:softwareVersion "2.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/XDE.html" .

