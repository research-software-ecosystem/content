@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:vsclust a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bty224" ;
    schema:description "Interactive tool for statistical testing, data browsing and interactive visualization of quantitative omics data" ;
    schema:downloadUrl "https://bitbucket.org/veitveit/vsclust/get/release-0.91.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "bioconductor-mfuzz",
        "bioconductor-qvalue",
        "r-base",
        "r-matrixstats" ;
    schema:identifier biotools:vsclust ;
    schema:license "GPL (>=2)" ;
    schema:name "vsclust" ;
    schema:softwareVersion "0.91" ;
    schema:url "https://bitbucket.org/veitveit/vsclust/src/master/" .

