@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-xvector a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Foundation of external vector representation and manipulation in Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/XVector_0.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/XVector/XVector_0.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/XVector_0.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-xvector/bioconductor-xvector_0.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:xvector ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-xvector" ;
    schema:softwareVersion "0.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/XVector.html" .

