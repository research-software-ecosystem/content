@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-casper a schema:SoftwareApplication ;
    schema:description "Characterization of Alternative Splicing based on Paired-End Reads" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/casper_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/casper/casper_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/casper_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-casper/bioconductor-casper_2.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-ebarrays",
        "bioconductor-gaga",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-coda",
        "r-gtools",
        "r-mgcv",
        "r-sqldf",
        "r-survival",
        "r-vgam",
        "zlib" ;
    schema:identifier biotools:casper ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-casper" ;
    schema:softwareVersion "2.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/casper.html" .

