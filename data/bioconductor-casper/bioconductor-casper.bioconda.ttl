@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-casper a schema1:SoftwareApplication ;
    schema1:alternateName "Characterization of Alternative Splicing based on Paired-End Reads" ;
    schema1:description "Infer alternative splicing from paired-end RNA-seq data. The model is based on counting paths across exons, rather than pairwise exon connections, and estimates the fragment size and start distributions non-parametrically, which improves estimation precision." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/casper_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/casper/casper_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/casper_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-casper/bioconductor-casper_2.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:casper" ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-casper" ;
    schema1:softwareVersion "2.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/casper.html" .

