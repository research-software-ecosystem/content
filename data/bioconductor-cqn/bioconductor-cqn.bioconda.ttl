@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cqn a schema:SoftwareApplication ;
    schema:description "Conditional quantile normalization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/cqn_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cqn/cqn_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cqn_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cqn/bioconductor-cqn_1.56.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mclust",
        "r-nor1mix",
        "r-quantreg" ;
    schema:identifier biotools:cqn ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-cqn" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/cqn.html" .

