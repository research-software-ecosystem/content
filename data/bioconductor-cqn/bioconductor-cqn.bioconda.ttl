@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cqn a schema1:SoftwareApplication ;
    schema1:alternateName "Conditional quantile normalization" ;
    schema1:description "A normalization tool for RNA-Seq data, implementing the conditional quantile normalization method." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/cqn_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/cqn/cqn_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/cqn_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cqn/bioconductor-cqn_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cqn" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-cqn" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cqn.html" .

