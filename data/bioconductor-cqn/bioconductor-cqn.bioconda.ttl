@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cqn a schema1:SoftwareApplication ;
    schema1:alternateName "Conditional quantile normalization" ;
    schema1:description "A normalization tool for RNA-Seq data, implementing the conditional quantile normalization method." ;
    schema1:identifier biotools:cqn ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-cqn" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/cqn.html" .

