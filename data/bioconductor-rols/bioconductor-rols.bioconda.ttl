@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rols a schema1:SoftwareApplication ;
    schema1:alternateName "An R interface to the Ontology Lookup Service" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The rols package is an interface to the Ontology Lookup Service (OLS) to access and query hundred of ontolgies directly from R." ;
    schema1:identifier biotools:rols ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-rols" ;
    schema1:softwareVersion "3.6.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rols.html" .

