@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rols a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "An R interface to the Ontology Lookup Service" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rols_3.6.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rols/rols_3.6.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rols_3.6.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rols/bioconductor-rols_3.6.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-httr2",
        "r-jsonlite" ;
    schema:identifier biotools:rols ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-rols" ;
    schema:softwareVersion "3.6.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rols.html" .

