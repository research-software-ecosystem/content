@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-yamss a schema:SoftwareApplication ;
    schema:description "Tools for high-throughput metabolomics" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/yamss_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/yamss/yamss_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/yamss_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-yamss/bioconductor-yamss_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-ebimage",
        "bioconductor-iranges",
        "bioconductor-limma",
        "bioconductor-mzr",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-data.table",
        "r-matrix" ;
    schema:identifier biotools:yamss ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-yamss" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/yamss.html" .

