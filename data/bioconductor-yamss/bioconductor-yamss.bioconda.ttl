@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-yamss a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for high-throughput metabolomics" ;
    schema1:description "Tools to analyze and visualize high-throughput metabolomics data aquired using chromatography-mass spectrometry. These tools preprocess data in a way that enables reliable and powerful differential analysis. At the core of these methods is a peak detection phase that pools information across all samples simultaneously. This is in contrast to other methods that detect peaks in a sample-by-sample basis." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/yamss_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/yamss/yamss_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/yamss_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-yamss/bioconductor-yamss_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:yamss" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-yamss" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/yamss.html" .

