@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:uvaia a schema:SoftwareApplication ;
    schema:description "Reference-based alignment and sequence database search" ;
    schema:hasPart "bzip2",
        "check",
        "libgcc-ng",
        "libgomp",
        "sysroot_linux-64",
        "xz",
        "zlib" ;
    schema:identifier biotools:uvaia ;
    schema:license "GPLv3" ;
    schema:name "uvaia" ;
    schema:softwareVersion "2.0.1" ;
    schema:url "https://github.com/quadram-institute-bioscience/uvaia" .

