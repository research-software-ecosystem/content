@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genbankr a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Parsing GenBank files into semantically useful objects" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/genbankr_1.27.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/genbankr/genbankr_1.27.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/genbankr_1.27.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genbankr/bioconductor-genbankr_1.27.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-variantannotation",
        "r-base" ;
    schema:identifier biotools:genbankr ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genbankr" ;
    schema:softwareVersion "1.27.0" ;
    schema:url "https://bioconductor.org/packages/3.17/bioc/html/genbankr.html" .

