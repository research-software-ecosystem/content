@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genbankr a schema1:SoftwareApplication ;
    schema1:alternateName "Parsing GenBank files into semantically useful objects" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Reads Genbank files." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/genbankr_1.27.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/Archive/genbankr/genbankr_1.27.0.tar.gz",
        "https://bioconductor.org/packages/3.17/bioc/src/contrib/genbankr_1.27.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genbankr/bioconductor-genbankr_1.27.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genbankr" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genbankr" ;
    schema1:softwareVersion "1.27.0" ;
    schema1:url "https://bioconductor.org/packages/3.17/bioc/html/genbankr.html" .

