@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hiccompare a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1186/s12859-018-2288-x" ;
    schema1:description "HiCcompare: Joint normalization and comparative analysis of multiple Hi-C datasets" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HiCcompare_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HiCcompare/HiCcompare_1.32.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HiCcompare_1.32.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hiccompare/bioconductor-hiccompare_1.32.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocparallel",
        "bioconductor-genomicranges",
        "bioconductor-interactionset",
        "bioconductor-iranges",
        "bioconductor-rhdf5",
        "bioconductor-s4vectors",
        "r-base",
        "r-data.table",
        "r-dplyr",
        "r-ggplot2",
        "r-gridextra",
        "r-gtools",
        "r-kernsmooth",
        "r-mgcv",
        "r-pheatmap" ;
    schema1:identifier biotools:HiCcompare ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-hiccompare" ;
    schema1:softwareVersion "1.32.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HiCcompare.html" .

