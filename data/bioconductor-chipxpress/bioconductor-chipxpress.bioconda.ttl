@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chipxpress a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-14-188" ;
    schema:description "ChIPXpress: enhanced transcription factor target gene identification from ChIP-seq and ChIP-chip data using publicly available gene expression profiles" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ChIPXpress_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ChIPXpress/ChIPXpress_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ChIPXpress_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipxpress/bioconductor-chipxpress_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-biobase",
        "bioconductor-chipxpressdata",
        "bioconductor-frma",
        "bioconductor-geoquery",
        "r-base",
        "r-biganalytics",
        "r-bigmemory" ;
    schema:identifier biotools:chipxpress ;
    schema:license "GPL(>=2)" ;
    schema:name "bioconductor-chipxpress" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ChIPXpress.html" .

