@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-metahdep a schema1:SoftwareApplication ;
    schema1:alternateName "Hierarchical Dependence in Meta-Analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/btp468" ;
    schema1:description "Tools for meta-analysis in the presence of hierarchical (and/or sampling) dependence, including with gene expression studies" ;
    schema1:identifier biotools:metahdep ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-metahdep" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/metahdep.html" .

