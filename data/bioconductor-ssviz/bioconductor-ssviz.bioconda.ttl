@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ssviz a schema1:SoftwareApplication ;
    schema1:alternateName "A small RNA-seq visualizer and analysis toolkit" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Small RNA sequencing viewer" ;
    schema1:identifier biotools:ssviz ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ssviz" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ssviz.html" .

