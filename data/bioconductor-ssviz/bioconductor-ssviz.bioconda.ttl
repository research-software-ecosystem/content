@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ssviz a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A small RNA-seq visualizer and analysis toolkit" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ssviz_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ssviz/ssviz_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ssviz_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ssviz/bioconductor-ssviz_1.44.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biostrings",
        "bioconductor-rsamtools",
        "r-base",
        "r-ggplot2",
        "r-rcolorbrewer",
        "r-reshape" ;
    schema1:identifier biotools:ssviz ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ssviz" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ssviz.html" .

