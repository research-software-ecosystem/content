@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-turbonorm a schema1:SoftwareApplication ;
    schema1:alternateName "A fast scatterplot smoother suitable for microarray normalization" ;
    schema1:description "A fast scatterplot smoother based on B-splines with second-order difference penalty. Functions for microarray normalization of single-colour data i.e. Affymetrix/Illumina and two-colour data supplied as marray MarrayRaw-objects or limma RGList-objects are available." ;
    schema1:identifier biotools:turbonorm ;
    schema1:license "LGPL" ;
    schema1:name "bioconductor-turbonorm" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/TurboNorm.html" .

