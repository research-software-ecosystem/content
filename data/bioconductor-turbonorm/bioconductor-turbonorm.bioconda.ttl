@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-turbonorm a schema:SoftwareApplication ;
    schema:description "A fast scatterplot smoother suitable for microarray normalization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/TurboNorm_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/TurboNorm/TurboNorm_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/TurboNorm_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-turbonorm/bioconductor-turbonorm_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-convert",
        "bioconductor-limma",
        "bioconductor-marray",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-lattice",
        "zlib" ;
    schema:identifier biotools:turbonorm ;
    schema:license "LGPL" ;
    schema:name "bioconductor-turbonorm" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/TurboNorm.html" .

