@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rgsea a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Random Gene Set Enrichment Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RGSEA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RGSEA/RGSEA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RGSEA_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgsea/bioconductor-rgsea_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "r-base" ;
    schema:identifier biotools:rgsea ;
    schema:license "GPL(>=3)" ;
    schema:name "bioconductor-rgsea" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RGSEA.html" .

