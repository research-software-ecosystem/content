@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgsea a schema1:SoftwareApplication ;
    schema1:alternateName "Random Gene Set Enrichment Analysis" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Combining bootstrap aggregating and Gene set enrichment analysis (GSEA), RGSEA is a classfication algorithm with high robustness and no over-fitting problem. It performs well especially for the data generated from different exprements." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RGSEA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RGSEA/RGSEA_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RGSEA_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgsea/bioconductor-rgsea_1.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rgsea" ;
    schema1:license "GPL(>=3)" ;
    schema1:name "bioconductor-rgsea" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RGSEA.html" .

