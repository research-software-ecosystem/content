@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-agdex a schema1:SoftwareApplication ;
    schema1:alternateName "Agreement of Differential Expression Analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/btr362" ;
    schema1:description "A tool to evaluate agreement of differential expression for cross-species genomics" ;
    schema1:identifier <https://bio.tools/biotools:agdex> ;
    schema1:license "GPL Version 2 or later" ;
    schema1:name "bioconductor-agdex" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AGDEX.html" .

