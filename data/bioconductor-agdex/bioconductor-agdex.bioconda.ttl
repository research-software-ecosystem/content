@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-agdex a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/btr362" ;
    schema1:description "Agreement of Differential Expression Analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/AGDEX_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AGDEX_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AGDEX/AGDEX_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-agdex/bioconductor-agdex_1.58.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-gseabase",
        "r-base" ;
    schema1:identifier biotools:agdex ;
    schema1:license "GPL Version 2 or later" ;
    schema1:name "bioconductor-agdex" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AGDEX.html" .

