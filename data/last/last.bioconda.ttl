@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:last a schema:SoftwareApplication ;
    schema:description "LAST finds & aligns related regions of sequences." ;
    schema:downloadUrl "https://gitlab.com/mcfrith/last/-/archive/1651/last-1651.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:last ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "last" ;
    schema:softwareHelp "https://gitlab.com/mcfrith/last/-/blob/1651/doc/last-cookbook.rst" ;
    schema:softwareVersion "1651" ;
    schema:url "https://gitlab.com/mcfrith/last" .

