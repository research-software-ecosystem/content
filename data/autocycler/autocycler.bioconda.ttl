    schema1:identifier "biotools:autocycler" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "mbhall88",
        "rrwick" ;
    schema1:name "autocycler" ;
    schema1:softwareVersion "0.6.2" ;
    schema1:url "https://github.com/rrwick/Autocycler" .

