@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:autocycler a schema:SoftwareApplication ;
    schema:author "mbhall88",
        "rrwick" ;
    schema:citation "doi:10.5281/zenodo.14642607" ;
    schema:description "A tool for generating consensus long-read assemblies for bacterial genomes." ;
    schema:downloadUrl "https://github.com/rrwick/Autocycler/archive/refs/tags/v0.6.2.tar.gz" ;
    schema:identifier biotools:autocycler ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "mbhall88",
        "rrwick" ;
    schema:name "autocycler" ;
    schema:softwareHelp "https://github.com/rrwick/Autocycler/wiki" ;
    schema:softwareVersion "0.6.2" ;
    schema:url "https://github.com/rrwick/Autocycler" .

