@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:autocycler a schema1:SoftwareApplication ;
    schema1:alternateName "A tool for generating consensus long-read assemblies for bacterial genomes." ;
    schema1:citation "doi:10.5281/zenodo.14642607" ;
    schema1:description "A tool for generating consensus long-read assemblies for bacterial genomes." ;
    schema1:identifier biotools:autocycler ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "mbhall88",
        "rrwick" ;
    schema1:name "autocycler" ;
    schema1:softwareVersion "0.7.0" ;
    schema1:url "https://github.com/rrwick/Autocycler" .

