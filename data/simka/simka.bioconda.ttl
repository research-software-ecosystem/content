@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:simka a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btz685",
        "doi:10.7717/peerj-cs.94" ;
    schema:description "Simka and simkaMin are de novo comparative metagenomics tools. Simka represents each dataset as a k-mer spectrum and computes several classical ecological distances between them. SimkaMin outputs approximate (but very similar) results by subsampling the kmer space and requires much less computational resources." ;
    schema:downloadUrl "https://github.com/GATB/simka/releases/download/v1.5.3/simka-v1.5.3-Source.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Simka ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "simka" ;
    schema:softwareVersion "1.5.3" ;
    schema:url "https://github.com/GATB/simka" .

