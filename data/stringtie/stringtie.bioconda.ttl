@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:stringtie a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nbt.3122",
        "doi:10.1038/nprot.2016.095",
        "doi:10.1186/s13059-019-1910-1" ;
    schema:description "StringTie employs efficient algorithms for transcript structure recovery and abundance estimation from bulk RNA-Seq reads aligned to a reference genome." ;
    schema:downloadUrl "https://github.com/gpertea/stringtie/releases/download/v3.0.3/stringtie-3.0.3.tar.gz" ;
    schema:hasPart "bzip2",
        "curl",
        "htslib",
        "xz",
        "zlib" ;
    schema:identifier biotools:stringtie ;
    schema:license "MIT" ;
    schema:name "stringtie" ;
    schema:softwareHelp "https://ccb.jhu.edu/software/stringtie/index.shtml?t=manual" ;
    schema:softwareVersion "3.0.3" ;
    schema:url "https://ccb.jhu.edu/software/stringtie" .

