@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hiannotator a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Functions for annotating GRanges objects" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/hiAnnotator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/Archive/hiAnnotator/hiAnnotator_1.40.0.tar.gz",
        "https://bioconductor.org/packages/3.20/bioc/src/contrib/hiAnnotator_1.40.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hiannotator/bioconductor-hiannotator_1.40.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-bsgenome",
        "bioconductor-genomicranges",
        "bioconductor-rtracklayer",
        "r-base",
        "r-dplyr",
        "r-foreach",
        "r-ggplot2",
        "r-iterators",
        "r-scales" ;
    schema:identifier biotools:hiannotator ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-hiannotator" ;
    schema:softwareVersion "1.40.0" ;
    schema:url "https://bioconductor.org/packages/3.20/bioc/html/hiAnnotator.html" .

