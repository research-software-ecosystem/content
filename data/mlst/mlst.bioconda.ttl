@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mlst a schema:SoftwareApplication ;
    schema:description "Scan contig files against PubMLST typing schemes" ;
    schema:downloadUrl "https://github.com/tseemann/mlst/archive/v2.35.0.tar.gz" ;
    schema:identifier biotools:mlst ;
    schema:license "GPL-2.0" ;
    schema:name "mlst" ;
    schema:softwareVersion "2.35.0" ;
    schema:url "https://github.com/tseemann/mlst" .

