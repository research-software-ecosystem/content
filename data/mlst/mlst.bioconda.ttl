@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mlst a schema1:SoftwareApplication ;
    schema1:alternateName "Scan contig files against PubMLST typing schemes" ;
    schema1:description "Scan contig files against PubMLST typing schemes" ;
    schema1:identifier <https://bio.tools/biotools:mlst> ;
    schema1:license "GPL-2.0" ;
    schema1:name "mlst" ;
    schema1:softwareVersion "2.35.0" ;
    schema1:url "https://github.com/tseemann/mlst" .

