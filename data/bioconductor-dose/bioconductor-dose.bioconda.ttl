@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dose a schema:SoftwareApplication ;
    schema:description "Disease Ontology Semantic and Enrichment analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DOSE_4.4.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DOSE/DOSE_4.4.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DOSE_4.4.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dose/bioconductor-dose_4.4.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocparallel",
        "bioconductor-fgsea",
        "bioconductor-gosemsim",
        "bioconductor-qvalue",
        "r-base",
        "r-ggplot2",
        "r-reshape2",
        "r-yulab.utils" ;
    schema:identifier biotools:dose ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-dose" ;
    schema:softwareVersion "4.4.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DOSE.html" .

