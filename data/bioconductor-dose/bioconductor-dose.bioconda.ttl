@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dose a schema1:SoftwareApplication ;
    schema1:description "Disease Ontology Semantic and Enrichment analysis" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DOSE_4.4.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DOSE/DOSE_4.4.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DOSE_4.4.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dose/bioconductor-dose_4.4.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biocparallel",
        "bioconductor-fgsea",
        "bioconductor-gosemsim",
        "bioconductor-qvalue",
        "r-base",
        "r-ggplot2",
        "r-reshape2",
        "r-yulab.utils" ;
    schema1:identifier biotools:dose ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-dose" ;
    schema1:softwareVersion "4.4.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DOSE.html" .

