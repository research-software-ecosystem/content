@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dig2 a schema:SoftwareApplication ;
    schema:description "dig2 is a simple but flexible in silico digester of protein sequences in the FASTA format. It allows for almost any enzyme to be simulated, including MS/MS enzymes to generate CID or ECD/ETD fragments." ;
    schema:downloadUrl "http://www.ms-utils.org/dig2/dig2.c" ;
    schema:identifier biotools:dig2 ;
    schema:license "GPL3" ;
    schema:name "dig2" ;
    schema:softwareVersion "1.0" ;
    schema:url "http://www.ms-utils.org/dig2/dig2.html" .

