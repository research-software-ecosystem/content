@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:impute2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1534/g3.111.001198" ;
    schema:description "Genotype imputation and haplotype phasing" ;
    schema:identifier biotools:IMPUTE2 ;
    schema:license "Academic use, commerically restricted (http://www.stats.ox.ac.uk/~marchini/software/gwas/gwas.html#licence)" ;
    schema:name "impute2" ;
    schema:softwareVersion "2.3.2" ;
    schema:url "https://mathgen.stats.ox.ac.uk/impute/impute_v2.html" .

