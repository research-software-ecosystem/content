@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-flowcore a schema1:SoftwareApplication ;
    schema1:alternateName "flowCore: Basic structures for flow cytometry data" ;
    schema1:citation "doi:10.1186/1471-2105-10-106" ;
    schema1:description "Provides S4 data structures and basic functions to deal with flow cytometry data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/flowCore_2.22.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowCore/flowCore_2.22.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowCore_2.22.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowcore/bioconductor-flowcore_2.22.1_src_all.tar.gz" ;
    schema1:identifier "biotools:flowcore" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-flowcore" ;
    schema1:softwareVersion "2.22.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/flowCore.html" .

