@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-flowcore a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-10-106" ;
    schema:description "flowCore: Basic structures for flow cytometry data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/flowCore_2.22.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/flowCore/flowCore_2.22.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/flowCore_2.22.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-flowcore/bioconductor-flowcore_2.22.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-cytolib",
        "bioconductor-rprotobuflib",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-bh",
        "r-cpp11",
        "r-matrixstats",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:flowcore ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-flowcore" ;
    schema:softwareVersion "2.22.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/flowCore.html" .

