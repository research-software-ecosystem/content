@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affycoretools a schema1:SoftwareApplication ;
    schema1:alternateName "Functions useful for those doing repetitive analyses with Affymetrix GeneChips" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Various wrapper functions that have been written to streamline the more common analyses that a core Biostatistician might see." ;
    schema1:identifier <https://bio.tools/biotools:affycoretools> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-affycoretools" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affycoretools.html" .

