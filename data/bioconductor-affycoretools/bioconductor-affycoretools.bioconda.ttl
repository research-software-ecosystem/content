@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affycoretools a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Functions useful for those doing repetitive analyses with Affymetrix GeneChips" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/affycoretools_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/affycoretools/affycoretools_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/affycoretools_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affycoretools/bioconductor-affycoretools_1.82.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-affy",
        "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-edger",
        "bioconductor-gcrma",
        "bioconductor-glimma",
        "bioconductor-gostats",
        "bioconductor-limma",
        "bioconductor-oligoclasses",
        "bioconductor-reportingtools",
        "bioconductor-s4vectors",
        "r-base",
        "r-dbi",
        "r-ggplot2",
        "r-gplots",
        "r-hwriter",
        "r-lattice",
        "r-rsqlite",
        "r-xtable" ;
    schema1:identifier biotools:affycoretools ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-affycoretools" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/affycoretools.html" .

