@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-sincell a schema1:SoftwareApplication ;
    schema1:description "R package for the statistical assessment of cell state hierarchies from single-cell RNA-seq data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/sincell_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sincell/sincell_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sincell_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sincell/bioconductor-sincell_1.42.0_src_all.tar.gz" ;
    schema1:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-entropy",
        "r-fastica",
        "r-fields",
        "r-ggplot2",
        "r-igraph",
        "r-mass",
        "r-proxy",
        "r-rcpp",
        "r-reshape2",
        "r-rtsne",
        "r-scatterplot3d",
        "r-statmod",
        "r-tsp",
        "zlib" ;
    schema1:identifier biotools:sincell ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-sincell" ;
    schema1:softwareVersion "1.42.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/sincell.html" .

