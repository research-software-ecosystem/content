@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sincell a schema:SoftwareApplication ;
    schema:description "R package for the statistical assessment of cell state hierarchies from single-cell RNA-seq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sincell_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sincell/sincell_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sincell_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sincell/bioconductor-sincell_1.42.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cluster",
        "r-entropy",
        "r-fastica",
        "r-fields",
        "r-ggplot2",
        "r-igraph",
        "r-mass",
        "r-proxy",
        "r-rcpp",
        "r-reshape2",
        "r-rtsne",
        "r-scatterplot3d",
        "r-statmod",
        "r-tsp",
        "zlib" ;
    schema:identifier biotools:sincell ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-sincell" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sincell.html" .

