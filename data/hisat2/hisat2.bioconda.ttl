@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:hisat2 a schema1:SoftwareApplication ;
    schema1:alternateName "Graph-based alignment of next generation sequencing reads to a population of genomes." ;
    schema1:citation "doi:10.1038/nmeth.3317",
        "doi:10.1038/s41587-019-0201-4" ;
    schema1:description "HISAT2 is a fast and sensitive alignment program for mapping next-generation sequencing reads (both DNA and RNA) to a population of human genomes as well as to a single reference genome." ;
    schema1:downloadUrl "https://github.com/DaehwanKimLab/hisat2/archive/v2.2.2.tar.gz" ;
    schema1:identifier "biotools:HISAT2",
        "usegalaxy-eu:hisat2" ;
    schema1:license "GPL-3.0" ;
    schema1:name "hisat2" ;
    schema1:softwareVersion "2.2.2" ;
    schema1:url "http://daehwankimlab.github.io/hisat2" .

