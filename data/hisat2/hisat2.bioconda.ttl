@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hisat2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3317",
        "doi:10.1038/s41587-019-0201-4" ;
    schema:description "Graph-based alignment of next generation sequencing reads to a population of genomes." ;
    schema:downloadUrl "https://github.com/DaehwanKimLab/hisat2/archive/v2.2.2.tar.gz" ;
    schema:identifier biotools:HISAT2 ;
    schema:license "GPL-3.0" ;
    schema:name "hisat2" ;
    schema:softwareHelp "https://daehwankimlab.github.io/hisat2/manual/" ;
    schema:softwareVersion "2.2.2" ;
    schema:url "http://daehwankimlab.github.io/hisat2" .

