@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bamutil a schema1:SoftwareApplication ;
    schema1:alternateName "Programs that perform operations on SAM/BAM files, all built into a single executable, bam." ;
    schema1:description "Programs that perform operations on SAM/BAM files, all built into a single executable, bam." ;
    schema1:identifier <https://bio.tools/biotools:Bamutil> ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "bamutil" ;
    schema1:softwareVersion "1.0.15" ;
    schema1:url "https://genome.sph.umich.edu/wiki/BamUtil" .

