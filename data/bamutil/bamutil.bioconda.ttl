@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bamutil a schema:SoftwareApplication ;
    schema:description "Programs that perform operations on SAM/BAM files, all built into a single executable, bam." ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:Bamutil ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "bamutil" ;
    schema:softwareHelp "https://genome.sph.umich.edu/wiki/BamUtil" ;
    schema:softwareVersion "1.0.15" ;
    schema:url "https://genome.sph.umich.edu/wiki/BamUtil" .

