    schema1:dateCreated "2024-11-22" ;
    schema1:description "MMUPHin is an R package implementing meta-analysis methods for microbial community profiles" ;
    schema1:encodingFormat "pdf",
        "tabular" ;
    schema1:identifier biotools:mmuphin,
        bioconda:bioconductor-mmuphin ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=466bdd8ba7b67264> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "mmuphin" ;
    schema1:softwareVersion "1.16.0" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/mmuphin> .

