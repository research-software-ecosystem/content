@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-icobra a schema1:SoftwareApplication ;
    schema1:description "Comparison and Visualization of Ranking and Assignment Methods" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/iCOBRA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iCOBRA/iCOBRA_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iCOBRA_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-icobra/bioconductor-icobra_1.38.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-limma",
        "r-base",
        "r-dplyr",
        "r-dt",
        "r-ggplot2",
        "r-reshape2",
        "r-rlang",
        "r-rocr",
        "r-scales",
        "r-shiny",
        "r-shinybs",
        "r-shinydashboard",
        "r-upsetr" ;
    schema1:identifier biotools:icobra ;
    schema1:license "GPL (>=2)" ;
    schema1:name "bioconductor-icobra" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/iCOBRA.html" .

