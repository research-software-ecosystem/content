@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sra-tools a schema:SoftwareApplication ;
    schema:author "rajwanir2" ;
    schema:description "The SRA Toolkit and SDK from NCBI." ;
    schema:identifier biotools:sra-tools ;
    schema:license "Public Domain" ;
    schema:maintainer "rajwanir2" ;
    schema:name "sra-tools" ;
    schema:softwareHelp "https://github.com/ncbi/sra-tools/wiki" ;
    schema:softwareVersion "3.4.1" ;
    schema:url "https://github.com/ncbi/sra-tools" .

