      "sc:author": "Alireza Balaei Kahnamoei",
      "sc:description": "A two-step desktop GUI application for RNA-seq differential gene expression (DEG) analysis. Step 1 reads raw GDC/TCGA STAR gene-count files together with a GDC sample sheet, matches samples to a Tumor/Normal design, and runs PyDESeq2 to produce normalized counts and DEG statistics. Step 2 generates publication-style volcano plots, MA plots, summary bar charts, and expression heatmaps (with optional gene labeling) from the results, exportable as PNG, PDF, SVG, or TIFF. Requires no coding from the user.",
      "sc:featureList": [
        {
          "@id": "edam:operation_2945"
        },
        {
          "@id": "edam:operation_0337"
        }
      ],
      "sc:isAccessibleForFree": true,
      "sc:license": "MIT",
      "sc:name": "DEG Pipeline and Visualizer",
      "sc:operatingSystem": [
        "Linux",
        "Mac",
        "Windows"
      ],
