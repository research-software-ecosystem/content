@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-methylpipe a schema1:SoftwareApplication ;
    schema1:alternateName "Base resolution DNA methylation data analysis" ;
    schema1:description "Memory efficient analysis of base resolution DNA methylation data in both the CpG and non-CpG sequence context. Integration of DNA methylation data derived from any methodology providing base- or low-resolution data." ;
    schema1:identifier biotools:methylpipe ;
    schema1:license "GPL(>=2)" ;
    schema1:name "bioconductor-methylpipe" ;
    schema1:softwareVersion "1.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/methylPipe.html" .

