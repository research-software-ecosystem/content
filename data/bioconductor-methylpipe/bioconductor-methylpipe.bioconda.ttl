@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-methylpipe a schema:SoftwareApplication ;
    schema:description "Base resolution DNA methylation data analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/methylPipe_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/methylPipe/methylPipe_1.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/methylPipe_1.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-methylpipe/bioconductor-methylpipe_1.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicalignments",
        "bioconductor-genomicranges",
        "bioconductor-gviz",
        "bioconductor-iranges",
        "bioconductor-marray",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "r-gplots",
        "zlib" ;
    schema:identifier biotools:methylpipe ;
    schema:license "GPL(>=2)" ;
    schema:name "bioconductor-methylpipe" ;
    schema:softwareVersion "1.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/methylPipe.html" .

