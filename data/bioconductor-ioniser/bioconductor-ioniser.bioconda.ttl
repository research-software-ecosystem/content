@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ioniser a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Quality Assessment Tools for Oxford Nanopore MinION data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/IONiseR_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IONiseR/IONiseR_2.34.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/IONiseR_2.34.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ioniser/bioconductor-ioniser_2.34.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biostrings",
        "bioconductor-rhdf5",
        "bioconductor-shortread",
        "bioconductor-xvector",
        "r-base",
        "r-bit64",
        "r-dplyr",
        "r-ggplot2",
        "r-magrittr",
        "r-stringr",
        "r-tibble",
        "r-tidyr" ;
    schema:identifier biotools:ioniser ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-ioniser" ;
    schema:softwareVersion "2.34.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/IONiseR.html" .

