@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rankprod a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btl476" ;
    schema:description "Rank Product method for identifying differentially expressed genes with application in meta-analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RankProd_3.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RankProd/RankProd_3.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RankProd_3.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rankprod/bioconductor-rankprod_3.36.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-gmp",
        "r-rmpfr" ;
    schema:identifier biotools:rankprod ;
    schema:license "file LICENSE" ;
    schema:name "bioconductor-rankprod" ;
    schema:softwareVersion "3.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RankProd.html" .

