@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rankprod a schema1:SoftwareApplication ;
    schema1:alternateName "Rank Product method for identifying differentially expressed genes with application in meta-analysis" ;
    schema1:citation "doi:10.1093/bioinformatics/btl476" ;
    schema1:description "Non-parametric method for identifying differentially expressed (up- or down- regulated) genes based on the estimated percentage of false predictions (pfp). The method can combine data sets from different origins (meta-analysis) to increase the power of the identification." ;
    schema1:identifier biotools:rankprod ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-rankprod" ;
    schema1:softwareVersion "3.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RankProd.html" .

