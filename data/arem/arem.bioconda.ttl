@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:arem a schema:SoftwareApplication ;
    schema:description """Aligning Reads by Expectation-Maximization.
Based on MACS (Model Based Analysis for ChIP-Seq data)""" ;
    schema:downloadUrl "https://pypi.python.org/packages/bc/0d/6db36d917d821d150f37c68839d8911e52b78c867b27372da5be41d4cc4f/AREM-1.0.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:arem ;
    schema:license "Artistic License" ;
    schema:name "arem" ;
    schema:softwareVersion "1.0.1" ;
    schema:url "http://cbcl.ics.uci.edu/AREM" .

