@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:discovar a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ng.3121" ;
    schema:description "Suitable for variant calling with reference and de novo assembly of small genomes." ;
    schema:downloadUrl "ftp://ftp.broadinstitute.org/pub/crd/Discovar/latest_source_code/discovar-52488.tar.gz" ;
    schema:identifier biotools:discovar ;
    schema:license "MIT" ;
    schema:name "discovar" ;
    schema:softwareVersion "52488" ;
    schema:url "https://www.broadinstitute.org/software/discovar" .

