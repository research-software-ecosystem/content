@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:orfm a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw241" ;
    schema:description "OrfM is a simple and not slow ORF caller." ;
    schema:downloadUrl "https://github.com/wwood/OrfM/archive/2.1.1.tar.gz" ;
    schema:identifier biotools:orfm ;
    schema:license "LGPL-3.0-or-later" ;
    schema:name "orfm" ;
    schema:softwareVersion "2.1.1" ;
    schema:url "https://github.com/wwood/OrfM" .

