@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-reactomepa a schema1:SoftwareApplication ;
    schema1:alternateName "Reactome Pathway Analysis" ;
    schema1:description "This package provides functions for pathway analysis based on REACTOME pathway database. It implements enrichment analysis, gene set enrichment analysis and several functions for visualization. This package is not affiliated with the Reactome team." ;
    schema1:identifier <https://bio.tools/biotools:reactomepa> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-reactomepa" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ReactomePA.html" .

