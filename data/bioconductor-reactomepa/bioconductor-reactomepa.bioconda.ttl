@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-reactomepa a schema:SoftwareApplication ;
    schema:description "Reactome Pathway Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ReactomePA_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ReactomePA/ReactomePA_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ReactomePA_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-reactomepa/bioconductor-reactomepa_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-dose",
        "bioconductor-enrichplot",
        "bioconductor-graphite",
        "bioconductor-reactome.db",
        "r-base",
        "r-ggplot2",
        "r-ggraph",
        "r-gson",
        "r-igraph",
        "r-yulab.utils" ;
    schema:identifier biotools:reactomepa ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-reactomepa" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ReactomePA.html" .

