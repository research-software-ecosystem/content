@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lmdme a schema:SoftwareApplication ;
    schema:description "Linear Model decomposition for Designed Multivariate Experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/lmdme_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lmdme/lmdme_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/lmdme_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lmdme/bioconductor-lmdme_1.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-limma",
        "bioconductor-stemhypoxia",
        "r-base",
        "r-pls" ;
    schema:identifier biotools:lmdme ;
    schema:license "GPL (>=2)" ;
    schema:name "bioconductor-lmdme" ;
    schema:softwareVersion "1.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/lmdme.html" .

