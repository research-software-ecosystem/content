@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-massir a schema:SoftwareApplication ;
    schema:description "massiR: MicroArray Sample Sex Identifier" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/massiR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/massiR/massiR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/massiR_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-massir/bioconductor-massir_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-cluster",
        "r-diptest",
        "r-gplots" ;
    schema:identifier biotools:massir ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-massir" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/massiR.html" .

