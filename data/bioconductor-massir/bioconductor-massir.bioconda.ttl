@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-massir a schema1:SoftwareApplication ;
    schema1:alternateName "massiR: MicroArray Sample Sex Identifier" ;
    schema1:description "Predicts the sex of samples in gene expression microarray datasets" ;
    schema1:identifier <https://bio.tools/biotools:massir> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-massir" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/massiR.html" .

