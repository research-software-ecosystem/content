@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-massir a schema1:SoftwareApplication ;
    schema1:alternateName "massiR: MicroArray Sample Sex Identifier" ;
    schema1:description "Predicts the sex of samples in gene expression microarray datasets" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/massiR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/massiR/massiR_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/massiR_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-massir/bioconductor-massir_1.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:massir" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-massir" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/massiR.html" .

