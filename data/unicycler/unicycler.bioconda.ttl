@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:unicycler a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1005595" ;
    schema:description "Hybrid assembly pipeline for bacterial genomes." ;
    schema:downloadUrl "https://github.com/rrwick/Unicycler/archive/v0.5.1.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "zlib" ;
    schema:identifier biotools:unicycler ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "unicycler" ;
    schema:softwareHelp "https://github.com/rrwick/Unicycler/wiki" ;
    schema:softwareVersion "0.5.1" ;
    schema:url "https://github.com/rrwick/Unicycler" .

