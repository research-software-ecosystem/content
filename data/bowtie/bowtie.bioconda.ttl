@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bowtie a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2009-10-3-r25" ;
    schema:description "An ultrafast memory-efficient short read aligner" ;
    schema:downloadUrl "https://github.com/BenLangmead/bowtie/archive/v1.3.1.tar.gz" ;
    schema:hasPart "tbb",
        "tbb-devel",
        "zlib" ;
    schema:identifier biotools:bowtie ;
    schema:license "Artistic-2.0-only" ;
    schema:name "bowtie" ;
    schema:softwareVersion "1.3.1" ;
    schema:url "https://github.com/BenLangmead/bowtie" .

