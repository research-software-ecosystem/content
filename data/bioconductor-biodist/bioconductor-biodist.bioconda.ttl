@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biodist a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Different distance measures" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/bioDist_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/bioDist/bioDist_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/bioDist_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-biodist/bioconductor-biodist_1.82.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "r-base",
        "r-kernsmooth" ;
    schema1:identifier biotools:biodist ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biodist" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bioDist.html" .

