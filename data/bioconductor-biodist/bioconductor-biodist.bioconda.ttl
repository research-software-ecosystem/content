@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-biodist a schema1:SoftwareApplication ;
    schema1:alternateName "Different distance measures" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A collection of software tools for calculating distance measures." ;
    schema1:identifier biotools:biodist ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-biodist" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/bioDist.html" .

