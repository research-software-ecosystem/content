@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:flash2 a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btr507" ;
    schema:description "Merge paired-end reads from fragments that are shorter than twice the read length." ;
    schema:downloadUrl "https://github.com/dstreett/FLASH2/archive/2.2.00.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:flash ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "flash2" ;
    schema:softwareVersion "2.2.00" ;
    schema:url "https://github.com/dstreett/FLASH2" .

