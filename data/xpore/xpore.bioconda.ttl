@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:xpore a schema1:SoftwareApplication ;
    schema1:alternateName "xpore is a python package for Nanopore data analysis of differential RNA modifications." ;
    schema1:citation "doi:10.1101/2020.06.18.160010" ;
    schema1:description "xpore is a python package for Nanopore data analysis of differential RNA modifications." ;
    schema1:identifier biotools:xpore ;
    schema1:license "MIT" ;
    schema1:maintainer "artbio" ;
    schema1:name "xpore" ;
    schema1:softwareVersion "2.2" ;
    schema1:url "https://github.com/GoekeLab/xpore" .

