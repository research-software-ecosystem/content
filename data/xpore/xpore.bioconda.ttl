@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:xpore a schema:SoftwareApplication ;
    schema:author "artbio" ;
    schema:citation "doi:10.1101/2020.06.18.160010" ;
    schema:description "xpore is a python package for Nanopore data analysis of differential RNA modifications." ;
    schema:downloadUrl "https://pypi.io/packages/source/x/xpore/xpore-2.1.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:xpore ;
    schema:license "MIT" ;
    schema:maintainer "artbio" ;
    schema:name "xpore" ;
    schema:softwareHelp "https://xpore.readthedocs.io/en/latest/" ;
    schema:softwareVersion "2.1" ;
    schema:url "https://github.com/GoekeLab/xpore" .

