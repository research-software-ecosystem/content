@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-cellmapper a schema1:SoftwareApplication ;
    schema1:alternateName "Predict genes expressed selectively in specific cell types" ;
    schema1:description "Infers cell type-specific expression based on co-expression similarity with known cell type marker genes. Can make accurate predictions using publicly available expression data, even when a cell type has not been isolated before." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/CellMapper_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CellMapper/CellMapper_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CellMapper_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cellmapper/bioconductor-cellmapper_1.36.0_src_all.tar.gz" ;
    schema1:identifier "biotools:cellmapper" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-cellmapper" ;
    schema1:softwareVersion "1.36.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/CellMapper.html" .

