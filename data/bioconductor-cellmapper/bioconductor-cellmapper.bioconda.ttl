@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cellmapper a schema:SoftwareApplication ;
    schema:description "Predict genes expressed selectively in specific cell types" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CellMapper_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CellMapper/CellMapper_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CellMapper_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cellmapper/bioconductor-cellmapper_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:cellmapper ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-cellmapper" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CellMapper.html" .

