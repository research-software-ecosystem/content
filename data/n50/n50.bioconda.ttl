@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:n50 a schema:SoftwareApplication ;
    schema:author "telatin" ;
    schema:citation "doi:10.3390/bioengineering8050059" ;
    schema:description "A command-line tool to calculate the N50 value of a set of sequences and other utilities." ;
    schema:downloadUrl "https://github.com/quadram-institute-bioscience/n50/archive/refs/tags/v1.9.3.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:n50 ;
    schema:license "MIT" ;
    schema:maintainer "telatin" ;
    schema:name "n50" ;
    schema:softwareHelp "https://github.com/quadram-institute-bioscience/n50/blob/v1.9.3/README.md" ;
    schema:softwareVersion "1.9.3" ;
    schema:url "https://github.com/quadram-institute-bioscience/n50" .

