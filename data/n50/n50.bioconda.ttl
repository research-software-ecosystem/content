@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:n50 a schema1:SoftwareApplication ;
    schema1:alternateName "A command-line tool to calculate the N50 value of a set of sequences and other utilities." ;
    schema1:citation "doi:10.3390/bioengineering8050059" ;
    schema1:description "This repository provides tools for N50 calculation and dataset simulation." ;
    schema1:identifier biotools:n50 ;
    schema1:license "MIT" ;
    schema1:maintainer "telatin" ;
    schema1:name "n50" ;
    schema1:softwareVersion "1.9.3" ;
    schema1:url "https://github.com/quadram-institute-bioscience/n50" .

