@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:checkv a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41587-020-00774-7" ;
    schema:description "Assess the quality of metagenome-assembled viral genomes." ;
    schema:downloadUrl "https://pypi.io/packages/source/c/checkv/checkv-1.1.1.tar.gz" ;
    schema:hasPart "flit-core",
        "pip",
        "python" ;
    schema:identifier biotools:checkv ;
    schema:license "BSD-3-Clause-LBNL" ;
    schema:name "checkv" ;
    schema:softwareVersion "1.1.1" ;
    schema:url "https://bitbucket.org/berkeleylab/checkv" .

