@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:checkv a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:operation_2429,
        edam:topic_0102,
        edam:topic_0196,
        edam:topic_3174,
        edam:topic_3837 ;
    schema1:codeRepository <https://bitbucket.org/berkeleylab/checkv/> ;
    schema1:dateCreated "2024-09-13" ;
    schema1:description "Assess quality of single-contig viral genomes" ;
    schema1:encodingFormat "fasta",
        "tabular" ;
    schema1:featureList edam:data_0925,
        edam:operation_0310,
        edam:operation_2428,
        edam:operation_3198,
        edam:topic_0196 ;
    schema1:identifier biotools:checkv,
        bioconda:checkv ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=36de05d50c703164>,
        <https://usegalaxy.eu/published/workflow?id=62392daea25a3980>,
        <https://usegalaxy.eu/published/workflow?id=87231a6a7938cb95>,
        <https://usegalaxy.eu/published/workflow?id=c62d65832377e376>,
        <https://usegalaxy.org> ;
    schema1:keywords "Metagenomics" ;
    schema1:name "checkv" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/Helmholtz-UFZ/ufz-galaxy-tools/blob/main/tools/checkv/> .

