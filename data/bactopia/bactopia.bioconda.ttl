@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bactopia a schema:SoftwareApplication ;
    schema:author "rpetit3" ;
    schema:citation "doi:10.1128/mSystems.00190-20" ;
    schema:description "Bactopia is a flexible pipeline for complete analysis of bacterial genomes." ;
    schema:downloadUrl "https://github.com/bactopia/bactopia/archive/v4.0.0.tar.gz" ;
    schema:identifier biotools:bactopia ;
    schema:license "MIT" ;
    schema:maintainer "rpetit3" ;
    schema:name "bactopia" ;
    schema:softwareVersion "4.0.0" ;
    schema:url "https://bactopia.io/" .

