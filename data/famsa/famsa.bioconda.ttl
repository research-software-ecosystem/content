@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:famsa a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/srep33964" ;
    schema:description "Algorithm for large-scale multiple sequence alignments." ;
    schema:downloadUrl "https://github.com/refresh-bio/famsa/releases/download/v2.4.1/famsa-v2.4.1-arm64_mac.tar.gz" ;
    schema:identifier biotools:famsa ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "famsa" ;
    schema:softwareVersion "2.4.1" ;
    schema:url "https://github.com/refresh-bio/FAMSA" .

