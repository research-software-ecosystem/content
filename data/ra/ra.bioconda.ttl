@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ra a schema:SoftwareApplication ;
    schema:description "Ra is short for RNA Assembler and it is a C++ implementation of an overlap-layout-consensus transcriptome assembler." ;
    schema:downloadUrl "https://github.com/mariokostelac/ra/archive/v0.9.tar.gz" ;
    schema:hasPart "libgomp",
        "llvm-openmp" ;
    schema:identifier biotools:ra ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "ra" ;
    schema:softwareVersion "0.9" ;
    schema:url "https://github.com/mariokostelac/ra" .

