@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ra a schema1:SoftwareApplication ;
    schema1:alternateName "Ra is short for RNA Assembler and it is a C++ implementation of an overlap-layout-consensus transcriptome assembler." ;
    schema1:description "Ra is short for RNA Assembler and it is a C++ implementation of an overlap-layout-consensus transcriptome assembler." ;
    schema1:identifier <https://bio.tools/biotools:ra> ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:name "ra" ;
    schema1:softwareVersion "0.9" ;
    schema1:url "https://github.com/mariokostelac/ra" .

