@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:phabox a schema:SoftwareApplication ;
    schema:author "PENG Cheng",
        "SHANG Jiayu" ;
    schema:citation "doi:10.1093/bioadv/vbad101" ;
    schema:description "Virus identification and analysis tool set" ;
    schema:downloadUrl "https://github.com/KennthShang/PhaBOX/archive/refs/tags/v2.1.13.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:phabox ;
    schema:license "GPL-3.0" ;
    schema:maintainer "PENG Cheng",
        "SHANG Jiayu" ;
    schema:name "phabox" ;
    schema:softwareHelp "https://github.com/KennthShang/PhaBOX/wiki" ;
    schema:softwareVersion "2.1.13" ;
    schema:url "https://github.com/KennthShang/PhaBOX" .

