@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-spem a schema:SoftwareApplication ;
    schema:citation "doi:10.1089/cmb.2011.0269" ;
    schema:description "S-system parameter estimation method" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SPEM_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SPEM/SPEM_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SPEM_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-spem/bioconductor-spem_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-rsolnp" ;
    schema:identifier biotools:spem ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-spem" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SPEM.html" .

