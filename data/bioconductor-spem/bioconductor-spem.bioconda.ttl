@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-spem a schema1:SoftwareApplication ;
    schema1:alternateName "S-system parameter estimation method" ;
    schema1:citation "doi:10.1089/cmb.2011.0269" ;
    schema1:description "This package can optimize the parameter in S-system models given time series data" ;
    schema1:identifier biotools:spem ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-spem" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SPEM.html" .

