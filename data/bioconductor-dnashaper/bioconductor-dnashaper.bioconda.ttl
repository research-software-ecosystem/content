@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dnashaper a schema:SoftwareApplication ;
    schema:description "High-throughput prediction of DNA shape features" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DNAshapeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DNAshapeR/DNAshapeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DNAshapeR_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dnashaper/bioconductor-dnashaper_1.38.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-fields",
        "r-rcpp",
        "zlib" ;
    schema:identifier biotools:dnashaper ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-dnashaper" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DNAshapeR.html" .

