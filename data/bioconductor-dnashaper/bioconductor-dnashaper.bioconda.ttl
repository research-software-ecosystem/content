@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dnashaper a schema1:SoftwareApplication ;
    schema1:alternateName "High-throughput prediction of DNA shape features" ;
    schema1:description "DNAhapeR is an R/BioConductor package for ultra-fast, high-throughput predictions of DNA shape features. The package allows to predict, visualize and encode DNA shape features for statistical learning." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/DNAshapeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DNAshapeR/DNAshapeR_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DNAshapeR_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dnashaper/bioconductor-dnashaper_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:dnashaper" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-dnashaper" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DNAshapeR.html" .

