@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bwa a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp324",
        "doi:10.1093/bioinformatics/btp698",
        "doi:10.48550/arXiv.1303.3997" ;
    schema:description "The BWA read mapper." ;
    schema:downloadUrl "https://github.com/lh3/bwa/archive/v0.7.19.tar.gz" ;
    schema:hasPart "zlib" ;
    schema:identifier biotools:bwa ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "bwa" ;
    schema:softwareHelp "https://github.com/lh3/bwa/blob/v0.7.19/README.md" ;
    schema:softwareVersion "0.7.19" ;
    schema:url "https://github.com/lh3/bwa" .

