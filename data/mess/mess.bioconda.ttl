@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mess a schema:SoftwareApplication ;
    schema:author "farchaab",
        "tpillone" ;
    schema:description "Snakemake pipeline for simulating shotgun metagenomic samples" ;
    schema:downloadUrl "https://github.com/metagenlab/MeSS/archive/refs/tags/v0.12.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:mess ;
    schema:license "MIT" ;
    schema:maintainer "farchaab",
        "tpillone" ;
    schema:name "mess" ;
    schema:softwareHelp "https://metagenlab.github.io/MeSS" ;
    schema:softwareVersion "0.12.0" ;
    schema:url "https://github.com/metagenlab/MeSS" .

