@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mess a schema1:SoftwareApplication ;
    schema1:alternateName "Snakemake pipeline for simulating shotgun metagenomic samples" ;
    schema1:description "Snakemake pipeline for simulating shotgun metagenomic samples" ;
    schema1:identifier <https://bio.tools/biotools:mess> ;
    schema1:license "MIT" ;
    schema1:maintainer "farchaab",
        "tpillone" ;
    schema1:name "mess" ;
    schema1:softwareVersion "0.12.0" ;
    schema1:url "https://github.com/metagenlab/MeSS" .

