@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:lollipop a schema:SoftwareApplication ;
    schema:author "DrYak" ;
    schema:citation "doi:10.1101/2022.11.02.22281825" ;
    schema:description "A tool for Deconvolution for Wastewater Genomics" ;
    schema:downloadUrl "https://github.com/cbg-ethz/LolliPop/archive/v0.5.3.tar.gz" ;
    schema:hasPart "pip",
        "poetry-core",
        "poetry-dynamic-versioning",
        "python" ;
    schema:identifier biotools:lollipop ;
    schema:license "GNU General Public License v3 or later (GPLv3+)" ;
    schema:maintainer "DrYak" ;
    schema:name "lollipop" ;
    schema:softwareVersion "0.5.3" ;
    schema:url "https://github.com/cbg-ethz/LolliPop" .

