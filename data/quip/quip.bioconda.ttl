@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:quip a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gks754" ;
    schema:description "Aggressive compression of FASTQ and SAM/BAM files." ;
    schema:downloadUrl "https://github.com/dcjones/quip/archive/refs/tags/v1.1.8.tar.gz" ;
    schema:hasPart "bzip2",
        "zlib" ;
    schema:identifier biotools:quip ;
    schema:license "Custom" ;
    schema:name "quip" ;
    schema:softwareVersion "1.1.8" ;
    schema:url "http://homes.cs.washington.edu/%7Edcjones/quip" .

