@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:qualimap a schema:SoftwareApplication ;
    schema:description "Quality control of alignment sequencing data and its derivatives like feature counts" ;
    schema:downloadUrl "https://bitbucket.org/kokonech/qualimap/downloads/qualimap_v2.3.zip" ;
    schema:identifier biotools:qualimap ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "qualimap" ;
    schema:softwareVersion "2.3" ;
    schema:url "http://qualimap.bioinfo.cipf.es/" .

