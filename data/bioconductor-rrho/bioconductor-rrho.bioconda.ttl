@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rrho a schema1:SoftwareApplication ;
    schema1:alternateName "Inference on agreement between ordered lists" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "The package is aimed at inference on the amount of agreement in two sorted lists using the Rank-Rank Hypergeometric Overlap test." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RRHO_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RRHO/RRHO_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RRHO_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rrho/bioconductor-rrho_1.50.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rrho" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-rrho" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RRHO.html" .

