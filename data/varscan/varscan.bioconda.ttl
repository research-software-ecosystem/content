@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:varscan a schema:SoftwareApplication ;
    schema:description "variant detection in massively parallel sequencing data" ;
    schema:downloadUrl "https://github.com/dkoboldt/varscan/raw/master/VarScan.v2.4.6.jar" ;
    schema:identifier biotools:varscan ;
    schema:license "The Non-Profit Open Software License version 3.0 (NPOSL-3.0)" ;
    schema:name "varscan" ;
    schema:softwareVersion "2.4.6" ;
    schema:url "http://dkoboldt.github.io/varscan/" .

