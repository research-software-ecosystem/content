@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:abyss a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/gr.089532.108",
        "doi:10.1101/gr.214346.116" ;
    schema:description "Assembly By Short Sequences - a de novo, parallel, paired-end short read sequence assembler." ;
    schema:downloadUrl "https://github.com/BirolLab/abyss/releases/download/2.3.10/abyss-2.3.10.tar.gz" ;
    schema:hasPart "boost-cpp",
        "btllib",
        "openmpi",
        "sparsehash" ;
    schema:identifier biotools:abyss ;
    schema:license "GPL-3.0-only" ;
    schema:name "abyss" ;
    schema:softwareHelp "https://github.com/BirolLab/abyss/blob/v2.3.10/README.md" ;
    schema:softwareVersion "2.3.10" ;
    schema:url "https://github.com/BirolLab/abyss" .

