@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:abyss a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196 ;
    schema1:codeRepository <https://github.com/bcgsc/abyss> ;
    schema1:dateCreated "2015-04-14" ;
    schema1:description "Assembly By Short Sequences - a de novo, parallel, paired-end sequence assembler" ;
    schema1:encodingFormat "fasta",
        "tabular" ;
    schema1:featureList edam:operation_0524,
        edam:operation_0525,
        edam:operation_3216,
        edam:operation_3440 ;
    schema1:identifier biotools:abyss,
        bioconda:abyss ;
    schema1:isPartOf <https://mississippi.sorbonne-universite.fr>,
        <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.no>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Assembly" ;
    schema1:name "abyss" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/abyss> .

