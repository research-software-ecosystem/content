@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-multiassayexperiment a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/144774" ;
    schema:description "Software for the integration of multi-omics experiments in Bioconductor" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MultiAssayExperiment_1.36.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MultiAssayExperiment/MultiAssayExperiment_1.36.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MultiAssayExperiment_1.36.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-multiassayexperiment/bioconductor-multiassayexperiment_1.36.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocbaseutils",
        "bioconductor-biocgenerics",
        "bioconductor-delayedarray",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-tidyr" ;
    schema:identifier biotools:multiassayexperiment ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-multiassayexperiment" ;
    schema:softwareVersion "1.36.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MultiAssayExperiment.html" .

