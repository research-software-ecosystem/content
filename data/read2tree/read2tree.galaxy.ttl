@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:read2tree a schema1:SoftwareApplication ;
    bioschemas:output "newick" ;
    schema1:applicationSubCategory edam:topic_0194 ;
    schema1:codeRepository "https://github.com/DessimozLab/read2tree" ;
    schema1:dateCreated "2025-11-23" ;
    schema1:description "Infer a species tree from sequencing reads." ;
    schema1:encodingFormat "newick" ;
    schema1:identifier biotools:read2tree,
        bioconda:read2tree ;
    schema1:keywords "Phylogenetics" ;
    schema1:name "read2tree" ;
    schema1:softwareVersion "@TOOL_VERSION@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/read2tree" .

