@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dbcan a schema:SoftwareApplication ;
    schema:author "Xinpeng021001" ;
    schema:citation "doi:10.1093/nar/gkad328",
        "doi:10.1093/nar/gkx894",
        "doi:10.1093/nar/gky418" ;
    schema:description "Standalone version of dbCAN annotation tool for automated CAZyme annotation." ;
    schema:downloadUrl "https://github.com/bcb-unl/run_dbcan/archive/v5.2.9.tar.gz" ;
    schema:hasPart "hatch-vcs",
        "hatchling",
        "pip",
        "python",
        "setuptools-scm" ;
    schema:identifier biotools:dbcan2 ;
    schema:license "GPL-3.0-only" ;
    schema:maintainer "Xinpeng021001" ;
    schema:name "dbcan" ;
    schema:softwareHelp "https://run-dbcan.readthedocs.io/en/latest" ;
    schema:softwareVersion "5.2.9" ;
    schema:url "https://bcb.unl.edu/dbCAN2" .

