@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mbkmeans a schema1:SoftwareApplication ;
    schema1:alternateName "Mini-batch K-means Clustering for Single-Cell RNA-seq" ;
    schema1:description "Implements the mini-batch k-means algorithm for large datasets, including support for on-disk data representation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/mbkmeans_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/mbkmeans/mbkmeans_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/mbkmeans_1.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mbkmeans/bioconductor-mbkmeans_1.26.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mbkmeans" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-mbkmeans" ;
    schema1:softwareVersion "1.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/mbkmeans.html" .

