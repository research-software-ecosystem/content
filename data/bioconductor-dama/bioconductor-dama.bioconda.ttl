@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-dama a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.csda.2004.08.014" ;
    schema:description "Efficient design and analysis of factorial two-colour microarray data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/daMA_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/daMA/daMA_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/daMA_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-dama/bioconductor-dama_1.82.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-mass" ;
    schema:identifier biotools:dama ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-dama" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/daMA.html" .

