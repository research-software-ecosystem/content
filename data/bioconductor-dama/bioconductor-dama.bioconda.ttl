@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-dama a schema1:SoftwareApplication ;
    schema1:alternateName "Efficient design and analysis of factorial two-colour microarray data" ;
    schema1:citation "doi:10.1016/j.csda.2004.08.014" ;
    schema1:description "This package contains functions for the efficient design of factorial two-colour microarray experiments and for the statistical analysis of factorial microarray data. Statistical details are described in Bretz et al. (2003, submitted)" ;
    schema1:identifier <https://bio.tools/biotools:dama> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-dama" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/daMA.html" .

