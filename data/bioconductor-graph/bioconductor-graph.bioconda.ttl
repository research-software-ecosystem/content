@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-graph a schema1:SoftwareApplication ;
    schema1:alternateName "graph: A package to handle graph data structures" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A package that implements some simple graph handling capabilities." ;
    schema1:identifier <https://bio.tools/biotools:graph> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-graph" ;
    schema1:softwareVersion "1.88.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/graph.html" .

