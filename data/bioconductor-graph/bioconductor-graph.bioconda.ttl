@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-graph a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "graph: A package to handle graph data structures" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/graph_1.88.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/graph/graph_1.88.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/graph_1.88.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-graph/bioconductor-graph_1.88.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:graph ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-graph" ;
    schema:softwareVersion "1.88.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/graph.html" .

