@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:anvio-minimal a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/s41564-020-00834-3" ;
    schema:description "An interactive analysis and visualization platform for omics data" ;
    schema:downloadUrl "https://github.com/merenlab/anvio/releases/download/v9/anvio-9.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:anvio ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "anvio-minimal" ;
    schema:softwareHelp "https://anvio.org/learn/" ;
    schema:softwareVersion "9" ;
    schema:url "https://merenlab.org/software/anvio/" .

