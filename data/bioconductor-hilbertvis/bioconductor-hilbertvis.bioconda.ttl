@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-hilbertvis a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btp152" ;
    schema:description "Hilbert curve visualization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/HilbertVis_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HilbertVis/HilbertVis_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HilbertVis_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hilbertvis/bioconductor-hilbertvis_1.68.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-lattice",
        "zlib" ;
    schema:identifier biotools:hilbertvis ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-hilbertvis" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/HilbertVis.html" .

