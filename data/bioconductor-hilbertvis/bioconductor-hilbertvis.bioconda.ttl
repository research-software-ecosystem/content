@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hilbertvis a schema1:SoftwareApplication ;
    schema1:alternateName "Hilbert curve visualization" ;
    schema1:citation "doi:10.1093/bioinformatics/btp152" ;
    schema1:description "Functions to visualize long vectors of integer data by means of Hilbert curves" ;
    schema1:identifier <https://bio.tools/biotools:hilbertvis> ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-hilbertvis" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HilbertVis.html" .

