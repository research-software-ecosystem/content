@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-hilbertvis a schema1:SoftwareApplication ;
    schema1:alternateName "Hilbert curve visualization" ;
    schema1:citation "doi:10.1093/bioinformatics/btp152" ;
    schema1:description "Functions to visualize long vectors of integer data by means of Hilbert curves" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/HilbertVis_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/HilbertVis/HilbertVis_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/HilbertVis_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-hilbertvis/bioconductor-hilbertvis_1.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:hilbertvis" ;
    schema1:license "GPL (>= 3)" ;
    schema1:name "bioconductor-hilbertvis" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/HilbertVis.html" .

