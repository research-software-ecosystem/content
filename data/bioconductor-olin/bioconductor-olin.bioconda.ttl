@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-olin a schema1:SoftwareApplication ;
    schema1:description "Optimized local intensity-dependent normalisation of two-color microarrays" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/OLIN_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OLIN/OLIN_1.88.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OLIN_1.88.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-olin/bioconductor-olin_1.88.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-limma",
        "bioconductor-marray",
        "r-base",
        "r-locfit" ;
    schema1:identifier biotools:olin ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-olin" ;
    schema1:softwareVersion "1.88.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/OLIN.html" .

