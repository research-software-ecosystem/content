@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-keggrest a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/s11845-015-1283-8" ;
    schema:description "Client-side REST access to the Kyoto Encyclopedia of Genes and Genomes (KEGG)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/KEGGREST_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/KEGGREST/KEGGREST_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/KEGGREST_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-keggrest/bioconductor-keggrest_1.50.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "r-base",
        "r-httr",
        "r-png" ;
    schema:identifier biotools:keggrest ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-keggrest" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/KEGGREST.html" .

