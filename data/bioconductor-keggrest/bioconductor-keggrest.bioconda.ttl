@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-keggrest a schema1:SoftwareApplication ;
    schema1:alternateName "Client-side REST access to the Kyoto Encyclopedia of Genes and Genomes (KEGG)" ;
    schema1:citation "doi:10.1007/s11845-015-1283-8" ;
    schema1:description "A package that provides a client interface to the Kyoto Encyclopedia of Genes and Genomes (KEGG) REST API. Only for academic use by academic users belonging to academic institutions (see <https://www.kegg.jp/kegg/rest/>). Note that KEGGREST is based on KEGGSOAP by J. Zhang, R. Gentleman, and Marc Carlson, and KEGG (python package) by Aurelien Mazurie." ;
    schema1:identifier <https://bio.tools/biotools:keggrest> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-keggrest" ;
    schema1:softwareVersion "1.50.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/KEGGREST.html" .

