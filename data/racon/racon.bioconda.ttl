@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:racon a schema:SoftwareApplication ;
    schema:description "Ultrafast consensus module for raw de novo genome assembly of long uncorrected reads." ;
    schema:downloadUrl "https://github.com/lbcb-sci/racon/archive/refs/tags/1.5.0.tar.gz" ;
    schema:hasPart "boost-cpp",
        "zlib" ;
    schema:identifier biotools:Racon ;
    schema:license "MIT" ;
    schema:name "racon" ;
    schema:softwareHelp "https://github.com/lbcb-sci/racon/blob/1.5.0/README.md" ;
    schema:softwareVersion "1.5.0" ;
    schema:url "https://github.com/lbcb-sci/racon" .

