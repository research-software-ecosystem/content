@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:racon a schema1:SoftwareApplication ;
    schema1:alternateName "Ultrafast consensus module for raw de novo genome assembly of long uncorrected reads." ;
    schema1:description "Ultrafast consensus module for raw de novo genome assembly of long uncorrected reads." ;
    schema1:identifier <https://bio.tools/biotools:Racon>,
        "usegalaxy-eu:racon" ;
    schema1:license "MIT" ;
    schema1:name "racon" ;
    schema1:softwareVersion "1.5.0" ;
    schema1:url "https://github.com/lbcb-sci/racon" .

