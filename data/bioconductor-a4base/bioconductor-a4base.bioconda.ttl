@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-a4base a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Automated Affymetrix Array Analysis Base Package" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/a4Base_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/a4Base/a4Base_1.58.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/a4Base_1.58.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-a4base/bioconductor-a4base_1.58.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-a4core",
        "bioconductor-a4preproc",
        "bioconductor-annaffy",
        "bioconductor-biobase",
        "bioconductor-genefilter",
        "bioconductor-limma",
        "bioconductor-multtest",
        "r-base",
        "r-glmnet",
        "r-gplots",
        "r-mpm" ;
    schema:identifier biotools:a4base ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-a4base" ;
    schema:softwareVersion "1.58.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/a4Base.html" .

