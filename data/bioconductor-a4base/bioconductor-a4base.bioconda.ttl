@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-a4base a schema1:SoftwareApplication ;
    schema1:alternateName "Automated Affymetrix Array Analysis Base Package" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Base utility functions are available for the Automated Affymetrix Array Analysis set of packages." ;
    schema1:identifier <https://bio.tools/biotools:a4base> ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-a4base" ;
    schema1:softwareVersion "1.58.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/a4Base.html" .

