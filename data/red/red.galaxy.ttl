@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:red a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "fasta" ;
    schema1:applicationSubCategory edam:topic_0092,
        edam:topic_0099,
        edam:topic_3168 ;
    schema1:codeRepository "https://github.com/BioinformaticsToolsmith/Red" ;
    schema1:dateCreated "2022-09-14" ;
    schema1:description "Red (REpeat Detector)" ;
    schema1:encodingFormat "bed",
        "fasta" ;
    schema1:featureList edam:operation_3680 ;
    schema1:identifier biotools:red,
        bioconda:red ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=4a71a1e08a4a8e61>,
        <https://usegalaxy.eu/published/workflow?id=f9279495683a8ac3>,
        <https://workflowhub.eu>,
        <https://workflowhub.eu/workflows/1538?version=2>,
        <https://workflowhub.eu/workflows/753?version=1> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "red" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/red" .

