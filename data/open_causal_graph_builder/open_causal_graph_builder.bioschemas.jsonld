  "@graph": [
    {
      "@id": "https://bio.tools/open_causal_graph_builder",
      "@type": "sc:SoftwareApplication",
      "biotools:primaryContact": "Hüseyin Küçükali",
      "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/0.6-DRAFT",
      "sc:citation": {
        "@id": "https://doi.org/10.1136/jech-2026-SSMabstracts.358"
      },
      "sc:description": "This tool guides researchers through building a causal graph by clearly defining causes and consequences of each variable in temporal order, then generating a saturated graph containing all plausible relationships between them. The researcher deliberately removes implausible relationships one-by-one, annotating justifications as they go. This ensures that the absence of a relationship (edge) is a deliberate choice rather than a default, and nudges explicit consideration of time throughout the design and visualisation of the causal graph.",
      "sc:name": "Open Causal Graph Builder",
      "sc:url": "https://opencausal.org/build/"
    },
    {
      "@id": "https://doi.org/10.1136/jech-2026-SSMabstracts.358",
      "@type": "sc:CreativeWork"
    }
  ]
