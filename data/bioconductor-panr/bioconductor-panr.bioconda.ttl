@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-panr a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pcbi.1002566" ;
    schema:description "Posterior association networks and functional modules inferred from rich phenotypes of gene perturbations" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/PANR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PANR/PANR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PANR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-panr/bioconductor-panr_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-reder",
        "r-base",
        "r-igraph",
        "r-mass",
        "r-pvclust" ;
    schema:identifier biotools:panr ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-panr" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/PANR.html" .

