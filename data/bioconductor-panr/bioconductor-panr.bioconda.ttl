@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-panr a schema1:SoftwareApplication ;
    schema1:alternateName "Posterior association networks and functional modules inferred from rich phenotypes of gene perturbations" ;
    schema1:citation "doi:10.1371/journal.pcbi.1002566" ;
    schema1:description "This package provides S4 classes and methods for inferring functional gene networks with edges encoding posterior beliefs of gene association types and nodes encoding perturbation effects." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/PANR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/PANR/PANR_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/PANR_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-panr/bioconductor-panr_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:panr" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-panr" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/PANR.html" .

