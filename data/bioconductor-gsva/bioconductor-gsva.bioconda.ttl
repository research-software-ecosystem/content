@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-gsva a schema:SoftwareApplication ;
    schema:description "Gene Set Variation Analysis for Microarray and RNA-Seq Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GSVA_2.4.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSVA/GSVA_2.4.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSVA_2.4.4.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsva/bioconductor-gsva_2.4.4_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biocparallel",
        "bioconductor-biocsingular",
        "bioconductor-delayedarray",
        "bioconductor-gseabase",
        "bioconductor-hdf5array",
        "bioconductor-iranges",
        "bioconductor-matrixgenerics",
        "bioconductor-s4arrays",
        "bioconductor-s4vectors",
        "bioconductor-singlecellexperiment",
        "bioconductor-sparsearray",
        "bioconductor-sparsematrixstats",
        "bioconductor-spatialexperiment",
        "bioconductor-summarizedexperiment",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-cli",
        "r-matrix",
        "r-memuse",
        "zlib" ;
    schema:identifier biotools:gsva ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-gsva" ;
    schema:softwareVersion "2.4.4" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GSVA.html" .

