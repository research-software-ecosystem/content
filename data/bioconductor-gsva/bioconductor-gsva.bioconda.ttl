@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gsva a schema1:SoftwareApplication ;
    schema1:alternateName "Gene Set Variation Analysis for Microarray and RNA-Seq Data" ;
    schema1:description "Gene Set Variation Analysis (GSVA) is a non-parametric, unsupervised method for estimating variation of gene set enrichment through the samples of a expression data set. GSVA performs a change in coordinate systems, transforming the data from a gene by sample matrix to a gene-set by sample matrix, thereby allowing the evaluation of pathway enrichment for each sample. This new matrix of GSVA enrichment scores facilitates applying standard analytical methods like functional enrichment, survival analysis, clustering, CNV-pathway analysis or cross-tissue pathway analysis, in a pathway-centric manner." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GSVA_2.4.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GSVA/GSVA_2.4.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GSVA_2.4.4.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gsva/bioconductor-gsva_2.4.4_src_all.tar.gz" ;
    schema1:identifier "biotools:gsva" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-gsva" ;
    schema1:softwareVersion "2.4.4" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GSVA.html" .

