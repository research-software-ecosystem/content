@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-mipp a schema1:SoftwareApplication ;
    schema1:alternateName "Misclassification Penalized Posterior Classification" ;
    schema1:citation "doi:10.1093/bioinformatics/bti1020" ;
    schema1:description "This package finds optimal sets of genes that seperate samples into two or more classes." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MiPP_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MiPP/MiPP_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MiPP_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mipp/bioconductor-mipp_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:mipp" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-mipp" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MiPP.html" .

