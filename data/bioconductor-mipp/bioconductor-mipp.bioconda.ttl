@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-mipp a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bti1020" ;
    schema:description "Misclassification Penalized Posterior Classification" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/MiPP_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MiPP/MiPP_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MiPP_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-mipp/bioconductor-mipp_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "r-base",
        "r-e1071",
        "r-mass" ;
    schema:identifier biotools:mipp ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-mipp" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/MiPP.html" .

