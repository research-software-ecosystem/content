@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-clusterprofiler a schema1:SoftwareApplication ;
    schema1:alternateName "A universal enrichment tool for interpreting omics data" ;
    schema1:description "This package supports functional characteristics of both coding and non-coding genomics data for thousands of species with up-to-date gene annotation. It provides a universal interface for gene functional annotation from a variety of sources and thus can be applied in diverse scenarios. It provides a tidy interface to access, manipulate, and visualize enrichment results to help users achieve efficient data interpretation. Datasets obtained from multiple treatments and time points can be analyzed and compared in a single run, easily revealing functional consensus and differences among distinct gene clusters." ;
    schema1:identifier biotools:clusterprofiler ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-clusterprofiler" ;
    schema1:softwareVersion "4.18.4" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/clusterProfiler.html" .

