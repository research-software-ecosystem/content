@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-clusterprofiler a schema:SoftwareApplication ;
    schema:description "A universal enrichment tool for interpreting omics data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/clusterProfiler_4.18.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/clusterProfiler/clusterProfiler_4.18.4.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/clusterProfiler_4.18.4.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-clusterprofiler/bioconductor-clusterprofiler_4.18.4_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-dose",
        "bioconductor-enrichplot",
        "bioconductor-go.db",
        "bioconductor-gosemsim",
        "bioconductor-qvalue",
        "r-base",
        "r-dplyr",
        "r-gson",
        "r-httr",
        "r-igraph",
        "r-magrittr",
        "r-plyr",
        "r-rlang",
        "r-tidyr",
        "r-yulab.utils" ;
    schema:identifier biotools:clusterprofiler ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-clusterprofiler" ;
    schema:softwareVersion "4.18.4" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/clusterProfiler.html" .

