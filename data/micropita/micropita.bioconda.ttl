@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:micropita a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/ismej.2013.139" ;
    schema:description "microPITA is a computational tool enabling sample selection in two-stage (tiered) studies." ;
    schema:downloadUrl "https://bitbucket.org/biobakery/micropita/downloads/micropita-8.tar.gz" ;
    schema:identifier biotools:micropita ;
    schema:license "MIT" ;
    schema:name "micropita" ;
    schema:softwareVersion "1.1.0" ;
    schema:url "http://huttenhower.sph.harvard.edu/micropita" .

