@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-sseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btt143" ;
    schema:description "Shrinkage estimation of dispersion in Negative Binomial models for RNA-seq experiments with small sample size" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/sSeq_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/sSeq/sSeq_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/sSeq_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-sseq/bioconductor-sseq_1.48.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-catools",
        "r-rcolorbrewer" ;
    schema:identifier biotools:sseq ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-sseq" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/sSeq.html" .

