@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-gnet2 a schema1:SoftwareApplication ;
    schema1:alternateName "Constructing gene regulatory networks from expression data through functional module inference" ;
    schema1:description "Cluster genes to functional groups with E-M process. Iteratively perform TF assigning and Gene assigning, until the assignment of genes did not change, or max number of iterations is reached." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GNET2_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GNET2/GNET2_1.26.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GNET2_1.26.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-gnet2/bioconductor-gnet2_1.26.0_src_all.tar.gz" ;
    schema1:identifier "biotools:gnet2" ;
    schema1:license "Apache License 2.0" ;
    schema1:name "bioconductor-gnet2" ;
    schema1:softwareVersion "1.26.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GNET2.html" .

