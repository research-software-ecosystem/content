@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pirate a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/598391" ;
    schema:description "Pangenome analysis and threshold evaluation toolbox" ;
    schema:downloadUrl "https://github.com/SionBayliss/PIRATE/archive/v1.0.5.tar.gz" ;
    schema:identifier biotools:pirate ;
    schema:license "GPL3" ;
    schema:name "pirate" ;
    schema:softwareVersion "1.0.5" ;
    schema:url "https://github.com/SionBayliss/PIRATE" .

