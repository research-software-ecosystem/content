@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:pirate a schema1:SoftwareApplication ;
    schema1:alternateName "Pangenome analysis and threshold evaluation toolbox" ;
    schema1:citation "doi:10.1101/598391" ;
    schema1:description "Pangenome analysis and threshold evaluation toolbox" ;
    schema1:identifier <https://bio.tools/biotools:pirate> ;
    schema1:license "GPL3" ;
    schema1:name "pirate" ;
    schema1:softwareVersion "1.0.5" ;
    schema1:url "https://github.com/SionBayliss/PIRATE" .

