@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:sipros a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular" ;
    schema1:applicationSubCategory edam:topic_0078,
        edam:topic_0121 ;
    schema1:codeRepository "https://github.com/thepanlab/sipros5/" ;
    schema1:dateCreated "2025-12-20" ;
    schema1:description "Labeled protein identification" ;
    schema1:encodingFormat "fasta",
        "tabular" ;
    schema1:featureList edam:operation_3646 ;
    schema1:identifier biotools:sipros,
        bioconda:sipros ;
    schema1:keywords "Proteomics" ;
    schema1:name "sipros" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/Helmholtz-UFZ/ufz-galaxy-tools/blob/main/tools/sipros" .

