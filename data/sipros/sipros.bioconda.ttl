@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sipros a schema:SoftwareApplication ;
    schema:author "bernt-matthias",
        "yi-xiong" ;
    schema:citation "doi:10.1186/s40168-024-01866-1" ;
    schema:description "Tools for stable isotopic mass spectrometry-based metaproteomics" ;
    schema:identifier biotools:sipros ;
    schema:license "MIT" ;
    schema:maintainer "bernt-matthias",
        "yi-xiong" ;
    schema:name "sipros" ;
    schema:softwareVersion "5.0.1" ;
    schema:url "https://github.com/thepanlab/sipros5/" .

