@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:plannotate a schema:SoftwareApplication ;
    schema:author "mmcguffi",
        "rpetit3" ;
    schema:description "Webserver and command line tool for annotating engineered plasmids." ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:plannotate ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "mmcguffi",
        "rpetit3" ;
    schema:name "plannotate" ;
    schema:softwareHelp "https://github.com/mmcguffi/pLannotate/blob/v1.2.5/README.md" ;
    schema:softwareVersion "1.2.5" ;
    schema:url "https://github.com/mmcguffi/pLannotate" .

