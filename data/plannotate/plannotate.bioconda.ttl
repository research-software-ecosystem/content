@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:plannotate a schema1:SoftwareApplication ;
    schema1:alternateName "Webserver and command line tool for annotating engineered plasmids." ;
    schema1:description "Webserver and command line tool for annotating engineered plasmids." ;
    schema1:downloadUrl "https://github.com/mmcguffi/plannotate/archive/refs/tags/v2.0.0.tar.gz" ;
    schema1:identifier "biotools:plannotate" ;
    schema1:license "GPL-3.0-or-later" ;
    schema1:maintainer "mmcguffi",
        "rpetit3" ;
    schema1:name "plannotate" ;
    schema1:softwareVersion "2.0.0" ;
    schema1:url "https://github.com/mmcguffi/pLannotate" .

