@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-bus a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Gene network reconstruction" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/BUS_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/BUS/BUS_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/BUS_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-bus/bioconductor-bus_1.66.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-minet",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-infotheo",
        "zlib" ;
    schema:identifier biotools:bus ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-bus" ;
    schema:softwareVersion "1.66.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/BUS.html" .

