@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-genemeta a schema1:SoftwareApplication ;
    schema1:alternateName "MetaAnalysis for High Throughput Experiments" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "A collection of meta-analysis tools for analysing high throughput experimental data" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/GeneMeta_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneMeta/GeneMeta_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneMeta_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genemeta/bioconductor-genemeta_1.82.0_src_all.tar.gz" ;
    schema1:identifier "biotools:genemeta" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-genemeta" ;
    schema1:softwareVersion "1.82.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/GeneMeta.html" .

