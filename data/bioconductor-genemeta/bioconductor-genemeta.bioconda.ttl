@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-genemeta a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "MetaAnalysis for High Throughput Experiments" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/GeneMeta_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/GeneMeta/GeneMeta_1.82.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/GeneMeta_1.82.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-genemeta/bioconductor-genemeta_1.82.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-genefilter",
        "r-base" ;
    schema:identifier biotools:genemeta ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-genemeta" ;
    schema:softwareVersion "1.82.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/GeneMeta.html" .

