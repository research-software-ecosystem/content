@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-illuminaio a schema1:SoftwareApplication ;
    schema1:alternateName "Parsing Illumina Microarray Output Files" ;
    schema1:description "Tools for parsing Illumina's microarray output files, including IDAT." ;
    schema1:identifier <https://bio.tools/biotools:illuminaio> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-illuminaio" ;
    schema1:softwareVersion "0.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/illuminaio.html" .

