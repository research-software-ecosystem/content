@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:biscuit a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkae097" ;
    schema:description "A utility for analyzing sodium bisulfite conversion-based DNA methylation/modification data." ;
    schema:downloadUrl "https://github.com/huishenlab/biscuit/releases/download/v1.9.0.20260624/release-source.zip" ;
    schema:hasPart "libcurl",
        "libdeflate",
        "ncurses",
        "pthread-stubs",
        "zlib" ;
    schema:identifier biotools:biscuit ;
    schema:license "MIT" ;
    schema:name "biscuit" ;
    schema:softwareHelp "https://huishenlab.github.io/biscuit" ;
    schema:softwareVersion "1.9.0.20260624" ;
    schema:url "https://github.com/huishenlab/biscuit" .

