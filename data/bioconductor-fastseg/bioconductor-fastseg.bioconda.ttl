@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-fastseg a schema1:SoftwareApplication ;
    schema1:description "fastseg - a fast segmentation algorithm" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/fastseg_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/fastseg/fastseg_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/fastseg_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-fastseg/bioconductor-fastseg_1.56.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:fastseg ;
    schema1:license "LGPL (>= 2.0)" ;
    schema1:name "bioconductor-fastseg" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/fastseg.html" .

