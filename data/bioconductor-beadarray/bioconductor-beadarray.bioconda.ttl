@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-beadarray a schema1:SoftwareApplication ;
    schema1:description "Quality assessment and low-level analysis for Illumina BeadArray data" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-beaddatapackr",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-illuminaio",
        "bioconductor-iranges",
        "bioconductor-limma",
        "libblas",
        "liblapack",
        "r-base",
        "r-ggplot2",
        "r-hexbin",
        "r-reshape2" ;
    schema1:identifier biotools:beadarray ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-beadarray" ;
    schema1:softwareVersion "2.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/beadarray.html" .

