@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-beadarray a schema1:SoftwareApplication ;
    schema1:alternateName "Quality assessment and low-level analysis for Illumina BeadArray data" ;
    schema1:description "The package is able to read bead-level data (raw TIFFs and text files) output by BeadScan as well as bead-summary data from BeadStudio. Methods for quality assessment and low-level analysis are provided." ;
    schema1:identifier "biotools:beadarray" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-beadarray" ;
    schema1:softwareVersion "2.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/beadarray.html" .

