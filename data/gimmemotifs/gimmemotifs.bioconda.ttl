@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gimmemotifs a schema:SoftwareApplication ;
    schema:author "siebrenf",
        "simonvh" ;
    schema:citation "doi:10.1093/bioinformatics/btq636",
        "doi:10.1101/474403" ;
    schema:description "Motif prediction pipeline and various motif-related tools." ;
    schema:downloadUrl "https://github.com/vanheeringen-lab/gimmemotifs/releases/download/0.18.4/gimmemotifs-0.18.4.tar.gz" ;
    schema:hasPart "python" ;
    schema:identifier biotools:gimmemotifs ;
    schema:license "MIT" ;
    schema:maintainer "siebrenf",
        "simonvh" ;
    schema:name "gimmemotifs" ;
    schema:softwareHelp "https://gimmemotifs.readthedocs.io/en/master" ;
    schema:softwareVersion "0.18.4" ;
    schema:url "https://github.com/vanheeringen-lab/gimmemotifs" .

