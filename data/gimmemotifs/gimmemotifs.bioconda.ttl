@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:gimmemotifs a schema1:SoftwareApplication ;
    schema1:alternateName "Motif prediction pipeline and various motif-related tools." ;
    schema1:citation "doi:10.1093/bioinformatics/btq636",
        "doi:10.1101/474403" ;
    schema1:description "Motif prediction pipeline and various motif-related tools." ;
    schema1:identifier <https://bio.tools/biotools:gimmemotifs> ;
    schema1:license "MIT" ;
    schema1:maintainer "siebrenf",
        "simonvh" ;
    schema1:name "gimmemotifs" ;
    schema1:softwareVersion "0.18.4" ;
    schema1:url "https://github.com/vanheeringen-lab/gimmemotifs" .

