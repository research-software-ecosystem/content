@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:perl-vcftools-vcf a schema:SoftwareApplication ;
    schema:description "cpanm ready distribution of VCFtools Perl libraries." ;
    schema:downloadUrl "https://github.com/vcftools/vcftools/releases/download/v0.1.17/vcftools-0.1.17.tar.gz" ;
    schema:hasPart "perl",
        "perl-module-build",
        "wget" ;
    schema:identifier biotools:vcftools ;
    schema:license "LGPL-3.0-only" ;
    schema:name "perl-vcftools-vcf" ;
    schema:softwareHelp "https://vcftools.github.io" ;
    schema:softwareVersion "0.1.17" ;
    schema:url "https://github.com/vcftools/vcftools" .

