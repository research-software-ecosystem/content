@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-varianttools a schema1:SoftwareApplication ;
    schema1:alternateName "Tools for Exploratory Analysis of Variant Calls" ;
    schema1:citation "doi:10.1101/027227" ;
    schema1:description "Explore, diagnose, and compare variant calls using filters." ;
    schema1:identifier biotools:varianttools ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-varianttools" ;
    schema1:softwareVersion "1.51.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/VariantTools.html" .

