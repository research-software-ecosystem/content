@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ideoviz a schema1:SoftwareApplication ;
    schema1:alternateName "Plots data (continuous/discrete) along chromosomal ideogram" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Plots data associated with arbitrary genomic intervals along chromosomal ideogram." ;
    schema1:identifier biotools:ideoviz ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-ideoviz" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/IdeoViz.html" .

