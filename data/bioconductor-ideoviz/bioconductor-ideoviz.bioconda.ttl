@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ideoviz a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Plots data (continuous/discrete) along chromosomal ideogram" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/IdeoViz_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/IdeoViz/IdeoViz_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/IdeoViz_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ideoviz/bioconductor-ideoviz_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "r-base",
        "r-rcolorbrewer" ;
    schema:identifier biotools:ideoviz ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-ideoviz" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/IdeoViz.html" .

