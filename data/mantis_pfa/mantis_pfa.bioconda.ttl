@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mantis_pfa a schema:SoftwareApplication ;
    schema:author "PedroMTQ" ;
    schema:citation "doi:10.1093/gigascience/giab042" ;
    schema:description "Consensus-driven protein function annotation tool" ;
    schema:downloadUrl "https://github.com/PedroMTQ/Mantis/archive/refs/tags/1.5.5.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools",
        "wheel" ;
    schema:identifier biotools:mantis_pfa ;
    schema:license "MIT" ;
    schema:maintainer "PedroMTQ" ;
    schema:name "mantis_pfa" ;
    schema:softwareVersion "1.5.5" ;
    schema:url "https://github.com/PedroMTQ/Mantis" .

