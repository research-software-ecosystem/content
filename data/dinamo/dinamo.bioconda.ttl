@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:dinamo a schema:SoftwareApplication ;
    schema:author "simonvh" ;
    schema:citation "doi:10.1186/s12859-018-2215-1" ;
    schema:description "An exact and efficient method for IUPAC motif discovery in DNA sequences." ;
    schema:downloadUrl "https://github.com/bonsai-team/DiNAMO/archive/V1.0.tar.gz" ;
    schema:hasPart "boost-cpp" ;
    schema:identifier biotools:DiNAMO ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "simonvh" ;
    schema:name "dinamo" ;
    schema:softwareVersion "1.0" ;
    schema:url "https://github.com/bonsai-team/DiNAMO" .

