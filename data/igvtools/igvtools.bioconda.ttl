@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:igvtools a schema:SoftwareApplication ;
    schema:description "Command line tools for IGV" ;
    schema:downloadUrl "http://data.broadinstitute.org/igv/projects/downloads/2.17/IGV_2.17.3.zip" ;
    schema:identifier biotools:IGVtools ;
    schema:license "MIT" ;
    schema:name "igvtools" ;
    schema:softwareVersion "2.17.3" ;
    schema:url "http://www.broadinstitute.org/igv/" .

