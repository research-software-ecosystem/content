@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cghregions a schema:SoftwareApplication ;
    schema:citation "doi:10.1002/9783527678679.dg00687" ;
    schema:description "Dimension Reduction for Array CGH Data with Minimal Information Loss." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CGHregions_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CGHregions/CGHregions_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CGHregions_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cghregions/bioconductor-cghregions_1.68.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-cghbase",
        "r-base" ;
    schema:identifier biotools:cghregions ;
    schema:license "GPL (http://www.gnu.org/copyleft/gpl.html)" ;
    schema:name "bioconductor-cghregions" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CGHregions.html" .

