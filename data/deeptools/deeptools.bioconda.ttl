@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:deeptools a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkw257" ;
    schema:description "A set of user-friendly tools for normalization and visualzation of deep-sequencing data" ;
    schema:downloadUrl "https://github.com/deeptools/deepTools/archive/refs/tags/3.5.6.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:deeptools ;
    schema:license "MIT" ;
    schema:name "deeptools" ;
    schema:softwareHelp "https://deeptools.readthedocs.io/en/latest/" ;
    schema:softwareVersion "3.5.6" ;
    schema:url "https://github.com/deeptools/deepTools" .

