@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:novoplasty a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "tabular",
        "txt",
        "vcf" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196 ;
    schema1:codeRepository <https://github.com/ndierckx/NOVOPlasty> ;
    schema1:dateCreated "2020-05-18" ;
    schema1:description "NOVOPlasty is a de novo assembler and heteroplasmy/variance caller for short circular genomes." ;
    schema1:encodingFormat "fasta",
        "tabular",
        "txt",
        "vcf" ;
    schema1:featureList edam:operation_0524,
        edam:operation_3227 ;
    schema1:identifier biotools:NOVOPlasty,
        bioconda:novoplasty ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.ca>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=5436eb1c430a38dd>,
        <https://usegalaxy.fr>,
        <https://usegalaxy.org.au> ;
    schema1:keywords "Assembly" ;
    schema1:name "novoplasty" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/novoplasty> .

