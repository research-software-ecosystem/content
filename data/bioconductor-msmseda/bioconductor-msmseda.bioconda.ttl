@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-msmseda a schema1:SoftwareApplication ;
    schema1:alternateName "Exploratory Data Analysis of LC-MS/MS data by spectral counts" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Exploratory data analysis to assess the quality of a set of LC-MS/MS experiments, and visualize de influence of the involved factors." ;
    schema1:identifier biotools:msmseda ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-msmseda" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/msmsEDA.html" .

