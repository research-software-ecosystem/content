@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:clinker-py a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btab007" ;
    schema:description "Gene cluster comparison figure generator" ;
    schema:downloadUrl "https://pypi.io/packages/source/c/clinker/clinker-0.0.32.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:clinker ;
    schema:license "MIT" ;
    schema:name "clinker-py" ;
    schema:softwareHelp "https://github.com/gamcil/clinker/blob/master/README.md" ;
    schema:softwareVersion "0.0.32" ;
    schema:url "https://github.com/gamcil/clinker" .

