@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ibdseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1016/j.ajhg.2013.09.014" ;
    schema:description "IBDseq is a software program for detecting segments of identity-by-descent (IBD) and homozygosity-by-descent (HBD) in unphased genetic sequence data." ;
    schema:downloadUrl "http://faculty.washington.edu/browning/ibdseq/ibdseq.r1206.jar" ;
    schema:identifier biotools:IBDseq ;
    schema:license "Apache v2.0" ;
    schema:name "ibdseq" ;
    schema:softwareVersion "r1206" ;
    schema:url "http://faculty.washington.edu/browning/ibdseq.html" .

