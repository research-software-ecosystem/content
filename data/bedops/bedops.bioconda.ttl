@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bedops a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/bts277" ;
    schema:description "High-performance genomic feature operations." ;
    schema:downloadUrl "https://github.com/bedops/bedops/archive/v2.4.42.tar.gz" ;
    schema:hasPart "bzip2",
        "jansson",
        "zlib" ;
    schema:identifier biotools:Bedops ;
    schema:license "GPL-2.0-or-later" ;
    schema:name "bedops" ;
    schema:softwareHelp "https://bedops.readthedocs.io" ;
    schema:softwareVersion "2.4.42" ;
    schema:url "https://github.com/bedops/bedops" .

