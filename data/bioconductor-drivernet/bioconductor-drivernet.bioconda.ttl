@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-drivernet a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/gb-2012-13-12-r124" ;
    schema:description "Drivernet: uncovering somatic driver mutations modulating transcriptional networks in cancer" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/DriverNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/DriverNet/DriverNet_1.50.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/DriverNet_1.50.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-drivernet/bioconductor-drivernet_1.50.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:drivernet ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-drivernet" ;
    schema:softwareVersion "1.50.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/DriverNet.html" .

