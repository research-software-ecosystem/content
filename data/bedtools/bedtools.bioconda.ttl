@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bedtools a schema:SoftwareApplication ;
    schema:description "A powerful toolset for genome arithmetic" ;
    schema:downloadUrl "https://github.com/arq5x/bedtools2/releases/download/v2.31.1/bedtools-2.31.1.tar.gz" ;
    schema:hasPart "bzip2",
        "xz",
        "zlib" ;
    schema:identifier biotools:bedtools ;
    schema:license "MIT" ;
    schema:name "bedtools" ;
    schema:softwareVersion "2.31.1" ;
    schema:url "http://bedtools.readthedocs.org/" .

