@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chicago a schema1:SoftwareApplication ;
    schema1:alternateName "CHiCAGO: Capture Hi-C Analysis of Genomic Organization" ;
    schema1:description "A pipeline for analysing Capture Hi-C data." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/Chicago_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Chicago/Chicago_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Chicago_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chicago/bioconductor-chicago_1.38.0_src_all.tar.gz" ;
    schema1:identifier "biotools:chicago" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-chicago" ;
    schema1:softwareVersion "1.38.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Chicago.html" .

