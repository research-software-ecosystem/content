@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chicago a schema:SoftwareApplication ;
    schema:description "CHiCAGO: Capture Hi-C Analysis of Genomic Organization" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Chicago_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Chicago/Chicago_1.38.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Chicago_1.38.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chicago/bioconductor-chicago_1.38.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-data.table",
        "r-delaporte",
        "r-hmisc",
        "r-mass",
        "r-matrixstats" ;
    schema:identifier biotools:chicago ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-chicago" ;
    schema:softwareVersion "1.38.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Chicago.html" .

