@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:sff2fastq a schema:SoftwareApplication ;
    schema:author "keuv-grvl" ;
    schema:description "Extract 454 Genome Sequencer reads from a SFF file and convert them into a FASTQ formatted output" ;
    schema:downloadUrl "https://github.com/indraniel/sff2fastq/archive/v0.9.2.tar.gz" ;
    schema:identifier biotools:sff2fastq ;
    schema:license "GPL-3" ;
    schema:maintainer "keuv-grvl" ;
    schema:name "sff2fastq" ;
    schema:softwareVersion "0.9.2" ;
    schema:url "https://github.com/indraniel/sff2fastq" .

