@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hitac a schema:SoftwareApplication ;
    schema:author "mirand863" ;
    schema:description "A hierarchical taxonomic classifier for fungal ITS sequences" ;
    schema:downloadUrl "https://pypi.io/packages/source/h/hitac/hitac-2.2.2.tar.gz" ;
    schema:hasPart "pip",
        "python" ;
    schema:identifier biotools:hitac ;
    schema:license "BSD-3-Clause" ;
    schema:maintainer "mirand863" ;
    schema:name "hitac" ;
    schema:softwareVersion "2.2.2" ;
    schema:url "https://gitlab.com/dacs-hpi/hitac" .

