@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-spktools a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for Spike-in Arrays" ;
    schema1:citation "doi:10.1093/nar/gkn430" ;
    schema1:description "The package contains functions that can be used to compare expression measures on different array platforms." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/spkTools_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/spkTools/spkTools_1.66.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/spkTools_1.66.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-spktools/bioconductor-spktools_1.66.0_src_all.tar.gz" ;
    schema1:identifier "biotools:spktools" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-spktools" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/spkTools.html" .

