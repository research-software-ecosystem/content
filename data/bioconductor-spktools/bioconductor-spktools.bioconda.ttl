@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-spktools a schema1:SoftwareApplication ;
    schema1:alternateName "Methods for Spike-in Arrays" ;
    schema1:citation "doi:10.1093/nar/gkn430" ;
    schema1:description "The package contains functions that can be used to compare expression measures on different array platforms." ;
    schema1:identifier biotools:spktools ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-spktools" ;
    schema1:softwareVersion "1.66.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/spkTools.html" .

