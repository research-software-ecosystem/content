@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-cnvpanelizer a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Reliable CNV detection in targeted sequencing applications" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CNVPanelizer_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CNVPanelizer/CNVPanelizer_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CNVPanelizer_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-cnvpanelizer/bioconductor-cnvpanelizer_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomeinfodb",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-noiseq",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "r-base",
        "r-foreach",
        "r-ggplot2",
        "r-gplots",
        "r-openxlsx",
        "r-plyr",
        "r-reshape2",
        "r-shiny",
        "r-shinyfiles",
        "r-shinyjs",
        "r-stringr",
        "r-testthat" ;
    schema:identifier biotools:cnvpanelizer ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-cnvpanelizer" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CNVPanelizer.html" .

