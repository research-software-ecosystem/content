@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lobstahs a schema:SoftwareApplication ;
    schema:description "Lipid and Oxylipin Biomarker Screening through Adduct Hierarchy Sequences" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/LOBSTAHS_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/LOBSTAHS/LOBSTAHS_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/LOBSTAHS_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lobstahs/bioconductor-lobstahs_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-camera",
        "bioconductor-xcms",
        "r-base" ;
    schema:identifier biotools:lobstahs ;
    schema:license "GPL (>= 3) + file LICENSE" ;
    schema:name "bioconductor-lobstahs" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/LOBSTAHS.html" .

