    schema1:featureList edam:operation_1781,
        edam:operation_3432,
        edam:operation_3927 ;
    schema1:identifier biotools:mcl,
        bioconda:mcl ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.no> ;
    schema1:keywords "Sequence Analysis" ;
    schema1:name "mcl" ;
