@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mcl a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/30.7.1575",
        "doi:10.1137/040608635" ;
    schema:description "MCL - a cluster algorithm for graphs." ;
    schema:hasPart "perl" ;
    schema:identifier biotools:mcl ;
    schema:license "GPL-3.0-only" ;
    schema:name "mcl" ;
    schema:softwareHelp "https://micans.org/mcl/man/mcl.html" ;
    schema:softwareVersion "22.282" ;
    schema:url "https://micans.org/mcl" .

