@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-somaticsignatures a schema1:SoftwareApplication ;
    schema1:alternateName "Somatic Signatures" ;
    schema1:description "The SomaticSignatures package identifies mutational signatures of single nucleotide variants (SNVs).  It provides a infrastructure related to the methodology described in Nik-Zainal (2012, Cell), with flexibility in the matrix decomposition algorithms." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/SomaticSignatures_2.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SomaticSignatures/SomaticSignatures_2.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SomaticSignatures_2.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-somaticsignatures/bioconductor-somaticsignatures_2.46.0_src_all.tar.gz" ;
    schema1:identifier "biotools:somaticsignatures" ;
    schema1:license "MIT + file LICENSE" ;
    schema1:name "bioconductor-somaticsignatures" ;
    schema1:softwareVersion "2.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/SomaticSignatures.html" .

