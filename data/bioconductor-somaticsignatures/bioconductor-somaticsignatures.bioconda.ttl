@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-somaticsignatures a schema:SoftwareApplication ;
    schema:description "Somatic Signatures" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SomaticSignatures_2.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SomaticSignatures/SomaticSignatures_2.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SomaticSignatures_2.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-somaticsignatures/bioconductor-somaticsignatures_2.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-ggbio",
        "bioconductor-iranges",
        "bioconductor-pcamethods",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "bioconductor-variantannotation",
        "r-base",
        "r-ggplot2",
        "r-nmf",
        "r-proxy",
        "r-reshape2" ;
    schema:identifier biotools:somaticsignatures ;
    schema:license "MIT + file LICENSE" ;
    schema:name "bioconductor-somaticsignatures" ;
    schema:softwareVersion "2.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SomaticSignatures.html" .

