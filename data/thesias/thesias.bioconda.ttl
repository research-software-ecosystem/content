@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:thesias a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm058" ;
    schema:description "Testing Haplotype Effects In Association Studies" ;
    schema:downloadUrl "https://github.com/daissi/thesias/archive/3.1.1.tar.gz" ;
    schema:hasPart "openjdk" ;
    schema:identifier biotools:THESIAS ;
    schema:license "GPL-3+" ;
    schema:name "thesias" ;
    schema:softwareVersion "3.1.1" ;
    schema:url "https://github.com/daissi/thesias" .

