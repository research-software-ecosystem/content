@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:thesias a schema1:SoftwareApplication ;
    schema1:alternateName "Testing Haplotype Effects In Association Studies" ;
    schema1:citation "doi:10.1093/bioinformatics/btm058" ;
