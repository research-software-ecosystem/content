@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-organismdbi a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Software to enable the smooth interfacing of different database packages" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/OrganismDbi_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/OrganismDbi/OrganismDbi_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/OrganismDbi_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-organismdbi/bioconductor-organismdbi_1.52.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-annotationdbi",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-graph",
        "bioconductor-iranges",
        "bioconductor-rbgl",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-biocmanager",
        "r-dbi" ;
    schema1:identifier biotools:organismdbi ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-organismdbi" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/OrganismDbi.html" .

