@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:raxml a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btu033" ;
    schema:description "Phylogenetics - Randomized Axelerated Maximum Likelihood." ;
    schema:downloadUrl "https://github.com/stamatak/standard-RAxML/archive/refs/tags/v8.2.13.tar.gz" ;
    schema:identifier biotools:raxml ;
    schema:license "GPL" ;
    schema:name "raxml" ;
    schema:softwareVersion "8.2.13" ;
    schema:url "http://sco.h-its.org/exelixis/web/software/raxml/index.html" .

