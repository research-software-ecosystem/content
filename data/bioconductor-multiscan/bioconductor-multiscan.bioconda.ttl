@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-multiscan a schema1:SoftwareApplication ;
    schema1:alternateName "R package for combining multiple scans" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Estimates gene expressions from several laser scans of the same microarray" ;
    schema1:identifier biotools:multiscan ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-multiscan" ;
    schema1:softwareVersion "1.70.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/multiscan.html" .

