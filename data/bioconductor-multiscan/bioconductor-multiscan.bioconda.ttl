@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-multiscan a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "R package for combining multiple scans" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/multiscan_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/multiscan/multiscan_1.70.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/multiscan_1.70.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-multiscan/bioconductor-multiscan_1.70.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:multiscan ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-multiscan" ;
    schema:softwareVersion "1.70.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/multiscan.html" .

