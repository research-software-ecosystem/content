@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:cuttlefish a schema:SoftwareApplication ;
    schema:author "jamshed",
        "rob-p" ;
    schema:citation "doi:10.1093/bioinformatics/btab309",
        "doi:10.1186/s13059-022-02743-6" ;
    schema:description "Construction of the compacted de Bruijn graph efficiently." ;
    schema:downloadUrl "https://github.com/COMBINE-lab/cuttlefish/archive/refs/tags/v2.2.0.tar.gz" ;
    schema:hasPart "bzip2",
        "jemalloc",
        "zlib" ;
    schema:identifier biotools:cuttlefish ;
    schema:license "BSD-3-Clause" ;
    schema:maintainer "jamshed",
        "rob-p" ;
    schema:name "cuttlefish" ;
    schema:softwareHelp "https://github.com/COMBINE-lab/cuttlefish/blob/v2.2.0/README.md" ;
    schema:softwareVersion "2.2.0" ;
    schema:url "https://github.com/COMBINE-lab/cuttlefish" .

