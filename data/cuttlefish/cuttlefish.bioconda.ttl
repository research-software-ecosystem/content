@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:cuttlefish a schema1:SoftwareApplication ;
    schema1:alternateName "Construction of the (colored) compacted de Bruijn graph efficiently." ;
    schema1:citation "doi:10.1093/bioinformatics/btab309",
        "doi:10.1101/2025.02.02.636161",
        "doi:10.1186/s13059-022-02743-6" ;
    schema1:description "Construction of the (colored) compacted de Bruijn graph efficiently." ;
    schema1:identifier biotools:cuttlefish ;
    schema1:license "BSD-3-Clause" ;
    schema1:maintainer "jamshed",
        "rob-p" ;
    schema1:name "cuttlefish" ;
    schema1:softwareVersion "3.0.1" ;
    schema1:url "https://github.com/COMBINE-lab/cuttlefish" .

