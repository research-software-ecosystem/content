@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-synlet a schema1:SoftwareApplication ;
    schema1:alternateName "Hits Selection for Synthetic Lethal RNAi Screen Data" ;
    schema1:citation "doi:10.1101/043570" ;
    schema1:description "Select hits from synthetic lethal RNAi screen data. For example, there are two identical celllines except one gene is knocked-down in one cellline. The interest is to find genes that lead to stronger lethal effect when they are knocked-down further by siRNA. Quality control and various visualisation tools are implemented. Four different algorithms could be used to pick up the interesting hits. This package is designed based on 384 wells plates, but may apply to other platforms with proper configuration." ;
    schema1:identifier biotools:synlet ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-synlet" ;
    schema1:softwareVersion "2.10.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/synlet.html" .

