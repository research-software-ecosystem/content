@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-synlet a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/043570" ;
    schema:description "Hits Selection for Synthetic Lethal RNAi Screen Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/synlet_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/synlet/synlet_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/synlet_2.10.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-synlet/bioconductor-synlet_2.10.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-rankprod",
        "r-base",
        "r-data.table",
        "r-ggplot2",
        "r-magrittr",
        "r-patchwork",
        "r-rcolorbrewer" ;
    schema:identifier biotools:synlet ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-synlet" ;
    schema:softwareVersion "2.10.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/synlet.html" .

