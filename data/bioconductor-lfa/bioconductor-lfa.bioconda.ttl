@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-lfa a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btv641" ;
    schema:description "Logistic Factor Analysis for Categorical Data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/lfa_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/lfa/lfa_2.10.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/lfa_2.10.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-lfa/bioconductor-lfa_2.10.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-corpcor",
        "r-rspectra",
        "zlib" ;
    schema:identifier biotools:lfa ;
    schema:license "GPL (>= 3)" ;
    schema:name "bioconductor-lfa" ;
    schema:softwareVersion "2.10.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/lfa.html" .

