@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:plek a schema:SoftwareApplication ;
    schema:description "Predictor of long non-coding RNAs and mRNAs based on k-mer scheme." ;
    schema:downloadUrl "https://sourceforge.net/projects/plek/files/PLEK.1.2.tar.gz" ;
    schema:hasPart "python" ;
    schema:identifier biotools:plek ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "plek" ;
    schema:softwareVersion "1.2" ;
    schema:url "https://sourceforge.net/projects/plek" .

