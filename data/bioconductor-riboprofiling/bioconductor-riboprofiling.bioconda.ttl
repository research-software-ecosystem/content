@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-riboprofiling a schema:SoftwareApplication ;
    schema:citation "doi:10.12688/f1000research.8964.1" ;
    schema:description "Ribosome Profiling Data Analysis: from BAM to Data Representation and Interpretation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/RiboProfiling_1.39.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RiboProfiling/RiboProfiling_1.39.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RiboProfiling_1.39.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-riboprofiling/bioconductor-riboprofiling_1.39.1_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicalignments",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-ggbio",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "bioconductor-seqinfo",
        "r-base",
        "r-data.table",
        "r-ggplot2",
        "r-plyr",
        "r-reshape2",
        "r-sqldf" ;
    schema:identifier biotools:riboprofiling ;
    schema:license "GPL-3" ;
    schema:name "bioconductor-riboprofiling" ;
    schema:softwareVersion "1.39.1" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/RiboProfiling.html" .

