@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-riboprofiling a schema1:SoftwareApplication ;
    schema1:alternateName "Ribosome Profiling Data Analysis: from BAM to Data Representation and Interpretation" ;
    schema1:citation "doi:10.12688/f1000research.8964.1" ;
    schema1:description "Starting with a BAM file, this package provides the necessary functions for quality assessment, read start position recalibration, the counting of reads on CDS, 3'UTR, and 5'UTR, plotting of count data: pairs, log fold-change, codon frequency and coverage assessment, principal component analysis on codon coverage." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/RiboProfiling_1.39.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/RiboProfiling/RiboProfiling_1.39.1.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/RiboProfiling_1.39.1.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-riboprofiling/bioconductor-riboprofiling_1.39.1_src_all.tar.gz" ;
    schema1:identifier "biotools:riboprofiling" ;
    schema1:license "GPL-3" ;
    schema1:name "bioconductor-riboprofiling" ;
    schema1:softwareVersion "1.39.1" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/RiboProfiling.html" .

