@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:kleborate a schema:SoftwareApplication ;
    schema:author "Marysteph" ;
    schema:citation "doi:10.1038/s41467-021-24448-3",
        "doi:10.1099/mgen.0.000102" ;
    schema:description "Kleborate: a tool for typing and screening pathogen genome assemblies." ;
    schema:downloadUrl "https://pypi.io/packages/source/k/kleborate/kleborate-3.2.4.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:kleborate ;
    schema:license "GPL-3.0-or-later" ;
    schema:maintainer "Marysteph" ;
    schema:name "kleborate" ;
    schema:softwareHelp "https://kleborate.readthedocs.io" ;
    schema:softwareVersion "3.2.4" ;
    schema:url "https://kleborate.readthedocs.io" .

