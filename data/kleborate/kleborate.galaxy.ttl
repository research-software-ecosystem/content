@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:kleborate a schema1:SoftwareApplication ;
    bioschemas:output "tabular" ;
    schema1:applicationSubCategory edam:data_0925,
        edam:operation_0310,
        edam:topic_0196,
        edam:topic_3174,
        edam:topic_3305,
        edam:topic_3673,
        edam:topic_3796 ;
    schema1:codeRepository "https://github.com/katholt/Kleborate" ;
    schema1:dateCreated "2022-09-09" ;
    schema1:description "Screen genome assemblies of Klebsiella pneumoniae and the Klebsiella pneumoniae species complex (KpSC)" ;
    schema1:encodingFormat "tabular" ;
    schema1:featureList edam:operation_0525,
        edam:operation_3440,
        edam:operation_3461,
        edam:operation_3840 ;
    schema1:identifier biotools:kleborate,
        bioconda:kleborate ;
    schema1:keywords "Metagenomics" ;
    schema1:name "kleborate" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/kleborate" .

