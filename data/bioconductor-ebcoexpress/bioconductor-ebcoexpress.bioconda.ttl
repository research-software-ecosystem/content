@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ebcoexpress a schema1:SoftwareApplication ;
    schema1:alternateName "EBcoexpress for Differential Co-Expression Analysis" ;
    schema1:description "An Empirical Bayesian Approach to Differential Co-Expression Analysis at the Gene-Pair Level" ;
    schema1:identifier biotools:ebcoexpress ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-ebcoexpress" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EBcoexpress.html" .

