@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ebcoexpress a schema:SoftwareApplication ;
    schema:description "EBcoexpress for Differential Co-Expression Analysis" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EBcoexpress_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EBcoexpress/EBcoexpress_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EBcoexpress_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ebcoexpress/bioconductor-ebcoexpress_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-ebarrays",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-mclust",
        "r-minqa",
        "zlib" ;
    schema:identifier biotools:ebcoexpress ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-ebcoexpress" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EBcoexpress.html" .

