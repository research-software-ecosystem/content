@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-shinymethyl a schema:SoftwareApplication ;
    schema:description "Interactive visualization for Illumina methylation arrays" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/shinyMethyl_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/shinyMethyl/shinyMethyl_1.46.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/shinyMethyl_1.46.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-shinymethyl/bioconductor-shinymethyl_1.46.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-matrixgenerics",
        "bioconductor-minfi",
        "r-base",
        "r-htmltools",
        "r-rcolorbrewer",
        "r-shiny" ;
    schema:identifier biotools:shinymethyl ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-shinymethyl" ;
    schema:softwareVersion "1.46.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/shinyMethyl.html" .

