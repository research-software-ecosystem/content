@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-shinymethyl a schema1:SoftwareApplication ;
    schema1:alternateName "Interactive visualization for Illumina methylation arrays" ;
    schema1:description "Interactive tool for visualizing Illumina methylation array data. Both the 450k and EPIC array are supported." ;
    schema1:identifier biotools:shinymethyl ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-shinymethyl" ;
    schema1:softwareVersion "1.46.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/shinyMethyl.html" .

