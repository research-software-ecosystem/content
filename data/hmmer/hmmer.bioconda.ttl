@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hmmer a schema:SoftwareApplication ;
    schema:citation "doi:10.1142/9781848165632_0019",
        "doi:10.1371/journal.pcbi.1000069",
        "doi:10.1371/journal.pcbi.1002195" ;
    schema:description "Biosequence analysis using profile hidden Markov models." ;
    schema:downloadUrl "http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz" ;
    schema:hasPart "gsl",
        "openmpi" ;
    schema:identifier biotools:hmmer3 ;
    schema:license "BSD" ;
    schema:name "hmmer" ;
    schema:softwareHelp "http://hmmer.org/documentation.html" ;
    schema:softwareVersion "3.4" ;
    schema:url "http://hmmer.org" .

