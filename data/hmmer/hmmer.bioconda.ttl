@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:hmmer a schema1:SoftwareApplication ;
    schema1:alternateName "Biosequence analysis using profile hidden Markov models." ;
    schema1:citation "doi:10.1142/9781848165632_0019",
        "doi:10.1371/journal.pcbi.1000069",
        "doi:10.1371/journal.pcbi.1002195" ;
    schema1:description "Biosequence analysis using profile hidden Markov models." ;
    schema1:identifier biotools:hmmer3,
        "usegalaxy-eu:hmmer_jackhmmer",
        "usegalaxy-eu:hmmer_nhmmer",
        "usegalaxy-eu:hmmer_phmmer" ;
    schema1:license "BSD" ;
    schema1:name "hmmer" ;
    schema1:softwareVersion "3.4" ;
    schema1:url "http://hmmer.org" .

