@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-demand a schema1:SoftwareApplication ;
    schema1:alternateName "DeMAND" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "DEMAND predicts Drug MoA by interrogating a cell context specific regulatory network with a small number (N >= 6) of compound-induced gene expression signatures, to elucidate specific proteins whose interactions in the network is dysregulated by the compound." ;
    schema1:identifier biotools:demand ;
    schema1:license "file LICENSE" ;
    schema1:name "bioconductor-demand" ;
    schema1:softwareVersion "1.40.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/DeMAND.html" .

