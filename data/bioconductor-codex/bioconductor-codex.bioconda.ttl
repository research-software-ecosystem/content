@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-codex a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gku1363" ;
    schema:description "A Normalization and Copy Number Variation Detection Method for Whole Exome Sequencing" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CODEX_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/CODEX/CODEX_1.42.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/CODEX_1.42.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-codex/bioconductor-codex_1.42.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biostrings",
        "bioconductor-bsgenome.hsapiens.ucsc.hg19",
        "bioconductor-genomeinfodb",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-s4vectors",
        "r-base" ;
    schema:identifier biotools:codex ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-codex" ;
    schema:softwareVersion "1.42.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/CODEX.html" .

