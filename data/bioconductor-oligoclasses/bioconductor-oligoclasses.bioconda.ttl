@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-oligoclasses a schema1:SoftwareApplication ;
    schema1:alternateName "Classes for high-throughput arrays supported by oligo and crlmm" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "This package contains class definitions, validity checks, and initialization methods for classes used by the oligo and crlmm packages." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/oligoClasses_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/oligoClasses/oligoClasses_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/oligoClasses_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-oligoclasses/bioconductor-oligoclasses_1.72.0_src_all.tar.gz" ;
    schema1:identifier "biotools:oligoclasses" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-oligoclasses" ;
    schema1:softwareVersion "1.72.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/oligoClasses.html" .

