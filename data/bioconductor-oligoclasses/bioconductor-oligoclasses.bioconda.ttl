@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-oligoclasses a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Classes for high-throughput arrays supported by oligo and crlmm" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/oligoClasses_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/oligoClasses/oligoClasses_1.72.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/oligoClasses_1.72.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-oligoclasses/bioconductor-oligoclasses_1.72.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-summarizedexperiment",
        "r-base",
        "r-biocmanager",
        "r-dbi",
        "r-ff",
        "r-foreach",
        "r-rsqlite" ;
    schema:identifier biotools:oligoclasses ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-oligoclasses" ;
    schema:softwareVersion "1.72.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/oligoClasses.html" .

