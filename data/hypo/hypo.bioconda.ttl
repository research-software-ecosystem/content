@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:hypo a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/2019.12.19.882506" ;
    schema:description "Super Fast and Accurate Polisher for Long Read Genome Assemblies." ;
    schema:downloadUrl "https://github.com/kensung-lab/hypo/releases/download/v1.0.3/hypo-v1.0.3.tar.gz" ;
    schema:hasPart "htslib",
        "kmc",
        "libgomp",
        "llvm-openmp",
        "sdsl-lite",
        "zlib" ;
    schema:identifier biotools:hypo ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "hypo" ;
    schema:softwareHelp "https://github.com/kensung-lab/hypo/blob/v1.0.3/README.md" ;
    schema:softwareVersion "1.0.3" ;
    schema:url "https://github.com/kensung-lab/hypo" .

