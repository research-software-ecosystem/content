@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:celltypist a schema1:SoftwareApplication ;
    bioschemas:output "h5ad",
        "pdf",
        "png",
        "svg" ;
    schema1:codeRepository "https://www.celltypist.org/" ;
    schema1:dateCreated "2026-03-10" ;
    schema1:description "CellTypist – Automated cell type annotation for scRNA-seq datasets" ;
    schema1:encodingFormat "h5ad",
        "pdf",
        "png",
        "svg" ;
    schema1:identifier biotools:celltypist,
        bioconda:celltypist ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=2e77db54ec220cc2>,
        <https://usegalaxy.eu/published/workflow?id=825ae7bc61667fb1> ;
    schema1:keywords "Single Cell",
        "Spatial Omics",
        "Transcriptomics" ;
    schema1:name "celltypist" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/celltypist" .

<https://usegalaxy.eu> a schema1:WebSite .

