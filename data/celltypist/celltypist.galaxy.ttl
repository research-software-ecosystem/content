@prefix bioconda: <https://bioconda.github.io/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:celltypist a schema1:SoftwareApplication ;
    schema1:description "CellTypist – Automated cell type annotation for scRNA-seq datasets" ;
    schema1:identifier biotools:celltypist,
        bioconda:celltypist ;
    schema1:isPartOf "https://usegalaxy.eu/published/workflow?id=2e77db54ec220cc2",
        "https://usegalaxy.eu/published/workflow?id=825ae7bc61667fb1" ;
    schema1:keywords "Single Cell",
        "Spatial Omics",
        "Transcriptomics" ;
    schema1:name "celltypist" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url "https://www.celltypist.org/" .

