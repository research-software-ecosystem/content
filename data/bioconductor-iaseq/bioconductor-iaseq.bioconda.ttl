@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-iaseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2164-13-681" ;
    schema:description "iASeq: integrating multiple sequencing datasets for detecting allele-specific events" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/iASeq_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/iASeq/iASeq_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/iASeq_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-iaseq/bioconductor-iaseq_1.54.0_src_all.tar.gz" ;
    schema:hasPart "r-base" ;
    schema:identifier biotools:iaseq ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-iaseq" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/iASeq.html" .

