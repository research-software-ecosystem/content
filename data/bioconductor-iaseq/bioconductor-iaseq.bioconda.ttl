@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-iaseq a schema1:SoftwareApplication ;
    schema1:alternateName "iASeq: integrating multiple sequencing datasets for detecting allele-specific events" ;
    schema1:citation "doi:10.1186/1471-2164-13-681" ;
    schema1:description "It fits correlation motif model to multiple RNAseq or ChIPseq studies to improve detection of allele-specific events and describe correlation patterns across studies." ;
    schema1:identifier <https://bio.tools/biotools:iaseq> ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-iaseq" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/iASeq.html" .

