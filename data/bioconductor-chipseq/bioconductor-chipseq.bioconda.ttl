@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-chipseq a schema1:SoftwareApplication ;
    schema1:alternateName "chipseq: A package for analyzing chipseq data" ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Tools for helping process short read data for chipseq experiments." ;
    schema1:identifier biotools:chipseq ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-chipseq" ;
    schema1:softwareVersion "1.60.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/chipseq.html" .

