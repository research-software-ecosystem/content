@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-chipseq a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "chipseq: A package for analyzing chipseq data" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/chipseq_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/chipseq/chipseq_1.60.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/chipseq_1.60.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-chipseq/bioconductor-chipseq_1.60.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-s4vectors",
        "bioconductor-shortread",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-lattice",
        "zlib" ;
    schema:identifier biotools:chipseq ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-chipseq" ;
    schema:softwareVersion "1.60.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/chipseq.html" .

