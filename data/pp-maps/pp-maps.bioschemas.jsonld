      "sc:citation": {
        "@id": "https://doi.org/10.64898/2026.04.22.720140"
      },
      "sc:description": "PP-MAPS is an open-source workflow designed to extract and aggregate dynamic pharmacophore signatures from molecular dynamics (MD) trajectories of protein-peptide complexes. It helps characterize protein-peptide interactions critical for drug discovery by producing per-residue interaction frequencies and pharmacophore heatmaps.",
