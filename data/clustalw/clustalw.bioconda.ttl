@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:clustalw a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btm404",
        "doi:10.1093/nar/22.22.4673" ;
    schema:description "ClustalW2 is a general purpose multiple sequence alignment program for DNA or proteins." ;
    schema:downloadUrl "http://www.clustal.org/download/current/clustalw-2.1.tar.gz" ;
    schema:identifier biotools:clustalw_biolib ;
    schema:license "LGPL-3.0-or-later" ;
    schema:name "clustalw" ;
    schema:softwareHelp "http://www.clustal.org/download/clustalw_help.txt" ;
    schema:softwareVersion "2.1" ;
    schema:url "http://www.clustal.org/clustal2" .

