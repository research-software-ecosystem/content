@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:clustalw a schema1:SoftwareApplication ;
    schema1:alternateName "ClustalW2 is a general purpose multiple sequence alignment program for DNA or proteins." ;
    schema1:citation "doi:10.1093/bioinformatics/btm404",
        "doi:10.1093/nar/22.22.4673" ;
    schema1:description "ClustalW2 is a general purpose multiple sequence alignment program for DNA or proteins." ;
    schema1:identifier <https://bio.tools/biotools:clustalw_biolib>,
        "usegalaxy-eu:clustalw" ;
    schema1:license "LGPL-3.0-or-later" ;
    schema1:name "clustalw" ;
    schema1:softwareVersion "2.1" ;
    schema1:url "https://ftp.ebi.ac.uk/pub/software/clustalw2" .

