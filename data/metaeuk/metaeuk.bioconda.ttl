@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metaeuk a schema:SoftwareApplication ;
    schema:author "elileka",
        "milot-mirdita" ;
    schema:citation "doi:10.1186/s40168-020-00808-x" ;
    schema:description "MetaEuk - sensitive, high-throughput gene discovery and annotation for large-scale eukaryotic metagenomics" ;
    schema:downloadUrl "https://github.com/soedinglab/metaeuk/archive/7-bba0d80.tar.gz" ;
    schema:hasPart "bzip2",
        "gawk",
        "perl",
        "zlib" ;
    schema:identifier biotools:metaeuk ;
    schema:license "GPL-3" ;
    schema:maintainer "elileka",
        "milot-mirdita" ;
    schema:name "metaeuk" ;
    schema:softwareVersion "7.bba0d80" ;
    schema:url "https://github.com/soedinglab/metaeuk" .

