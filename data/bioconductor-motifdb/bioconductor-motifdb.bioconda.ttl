@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-motifdb a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "An Annotated Collection of Protein-DNA Binding Sequence Motifs" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/MotifDb_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/MotifDb/MotifDb_1.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/MotifDb_1.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-motifdb/bioconductor-motifdb_1.52.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biocgenerics",
        "bioconductor-biostrings",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rtracklayer",
        "bioconductor-s4vectors",
        "r-base",
        "r-splitstackshape" ;
    schema1:identifier biotools:motifdb ;
    schema1:license "Artistic-2.0 | file LICENSE" ;
    schema1:name "bioconductor-motifdb" ;
    schema1:softwareVersion "1.52.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/MotifDb.html" .

