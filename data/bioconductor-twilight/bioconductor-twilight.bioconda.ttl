@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-twilight a schema1:SoftwareApplication ;
    schema1:citation "doi:10.1093/bioinformatics/bti436" ;
    schema1:description "Estimation of local false discovery rate" ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/twilight_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/twilight/twilight_1.86.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/twilight_1.86.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-twilight/bioconductor-twilight_1.86.0_src_all.tar.gz" ;
    schema1:hasPart "bioconductor-biobase",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema1:identifier biotools:twilight ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-twilight" ;
    schema1:softwareVersion "1.86.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/twilight.html" .

