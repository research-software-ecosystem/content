@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-geneattribution a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/bioinformatics/btw698" ;
    schema:description "Identification of candidate genes associated with genetic variation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/geneAttribution_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/geneAttribution/geneAttribution_1.36.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/geneAttribution_1.36.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-geneattribution/bioconductor-geneattribution_1.36.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocgenerics",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-org.hs.eg.db",
        "bioconductor-rtracklayer",
        "bioconductor-seqinfo",
        "r-base" ;
    schema:identifier biotools:geneattribution ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-geneattribution" ;
    schema:softwareVersion "1.36.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/geneAttribution.html" .

