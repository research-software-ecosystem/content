@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-scan.upc a schema:SoftwareApplication ;
    schema:description "Single-channel array normalization (SCAN) and Universal exPression Codes (UPC)" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/SCAN.UPC_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/SCAN.UPC/SCAN.UPC_2.52.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/SCAN.UPC_2.52.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-scan.upc/bioconductor-scan.upc_2.52.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "bioconductor-affyio",
        "bioconductor-biobase",
        "bioconductor-biostrings",
        "bioconductor-geoquery",
        "bioconductor-iranges",
        "bioconductor-oligo",
        "bioconductor-sva",
        "r-base",
        "r-foreach",
        "r-mass" ;
    schema:identifier biotools:scan.upc ;
    schema:license "MIT" ;
    schema:name "bioconductor-scan.upc" ;
    schema:softwareVersion "2.52.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/SCAN.UPC.html" .

