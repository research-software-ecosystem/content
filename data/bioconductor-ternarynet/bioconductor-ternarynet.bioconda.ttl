@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-ternarynet a schema1:SoftwareApplication ;
    schema1:alternateName "Ternary Network Estimation" ;
    schema1:description "Gene-regulatory network (GRN) modeling seeks to infer dependencies between genes and thereby provide insight into the regulatory relationships that exist within a cell. This package provides a computational Bayesian approach to GRN estimation from perturbation experiments using a ternary network model, in which gene expression is discretized into one of 3 states: up, unchanged, or down). The ternarynet package includes a parallel implementation of the replica exchange Monte Carlo algorithm for fitting network models, using MPI." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/ternarynet_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ternarynet/ternarynet_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ternarynet_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ternarynet/bioconductor-ternarynet_1.54.0_src_all.tar.gz" ;
    schema1:identifier "biotools:ternarynet" ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-ternarynet" ;
    schema1:softwareVersion "1.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/ternarynet.html" .

