@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-ternarynet a schema:SoftwareApplication ;
    schema:description "Ternary Network Estimation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/ternarynet_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/ternarynet/ternarynet_1.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/ternarynet_1.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-ternarynet/bioconductor-ternarynet_1.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-biocparallel",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-igraph",
        "zlib" ;
    schema:identifier biotools:ternarynet ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-ternarynet" ;
    schema:softwareVersion "1.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/ternarynet.html" .

