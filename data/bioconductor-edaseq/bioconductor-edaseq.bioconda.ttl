@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-edaseq a schema1:SoftwareApplication ;
    schema1:alternateName "Exploratory Data Analysis and Normalization for RNA-Seq" ;
    schema1:description "Numerical and graphical summaries of RNA-Seq read data. Within-lane normalization procedures to adjust for GC-content effect (or other gene-level effects) on read counts: loess robust local regression, global-scaling, and full-quantile normalization (Risso et al., 2011). Between-lane normalization procedures to adjust for distributional differences between lanes (e.g., sequencing depth): global-scaling and full-quantile normalization (Bullard et al., 2010)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/EDASeq_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EDASeq/EDASeq_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EDASeq_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-edaseq/bioconductor-edaseq_2.44.0_src_all.tar.gz" ;
    schema1:identifier "biotools:edaseq" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-edaseq" ;
    schema1:softwareVersion "2.44.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/EDASeq.html" .

