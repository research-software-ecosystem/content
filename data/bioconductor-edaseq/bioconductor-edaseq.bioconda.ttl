@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-edaseq a schema:SoftwareApplication ;
    schema:description "Exploratory Data Analysis and Normalization for RNA-Seq" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/EDASeq_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/EDASeq/EDASeq_2.44.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/EDASeq_2.44.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-edaseq/bioconductor-edaseq_2.44.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-annotationdbi",
        "bioconductor-aroma.light",
        "bioconductor-biobase",
        "bioconductor-biocgenerics",
        "bioconductor-biomart",
        "bioconductor-biostrings",
        "bioconductor-genomicfeatures",
        "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-shortread",
        "r-base",
        "r-biocmanager" ;
    schema:identifier biotools:edaseq ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-edaseq" ;
    schema:softwareVersion "2.44.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/EDASeq.html" .

