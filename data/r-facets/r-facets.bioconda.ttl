@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:r-facets a schema:SoftwareApplication ;
    schema:description "Cellular Fraction and Copy Numbers from Tumor Sequencing" ;
    schema:downloadUrl "https://github.com/mskcc/facets/archive/refs/tags/v0.6.2.tar.gz" ;
    schema:hasPart "r-base",
        "r-pctgcdata" ;
    schema:identifier biotools:facets ;
    schema:license "GPL (>= 2)" ;
    schema:name "r-facets" ;
    schema:softwareVersion "0.6.2" ;
    schema:url "https://github.com/mskcc/facets" .

