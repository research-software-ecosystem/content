@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-correp a schema:SoftwareApplication ;
    schema:citation "doi:10.1038/nmeth.3252" ;
    schema:description "Multivariate Correlation Estimator and Statistical Inference Procedures." ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/CORREP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/Archive/CORREP/CORREP_1.68.0.tar.gz",
        "https://bioconductor.org/packages/3.18/bioc/src/contrib/CORREP_1.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-correp/bioconductor-correp_1.68.0_src_all.tar.gz" ;
    schema:hasPart "r-base",
        "r-e1071" ;
    schema:identifier biotools:correp ;
    schema:license "GPL (>= 2)" ;
    schema:name "bioconductor-correp" ;
    schema:softwareVersion "1.68.0" ;
    schema:url "https://bioconductor.org/packages/3.18/bioc/html/CORREP.html" .

