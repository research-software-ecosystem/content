@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-correp a schema1:SoftwareApplication ;
    schema1:alternateName "Multivariate Correlation Estimator and Statistical Inference Procedures." ;
    schema1:citation "doi:10.1038/nmeth.3252" ;
    schema1:description "Multivariate correlation estimation and statistical inference. See package vignette." ;
    schema1:identifier <https://bio.tools/biotools:correp> ;
    schema1:license "GPL (>= 2)" ;
    schema1:name "bioconductor-correp" ;
    schema1:softwareVersion "1.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.18/bioc/html/CORREP.html" .

