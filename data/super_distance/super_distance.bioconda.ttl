@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:super_distance a schema:SoftwareApplication ;
    schema:description "Supertree method with distances" ;
    schema:hasPart "check",
        "zlib" ;
    schema:identifier biotools:super_distance ;
    schema:license "GPLv3" ;
    schema:name "super_distance" ;
    schema:softwareVersion "1.1.0" ;
    schema:url "https://github.com/quadram-institute-bioscience/super_distance" .

