@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mikado a schema:SoftwareApplication ;
    schema:author "gemygk",
        "ljyanesm",
        "lucventurini",
        "swarbred" ;
    schema:citation "doi:10.1093/gigascience/giy093",
        "doi:10.1093/gigascience/giy131" ;
    schema:description "A Python3 annotation program to select the best gene model in each locus." ;
    schema:downloadUrl "https://github.com/EI-CoreBioinformatics/mikado/archive/refs/tags/v2.3.5rc3.tar.gz" ;
    schema:hasPart "cython",
        "numpy",
        "pip",
        "python",
        "scipy",
        "setuptools" ;
    schema:identifier biotools:mikado ;
    schema:license "LGPL-3.0-or-later" ;
    schema:maintainer "gemygk",
        "ljyanesm",
        "lucventurini",
        "swarbred" ;
    schema:name "mikado" ;
    schema:softwareHelp "https://mikado.readthedocs.io/en/stable" ;
    schema:softwareVersion "2.3.5rc3" ;
    schema:url "https://github.com/EI-CoreBioinformatics/mikado" .

