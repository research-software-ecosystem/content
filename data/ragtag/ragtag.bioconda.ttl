@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:ragtag a schema1:SoftwareApplication ;
    schema1:alternateName "Fast reference-guided genome assembly scaffolding." ;
    schema1:citation "doi:10.1186/s13059-022-02823-7" ;
    schema1:description "Fast reference-guided genome assembly scaffolding." ;
    schema1:identifier <https://bio.tools/biotools:ragtag>,
        "usegalaxy-eu:ragtag" ;
    schema1:license "MIT" ;
    schema1:maintainer "malonge" ;
    schema1:name "ragtag" ;
    schema1:softwareVersion "2.1.0" ;
    schema1:url "https://github.com/malonge/RagTag" .

