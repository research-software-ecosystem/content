@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:ragtag a schema:SoftwareApplication ;
    schema:author "malonge" ;
    schema:citation "doi:10.1186/s13059-022-02823-7" ;
    schema:description "Fast reference-guided genome assembly scaffolding." ;
    schema:downloadUrl "https://pypi.org/packages/source/R/RagTag/RagTag-2.1.0.tar.gz" ;
    schema:hasPart "pip",
        "python",
        "setuptools" ;
    schema:identifier biotools:ragtag ;
    schema:license "MIT" ;
    schema:maintainer "malonge" ;
    schema:name "ragtag" ;
    schema:softwareHelp "https://github.com/malonge/RagTag/wiki" ;
    schema:softwareVersion "2.1.0" ;
    schema:url "https://github.com/malonge/RagTag" .

