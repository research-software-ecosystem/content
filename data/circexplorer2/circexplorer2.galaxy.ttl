@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:circexplorer2 a schema1:SoftwareApplication ;
    bioschemas:output "bed",
        "bigwig",
        "tabular",
        "tgz" ;
    schema1:applicationSubCategory edam:topic_3068,
        edam:topic_3320,
        edam:topic_3512 ;
    schema1:codeRepository "https://github.com/YangLab/CIRCexplorer2" ;
    schema1:dateCreated "2022-08-26" ;
    schema1:description "Comprehensive and integrative circular RNA analysis toolset." ;
    schema1:encodingFormat "bed",
        "bigwig",
        "tabular",
        "tgz" ;
    schema1:identifier biotools:circexplorer2,
        bioconda:circexplorer2 ;
    schema1:keywords "Assembly",
        "RNA" ;
    schema1:name "circexplorer2" ;
    schema1:softwareVersion "2.3.8" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/circexplorer2" .

