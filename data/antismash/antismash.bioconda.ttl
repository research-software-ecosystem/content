@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:antismash a schema:SoftwareApplication ;
    schema:citation "doi:10.1093/nar/gkab335",
        "doi:10.1093/nar/gkad344",
        "doi:10.1093/nar/gkr466",
        "doi:10.1093/nar/gkt449",
        "doi:10.1093/nar/gkv437",
        "doi:10.1093/nar/gkx319",
        "doi:10.1093/nar/gkz310" ;
    schema:description "antiSMASH - the antibiotics and Secondary Metabolite Analysis SHell." ;
    schema:downloadUrl "https://github.com/antismash/antismash/archive/refs/tags/8-0-4.tar.gz" ;
    schema:hasPart "pip",
        "pytest",
        "python",
        "setuptools" ;
    schema:identifier biotools:antismash ;
    schema:license "AGPL-3.0-or-later" ;
    schema:name "antismash" ;
    schema:softwareHelp "https://docs.antismash.secondarymetabolites.org" ;
    schema:softwareVersion "8.0.4" ;
    schema:url "https://docs.antismash.secondarymetabolites.org/intro" .

