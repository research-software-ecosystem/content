@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:lofreq a schema:SoftwareApplication ;
    schema:description "A fast and sensitive variant-caller for inferring SNVs and indels from next-generation sequencing data." ;
    schema:downloadUrl "https://github.com/CSB5/lofreq/archive/refs/tags/v2.1.5.tar.gz" ;
    schema:hasPart "gsl",
        "htslib",
        "python",
        "samtools",
        "setuptools",
        "zlib" ;
    schema:identifier biotools:lofreq ;
    schema:license "MIT" ;
    schema:name "lofreq" ;
    schema:softwareHelp "https://csb5.github.io/lofreq" ;
    schema:softwareVersion "2.1.5" ;
    schema:url "https://csb5.github.io/lofreq" .

