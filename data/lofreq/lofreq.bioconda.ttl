@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema1: <http://schema.org/> .

bioconda:lofreq a schema1:SoftwareApplication ;
    schema1:alternateName "A fast and sensitive variant-caller for inferring SNVs and indels from next-generation sequencing data." ;
    schema1:description "A fast and sensitive variant-caller for inferring SNVs and indels from next-generation sequencing data." ;
    schema1:identifier biotools:lofreq,
        "usegalaxy-eu:lofreq_call" ;
    schema1:license "MIT" ;
    schema1:name "lofreq" ;
    schema1:softwareVersion "2.1.5" ;
    schema1:url "https://csb5.github.io/lofreq" .

