@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:virheat a schema1:SoftwareApplication ;
    bioschemas:output "pdf" ;
    schema1:codeRepository <https://github.com/jonas-fuchs/virHEAT> ;
    schema1:dateCreated "2024-05-15" ;
    schema1:description "generates a heatmap of allele frequencies from vcf files" ;
    schema1:encodingFormat "pdf" ;
    schema1:identifier biotools:virheat,
        bioconda:virheat ;
    schema1:isPartOf <https://galaxytrakr.org>,
        <https://usegalaxy.eu> ;
    schema1:keywords "Variant Analysis",
        "Visualization" ;
    schema1:name "virheat" ;
    schema1:softwareVersion "0.7.1" ;
    schema1:url <https://github.com/galaxyproject/tools-iuc/tree/main/tools/virheat> .

<https://galaxytrakr.org> a schema1:WebSite .

<https://usegalaxy.eu> a schema1:WebSite .

