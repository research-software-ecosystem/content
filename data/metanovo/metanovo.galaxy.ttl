    schema1:keywords "Proteomics" ;
    schema1:name "metanovo" ;
    schema1:softwareVersion "@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" ;
    schema1:url <https://github.com/galaxyproteomics/tools-galaxyp/tree/master/tools/metanovo> .

