    schema1:description "Produce targeted databases for mass spectrometry analysis." ;
    schema1:encodingFormat "csv",
        "fasta" ;
    schema1:featureList edam:operation_2495,
        edam:operation_3643,
        edam:operation_3644,
        edam:operation_3649,
        edam:operation_3767 ;
    schema1:identifier biotools:metanovo,
        bioconda:metanovo ;
    schema1:isPartOf <https://usegalaxy.be>,
        <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
