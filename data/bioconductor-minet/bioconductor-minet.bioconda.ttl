@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-minet a schema1:SoftwareApplication ;
    schema1:alternateName "Mutual Information NETworks" ;
    schema1:citation "doi:10.1186/1471-2105-9-461" ;
    schema1:description "This package implements various algorithms for inferring mutual information networks from data." ;
    schema1:identifier <https://bio.tools/biotools:minet> ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-minet" ;
    schema1:softwareVersion "3.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/minet.html" .

