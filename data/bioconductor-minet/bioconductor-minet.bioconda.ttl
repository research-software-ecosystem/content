@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-minet a schema:SoftwareApplication ;
    schema:citation "doi:10.1186/1471-2105-9-461" ;
    schema:description "Mutual Information NETworks" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/minet_3.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/minet/minet_3.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/minet_3.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-minet/bioconductor-minet_3.68.0_src_all.tar.gz" ;
    schema:hasPart "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-infotheo",
        "zlib" ;
    schema:identifier biotools:minet ;
    schema:license "Artistic-2.0" ;
    schema:name "bioconductor-minet" ;
    schema:softwareVersion "3.68.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/minet.html" .

