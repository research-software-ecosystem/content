        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/minet/minet_3.68.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/minet_3.68.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-minet/bioconductor-minet_3.68.0_src_all.tar.gz" ;
    schema1:identifier "biotools:minet" ;
    schema1:license "Artistic-2.0" ;
    schema1:name "bioconductor-minet" ;
    schema1:softwareVersion "3.68.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/minet.html" .

