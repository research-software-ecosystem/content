@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:mstmap a schema:SoftwareApplication ;
    schema:citation "doi:10.1371/journal.pgen.1000212" ;
    schema:description "Accurate construction of genetic maps (Wu et al., PLoS Genetics, 4(10):e1000212, 2008)" ;
    schema:downloadUrl "http://www.cs.ucr.edu/~stelo/pub/mstmap_v1.tar.gz" ;
    schema:identifier biotools:mstmap ;
    schema:license "GPL3" ;
    schema:name "mstmap" ;
    schema:softwareVersion "1" ;
    schema:url "http://mstmap.org/" .

