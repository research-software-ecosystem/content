@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mstmap a schema1:SoftwareApplication ;
    schema1:alternateName "Accurate construction of genetic maps (Wu et al., PLoS Genetics, 4(10):e1000212, 2008)" ;
    schema1:citation "doi:10.1371/journal.pgen.1000212" ;
    schema1:description "Accurate construction of genetic maps (Wu et al., PLoS Genetics, 4(10):e1000212, 2008)" ;
    schema1:identifier <https://bio.tools/biotools:mstmap> ;
    schema1:license "GPL3" ;
    schema1:name "mstmap" ;
    schema1:softwareVersion "1" ;
    schema1:url "http://mstmap.org/" .

