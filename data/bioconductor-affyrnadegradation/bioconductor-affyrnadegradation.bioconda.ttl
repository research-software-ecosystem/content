@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-affyrnadegradation a schema:SoftwareApplication ;
    schema:description "Analyze and correct probe positional bias in microarray data due to RNA degradation" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/AffyRNADegradation_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AffyRNADegradation_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AffyRNADegradation/AffyRNADegradation_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affyrnadegradation/bioconductor-affyrnadegradation_1.56.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-affy",
        "r-base" ;
    schema:identifier biotools:affyrnadegradation ;
    schema:license "GPL-2" ;
    schema:name "bioconductor-affyrnadegradation" ;
    schema:softwareVersion "1.56.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/AffyRNADegradation.html" .

