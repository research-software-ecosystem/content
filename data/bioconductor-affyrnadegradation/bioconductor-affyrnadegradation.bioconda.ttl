@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-affyrnadegradation a schema1:SoftwareApplication ;
    schema1:alternateName "Analyze and correct probe positional bias in microarray data due to RNA degradation" ;
    schema1:description "The package helps with the assessment and correction of RNA degradation effects in Affymetrix 3' expression arrays. The parameter d gives a robust and accurate measure of RNA integrity. The correction removes the probe positional bias, and thus improves comparability of samples that are affected by RNA degradation." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/AffyRNADegradation_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/AffyRNADegradation_1.56.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/AffyRNADegradation/AffyRNADegradation_1.56.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-affyrnadegradation/bioconductor-affyrnadegradation_1.56.0_src_all.tar.gz" ;
    schema1:identifier "biotools:affyrnadegradation" ;
    schema1:license "GPL-2" ;
    schema1:name "bioconductor-affyrnadegradation" ;
    schema1:softwareVersion "1.56.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/AffyRNADegradation.html" .

