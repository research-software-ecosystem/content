    schema1:description "Galaxy wrapper for ORFIPY" ;
    schema1:encodingFormat "bed12",
        "bed6",
        "fasta" ;
    schema1:featureList edam:operation_0436,
        edam:operation_0524,
        edam:operation_2421,
        edam:operation_3258 ;
    schema1:identifier biotools:orfipy,
        bioconda:orfipy ;
    schema1:isPartOf <https://usegalaxy.cz>,
        <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=30dc526dcfa500df>,
        <https://usegalaxy.org> ;
    schema1:keywords "Sequence Analysis" ;
