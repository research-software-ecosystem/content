@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rfpred a schema:SoftwareApplication ;
    schema:citation "doi:10.1101/037127" ;
    schema:description "Assign rfPred functional prediction scores to a missense variants list" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/rfPred_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rfPred/rfPred_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rfPred_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rfpred/bioconductor-rfpred_1.48.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-genomicranges",
        "bioconductor-iranges",
        "bioconductor-rsamtools",
        "bioconductor-seqinfo",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "r-data.table",
        "zlib" ;
    schema:identifier biotools:rfpred ;
    schema:license "GPL (>=2 )" ;
    schema:name "bioconductor-rfpred" ;
    schema:softwareVersion "1.48.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/rfPred.html" .

