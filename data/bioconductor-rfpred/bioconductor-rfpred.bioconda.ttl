@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rfpred a schema1:SoftwareApplication ;
    schema1:alternateName "Assign rfPred functional prediction scores to a missense variants list" ;
    schema1:citation "doi:10.1101/037127" ;
    schema1:description "Based on external numerous data files where rfPred scores are pre-calculated on all genomic positions of the human exome, the package gives rfPred scores to missense variants identified by the chromosome, the position (hg19 version), the referent and alternative nucleotids and the uniprot identifier of the protein. Note that for using the package, the user has to download the TabixFile and index (approximately 3.3 Go)." ;
    schema1:downloadUrl "https://bioarchive.galaxyproject.org/rfPred_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/rfPred/rfPred_1.48.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/rfPred_1.48.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rfpred/bioconductor-rfpred_1.48.0_src_all.tar.gz" ;
    schema1:identifier "biotools:rfpred" ;
    schema1:license "GPL (>=2 )" ;
    schema1:name "bioconductor-rfpred" ;
    schema1:softwareVersion "1.48.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/rfPred.html" .

