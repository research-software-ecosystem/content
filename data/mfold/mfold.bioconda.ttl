@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:mfold a schema1:SoftwareApplication ;
    schema1:alternateName "Mfold web server for nucleic acid folding and hybridization prediction." ;
    schema1:citation "doi:10.1007/978-94-011-4485-8_2" ;
    schema1:description "Mfold web server for nucleic acid folding and hybridization prediction." ;
    schema1:downloadUrl "http://www.unafold.org/download/mfold-3.6.tar.gz" ;
    schema1:identifier "biotools:mfold" ;
    schema1:license "Custom OSS" ;
    schema1:name "mfold" ;
    schema1:softwareVersion "3.6" ;
    schema1:url "https://www.unafold.org/mfold/software/download-mfold.php" .

