@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:gadem a schema:SoftwareApplication ;
    schema:citation "doi:10.1089/cmb.2008.16TT" ;
    schema:description "A Genetic Algorithm Guided Formation of Spaced Dyads Coupled with an EM Algorithm for Motif Discovery." ;
    schema:downloadUrl "https://www.niehs.nih.gov/research/resources/assets/docs/gadem_v1.3.1.tar.gz" ;
    schema:hasPart "tcsh" ;
    schema:identifier biotools:gadem ;
    schema:license "GPL-3.0-or-later" ;
    schema:name "gadem" ;
    schema:softwareHelp "https://www.niehs.nih.gov/research/resources/software/biostatistics/gadem/index.cfm" ;
    schema:softwareVersion "1.3.1" ;
    schema:url "https://www.niehs.nih.gov/research/resources/software/biostatistics/gadem/index.cfm" .

