@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:bioconductor-rgraphviz a schema:SoftwareApplication ;
    schema:description "Provides plotting capabilities for R graph objects" ;
    schema:downloadUrl "https://bioarchive.galaxyproject.org/Rgraphviz_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Archive/Rgraphviz/Rgraphviz_2.54.0.tar.gz",
        "https://bioconductor.org/packages/3.22/bioc/src/contrib/Rgraphviz_2.54.0.tar.gz",
        "https://depot.galaxyproject.org/software/bioconductor-rgraphviz/bioconductor-rgraphviz_2.54.0_src_all.tar.gz" ;
    schema:hasPart "bioconductor-graph",
        "libblas",
        "liblapack",
        "liblzma-devel",
        "r-base",
        "zlib" ;
    schema:identifier biotools:rgraphviz ;
    schema:license "EPL" ;
    schema:name "bioconductor-rgraphviz" ;
    schema:softwareVersion "2.54.0" ;
    schema:url "https://bioconductor.org/packages/3.22/bioc/html/Rgraphviz.html" .

