@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix schema1: <http://schema.org/> .

bioconda:bioconductor-rgraphviz a schema1:SoftwareApplication ;
    schema1:alternateName "Provides plotting capabilities for R graph objects" ;
    schema1:description "Interfaces R with the AT and T graphviz library for plotting R graph objects from the graph package." ;
    schema1:identifier <https://bio.tools/biotools:rgraphviz>,
        "usegalaxy-eu:rgraphviz" ;
    schema1:license "EPL" ;
    schema1:name "bioconductor-rgraphviz" ;
    schema1:softwareVersion "2.54.0" ;
    schema1:url "https://bioconductor.org/packages/3.22/bioc/html/Rgraphviz.html" .

