@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix bioschemas: <http://bioschemas.org/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:pbgcpp a schema1:SoftwareApplication ;
    bioschemas:output "fasta",
        "gff",
        "vcf" ;
    schema1:applicationSubCategory edam:operation_2429,
        edam:topic_0102 ;
    schema1:codeRepository "https://github.com/PacificBiosciences/gcpp" ;
    schema1:dateCreated "2022-03-11" ;
    schema1:description "Compute genomic consensus and call variants using PacBio reads mapped to a reference" ;
    schema1:encodingFormat "fasta",
        "gff",
        "vcf" ;
    schema1:featureList edam:operation_3227 ;
    schema1:identifier biotools:genomicconsensus,
        bioconda:pbgcpp ;
    schema1:keywords "Variant Analysis" ;
    schema1:name "pbgcpp" ;
    schema1:softwareVersion "2.0.2" ;
    schema1:url "https://github.com/galaxyproject/tools-iuc/tree/main/tools/pbgcpp" .

