@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:metabinkit a schema:SoftwareApplication ;
    schema:author "nuno.fonseca" ;
    schema:citation "doi:10.5281/zenodo.3855032" ;
    schema:description "Set of programs to perform taxonomic binning." ;
    schema:downloadUrl "https://github.com/envmetagen/metabinkit/archive/0.2.3.tar.gz" ;
    schema:hasPart "pcre",
        "r-base",
        "zlib" ;
    schema:identifier biotools:metabinkit ;
    schema:license "GPL-3" ;
    schema:maintainer "nuno.fonseca" ;
    schema:name "metabinkit" ;
    schema:softwareHelp "https://github.com/envmetagen/metabinkit" ;
    schema:softwareVersion "0.2.3" ;
    schema:url "https://github.com/envmetagen/metabinkit" .

