@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix schema: <https://schema.org/> .

bioconda:pathracer a schema:SoftwareApplication ;
    schema:citation "doi:10.1007/978-3-030-18174-1_6" ;
    schema:description "PathRacer is a tool for alignment of profile HMM against assembly graph." ;
    schema:downloadUrl "http://cab.spbu.ru/files/pathracer/SPAdes-3.16.0-pathracer-dev.tar.gz" ;
    schema:hasPart "bzip2",
        "llvm-openmp",
        "openmp",
        "sysroot_linux-64=2.17",
        "zlib" ;
    schema:identifier biotools:pathracer ;
    schema:license "GPLv2" ;
    schema:name "pathracer" ;
    schema:softwareVersion "3.16.0.dev" ;
    schema:url "http://cab.spbu.ru/software/pathracer/" .

